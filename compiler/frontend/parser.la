module luna.bootstrap.frontend.parser;

enum ParserLimit: usize {
    maximum_size = 18446744073709551615, maximum_nesting = 256, maximum_nodes = 262144,
}

struct ParserState {
    source: text::View;
    tokens: lexer::TokenBuffer;
    cursor: usize;
    current: lexer::Token;
    current_index: usize;
    previous: lexer::Token;
    tree: SyntaxTree;
    diagnostics: lexer::DiagnosticBuffer;
    error: runtime::Error;
    nesting_depth: usize;
}

fn syntax_no_index() -> usize {
    return ParserLimit.maximum_size as usize;
}

fn parser_empty_span() -> lexer::SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn parser_invalid_token() -> lexer::Token {
    return {
        kind = lexer::TokenKind.invalid, span = parser_empty_span(),
    };
}

fn parser_invalid_node() -> SyntaxNode {
    return {
        kind = SyntaxKind.invalid, span = parser_empty_span(),
        token_index = syntax_no_index(), parent = syntax_no_index(),
        first_child = syntax_no_index(), last_child = syntax_no_index(),
        next_sibling = syntax_no_index(), child_count = 0, flags = SyntaxFlag.none as usize,
    };
}

fn syntax_tree_empty() -> SyntaxTree {
    return {
        storage = bytes::empty(), count = 0, token_count = 0, root = syntax_no_index(),
    };
}

fn syntax_tree_storage_is_valid(tree: SyntaxTree) -> bool {
    if (!bytes::is_valid(tree.storage) || tree.storage.length % sizeof(SyntaxNode) != 0 ||
        tree.count > ParserLimit.maximum_nodes as usize) {
        return false;
    }
    return tree.count == tree.storage.length / sizeof(SyntaxNode);
}

fn syntax_tree_is_valid(tree: SyntaxTree) -> bool {
    if (!syntax_tree_storage_is_valid(tree)) {
        return false;
    }
    let none: usize = syntax_no_index();
    if (tree.count == 0) {
        return tree.token_count == 0 && tree.root == none;
    }
    if (tree.token_count == 0 || tree.root >= tree.count) {
        return false;
    }

    let nodes: *const SyntaxNode = tree.storage.data as *const SyntaxNode;
    var node_index: usize = 0;
    while (node_index < tree.count) {
        let node: SyntaxNode = nodes[node_index];
        if ((node.kind as usize) > (SyntaxKind.selective_import_names as usize) || node.flags > 524287 ||
            node.span.line == 0 || node.span.column == 0 || node.span.length >
                (ParserLimit.maximum_size as usize) - node.span.offset || (node.token_index != none &&
                node.token_index >= tree.token_count)) {
            return false;
        }
        if (node_index == tree.root) {
            if (node.parent != none) {
                return false;
            }
        } else if (node.parent >= tree.count) {
            return false;
        }
        if (node.next_sibling != none && node.next_sibling >= tree.count) {
            return false;
        }
        if (node.child_count == 0) {
            if (node.first_child != none || node.last_child != none) {
                return false;
            }
            node_index += 1;
            continue;
        }
        if (node.child_count > tree.count || node.first_child >= tree.count || node.last_child >= tree.count) {
            return false;
        }

        var child_index: usize = node.first_child;
        var previous_child: usize = none;
        var visited: usize = 0;
        while (visited < node.child_count) {
            if (child_index >= tree.count) {
                return false;
            }
            if (nodes[child_index].parent != node_index) {
                return false;
            }
            previous_child = child_index;
            child_index = nodes[child_index].next_sibling;
            visited += 1;
        }
        if (previous_child != node.last_child || child_index != none) {
            return false;
        }
        node_index += 1;
    }
    if (nodes[tree.root].kind != SyntaxKind.program || nodes[tree.root].next_sibling != none) {
        return false;
    }

    node_index = 0;
    while (node_index < tree.count) {
        var ancestor: usize = node_index;
        var depth: usize = 0;
        while (ancestor != tree.root && depth < tree.count) {
            ancestor = nodes[ancestor].parent;
            if (ancestor >= tree.count) {
                return false;
            }
            depth += 1;
        }
        if (ancestor != tree.root) {
            return false;
        }
        node_index += 1;
    }
    return true;
}

fn syntax_tree_get(tree: SyntaxTree, index: usize) -> SyntaxNodeResult {
    if (!syntax_tree_storage_is_valid(tree) || index >= tree.count) {
        return {
            node = parser_invalid_node(), error = runtime::Error.invalid_argument,
        };
    }
    let nodes: *const SyntaxNode = tree.storage.data as *const SyntaxNode;
    return {
        node = nodes[index], error = runtime::Error.none,
    };
}

fn syntax_tree_release(tree: SyntaxTree) -> runtime::Error {
    if (!syntax_tree_storage_is_valid(tree)) {
        return runtime::Error.invalid_argument;
    }
    return bytes::release(tree.storage);
}

fn parser_span_is_valid(source: text::View, span: lexer::SourceSpan) -> bool {
    return span.offset <= source.length && span.length <= source.length - span.offset &&
        span.line != 0 && span.column != 0;
}

fn parser_source_is_valid(source: text::View) -> bool {
    if (!text::is_valid_utf8(source)) {
        return false;
    }
    var index: usize = 0;
    while (index < source.length) {
        if (source.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn parser_input_is_valid(source: text::View, tokens: lexer::TokenBuffer) -> bool {
    if (!parser_source_is_valid(source) || !lexer::token_buffer_is_valid(tokens) || tokens.count == 0) {
        return false;
    }

    var previous_end: usize = 0;
    var scan_offset: usize = 0;
    var scan_line: usize = 1;
    var scan_column: usize = 1;
    var index: usize = 0;
    while (index < tokens.count) {
        let token_result: lexer::TokenResult = lexer::token_buffer_get(tokens, index);
        if (token_result.error != runtime::Error.none) {
            return false;
        }
        let token: lexer::Token = token_result.token;
        if ((token.kind as usize) > (lexer::TokenKind.colon_colon as usize) ||
            !parser_span_is_valid(source, token.span) || token.span.offset < previous_end) {
            return false;
        }
        while (scan_offset < token.span.offset) {
            if (source.data[scan_offset] == 10) {
                scan_line += 1;
                scan_column = 1;
            } else {
                scan_column += 1;
            }
            scan_offset += 1;
        }
        if (token.span.line != scan_line || token.span.column != scan_column) {
            return false;
        }
        previous_end = token.span.offset + token.span.length;
        if (index + 1 == tokens.count) {
            return token.kind == lexer::TokenKind.end && token.span.length == 0 && token.span.offset == source.length;
        }
        if (token.kind == lexer::TokenKind.end) {
            return false;
        }
        index += 1;
    }
    return false;
}

fn parser_join_spans(first: lexer::SourceSpan, last: lexer::SourceSpan) -> lexer::SourceSpan {
    if (last.offset < first.offset || last.length > (ParserLimit.maximum_size as usize) - last.offset) {
        return first;
    }
    let last_end: usize = last.offset + last.length;
    if (last_end < first.offset) {
        return first;
    }
    return {
        offset = first.offset, length = last_end - first.offset, line = first.line, column = first.column,
    };
}

fn parser_add_diagnostic(
    state: *ParserState, kind: lexer::DiagnosticKind, span: lexer::SourceSpan,
    expected: lexer::TokenKind, found: lexer::TokenKind, detail: usize) -> bool {
    if (state->error != runtime::Error.none) {
        return false;
    }
    let added: lexer::DiagnosticBufferResult =
        lexer::diagnostic_buffer_add(
            state->diagnostics, {
                kind = kind, span = span, expected = expected, found = found, detail = detail,
            });
    state->diagnostics = added.buffer;
    state->error = added.error;
    return added.error == runtime::Error.none;
}

fn parser_new_node(
    state: *ParserState, kind: SyntaxKind, span: lexer::SourceSpan, token_index: usize) -> usize {
    let none: usize = syntax_no_index();
    if (state->error != runtime::Error.none) {
        return none;
    }
    if (!syntax_tree_storage_is_valid(state->tree)) {
        state->error = runtime::Error.invalid_argument;
        return none;
    }
    if (state->tree.count >= ParserLimit.maximum_nodes as usize) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.resource_limit, span, lexer::TokenKind.invalid, state->current.kind,
            ParserLimit.maximum_nodes as usize);
        state->error = runtime::Error.out_of_memory;
        return none;
    }
    let node: SyntaxNode = {
        kind = kind, span = span, token_index = token_index, parent = none, first_child = none, last_child = none,
        next_sibling = none, child_count = 0, flags = SyntaxFlag.none as usize,
    };
    let appended: bytes::BufferResult = bytes::append(
        state->tree.storage, (&node) as *const SyntaxNode as *const u8, sizeof(SyntaxNode));
    state->tree.storage = appended.buffer;
    state->error = appended.error;
    if (appended.error != runtime::Error.none) {
        return none;
    }
    let index: usize = state->tree.count;
    state->tree.count += 1;
    return index;
}

fn parser_node_pointer(state: *ParserState, index: usize) -> *SyntaxNode {
    if (state->error != runtime::Error.none) {
        return null;
    }
    if (index >= state->tree.count) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return null;
    }
    let nodes: *SyntaxNode = state->tree.storage.data as *SyntaxNode;
    return &nodes[index];
}

fn parser_set_node_span(state: *ParserState, index: usize, span: lexer::SourceSpan) -> bool {
    let node: *SyntaxNode = parser_node_pointer(state, index);
    if (node == null) {
        return false;
    }
    node->span = span;
    return true;
}

fn parser_add_node_flags(state: *ParserState, index: usize, flags: usize) -> bool {
    let node: *SyntaxNode = parser_node_pointer(state, index);
    if (node == null) {
        return false;
    }
    node->flags |= flags;
    return true;
}

fn parser_add_child(state: *ParserState, parent_index: usize, child_index: usize) -> bool {
    let none: usize = syntax_no_index();
    if (state->error != runtime::Error.none) {
        return false;
    }
    if (parent_index >= state->tree.count || child_index >= state->tree.count || parent_index == child_index) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return false;
    }
    let nodes: *SyntaxNode = state->tree.storage.data as *SyntaxNode;
    if (nodes[child_index].parent != none || nodes[child_index].next_sibling != none ||
        nodes[parent_index].child_count == ParserLimit.maximum_size as usize) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return false;
    }
    if (nodes[parent_index].child_count == 0) {
        nodes[parent_index].first_child = child_index;
    } else {
        nodes[nodes[parent_index].last_child].next_sibling = child_index;
    }
    nodes[child_index].parent = parent_index;
    nodes[parent_index].last_child = child_index;
    nodes[parent_index].child_count += 1;
    return true;
}

fn parser_advance(state: *ParserState) -> void {
    if (state->error != runtime::Error.none) {
        return;
    }
    state->previous = state->current;
    while (state->cursor < state->tokens.count) {
        let token_result: lexer::TokenResult = lexer::token_buffer_get(state->tokens, state->cursor);
        if (token_result.error != runtime::Error.none) {
            state->error = token_result.error;
            return;
        }
        state->current = token_result.token;
        state->current_index = state->cursor;
        state->cursor += 1;
        if (state->current.kind != lexer::TokenKind.invalid) {
            return;
        }
    }
    state->error = runtime::Error.invalid_argument;
}

fn parser_check(state: *ParserState, kind: lexer::TokenKind) -> bool {
    return state->current.kind == kind;
}

fn parser_peek_kind(state: *ParserState) -> lexer::TokenKind {
    var cursor: usize = state->cursor;
    while (cursor < state->tokens.count) {
        let token_result: lexer::TokenResult = lexer::token_buffer_get(state->tokens, cursor);
        if (token_result.error != runtime::Error.none) {
            state->error = token_result.error;
            return lexer::TokenKind.invalid;
        }
        if (token_result.token.kind != lexer::TokenKind.invalid) {
            return token_result.token.kind;
        }
        cursor += 1;
    }
    return lexer::TokenKind.invalid;
}

fn parser_match(state: *ParserState, kind: lexer::TokenKind) -> bool {
    if (!parser_check(state, kind)) {
        return false;
    }
    if (kind != lexer::TokenKind.end) {
        parser_advance(state);
    }
    return true;
}

fn parser_expect(state: *ParserState, kind: lexer::TokenKind) -> bool {
    if (parser_match(state, kind)) {
        return true;
    }
    return parser_add_diagnostic(
        state, lexer::DiagnosticKind.expected_token, state->current.span, kind, state->current.kind, 0) && false;
}

fn parser_enter_nesting(state: *ParserState, span: lexer::SourceSpan) -> bool {
    if (state->nesting_depth >= ParserLimit.maximum_nesting as usize) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.nesting_limit, span, lexer::TokenKind.invalid, state->current.kind,
            state->nesting_depth);
        return false;
    }
    state->nesting_depth += 1;
    return true;
}

fn parser_leave_nesting(state: *ParserState) -> void {
    if (state->nesting_depth == 0) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return;
    }
    state->nesting_depth -= 1;
}

fn parser_is_builtin_type(kind: lexer::TokenKind) -> bool {
    var builtin: [15]lexer::TokenKind = {};
    builtin[0] = lexer::TokenKind.keyword_bool;
    builtin[1] = lexer::TokenKind.keyword_i8;
    builtin[2] = lexer::TokenKind.keyword_i16;
    builtin[3] = lexer::TokenKind.keyword_i32;
    builtin[4] = lexer::TokenKind.keyword_i64;
    builtin[5] = lexer::TokenKind.keyword_isize;
    builtin[6] = lexer::TokenKind.keyword_u8;
    builtin[7] = lexer::TokenKind.keyword_u16;
    builtin[8] = lexer::TokenKind.keyword_u32;
    builtin[9] = lexer::TokenKind.keyword_u64;
    builtin[10] = lexer::TokenKind.keyword_usize;
    builtin[11] = lexer::TokenKind.keyword_f32;
    builtin[12] = lexer::TokenKind.keyword_f64;
    builtin[13] = lexer::TokenKind.keyword_void;
    builtin[14] = lexer::TokenKind.keyword_va_list;
    var index: usize = 0;
    while (index < 15) {
        if (kind == builtin[index]) {
            return true;
        }
        index += 1;
    }
    return false;
}

fn parser_parse_integer_token(state: *ParserState, token: lexer::Token) -> bool {
    var index: usize = 0;
    var base: u64 = 10;
    if (token.span.length >= 2 && state->source.data[token.span.offset] == 48) {
        let prefix: u8 = state->source.data[token.span.offset + 1];
        if (prefix == 98 || prefix == 66) {
            base = 2;
            index = 2;
        } else if (prefix == 111 || prefix == 79) {
            base = 8;
            index = 2;
        } else if (prefix == 120 || prefix == 88) {
            base = 16;
            index = 2;
        }
    }

    var value: u64 = 0;
    var saw_digit: bool = false;
    var previous_separator: bool = false;
    while (index < token.span.length) {
        let byte: u8 = state->source.data[token.span.offset + index];
        if (byte == 95) {
            if (!saw_digit || previous_separator) {
                parser_add_diagnostic(
                    state, lexer::DiagnosticKind.invalid_integer, token.span, lexer::TokenKind.integer, token.kind,
                    1);
                return false;
            }
            previous_separator = true;
            index += 1;
            continue;
        }

        var digit: u64 = 16;
        if (byte >= 48 && byte <= 57) {
            digit = (byte - 48) as u64;
        } else if (byte >= 65 && byte <= 70) {
            digit = (byte - 65 + 10) as u64;
        } else if (byte >= 97 && byte <= 102) {
            digit = (byte - 97 + 10) as u64;
        }
        if (digit >= base) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_integer, token.span, lexer::TokenKind.integer, token.kind, 2);
            return false;
        }
        if (value > (18446744073709551615 - digit) / base) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_integer, token.span, lexer::TokenKind.integer, token.kind, 3);
            return false;
        }
        value = value * base + digit;
        saw_digit = true;
        previous_separator = false;
        index += 1;
    }
    if (!saw_digit || previous_separator) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.invalid_integer, token.span, lexer::TokenKind.integer, token.kind, 4);
        return false;
    }
    return true;
}

fn parser_is_hex_digit(byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102);
}

fn parser_scan_float_digits(
    state: *ParserState, token: lexer::Token, start: usize, hexadecimal: bool) -> usize {
    var index: usize = start;
    var saw_digit: bool = false;
    var previous_separator: bool = false;
    while (index < token.span.length) {
        let byte: u8 = state->source.data[token.span.offset + index];
        if ((hexadecimal && parser_is_hex_digit(byte)) || (!hexadecimal && byte >= 48 && byte <= 57)) {
            saw_digit = true;
            previous_separator = false;
            index += 1;
            continue;
        }
        if (byte == 95) {
            if (!saw_digit || previous_separator || index + 1 >= token.span.length) {
                return syntax_no_index();
            }
            let next: u8 = state->source.data[token.span.offset + index + 1];
            if (!parser_is_hex_digit(next) && (hexadecimal || next < 48 || next > 57)) {
                return syntax_no_index();
            }
            previous_separator = true;
            index += 1;
            continue;
        }
        break;
    }
    if (!saw_digit || previous_separator) {
        return syntax_no_index();
    }
    return index;
}

fn parser_validate_hex_float(state: *ParserState, token: lexer::Token) -> bool {
    let none: usize = syntax_no_index();
    var index: usize = 2;
    var saw_mantissa: bool = false;
    let integer_end: usize = parser_scan_float_digits(state, token, index, true);
    if (integer_end != none) {
        saw_mantissa = true;
        index = integer_end;
    }
    if (index < token.span.length && state->source.data[token.span.offset + index] == 46) {
        let fraction_end: usize = parser_scan_float_digits(state, token, index + 1, true);
        if (fraction_end == none) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_floating, token.span, lexer::TokenKind.floating, token.kind, 0);
            return false;
        }
        saw_mantissa = true;
        index = fraction_end;
    }
    var valid: bool = saw_mantissa;
    if (valid && index < token.span.length) {
        let exponent: u8 = state->source.data[token.span.offset + index];
        if (exponent == 112 || exponent == 80) {
            index += 1;
            if (index < token.span.length) {
                let sign: u8 = state->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    index += 1;
                }
            }
            index = parser_scan_float_digits(state, token, index, false);
            valid = index == token.span.length;
        } else {
            valid = false;
        }
    } else {
        valid = false;
    }
    if (!valid) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.invalid_floating, token.span, lexer::TokenKind.floating, token.kind, 0);
        return false;
    }
    return true;
}

fn parser_validate_float(state: *ParserState, token: lexer::Token) -> bool {
    if (token.span.length >= 2 && state->source.data[token.span.offset] == 48 &&
        (state->source.data[token.span.offset + 1] == 120 || state->source.data[token.span.offset + 1] == 88)) {
        return parser_validate_hex_float(state, token);
    }
    let none: usize = syntax_no_index();
    var index: usize = parser_scan_float_digits(state, token, 0, false);
    var has_fraction: bool = false;
    var has_exponent: bool = false;
    if (index != none && index < token.span.length && state->source.data[token.span.offset + index] == 46) {
        has_fraction = true;
        index = parser_scan_float_digits(state, token, index + 1, false);
    }
    if (index != none && index < token.span.length) {
        let exponent: u8 = state->source.data[token.span.offset + index];
        if (exponent == 101 || exponent == 69) {
            has_exponent = true;
            index += 1;
            if (index < token.span.length) {
                let sign: u8 = state->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    index += 1;
                }
            }
            index = parser_scan_float_digits(state, token, index, false);
        }
    }
    if (index == none || index != token.span.length || (!has_fraction && !has_exponent)) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.invalid_floating, token.span, lexer::TokenKind.floating, token.kind, 0);
        return false;
    }
    return true;
}

// Parses the `:: segment` tail of a qualified path after the first
// identifier. The node's token_index names the last segment; every preceding
// segment becomes a name_expression child in source order, so qualified
// names need no new node kinds. Sema accepts exactly one qualifier segment
// and diagnoses longer chains itself (parse errors are not diagnosable).
fn parser_parse_qualified_name(
    state: *ParserState, first: lexer::Token, first_index: usize, kind: SyntaxKind) -> usize {
    let node: usize = parser_new_node(state, kind, first.span, first_index);
    var segment: lexer::Token = first;
    var segment_index: usize = first_index;
    while (state->error == runtime::Error.none && state->current.kind == lexer::TokenKind.colon_colon) {
        parser_advance(state);
        let name: lexer::Token = state->current;
        let name_index: usize = state->current_index;
        if (!parser_expect(
                state, lexer::TokenKind.identifier)) {
            break;
        }
        parser_add_child(
            state, node,
            parser_new_node(state, SyntaxKind.name_expression, segment.span, segment_index));
        segment = name;
        segment_index = name_index;
        let pointer: *SyntaxNode = parser_node_pointer(state, node);
        if (pointer == null) {
            return syntax_no_index();
        }
        pointer->token_index = name_index;
        parser_set_node_span(state, node, parser_join_spans(first.span, name.span));
    }
    return node;
}

fn parser_parse_type(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let start: lexer::Token = state->current;
    let start_index: usize = state->current_index;
    if (!parser_enter_nesting(state, start.span)) {
        return none;
    }

    if (parser_match(
            state, lexer::TokenKind.keyword_fn)) {
        let node: usize = parser_new_node(state, SyntaxKind.type_function, start.span, start_index);
        parser_expect(state, lexer::TokenKind.left_parenthesis);
        if (state->current.kind != lexer::TokenKind.right_parenthesis) {
            while (state->error == runtime::Error.none) {
                // A `...` tail marks a variadic signature; the semantic layer
                // rejects it on every non-function mount (fn-pointer types
                // included) with invalid_variadic.
                if (state->current.kind == lexer::TokenKind.dot_dot_dot) {
                    parser_advance(state);
                    parser_add_node_flags(state, node, SyntaxFlag.variadic as usize);
                    break;
                }
                let parameter: usize = parser_parse_type(state);
                if (parameter != none) {
                    parser_add_child(state, node, parameter);
                }
                if (!parser_match(
                        state, lexer::TokenKind.comma)) {
                    break;
                }
            }
        }
        parser_expect(state, lexer::TokenKind.right_parenthesis);
        if (parser_match(
                state, lexer::TokenKind.arrow)) {
            parser_add_node_flags(state, node, SyntaxFlag.has_return_type as usize);
            let return_type: usize = parser_parse_type(state);
            if (return_type != none) {
                parser_add_child(state, node, return_type);
            }
        }
        parser_leave_nesting(state);
        return node;
    }

    if (parser_match(state, lexer::TokenKind.star)) {
        let node: usize = parser_new_node(state, SyntaxKind.type_pointer, start.span, start_index);
        var seen_const: bool = false;
        var seen_volatile: bool = false;
        var qualifiers_done: bool = false;
        while (!qualifiers_done && state->error == runtime::Error.none) {
            if (state->current.kind == lexer::TokenKind.keyword_const) {
                if (seen_const) {
                    parser_add_diagnostic(
                        state, lexer::DiagnosticKind.expected_type, state->current.span,
                        lexer::TokenKind.identifier, state->current.kind, 0);
                    qualifiers_done = true;
                } else {
                    seen_const = true;
                    parser_add_node_flags(state, node, SyntaxFlag.read_only as usize);
                    parser_advance(state);
                }
            } else if (state->current.kind == lexer::TokenKind.keyword_volatile) {
                if (seen_volatile) {
                    parser_add_diagnostic(
                        state, lexer::DiagnosticKind.expected_type, state->current.span,
                        lexer::TokenKind.identifier, state->current.kind, 0);
                    qualifiers_done = true;
                } else {
                    seen_volatile = true;
                    parser_add_node_flags(state, node, SyntaxFlag.volatile_ as usize);
                    parser_advance(state);
                }
            } else {
                qualifiers_done = true;
            }
        }
        let pointee: usize = parser_parse_type(state);
        if (pointee != none) {
            parser_add_child(state, node, pointee);
            let pointee_node: *SyntaxNode = parser_node_pointer(state, pointee);
            if (pointee_node != null) {
                parser_set_node_span(
                    state, node, parser_join_spans(start.span, pointee_node->span));
            }
        }
        parser_leave_nesting(state);
        return node;
    }

    if (parser_match(
            state, lexer::TokenKind.left_bracket)) {
        let node: usize = parser_new_node(state, SyntaxKind.type_array, start.span, start_index);
        if (state->current.kind == lexer::TokenKind.question) {
            parser_add_node_flags(state, node, SyntaxFlag.flexible as usize);
            parser_advance(state);
        } else {
            let count_expression: usize = parser_parse_expression(state);
            if (count_expression != none) {
                parser_add_child(state, node, count_expression);
            }
        }
        parser_expect(state, lexer::TokenKind.right_bracket);
        let element: usize = parser_parse_type(state);
        if (element != none) {
            parser_add_child(state, node, element);
            let element_node: *SyntaxNode = parser_node_pointer(state, element);
            if (element_node != null) {
                parser_set_node_span(
                    state, node, parser_join_spans(start.span, element_node->span));
            }
        }
        parser_leave_nesting(state);
        return node;
    }

    var kind: SyntaxKind = SyntaxKind.invalid;
    if (state->current.kind == lexer::TokenKind.identifier) {
        kind = SyntaxKind.type_named;
    } else if (parser_is_builtin_type(
            state->current.kind)) {
        kind = SyntaxKind.type_builtin;
    }
    if (kind == SyntaxKind.invalid) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.expected_type, state->current.span, lexer::TokenKind.identifier,
            state->current.kind, 0);
        if (state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
        parser_leave_nesting(state);
        return parser_new_node(state, SyntaxKind.invalid, start.span, start_index);
    }

    if (kind == SyntaxKind.type_named) {
        let named: lexer::Token = state->current;
        let named_index: usize = state->current_index;
        parser_advance(state);
        let named_node: usize = parser_parse_qualified_name(state, named, named_index, kind);
        parser_leave_nesting(state);
        return named_node;
    }

    let node: usize = parser_new_node(state, kind, state->current.span, state->current_index);
    parser_advance(state);
    parser_leave_nesting(state);
    return node;
}

fn parser_parse_expression(state: *ParserState) -> usize {
    return parser_parse_conditional_expression(state);
}

fn parser_parse_aggregate_initializer(
    state: *ParserState, left_brace: lexer::Token, left_brace_index: usize) -> usize {
    let none: usize = syntax_no_index();
    if (parser_match(
            state, lexer::TokenKind.right_brace)) {
        return parser_new_node(
            state, SyntaxKind.zero_initializer,
            parser_join_spans(left_brace.span, state->previous.span), left_brace_index);
    }

    let initializer: usize = parser_new_node(
        state, SyntaxKind.aggregate_initializer, left_brace.span, left_brace_index);
    if (!parser_enter_nesting(
            state, left_brace.span)) {
        return initializer;
    }
    while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
        state->current.kind != lexer::TokenKind.end) {
        let offset_before: usize = state->current.span.offset;
        if (state->current.kind == lexer::TokenKind.left_bracket) {
            let bracket: lexer::Token = state->current;
            let bracket_index: usize = state->current_index;
            parser_advance(state);
            let element: usize = parser_new_node(
                state, SyntaxKind.initializer_element, bracket.span, bracket_index);
            parser_add_node_flags(state, element, SyntaxFlag.indexed as usize);
            let index: usize = parser_parse_expression(state);
            if (index != none) {
                parser_add_child(state, element, index);
            }
            parser_expect(state, lexer::TokenKind.right_bracket);
            parser_expect(state, lexer::TokenKind.equal);
            let indexed_value: usize = parser_parse_expression(state);
            if (indexed_value != none) {
                parser_add_child(state, element, indexed_value);
                let value_node: *SyntaxNode = parser_node_pointer(state, indexed_value);
                if (value_node != null) {
                    parser_set_node_span(
                        state, element, parser_join_spans(bracket.span, value_node->span));
                }
            }
            parser_add_child(state, initializer, element);
        } else if (state->current.kind == lexer::TokenKind.identifier &&
            parser_token_at(state, state->current_index + 1).kind == lexer::TokenKind.equal) {
            let name: lexer::Token = state->current;
            let name_index: usize = state->current_index;
            parser_advance(state);
            let field: usize = parser_new_node(
                state, SyntaxKind.initializer_field, name.span, name_index);
            parser_expect(state, lexer::TokenKind.equal);
            let value: usize = parser_parse_expression(state);
            if (value != none) {
                parser_add_child(state, field, value);
                let value_node: *SyntaxNode = parser_node_pointer(state, value);
                if (value_node != null) {
                    parser_set_node_span(
                        state, field, parser_join_spans(name.span, value_node->span));
                }
            }
            parser_add_child(state, initializer, field);
        } else {
            let value_index: usize = state->current_index;
            let value: usize = parser_parse_expression(state);
            if (value != none) {
                let value_node: *SyntaxNode = parser_node_pointer(state, value);
                let element: usize = parser_new_node(
                    state, SyntaxKind.initializer_element,
                    value_node == null ? state->previous.span : value_node->span, value_index);
                parser_add_child(state, element, value);
                parser_add_child(state, initializer, element);
            } else if (state->current.kind != lexer::TokenKind.end) {
                parser_advance(state);
            }
        }

        if (!parser_match(
                state, lexer::TokenKind.comma)) {
            break;
        }
        if (state->current.kind == lexer::TokenKind.right_brace) {
            break;
        }
        if (state->current.span.offset == offset_before && state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
    }
    parser_expect(state, lexer::TokenKind.right_brace);
    parser_set_node_span(
        state, initializer, parser_join_spans(left_brace.span, state->previous.span));
    parser_leave_nesting(state);
    return initializer;
}

fn parser_parse_call(
    state: *ParserState, callee: usize, left_parenthesis: lexer::Token, left_parenthesis_index: usize
) -> usize {
    let none: usize = syntax_no_index();
    let callee_node: *SyntaxNode = parser_node_pointer(state, callee);
    let start_span: lexer::SourceSpan = callee_node == null ? left_parenthesis.span : callee_node->span;
    let call: usize = parser_new_node(
        state, SyntaxKind.call_expression, start_span, left_parenthesis_index);
    parser_add_child(state, call, callee);
    if (!parser_enter_nesting(
            state, left_parenthesis.span)) {
        return call;
    }
    if (state->current.kind != lexer::TokenKind.right_parenthesis) {
        while (state->error == runtime::Error.none) {
            let argument: usize = parser_parse_expression(state);
            if (argument != none) {
                parser_add_child(state, call, argument);
            }
            if (!parser_match(
                    state, lexer::TokenKind.comma)) {
                break;
            }
        }
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_set_node_span(state, call, parser_join_spans(start_span, state->previous.span));
    parser_leave_nesting(state);
    return call;
}

fn parser_parse_intrinsic_expression(state: *ParserState, at_sign: lexer::Token) -> usize {
    let none: usize = syntax_no_index();
    let name_index: usize = state->current_index;
    let intrinsic: usize = parser_new_node(
        state, SyntaxKind.intrinsic_expression, at_sign.span, name_index);
    if (parser_expect(
            state, lexer::TokenKind.identifier) &&
        parser_expect(
            state, lexer::TokenKind.left_parenthesis)) {
        if (!parser_enter_nesting(
                state, at_sign.span)) {
            return intrinsic;
        }
        if (state->current.kind != lexer::TokenKind.right_parenthesis) {
            while (state->error == runtime::Error.none) {
                let argument: usize = parser_parse_expression(state);
                if (argument != none) {
                    parser_add_child(state, intrinsic, argument);
                }
                if (!parser_match(
                        state, lexer::TokenKind.comma)) {
                    break;
                }
            }
        }
        parser_expect(state, lexer::TokenKind.right_parenthesis);
        parser_leave_nesting(state);
    }
    parser_set_node_span(
        state, intrinsic, parser_join_spans(at_sign.span, state->previous.span));
    return intrinsic;
}

fn parser_parse_layout_query(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    if (!parser_enter_nesting(
            state, keyword.span)) {
        return syntax_no_index();
    }
    var kind: SyntaxKind = SyntaxKind.sizeof_expression;
    if (keyword.kind == lexer::TokenKind.keyword_alignof) {
        kind = SyntaxKind.alignof_expression;
    } else if (keyword.kind == lexer::TokenKind.keyword_offsetof) {
        kind = SyntaxKind.offsetof_expression;
    }
    let query: usize = parser_new_node(state, kind, keyword.span, keyword_index);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    var operand: usize = syntax_no_index();
    if (state->current.kind == lexer::TokenKind.at_sign) {
        // A layout query also takes an intrinsic operand (e.g. sizeof(@embed("path"))); the semantic
        // pass then reads the layout of the lowered expression's type instead of a type node.
        let at_sign: lexer::Token = state->current;
        parser_advance(state);
        operand = parser_parse_intrinsic_expression(state, at_sign);
    } else {
        operand = parser_parse_type(state);
    }
    if (operand != syntax_no_index()) {
        parser_add_child(state, query, operand);
    }
    if (keyword.kind == lexer::TokenKind.keyword_offsetof) {
        parser_expect(state, lexer::TokenKind.comma);
        let member: lexer::Token = state->current;
        let member_index: usize = state->current_index;
        if (parser_expect(
                state, lexer::TokenKind.identifier)) {
            let member_node: usize = parser_new_node(
                state, SyntaxKind.name_expression, member.span, member_index);
            parser_add_child(state, query, member_node);
        }
        while (parser_match(state, lexer::TokenKind.dot)) {
            let nested: lexer::Token = state->current;
            let nested_index: usize = state->current_index;
            if (!parser_expect(
                    state, lexer::TokenKind.identifier)) {
                break;
            }
            let nested_node: usize = parser_new_node(
                state, SyntaxKind.name_expression, nested.span, nested_index);
            parser_add_child(state, query, nested_node);
        }
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_set_node_span(state, query, parser_join_spans(keyword.span, state->previous.span));
    parser_leave_nesting(state);
    return query;
}

fn parser_parse_va_arg_expression(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    if (!parser_enter_nesting(
            state, keyword.span)) {
        return syntax_no_index();
    }
    let query: usize =
        parser_new_node(state, SyntaxKind.va_arg_expression, keyword.span, keyword_index);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let list_expression: usize = parser_parse_expression(state);
    if (list_expression != syntax_no_index()) {
        parser_add_child(state, query, list_expression);
    }
    parser_expect(state, lexer::TokenKind.comma);
    let type_node: usize = parser_parse_type(state);
    if (type_node != syntax_no_index()) {
        parser_add_child(state, query, type_node);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_set_node_span(state, query, parser_join_spans(keyword.span, state->previous.span));
    parser_leave_nesting(state);
    return query;
}

fn parser_parse_primary_expression(state: *ParserState) -> usize {
    let token: lexer::Token = state->current;
    let token_index: usize = state->current_index;
    if (token.kind == lexer::TokenKind.keyword_va_arg) {
        parser_advance(state);
        return parser_parse_va_arg_expression(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_sizeof || token.kind == lexer::TokenKind.keyword_alignof ||
        token.kind == lexer::TokenKind.keyword_offsetof) {
        parser_advance(state);
        return parser_parse_layout_query(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.at_sign) {
        parser_advance(state);
        return parser_parse_intrinsic_expression(state, token);
    }
    if (token.kind == lexer::TokenKind.integer) {
        parser_advance(state);
        parser_parse_integer_token(state, token);
        return parser_new_node(state, SyntaxKind.integer_expression, token.span, token_index);
    }
    if (token.kind == lexer::TokenKind.floating) {
        parser_advance(state);
        parser_validate_float(state, token);
        return parser_new_node(state, SyntaxKind.floating_expression, token.span, token_index);
    }
    if (token.kind == lexer::TokenKind.character) {
        parser_advance(state);
        return parser_new_node(state, SyntaxKind.character_expression, token.span, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_true || token.kind == lexer::TokenKind.keyword_false) {
        parser_advance(state);
        return parser_new_node(state, SyntaxKind.boolean_expression, token.span, token_index);
    }
    if (token.kind == lexer::TokenKind.string || token.kind == lexer::TokenKind.string_u16 ||
        token.kind == lexer::TokenKind.string_u32) {
        parser_advance(state);
        let node: usize =
            parser_new_node(state, SyntaxKind.string_expression, token.span, token_index);
        while (state->current.kind == lexer::TokenKind.string ||
            state->current.kind == lexer::TokenKind.string_u16 ||
            state->current.kind == lexer::TokenKind.string_u32) {
            let part: lexer::Token = state->current;
            let part_index: usize = state->current_index;
            parser_advance(state);
            parser_add_child(
                state, node,
                parser_new_node(state, SyntaxKind.string_expression, part.span, part_index));
            parser_set_node_span(state, node, parser_join_spans(token.span, state->previous.span));
        }
        return node;
    }
    if (token.kind == lexer::TokenKind.keyword_null) {
        parser_advance(state);
        return parser_new_node(state, SyntaxKind.null_expression, token.span, token_index);
    }
    if (token.kind == lexer::TokenKind.left_brace) {
        parser_advance(state);
        return parser_parse_aggregate_initializer(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.identifier) {
        parser_advance(state);
        return parser_parse_qualified_name(state, token, token_index, SyntaxKind.name_expression);
    }
    if (token.kind == lexer::TokenKind.left_parenthesis) {
        parser_advance(state);
        if (!parser_enter_nesting(
                state, token.span)) {
            return syntax_no_index();
        }
        let expression: usize = parser_parse_expression(state);
        parser_expect(state, lexer::TokenKind.right_parenthesis);
        let node: usize = parser_new_node(
            state, SyntaxKind.parenthesized_expression,
            parser_join_spans(token.span, state->previous.span), token_index);
        if (expression != syntax_no_index()) {
            parser_add_child(state, node, expression);
        }
        parser_leave_nesting(state);
        return node;
    }

    parser_add_diagnostic(
        state, lexer::DiagnosticKind.expected_expression, token.span, lexer::TokenKind.identifier, token.kind, 0);
    if (token.kind != lexer::TokenKind.end) {
        parser_advance(state);
    }
    return parser_new_node(state, SyntaxKind.invalid, token.span, token_index);
}

fn parser_parse_postfix_expression(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    var expression: usize = parser_parse_primary_expression(state);
    while (expression != none && state->error == runtime::Error.none) {
        if (state->current.kind == lexer::TokenKind.left_parenthesis) {
            let operator: lexer::Token = state->current;
            let operator_index: usize = state->current_index;
            parser_advance(state);
            expression = parser_parse_call(state, expression, operator, operator_index);
            continue;
        }
        if (state->current.kind == lexer::TokenKind.left_bracket) {
            let operator: lexer::Token = state->current;
            let operator_index: usize = state->current_index;
            parser_advance(state);
            if (!parser_enter_nesting(
                    state, operator.span)) {
                return expression;
            }
            let index: usize = parser_parse_expression(state);
            parser_expect(state, lexer::TokenKind.right_bracket);
            let expression_node: *SyntaxNode = parser_node_pointer(state, expression);
            let start_span: lexer::SourceSpan = expression_node == null ? operator.span : expression_node->span;
            let indexed: usize = parser_new_node(
                state, SyntaxKind.index_expression,
                parser_join_spans(start_span, state->previous.span), operator_index);
            parser_add_child(state, indexed, expression);
            if (index != none) {
                parser_add_child(state, indexed, index);
            }
            parser_leave_nesting(state);
            expression = indexed;
            continue;
        }
        if (state->current.kind == lexer::TokenKind.dot || state->current.kind == lexer::TokenKind.arrow) {
            let operator: lexer::Token = state->current;
            let operator_index: usize = state->current_index;
            parser_advance(state);
            let name: lexer::Token = state->current;
            let name_index: usize = state->current_index;
            let expression_node: *SyntaxNode = parser_node_pointer(state, expression);
            let start_span: lexer::SourceSpan = expression_node == null ? operator.span : expression_node->span;
            let member: usize = parser_new_node(
                state, SyntaxKind.member_expression, start_span, operator_index);
            parser_add_child(state, member, expression);
            if (parser_expect(
                    state, lexer::TokenKind.identifier)) {
                let name_node: usize = parser_new_node(
                    state, SyntaxKind.name_expression, name.span, name_index);
                parser_add_child(state, member, name_node);
                parser_set_node_span(state, member, parser_join_spans(start_span, name.span));
            }
            expression = member;
            continue;
        }
        break;
    }
    return expression;
}

fn parser_is_unary_operator(kind: lexer::TokenKind) -> bool {
    return kind == lexer::TokenKind.plus || kind == lexer::TokenKind.minus || kind == lexer::TokenKind.bang ||
        kind == lexer::TokenKind.tilde || kind == lexer::TokenKind.star || kind == lexer::TokenKind.ampersand;
}

fn parser_parse_unary_expression(state: *ParserState) -> usize {
    if (!parser_is_unary_operator(
            state->current.kind)) {
        return parser_parse_postfix_expression(state);
    }
    let operator: lexer::Token = state->current;
    let operator_index: usize = state->current_index;
    if (!parser_enter_nesting(
            state, operator.span)) {
        return syntax_no_index();
    }
    parser_advance(state);
    let operand: usize = parser_parse_unary_expression(state);
    parser_leave_nesting(state);
    let node: usize = parser_new_node(
        state, SyntaxKind.unary_expression, operator.span, operator_index);
    if (operand != syntax_no_index()) {
        parser_add_child(state, node, operand);
        let operand_node: *SyntaxNode = parser_node_pointer(state, operand);
        if (operand_node != null) {
            parser_set_node_span(state, node, parser_join_spans(operator.span, operand_node->span));
        }
    }
    return node;
}

fn parser_parse_cast_expression(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    var expression: usize = parser_parse_unary_expression(state);
    while (expression != none && state->current.kind == lexer::TokenKind.keyword_as) {
        let operator: lexer::Token = state->current;
        let operator_index: usize = state->current_index;
        parser_advance(state);
        let target: usize = parser_parse_type(state);
        let expression_node: *SyntaxNode = parser_node_pointer(state, expression);
        var target_node: *SyntaxNode = null;
        if (target != none) {
            target_node = parser_node_pointer(state, target);
        }
        var span: lexer::SourceSpan = operator.span;
        if (expression_node != null && target_node != null) {
            span = parser_join_spans(expression_node->span, target_node->span);
        }
        let cast: usize = parser_new_node(state, SyntaxKind.cast_expression, span, operator_index);
        parser_add_child(state, cast, expression);
        if (target != none) {
            parser_add_child(state, cast, target);
        }
        expression = cast;
    }
    return expression;
}

fn parser_binary_precedence(kind: lexer::TokenKind) -> usize {
    if (kind == lexer::TokenKind.logical_or) {
        return 1;
    }
    if (kind == lexer::TokenKind.logical_and) {
        return 2;
    }
    if (kind == lexer::TokenKind.pipe) {
        return 3;
    }
    if (kind == lexer::TokenKind.caret) {
        return 4;
    }
    if (kind == lexer::TokenKind.ampersand) {
        return 5;
    }
    if (kind == lexer::TokenKind.equal_equal || kind == lexer::TokenKind.bang_equal) {
        return 6;
    }
    if (kind == lexer::TokenKind.less || kind == lexer::TokenKind.less_equal ||
        kind == lexer::TokenKind.greater || kind == lexer::TokenKind.greater_equal) {
        return 7;
    }
    if (kind == lexer::TokenKind.shift_left || kind == lexer::TokenKind.shift_right) {
        return 8;
    }
    if (kind == lexer::TokenKind.plus || kind == lexer::TokenKind.minus) {
        return 9;
    }
    if (kind == lexer::TokenKind.star || kind == lexer::TokenKind.slash || kind == lexer::TokenKind.percent) {
        return 10;
    }
    return 0;
}

fn parser_parse_binary_expression(state: *ParserState, minimum_precedence: usize) -> usize {
    let none: usize = syntax_no_index();
    var left: usize = parser_parse_cast_expression(state);
    if (left == none) {
        return none;
    }
    while (state->error == runtime::Error.none) {
        let precedence: usize = parser_binary_precedence(state->current.kind);
        if (precedence < minimum_precedence) {
            break;
        }
        let operator: lexer::Token = state->current;
        let operator_index: usize = state->current_index;
        parser_advance(state);
        let right: usize = parser_parse_binary_expression(state, precedence + 1);
        if (right == none) {
            return left;
        }
        let left_node: *SyntaxNode = parser_node_pointer(state, left);
        let right_node: *SyntaxNode = parser_node_pointer(state, right);
        var span: lexer::SourceSpan = operator.span;
        if (left_node != null && right_node != null) {
            span = parser_join_spans(left_node->span, right_node->span);
        }
        let binary: usize = parser_new_node(
            state, SyntaxKind.binary_expression, span, operator_index);
        parser_add_child(state, binary, left);
        parser_add_child(state, binary, right);
        left = binary;
    }
    return left;
}

fn parser_parse_conditional_expression(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let condition: usize = parser_parse_binary_expression(state, 1);
    if (condition == none || state->current.kind != lexer::TokenKind.question) {
        return condition;
    }
    let question: lexer::Token = state->current;
    let question_index: usize = state->current_index;
    parser_advance(state);
    if (!parser_enter_nesting(
            state, question.span)) {
        return condition;
    }
    let then_expression: usize = parser_parse_expression(state);
    parser_expect(state, lexer::TokenKind.colon);
    let else_expression: usize = parser_parse_conditional_expression(state);
    parser_leave_nesting(state);
    let condition_node: *SyntaxNode = parser_node_pointer(state, condition);
    var else_node: *SyntaxNode = null;
    if (else_expression != none) {
        else_node = parser_node_pointer(state, else_expression);
    }
    var span: lexer::SourceSpan = question.span;
    if (condition_node != null && else_node != null) {
        span = parser_join_spans(condition_node->span, else_node->span);
    }
    let conditional: usize = parser_new_node(
        state, SyntaxKind.conditional_expression, span, question_index);
    parser_add_child(state, conditional, condition);
    if (then_expression != none) {
        parser_add_child(state, conditional, then_expression);
    }
    if (else_expression != none) {
        parser_add_child(state, conditional, else_expression);
    }
    return conditional;
}

fn parser_is_assignment_operator(kind: lexer::TokenKind) -> bool {
    return kind == lexer::TokenKind.equal || kind == lexer::TokenKind.plus_equal ||
        kind == lexer::TokenKind.minus_equal || kind == lexer::TokenKind.star_equal ||
        kind == lexer::TokenKind.slash_equal || kind == lexer::TokenKind.percent_equal ||
        kind == lexer::TokenKind.ampersand_equal || kind == lexer::TokenKind.pipe_equal ||
        kind == lexer::TokenKind.caret_equal || kind == lexer::TokenKind.shift_left_equal ||
        kind == lexer::TokenKind.shift_right_equal;
}

fn parser_parse_expression_statement(state: *ParserState, terminator: lexer::TokenKind) -> usize {
    let none: usize = syntax_no_index();
    let expression: usize = parser_parse_expression(state);
    if (expression == none) {
        return none;
    }
    if (parser_is_assignment_operator(
            state->current.kind)) {
        let operator: lexer::Token = state->current;
        let operator_index: usize = state->current_index;
        parser_advance(state);
        let value: usize = parser_parse_expression(state);
        parser_expect(state, terminator);
        let expression_node: *SyntaxNode = parser_node_pointer(state, expression);
        let start_span: lexer::SourceSpan = expression_node == null ? operator.span : expression_node->span;
        let assignment: usize = parser_new_node(
            state, SyntaxKind.assignment_statement,
            parser_join_spans(start_span, state->previous.span), operator_index);
        parser_add_child(state, assignment, expression);
        if (value != none) {
            parser_add_child(state, assignment, value);
        }
        return assignment;
    }

    parser_expect(state, terminator);
    let expression_node: *SyntaxNode = parser_node_pointer(state, expression);
    let span: lexer::SourceSpan = expression_node == null ? state->previous.span :
            parser_join_spans(expression_node->span, state->previous.span);
    let statement: usize = parser_new_node(
        state, SyntaxKind.expression_statement, span, expression_node == null ? syntax_no_index() :
            expression_node->token_index);
    parser_add_child(state, statement, expression);
    return statement;
}

fn parser_parse_attributes(
    state: *ParserState, first_attribute: *usize, attribute_count: *usize) -> bool {
    let none: usize = syntax_no_index();
    if (first_attribute == null || attribute_count == null) {
        return false;
    }
    *first_attribute = none;
    *attribute_count = 0;
    while (state->error == runtime::Error.none && state->current.kind == lexer::TokenKind.at_sign) {
        let at_token: lexer::Token = state->current;
        parser_advance(state);
        let name: lexer::Token = state->current;
        let name_index: usize = state->current_index;
        if (!parser_expect(
                state, lexer::TokenKind.identifier)) {
            return false;
        }
        let attribute: usize = parser_new_node(
            state, SyntaxKind.attribute, parser_join_spans(at_token.span, name.span), name_index);
        if (attribute == none) {
            return false;
        }
        if (*attribute_count == 0) {
            *first_attribute = attribute;
        }
        *attribute_count += 1;
        if (parser_match(
                state, lexer::TokenKind.left_parenthesis)) {
            if (state->current.kind != lexer::TokenKind.right_parenthesis) {
                while (state->error == runtime::Error.none) {
                    var argument: usize = none;
                    if (state->current.kind == lexer::TokenKind.identifier &&
                        parser_token_at(state, state->current_index + 1).kind == lexer::TokenKind.colon) {
                        let argument_name: lexer::Token = state->current;
                        let argument_name_index: usize = state->current_index;
                        parser_advance(state);
                        parser_advance(state);
                        let argument_value: usize = parser_parse_expression(state);
                        if (argument_value == none) {
                            return false;
                        }
                        argument = parser_new_node(
                            state, SyntaxKind.named_argument,
                            parser_join_spans(argument_name.span, state->previous.span), argument_name_index);
                        if (argument == none) {
                            return false;
                        }
                        parser_add_child(state, argument, argument_value);
                    } else {
                        argument = parser_parse_expression(state);
                    }
                    if (argument == none) {
                        return false;
                    }
                    parser_add_child(state, attribute, argument);
                    if (!parser_match(
                            state, lexer::TokenKind.comma)) {
                        break;
                    }
                }
            }
            if (!parser_expect(
                    state, lexer::TokenKind.right_parenthesis)) {
                return false;
            }
            parser_add_node_flags(state, attribute, SyntaxFlag.has_arguments as usize);
            parser_set_node_span(
                state, attribute, parser_join_spans(at_token.span, state->previous.span));
        }
    }
    return state->error == runtime::Error.none;
}

fn parser_attach_attributes(
    state: *ParserState, declaration: usize, first_attribute: usize, attribute_count: usize) -> bool {
    var index: usize = 0;
    while (index < attribute_count) {
        if (!parser_add_child(state, declaration, first_attribute + index)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn parser_parse_variable_declaration(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize, is_mutable: bool,
    is_volatile: bool, first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = syntax_no_index();
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.identifier);
    let declaration: usize = parser_new_node(
        state, SyntaxKind.variable_declaration, keyword.span, name_index);
    if (is_mutable) {
        parser_add_node_flags(state, declaration, SyntaxFlag.mutable_binding as usize);
    }
    if (is_volatile) {
        parser_add_node_flags(state, declaration, SyntaxFlag.volatile_ as usize);
    }
    if (parser_match(state, lexer::TokenKind.colon)) {
        let type_node: usize = parser_parse_type(state);
        if (type_node != none) {
            parser_add_child(state, declaration, type_node);
        }
    } else {
        parser_add_node_flags(state, declaration, SyntaxFlag.inferred_type as usize);
    }
    parser_expect(state, lexer::TokenKind.equal);
    let initializer: usize = parser_parse_expression(state);
    if (initializer != none) {
        parser_add_child(state, declaration, initializer);
    }
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    parser_set_node_span(state, declaration, parser_join_spans(keyword.span, state->previous.span));
    return declaration;
}

fn parser_parse_const_declaration(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize, flags: usize,
    first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = syntax_no_index();
    if ((flags & (SyntaxFlag.external as usize)) != 0) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.invalid_external_declaration, keyword.span,
            lexer::TokenKind.keyword_fn, lexer::TokenKind.identifier, 0);
    }
    parser_advance(state);
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.identifier);
    let declaration: usize = parser_new_node(
        state, SyntaxKind.const_declaration, keyword.span, name_index);
    parser_add_node_flags(state, declaration, flags);
    parser_expect(state, lexer::TokenKind.colon);
    let type_node: usize = parser_parse_type(state);
    if (type_node != none) {
        parser_add_child(state, declaration, type_node);
    }
    parser_expect(state, lexer::TokenKind.equal);
    let initializer: usize = parser_parse_expression(state);
    if (initializer != none) {
        parser_add_child(state, declaration, initializer);
    }
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    parser_set_node_span(state, declaration, parser_join_spans(keyword.span, state->previous.span));
    return declaration;
}

// An asm fn body is one or more adjacent string literals between braces
// and nothing else (no semicolons; m1.4 concatenation keeps long bodies
// readable). Non-string content is carried as an invalid node so the
// semantic pass rejects it with invalid_asm_function instead of the parse
// failing here.
fn parser_parse_asm_body(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let left_brace: lexer::Token = state->current;
    if (!parser_expect(
            state, lexer::TokenKind.left_brace)) {
        return none;
    }
    if (!parser_enter_nesting(
            state, left_brace.span)) {
        return none;
    }
    var body: usize = none;
    if (state->current.kind == lexer::TokenKind.string || state->current.kind == lexer::TokenKind.string_u16 ||
        state->current.kind == lexer::TokenKind.string_u32) {
        let token: lexer::Token = state->current;
        let token_index: usize = state->current_index;
        parser_advance(state);
        body = parser_new_node(state, SyntaxKind.string_expression, token.span, token_index);
        while (state->error == runtime::Error.none &&
            (state->current.kind == lexer::TokenKind.string ||
                state->current.kind == lexer::TokenKind.string_u16 ||
                state->current.kind == lexer::TokenKind.string_u32)) {
            let part: lexer::Token = state->current;
            let part_index: usize = state->current_index;
            parser_advance(state);
            parser_add_child(
                state, body,
                parser_new_node(state, SyntaxKind.string_expression, part.span, part_index));
            parser_set_node_span(state, body, parser_join_spans(token.span, state->previous.span));
        }
    } else if (state->current.kind != lexer::TokenKind.right_brace) {
        body = parser_new_node(
            state, SyntaxKind.invalid, state->current.span, state->current_index);
        while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
            state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
    }
    parser_expect(state, lexer::TokenKind.right_brace);
    parser_leave_nesting(state);
    return body;
}

fn parser_parse_block(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let left_brace: lexer::Token = state->current;
    let left_brace_index: usize = state->current_index;
    if (!parser_expect(
            state, lexer::TokenKind.left_brace)) {
        return none;
    }
    let block: usize = parser_new_node(
        state, SyntaxKind.block_statement, left_brace.span, left_brace_index);
    if (!parser_enter_nesting(
            state, left_brace.span)) {
        return block;
    }
    while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
        state->current.kind != lexer::TokenKind.end) {
        let index_before: usize = state->current_index;
        let statement: usize = parser_parse_statement(state);
        if (statement != none) {
            parser_add_child(state, block, statement);
        }
        if (state->current_index == index_before && state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
    }
    parser_expect(state, lexer::TokenKind.right_brace);
    parser_set_node_span(state, block, parser_join_spans(left_brace.span, state->previous.span));
    parser_leave_nesting(state);
    return block;
}

fn parser_parse_if_statement(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.if_statement, keyword.span, keyword_index);
    if (!parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let condition: usize = parser_parse_expression(state);
    if (condition != none) {
        parser_add_child(state, statement, condition);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    let then_block: usize = parser_parse_block(state);
    if (then_block != none) {
        parser_add_child(state, statement, then_block);
    }
    var end_span: lexer::SourceSpan = state->previous.span;
    if (parser_match(
            state, lexer::TokenKind.keyword_else)) {
        var else_branch: usize = none;
        if (state->current.kind == lexer::TokenKind.keyword_if) {
            let else_keyword: lexer::Token = state->current;
            let else_index: usize = state->current_index;
            parser_advance(state);
            else_branch = parser_parse_if_statement(state, else_keyword, else_index);
        } else {
            else_branch = parser_parse_block(state);
        }
        if (else_branch != none) {
            parser_add_child(state, statement, else_branch);
            let else_node: *SyntaxNode = parser_node_pointer(state, else_branch);
            if (else_node != null) {
                end_span = else_node->span;
            }
        }
    }
    parser_set_node_span(state, statement, parser_join_spans(keyword.span, end_span));
    parser_leave_nesting(state);
    return statement;
}

fn parser_parse_while_statement(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.while_statement, keyword.span, keyword_index);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let condition: usize = parser_parse_expression(state);
    if (condition != none) {
        parser_add_child(state, statement, condition);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    let body: usize = parser_parse_block(state);
    if (body != none) {
        parser_add_child(state, statement, body);
        let body_node: *SyntaxNode = parser_node_pointer(state, body);
        if (body_node != null) {
            parser_set_node_span(
                state, statement, parser_join_spans(keyword.span, body_node->span));
        }
    }
    return statement;
}

fn parser_parse_do_statement(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.do_statement, keyword.span, keyword_index);
    if (!parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    let body: usize = parser_parse_block(state);
    if (body != none) {
        parser_add_child(state, statement, body);
    }
    parser_expect(state, lexer::TokenKind.keyword_while);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let condition: usize = parser_parse_expression(state);
    if (condition != none) {
        parser_add_child(state, statement, condition);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_set_node_span(state, statement, parser_join_spans(keyword.span, state->previous.span));
    parser_leave_nesting(state);
    return statement;
}

fn parser_parse_loop_statement(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.loop_statement, keyword.span, keyword_index);
    let body: usize = parser_parse_block(state);
    if (body != none) {
        parser_add_child(state, statement, body);
        let body_node: *SyntaxNode = parser_node_pointer(state, body);
        if (body_node != null) {
            parser_set_node_span(
                state, statement, parser_join_spans(keyword.span, body_node->span));
        }
    }
    return statement;
}

fn parser_parse_for_clause(
    state: *ParserState, kind: SyntaxKind, terminator: lexer::TokenKind, allow_declaration: bool
) -> usize {
    let wrapper: usize = parser_new_node(state, kind, state->current.span, state->current_index);
    if (parser_match(state, terminator)) {
        parser_set_node_span(state, wrapper, state->previous.span);
        return wrapper;
    }

    var child: usize = syntax_no_index();
    var is_volatile: bool = false;
    if (allow_declaration && state->current.kind == lexer::TokenKind.keyword_volatile) {
        is_volatile = true;
        parser_advance(state);
    }
    if (allow_declaration && (state->current.kind == lexer::TokenKind.keyword_let ||
            state->current.kind == lexer::TokenKind.keyword_var)) {
        let keyword: lexer::Token = state->current;
        let keyword_index: usize = state->current_index;
        let is_mutable: bool = state->current.kind == lexer::TokenKind.keyword_var;
        parser_advance(state);
        child = parser_parse_variable_declaration(
            state, keyword, keyword_index, is_mutable, is_volatile, syntax_no_index(), 0);
    } else {
        child = parser_parse_expression_statement(state, terminator);
    }
    if (child != syntax_no_index()) {
        parser_add_child(state, wrapper, child);
        let child_node: *SyntaxNode = parser_node_pointer(state, child);
        if (child_node != null) {
            parser_set_node_span(state, wrapper, child_node->span);
        }
    }
    return wrapper;
}

fn parser_parse_for_statement(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.for_statement, keyword.span, keyword_index);
    if (!parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let initializer: usize = parser_parse_for_clause(
        state, SyntaxKind.for_initializer, lexer::TokenKind.semicolon, true);
    parser_add_child(state, statement, initializer);

    let condition_wrapper: usize = parser_new_node(
        state, SyntaxKind.for_condition, state->current.span, state->current_index);
    if (!parser_match(
            state, lexer::TokenKind.semicolon)) {
        let condition: usize = parser_parse_expression(state);
        if (condition != none) {
            parser_add_child(state, condition_wrapper, condition);
            let condition_node: *SyntaxNode = parser_node_pointer(state, condition);
            if (condition_node != null) {
                parser_set_node_span(state, condition_wrapper, condition_node->span);
            }
        }
        parser_expect(state, lexer::TokenKind.semicolon);
    }
    parser_add_child(state, statement, condition_wrapper);

    let update: usize = parser_parse_for_clause(
        state, SyntaxKind.for_update, lexer::TokenKind.right_parenthesis, false);
    parser_add_child(state, statement, update);
    let body: usize = parser_parse_block(state);
    if (body != none) {
        parser_add_child(state, statement, body);
        let body_node: *SyntaxNode = parser_node_pointer(state, body);
        if (body_node != null) {
            parser_set_node_span(
                state, statement, parser_join_spans(keyword.span, body_node->span));
        }
    }
    parser_leave_nesting(state);
    return statement;
}

fn parser_parse_switch_label(state: *ParserState) -> usize {
    if (state->current.kind == lexer::TokenKind.identifier) {
        return parser_parse_postfix_expression(state);
    }
    let none: usize = syntax_no_index();
    var sign: lexer::Token = parser_invalid_token();
    var sign_index: usize = none;
    if (state->current.kind == lexer::TokenKind.plus || state->current.kind == lexer::TokenKind.minus) {
        sign = state->current;
        sign_index = state->current_index;
        parser_advance(state);
    }
    let literal: lexer::Token = state->current;
    let literal_index: usize = state->current_index;
    if (!parser_expect(
            state, lexer::TokenKind.integer)) {
        return none;
    }
    parser_parse_integer_token(state, literal);
    let literal_node: usize = parser_new_node(
        state, SyntaxKind.integer_expression, literal.span, literal_index);
    if (sign_index == none) {
        return literal_node;
    }
    let unary: usize = parser_new_node(
        state, SyntaxKind.unary_expression, parser_join_spans(sign.span, literal.span), sign_index);
    parser_add_child(state, unary, literal_node);
    return unary;
}

fn parser_parse_switch_statement(
    state: *ParserState, keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.switch_statement, keyword.span, keyword_index);
    if (!parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let expression: usize = parser_parse_expression(state);
    if (expression != none) {
        parser_add_child(state, statement, expression);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_expect(state, lexer::TokenKind.left_brace);
    while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
        state->current.kind != lexer::TokenKind.end) {
        let arm_token: lexer::Token = state->current;
        let arm_index: usize = state->current_index;
        let is_case: bool = state->current.kind == lexer::TokenKind.keyword_case;
        let is_default: bool = state->current.kind == lexer::TokenKind.keyword_default;
        if (!is_case && !is_default) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_switch_arm, state->current.span, lexer::TokenKind.keyword_case,
                state->current.kind, 0);
            parser_advance(state);
            continue;
        }
        parser_advance(state);
        let arm: usize = parser_new_node(state, SyntaxKind.switch_arm, arm_token.span, arm_index);
        if (is_default) {
            parser_add_node_flags(state, arm, SyntaxFlag.default_arm as usize);
        } else {
            while (state->error == runtime::Error.none) {
                let label: usize = parser_parse_switch_label(state);
                if (label != none) {
                    parser_add_child(state, arm, label);
                }
                if (!parser_match(
                        state, lexer::TokenKind.comma)) {
                    break;
                }
            }
        }
        let body: usize = parser_parse_block(state);
        if (body != none) {
            parser_add_child(state, arm, body);
            let body_node: *SyntaxNode = parser_node_pointer(state, body);
            if (body_node != null) {
                parser_set_node_span(
                    state, arm, parser_join_spans(arm_token.span, body_node->span));
            }
        }
        parser_add_child(state, statement, arm);
    }
    parser_expect(state, lexer::TokenKind.right_brace);
    parser_set_node_span(state, statement, parser_join_spans(keyword.span, state->previous.span));
    parser_leave_nesting(state);
    return statement;
}

fn parser_parse_assert_statement(state: *ParserState) -> usize {
    let keyword: lexer::Token = state->current;
    let keyword_index: usize = state->current_index;
    parser_advance(state);
    let statement: usize = parser_new_node(
        state, SyntaxKind.assert_statement, keyword.span, keyword_index);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let expression: usize = parser_parse_expression(state);
    if (expression != syntax_no_index()) {
        parser_add_child(state, statement, expression);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_set_node_span(state, statement, parser_join_spans(keyword.span, state->previous.span));
    return statement;
}

fn parser_parse_va_start_statement(state: *ParserState) -> usize {
    let keyword: lexer::Token = state->current;
    let keyword_index: usize = state->current_index;
    parser_advance(state);
    let statement: usize = parser_new_node(
        state, SyntaxKind.va_start_statement, keyword.span, keyword_index);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    let expression: usize = parser_parse_expression(state);
    if (expression != syntax_no_index()) {
        parser_add_child(state, statement, expression);
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_set_node_span(state, statement, parser_join_spans(keyword.span, state->previous.span));
    return statement;
}

fn parser_parse_goto_statement(state: *ParserState) -> usize {
    let keyword: lexer::Token = state->current;
    let keyword_index: usize = state->current_index;
    parser_advance(state);
    let statement: usize = parser_new_node(
        state, SyntaxKind.goto_statement, keyword.span, keyword_index);
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    if (parser_expect(state, lexer::TokenKind.identifier)) {
        parser_add_child(
            state, statement,
            parser_new_node(state, SyntaxKind.name_expression, name.span, name_index));
    }
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_set_node_span(state, statement, parser_join_spans(keyword.span, state->previous.span));
    return statement;
}

fn parser_parse_labeled_statement(
    state: *ParserState, name: lexer::Token, name_index: usize) -> usize {
    let none: usize = syntax_no_index();
    let statement: usize = parser_new_node(
        state, SyntaxKind.labeled_statement, name.span, name_index);
    parser_expect(state, lexer::TokenKind.colon);
    let inner: usize = parser_parse_statement(state);
    if (inner != none) {
        parser_add_child(state, statement, inner);
        let inner_node: *SyntaxNode = parser_node_pointer(state, inner);
        if (inner_node != null) {
            parser_set_node_span(
                state, statement, parser_join_spans(name.span, inner_node->span));
        }
    }
    return statement;
}

fn parser_parse_statement(state: *ParserState) -> usize {
    let token: lexer::Token = state->current;
    let token_index: usize = state->current_index;
    if (token.kind == lexer::TokenKind.left_brace) {
        return parser_parse_block(state);
    }
    if (token.kind == lexer::TokenKind.identifier &&
        parser_peek_kind(state) == lexer::TokenKind.colon) {
        parser_advance(state);
        return parser_parse_labeled_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_let || token.kind == lexer::TokenKind.keyword_var) {
        parser_advance(state);
        return parser_parse_variable_declaration(
            state, token, token_index, token.kind == lexer::TokenKind.keyword_var, false, syntax_no_index(),
            0);
    }
    if (token.kind == lexer::TokenKind.keyword_const) {
        return parser_parse_const_declaration(
            state, token, token_index, SyntaxFlag.none as usize, syntax_no_index(), 0);
    }
    if (token.kind == lexer::TokenKind.keyword_volatile) {
        parser_advance(state);
        let keyword: lexer::Token = state->current;
        let keyword_index: usize = state->current_index;
        if (keyword.kind != lexer::TokenKind.keyword_let && keyword.kind != lexer::TokenKind.keyword_var) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.expected_token, keyword.span, lexer::TokenKind.keyword_let,
                keyword.kind, 0);
            return syntax_no_index();
        }
        parser_advance(state);
        return parser_parse_variable_declaration(
            state, keyword, keyword_index, keyword.kind == lexer::TokenKind.keyword_var, true,
            syntax_no_index(), 0);
    }
    if (token.kind == lexer::TokenKind.at_sign) {
        var first_attribute: usize = syntax_no_index();
        var attribute_count: usize = 0;
        parser_parse_attributes(state, &first_attribute, &attribute_count);
        let keyword: lexer::Token = state->current;
        let keyword_index: usize = state->current_index;
        if (keyword.kind != lexer::TokenKind.keyword_let && keyword.kind != lexer::TokenKind.keyword_var) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.expected_token, keyword.span, lexer::TokenKind.keyword_let,
                keyword.kind, 0);
            parser_attach_attributes(state, state->tree.root, first_attribute, attribute_count);
            return syntax_no_index();
        }
        parser_advance(state);
        return parser_parse_variable_declaration(
            state, keyword, keyword_index, keyword.kind == lexer::TokenKind.keyword_var, false, first_attribute,
            attribute_count);
    }
    if (token.kind == lexer::TokenKind.keyword_if) {
        parser_advance(state);
        return parser_parse_if_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_while) {
        parser_advance(state);
        return parser_parse_while_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_do) {
        parser_advance(state);
        return parser_parse_do_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_for) {
        parser_advance(state);
        return parser_parse_for_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_loop) {
        parser_advance(state);
        return parser_parse_loop_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_switch) {
        parser_advance(state);
        return parser_parse_switch_statement(state, token, token_index);
    }
    if (token.kind == lexer::TokenKind.keyword_break || token.kind == lexer::TokenKind.keyword_continue) {
        parser_advance(state);
        let statement: usize = parser_new_node(
            state, token.kind == lexer::TokenKind.keyword_break ? SyntaxKind.break_statement :
                SyntaxKind.continue_statement, token.span, token_index);
        if (state->current.kind == lexer::TokenKind.identifier) {
            let name: lexer::Token = state->current;
            let name_index: usize = state->current_index;
            parser_advance(state);
            parser_add_child(
                state, statement,
                parser_new_node(state, SyntaxKind.name_expression, name.span, name_index));
        }
        parser_expect(state, lexer::TokenKind.semicolon);
        parser_set_node_span(
            state, statement, parser_join_spans(token.span, state->previous.span));
        return statement;
    }
    if (token.kind == lexer::TokenKind.keyword_goto) {
        return parser_parse_goto_statement(state);
    }
    if (token.kind == lexer::TokenKind.keyword_return) {
        parser_advance(state);
        let statement: usize = parser_new_node(
            state, SyntaxKind.return_statement, token.span, token_index);
        if (state->current.kind != lexer::TokenKind.semicolon) {
            let value: usize = parser_parse_expression(state);
            if (value != syntax_no_index()) {
                parser_add_child(state, statement, value);
            }
        }
        parser_expect(state, lexer::TokenKind.semicolon);
        parser_set_node_span(state, statement, parser_join_spans(token.span, state->previous.span));
        return statement;
    }
    if (token.kind == lexer::TokenKind.keyword_assert) {
        return parser_parse_assert_statement(state);
    }
    if (token.kind == lexer::TokenKind.keyword_va_start) {
        return parser_parse_va_start_statement(state);
    }
    return parser_parse_expression_statement(state, lexer::TokenKind.semicolon);
}

fn parser_parse_module_name(state: *ParserState, declaration: usize) -> bool {
    var saw_name: bool = false;
    while (state->error == runtime::Error.none) {
        let name: lexer::Token = state->current;
        let name_index: usize = state->current_index;
        if (!parser_expect(
                state, lexer::TokenKind.identifier)) {
            return false;
        }
        let name_node: usize = parser_new_node(
            state, SyntaxKind.name_expression, name.span, name_index);
        parser_add_child(state, declaration, name_node);
        saw_name = true;
        if (!parser_match(
                state, lexer::TokenKind.dot)) {
            break;
        }
    }
    return saw_name;
}

fn parser_parse_field(state: *ParserState, owner: usize) -> usize {
    let none: usize = syntax_no_index();
    var first_attribute: usize = none;
    var attribute_count: usize = 0;
    parser_parse_attributes(state, &first_attribute, &attribute_count);
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    if (name.kind == lexer::TokenKind.keyword_struct || name.kind == lexer::TokenKind.keyword_union) {
        parser_advance(state);
        let field: usize =
            parser_new_node(state, SyntaxKind.field_declaration, name.span, name_index);
        parser_add_node_flags(state, field, SyntaxFlag.anonymous as usize);
        let declaration: usize = parser_new_node(
            state,
            name.kind == lexer::TokenKind.keyword_struct ? SyntaxKind.structure_declaration :
                SyntaxKind.union_declaration, name.span, name_index);
        parser_add_child(state, field, declaration);
        parser_expect(state, lexer::TokenKind.left_brace);
        if (!parser_enter_nesting(state, name.span)) {
            parser_attach_attributes(state, owner, first_attribute, attribute_count);
            return field;
        }
        while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
            state->current.kind != lexer::TokenKind.end) {
            let index_before: usize = state->current_index;
            let nested: usize = parser_parse_field(state, declaration);
            if (nested != none) {
                parser_add_child(state, declaration, nested);
            }
            if (state->current_index == index_before && state->current.kind != lexer::TokenKind.end) {
                parser_advance(state);
            }
        }
        parser_expect(state, lexer::TokenKind.right_brace);
        parser_leave_nesting(state);
        parser_set_node_span(
            state, declaration, parser_join_spans(name.span, state->previous.span));
        parser_attach_attributes(state, field, first_attribute, attribute_count);
        parser_set_node_span(state, field, parser_join_spans(name.span, state->previous.span));
        return field;
    }
    if (!parser_expect(
            state, lexer::TokenKind.identifier)) {
        parser_attach_attributes(state, owner, first_attribute, attribute_count);
        return none;
    }
    let field: usize = parser_new_node(state, SyntaxKind.field_declaration, name.span, name_index);
    parser_expect(state, lexer::TokenKind.colon);
    let type_node: usize = parser_parse_type(state);
    if (type_node != none) {
        parser_add_child(state, field, type_node);
    }
    var trailing_attribute: usize = none;
    var trailing_count: usize = 0;
    parser_parse_attributes(state, &trailing_attribute, &trailing_count);
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_attach_attributes(state, field, first_attribute, attribute_count);
    parser_attach_attributes(state, field, trailing_attribute, trailing_count);
    parser_set_node_span(state, field, parser_join_spans(name.span, state->previous.span));
    return field;
}

fn parser_parse_aggregate_declaration(
    state: *ParserState, start: lexer::Token, declaration_kind: SyntaxKind, flags: usize,
    first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = syntax_no_index();
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.identifier);
    let declaration: usize = parser_new_node(state, declaration_kind, start.span, name_index);
    parser_add_node_flags(state, declaration, flags);
    parser_expect(state, lexer::TokenKind.left_brace);
    while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
        state->current.kind != lexer::TokenKind.end) {
        let index_before: usize = state->current_index;
        let field: usize = parser_parse_field(state, declaration);
        if (field != none) {
            parser_add_child(state, declaration, field);
        }
        if (state->current_index == index_before && state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
    }
    parser_expect(state, lexer::TokenKind.right_brace);
    parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    parser_set_node_span(state, declaration, parser_join_spans(start.span, state->previous.span));
    return declaration;
}

fn parser_parse_enum_declaration(
    state: *ParserState, start: lexer::Token, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = syntax_no_index();
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.identifier);
    let declaration: usize = parser_new_node(
        state, SyntaxKind.enum_declaration, start.span, name_index);
    parser_add_node_flags(state, declaration, flags);
    parser_expect(state, lexer::TokenKind.colon);
    let underlying_type: usize = parser_parse_type(state);
    if (underlying_type != none) {
        parser_add_child(state, declaration, underlying_type);
    }
    parser_expect(state, lexer::TokenKind.left_brace);
    while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.right_brace &&
        state->current.kind != lexer::TokenKind.end) {
        let index_before: usize = state->current_index;
        let member_name: lexer::Token = state->current;
        let member_index: usize = state->current_index;
        if (!parser_expect(
                state, lexer::TokenKind.identifier)) {
            if (state->current.kind != lexer::TokenKind.end) {
                parser_advance(state);
            }
        } else {
            let member: usize = parser_new_node(
                state, SyntaxKind.enum_member, member_name.span, member_index);
            if (parser_match(
                    state, lexer::TokenKind.equal)) {
                let initializer: usize = parser_parse_expression(state);
                if (initializer != none) {
                    parser_add_child(state, member, initializer);
                    let initializer_node: *SyntaxNode = parser_node_pointer(state, initializer);
                    if (initializer_node != null) {
                        parser_set_node_span(
                            state, member, parser_join_spans(member_name.span, initializer_node->span));
                    }
                }
            }
            parser_add_child(state, declaration, member);
        }
        if (!parser_match(
                state, lexer::TokenKind.comma)) {
            break;
        }
        if (state->current.kind == lexer::TokenKind.right_brace) {
            break;
        }
        if (state->current_index == index_before && state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
    }
    parser_expect(state, lexer::TokenKind.right_brace);
    parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    parser_set_node_span(state, declaration, parser_join_spans(start.span, state->previous.span));
    return declaration;
}

fn parser_parse_parameter(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    if (!parser_expect(
            state, lexer::TokenKind.identifier)) {
        return none;
    }
    let parameter: usize = parser_new_node(state, SyntaxKind.parameter, name.span, name_index);
    parser_expect(state, lexer::TokenKind.colon);
    let type_node: usize = parser_parse_type(state);
    if (type_node != none) {
        parser_add_child(state, parameter, type_node);
        let type_pointer: *SyntaxNode = parser_node_pointer(state, type_node);
        if (type_pointer != null) {
            parser_set_node_span(
                state, parameter, parser_join_spans(name.span, type_pointer->span));
        }
    }
    return parameter;
}

fn parser_parse_function_declaration(
    state: *ParserState, start: lexer::Token, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = syntax_no_index();
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.identifier);
    let function: usize = parser_new_node(
        state, SyntaxKind.function_declaration, start.span, name_index);
    parser_add_node_flags(state, function, flags);
    parser_expect(state, lexer::TokenKind.left_parenthesis);
    if (state->current.kind != lexer::TokenKind.right_parenthesis) {
        while (state->error == runtime::Error.none) {
            if (state->current.kind == lexer::TokenKind.dot_dot_dot) {
                parser_advance(state);
                parser_add_node_flags(state, function, SyntaxFlag.variadic as usize);
                break;
            }
            let parameter: usize = parser_parse_parameter(state);
            if (parameter != none) {
                parser_add_child(state, function, parameter);
            }
            if (!parser_match(
                    state, lexer::TokenKind.comma)) {
                break;
            }
        }
    }
    parser_expect(state, lexer::TokenKind.right_parenthesis);
    if (parser_match(
            state, lexer::TokenKind.arrow)) {
        let return_type: usize = parser_parse_type(state);
        if (return_type != none) {
            parser_add_child(state, function, return_type);
        }
    }

    if (parser_match(
            state, lexer::TokenKind.semicolon)) {
        parser_add_node_flags(state, function, SyntaxFlag.bodyless as usize);
    } else if ((flags & (SyntaxFlag.asm_function as usize)) != 0) {
        let body: usize = parser_parse_asm_body(state);
        if (body != none) {
            parser_add_child(state, function, body);
        }
        if ((flags & (SyntaxFlag.external as usize)) != 0) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_external_declaration, start.span, lexer::TokenKind.semicolon,
                lexer::TokenKind.left_brace, 0);
        }
    } else {
        let body: usize = parser_parse_block(state);
        if (body != none) {
            parser_add_child(state, function, body);
        }
        if ((flags & (SyntaxFlag.external as usize)) != 0) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_external_declaration, start.span, lexer::TokenKind.semicolon,
                lexer::TokenKind.left_brace, 0);
        }
    }
    parser_attach_attributes(state, function, first_attribute, attribute_count);
    parser_set_node_span(state, function, parser_join_spans(start.span, state->previous.span));
    return function;
}

fn parser_token_at(state: *ParserState, index: usize) -> lexer::Token {
    let result: lexer::TokenResult = lexer::token_buffer_get(state->tokens, index);
    if (result.error != runtime::Error.none) {
        if (state->error == runtime::Error.none) {
            state->error = result.error;
        }
        return {
            kind = lexer::TokenKind.invalid, span = {
                offset = 0, length = 0, line = 0, column = 0,
            },
        };
    }
    return result.token;
}

fn parser_identifier_text_is(
    state: *ParserState, token: lexer::Token, text: *const u8, length: usize) -> bool {
    if (token.kind != lexer::TokenKind.identifier || token.span.length != length) {
        return false;
    }
    let source: text::View = state->source;
    var index: usize = 0;
    while (index < length) {
        if (source.data[token.span.offset + index] != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn parser_parse_type_alias_declaration(
    state: *ParserState, start: lexer::Token, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = syntax_no_index();
    if ((flags & (SyntaxFlag.external as usize)) != 0) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.invalid_external_declaration, start.span, lexer::TokenKind.keyword_fn,
            lexer::TokenKind.identifier, 0);
    }
    parser_advance(state);
    let name: lexer::Token = state->current;
    let name_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.identifier);
    let declaration: usize = parser_new_node(
        state, SyntaxKind.type_alias_declaration, start.span, name_index);
    parser_add_node_flags(state, declaration, flags);
    parser_expect(state, lexer::TokenKind.equal);
    if (!parser_enter_nesting(state, start.span)) {
        parser_attach_attributes(state, declaration, first_attribute, attribute_count);
        return declaration;
    }
    let target: usize = parser_parse_type(state);
    if (target != none) {
        parser_add_child(state, declaration, target);
        let target_node: *SyntaxNode = parser_node_pointer(state, target);
        if (target_node != null) {
            parser_set_node_span(
                state, declaration, parser_join_spans(start.span, target_node->span));
        }
    }
    parser_leave_nesting(state);
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    return declaration;
}

fn parser_parse_top_level_declaration(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let start: lexer::Token = state->current;
    var flags: usize = SyntaxFlag.none as usize;
    if (parser_match(
            state, lexer::TokenKind.keyword_export)) {
        flags |= SyntaxFlag.exported as usize;
    }
    if (parser_match(
            state, lexer::TokenKind.keyword_extern)) {
        flags |= SyntaxFlag.external as usize;
    }
    var first_attribute: usize = none;
    var attribute_count: usize = 0;
    parser_parse_attributes(state, &first_attribute, &attribute_count);

    if (parser_match(
            state, lexer::TokenKind.keyword_struct)) {
        if ((flags & (SyntaxFlag.external as usize)) != 0) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_external_declaration, start.span, lexer::TokenKind.keyword_fn,
                lexer::TokenKind.keyword_struct, 0);
        }
        return parser_parse_aggregate_declaration(
            state, start, SyntaxKind.structure_declaration, flags, first_attribute, attribute_count);
    }
    if (parser_match(
            state, lexer::TokenKind.keyword_union)) {
        if ((flags & (SyntaxFlag.external as usize)) != 0) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_external_declaration, start.span, lexer::TokenKind.keyword_fn,
                lexer::TokenKind.keyword_union, 0);
        }
        return parser_parse_aggregate_declaration(
            state, start, SyntaxKind.union_declaration, flags, first_attribute, attribute_count);
    }
    if (parser_match(
            state, lexer::TokenKind.keyword_enum)) {
        if ((flags & (SyntaxFlag.external as usize)) != 0) {
            parser_add_diagnostic(
                state, lexer::DiagnosticKind.invalid_external_declaration, start.span, lexer::TokenKind.keyword_fn,
                lexer::TokenKind.keyword_enum, 0);
        }
        return parser_parse_enum_declaration(state, start, flags, first_attribute, attribute_count);
    }
    if (parser_match(
            state, lexer::TokenKind.keyword_fn)) {
        return parser_parse_function_declaration(state, start, flags, first_attribute, attribute_count);
    }
    if (state->current.kind == lexer::TokenKind.keyword_asm &&
        parser_token_at(state, state->current_index + 1).kind == lexer::TokenKind.keyword_fn) {
        parser_advance(state);
        parser_advance(state);
        return parser_parse_function_declaration(
            state, start, flags | (SyntaxFlag.asm_function as usize), first_attribute, attribute_count);
    }
    if (state->current.kind == lexer::TokenKind.keyword_const) {
        if (parser_token_at(
                state, state->current_index + 1).kind == lexer::TokenKind.keyword_fn) {
            if ((flags & (SyntaxFlag.external as usize)) != 0) {
                parser_add_diagnostic(
                    state, lexer::DiagnosticKind.invalid_external_declaration, start.span,
                    lexer::TokenKind.keyword_fn, lexer::TokenKind.keyword_const, 0);
            }
            parser_advance(state);
            parser_advance(state);
            return parser_parse_function_declaration(
                state, start, flags | (SyntaxFlag.const_function as usize), first_attribute,
                attribute_count);
        }
        return parser_parse_const_declaration(
            state, start, state->current_index, flags, first_attribute, attribute_count);
    }
    if (state->current.kind == lexer::TokenKind.identifier &&
        parser_identifier_text_is(state, state->current, "type", 4) &&
        parser_token_at(state, state->current_index + 1).kind == lexer::TokenKind.identifier &&
        parser_token_at(
            state, state->current_index + 2).kind == lexer::TokenKind.equal) {
        return parser_parse_type_alias_declaration(state, start, flags, first_attribute, attribute_count);
    }

    if (state->current.kind == lexer::TokenKind.keyword_assert) {
        parser_attach_attributes(state, state->tree.root, first_attribute, attribute_count);
        return parser_parse_assert_statement(state);
    }

    parser_add_diagnostic(
        state, lexer::DiagnosticKind.expected_declaration, state->current.span, lexer::TokenKind.keyword_fn,
        state->current.kind, 0);
    parser_attach_attributes(state, state->tree.root, first_attribute, attribute_count);
    if (state->current.kind != lexer::TokenKind.end) {
        parser_advance(state);
    }
    return none;
}

fn parser_parse_program(state: *ParserState) -> usize {
    let none: usize = syntax_no_index();
    let start: lexer::Token = state->current;
    let start_index: usize = state->current_index;
    var interface_unit: bool = false;
    if (parser_match(
            state, lexer::TokenKind.keyword_export)) {
        interface_unit = true;
    }
    let module_keyword: lexer::Token = state->current;
    let module_index: usize = state->current_index;
    parser_expect(state, lexer::TokenKind.keyword_module);
    let program: usize = parser_new_node(state, SyntaxKind.program, start.span, start_index);
    state->tree.root = program;
    if (interface_unit) {
        parser_add_node_flags(state, program, SyntaxFlag.interface_unit as usize);
    }

    let module_declaration: usize = parser_new_node(
        state, SyntaxKind.module_declaration, module_keyword.span, module_index);
    parser_parse_module_name(state, module_declaration);
    parser_expect(state, lexer::TokenKind.semicolon);
    parser_set_node_span(
        state, module_declaration, parser_join_spans(module_keyword.span, state->previous.span));
    parser_add_child(state, program, module_declaration);

    while (state->current.kind == lexer::TokenKind.keyword_import) {
        let import_keyword: lexer::Token = state->current;
        let import_index: usize = state->current_index;
        parser_advance(state);
        let import_declaration: usize =
            parser_new_node(state, SyntaxKind.import_declaration, import_keyword.span, import_index);
        parser_parse_module_name(state, import_declaration);
        // `import a.b.c as t;` binds only the qualifier `t::`; the alias is
        // carried as a trailing name_expression child after the module-name
        // segments, marked by the aliased_import flag.
        if (parser_match(
                state, lexer::TokenKind.keyword_as)) {
            let alias: lexer::Token = state->current;
            let alias_index: usize = state->current_index;
            if (parser_expect(
                    state, lexer::TokenKind.identifier)) {
                parser_add_node_flags(
                    state, import_declaration, SyntaxFlag.aliased_import as usize);
                parser_add_child(
                    state, import_declaration,
                    parser_new_node(state, SyntaxKind.name_expression, alias.span, alias_index));
            }
        }
        // `import a.b.c::{x, y};` binds only the listed names flat (the
        // `c::` qualifier still binds). The names are carried as
        // name_expression children of a trailing selective_import_names
        // container node, marked by the selective_import flag; combining
        // with `as` is rejected by sema.
        let colons: lexer::Token = state->current;
        let colons_index: usize = state->current_index;
        if (parser_match(
                state, lexer::TokenKind.colon_colon)) {
            parser_add_node_flags(
                state, import_declaration, SyntaxFlag.selective_import as usize);
            let selective_node: usize =
                parser_new_node(
                    state, SyntaxKind.selective_import_names, colons.span, colons_index);
            if (parser_expect(
                    state, lexer::TokenKind.left_brace)) {
                while (state->error == runtime::Error.none &&
                    state->current.kind == lexer::TokenKind.identifier) {
                    let selective_name: lexer::Token = state->current;
                    let selective_name_index: usize = state->current_index;
                    parser_advance(state);
                    parser_add_child(
                        state, selective_node,
                        parser_new_node(
                            state, SyntaxKind.name_expression, selective_name.span, selective_name_index));
                    if (!parser_match(
                            state, lexer::TokenKind.comma)) {
                        break;
                    }
                }
                if (parser_expect(
                        state, lexer::TokenKind.right_brace)) {
                    parser_set_node_span(
                        state, selective_node, parser_join_spans(colons.span, state->previous.span));
                }
            }
            parser_add_child(state, import_declaration, selective_node);
        }
        parser_expect(state, lexer::TokenKind.semicolon);
        parser_set_node_span(
            state, import_declaration, parser_join_spans(import_keyword.span, state->previous.span));
        parser_add_child(state, program, import_declaration);
    }

    while (state->error == runtime::Error.none && state->current.kind != lexer::TokenKind.end) {
        let index_before: usize = state->current_index;
        let declaration: usize = parser_parse_top_level_declaration(state);
        if (declaration != none) {
            parser_add_child(state, program, declaration);
        }
        if (state->current_index == index_before && state->current.kind != lexer::TokenKind.end) {
            parser_advance(state);
        }
    }
    let end_span: lexer::SourceSpan = state->current.kind == lexer::TokenKind.end ?
            state->current.span : state->previous.span;
    parser_set_node_span(state, program, parser_join_spans(start.span, end_span));
    return program;
}

fn parse(source: text::View, tokens: lexer::TokenBuffer) -> ParseResult {
    if (!parser_input_is_valid(source, tokens)) {
        return {
            tree = syntax_tree_empty(), diagnostics = lexer::diagnostic_buffer_empty(),
            error = runtime::Error.invalid_argument,
        };
    }
    var state: ParserState = {
        source = source, tokens = tokens, cursor = 0, current = parser_invalid_token(),
        current_index = syntax_no_index(), previous = parser_invalid_token(),
        tree = syntax_tree_empty(), diagnostics = lexer::diagnostic_buffer_empty(),
        error = runtime::Error.none, nesting_depth = 0,
    };
    state.tree.token_count = tokens.count;
    parser_advance(&state);
    if (state.error == runtime::Error.none) {
        parser_parse_program(&state);
    }
    if (state.error == runtime::Error.none && !syntax_tree_is_valid(state.tree)) {
        state.error = runtime::Error.io;
    }
    return {
        tree = state.tree, diagnostics = state.diagnostics, error = state.error,
    };
}

fn parse_result_release(result: ParseResult) -> runtime::Error {
    let tree_error: runtime::Error = syntax_tree_release(result.tree);
    let diagnostic_error: runtime::Error = lexer::diagnostic_buffer_release(result.diagnostics);
    if (tree_error != runtime::Error.none) {
        return tree_error;
    }
    return diagnostic_error;
}

fn frontend_parse(source: text::View) -> FrontendResult {
    let lex: lexer::LexResult = lexer::lex(source);
    if (lex.error != runtime::Error.none) {
        return {
            lex = lex, parse = {
                tree = syntax_tree_empty(), diagnostics = lexer::diagnostic_buffer_empty(),
                error = lex.error,
            }, error = lex.error,
        };
    }
    let parse_result: ParseResult = parse(source, lex.tokens);
    return {
        lex = lex, parse = parse_result, error = parse_result.error,
    };
}

fn frontend_result_release(result: FrontendResult) -> runtime::Error {
    let parse_error: runtime::Error = parse_result_release(result.parse);
    let lex_error: runtime::Error = lexer::lex_result_release(result.lex);
    if (parse_error != runtime::Error.none) {
        return parse_error;
    }
    return lex_error;
}

