module luna.bootstrap.frontend.parser;

enum BootstrapParserLimit: usize {
    maximum_size = 18446744073709551615, maximum_nesting = 256, maximum_nodes = 262144,
}

struct BootstrapParserState {
    source: StdTextView;
    tokens: BootstrapTokenBuffer;
    cursor: usize;
    current: BootstrapToken;
    current_index: usize;
    previous: BootstrapToken;
    tree: BootstrapSyntaxTree;
    diagnostics: BootstrapDiagnosticBuffer;
    error: RuntimeError;
    nesting_depth: usize;
}

fn bootstrap_syntax_no_index() -> usize {
    return BootstrapParserLimit.maximum_size as usize;
}

fn bootstrap_parser_empty_span() -> BootstrapSourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn bootstrap_parser_invalid_token() -> BootstrapToken {
    return {
        kind = BootstrapTokenKind.invalid, span = bootstrap_parser_empty_span(),
    };
}

fn bootstrap_parser_invalid_node() -> BootstrapSyntaxNode {
    return {
        kind = BootstrapSyntaxKind.invalid, span = bootstrap_parser_empty_span(),
        token_index = bootstrap_syntax_no_index(), parent = bootstrap_syntax_no_index(),
        first_child = bootstrap_syntax_no_index(), last_child = bootstrap_syntax_no_index(),
        next_sibling = bootstrap_syntax_no_index(), child_count = 0, flags = BootstrapSyntaxFlag.none as usize,
    };
}

fn bootstrap_syntax_tree_empty() -> BootstrapSyntaxTree {
    return {
        storage = std_byte_buffer_empty(), count = 0, token_count = 0, root = bootstrap_syntax_no_index(),
    };
}

fn bootstrap_syntax_tree_storage_is_valid(tree: BootstrapSyntaxTree) -> bool {
    if (!std_byte_buffer_is_valid(tree.storage) || tree.storage.length % sizeof(BootstrapSyntaxNode) != 0 ||
        tree.count > BootstrapParserLimit.maximum_nodes as usize) {
        return false;
    }
    return tree.count == tree.storage.length / sizeof(BootstrapSyntaxNode);
}

fn bootstrap_syntax_tree_is_valid(tree: BootstrapSyntaxTree) -> bool {
    if (!bootstrap_syntax_tree_storage_is_valid(tree)) {
        return false;
    }
    let none: usize = bootstrap_syntax_no_index();
    if (tree.count == 0) {
        return tree.token_count == 0 && tree.root == none;
    }
    if (tree.token_count == 0 || tree.root >= tree.count) {
        return false;
    }

    let nodes: *const BootstrapSyntaxNode = tree.storage.data as *const BootstrapSyntaxNode;
    var node_index: usize = 0;
    while (node_index < tree.count) {
        let node: BootstrapSyntaxNode = nodes[node_index];
        if ((node.kind as usize) > (BootstrapSyntaxKind.va_arg_expression as usize) || node.flags > 131071 ||
            node.span.line == 0 || node.span.column == 0 || node.span.length >
                (BootstrapParserLimit.maximum_size as usize) - node.span.offset || (node.token_index != none &&
                node.token_index >= tree.token_count)) {
            return false;
        }
        if (node_index == tree.root) {
            if (node.parent != none) {
                return false;
            }
        } else if (node.parent >= tree.count) {
            return false;
        }
        if (node.next_sibling != none && node.next_sibling >= tree.count) {
            return false;
        }
        if (node.child_count == 0) {
            if (node.first_child != none || node.last_child != none) {
                return false;
            }
            node_index += 1;
            continue;
        }
        if (node.child_count > tree.count || node.first_child >= tree.count || node.last_child >= tree.count) {
            return false;
        }

        var child_index: usize = node.first_child;
        var previous_child: usize = none;
        var visited: usize = 0;
        while (visited < node.child_count) {
            if (child_index >= tree.count) {
                return false;
            }
            if (nodes[child_index].parent != node_index) {
                return false;
            }
            previous_child = child_index;
            child_index = nodes[child_index].next_sibling;
            visited += 1;
        }
        if (previous_child != node.last_child || child_index != none) {
            return false;
        }
        node_index += 1;
    }
    if (nodes[tree.root].kind != BootstrapSyntaxKind.program || nodes[tree.root].next_sibling != none) {
        return false;
    }

    node_index = 0;
    while (node_index < tree.count) {
        var ancestor: usize = node_index;
        var depth: usize = 0;
        while (ancestor != tree.root && depth < tree.count) {
            ancestor = nodes[ancestor].parent;
            if (ancestor >= tree.count) {
                return false;
            }
            depth += 1;
        }
        if (ancestor != tree.root) {
            return false;
        }
        node_index += 1;
    }
    return true;
}

fn bootstrap_syntax_tree_get(tree: BootstrapSyntaxTree, index: usize) -> BootstrapSyntaxNodeResult {
    if (!bootstrap_syntax_tree_storage_is_valid(tree) || index >= tree.count) {
        return {
            node = bootstrap_parser_invalid_node(), error = RuntimeError.invalid_argument,
        };
    }
    let nodes: *const BootstrapSyntaxNode = tree.storage.data as *const BootstrapSyntaxNode;
    return {
        node = nodes[index], error = RuntimeError.none,
    };
}

fn bootstrap_syntax_tree_release(tree: BootstrapSyntaxTree) -> RuntimeError {
    if (!bootstrap_syntax_tree_storage_is_valid(tree)) {
        return RuntimeError.invalid_argument;
    }
    return std_byte_buffer_release(tree.storage);
}

fn bootstrap_parser_span_is_valid(source: StdTextView, span: BootstrapSourceSpan) -> bool {
    return span.offset <= source.length && span.length <= source.length - span.offset &&
        span.line != 0 && span.column != 0;
}

fn bootstrap_parser_source_is_valid(source: StdTextView) -> bool {
    if (!std_text_is_valid_utf8(source)) {
        return false;
    }
    var index: usize = 0;
    while (index < source.length) {
        if (source.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_parser_input_is_valid(source: StdTextView, tokens: BootstrapTokenBuffer) -> bool {
    if (!bootstrap_parser_source_is_valid(source) || !bootstrap_token_buffer_is_valid(tokens) || tokens.count == 0) {
        return false;
    }

    var previous_end: usize = 0;
    var scan_offset: usize = 0;
    var scan_line: usize = 1;
    var scan_column: usize = 1;
    var index: usize = 0;
    while (index < tokens.count) {
        let token_result: BootstrapTokenResult = bootstrap_token_buffer_get(tokens, index);
        if (token_result.error != RuntimeError.none) {
            return false;
        }
        let token: BootstrapToken = token_result.token;
        if ((token.kind as usize) > (BootstrapTokenKind.keyword_asm as usize) ||
            !bootstrap_parser_span_is_valid(source, token.span) || token.span.offset < previous_end) {
            return false;
        }
        while (scan_offset < token.span.offset) {
            if (source.data[scan_offset] == 10) {
                scan_line += 1;
                scan_column = 1;
            } else {
                scan_column += 1;
            }
            scan_offset += 1;
        }
        if (token.span.line != scan_line || token.span.column != scan_column) {
            return false;
        }
        previous_end = token.span.offset + token.span.length;
        if (index + 1 == tokens.count) {
            return token.kind == BootstrapTokenKind.end && token.span.length == 0 && token.span.offset == source.length;
        }
        if (token.kind == BootstrapTokenKind.end) {
            return false;
        }
        index += 1;
    }
    return false;
}

fn bootstrap_parser_join_spans(first: BootstrapSourceSpan, last: BootstrapSourceSpan) -> BootstrapSourceSpan {
    if (last.offset < first.offset || last.length > (BootstrapParserLimit.maximum_size as usize) - last.offset) {
        return first;
    }
    let last_end: usize = last.offset + last.length;
    if (last_end < first.offset) {
        return first;
    }
    return {
        offset = first.offset, length = last_end - first.offset, line = first.line, column = first.column,
    };
}

fn bootstrap_parser_add_diagnostic(
    state: *BootstrapParserState, kind: BootstrapDiagnosticKind, span: BootstrapSourceSpan,
    expected: BootstrapTokenKind, found: BootstrapTokenKind, detail: usize) -> bool {
    if (state->error != RuntimeError.none) {
        return false;
    }
    let added: BootstrapDiagnosticBufferResult =
        bootstrap_diagnostic_buffer_add(
            state->diagnostics, {
                kind = kind, span = span, expected = expected, found = found, detail = detail,
            });
    state->diagnostics = added.buffer;
    state->error = added.error;
    return added.error == RuntimeError.none;
}

fn bootstrap_parser_new_node(
    state: *BootstrapParserState, kind: BootstrapSyntaxKind, span: BootstrapSourceSpan, token_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    if (state->error != RuntimeError.none) {
        return none;
    }
    if (!bootstrap_syntax_tree_storage_is_valid(state->tree)) {
        state->error = RuntimeError.invalid_argument;
        return none;
    }
    if (state->tree.count >= BootstrapParserLimit.maximum_nodes as usize) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.resource_limit, span, BootstrapTokenKind.invalid, state->current.kind,
            BootstrapParserLimit.maximum_nodes as usize);
        state->error = RuntimeError.out_of_memory;
        return none;
    }
    let node: BootstrapSyntaxNode = {
        kind = kind, span = span, token_index = token_index, parent = none, first_child = none, last_child = none,
        next_sibling = none, child_count = 0, flags = BootstrapSyntaxFlag.none as usize,
    };
    let appended: StdByteBufferResult = std_byte_buffer_append(
        state->tree.storage, (&node) as *const BootstrapSyntaxNode as *const u8, sizeof(BootstrapSyntaxNode));
    state->tree.storage = appended.buffer;
    state->error = appended.error;
    if (appended.error != RuntimeError.none) {
        return none;
    }
    let index: usize = state->tree.count;
    state->tree.count += 1;
    return index;
}

fn bootstrap_parser_node_pointer(state: *BootstrapParserState, index: usize) -> *BootstrapSyntaxNode {
    if (state->error != RuntimeError.none) {
        return null;
    }
    if (index >= state->tree.count) {
        if (state->error == RuntimeError.none) {
            state->error = RuntimeError.invalid_argument;
        }
        return null;
    }
    let nodes: *BootstrapSyntaxNode = state->tree.storage.data as *BootstrapSyntaxNode;
    return &nodes[index];
}

fn bootstrap_parser_set_node_span(state: *BootstrapParserState, index: usize, span: BootstrapSourceSpan) -> bool {
    let node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, index);
    if (node == null) {
        return false;
    }
    node->span = span;
    return true;
}

fn bootstrap_parser_add_node_flags(state: *BootstrapParserState, index: usize, flags: usize) -> bool {
    let node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, index);
    if (node == null) {
        return false;
    }
    node->flags |= flags;
    return true;
}

fn bootstrap_parser_add_child(state: *BootstrapParserState, parent_index: usize, child_index: usize) -> bool {
    let none: usize = bootstrap_syntax_no_index();
    if (state->error != RuntimeError.none) {
        return false;
    }
    if (parent_index >= state->tree.count || child_index >= state->tree.count || parent_index == child_index) {
        if (state->error == RuntimeError.none) {
            state->error = RuntimeError.invalid_argument;
        }
        return false;
    }
    let nodes: *BootstrapSyntaxNode = state->tree.storage.data as *BootstrapSyntaxNode;
    if (nodes[child_index].parent != none || nodes[child_index].next_sibling != none ||
        nodes[parent_index].child_count == BootstrapParserLimit.maximum_size as usize) {
        if (state->error == RuntimeError.none) {
            state->error = RuntimeError.invalid_argument;
        }
        return false;
    }
    if (nodes[parent_index].child_count == 0) {
        nodes[parent_index].first_child = child_index;
    } else {
        nodes[nodes[parent_index].last_child].next_sibling = child_index;
    }
    nodes[child_index].parent = parent_index;
    nodes[parent_index].last_child = child_index;
    nodes[parent_index].child_count += 1;
    return true;
}

fn bootstrap_parser_advance(state: *BootstrapParserState) -> void {
    if (state->error != RuntimeError.none) {
        return;
    }
    state->previous = state->current;
    while (state->cursor < state->tokens.count) {
        let token_result: BootstrapTokenResult = bootstrap_token_buffer_get(state->tokens, state->cursor);
        if (token_result.error != RuntimeError.none) {
            state->error = token_result.error;
            return;
        }
        state->current = token_result.token;
        state->current_index = state->cursor;
        state->cursor += 1;
        if (state->current.kind != BootstrapTokenKind.invalid) {
            return;
        }
    }
    state->error = RuntimeError.invalid_argument;
}

fn bootstrap_parser_check(state: *BootstrapParserState, kind: BootstrapTokenKind) -> bool {
    return state->current.kind == kind;
}

fn bootstrap_parser_peek_kind(state: *BootstrapParserState) -> BootstrapTokenKind {
    var cursor: usize = state->cursor;
    while (cursor < state->tokens.count) {
        let token_result: BootstrapTokenResult = bootstrap_token_buffer_get(state->tokens, cursor);
        if (token_result.error != RuntimeError.none) {
            state->error = token_result.error;
            return BootstrapTokenKind.invalid;
        }
        if (token_result.token.kind != BootstrapTokenKind.invalid) {
            return token_result.token.kind;
        }
        cursor += 1;
    }
    return BootstrapTokenKind.invalid;
}

fn bootstrap_parser_match(state: *BootstrapParserState, kind: BootstrapTokenKind) -> bool {
    if (!bootstrap_parser_check(state, kind)) {
        return false;
    }
    if (kind != BootstrapTokenKind.end) {
        bootstrap_parser_advance(state);
    }
    return true;
}

fn bootstrap_parser_expect(state: *BootstrapParserState, kind: BootstrapTokenKind) -> bool {
    if (bootstrap_parser_match(state, kind)) {
        return true;
    }
    return bootstrap_parser_add_diagnostic(
        state, BootstrapDiagnosticKind.expected_token, state->current.span, kind, state->current.kind, 0) && false;
}

fn bootstrap_parser_enter_nesting(state: *BootstrapParserState, span: BootstrapSourceSpan) -> bool {
    if (state->nesting_depth >= BootstrapParserLimit.maximum_nesting as usize) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.nesting_limit, span, BootstrapTokenKind.invalid, state->current.kind,
            state->nesting_depth);
        return false;
    }
    state->nesting_depth += 1;
    return true;
}

fn bootstrap_parser_leave_nesting(state: *BootstrapParserState) -> void {
    if (state->nesting_depth == 0) {
        if (state->error == RuntimeError.none) {
            state->error = RuntimeError.invalid_argument;
        }
        return;
    }
    state->nesting_depth -= 1;
}

fn bootstrap_parser_is_builtin_type(kind: BootstrapTokenKind) -> bool {
    var builtin: [15]BootstrapTokenKind = {};
    builtin[0] = BootstrapTokenKind.keyword_bool;
    builtin[1] = BootstrapTokenKind.keyword_i8;
    builtin[2] = BootstrapTokenKind.keyword_i16;
    builtin[3] = BootstrapTokenKind.keyword_i32;
    builtin[4] = BootstrapTokenKind.keyword_i64;
    builtin[5] = BootstrapTokenKind.keyword_isize;
    builtin[6] = BootstrapTokenKind.keyword_u8;
    builtin[7] = BootstrapTokenKind.keyword_u16;
    builtin[8] = BootstrapTokenKind.keyword_u32;
    builtin[9] = BootstrapTokenKind.keyword_u64;
    builtin[10] = BootstrapTokenKind.keyword_usize;
    builtin[11] = BootstrapTokenKind.keyword_f32;
    builtin[12] = BootstrapTokenKind.keyword_f64;
    builtin[13] = BootstrapTokenKind.keyword_void;
    builtin[14] = BootstrapTokenKind.keyword_va_list;
    var index: usize = 0;
    while (index < 15) {
        if (kind == builtin[index]) {
            return true;
        }
        index += 1;
    }
    return false;
}

fn bootstrap_parser_parse_integer_token(state: *BootstrapParserState, token: BootstrapToken) -> bool {
    var index: usize = 0;
    var base: u64 = 10;
    if (token.span.length >= 2 && state->source.data[token.span.offset] == 48) {
        let prefix: u8 = state->source.data[token.span.offset + 1];
        if (prefix == 98 || prefix == 66) {
            base = 2;
            index = 2;
        } else if (prefix == 111 || prefix == 79) {
            base = 8;
            index = 2;
        } else if (prefix == 120 || prefix == 88) {
            base = 16;
            index = 2;
        }
    }

    var value: u64 = 0;
    var saw_digit: bool = false;
    var previous_separator: bool = false;
    while (index < token.span.length) {
        let byte: u8 = state->source.data[token.span.offset + index];
        if (byte == 95) {
            if (!saw_digit || previous_separator) {
                bootstrap_parser_add_diagnostic(
                    state, BootstrapDiagnosticKind.invalid_integer, token.span, BootstrapTokenKind.integer, token.kind,
                    1);
                return false;
            }
            previous_separator = true;
            index += 1;
            continue;
        }

        var digit: u64 = 16;
        if (byte >= 48 && byte <= 57) {
            digit = (byte - 48) as u64;
        } else if (byte >= 65 && byte <= 70) {
            digit = (byte - 65 + 10) as u64;
        } else if (byte >= 97 && byte <= 102) {
            digit = (byte - 97 + 10) as u64;
        }
        if (digit >= base) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_integer, token.span, BootstrapTokenKind.integer, token.kind, 2);
            return false;
        }
        if (value > (18446744073709551615 - digit) / base) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_integer, token.span, BootstrapTokenKind.integer, token.kind, 3);
            return false;
        }
        value = value * base + digit;
        saw_digit = true;
        previous_separator = false;
        index += 1;
    }
    if (!saw_digit || previous_separator) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.invalid_integer, token.span, BootstrapTokenKind.integer, token.kind, 4);
        return false;
    }
    return true;
}

fn bootstrap_parser_is_hex_digit(byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102);
}

fn bootstrap_parser_scan_float_digits(
    state: *BootstrapParserState, token: BootstrapToken, start: usize, hexadecimal: bool) -> usize {
    var index: usize = start;
    var saw_digit: bool = false;
    var previous_separator: bool = false;
    while (index < token.span.length) {
        let byte: u8 = state->source.data[token.span.offset + index];
        if ((hexadecimal && bootstrap_parser_is_hex_digit(byte)) || (!hexadecimal && byte >= 48 && byte <= 57)) {
            saw_digit = true;
            previous_separator = false;
            index += 1;
            continue;
        }
        if (byte == 95) {
            if (!saw_digit || previous_separator || index + 1 >= token.span.length) {
                return bootstrap_syntax_no_index();
            }
            let next: u8 = state->source.data[token.span.offset + index + 1];
            if (!bootstrap_parser_is_hex_digit(next) && (hexadecimal || next < 48 || next > 57)) {
                return bootstrap_syntax_no_index();
            }
            previous_separator = true;
            index += 1;
            continue;
        }
        break;
    }
    if (!saw_digit || previous_separator) {
        return bootstrap_syntax_no_index();
    }
    return index;
}

fn bootstrap_parser_validate_hex_float(state: *BootstrapParserState, token: BootstrapToken) -> bool {
    let none: usize = bootstrap_syntax_no_index();
    var index: usize = 2;
    var saw_mantissa: bool = false;
    let integer_end: usize = bootstrap_parser_scan_float_digits(state, token, index, true);
    if (integer_end != none) {
        saw_mantissa = true;
        index = integer_end;
    }
    if (index < token.span.length && state->source.data[token.span.offset + index] == 46) {
        let fraction_end: usize = bootstrap_parser_scan_float_digits(state, token, index + 1, true);
        if (fraction_end == none) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_floating, token.span, BootstrapTokenKind.floating, token.kind, 0);
            return false;
        }
        saw_mantissa = true;
        index = fraction_end;
    }
    var valid: bool = saw_mantissa;
    if (valid && index < token.span.length) {
        let exponent: u8 = state->source.data[token.span.offset + index];
        if (exponent == 112 || exponent == 80) {
            index += 1;
            if (index < token.span.length) {
                let sign: u8 = state->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    index += 1;
                }
            }
            index = bootstrap_parser_scan_float_digits(state, token, index, false);
            valid = index == token.span.length;
        } else {
            valid = false;
        }
    } else {
        valid = false;
    }
    if (!valid) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.invalid_floating, token.span, BootstrapTokenKind.floating, token.kind, 0);
        return false;
    }
    return true;
}

fn bootstrap_parser_validate_float(state: *BootstrapParserState, token: BootstrapToken) -> bool {
    if (token.span.length >= 2 && state->source.data[token.span.offset] == 48 &&
        (state->source.data[token.span.offset + 1] == 120 || state->source.data[token.span.offset + 1] == 88)) {
        return bootstrap_parser_validate_hex_float(state, token);
    }
    let none: usize = bootstrap_syntax_no_index();
    var index: usize = bootstrap_parser_scan_float_digits(state, token, 0, false);
    var has_fraction: bool = false;
    var has_exponent: bool = false;
    if (index != none && index < token.span.length && state->source.data[token.span.offset + index] == 46) {
        has_fraction = true;
        index = bootstrap_parser_scan_float_digits(state, token, index + 1, false);
    }
    if (index != none && index < token.span.length) {
        let exponent: u8 = state->source.data[token.span.offset + index];
        if (exponent == 101 || exponent == 69) {
            has_exponent = true;
            index += 1;
            if (index < token.span.length) {
                let sign: u8 = state->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    index += 1;
                }
            }
            index = bootstrap_parser_scan_float_digits(state, token, index, false);
        }
    }
    if (index == none || index != token.span.length || (!has_fraction && !has_exponent)) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.invalid_floating, token.span, BootstrapTokenKind.floating, token.kind, 0);
        return false;
    }
    return true;
}

fn bootstrap_parser_parse_type(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let start: BootstrapToken = state->current;
    let start_index: usize = state->current_index;
    if (!bootstrap_parser_enter_nesting(state, start.span)) {
        return none;
    }

    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_fn)) {
        let node: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.type_function, start.span, start_index);
        bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
        if (state->current.kind != BootstrapTokenKind.right_parenthesis) {
            while (state->error == RuntimeError.none) {
                // A `...` tail marks a variadic signature; the semantic layer
                // rejects it on every non-function mount (fn-pointer types
                // included) with invalid_variadic.
                if (state->current.kind == BootstrapTokenKind.dot_dot_dot) {
                    bootstrap_parser_advance(state);
                    bootstrap_parser_add_node_flags(state, node, BootstrapSyntaxFlag.variadic as usize);
                    break;
                }
                let parameter: usize = bootstrap_parser_parse_type(state);
                if (parameter != none) {
                    bootstrap_parser_add_child(state, node, parameter);
                }
                if (!bootstrap_parser_match(
                        state, BootstrapTokenKind.comma)) {
                    break;
                }
            }
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
        if (bootstrap_parser_match(
                state, BootstrapTokenKind.arrow)) {
            bootstrap_parser_add_node_flags(state, node, BootstrapSyntaxFlag.has_return_type as usize);
            let return_type: usize = bootstrap_parser_parse_type(state);
            if (return_type != none) {
                bootstrap_parser_add_child(state, node, return_type);
            }
        }
        bootstrap_parser_leave_nesting(state);
        return node;
    }

    if (bootstrap_parser_match(state, BootstrapTokenKind.star)) {
        let node: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.type_pointer, start.span, start_index);
        var seen_const: bool = false;
        var seen_volatile: bool = false;
        var qualifiers_done: bool = false;
        while (!qualifiers_done && state->error == RuntimeError.none) {
            if (state->current.kind == BootstrapTokenKind.keyword_const) {
                if (seen_const) {
                    bootstrap_parser_add_diagnostic(
                        state, BootstrapDiagnosticKind.expected_type, state->current.span,
                        BootstrapTokenKind.identifier, state->current.kind, 0);
                    qualifiers_done = true;
                } else {
                    seen_const = true;
                    bootstrap_parser_add_node_flags(state, node, BootstrapSyntaxFlag.read_only as usize);
                    bootstrap_parser_advance(state);
                }
            } else if (state->current.kind == BootstrapTokenKind.keyword_volatile) {
                if (seen_volatile) {
                    bootstrap_parser_add_diagnostic(
                        state, BootstrapDiagnosticKind.expected_type, state->current.span,
                        BootstrapTokenKind.identifier, state->current.kind, 0);
                    qualifiers_done = true;
                } else {
                    seen_volatile = true;
                    bootstrap_parser_add_node_flags(state, node, BootstrapSyntaxFlag.volatile_ as usize);
                    bootstrap_parser_advance(state);
                }
            } else {
                qualifiers_done = true;
            }
        }
        let pointee: usize = bootstrap_parser_parse_type(state);
        if (pointee != none) {
            bootstrap_parser_add_child(state, node, pointee);
            let pointee_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, pointee);
            if (pointee_node != null) {
                bootstrap_parser_set_node_span(
                    state, node, bootstrap_parser_join_spans(start.span, pointee_node->span));
            }
        }
        bootstrap_parser_leave_nesting(state);
        return node;
    }

    if (bootstrap_parser_match(
            state, BootstrapTokenKind.left_bracket)) {
        let node: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.type_array, start.span, start_index);
        if (state->current.kind == BootstrapTokenKind.question) {
            bootstrap_parser_add_node_flags(state, node, BootstrapSyntaxFlag.flexible as usize);
            bootstrap_parser_advance(state);
        } else {
            let count_expression: usize = bootstrap_parser_parse_expression(state);
            if (count_expression != none) {
                bootstrap_parser_add_child(state, node, count_expression);
            }
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.right_bracket);
        let element: usize = bootstrap_parser_parse_type(state);
        if (element != none) {
            bootstrap_parser_add_child(state, node, element);
            let element_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, element);
            if (element_node != null) {
                bootstrap_parser_set_node_span(
                    state, node, bootstrap_parser_join_spans(start.span, element_node->span));
            }
        }
        bootstrap_parser_leave_nesting(state);
        return node;
    }

    var kind: BootstrapSyntaxKind = BootstrapSyntaxKind.invalid;
    if (state->current.kind == BootstrapTokenKind.identifier) {
        kind = BootstrapSyntaxKind.type_named;
    } else if (bootstrap_parser_is_builtin_type(
            state->current.kind)) {
        kind = BootstrapSyntaxKind.type_builtin;
    }
    if (kind == BootstrapSyntaxKind.invalid) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.expected_type, state->current.span, BootstrapTokenKind.identifier,
            state->current.kind, 0);
        if (state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
        bootstrap_parser_leave_nesting(state);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.invalid, start.span, start_index);
    }

    let node: usize = bootstrap_parser_new_node(state, kind, state->current.span, state->current_index);
    bootstrap_parser_advance(state);
    bootstrap_parser_leave_nesting(state);
    return node;
}

fn bootstrap_parser_parse_expression(state: *BootstrapParserState) -> usize {
    return bootstrap_parser_parse_conditional_expression(state);
}

fn bootstrap_parser_parse_aggregate_initializer(
    state: *BootstrapParserState, left_brace: BootstrapToken, left_brace_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.right_brace)) {
        return bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.zero_initializer,
            bootstrap_parser_join_spans(left_brace.span, state->previous.span), left_brace_index);
    }

    let initializer: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.aggregate_initializer, left_brace.span, left_brace_index);
    if (!bootstrap_parser_enter_nesting(
            state, left_brace.span)) {
        return initializer;
    }
    while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
        state->current.kind != BootstrapTokenKind.end) {
        let offset_before: usize = state->current.span.offset;
        if (state->current.kind == BootstrapTokenKind.left_bracket) {
            let bracket: BootstrapToken = state->current;
            let bracket_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            let element: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.initializer_element, bracket.span, bracket_index);
            bootstrap_parser_add_node_flags(state, element, BootstrapSyntaxFlag.indexed as usize);
            let index: usize = bootstrap_parser_parse_expression(state);
            if (index != none) {
                bootstrap_parser_add_child(state, element, index);
            }
            bootstrap_parser_expect(state, BootstrapTokenKind.right_bracket);
            bootstrap_parser_expect(state, BootstrapTokenKind.equal);
            let indexed_value: usize = bootstrap_parser_parse_expression(state);
            if (indexed_value != none) {
                bootstrap_parser_add_child(state, element, indexed_value);
                let value_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, indexed_value);
                if (value_node != null) {
                    bootstrap_parser_set_node_span(
                        state, element, bootstrap_parser_join_spans(bracket.span, value_node->span));
                }
            }
            bootstrap_parser_add_child(state, initializer, element);
        } else if (state->current.kind == BootstrapTokenKind.identifier &&
            bootstrap_parser_token_at(state, state->current_index + 1).kind == BootstrapTokenKind.equal) {
            let name: BootstrapToken = state->current;
            let name_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            let field: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.initializer_field, name.span, name_index);
            bootstrap_parser_expect(state, BootstrapTokenKind.equal);
            let value: usize = bootstrap_parser_parse_expression(state);
            if (value != none) {
                bootstrap_parser_add_child(state, field, value);
                let value_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, value);
                if (value_node != null) {
                    bootstrap_parser_set_node_span(
                        state, field, bootstrap_parser_join_spans(name.span, value_node->span));
                }
            }
            bootstrap_parser_add_child(state, initializer, field);
        } else {
            let value_index: usize = state->current_index;
            let value: usize = bootstrap_parser_parse_expression(state);
            if (value != none) {
                let value_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, value);
                let element: usize = bootstrap_parser_new_node(
                    state, BootstrapSyntaxKind.initializer_element,
                    value_node == null ? state->previous.span : value_node->span, value_index);
                bootstrap_parser_add_child(state, element, value);
                bootstrap_parser_add_child(state, initializer, element);
            } else if (state->current.kind != BootstrapTokenKind.end) {
                bootstrap_parser_advance(state);
            }
        }

        if (!bootstrap_parser_match(
                state, BootstrapTokenKind.comma)) {
            break;
        }
        if (state->current.kind == BootstrapTokenKind.right_brace) {
            break;
        }
        if (state->current.span.offset == offset_before && state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
    bootstrap_parser_set_node_span(
        state, initializer, bootstrap_parser_join_spans(left_brace.span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return initializer;
}

fn bootstrap_parser_parse_call(
    state: *BootstrapParserState, callee: usize, left_parenthesis: BootstrapToken, left_parenthesis_index: usize
) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let callee_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, callee);
    let start_span: BootstrapSourceSpan = callee_node == null ? left_parenthesis.span : callee_node->span;
    let call: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.call_expression, start_span, left_parenthesis_index);
    bootstrap_parser_add_child(state, call, callee);
    if (!bootstrap_parser_enter_nesting(
            state, left_parenthesis.span)) {
        return call;
    }
    if (state->current.kind != BootstrapTokenKind.right_parenthesis) {
        while (state->error == RuntimeError.none) {
            let argument: usize = bootstrap_parser_parse_expression(state);
            if (argument != none) {
                bootstrap_parser_add_child(state, call, argument);
            }
            if (!bootstrap_parser_match(
                    state, BootstrapTokenKind.comma)) {
                break;
            }
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_set_node_span(state, call, bootstrap_parser_join_spans(start_span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return call;
}

fn bootstrap_parser_parse_intrinsic_expression(state: *BootstrapParserState, at_sign: BootstrapToken) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let name_index: usize = state->current_index;
    let intrinsic: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.intrinsic_expression, at_sign.span, name_index);
    if (bootstrap_parser_expect(
            state, BootstrapTokenKind.identifier) &&
        bootstrap_parser_expect(
            state, BootstrapTokenKind.left_parenthesis)) {
        if (!bootstrap_parser_enter_nesting(
                state, at_sign.span)) {
            return intrinsic;
        }
        if (state->current.kind != BootstrapTokenKind.right_parenthesis) {
            while (state->error == RuntimeError.none) {
                let argument: usize = bootstrap_parser_parse_expression(state);
                if (argument != none) {
                    bootstrap_parser_add_child(state, intrinsic, argument);
                }
                if (!bootstrap_parser_match(
                        state, BootstrapTokenKind.comma)) {
                    break;
                }
            }
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
        bootstrap_parser_leave_nesting(state);
    }
    bootstrap_parser_set_node_span(
        state, intrinsic, bootstrap_parser_join_spans(at_sign.span, state->previous.span));
    return intrinsic;
}

fn bootstrap_parser_parse_layout_query(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    if (!bootstrap_parser_enter_nesting(
            state, keyword.span)) {
        return bootstrap_syntax_no_index();
    }
    var kind: BootstrapSyntaxKind = BootstrapSyntaxKind.sizeof_expression;
    if (keyword.kind == BootstrapTokenKind.keyword_alignof) {
        kind = BootstrapSyntaxKind.alignof_expression;
    } else if (keyword.kind == BootstrapTokenKind.keyword_offsetof) {
        kind = BootstrapSyntaxKind.offsetof_expression;
    }
    let query: usize = bootstrap_parser_new_node(state, kind, keyword.span, keyword_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let type_node: usize = bootstrap_parser_parse_type(state);
    if (type_node != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, query, type_node);
    }
    if (keyword.kind == BootstrapTokenKind.keyword_offsetof) {
        bootstrap_parser_expect(state, BootstrapTokenKind.comma);
        let member: BootstrapToken = state->current;
        let member_index: usize = state->current_index;
        if (bootstrap_parser_expect(
                state, BootstrapTokenKind.identifier)) {
            let member_node: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.name_expression, member.span, member_index);
            bootstrap_parser_add_child(state, query, member_node);
        }
        while (bootstrap_parser_match(state, BootstrapTokenKind.dot)) {
            let nested: BootstrapToken = state->current;
            let nested_index: usize = state->current_index;
            if (!bootstrap_parser_expect(
                    state, BootstrapTokenKind.identifier)) {
                break;
            }
            let nested_node: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.name_expression, nested.span, nested_index);
            bootstrap_parser_add_child(state, query, nested_node);
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_set_node_span(state, query, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return query;
}

fn bootstrap_parser_parse_va_arg_expression(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    if (!bootstrap_parser_enter_nesting(
            state, keyword.span)) {
        return bootstrap_syntax_no_index();
    }
    let query: usize =
        bootstrap_parser_new_node(state, BootstrapSyntaxKind.va_arg_expression, keyword.span, keyword_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let list_expression: usize = bootstrap_parser_parse_expression(state);
    if (list_expression != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, query, list_expression);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.comma);
    let type_node: usize = bootstrap_parser_parse_type(state);
    if (type_node != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, query, type_node);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_set_node_span(state, query, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return query;
}

fn bootstrap_parser_parse_primary_expression(state: *BootstrapParserState) -> usize {
    let token: BootstrapToken = state->current;
    let token_index: usize = state->current_index;
    if (token.kind == BootstrapTokenKind.keyword_va_arg) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_va_arg_expression(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_sizeof || token.kind == BootstrapTokenKind.keyword_alignof ||
        token.kind == BootstrapTokenKind.keyword_offsetof) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_layout_query(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.at_sign) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_intrinsic_expression(state, token);
    }
    if (token.kind == BootstrapTokenKind.integer) {
        bootstrap_parser_advance(state);
        bootstrap_parser_parse_integer_token(state, token);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.integer_expression, token.span, token_index);
    }
    if (token.kind == BootstrapTokenKind.floating) {
        bootstrap_parser_advance(state);
        bootstrap_parser_validate_float(state, token);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.floating_expression, token.span, token_index);
    }
    if (token.kind == BootstrapTokenKind.character) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.character_expression, token.span, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_true || token.kind == BootstrapTokenKind.keyword_false) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.boolean_expression, token.span, token_index);
    }
    if (token.kind == BootstrapTokenKind.string || token.kind == BootstrapTokenKind.string_u16 ||
        token.kind == BootstrapTokenKind.string_u32) {
        bootstrap_parser_advance(state);
        let node: usize =
            bootstrap_parser_new_node(state, BootstrapSyntaxKind.string_expression, token.span, token_index);
        while (state->current.kind == BootstrapTokenKind.string ||
            state->current.kind == BootstrapTokenKind.string_u16 ||
            state->current.kind == BootstrapTokenKind.string_u32) {
            let part: BootstrapToken = state->current;
            let part_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            bootstrap_parser_add_child(
                state, node,
                bootstrap_parser_new_node(state, BootstrapSyntaxKind.string_expression, part.span, part_index));
            bootstrap_parser_set_node_span(state, node, bootstrap_parser_join_spans(token.span, state->previous.span));
        }
        return node;
    }
    if (token.kind == BootstrapTokenKind.keyword_null) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.null_expression, token.span, token_index);
    }
    if (token.kind == BootstrapTokenKind.left_brace) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_aggregate_initializer(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.identifier) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_new_node(state, BootstrapSyntaxKind.name_expression, token.span, token_index);
    }
    if (token.kind == BootstrapTokenKind.left_parenthesis) {
        bootstrap_parser_advance(state);
        if (!bootstrap_parser_enter_nesting(
                state, token.span)) {
            return bootstrap_syntax_no_index();
        }
        let expression: usize = bootstrap_parser_parse_expression(state);
        bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
        let node: usize = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.parenthesized_expression,
            bootstrap_parser_join_spans(token.span, state->previous.span), token_index);
        if (expression != bootstrap_syntax_no_index()) {
            bootstrap_parser_add_child(state, node, expression);
        }
        bootstrap_parser_leave_nesting(state);
        return node;
    }

    bootstrap_parser_add_diagnostic(
        state, BootstrapDiagnosticKind.expected_expression, token.span, BootstrapTokenKind.identifier, token.kind, 0);
    if (token.kind != BootstrapTokenKind.end) {
        bootstrap_parser_advance(state);
    }
    return bootstrap_parser_new_node(state, BootstrapSyntaxKind.invalid, token.span, token_index);
}

fn bootstrap_parser_parse_postfix_expression(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    var expression: usize = bootstrap_parser_parse_primary_expression(state);
    while (expression != none && state->error == RuntimeError.none) {
        if (state->current.kind == BootstrapTokenKind.left_parenthesis) {
            let operator: BootstrapToken = state->current;
            let operator_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            expression = bootstrap_parser_parse_call(state, expression, operator, operator_index);
            continue;
        }
        if (state->current.kind == BootstrapTokenKind.left_bracket) {
            let operator: BootstrapToken = state->current;
            let operator_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            if (!bootstrap_parser_enter_nesting(
                    state, operator.span)) {
                return expression;
            }
            let index: usize = bootstrap_parser_parse_expression(state);
            bootstrap_parser_expect(state, BootstrapTokenKind.right_bracket);
            let expression_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, expression);
            let start_span: BootstrapSourceSpan = expression_node == null ? operator.span : expression_node->span;
            let indexed: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.index_expression,
                bootstrap_parser_join_spans(start_span, state->previous.span), operator_index);
            bootstrap_parser_add_child(state, indexed, expression);
            if (index != none) {
                bootstrap_parser_add_child(state, indexed, index);
            }
            bootstrap_parser_leave_nesting(state);
            expression = indexed;
            continue;
        }
        if (state->current.kind == BootstrapTokenKind.dot || state->current.kind == BootstrapTokenKind.arrow) {
            let operator: BootstrapToken = state->current;
            let operator_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            let name: BootstrapToken = state->current;
            let name_index: usize = state->current_index;
            let expression_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, expression);
            let start_span: BootstrapSourceSpan = expression_node == null ? operator.span : expression_node->span;
            let member: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.member_expression, start_span, operator_index);
            bootstrap_parser_add_child(state, member, expression);
            if (bootstrap_parser_expect(
                    state, BootstrapTokenKind.identifier)) {
                let name_node: usize = bootstrap_parser_new_node(
                    state, BootstrapSyntaxKind.name_expression, name.span, name_index);
                bootstrap_parser_add_child(state, member, name_node);
                bootstrap_parser_set_node_span(state, member, bootstrap_parser_join_spans(start_span, name.span));
            }
            expression = member;
            continue;
        }
        break;
    }
    return expression;
}

fn bootstrap_parser_is_unary_operator(kind: BootstrapTokenKind) -> bool {
    return kind == BootstrapTokenKind.plus || kind == BootstrapTokenKind.minus || kind == BootstrapTokenKind.bang ||
        kind == BootstrapTokenKind.tilde || kind == BootstrapTokenKind.star || kind == BootstrapTokenKind.ampersand;
}

fn bootstrap_parser_parse_unary_expression(state: *BootstrapParserState) -> usize {
    if (!bootstrap_parser_is_unary_operator(
            state->current.kind)) {
        return bootstrap_parser_parse_postfix_expression(state);
    }
    let operator: BootstrapToken = state->current;
    let operator_index: usize = state->current_index;
    if (!bootstrap_parser_enter_nesting(
            state, operator.span)) {
        return bootstrap_syntax_no_index();
    }
    bootstrap_parser_advance(state);
    let operand: usize = bootstrap_parser_parse_unary_expression(state);
    bootstrap_parser_leave_nesting(state);
    let node: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.unary_expression, operator.span, operator_index);
    if (operand != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, node, operand);
        let operand_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, operand);
        if (operand_node != null) {
            bootstrap_parser_set_node_span(state, node, bootstrap_parser_join_spans(operator.span, operand_node->span));
        }
    }
    return node;
}

fn bootstrap_parser_parse_cast_expression(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    var expression: usize = bootstrap_parser_parse_unary_expression(state);
    while (expression != none && state->current.kind == BootstrapTokenKind.keyword_as) {
        let operator: BootstrapToken = state->current;
        let operator_index: usize = state->current_index;
        bootstrap_parser_advance(state);
        let target: usize = bootstrap_parser_parse_type(state);
        let expression_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, expression);
        var target_node: *BootstrapSyntaxNode = null;
        if (target != none) {
            target_node = bootstrap_parser_node_pointer(state, target);
        }
        var span: BootstrapSourceSpan = operator.span;
        if (expression_node != null && target_node != null) {
            span = bootstrap_parser_join_spans(expression_node->span, target_node->span);
        }
        let cast: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.cast_expression, span, operator_index);
        bootstrap_parser_add_child(state, cast, expression);
        if (target != none) {
            bootstrap_parser_add_child(state, cast, target);
        }
        expression = cast;
    }
    return expression;
}

fn bootstrap_parser_binary_precedence(kind: BootstrapTokenKind) -> usize {
    if (kind == BootstrapTokenKind.logical_or) {
        return 1;
    }
    if (kind == BootstrapTokenKind.logical_and) {
        return 2;
    }
    if (kind == BootstrapTokenKind.pipe) {
        return 3;
    }
    if (kind == BootstrapTokenKind.caret) {
        return 4;
    }
    if (kind == BootstrapTokenKind.ampersand) {
        return 5;
    }
    if (kind == BootstrapTokenKind.equal_equal || kind == BootstrapTokenKind.bang_equal) {
        return 6;
    }
    if (kind == BootstrapTokenKind.less || kind == BootstrapTokenKind.less_equal ||
        kind == BootstrapTokenKind.greater || kind == BootstrapTokenKind.greater_equal) {
        return 7;
    }
    if (kind == BootstrapTokenKind.shift_left || kind == BootstrapTokenKind.shift_right) {
        return 8;
    }
    if (kind == BootstrapTokenKind.plus || kind == BootstrapTokenKind.minus) {
        return 9;
    }
    if (kind == BootstrapTokenKind.star || kind == BootstrapTokenKind.slash || kind == BootstrapTokenKind.percent) {
        return 10;
    }
    return 0;
}

fn bootstrap_parser_parse_binary_expression(state: *BootstrapParserState, minimum_precedence: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    var left: usize = bootstrap_parser_parse_cast_expression(state);
    if (left == none) {
        return none;
    }
    while (state->error == RuntimeError.none) {
        let precedence: usize = bootstrap_parser_binary_precedence(state->current.kind);
        if (precedence < minimum_precedence) {
            break;
        }
        let operator: BootstrapToken = state->current;
        let operator_index: usize = state->current_index;
        bootstrap_parser_advance(state);
        let right: usize = bootstrap_parser_parse_binary_expression(state, precedence + 1);
        if (right == none) {
            return left;
        }
        let left_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, left);
        let right_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, right);
        var span: BootstrapSourceSpan = operator.span;
        if (left_node != null && right_node != null) {
            span = bootstrap_parser_join_spans(left_node->span, right_node->span);
        }
        let binary: usize = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.binary_expression, span, operator_index);
        bootstrap_parser_add_child(state, binary, left);
        bootstrap_parser_add_child(state, binary, right);
        left = binary;
    }
    return left;
}

fn bootstrap_parser_parse_conditional_expression(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let condition: usize = bootstrap_parser_parse_binary_expression(state, 1);
    if (condition == none || state->current.kind != BootstrapTokenKind.question) {
        return condition;
    }
    let question: BootstrapToken = state->current;
    let question_index: usize = state->current_index;
    bootstrap_parser_advance(state);
    if (!bootstrap_parser_enter_nesting(
            state, question.span)) {
        return condition;
    }
    let then_expression: usize = bootstrap_parser_parse_expression(state);
    bootstrap_parser_expect(state, BootstrapTokenKind.colon);
    let else_expression: usize = bootstrap_parser_parse_conditional_expression(state);
    bootstrap_parser_leave_nesting(state);
    let condition_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, condition);
    var else_node: *BootstrapSyntaxNode = null;
    if (else_expression != none) {
        else_node = bootstrap_parser_node_pointer(state, else_expression);
    }
    var span: BootstrapSourceSpan = question.span;
    if (condition_node != null && else_node != null) {
        span = bootstrap_parser_join_spans(condition_node->span, else_node->span);
    }
    let conditional: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.conditional_expression, span, question_index);
    bootstrap_parser_add_child(state, conditional, condition);
    if (then_expression != none) {
        bootstrap_parser_add_child(state, conditional, then_expression);
    }
    if (else_expression != none) {
        bootstrap_parser_add_child(state, conditional, else_expression);
    }
    return conditional;
}

fn bootstrap_parser_is_assignment_operator(kind: BootstrapTokenKind) -> bool {
    return kind == BootstrapTokenKind.equal || kind == BootstrapTokenKind.plus_equal ||
        kind == BootstrapTokenKind.minus_equal || kind == BootstrapTokenKind.star_equal ||
        kind == BootstrapTokenKind.slash_equal || kind == BootstrapTokenKind.percent_equal ||
        kind == BootstrapTokenKind.ampersand_equal || kind == BootstrapTokenKind.pipe_equal ||
        kind == BootstrapTokenKind.caret_equal || kind == BootstrapTokenKind.shift_left_equal ||
        kind == BootstrapTokenKind.shift_right_equal;
}

fn bootstrap_parser_parse_expression_statement(state: *BootstrapParserState, terminator: BootstrapTokenKind) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let expression: usize = bootstrap_parser_parse_expression(state);
    if (expression == none) {
        return none;
    }
    if (bootstrap_parser_is_assignment_operator(
            state->current.kind)) {
        let operator: BootstrapToken = state->current;
        let operator_index: usize = state->current_index;
        bootstrap_parser_advance(state);
        let value: usize = bootstrap_parser_parse_expression(state);
        bootstrap_parser_expect(state, terminator);
        let expression_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, expression);
        let start_span: BootstrapSourceSpan = expression_node == null ? operator.span : expression_node->span;
        let assignment: usize = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.assignment_statement,
            bootstrap_parser_join_spans(start_span, state->previous.span), operator_index);
        bootstrap_parser_add_child(state, assignment, expression);
        if (value != none) {
            bootstrap_parser_add_child(state, assignment, value);
        }
        return assignment;
    }

    bootstrap_parser_expect(state, terminator);
    let expression_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, expression);
    let span: BootstrapSourceSpan = expression_node == null ? state->previous.span :
            bootstrap_parser_join_spans(expression_node->span, state->previous.span);
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.expression_statement, span, expression_node == null ? bootstrap_syntax_no_index() :
            expression_node->token_index);
    bootstrap_parser_add_child(state, statement, expression);
    return statement;
}

fn bootstrap_parser_parse_attributes(
    state: *BootstrapParserState, first_attribute: *usize, attribute_count: *usize) -> bool {
    let none: usize = bootstrap_syntax_no_index();
    if (first_attribute == null || attribute_count == null) {
        return false;
    }
    *first_attribute = none;
    *attribute_count = 0;
    while (state->error == RuntimeError.none && state->current.kind == BootstrapTokenKind.at_sign) {
        let at_token: BootstrapToken = state->current;
        bootstrap_parser_advance(state);
        let name: BootstrapToken = state->current;
        let name_index: usize = state->current_index;
        if (!bootstrap_parser_expect(
                state, BootstrapTokenKind.identifier)) {
            return false;
        }
        let attribute: usize = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.attribute, bootstrap_parser_join_spans(at_token.span, name.span), name_index);
        if (attribute == none) {
            return false;
        }
        if (*attribute_count == 0) {
            *first_attribute = attribute;
        }
        *attribute_count += 1;
        if (bootstrap_parser_match(
                state, BootstrapTokenKind.left_parenthesis)) {
            if (state->current.kind != BootstrapTokenKind.right_parenthesis) {
                while (state->error == RuntimeError.none) {
                    var argument: usize = none;
                    if (state->current.kind == BootstrapTokenKind.identifier &&
                        bootstrap_parser_token_at(state, state->current_index + 1).kind == BootstrapTokenKind.colon) {
                        let argument_name: BootstrapToken = state->current;
                        let argument_name_index: usize = state->current_index;
                        bootstrap_parser_advance(state);
                        bootstrap_parser_advance(state);
                        let argument_value: usize = bootstrap_parser_parse_expression(state);
                        if (argument_value == none) {
                            return false;
                        }
                        argument = bootstrap_parser_new_node(
                            state, BootstrapSyntaxKind.named_argument,
                            bootstrap_parser_join_spans(argument_name.span, state->previous.span), argument_name_index);
                        if (argument == none) {
                            return false;
                        }
                        bootstrap_parser_add_child(state, argument, argument_value);
                    } else {
                        argument = bootstrap_parser_parse_expression(state);
                    }
                    if (argument == none) {
                        return false;
                    }
                    bootstrap_parser_add_child(state, attribute, argument);
                    if (!bootstrap_parser_match(
                            state, BootstrapTokenKind.comma)) {
                        break;
                    }
                }
            }
            if (!bootstrap_parser_expect(
                    state, BootstrapTokenKind.right_parenthesis)) {
                return false;
            }
            bootstrap_parser_add_node_flags(state, attribute, BootstrapSyntaxFlag.has_arguments as usize);
            bootstrap_parser_set_node_span(
                state, attribute, bootstrap_parser_join_spans(at_token.span, state->previous.span));
        }
    }
    return state->error == RuntimeError.none;
}

fn bootstrap_parser_attach_attributes(
    state: *BootstrapParserState, declaration: usize, first_attribute: usize, attribute_count: usize) -> bool {
    var index: usize = 0;
    while (index < attribute_count) {
        if (!bootstrap_parser_add_child(state, declaration, first_attribute + index)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_parser_parse_variable_declaration(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize, is_mutable: bool,
    is_volatile: bool, first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.identifier);
    let declaration: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.variable_declaration, keyword.span, name_index);
    if (is_mutable) {
        bootstrap_parser_add_node_flags(state, declaration, BootstrapSyntaxFlag.mutable_binding as usize);
    }
    if (is_volatile) {
        bootstrap_parser_add_node_flags(state, declaration, BootstrapSyntaxFlag.volatile_ as usize);
    }
    if (bootstrap_parser_match(state, BootstrapTokenKind.colon)) {
        let type_node: usize = bootstrap_parser_parse_type(state);
        if (type_node != none) {
            bootstrap_parser_add_child(state, declaration, type_node);
        }
    } else {
        bootstrap_parser_add_node_flags(state, declaration, BootstrapSyntaxFlag.inferred_type as usize);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.equal);
    let initializer: usize = bootstrap_parser_parse_expression(state);
    if (initializer != none) {
        bootstrap_parser_add_child(state, declaration, initializer);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    bootstrap_parser_set_node_span(state, declaration, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    return declaration;
}

fn bootstrap_parser_parse_const_declaration(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize, flags: usize,
    first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.invalid_external_declaration, keyword.span,
            BootstrapTokenKind.keyword_fn, BootstrapTokenKind.identifier, 0);
    }
    bootstrap_parser_advance(state);
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.identifier);
    let declaration: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.const_declaration, keyword.span, name_index);
    bootstrap_parser_add_node_flags(state, declaration, flags);
    bootstrap_parser_expect(state, BootstrapTokenKind.colon);
    let type_node: usize = bootstrap_parser_parse_type(state);
    if (type_node != none) {
        bootstrap_parser_add_child(state, declaration, type_node);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.equal);
    let initializer: usize = bootstrap_parser_parse_expression(state);
    if (initializer != none) {
        bootstrap_parser_add_child(state, declaration, initializer);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    bootstrap_parser_set_node_span(state, declaration, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    return declaration;
}

// An asm fn body is one or more adjacent string literals between braces
// and nothing else (no semicolons; m1.4 concatenation keeps long bodies
// readable). Non-string content is carried as an invalid node so the
// semantic pass rejects it with invalid_asm_function instead of the parse
// failing here.
fn bootstrap_parser_parse_asm_body(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let left_brace: BootstrapToken = state->current;
    if (!bootstrap_parser_expect(
            state, BootstrapTokenKind.left_brace)) {
        return none;
    }
    if (!bootstrap_parser_enter_nesting(
            state, left_brace.span)) {
        return none;
    }
    var body: usize = none;
    if (state->current.kind == BootstrapTokenKind.string || state->current.kind == BootstrapTokenKind.string_u16 ||
        state->current.kind == BootstrapTokenKind.string_u32) {
        let token: BootstrapToken = state->current;
        let token_index: usize = state->current_index;
        bootstrap_parser_advance(state);
        body = bootstrap_parser_new_node(state, BootstrapSyntaxKind.string_expression, token.span, token_index);
        while (state->error == RuntimeError.none &&
            (state->current.kind == BootstrapTokenKind.string ||
                state->current.kind == BootstrapTokenKind.string_u16 ||
                state->current.kind == BootstrapTokenKind.string_u32)) {
            let part: BootstrapToken = state->current;
            let part_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            bootstrap_parser_add_child(
                state, body,
                bootstrap_parser_new_node(state, BootstrapSyntaxKind.string_expression, part.span, part_index));
            bootstrap_parser_set_node_span(state, body, bootstrap_parser_join_spans(token.span, state->previous.span));
        }
    } else if (state->current.kind != BootstrapTokenKind.right_brace) {
        body = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.invalid, state->current.span, state->current_index);
        while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
            state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
    bootstrap_parser_leave_nesting(state);
    return body;
}

fn bootstrap_parser_parse_block(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let left_brace: BootstrapToken = state->current;
    let left_brace_index: usize = state->current_index;
    if (!bootstrap_parser_expect(
            state, BootstrapTokenKind.left_brace)) {
        return none;
    }
    let block: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.block_statement, left_brace.span, left_brace_index);
    if (!bootstrap_parser_enter_nesting(
            state, left_brace.span)) {
        return block;
    }
    while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
        state->current.kind != BootstrapTokenKind.end) {
        let index_before: usize = state->current_index;
        let statement: usize = bootstrap_parser_parse_statement(state);
        if (statement != none) {
            bootstrap_parser_add_child(state, block, statement);
        }
        if (state->current_index == index_before && state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
    bootstrap_parser_set_node_span(state, block, bootstrap_parser_join_spans(left_brace.span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return block;
}

fn bootstrap_parser_parse_if_statement(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.if_statement, keyword.span, keyword_index);
    if (!bootstrap_parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let condition: usize = bootstrap_parser_parse_expression(state);
    if (condition != none) {
        bootstrap_parser_add_child(state, statement, condition);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    let then_block: usize = bootstrap_parser_parse_block(state);
    if (then_block != none) {
        bootstrap_parser_add_child(state, statement, then_block);
    }
    var end_span: BootstrapSourceSpan = state->previous.span;
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_else)) {
        var else_branch: usize = none;
        if (state->current.kind == BootstrapTokenKind.keyword_if) {
            let else_keyword: BootstrapToken = state->current;
            let else_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            else_branch = bootstrap_parser_parse_if_statement(state, else_keyword, else_index);
        } else {
            else_branch = bootstrap_parser_parse_block(state);
        }
        if (else_branch != none) {
            bootstrap_parser_add_child(state, statement, else_branch);
            let else_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, else_branch);
            if (else_node != null) {
                end_span = else_node->span;
            }
        }
    }
    bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(keyword.span, end_span));
    bootstrap_parser_leave_nesting(state);
    return statement;
}

fn bootstrap_parser_parse_while_statement(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.while_statement, keyword.span, keyword_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let condition: usize = bootstrap_parser_parse_expression(state);
    if (condition != none) {
        bootstrap_parser_add_child(state, statement, condition);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    let body: usize = bootstrap_parser_parse_block(state);
    if (body != none) {
        bootstrap_parser_add_child(state, statement, body);
        let body_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, body);
        if (body_node != null) {
            bootstrap_parser_set_node_span(
                state, statement, bootstrap_parser_join_spans(keyword.span, body_node->span));
        }
    }
    return statement;
}

fn bootstrap_parser_parse_do_statement(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.do_statement, keyword.span, keyword_index);
    if (!bootstrap_parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    let body: usize = bootstrap_parser_parse_block(state);
    if (body != none) {
        bootstrap_parser_add_child(state, statement, body);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.keyword_while);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let condition: usize = bootstrap_parser_parse_expression(state);
    if (condition != none) {
        bootstrap_parser_add_child(state, statement, condition);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return statement;
}

fn bootstrap_parser_parse_loop_statement(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.loop_statement, keyword.span, keyword_index);
    let body: usize = bootstrap_parser_parse_block(state);
    if (body != none) {
        bootstrap_parser_add_child(state, statement, body);
        let body_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, body);
        if (body_node != null) {
            bootstrap_parser_set_node_span(
                state, statement, bootstrap_parser_join_spans(keyword.span, body_node->span));
        }
    }
    return statement;
}

fn bootstrap_parser_parse_for_clause(
    state: *BootstrapParserState, kind: BootstrapSyntaxKind, terminator: BootstrapTokenKind, allow_declaration: bool
) -> usize {
    let wrapper: usize = bootstrap_parser_new_node(state, kind, state->current.span, state->current_index);
    if (bootstrap_parser_match(state, terminator)) {
        bootstrap_parser_set_node_span(state, wrapper, state->previous.span);
        return wrapper;
    }

    var child: usize = bootstrap_syntax_no_index();
    var is_volatile: bool = false;
    if (allow_declaration && state->current.kind == BootstrapTokenKind.keyword_volatile) {
        is_volatile = true;
        bootstrap_parser_advance(state);
    }
    if (allow_declaration && (state->current.kind == BootstrapTokenKind.keyword_let ||
            state->current.kind == BootstrapTokenKind.keyword_var)) {
        let keyword: BootstrapToken = state->current;
        let keyword_index: usize = state->current_index;
        let is_mutable: bool = state->current.kind == BootstrapTokenKind.keyword_var;
        bootstrap_parser_advance(state);
        child = bootstrap_parser_parse_variable_declaration(
            state, keyword, keyword_index, is_mutable, is_volatile, bootstrap_syntax_no_index(), 0);
    } else {
        child = bootstrap_parser_parse_expression_statement(state, terminator);
    }
    if (child != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, wrapper, child);
        let child_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, child);
        if (child_node != null) {
            bootstrap_parser_set_node_span(state, wrapper, child_node->span);
        }
    }
    return wrapper;
}

fn bootstrap_parser_parse_for_statement(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.for_statement, keyword.span, keyword_index);
    if (!bootstrap_parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let initializer: usize = bootstrap_parser_parse_for_clause(
        state, BootstrapSyntaxKind.for_initializer, BootstrapTokenKind.semicolon, true);
    bootstrap_parser_add_child(state, statement, initializer);

    let condition_wrapper: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.for_condition, state->current.span, state->current_index);
    if (!bootstrap_parser_match(
            state, BootstrapTokenKind.semicolon)) {
        let condition: usize = bootstrap_parser_parse_expression(state);
        if (condition != none) {
            bootstrap_parser_add_child(state, condition_wrapper, condition);
            let condition_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, condition);
            if (condition_node != null) {
                bootstrap_parser_set_node_span(state, condition_wrapper, condition_node->span);
            }
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    }
    bootstrap_parser_add_child(state, statement, condition_wrapper);

    let update: usize = bootstrap_parser_parse_for_clause(
        state, BootstrapSyntaxKind.for_update, BootstrapTokenKind.right_parenthesis, false);
    bootstrap_parser_add_child(state, statement, update);
    let body: usize = bootstrap_parser_parse_block(state);
    if (body != none) {
        bootstrap_parser_add_child(state, statement, body);
        let body_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, body);
        if (body_node != null) {
            bootstrap_parser_set_node_span(
                state, statement, bootstrap_parser_join_spans(keyword.span, body_node->span));
        }
    }
    bootstrap_parser_leave_nesting(state);
    return statement;
}

fn bootstrap_parser_parse_switch_label(state: *BootstrapParserState) -> usize {
    if (state->current.kind == BootstrapTokenKind.identifier) {
        return bootstrap_parser_parse_postfix_expression(state);
    }
    let none: usize = bootstrap_syntax_no_index();
    var sign: BootstrapToken = bootstrap_parser_invalid_token();
    var sign_index: usize = none;
    if (state->current.kind == BootstrapTokenKind.plus || state->current.kind == BootstrapTokenKind.minus) {
        sign = state->current;
        sign_index = state->current_index;
        bootstrap_parser_advance(state);
    }
    let literal: BootstrapToken = state->current;
    let literal_index: usize = state->current_index;
    if (!bootstrap_parser_expect(
            state, BootstrapTokenKind.integer)) {
        return none;
    }
    bootstrap_parser_parse_integer_token(state, literal);
    let literal_node: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.integer_expression, literal.span, literal_index);
    if (sign_index == none) {
        return literal_node;
    }
    let unary: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.unary_expression, bootstrap_parser_join_spans(sign.span, literal.span), sign_index);
    bootstrap_parser_add_child(state, unary, literal_node);
    return unary;
}

fn bootstrap_parser_parse_switch_statement(
    state: *BootstrapParserState, keyword: BootstrapToken, keyword_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.switch_statement, keyword.span, keyword_index);
    if (!bootstrap_parser_enter_nesting(
            state, keyword.span)) {
        return statement;
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let expression: usize = bootstrap_parser_parse_expression(state);
    if (expression != none) {
        bootstrap_parser_add_child(state, statement, expression);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_brace);
    while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
        state->current.kind != BootstrapTokenKind.end) {
        let arm_token: BootstrapToken = state->current;
        let arm_index: usize = state->current_index;
        let is_case: bool = state->current.kind == BootstrapTokenKind.keyword_case;
        let is_default: bool = state->current.kind == BootstrapTokenKind.keyword_default;
        if (!is_case && !is_default) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_switch_arm, state->current.span, BootstrapTokenKind.keyword_case,
                state->current.kind, 0);
            bootstrap_parser_advance(state);
            continue;
        }
        bootstrap_parser_advance(state);
        let arm: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.switch_arm, arm_token.span, arm_index);
        if (is_default) {
            bootstrap_parser_add_node_flags(state, arm, BootstrapSyntaxFlag.default_arm as usize);
        } else {
            while (state->error == RuntimeError.none) {
                let label: usize = bootstrap_parser_parse_switch_label(state);
                if (label != none) {
                    bootstrap_parser_add_child(state, arm, label);
                }
                if (!bootstrap_parser_match(
                        state, BootstrapTokenKind.comma)) {
                    break;
                }
            }
        }
        let body: usize = bootstrap_parser_parse_block(state);
        if (body != none) {
            bootstrap_parser_add_child(state, arm, body);
            let body_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, body);
            if (body_node != null) {
                bootstrap_parser_set_node_span(
                    state, arm, bootstrap_parser_join_spans(arm_token.span, body_node->span));
            }
        }
        bootstrap_parser_add_child(state, statement, arm);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
    bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    bootstrap_parser_leave_nesting(state);
    return statement;
}

fn bootstrap_parser_parse_assert_statement(state: *BootstrapParserState) -> usize {
    let keyword: BootstrapToken = state->current;
    let keyword_index: usize = state->current_index;
    bootstrap_parser_advance(state);
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.assert_statement, keyword.span, keyword_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let expression: usize = bootstrap_parser_parse_expression(state);
    if (expression != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, statement, expression);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    return statement;
}

fn bootstrap_parser_parse_va_start_statement(state: *BootstrapParserState) -> usize {
    let keyword: BootstrapToken = state->current;
    let keyword_index: usize = state->current_index;
    bootstrap_parser_advance(state);
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.va_start_statement, keyword.span, keyword_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    let expression: usize = bootstrap_parser_parse_expression(state);
    if (expression != bootstrap_syntax_no_index()) {
        bootstrap_parser_add_child(state, statement, expression);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    return statement;
}

fn bootstrap_parser_parse_goto_statement(state: *BootstrapParserState) -> usize {
    let keyword: BootstrapToken = state->current;
    let keyword_index: usize = state->current_index;
    bootstrap_parser_advance(state);
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.goto_statement, keyword.span, keyword_index);
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    if (bootstrap_parser_expect(state, BootstrapTokenKind.identifier)) {
        bootstrap_parser_add_child(
            state, statement,
            bootstrap_parser_new_node(state, BootstrapSyntaxKind.name_expression, name.span, name_index));
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(keyword.span, state->previous.span));
    return statement;
}

fn bootstrap_parser_parse_labeled_statement(
    state: *BootstrapParserState, name: BootstrapToken, name_index: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let statement: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.labeled_statement, name.span, name_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.colon);
    let inner: usize = bootstrap_parser_parse_statement(state);
    if (inner != none) {
        bootstrap_parser_add_child(state, statement, inner);
        let inner_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, inner);
        if (inner_node != null) {
            bootstrap_parser_set_node_span(
                state, statement, bootstrap_parser_join_spans(name.span, inner_node->span));
        }
    }
    return statement;
}

fn bootstrap_parser_parse_statement(state: *BootstrapParserState) -> usize {
    let token: BootstrapToken = state->current;
    let token_index: usize = state->current_index;
    if (token.kind == BootstrapTokenKind.left_brace) {
        return bootstrap_parser_parse_block(state);
    }
    if (token.kind == BootstrapTokenKind.identifier &&
        bootstrap_parser_peek_kind(state) == BootstrapTokenKind.colon) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_labeled_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_let || token.kind == BootstrapTokenKind.keyword_var) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_variable_declaration(
            state, token, token_index, token.kind == BootstrapTokenKind.keyword_var, false, bootstrap_syntax_no_index(),
            0);
    }
    if (token.kind == BootstrapTokenKind.keyword_const) {
        return bootstrap_parser_parse_const_declaration(
            state, token, token_index, BootstrapSyntaxFlag.none as usize, bootstrap_syntax_no_index(), 0);
    }
    if (token.kind == BootstrapTokenKind.keyword_volatile) {
        bootstrap_parser_advance(state);
        let keyword: BootstrapToken = state->current;
        let keyword_index: usize = state->current_index;
        if (keyword.kind != BootstrapTokenKind.keyword_let && keyword.kind != BootstrapTokenKind.keyword_var) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.expected_token, keyword.span, BootstrapTokenKind.keyword_let,
                keyword.kind, 0);
            return bootstrap_syntax_no_index();
        }
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_variable_declaration(
            state, keyword, keyword_index, keyword.kind == BootstrapTokenKind.keyword_var, true,
            bootstrap_syntax_no_index(), 0);
    }
    if (token.kind == BootstrapTokenKind.at_sign) {
        var first_attribute: usize = bootstrap_syntax_no_index();
        var attribute_count: usize = 0;
        bootstrap_parser_parse_attributes(state, &first_attribute, &attribute_count);
        let keyword: BootstrapToken = state->current;
        let keyword_index: usize = state->current_index;
        if (keyword.kind != BootstrapTokenKind.keyword_let && keyword.kind != BootstrapTokenKind.keyword_var) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.expected_token, keyword.span, BootstrapTokenKind.keyword_let,
                keyword.kind, 0);
            bootstrap_parser_attach_attributes(state, state->tree.root, first_attribute, attribute_count);
            return bootstrap_syntax_no_index();
        }
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_variable_declaration(
            state, keyword, keyword_index, keyword.kind == BootstrapTokenKind.keyword_var, false, first_attribute,
            attribute_count);
    }
    if (token.kind == BootstrapTokenKind.keyword_if) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_if_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_while) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_while_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_do) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_do_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_for) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_for_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_loop) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_loop_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_switch) {
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_switch_statement(state, token, token_index);
    }
    if (token.kind == BootstrapTokenKind.keyword_break || token.kind == BootstrapTokenKind.keyword_continue) {
        bootstrap_parser_advance(state);
        let statement: usize = bootstrap_parser_new_node(
            state, token.kind == BootstrapTokenKind.keyword_break ? BootstrapSyntaxKind.break_statement :
                BootstrapSyntaxKind.continue_statement, token.span, token_index);
        if (state->current.kind == BootstrapTokenKind.identifier) {
            let name: BootstrapToken = state->current;
            let name_index: usize = state->current_index;
            bootstrap_parser_advance(state);
            bootstrap_parser_add_child(
                state, statement,
                bootstrap_parser_new_node(state, BootstrapSyntaxKind.name_expression, name.span, name_index));
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
        bootstrap_parser_set_node_span(
            state, statement, bootstrap_parser_join_spans(token.span, state->previous.span));
        return statement;
    }
    if (token.kind == BootstrapTokenKind.keyword_goto) {
        return bootstrap_parser_parse_goto_statement(state);
    }
    if (token.kind == BootstrapTokenKind.keyword_return) {
        bootstrap_parser_advance(state);
        let statement: usize = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.return_statement, token.span, token_index);
        if (state->current.kind != BootstrapTokenKind.semicolon) {
            let value: usize = bootstrap_parser_parse_expression(state);
            if (value != bootstrap_syntax_no_index()) {
                bootstrap_parser_add_child(state, statement, value);
            }
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
        bootstrap_parser_set_node_span(state, statement, bootstrap_parser_join_spans(token.span, state->previous.span));
        return statement;
    }
    if (token.kind == BootstrapTokenKind.keyword_assert) {
        return bootstrap_parser_parse_assert_statement(state);
    }
    if (token.kind == BootstrapTokenKind.keyword_va_start) {
        return bootstrap_parser_parse_va_start_statement(state);
    }
    return bootstrap_parser_parse_expression_statement(state, BootstrapTokenKind.semicolon);
}

fn bootstrap_parser_parse_module_name(state: *BootstrapParserState, declaration: usize) -> bool {
    var saw_name: bool = false;
    while (state->error == RuntimeError.none) {
        let name: BootstrapToken = state->current;
        let name_index: usize = state->current_index;
        if (!bootstrap_parser_expect(
                state, BootstrapTokenKind.identifier)) {
            return false;
        }
        let name_node: usize = bootstrap_parser_new_node(
            state, BootstrapSyntaxKind.name_expression, name.span, name_index);
        bootstrap_parser_add_child(state, declaration, name_node);
        saw_name = true;
        if (!bootstrap_parser_match(
                state, BootstrapTokenKind.dot)) {
            break;
        }
    }
    return saw_name;
}

fn bootstrap_parser_parse_field(state: *BootstrapParserState, owner: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    var first_attribute: usize = none;
    var attribute_count: usize = 0;
    bootstrap_parser_parse_attributes(state, &first_attribute, &attribute_count);
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    if (name.kind == BootstrapTokenKind.keyword_struct || name.kind == BootstrapTokenKind.keyword_union) {
        bootstrap_parser_advance(state);
        let field: usize =
            bootstrap_parser_new_node(state, BootstrapSyntaxKind.field_declaration, name.span, name_index);
        bootstrap_parser_add_node_flags(state, field, BootstrapSyntaxFlag.anonymous as usize);
        let declaration: usize = bootstrap_parser_new_node(
            state,
            name.kind == BootstrapTokenKind.keyword_struct ? BootstrapSyntaxKind.structure_declaration :
                BootstrapSyntaxKind.union_declaration, name.span, name_index);
        bootstrap_parser_add_child(state, field, declaration);
        bootstrap_parser_expect(state, BootstrapTokenKind.left_brace);
        if (!bootstrap_parser_enter_nesting(state, name.span)) {
            bootstrap_parser_attach_attributes(state, owner, first_attribute, attribute_count);
            return field;
        }
        while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
            state->current.kind != BootstrapTokenKind.end) {
            let index_before: usize = state->current_index;
            let nested: usize = bootstrap_parser_parse_field(state, declaration);
            if (nested != none) {
                bootstrap_parser_add_child(state, declaration, nested);
            }
            if (state->current_index == index_before && state->current.kind != BootstrapTokenKind.end) {
                bootstrap_parser_advance(state);
            }
        }
        bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
        bootstrap_parser_leave_nesting(state);
        bootstrap_parser_set_node_span(
            state, declaration, bootstrap_parser_join_spans(name.span, state->previous.span));
        bootstrap_parser_attach_attributes(state, field, first_attribute, attribute_count);
        bootstrap_parser_set_node_span(state, field, bootstrap_parser_join_spans(name.span, state->previous.span));
        return field;
    }
    if (!bootstrap_parser_expect(
            state, BootstrapTokenKind.identifier)) {
        bootstrap_parser_attach_attributes(state, owner, first_attribute, attribute_count);
        return none;
    }
    let field: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.field_declaration, name.span, name_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.colon);
    let type_node: usize = bootstrap_parser_parse_type(state);
    if (type_node != none) {
        bootstrap_parser_add_child(state, field, type_node);
    }
    var trailing_attribute: usize = none;
    var trailing_count: usize = 0;
    bootstrap_parser_parse_attributes(state, &trailing_attribute, &trailing_count);
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_attach_attributes(state, field, first_attribute, attribute_count);
    bootstrap_parser_attach_attributes(state, field, trailing_attribute, trailing_count);
    bootstrap_parser_set_node_span(state, field, bootstrap_parser_join_spans(name.span, state->previous.span));
    return field;
}

fn bootstrap_parser_parse_aggregate_declaration(
    state: *BootstrapParserState, start: BootstrapToken, declaration_kind: BootstrapSyntaxKind, flags: usize,
    first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.identifier);
    let declaration: usize = bootstrap_parser_new_node(state, declaration_kind, start.span, name_index);
    bootstrap_parser_add_node_flags(state, declaration, flags);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_brace);
    while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
        state->current.kind != BootstrapTokenKind.end) {
        let index_before: usize = state->current_index;
        let field: usize = bootstrap_parser_parse_field(state, declaration);
        if (field != none) {
            bootstrap_parser_add_child(state, declaration, field);
        }
        if (state->current_index == index_before && state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
    bootstrap_parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    bootstrap_parser_set_node_span(state, declaration, bootstrap_parser_join_spans(start.span, state->previous.span));
    return declaration;
}

fn bootstrap_parser_parse_enum_declaration(
    state: *BootstrapParserState, start: BootstrapToken, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.identifier);
    let declaration: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.enum_declaration, start.span, name_index);
    bootstrap_parser_add_node_flags(state, declaration, flags);
    bootstrap_parser_expect(state, BootstrapTokenKind.colon);
    let underlying_type: usize = bootstrap_parser_parse_type(state);
    if (underlying_type != none) {
        bootstrap_parser_add_child(state, declaration, underlying_type);
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.left_brace);
    while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.right_brace &&
        state->current.kind != BootstrapTokenKind.end) {
        let index_before: usize = state->current_index;
        let member_name: BootstrapToken = state->current;
        let member_index: usize = state->current_index;
        if (!bootstrap_parser_expect(
                state, BootstrapTokenKind.identifier)) {
            if (state->current.kind != BootstrapTokenKind.end) {
                bootstrap_parser_advance(state);
            }
        } else {
            let member: usize = bootstrap_parser_new_node(
                state, BootstrapSyntaxKind.enum_member, member_name.span, member_index);
            if (bootstrap_parser_match(
                    state, BootstrapTokenKind.equal)) {
                let initializer: usize = bootstrap_parser_parse_expression(state);
                if (initializer != none) {
                    bootstrap_parser_add_child(state, member, initializer);
                    let initializer_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, initializer);
                    if (initializer_node != null) {
                        bootstrap_parser_set_node_span(
                            state, member, bootstrap_parser_join_spans(member_name.span, initializer_node->span));
                    }
                }
            }
            bootstrap_parser_add_child(state, declaration, member);
        }
        if (!bootstrap_parser_match(
                state, BootstrapTokenKind.comma)) {
            break;
        }
        if (state->current.kind == BootstrapTokenKind.right_brace) {
            break;
        }
        if (state->current_index == index_before && state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_brace);
    bootstrap_parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    bootstrap_parser_set_node_span(state, declaration, bootstrap_parser_join_spans(start.span, state->previous.span));
    return declaration;
}

fn bootstrap_parser_parse_parameter(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    if (!bootstrap_parser_expect(
            state, BootstrapTokenKind.identifier)) {
        return none;
    }
    let parameter: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.parameter, name.span, name_index);
    bootstrap_parser_expect(state, BootstrapTokenKind.colon);
    let type_node: usize = bootstrap_parser_parse_type(state);
    if (type_node != none) {
        bootstrap_parser_add_child(state, parameter, type_node);
        let type_pointer: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, type_node);
        if (type_pointer != null) {
            bootstrap_parser_set_node_span(
                state, parameter, bootstrap_parser_join_spans(name.span, type_pointer->span));
        }
    }
    return parameter;
}

fn bootstrap_parser_parse_function_declaration(
    state: *BootstrapParserState, start: BootstrapToken, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.identifier);
    let function: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.function_declaration, start.span, name_index);
    bootstrap_parser_add_node_flags(state, function, flags);
    bootstrap_parser_expect(state, BootstrapTokenKind.left_parenthesis);
    if (state->current.kind != BootstrapTokenKind.right_parenthesis) {
        while (state->error == RuntimeError.none) {
            if (state->current.kind == BootstrapTokenKind.dot_dot_dot) {
                bootstrap_parser_advance(state);
                bootstrap_parser_add_node_flags(state, function, BootstrapSyntaxFlag.variadic as usize);
                break;
            }
            let parameter: usize = bootstrap_parser_parse_parameter(state);
            if (parameter != none) {
                bootstrap_parser_add_child(state, function, parameter);
            }
            if (!bootstrap_parser_match(
                    state, BootstrapTokenKind.comma)) {
                break;
            }
        }
    }
    bootstrap_parser_expect(state, BootstrapTokenKind.right_parenthesis);
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.arrow)) {
        let return_type: usize = bootstrap_parser_parse_type(state);
        if (return_type != none) {
            bootstrap_parser_add_child(state, function, return_type);
        }
    }

    if (bootstrap_parser_match(
            state, BootstrapTokenKind.semicolon)) {
        bootstrap_parser_add_node_flags(state, function, BootstrapSyntaxFlag.bodyless as usize);
    } else if ((flags & (BootstrapSyntaxFlag.asm_function as usize)) != 0) {
        let body: usize = bootstrap_parser_parse_asm_body(state);
        if (body != none) {
            bootstrap_parser_add_child(state, function, body);
        }
        if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_external_declaration, start.span, BootstrapTokenKind.semicolon,
                BootstrapTokenKind.left_brace, 0);
        }
    } else {
        let body: usize = bootstrap_parser_parse_block(state);
        if (body != none) {
            bootstrap_parser_add_child(state, function, body);
        }
        if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_external_declaration, start.span, BootstrapTokenKind.semicolon,
                BootstrapTokenKind.left_brace, 0);
        }
    }
    bootstrap_parser_attach_attributes(state, function, first_attribute, attribute_count);
    bootstrap_parser_set_node_span(state, function, bootstrap_parser_join_spans(start.span, state->previous.span));
    return function;
}

fn bootstrap_parser_token_at(state: *BootstrapParserState, index: usize) -> BootstrapToken {
    let result: BootstrapTokenResult = bootstrap_token_buffer_get(state->tokens, index);
    if (result.error != RuntimeError.none) {
        if (state->error == RuntimeError.none) {
            state->error = result.error;
        }
        return {
            kind = BootstrapTokenKind.invalid, span = {
                offset = 0, length = 0, line = 0, column = 0,
            },
        };
    }
    return result.token;
}

fn bootstrap_parser_identifier_text_is(
    state: *BootstrapParserState, token: BootstrapToken, text: *const u8, length: usize) -> bool {
    if (token.kind != BootstrapTokenKind.identifier || token.span.length != length) {
        return false;
    }
    let source: StdTextView = state->source;
    var index: usize = 0;
    while (index < length) {
        if (source.data[token.span.offset + index] != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_parser_parse_type_alias_declaration(
    state: *BootstrapParserState, start: BootstrapToken, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
        bootstrap_parser_add_diagnostic(
            state, BootstrapDiagnosticKind.invalid_external_declaration, start.span, BootstrapTokenKind.keyword_fn,
            BootstrapTokenKind.identifier, 0);
    }
    bootstrap_parser_advance(state);
    let name: BootstrapToken = state->current;
    let name_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.identifier);
    let declaration: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.type_alias_declaration, start.span, name_index);
    bootstrap_parser_add_node_flags(state, declaration, flags);
    bootstrap_parser_expect(state, BootstrapTokenKind.equal);
    if (!bootstrap_parser_enter_nesting(state, start.span)) {
        bootstrap_parser_attach_attributes(state, declaration, first_attribute, attribute_count);
        return declaration;
    }
    let target: usize = bootstrap_parser_parse_type(state);
    if (target != none) {
        bootstrap_parser_add_child(state, declaration, target);
        let target_node: *BootstrapSyntaxNode = bootstrap_parser_node_pointer(state, target);
        if (target_node != null) {
            bootstrap_parser_set_node_span(
                state, declaration, bootstrap_parser_join_spans(start.span, target_node->span));
        }
    }
    bootstrap_parser_leave_nesting(state);
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_attach_attributes(state, declaration, first_attribute, attribute_count);
    return declaration;
}

fn bootstrap_parser_parse_top_level_declaration(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let start: BootstrapToken = state->current;
    var flags: usize = BootstrapSyntaxFlag.none as usize;
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_export)) {
        flags |= BootstrapSyntaxFlag.exported as usize;
    }
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_extern)) {
        flags |= BootstrapSyntaxFlag.external as usize;
    }
    var first_attribute: usize = none;
    var attribute_count: usize = 0;
    bootstrap_parser_parse_attributes(state, &first_attribute, &attribute_count);

    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_struct)) {
        if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_external_declaration, start.span, BootstrapTokenKind.keyword_fn,
                BootstrapTokenKind.keyword_struct, 0);
        }
        return bootstrap_parser_parse_aggregate_declaration(
            state, start, BootstrapSyntaxKind.structure_declaration, flags, first_attribute, attribute_count);
    }
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_union)) {
        if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_external_declaration, start.span, BootstrapTokenKind.keyword_fn,
                BootstrapTokenKind.keyword_union, 0);
        }
        return bootstrap_parser_parse_aggregate_declaration(
            state, start, BootstrapSyntaxKind.union_declaration, flags, first_attribute, attribute_count);
    }
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_enum)) {
        if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
            bootstrap_parser_add_diagnostic(
                state, BootstrapDiagnosticKind.invalid_external_declaration, start.span, BootstrapTokenKind.keyword_fn,
                BootstrapTokenKind.keyword_enum, 0);
        }
        return bootstrap_parser_parse_enum_declaration(state, start, flags, first_attribute, attribute_count);
    }
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_fn)) {
        return bootstrap_parser_parse_function_declaration(state, start, flags, first_attribute, attribute_count);
    }
    if (state->current.kind == BootstrapTokenKind.keyword_asm &&
        bootstrap_parser_token_at(state, state->current_index + 1).kind == BootstrapTokenKind.keyword_fn) {
        bootstrap_parser_advance(state);
        bootstrap_parser_advance(state);
        return bootstrap_parser_parse_function_declaration(
            state, start, flags | (BootstrapSyntaxFlag.asm_function as usize), first_attribute, attribute_count);
    }
    if (state->current.kind == BootstrapTokenKind.keyword_const) {
        if (bootstrap_parser_token_at(
                state, state->current_index + 1).kind == BootstrapTokenKind.keyword_fn) {
            if ((flags & (BootstrapSyntaxFlag.external as usize)) != 0) {
                bootstrap_parser_add_diagnostic(
                    state, BootstrapDiagnosticKind.invalid_external_declaration, start.span,
                    BootstrapTokenKind.keyword_fn, BootstrapTokenKind.keyword_const, 0);
            }
            bootstrap_parser_advance(state);
            bootstrap_parser_advance(state);
            return bootstrap_parser_parse_function_declaration(
                state, start, flags | (BootstrapSyntaxFlag.const_function as usize), first_attribute,
                attribute_count);
        }
        return bootstrap_parser_parse_const_declaration(
            state, start, state->current_index, flags, first_attribute, attribute_count);
    }
    if (state->current.kind == BootstrapTokenKind.identifier &&
        bootstrap_parser_identifier_text_is(state, state->current, "type", 4) &&
        bootstrap_parser_token_at(state, state->current_index + 1).kind == BootstrapTokenKind.identifier &&
        bootstrap_parser_token_at(
            state, state->current_index + 2).kind == BootstrapTokenKind.equal) {
        return bootstrap_parser_parse_type_alias_declaration(state, start, flags, first_attribute, attribute_count);
    }

    if (state->current.kind == BootstrapTokenKind.keyword_assert) {
        bootstrap_parser_attach_attributes(state, state->tree.root, first_attribute, attribute_count);
        return bootstrap_parser_parse_assert_statement(state);
    }

    bootstrap_parser_add_diagnostic(
        state, BootstrapDiagnosticKind.expected_declaration, state->current.span, BootstrapTokenKind.keyword_fn,
        state->current.kind, 0);
    bootstrap_parser_attach_attributes(state, state->tree.root, first_attribute, attribute_count);
    if (state->current.kind != BootstrapTokenKind.end) {
        bootstrap_parser_advance(state);
    }
    return none;
}

fn bootstrap_parser_parse_program(state: *BootstrapParserState) -> usize {
    let none: usize = bootstrap_syntax_no_index();
    let start: BootstrapToken = state->current;
    let start_index: usize = state->current_index;
    var interface_unit: bool = false;
    if (bootstrap_parser_match(
            state, BootstrapTokenKind.keyword_export)) {
        interface_unit = true;
    }
    let module_keyword: BootstrapToken = state->current;
    let module_index: usize = state->current_index;
    bootstrap_parser_expect(state, BootstrapTokenKind.keyword_module);
    let program: usize = bootstrap_parser_new_node(state, BootstrapSyntaxKind.program, start.span, start_index);
    state->tree.root = program;
    if (interface_unit) {
        bootstrap_parser_add_node_flags(state, program, BootstrapSyntaxFlag.interface_unit as usize);
    }

    let module_declaration: usize = bootstrap_parser_new_node(
        state, BootstrapSyntaxKind.module_declaration, module_keyword.span, module_index);
    bootstrap_parser_parse_module_name(state, module_declaration);
    bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
    bootstrap_parser_set_node_span(
        state, module_declaration, bootstrap_parser_join_spans(module_keyword.span, state->previous.span));
    bootstrap_parser_add_child(state, program, module_declaration);

    while (state->current.kind == BootstrapTokenKind.keyword_import) {
        let import_keyword: BootstrapToken = state->current;
        let import_index: usize = state->current_index;
        bootstrap_parser_advance(state);
        let import_declaration: usize =
            bootstrap_parser_new_node(state, BootstrapSyntaxKind.import_declaration, import_keyword.span, import_index);
        bootstrap_parser_parse_module_name(state, import_declaration);
        bootstrap_parser_expect(state, BootstrapTokenKind.semicolon);
        bootstrap_parser_set_node_span(
            state, import_declaration, bootstrap_parser_join_spans(import_keyword.span, state->previous.span));
        bootstrap_parser_add_child(state, program, import_declaration);
    }

    while (state->error == RuntimeError.none && state->current.kind != BootstrapTokenKind.end) {
        let index_before: usize = state->current_index;
        let declaration: usize = bootstrap_parser_parse_top_level_declaration(state);
        if (declaration != none) {
            bootstrap_parser_add_child(state, program, declaration);
        }
        if (state->current_index == index_before && state->current.kind != BootstrapTokenKind.end) {
            bootstrap_parser_advance(state);
        }
    }
    let end_span: BootstrapSourceSpan = state->current.kind == BootstrapTokenKind.end ?
            state->current.span : state->previous.span;
    bootstrap_parser_set_node_span(state, program, bootstrap_parser_join_spans(start.span, end_span));
    return program;
}

fn bootstrap_parse(source: StdTextView, tokens: BootstrapTokenBuffer) -> BootstrapParseResult {
    if (!bootstrap_parser_input_is_valid(source, tokens)) {
        return {
            tree = bootstrap_syntax_tree_empty(), diagnostics = bootstrap_diagnostic_buffer_empty(),
            error = RuntimeError.invalid_argument,
        };
    }
    var state: BootstrapParserState = {
        source = source, tokens = tokens, cursor = 0, current = bootstrap_parser_invalid_token(),
        current_index = bootstrap_syntax_no_index(), previous = bootstrap_parser_invalid_token(),
        tree = bootstrap_syntax_tree_empty(), diagnostics = bootstrap_diagnostic_buffer_empty(),
        error = RuntimeError.none, nesting_depth = 0,
    };
    state.tree.token_count = tokens.count;
    bootstrap_parser_advance(&state);
    if (state.error == RuntimeError.none) {
        bootstrap_parser_parse_program(&state);
    }
    if (state.error == RuntimeError.none && !bootstrap_syntax_tree_is_valid(state.tree)) {
        state.error = RuntimeError.io;
    }
    return {
        tree = state.tree, diagnostics = state.diagnostics, error = state.error,
    };
}

fn bootstrap_parse_result_release(result: BootstrapParseResult) -> RuntimeError {
    let tree_error: RuntimeError = bootstrap_syntax_tree_release(result.tree);
    let diagnostic_error: RuntimeError = bootstrap_diagnostic_buffer_release(result.diagnostics);
    if (tree_error != RuntimeError.none) {
        return tree_error;
    }
    return diagnostic_error;
}

fn bootstrap_frontend_parse(source: StdTextView) -> BootstrapFrontendResult {
    let lex: BootstrapLexResult = bootstrap_lex(source);
    if (lex.error != RuntimeError.none) {
        return {
            lex = lex, parse = {
                tree = bootstrap_syntax_tree_empty(), diagnostics = bootstrap_diagnostic_buffer_empty(),
                error = lex.error,
            }, error = lex.error,
        };
    }
    let parse: BootstrapParseResult = bootstrap_parse(source, lex.tokens);
    return {
        lex = lex, parse = parse, error = parse.error,
    };
}

fn bootstrap_frontend_result_release(result: BootstrapFrontendResult) -> RuntimeError {
    let parse_error: RuntimeError = bootstrap_parse_result_release(result.parse);
    let lex_error: RuntimeError = bootstrap_lex_result_release(result.lex);
    if (parse_error != RuntimeError.none) {
        return parse_error;
    }
    return lex_error;
}

