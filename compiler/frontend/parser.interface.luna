export module luna.bootstrap.frontend.parser;

import luna.bootstrap.frontend.lexer;
import luna.runtime;
import luna.std.bytes;
import luna.std.text;

export enum BootstrapSyntaxKind: usize {
    invalid, program, module_declaration, import_declaration, structure_declaration, union_declaration,
    enum_declaration, enum_member, type_alias_declaration, field_declaration, function_declaration, parameter,
    type_builtin, type_named, type_pointer, type_array, type_function, block_statement, variable_declaration,
    assignment_statement, expression_statement, if_statement, while_statement, do_statement, for_statement,
    loop_statement, for_initializer, for_condition, for_update, switch_statement, switch_arm, break_statement,
    continue_statement, return_statement, integer_expression, floating_expression, boolean_expression,
    string_expression, null_expression, name_expression, zero_initializer, aggregate_initializer, initializer_field,
    parenthesized_expression, call_expression, index_expression, member_expression, unary_expression, cast_expression,
    binary_expression, conditional_expression, sizeof_expression, alignof_expression, offsetof_expression, attribute,
    assert_statement, intrinsic_expression, named_argument, character_expression, initializer_element,
    const_declaration,
}

export enum BootstrapSyntaxFlag: usize {
    none = 0, exported = 1, external = 2, interface_unit = 4, mutable_binding = 8, bodyless = 16, default_arm = 32,
    read_only = 64, has_return_type = 128, has_arguments = 256, volatile_ = 512, anonymous = 1024, flexible = 2048,
    indexed = 4096, inferred_type = 8192, const_function = 16384,
}

export struct BootstrapSyntaxNode {
    kind: BootstrapSyntaxKind;
    span: BootstrapSourceSpan;
    token_index: usize;
    parent: usize;
    first_child: usize;
    last_child: usize;
    next_sibling: usize;
    child_count: usize;
    flags: usize;
}

export struct BootstrapSyntaxTree {
    storage: StdByteBuffer;
    count: usize;
    token_count: usize;
    root: usize;
}

export struct BootstrapSyntaxNodeResult {
    node: BootstrapSyntaxNode;
    error: RuntimeError;
}

export struct BootstrapParseResult {
    tree: BootstrapSyntaxTree;
    diagnostics: BootstrapDiagnosticBuffer;
    error: RuntimeError;
}

export struct BootstrapFrontendResult {
    lex: BootstrapLexResult;
    parse: BootstrapParseResult;
    error: RuntimeError;
}

export fn bootstrap_syntax_no_index() -> usize;
export fn bootstrap_syntax_tree_empty() -> BootstrapSyntaxTree;
export fn bootstrap_syntax_tree_is_valid(tree: BootstrapSyntaxTree) -> bool;
export fn bootstrap_syntax_tree_get(tree: BootstrapSyntaxTree, index: usize) -> BootstrapSyntaxNodeResult;
export fn bootstrap_syntax_tree_release(tree: BootstrapSyntaxTree) -> RuntimeError;

export fn bootstrap_parse(source: StdTextView, tokens: BootstrapTokenBuffer) -> BootstrapParseResult;
export fn bootstrap_parse_result_release(result: BootstrapParseResult) -> RuntimeError;
export fn bootstrap_frontend_parse(source: StdTextView) -> BootstrapFrontendResult;
export fn bootstrap_frontend_result_release(result: BootstrapFrontendResult) -> RuntimeError;

