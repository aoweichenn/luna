export module luna.bootstrap.frontend.syntax;

import luna.bootstrap.frontend.lexer as lexer;
import luna.runtime;
import luna.std.bytes;

export enum SyntaxKind: usize {
    invalid, program, module_declaration, import_declaration, structure_declaration, union_declaration,
    enum_declaration, enum_member, type_alias_declaration, field_declaration, function_declaration, parameter,
    type_builtin, type_named, type_pointer, type_array, type_function, block_statement, variable_declaration,
    assignment_statement, expression_statement, if_statement, while_statement, do_statement, for_statement,
    loop_statement, for_initializer, for_condition, for_update, switch_statement, switch_arm, break_statement,
    continue_statement, return_statement, integer_expression, floating_expression, boolean_expression,
    string_expression, null_expression, name_expression, zero_initializer, aggregate_initializer, initializer_field,
    parenthesized_expression, call_expression, index_expression, member_expression, unary_expression, cast_expression,
    binary_expression, conditional_expression, sizeof_expression, alignof_expression, offsetof_expression, attribute,
    assert_statement, intrinsic_expression, named_argument, character_expression, initializer_element,
    const_declaration, labeled_statement, goto_statement, va_start_statement, va_arg_expression, selective_import_names,
}

export enum SyntaxFlag: usize {
    none = 0, exported = 1, external = 2, interface_unit = 4, mutable_binding = 8, bodyless = 16, default_arm = 32,
    read_only = 64, has_return_type = 128, has_arguments = 256, volatile_ = 512, anonymous = 1024, flexible = 2048,
    indexed = 4096, inferred_type = 8192, const_function = 16384, variadic = 32768, asm_function = 65536,
    aliased_import = 131072, selective_import = 262144,
}

export struct SyntaxNode {
    kind: SyntaxKind;
    span: lexer::SourceSpan;
    token_index: usize;
    parent: usize;
    first_child: usize;
    last_child: usize;
    next_sibling: usize;
    child_count: usize;
    flags: usize;
}

export struct SyntaxTree {
    storage: bytes::Buffer;
    count: usize;
    token_count: usize;
    root: usize;
}

export struct SyntaxNodeResult {
    node: SyntaxNode;
    error: runtime::Error;
}

export fn syntax_no_index() -> usize;
export fn syntax_tree_empty() -> SyntaxTree;
export fn syntax_tree_storage_is_valid(tree: SyntaxTree) -> bool;
export fn syntax_tree_is_valid(tree: SyntaxTree) -> bool;
export fn syntax_tree_get(tree: SyntaxTree, index: usize) -> SyntaxNodeResult;
export fn syntax_tree_release(tree: SyntaxTree) -> runtime::Error;
