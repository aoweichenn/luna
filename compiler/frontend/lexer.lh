export module luna.bootstrap.frontend.lexer;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;

export enum BootstrapTokenKind: usize {
    invalid, end,

    identifier, integer, floating, character, string, string_u16, string_u32,

    keyword_import, keyword_module, keyword_export, keyword_extern, keyword_const, keyword_let, keyword_var, keyword_fn,
    keyword_struct, keyword_union, keyword_enum, keyword_if, keyword_else, keyword_switch, keyword_case,
    keyword_default, keyword_while, keyword_do, keyword_for, keyword_loop, keyword_break, keyword_continue,
    keyword_return, keyword_as, keyword_sizeof, keyword_alignof, keyword_offsetof, keyword_true, keyword_false,
    keyword_null,

    keyword_bool, keyword_i8, keyword_i16, keyword_i32, keyword_i64, keyword_u8, keyword_u16, keyword_u32, keyword_u64,
    keyword_isize, keyword_usize, keyword_f32, keyword_f64, keyword_void,

    left_parenthesis, right_parenthesis, left_brace, right_brace, left_bracket, right_bracket, comma, dot, semicolon,
    colon, question,

    plus, minus, star, slash, percent, ampersand, pipe, caret, tilde, bang, equal, less, greater,

    arrow, plus_equal, minus_equal, star_equal, slash_equal, percent_equal, ampersand_equal, pipe_equal, caret_equal,
    shift_left, shift_right, shift_left_equal, shift_right_equal, equal_equal, bang_equal, less_equal, greater_equal,
    logical_and, logical_or, at_sign, keyword_assert, keyword_volatile, keyword_goto, dot_dot_dot,
    keyword_va_list, keyword_va_start, keyword_va_arg, keyword_asm, colon_colon,
}

export enum BootstrapDiagnosticKind: usize {
    unexpected_character, unterminated_block_comment, unterminated_string, unterminated_character, expected_token,
    expected_type, expected_expression, expected_declaration, invalid_integer, invalid_floating,
    invalid_external_declaration, invalid_switch_arm, nesting_limit, resource_limit,
}

export struct BootstrapSourceSpan {
    offset: usize;
    length: usize;
    line: usize;
    column: usize;
}

export struct BootstrapToken {
    kind: BootstrapTokenKind;
    span: BootstrapSourceSpan;
}

export struct BootstrapDiagnostic {
    kind: BootstrapDiagnosticKind;
    span: BootstrapSourceSpan;
    expected: BootstrapTokenKind;
    found: BootstrapTokenKind;
    detail: usize;
}

export struct BootstrapTokenBuffer {
    storage: bytes::Buffer;
    count: usize;
}

export struct BootstrapDiagnosticBuffer {
    storage: bytes::Buffer;
    count: usize;
}

export struct BootstrapTokenResult {
    token: BootstrapToken;
    error: runtime::Error;
}

export struct BootstrapDiagnosticResult {
    diagnostic: BootstrapDiagnostic;
    error: runtime::Error;
}

export struct BootstrapDiagnosticBufferResult {
    buffer: BootstrapDiagnosticBuffer;
    error: runtime::Error;
}

export struct BootstrapLexResult {
    tokens: BootstrapTokenBuffer;
    diagnostics: BootstrapDiagnosticBuffer;
    error: runtime::Error;
}

export fn bootstrap_token_buffer_is_valid(buffer: BootstrapTokenBuffer) -> bool;
export fn bootstrap_token_buffer_get(buffer: BootstrapTokenBuffer, index: usize) -> BootstrapTokenResult;
export fn bootstrap_token_buffer_release(buffer: BootstrapTokenBuffer) -> runtime::Error;

export fn bootstrap_diagnostic_buffer_empty()
    -> BootstrapDiagnosticBuffer;
export fn bootstrap_diagnostic_buffer_is_valid(buffer: BootstrapDiagnosticBuffer) -> bool;
export fn bootstrap_diagnostic_buffer_add(
    buffer: BootstrapDiagnosticBuffer, diagnostic: BootstrapDiagnostic) -> BootstrapDiagnosticBufferResult;
export fn bootstrap_diagnostic_buffer_get(buffer: BootstrapDiagnosticBuffer, index: usize) -> BootstrapDiagnosticResult;
export fn bootstrap_diagnostic_buffer_release(buffer: BootstrapDiagnosticBuffer) -> runtime::Error;

export fn bootstrap_lex(source: text::View) -> BootstrapLexResult;
export fn bootstrap_lex_result_release(result: BootstrapLexResult) -> runtime::Error;

