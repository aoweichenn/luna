export module luna.bootstrap.frontend.parser;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.syntax as syntax;
import luna.runtime;
import luna.std.text as text;

export struct ParseResult {
    tree: syntax::SyntaxTree;
    diagnostics: lexer::DiagnosticBuffer;
    error: runtime::Error;
}

export struct FrontendResult {
    lex: lexer::LexResult;
    parse: ParseResult;
    error: runtime::Error;
}

export fn parse(source: text::View, tokens: lexer::TokenBuffer) -> ParseResult;
export fn parse_result_release(result: ParseResult) -> runtime::Error;
export fn frontend_parse(source: text::View) -> FrontendResult;
export fn frontend_result_release(result: FrontendResult) -> runtime::Error;

