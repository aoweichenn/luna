module luna.bootstrap.frontend.lexer;

struct LexerKeyword {
    text: *const u8;
    length: usize;
    kind: TokenKind;
}

enum LexerLimit: usize {
    maximum_size = 18446744073709551615, maximum_tokens = 131072, maximum_diagnostics = 4096,
    maximum_token_length = 65536,
}

struct TokenBufferResult {
    buffer: TokenBuffer;
    error: runtime::Error;
}

struct LexerState {
    source: text::View;
    offset: usize;
    line: usize;
    column: usize;
    tokens: TokenBuffer;
    diagnostics: DiagnosticBuffer;
    error: runtime::Error;
}

fn empty_span() -> SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn invalid_token() -> Token {
    return {
        kind = TokenKind.invalid, span = empty_span(),
    };
}

fn invalid_diagnostic() -> Diagnostic {
    return {
        kind = DiagnosticKind.unexpected_character, span = empty_span(),
        expected = TokenKind.invalid, found = TokenKind.invalid, detail = 0,
    };
}

fn token_buffer_empty() -> TokenBuffer {
    return {
        storage = bytes::empty(), count = 0,
    };
}

fn token_buffer_is_valid(buffer: TokenBuffer) -> bool {
    if (!bytes::is_valid(buffer.storage) || buffer.storage.length % sizeof(Token) != 0 ||
        buffer.count > LexerLimit.maximum_tokens as usize) {
        return false;
    }
    return buffer.count == buffer.storage.length / sizeof(Token);
}

fn token_buffer_add(buffer: TokenBuffer, token: Token) -> TokenBufferResult {
    if (!token_buffer_is_valid(buffer)) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }
    if (buffer.count >= LexerLimit.maximum_tokens as usize) {
        return {
            buffer = buffer, error = runtime::Error.out_of_memory,
        };
    }

    let appended: bytes::BufferResult = bytes::append(
        buffer.storage, (&token) as *const Token as *const u8, sizeof(Token));
    var result: TokenBuffer = {
        storage = appended.buffer, count = buffer.count,
    };
    if (appended.error == runtime::Error.none) {
        result.count += 1;
    }
    return {
        buffer = result, error = appended.error,
    };
}

fn token_buffer_get(buffer: TokenBuffer, index: usize) -> TokenResult {
    if (!token_buffer_is_valid(buffer) || index >= buffer.count) {
        return {
            token = invalid_token(), error = runtime::Error.invalid_argument,
        };
    }
    let tokens: *const Token = buffer.storage.data as *const Token;
    return {
        token = tokens[index], error = runtime::Error.none,
    };
}

fn token_buffer_release(buffer: TokenBuffer) -> runtime::Error {
    if (!token_buffer_is_valid(buffer)) {
        return runtime::Error.invalid_argument;
    }
    return bytes::release(buffer.storage);
}

fn diagnostic_buffer_empty()
    -> DiagnosticBuffer {
    return {
        storage = bytes::empty(), count = 0,
    };
}

fn diagnostic_buffer_is_valid(buffer: DiagnosticBuffer) -> bool {
    if (!bytes::is_valid(buffer.storage) || buffer.storage.length % sizeof(Diagnostic) != 0 ||
        buffer.count > LexerLimit.maximum_diagnostics as usize) {
        return false;
    }
    return buffer.count == buffer.storage.length / sizeof(Diagnostic);
}

fn diagnostic_buffer_add(buffer: DiagnosticBuffer, diagnostic: Diagnostic) -> DiagnosticBufferResult {
    if (!diagnostic_buffer_is_valid(buffer)) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }
    if (buffer.count >= LexerLimit.maximum_diagnostics as usize) {
        return {
            buffer = buffer, error = runtime::Error.out_of_memory,
        };
    }

    let appended: bytes::BufferResult = bytes::append(
        buffer.storage, (&diagnostic) as *const Diagnostic as *const u8, sizeof(Diagnostic));
    var result: DiagnosticBuffer = {
        storage = appended.buffer, count = buffer.count,
    };
    if (appended.error == runtime::Error.none) {
        result.count += 1;
    }
    return {
        buffer = result, error = appended.error,
    };
}

fn diagnostic_buffer_get(buffer: DiagnosticBuffer, index: usize) -> DiagnosticResult {
    if (!diagnostic_buffer_is_valid(buffer) || index >= buffer.count) {
        return {
            diagnostic = invalid_diagnostic(), error = runtime::Error.invalid_argument,
        };
    }
    let diagnostics: *const Diagnostic = buffer.storage.data as *const Diagnostic;
    return {
        diagnostic = diagnostics[index], error = runtime::Error.none,
    };
}

fn diagnostic_buffer_release(buffer: DiagnosticBuffer) -> runtime::Error {
    if (!diagnostic_buffer_is_valid(buffer)) {
        return runtime::Error.invalid_argument;
    }
    return bytes::release(buffer.storage);
}

fn lexer_at_end(state: *LexerState) -> bool {
    return state->offset >= state->source.length;
}

fn lexer_peek(state: *LexerState) -> u8 {
    if (lexer_at_end(state)) {
        return 0;
    }
    return state->source.data[state->offset];
}

fn lexer_peek_next(state: *LexerState) -> u8 {
    if (state->offset == state->source.length || state->source.length - state->offset < 2) {
        return 0;
    }
    return state->source.data[state->offset + 1];
}

fn lexer_advance(state: *LexerState) -> u8 {
    if (lexer_at_end(state)) {
        return 0;
    }
    let byte: u8 = state->source.data[state->offset];
    state->offset += 1;
    if (byte == '\n') {
        state->line += 1;
        state->column = 1;
    } else {
        state->column += 1;
    }
    return byte;
}

fn lexer_match(state: *LexerState, expected: u8) -> bool {
    if (lexer_peek(state) != expected) {
        return false;
    }
    lexer_advance(state);
    return true;
}

fn lexer_span(state: *LexerState, start_offset: usize, start_line: usize, start_column: usize) -> SourceSpan {
    return {
        offset = start_offset, length = state->offset - start_offset, line = start_line, column = start_column,
    };
}

fn lexer_add_diagnostic(state: *LexerState, kind: DiagnosticKind, span: SourceSpan, detail: usize) -> bool {
    if (state->error != runtime::Error.none) {
        return false;
    }
    let added: DiagnosticBufferResult =
        diagnostic_buffer_add(
            state->diagnostics, {
                kind = kind, span = span, expected = TokenKind.invalid, found = TokenKind.invalid, detail = detail,
            });
    state->diagnostics = added.buffer;
    state->error = added.error;
    return added.error == runtime::Error.none;
}

fn lexer_add_token(
    state: *LexerState, kind: TokenKind, start_offset: usize, start_line: usize, start_column: usize) -> bool {
    if (state->error != runtime::Error.none) {
        return false;
    }
    let span: SourceSpan = lexer_span(state, start_offset, start_line, start_column);
    let token_kind: TokenKind = span.length > LexerLimit.maximum_token_length as usize ? TokenKind.invalid : kind;
    let added: TokenBufferResult = token_buffer_add(state->tokens, { kind = token_kind, span = span, });
    state->tokens = added.buffer;
    state->error = added.error;
    if (added.error != runtime::Error.none) {
        return false;
    }
    if (span.length > LexerLimit.maximum_token_length as usize) {
        return lexer_add_diagnostic(
            state, DiagnosticKind.resource_limit, span, LexerLimit.maximum_token_length as usize);
    }
    return true;
}

fn is_ascii_letter(byte: u8) -> bool {
    return (byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z');
}

fn is_decimal_digit(byte: u8) -> bool {
    return byte >= '0' && byte <= '9';
}

fn is_hex_digit(byte: u8) -> bool {
    return is_decimal_digit(byte) || (byte >= 'A' && byte <= 'F') || (byte >= 'a' && byte <= 'f');
}

fn digit_matches_base(byte: u8, base: usize) -> bool {
    if (base == 2) {
        return byte == '0' || byte == '1';
    }
    if (base == 8) {
        return byte >= '0' && byte <= '7';
    }
    if (base == 10) {
        return is_decimal_digit(byte);
    }
    return base == 16 && is_hex_digit(byte);
}

fn lexer_text_equals(
    state: *LexerState, start: usize, length: usize, expected: *const u8, expected_length: usize) -> bool {
    if (length != expected_length) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (state->source.data[start + index] != expected[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn lexer_identifier_kind(state: *LexerState, start: usize, length: usize) -> TokenKind {
    var keywords: [51]LexerKeyword = {};
    keywords[0] = {text = "as", length = 2, kind = TokenKind.keyword_as};
    keywords[1] = {text = "do", length = 2, kind = TokenKind.keyword_do};
    keywords[2] = {text = "fn", length = 2, kind = TokenKind.keyword_fn};
    keywords[3] = {text = "i8", length = 2, kind = TokenKind.keyword_i8};
    keywords[4] = {text = "u8", length = 2, kind = TokenKind.keyword_u8};
    keywords[5] = {text = "f32", length = 3, kind = TokenKind.keyword_f32};
    keywords[6] = {text = "f64", length = 3, kind = TokenKind.keyword_f64};
    keywords[7] = {text = "for", length = 3, kind = TokenKind.keyword_for};
    keywords[8] = {text = "i16", length = 3, kind = TokenKind.keyword_i16};
    keywords[9] = {text = "i32", length = 3, kind = TokenKind.keyword_i32};
    keywords[10] = {text = "i64", length = 3, kind = TokenKind.keyword_i64};
    keywords[11] = {text = "let", length = 3, kind = TokenKind.keyword_let};
    keywords[12] = {text = "loop", length = 4, kind = TokenKind.keyword_loop};
    keywords[13] = {text = "u16", length = 3, kind = TokenKind.keyword_u16};
    keywords[14] = {text = "u32", length = 3, kind = TokenKind.keyword_u32};
    keywords[15] = {text = "u64", length = 3, kind = TokenKind.keyword_u64};
    keywords[16] = {text = "var", length = 3, kind = TokenKind.keyword_var};
    keywords[17] = {text = "bool", length = 4, kind = TokenKind.keyword_bool};
    keywords[18] = {text = "case", length = 4, kind = TokenKind.keyword_case};
    keywords[19] = {text = "else", length = 4, kind = TokenKind.keyword_else};
    keywords[20] = {text = "enum", length = 4, kind = TokenKind.keyword_enum};
    keywords[21] = {text = "false", length = 5, kind = TokenKind.keyword_false};
    keywords[22] = {text = "isize", length = 5, kind = TokenKind.keyword_isize};
    keywords[23] = {text = "null", length = 4, kind = TokenKind.keyword_null};
    keywords[24] = {text = "true", length = 4, kind = TokenKind.keyword_true};
    keywords[25] = {text = "union", length = 5, kind = TokenKind.keyword_union};
    keywords[26] = {text = "usize", length = 5, kind = TokenKind.keyword_usize};
    keywords[27] = {text = "void", length = 4, kind = TokenKind.keyword_void};
    keywords[28] = {text = "alignof", length = 7, kind = TokenKind.keyword_alignof};
    keywords[29] = {text = "break", length = 5, kind = TokenKind.keyword_break};
    keywords[30] = {text = "const", length = 5, kind = TokenKind.keyword_const};
    keywords[31] = {text = "continue", length = 8, kind = TokenKind.keyword_continue};
    keywords[32] = {text = "default", length = 7, kind = TokenKind.keyword_default};
    keywords[33] = {text = "export", length = 6, kind = TokenKind.keyword_export};
    keywords[34] = {text = "extern", length = 6, kind = TokenKind.keyword_extern};
    keywords[35] = {text = "if", length = 2, kind = TokenKind.keyword_if};
    keywords[36] = {text = "import", length = 6, kind = TokenKind.keyword_import};
    keywords[37] = {text = "module", length = 6, kind = TokenKind.keyword_module};
    keywords[38] = {text = "offsetof", length = 8, kind = TokenKind.keyword_offsetof};
    keywords[39] = {text = "return", length = 6, kind = TokenKind.keyword_return};
    keywords[40] = {text = "sizeof", length = 6, kind = TokenKind.keyword_sizeof};
    keywords[41] = {text = "struct", length = 6, kind = TokenKind.keyword_struct};
    keywords[42] = {text = "switch", length = 6, kind = TokenKind.keyword_switch};
    keywords[43] = {text = "while", length = 5, kind = TokenKind.keyword_while};
    keywords[44] = {text = "assert", length = 6, kind = TokenKind.keyword_assert};
    keywords[45] = {text = "volatile", length = 8, kind = TokenKind.keyword_volatile};
    keywords[46] = {text = "goto", length = 4, kind = TokenKind.keyword_goto};
    keywords[47] = {text = "va_arg", length = 6, kind = TokenKind.keyword_va_arg};
    keywords[48] = {text = "va_list", length = 7, kind = TokenKind.keyword_va_list};
    keywords[49] = {text = "va_start", length = 8, kind = TokenKind.keyword_va_start};
    keywords[50] = {text = "asm", length = 3, kind = TokenKind.keyword_asm};
    var index: usize = 0;
    while (index < 51) {
        let entry: LexerKeyword = keywords[index];
        if (lexer_text_equals(state, start, length, entry.text, entry.length)) {
            return entry.kind;
        }
        index += 1;
    }
    return TokenKind.identifier;
}

fn lexer_skip_trivia(state: *LexerState) -> void {
    while (!lexer_at_end(state) && state->error == runtime::Error.none) {
        let byte: u8 = lexer_peek(state);
        if (byte == ' ' || byte == '\t' || byte == '\r' || byte == '\n') {
            lexer_advance(state);
            continue;
        }
        if (byte == '/' && lexer_peek_next(state) == '/') {
            while (!lexer_at_end(state) && lexer_peek(state) != '\n') {
                lexer_advance(state);
            }
            continue;
        }
        if (byte != '/' || lexer_peek_next(state) != '*') {
            return;
        }

        let start_offset: usize = state->offset;
        let start_line: usize = state->line;
        let start_column: usize = state->column;
        lexer_advance(state);
        lexer_advance(state);
        while (!lexer_at_end(state) && !(lexer_peek(state) == '*' && lexer_peek_next(state) == '/')) {
            lexer_advance(state);
        }
        if (lexer_at_end(state)) {
            lexer_add_diagnostic(
                state, DiagnosticKind.unterminated_block_comment,
                lexer_span(state, start_offset, start_line, start_column), 0);
            return;
        }
        lexer_advance(state);
        lexer_advance(state);
    }
}

fn lexer_scan_identifier(state: *LexerState, start_offset: usize, start_line: usize, start_column: usize) -> bool {
    while (is_ascii_letter(lexer_peek(state)) || is_decimal_digit(lexer_peek(state)) || lexer_peek(state) == '_') {
        lexer_advance(state);
    }
    return lexer_add_token(
        state, lexer_identifier_kind(state, start_offset, state->offset - start_offset),
        start_offset, start_line, start_column);
}

fn lexer_scan_number(state: *LexerState, start_offset: usize, start_line: usize, start_column: usize) -> bool {
    var base: usize = 10;
    var is_floating: bool = false;
    if (state->source.data[start_offset] == '0' && (lexer_peek(state) == 'b' || lexer_peek(state) == 'B')) {
        base = 2;
        lexer_advance(state);
    } else if (state->source.data[start_offset] == '0' && (lexer_peek(state) == 'o' || lexer_peek(state) == 'O')) {
        base = 8;
        lexer_advance(state);
    } else if (state->source.data[start_offset] == '0' && (lexer_peek(state) == 'x' || lexer_peek(state) == 'X')) {
        base = 16;
        lexer_advance(state);
    }

    while (digit_matches_base(
            lexer_peek(state), base) || lexer_peek(state) == '_') {
        lexer_advance(state);
    }
    if (base == 10 && lexer_peek(state) == '.' &&
        is_decimal_digit(
            lexer_peek_next(state))) {
        is_floating = true;
        lexer_advance(state);
        while (is_decimal_digit(
                lexer_peek(state)) || lexer_peek(state) == '_') {
            lexer_advance(state);
        }
    }
    if (base == 16 && lexer_peek(state) == '.' &&
        is_hex_digit(
            lexer_peek_next(state))) {
        is_floating = true;
        lexer_advance(state);
        while (is_hex_digit(
                lexer_peek(state)) || lexer_peek(state) == '_') {
            lexer_advance(state);
        }
    }
    if (base == 16 && (lexer_peek(state) == 'p' || lexer_peek(state) == 'P')) {
        is_floating = true;
        lexer_advance(state);
        if (lexer_peek(state) == '+' || lexer_peek(state) == '-') {
            lexer_advance(state);
        }
        while (is_decimal_digit(
                lexer_peek(state)) || lexer_peek(state) == '_') {
            lexer_advance(state);
        }
    }
    if (base == 10 && (lexer_peek(state) == 'e' || lexer_peek(state) == 'E')) {
        is_floating = true;
        lexer_advance(state);
        if (lexer_peek(state) == '+' || lexer_peek(state) == '-') {
            lexer_advance(state);
        }
        while (is_decimal_digit(
                lexer_peek(state)) || lexer_peek(state) == '_') {
            lexer_advance(state);
        }
    }
    return lexer_add_token(
        state, is_floating ? TokenKind.floating : TokenKind.integer, start_offset, start_line, start_column);
}

fn lexer_scan_quoted(
    state: *LexerState, quote: u8, kind: TokenKind, diagnostic_kind: DiagnosticKind,
    start_offset: usize, start_line: usize, start_column: usize) -> bool {
    var terminated: bool = false;
    while (!lexer_at_end(state)) {
        let byte: u8 = lexer_advance(state);
        if (byte == quote) {
            terminated = true;
            break;
        }
        if (byte == '\\' && !lexer_at_end(state)) {
            lexer_advance(state);
            continue;
        }
        if (byte == '\n') {
            break;
        }
    }

    let token_kind: TokenKind = terminated ? kind : TokenKind.invalid;
    if (!lexer_add_token(
            state, token_kind, start_offset, start_line, start_column)) {
        return false;
    }
    if (!terminated) {
        return lexer_add_diagnostic(
            state, diagnostic_kind, lexer_span(state, start_offset, start_line, start_column), 0);
    }
    return true;
}

fn lexer_scan_token(state: *LexerState) -> bool {
    lexer_skip_trivia(state);
    if (state->error != runtime::Error.none) {
        return false;
    }

    let start_offset: usize = state->offset;
    let start_line: usize = state->line;
    let start_column: usize = state->column;
    if (lexer_at_end(state)) {
        return lexer_add_token(state, TokenKind.end, start_offset, start_line, start_column);
    }
    if (state->tokens.count >= (LexerLimit.maximum_tokens as usize) - 1) {
        let span: SourceSpan = lexer_span(state, start_offset, start_line, start_column);
        if (!lexer_add_diagnostic(
                state, DiagnosticKind.resource_limit, span, LexerLimit.maximum_tokens as usize)) {
            return false;
        }
        while (!lexer_at_end(state)) {
            lexer_advance(state);
        }
        return lexer_add_token(state, TokenKind.end, state->offset, state->line, state->column);
    }

    let byte: u8 = lexer_advance(state);
    if (byte == 'u' && state->offset + 2 < state->source.length && state->source.data[state->offset + 2] == '"' &&
        ((state->source.data[state->offset] == '1' && state->source.data[state->offset + 1] == '6') ||
            (state->source.data[state->offset] == '3' && state->source.data[state->offset + 1] == '2'))) {
        let wide_kind: TokenKind = state->source.data[state->offset] == '1' ? TokenKind.string_u16 :
            TokenKind.string_u32;
        lexer_advance(state);
        lexer_advance(state);
        lexer_advance(state);
        return lexer_scan_quoted(
            state, '"', wide_kind, DiagnosticKind.unterminated_string, start_offset, start_line, start_column);
    }
    if (is_ascii_letter(byte) || byte == '_') {
        return lexer_scan_identifier(state, start_offset, start_line, start_column);
    }
    if (is_decimal_digit(byte)) {
        return lexer_scan_number(state, start_offset, start_line, start_column);
    }

    var kind: TokenKind = TokenKind.invalid;
    switch (byte) {
    case 40 {
        kind = TokenKind.left_parenthesis;
    }
    case 41 {
        kind = TokenKind.right_parenthesis;
    }
    case 123 {
        kind = TokenKind.left_brace;
    }
    case 125 {
        kind = TokenKind.right_brace;
    }
    case 91 {
        kind = TokenKind.left_bracket;
    }
    case 93 {
        kind = TokenKind.right_bracket;
    }
    case 44 {
        kind = TokenKind.comma;
    }
    case 46 {
        if (lexer_match(state, '.')) {
            kind = lexer_match(state, '.') ? TokenKind.dot_dot_dot : TokenKind.invalid;
        } else {
            kind = TokenKind.dot;
        }
    }
    case 59 {
        kind = TokenKind.semicolon;
    }
    case 58 {
        kind = lexer_match(state, ':') ? TokenKind.colon_colon : TokenKind.colon;
    }
    case 63 {
        kind = TokenKind.question;
    }
    case 64 {
        kind = TokenKind.at_sign;
    }
    case 126 {
        kind = TokenKind.tilde;
    }
    case 43 {
        kind = lexer_match(state, '=') ? TokenKind.plus_equal : TokenKind.plus;
    }
    case 45 {
        if (lexer_match(state, '>')) {
            kind = TokenKind.arrow;
        } else {
            kind = lexer_match(state, '=') ? TokenKind.minus_equal : TokenKind.minus;
        }
    }
    case 42 {
        kind = lexer_match(state, '=') ? TokenKind.star_equal : TokenKind.star;
    }
    case 47 {
        kind = lexer_match(state, '=') ? TokenKind.slash_equal : TokenKind.slash;
    }
    case 37 {
        kind = lexer_match(state, '=') ? TokenKind.percent_equal : TokenKind.percent;
    }
    case 38 {
        if (lexer_match(state, '&')) {
            kind = TokenKind.logical_and;
        } else {
            kind = lexer_match(state, '=') ? TokenKind.ampersand_equal : TokenKind.ampersand;
        }
    }
    case 124 {
        if (lexer_match(state, '|')) {
            kind = TokenKind.logical_or;
        } else {
            kind = lexer_match(state, '=') ? TokenKind.pipe_equal : TokenKind.pipe;
        }
    }
    case 94 {
        kind = lexer_match(state, '=') ? TokenKind.caret_equal : TokenKind.caret;
    }
    case 33 {
        kind = lexer_match(state, '=') ? TokenKind.bang_equal : TokenKind.bang;
    }
    case 61 {
        kind = lexer_match(state, '=') ? TokenKind.equal_equal : TokenKind.equal;
    }
    case 60 {
        if (lexer_match(state, '<')) {
            kind = lexer_match(state, '=') ? TokenKind.shift_left_equal : TokenKind.shift_left;
        } else {
            kind = lexer_match(state, '=') ? TokenKind.less_equal : TokenKind.less;
        }
    }
    case 62 {
        if (lexer_match(state, '>')) {
            kind = lexer_match(state, '=') ? TokenKind.shift_right_equal : TokenKind.shift_right;
        } else {
            kind = lexer_match(state, '=') ? TokenKind.greater_equal : TokenKind.greater;
        }
    }
    case 34 {
        return lexer_scan_quoted(
            state, '"', TokenKind.string, DiagnosticKind.unterminated_string, start_offset, start_line, start_column);
    }
    case 39 {
        return lexer_scan_quoted(
            state, '\x27', TokenKind.character, DiagnosticKind.unterminated_character, start_offset,
            start_line, start_column);
    }
    default {
    }
    }

    if (!lexer_add_token(
            state, kind, start_offset, start_line, start_column)) {
        return false;
    }
    if (kind == TokenKind.invalid) {
        return lexer_add_diagnostic(
            state, DiagnosticKind.unexpected_character, lexer_span(state, start_offset, start_line, start_column), 0);
    }
    return true;
}

fn source_is_valid(source: text::View) -> bool {
    if (!text::is_valid_utf8(source)) {
        return false;
    }
    var index: usize = 0;
    while (index < source.length) {
        if (source.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn lex(source: text::View) -> LexResult {
    if (!source_is_valid(source)) {
        return {
            tokens = token_buffer_empty(), diagnostics = diagnostic_buffer_empty(),
            error = runtime::Error.invalid_argument,
        };
    }

    var state: LexerState = {
        source = source, offset = 0, line = 1, column = 1, tokens = token_buffer_empty(),
        diagnostics = diagnostic_buffer_empty(), error = runtime::Error.none,
    };
    while (state.error == runtime::Error.none) {
        if (!lexer_scan_token(&state)) {
            break;
        }
        let last: TokenResult = token_buffer_get(state.tokens, state.tokens.count - 1);
        if (last.error != runtime::Error.none) {
            state.error = last.error;
            break;
        }
        if (last.token.kind == TokenKind.end) {
            break;
        }
    }
    return {
        tokens = state.tokens, diagnostics = state.diagnostics, error = state.error,
    };
}

fn lex_result_release(result: LexResult) -> runtime::Error {
    let token_error: runtime::Error = token_buffer_release(result.tokens);
    let diagnostic_error: runtime::Error = diagnostic_buffer_release(result.diagnostics);
    if (token_error != runtime::Error.none) {
        return token_error;
    }
    return diagnostic_error;
}
