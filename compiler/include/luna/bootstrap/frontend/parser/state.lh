export module luna.bootstrap.frontend.parser.state;

import luna.bootstrap.frontend.syntax as syntax;
import luna.compiler.lexer as lexer;
import luna.runtime;
import luna.std.string_view as string_views;

export struct State {
    source: string_views::string_view;
    tokens: lexer::TokenView;
    cursor: usize;
    current: lexer::Token;
    current_index: usize;
    previous: lexer::Token;
    tree: syntax::SyntaxTree;
    diagnostics: lexer::DiagnosticBuffer;
    error: runtime::Error;
    nesting_depth: usize;
}

export struct Mark {
    cursor: usize;
    current: lexer::Token;
    current_index: usize;
    previous: lexer::Token;
    tree_length: usize;
    tree_count: usize;
    diagnostic_count: usize;
    nesting_depth: usize;
}

export fn parser_empty_span() -> lexer::SourceSpan;
export fn parser_invalid_token() -> lexer::Token;
export fn parser_token_at(state: *State, index: usize) -> lexer::Token;
export fn parser_identifier_text_is(state: *State, token: lexer::Token, expected: *const u8, length: usize) -> bool;
export fn parser_span_is_valid(source: string_views::string_view, span: lexer::SourceSpan) -> bool;
export fn parser_source_is_valid(source: string_views::string_view) -> bool;
export fn parser_input_is_valid(source: string_views::string_view, tokens: lexer::TokenView) -> bool;
export fn parser_join_spans(first: lexer::SourceSpan, last: lexer::SourceSpan) -> lexer::SourceSpan;
export fn parser_add_diagnostic(
    state: *State, kind: lexer::DiagnosticKind, span: lexer::SourceSpan,
    expected: lexer::TokenKind, found: lexer::TokenKind, detail: usize) -> bool;
export fn parser_new_node(state: *State, kind: syntax::SyntaxKind, span: lexer::SourceSpan,
    token_index: usize) -> usize;
export fn parser_node_pointer(state: *State, index: usize) -> *syntax::SyntaxNode;
export fn parser_set_node_span(state: *State, index: usize, span: lexer::SourceSpan) -> bool;
export fn parser_add_node_flags(state: *State, index: usize, flags: usize) -> bool;
export fn parser_add_child(state: *State, parent_index: usize, child_index: usize) -> bool;
export fn parser_advance(state: *State) -> void;
export fn parser_check(state: *State, kind: lexer::TokenKind) -> bool;
export fn parser_peek_kind(state: *State) -> lexer::TokenKind;
export fn parser_match(state: *State, kind: lexer::TokenKind) -> bool;
export fn parser_expect(state: *State, kind: lexer::TokenKind) -> bool;
export fn parser_enter_nesting(state: *State, span: lexer::SourceSpan) -> bool;
export fn parser_leave_nesting(state: *State) -> void;
export fn parser_mark(state: *State) -> Mark;
export fn parser_restore(state: *State, mark: Mark) -> bool;
