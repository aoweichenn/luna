export module luna.bootstrap.frontend.parser.statements;

import luna.bootstrap.frontend.parser.state as state;
import luna.compiler.lexer as lexer;

export fn parser_parse_attributes(state: *state::State, first_attribute: *usize, attribute_count: *usize) -> bool;
export fn parser_attach_attributes(state: *state::State, declaration: usize, first_attribute: usize,
    attribute_count: usize) -> bool;
export fn parser_parse_const_declaration(
    state: *state::State, keyword: lexer::Token, keyword_index: usize, flags: usize,
    first_attribute: usize, attribute_count: usize) -> usize;
export fn parser_parse_asm_body(state: *state::State) -> usize;
export fn parser_parse_block(state: *state::State) -> usize;
export fn parser_parse_assert_statement(state: *state::State) -> usize;
