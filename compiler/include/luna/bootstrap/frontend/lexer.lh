export module luna.bootstrap.frontend.lexer;

import luna.runtime;
import luna.std.bytes;
import luna.std.string_view as string_views;

export enum TokenKind: usize {
    invalid, end,

    identifier, integer, floating, character, string, string_u16, string_u32,

    keyword_import, keyword_module, keyword_export, keyword_extern, keyword_const, keyword_let, keyword_var, keyword_fn,
    keyword_struct, keyword_union, keyword_enum, keyword_if, keyword_else, keyword_switch, keyword_case,
    keyword_default, keyword_while, keyword_do, keyword_for, keyword_loop, keyword_break, keyword_continue,
    keyword_return, keyword_as, keyword_sizeof, keyword_alignof, keyword_offsetof, keyword_true, keyword_false,
    keyword_null,

    keyword_bool, keyword_i8, keyword_i16, keyword_i32, keyword_i64, keyword_u8, keyword_u16, keyword_u32, keyword_u64,
    keyword_isize, keyword_usize, keyword_f32, keyword_f64, keyword_void,

    left_parenthesis, right_parenthesis, left_brace, right_brace, left_bracket, right_bracket, comma, dot, semicolon,
    colon, question,

    plus, minus, star, slash, percent, ampersand, pipe, caret, tilde, bang, equal, less, greater,

    arrow, plus_equal, minus_equal, star_equal, slash_equal, percent_equal, ampersand_equal, pipe_equal, caret_equal,
    shift_left, shift_right, shift_left_equal, shift_right_equal, equal_equal, bang_equal, less_equal, greater_equal,
    logical_and, logical_or, at_sign, keyword_assert, keyword_volatile, keyword_goto, dot_dot_dot,
    keyword_va_list, keyword_va_start, keyword_va_arg, keyword_asm, colon_colon, keyword_class,
    keyword_pub, keyword_prot, keyword_priv, keyword_static, keyword_impl, keyword_this,
    keyword_final, keyword_virtual, keyword_abstract, keyword_override, keyword_super,
    keyword_operator, keyword_method, keyword_friend, keyword_opaque,
}

export enum DiagnosticKind: usize {
    unexpected_character, unterminated_block_comment, unterminated_string, unterminated_character, expected_token,
    expected_type, expected_expression, expected_declaration, invalid_integer, invalid_floating,
    invalid_external_declaration, invalid_switch_arm, nesting_limit, resource_limit,
}

export struct SourceSpan {
    offset: usize;
    length: usize;
    line: usize;
    column: usize;
}

export struct Token {
    kind: TokenKind;
    span: SourceSpan;
}

export struct Diagnostic {
    kind: DiagnosticKind;
    span: SourceSpan;
    expected: TokenKind;
    found: TokenKind;
    detail: usize;
}

export struct TokenBuffer {
    storage: bytes::Buffer;
    count: usize;
}

export struct DiagnosticBuffer {
    storage: bytes::Buffer;
    count: usize;
}

export struct TokenResult {
    token: Token;
    error: runtime::Error;
}

export struct DiagnosticResult {
    diagnostic: Diagnostic;
    error: runtime::Error;
}

export struct DiagnosticBufferResult {
    buffer: DiagnosticBuffer;
    error: runtime::Error;
}

export struct LexResult {
    tokens: TokenBuffer;
    diagnostics: DiagnosticBuffer;
    error: runtime::Error;
}

export fn token_buffer_is_valid(buffer: TokenBuffer) -> bool;
export fn token_buffer_get(buffer: TokenBuffer, index: usize) -> TokenResult;
export fn token_buffer_release(buffer: TokenBuffer) -> runtime::Error;

export fn diagnostic_buffer_empty()
    -> DiagnosticBuffer;
export fn diagnostic_buffer_is_valid(buffer: DiagnosticBuffer) -> bool;
export fn diagnostic_buffer_add(buffer: DiagnosticBuffer, diagnostic: Diagnostic) -> DiagnosticBufferResult;
export fn diagnostic_buffer_get(buffer: DiagnosticBuffer, index: usize) -> DiagnosticResult;
export fn diagnostic_buffer_release(buffer: DiagnosticBuffer) -> runtime::Error;

export fn lex(source: string_views::string_view) -> LexResult;
export fn lex_result_release(result: LexResult) -> runtime::Error;
