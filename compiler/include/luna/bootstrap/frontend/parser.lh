export module luna.bootstrap.frontend.parser;

import luna.compiler.lexer as lexer;
import luna.compiler.syntax as syntax;
import luna.runtime;
import luna.std.string_view as string_views;

export struct ParseView {
    tree: syntax::SyntaxView;
    diagnostics: lexer::DiagnosticView;
    error: runtime::Error;
}

export struct FrontendView {
    lex: lexer::LexView;
    parse: ParseView;
    error: runtime::Error;
}

export class ParseResult {
    priv tree_storage: syntax::SyntaxTree;
    priv diagnostic_storage: lexer::DiagnosticBuffer;
    priv error_code: runtime::Error;

    pub init();
    pub init(tree: syntax::SyntaxTree&&, diagnostics: lexer::DiagnosticBuffer&&, error: runtime::Error);
    pub init(other: ParseResult&&);
    pub fn is_valid() const -> bool;
    pub fn tree() const -> syntax::SyntaxView;
    pub fn diagnostics() const -> lexer::DiagnosticView;
    pub fn view() const -> ParseView;
    pub fn error() const -> runtime::Error;
    pub deinit();
}

export class FrontendResult {
    priv lexical_result: lexer::LexResult;
    priv parse_result: ParseResult;
    priv error_code: runtime::Error;

    pub init();
    pub init(lexical: lexer::LexResult&&, parsed: ParseResult&&, error: runtime::Error);
    pub init(other: FrontendResult&&);
    pub fn lexical() const -> lexer::LexResult const&;
    pub fn parsed() const -> ParseResult const&;
    pub fn view() const -> FrontendView;
    pub fn error() const -> runtime::Error;
    pub deinit();
}

export fn parse(source: string_views::string_view, tokens: lexer::TokenView) -> ParseResult;
export fn frontend_parse(source: string_views::string_view) -> FrontendResult;
