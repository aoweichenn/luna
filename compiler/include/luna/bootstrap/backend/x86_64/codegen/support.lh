export module luna.bootstrap.backend.x86_64.codegen.support;

import luna.bootstrap.backend.x86_64.abi as abi;
import luna.bootstrap.backend.x86_64.frame as frame;
import luna.bootstrap.backend.x86_64.text as asm_text;
import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.checked as checked;

export enum Limit: usize {
    maximum_size = 18446744073709551615, text_limit = 4096, general_argument_registers = 6,
    vector_argument_registers = 8, variadic_stack_slot = 8, call_stack_alignment = 16,
}

export struct Context {
    semantic_input: context::Input;
    ir: ir::Store;
    types: type_info::Table;
    abi: abi::Abi;
    frames: frame::Plan;
    text: asm_text::Text;
    current_function: usize;
    // Live bytes subtracted from rsp for outgoing call argument areas; only
    // nonzero between a call's subq and its matching addq.
    call_frame_depth: usize;
    error: runtime::Error;
}


export fn no_id() -> usize;
export fn fail(context: *Context, error: runtime::Error) -> bool;
export fn literal(context: *Context, literal: *const u8) -> bool;
export fn append_usize(context: *Context, value: usize) -> bool;
export fn hex(context: *Context, value: u64, digits: usize) -> bool;
export fn type(context: *Context, type_id: usize) -> *const type_info::Record;
export fn unit(context: *Context, unit_id: usize) -> *const context::Unit;
export fn token(context: *Context, unit_id: usize, token_id: usize) -> lexer::Token;
export fn node(context: *Context, unit_id: usize, node_id: usize) -> syntax::SyntaxNode;
export fn append_mangled_function_symbol(context: *Context, function_id: usize) -> bool;
export fn append_function_symbol(context: *Context, function_id: usize) -> bool;
export fn storage(context: *Context, kind: frame::StorageKind, source_id: usize) -> frame::Storage;
export fn append_stack(context: *Context, storage: frame::Storage) -> bool;
export fn append_value(context: *Context, value_id: usize) -> bool;
export fn append_slot(context: *Context, slot_id: usize) -> bool;
export fn block_label(context: *Context, block_id: usize) -> bool;
export fn return_label(context: *Context) -> bool;
export fn instruction_label(context: *Context, instruction_id: usize, suffix: *const u8) -> bool;
export fn append_global_label(context: *Context, global_id: usize) -> bool;
export fn bit_width(record: *const type_info::Record) -> usize;
export fn is_signed(context: *Context, record: *const type_info::Record) -> bool;
export fn load_integer(
    context: *Context, value_id: usize, record: *const type_info::Record,
    destination_32: *const u8, destination_64: *const u8, signed_value: bool) -> bool;
export fn load_rax(context: *Context, value_id: usize, record: *const type_info::Record) -> bool;
export fn load_rcx(context: *Context, value_id: usize, record: *const type_info::Record) -> bool;
export fn load_signed_rax(context: *Context, value_id: usize, record: *const type_info::Record) -> bool;
export fn store_rax(context: *Context, result: usize, record: *const type_info::Record) -> bool;
export fn float_move(record: *const type_info::Record) -> *const u8;
export fn load_xmm(context: *Context, value_id: usize, record: *const type_info::Record,
    register_name: *const u8) -> bool;
export fn store_xmm(context: *Context, result: usize, record: *const type_info::Record,
    register_name: *const u8) -> bool;
