export module luna.bootstrap.backend.x86_64.object;

import luna.runtime;
import luna.std.bytes as bytes;
import luna.std.text as text;

export enum Section: usize {
    undefined = 0, text = 1, rodata = 2, data = 3, bss = 4,
}

export enum SymbolKind: usize {
    none = 0, function = 1, object = 2,
}

export enum RelocationKind: usize {
    pc32 = 1, plt32 = 2, absolute64 = 3, absolute32 = 4, signed32 = 5,
}

export struct Symbol {
    name_offset: usize;
    name_length: usize;
    section: Section;
    value: usize;
    size: usize;
    kind: SymbolKind;
    defined: bool;
    global: bool;
    external: bool;
}

export struct Relocation {
    section: Section;
    offset: usize;
    symbol_index: usize;
    kind: RelocationKind;
    addend: isize;
}

export struct Object {
    text: bytes::Buffer;
    rodata: bytes::Buffer;
    data: bytes::Buffer;
    names: bytes::Buffer;
    symbols: bytes::Buffer;
    relocations: bytes::Buffer;
    bss_size: usize;
    text_alignment: usize;
    rodata_alignment: usize;
    data_alignment: usize;
    bss_alignment: usize;
    error: runtime::Error;
}

export struct Result {
    object: Object;
    error: runtime::Error;
}

export struct SymbolResult {
    symbol: Symbol;
    error: runtime::Error;
}

export struct RelocationResult {
    relocation: Relocation;
    error: runtime::Error;
}

export struct IndexResult {
    index: usize;
    found: bool;
    error: runtime::Error;
}

export fn empty() -> Object;
export fn is_valid(object: Object) -> bool;
export fn release(object: Object) -> runtime::Error;
export fn section_length(object: Object, section: Section) -> usize;
export fn set_alignment(object: *Object, section: Section, alignment: usize) -> bool;
export fn append_u8(object: *Object, section: Section, value: u8) -> bool;
export fn append_u16(object: *Object, section: Section, value: u16) -> bool;
export fn append_u32(object: *Object, section: Section, value: u32) -> bool;
export fn append_u64(object: *Object, section: Section, value: u64) -> bool;
export fn append_symbol(object: *Object, name: text::View) -> IndexResult;
export fn add_symbol(object: *Object, name: text::View) -> IndexResult;
export fn find_symbol(object: Object, name: text::View) -> IndexResult;
export fn get_symbol(object: Object, index: usize) -> SymbolResult;
export fn symbol_mut(object: *Object, index: usize) -> *Symbol;
export fn symbol_name(object: Object, symbol: Symbol) -> text::ViewResult;
export fn add_relocation(object: *Object, relocation: Relocation) -> bool;
export fn get_relocation(object: Object, index: usize) -> RelocationResult;
export fn symbol_count(object: Object) -> usize;
export fn relocation_count(object: Object) -> usize;
export fn serialize(object: Object) -> bytes::BufferResult;
export fn deserialize(bytes: *const u8, length: usize) -> Result;
