export module luna.bootstrap.backend.x86_64.assembler.encoding;

import luna.bootstrap.backend.x86_64.assembler.operands as operands;
import luna.bootstrap.backend.x86_64.object as object;
import luna.runtime as runtime;
import luna.std.bytes as bytes;
import luna.std.text as text;

export enum Limit: usize {
    maximum_source = 67108864, maximum_line = 1048576, maximum_fixups = 1048576, maximum_numeric_labels = 1048576,
}

export enum FixupKind: usize {
    branch = 0, call = 1, rip_relative = 2, absolute64 = 3,
}

export struct Fixup {
    target: text::View;
    section: object::Section;
    offset: usize;
    line: usize;
    kind: FixupKind;
    numeric_label: usize;
    numeric_forward: bool;
    is_numeric: bool;
}

export struct NumericLabel {
    section: object::Section;
    offset: usize;
    number: usize;
}

export struct State {
    object: object::Object;
    section: object::Section;
    fixups: bytes::Buffer;
    numeric_labels: bytes::Buffer;
    line: usize;
    error: runtime::Error;
}

export fn fail(assembler: *State, error: runtime::Error) -> bool;
export fn section_buffer(assembler: *State) -> *bytes::Buffer;
export fn append_u8(assembler: *State, value: u8) -> bool;
export fn append_symbol_address(assembler: *State, target: text::View) -> bool;
export fn fits_u8(bits: u64) -> bool;
export fn encode(assembler: *State, mnemonic: text::View, raw_operands: text::View,
    operands: *const operands::Operands) -> bool;
