export module luna.bootstrap.middleend.type;

import luna.runtime;
import luna.std.bytes;

export enum Kind: usize {
    invalid, type_void, boolean, signed_8, signed_16, signed_32, signed_64, signed_size, unsigned_8, unsigned_16,
    unsigned_32, unsigned_64, unsigned_size, float_32, float_64, pointer, array, structure, record_union, enumeration,
    alias, function_pointer, va_list_type, class_type, bound_method,
}

export enum BuiltinType: usize {
    invalid = 0, type_void = 1, boolean = 2, signed_8 = 3, signed_16 = 4, signed_32 = 5, signed_64 = 6, signed_size = 7,
    unsigned_8 = 8, unsigned_16 = 9, unsigned_32 = 10, unsigned_64 = 11, unsigned_size = 12, float_32 = 13,
    float_64 = 14, va_list_type = 15, count = 16,
}

export enum Flag: usize {
    none = 0, read_only = 1, complete = 2, resolving = 4, exported = 8, volatile_pointee = 16, packed = 32,
    flexible = 64, header = 128, opaque_class = 256, opaque_definition = 512,
}

export struct Record {
    kind: Kind;
    element_type: usize;
    element_count: usize;
    // 仅 class_type 可设置单一基类；其他类型恒为 no-id。
    base_type: usize;
    // 仅多态 class_type 使用；它是对象内隐藏 vptr 的确定字节偏移。
    vptr_offset: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    first_field: usize;
    field_count: usize;
    size_bytes: usize;
    alignment_bytes: usize;
    flags: usize;
}

export struct Field {
    owner_type: usize;
    type_id: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    offset_bytes: usize;
    // Raised field alignment from @align, zero means natural alignment.
    alignment_bytes: usize;
}

export struct Table {
    types: bytes::Buffer;
    type_count: usize;
    fields: bytes::Buffer;
    field_count: usize;
}

export struct RecordResult {
    record: Record;
    error: runtime::Error;
}

export struct FieldResult {
    field: Field;
    error: runtime::Error;
}

export struct IdResult {
    type_id: usize;
    error: runtime::Error;
}

export struct TableResult {
    table: Table;
    error: runtime::Error;
}

export fn no_id() -> usize;
export fn table_empty() -> Table;
export fn table_create() -> TableResult;
export fn table_storage_is_valid(table: Table) -> bool;
export fn table_is_valid(table: Table, require_complete: bool) -> bool;
export fn table_get(table: Table, type_id: usize) -> RecordResult;
export fn table_get_field(table: Table, field_id: usize) -> FieldResult;
export fn table_add_named(
    table: Table, kind: Kind, declaration_unit: usize, declaration_node: usize,
    name_token: usize, exported: bool) -> TableResult;
export fn table_add_opaque_class(
    table: Table, declaration_unit: usize, declaration_node: usize, name_token: usize, exported: bool) -> TableResult;
export fn table_define_opaque_class(
    table: Table, type_id: usize, definition_unit: usize, definition_node: usize, name_token: usize) -> runtime::Error;
export fn table_pointer(table: *Table, element_type: usize, read_only: bool, volatile_pointee: bool) -> IdResult;
export fn table_array(table: *Table, element_type: usize, element_count: usize) -> IdResult;
export fn table_flexible_array(table: *Table, element_type: usize) -> IdResult;
export fn table_add_field(table: Table, field: Field) -> TableResult;
export fn table_add_function_pointer(table: Table, return_type: usize) -> TableResult;
export fn table_add_bound_method(table: Table, return_type: usize) -> TableResult;
export fn table_add_parameter(table: Table, owner_type: usize, parameter_type: usize) -> TableResult;
export fn table_set_layout(table: Table, type_id: usize, size_bytes: usize, alignment_bytes: usize) -> runtime::Error;
export fn table_set_packed(table: Table, type_id: usize, packed: bool) -> runtime::Error;
export fn table_set_header(table: Table, type_id: usize, header: bool) -> runtime::Error;
export fn table_set_enum_underlying(table: Table, type_id: usize, underlying_type: usize) -> runtime::Error;
export fn table_set_alias_target(table: Table, type_id: usize, target_type: usize) -> runtime::Error;
export fn table_set_base(table: Table, type_id: usize, base_type: usize) -> runtime::Error;
export fn table_set_vptr(table: Table, type_id: usize, vptr_offset: usize) -> runtime::Error;
export fn table_set_resolving(table: Table, type_id: usize, resolving: bool) -> runtime::Error;
export fn table_release(table: Table) -> runtime::Error;

export fn is_integer(kind: Kind) -> bool;
export fn is_signed_integer(kind: Kind) -> bool;
export fn is_float(kind: Kind) -> bool;
export fn is_named(kind: Kind) -> bool;
export fn is_record(kind: Kind) -> bool;
export fn is_scalar(kind: Kind) -> bool;
export fn is_memory(kind: Kind) -> bool;
export fn is_opaque_class(record: Record) -> bool;
export fn has_opaque_definition(record: Record) -> bool;
export fn bit_width(kind: Kind) -> usize;
