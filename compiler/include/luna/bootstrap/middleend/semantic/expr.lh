export module luna.bootstrap.middleend.semantic.expr;

import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.semantic.context as context;

export fn lower_expression(context: *context::Context, node_id: usize, expected_type: usize) -> context::Expression;
export fn lower_expression_into(
    context: *context::Context, node_id: usize, expected_type: usize, destination: usize) -> context::Expression;
export fn lower_into(
    context: *context::Context, node_id: usize, expected_type: usize, result: *context::Expression) -> void;
export fn lower_unary(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression;
