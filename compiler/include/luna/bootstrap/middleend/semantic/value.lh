export module luna.bootstrap.middleend.semantic.value;

import luna.bootstrap.middleend.type as type_info;

export enum Category: usize {
    rvalue, temporary, read_only_lvalue, writable_lvalue, volatile_lvalue, writable_volatile_lvalue,
    read_only_bitfield, writable_bitfield, volatile_bitfield, writable_volatile_bitfield, temporary_bitfield,
    xvalue, read_only_xvalue,
}

export enum ReferenceRank: usize {
    exact = 0, qualified = 1, temporary = 2,
}

export fn lvalue(writable: bool, volatile_access: bool) -> Category;
export fn xvalue(read_only: bool) -> Category;
export fn pointee(pointer: type_info::Record) -> Category;
export fn project(source: Category) -> Category;
export fn as_bitfield(source: Category) -> Category;
export fn is_lvalue(category: Category) -> bool;
export fn is_xvalue(category: Category) -> bool;
export fn is_expiring(category: Category) -> bool;
export fn has_storage(category: Category) -> bool;
export fn is_addressable(category: Category) -> bool;
export fn is_assignable(category: Category) -> bool;
export fn is_writable(category: Category) -> bool;
export fn is_volatile(category: Category) -> bool;
export fn is_temporary(category: Category) -> bool;
export fn reference_binding_rank(reference: type_info::Record, actual: Category) -> usize;
