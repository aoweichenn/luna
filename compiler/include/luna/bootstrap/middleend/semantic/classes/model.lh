export module luna.bootstrap.middleend.semantic.classes.model;

import luna.compiler.sema.domain as domain;
import luna.runtime;
import luna.std.vector as vector;

export class ClassTable {
    priv records: vector::vector<domain::ClassRecord>;
    priv fields: vector::vector<domain::ClassField>;
    priv methods: vector::vector<domain::ClassMethod>;
    priv friends: vector::vector<domain::ClassFriend>;
    priv error_code: runtime::Error;

    pub init();
    pub init(other: ClassTable&&);
    pub fn storage_is_valid() const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn record_count() const -> usize;
    pub fn field_count() const -> usize;
    pub fn method_count() const -> usize;
    pub fn friend_count() const -> usize;
    pub fn record_data() -> *domain::ClassRecord;
    pub fn record_data() const -> *const domain::ClassRecord;
    pub fn field_data() -> *domain::ClassField;
    pub fn field_data() const -> *const domain::ClassField;
    pub fn method_data() -> *domain::ClassMethod;
    pub fn method_data() const -> *const domain::ClassMethod;
    pub fn friend_data() -> *domain::ClassFriend;
    pub fn friend_data() const -> *const domain::ClassFriend;
    pub fn append_record(record: domain::ClassRecord) -> runtime::Error;
    pub fn append_field(record_id: usize, field: domain::ClassField) -> runtime::Error;
    pub fn append_method(record_id: usize, method_record: domain::ClassMethod) -> runtime::Error;
    pub fn append_friend(record_id: usize, friend_record: domain::ClassFriend) -> runtime::Error;
    pub deinit();
}
