export module luna.bootstrap.middleend.semantic.classes.model;

import luna.runtime;
import luna.std.bytes;

export enum Access: usize {
    invalid, public_access, protected_access, private_access,
}

export enum Dispatch: usize {
    invalid, static_method, direct, virtual_method, abstract_method,
}

export enum Flag: usize {
    none = 0, exported = 1, final_class = 2, abstract_class = 4, polymorphic = 8, rtti = 16,
}

export enum MethodFlag: usize {
    none = 0, final_method = 1,
}

export enum Layout: usize {
    vptr_size_bytes = 8, vptr_alignment_bytes = 8,
}

export enum CallDispatch: usize {
    direct, virtual_call,
}

export struct DispatchPlan {
    kind: CallDispatch;
    vptr_offset: usize;
    virtual_slot: usize;
}

export struct Record {
    type_id: usize;
    // 与类型表中的单一 base_type 镜像，用于类策略和方法层级分析。
    base_type: usize;
    first_field: usize;
    field_count: usize;
    first_method: usize;
    method_count: usize;
    first_friend: usize;
    friend_count: usize;
    vptr_offset: usize;
    descriptor_global: usize;
    vtable_global: usize;
    flags: usize;
}

export struct Field {
    field_id: usize;
    access: Access;
}

export struct Method {
    function_id: usize;
    access: Access;
    dispatch: Dispatch;
    // 槽位是层次内的稳定调用身份；具体类据此生成最终覆写者表。
    virtual_slot: usize;
    flags: usize;
}

export struct Friend {
    owner_type: usize;
    friend_type: usize;
}

export struct Store {
    records: bytes::Buffer;
    record_count: usize;
    fields: bytes::Buffer;
    field_count: usize;
    methods: bytes::Buffer;
    method_count: usize;
    friends: bytes::Buffer;
    friend_count: usize;
}

export fn empty() -> Store;
export fn storage_is_valid(store: Store) -> bool;
export fn append_record(store: *Store, record: Record) -> runtime::Error;
export fn append_field(store: *Store, record_id: usize, field: Field) -> runtime::Error;
export fn append_method(store: *Store, record_id: usize, method_record: Method) -> runtime::Error;
export fn append_friend(store: *Store, record_id: usize, friend_record: Friend) -> runtime::Error;
export fn release(store: Store) -> runtime::Error;
