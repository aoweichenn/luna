export module luna.bootstrap.middleend.semantic.generics.model;

import luna.runtime;
import luna.std.bytes;

export enum DeclarationKind: usize {
    invalid, type_declaration, function_declaration,
}

export enum InstanceState: usize {
    requested, resolving, complete, failed,
}

export struct Declaration {
    kind: DeclarationKind;
    module_id: usize;
    unit_index: usize;
    node_index: usize;
    name_token: usize;
    first_parameter: usize;
    parameter_count: usize;
    binding_id: usize;
    flags: usize;
}

export struct Parameter {
    declaration_id: usize;
    unit_index: usize;
    node_index: usize;
    name_token: usize;
    position: usize;
}

export struct Instance {
    declaration_id: usize;
    owner_type: usize;
    first_argument: usize;
    argument_count: usize;
    type_id: usize;
    function_id: usize;
    expansion_depth: usize;
    state: InstanceState;
}

export struct ActiveBinding {
    unit_index: usize;
    name_token: usize;
    type_id: usize;
}

export struct InstanceResult {
    instance_id: usize;
    error: runtime::Error;
}

export struct Store {
    declarations: bytes::Buffer;
    declaration_count: usize;
    parameters: bytes::Buffer;
    parameter_count: usize;
    instances: bytes::Buffer;
    instance_count: usize;
    arguments: bytes::Buffer;
    argument_count: usize;
    buckets: bytes::Buffer;
    bucket_count: usize;
    type_instances: bytes::Buffer;
    type_instance_count: usize;
    function_instances: bytes::Buffer;
    function_instance_count: usize;
    active_bindings: bytes::Buffer;
    active_binding_count: usize;
}

export fn no_id() -> usize;
export fn empty() -> Store;
export fn storage_is_valid(store: Store) -> bool;
export fn is_valid(store: Store) -> bool;
export fn append_declaration(store: *Store, declaration: Declaration) -> runtime::Error;
export fn append_parameter(store: *Store, declaration_id: usize, parameter: Parameter) -> runtime::Error;
export fn find_instance(
    store: Store, declaration_id: usize, owner_type: usize, arguments: *const usize, argument_count: usize) -> usize;
export fn append_instance(
    store: *Store, declaration_id: usize, owner_type: usize, arguments: *const usize,
    argument_count: usize, expansion_depth: usize) -> InstanceResult;
export fn set_instance_result(
    store: *Store, instance_id: usize, type_id: usize, function_id: usize, state: InstanceState) -> runtime::Error;
export fn instance_for_type(store: Store, type_id: usize) -> usize;
export fn instance_for_function(store: Store, function_id: usize) -> usize;
export fn map_function_instance(store: *Store, function_id: usize, instance_id: usize) -> runtime::Error;
export fn append_active_binding(store: *Store, binding: ActiveBinding) -> runtime::Error;
export fn truncate_active_bindings(store: *Store, count: usize) -> runtime::Error;
export fn release(store: Store) -> runtime::Error;
