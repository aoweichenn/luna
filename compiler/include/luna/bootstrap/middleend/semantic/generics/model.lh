export module luna.bootstrap.middleend.semantic.generics.model;

import luna.compiler.sema.domain as domain;
import luna.runtime;
import luna.std.vector as vector;

export struct InstanceResult {
    instance_id: usize;
    error: runtime::Error;
}

// 当前导出类 ABI 要求私有泛型实参可见；该记录不属于 GenericTable 的公共操作面。
export struct IndexEntry {
    value: usize;
}

export class GenericTable {
    priv declarations: vector::vector<domain::GenericDeclaration>;
    priv parameters: vector::vector<domain::GenericParameter>;
    priv instances: vector::vector<domain::GenericInstance>;
    priv arguments: vector::vector<IndexEntry>;
    priv buckets: vector::vector<IndexEntry>;
    priv type_instances: vector::vector<IndexEntry>;
    priv function_instances: vector::vector<IndexEntry>;
    priv active_bindings: vector::vector<domain::GenericActiveBinding>;
    priv error_code: runtime::Error;

    pub init();
    pub init(other: GenericTable&&);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid() const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn declaration_count() const -> usize;
    pub fn parameter_count() const -> usize;
    pub fn instance_count() const -> usize;
    pub fn argument_count() const -> usize;
    pub fn active_binding_count() const -> usize;
    pub fn declaration_data() const -> *const domain::GenericDeclaration;
    pub fn parameter_data() const -> *const domain::GenericParameter;
    pub fn instance_data() const -> *const domain::GenericInstance;
    pub fn argument_data() const -> *const usize;
    pub fn active_binding_data() const -> *const domain::GenericActiveBinding;
    pub fn append_declaration(declaration: domain::GenericDeclaration) -> runtime::Error;
    pub fn append_parameter(declaration_id: usize, parameter: domain::GenericParameter) -> runtime::Error;
    pub fn set_declaration_binding(declaration_id: usize, binding_id: usize) -> runtime::Error;
    pub fn find_instance(
        declaration_id: usize, owner_type: usize, arguments: *const usize, argument_count: usize) const -> usize;
    pub fn append_instance(
        declaration_id: usize, owner_type: usize, arguments: *const usize,
        argument_count: usize, expansion_depth: usize) -> InstanceResult;
    pub fn set_instance_result(
        instance_id: usize, type_id: usize, function_id: usize, state: domain::GenericInstanceState) -> runtime::Error;
    pub fn instance_for_type(type_id: usize) const -> usize;
    pub fn instance_for_function(function_id: usize) const -> usize;
    pub fn map_function_instance(function_id: usize, instance_id: usize) -> runtime::Error;
    pub fn append_active_binding(binding: domain::GenericActiveBinding) -> runtime::Error;
    pub fn truncate_active_bindings(count: usize) -> runtime::Error;
    pub deinit();
}

export fn no_id() -> usize;
