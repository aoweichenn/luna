export module luna.bootstrap.middleend.semantic.consteval.engine;

import luna.bootstrap.middleend.semantic.consteval.model as model;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.type as type_info;
import luna.compiler.lexer as lexer;
import luna.compiler.syntax as syntax;

export fn expression(context: *context::Context, unit_index: usize, node_index: usize) -> model::Value;
export fn eval_name(context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> model::Value;
export fn const_integer_fits(kind: type_info::Kind, value: u64) -> bool;
export fn resolve_enum_constant_values(context: *context::Context, type_id: usize) -> bool;
export fn const_value_conforms(
    context: *context::Context, unit_index: usize, span: lexer::SourceSpan, type_id: usize,
    value: model::Value) -> bool;
export fn resolve_constants(context: *context::Context) -> bool;
