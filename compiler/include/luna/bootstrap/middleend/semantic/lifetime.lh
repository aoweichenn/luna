export module luna.bootstrap.middleend.semantic.lifetime;

import luna.bootstrap.middleend.semantic.context as context;
import luna.compiler.syntax as syntax;

export fn type_needs_cleanup(context: *context::Context, type_id: usize) -> bool;
export fn emit_destroy_subobjects(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, address_id: usize, depth: usize) -> bool;
export fn emit_scope_cleanup(context: *context::Context, local_start: usize, node: syntax::SyntaxNode) -> bool;
export fn register_temporary(context: *context::Context, type_id: usize, address_id: usize) -> bool;
export fn adopt_temporary(
    context: *context::Context, first: usize, address_id: usize, type_id: *usize, owned_address: *usize) -> bool;
export fn emit_temporary_cleanup(context: *context::Context, first: usize, node: syntax::SyntaxNode) -> bool;
export fn complete_full_expression(
    context: *context::Context, first: usize, node: syntax::SyntaxNode, lowered: bool) -> bool;
