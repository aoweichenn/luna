export module luna.bootstrap.middleend.semantic.classes;

import luna.bootstrap.middleend.semantic.classes.model as model;
import luna.bootstrap.middleend.semantic.context as context;

export fn collect_classes(context: *context::Context) -> bool;
export fn collect_bases(context: *context::Context) -> bool;
export fn prepare_layouts(context: *context::Context) -> bool;
export fn access_from_flags(flags: usize) -> model::Access;
export fn collect_fields(context: *context::Context) -> bool;
export fn collect_friends(context: *context::Context) -> bool;
export fn validate_classes(context: *context::Context) -> bool;
export fn collect_methods(context: *context::Context) -> bool;
export fn validate_methods(context: *context::Context) -> bool;
export fn create_vtables(context: *context::Context) -> bool;
export fn field_is_accessible(context: *context::Context, field_id: usize) -> bool;
export fn method_is_accessible(context: *context::Context, function_id: usize) -> bool;
export fn base_type(context: *context::Context, type_id: usize) -> usize;
export fn is_base_of(context: *context::Context, candidate_base: usize, derived_type: usize) -> bool;
export fn type_contains_class_value(context: *context::Context, type_id: usize) -> bool;
export fn method_is_shadowed(context: *context::Context, lookup_type: usize, function_id: usize) -> bool;
export fn method_is_abstract(context: *context::Context, function_id: usize) -> bool;
export fn class_is_abstract(context: *context::Context, type_id: usize) -> bool;
export fn prepare_generic_class(context: *context::Context, type_id: usize) -> bool;
export fn collect_generic_methods(context: *context::Context, type_id: usize) -> bool;
export fn vptr_offset(context: *context::Context, type_id: usize) -> usize;
export fn rtti_is_enabled(context: *context::Context, type_id: usize) -> bool;
export fn descriptor_global(context: *context::Context, type_id: usize) -> usize;
export fn vtable_slot_offset(context: *context::Context, type_id: usize) -> usize;
export fn vtable_global(context: *context::Context, type_id: usize) -> usize;
export fn dispatch_plan(
    context: *context::Context, static_type: usize, function_id: usize,
    exact_dynamic_type: bool) -> model::DispatchPlan;
