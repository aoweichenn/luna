export module luna.bootstrap.middleend.semantic.expr.operators;

import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.expr.api as api;
import luna.compiler.lexer as lexer;
import luna.compiler.syntax as syntax;

export fn lower_unary(context: *context::Context, node_id: usize, node: syntax::SyntaxNode, expected_type: usize,
    lowerer: api::Lowerer) -> context::Expression;
export fn lower_cast(context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer) -> context::Expression;
export fn binary_is_arithmetic(operation: lexer::TokenKind) -> bool;
export fn binary_is_bitwise(operation: lexer::TokenKind) -> bool;
export fn pointer_arithmetic_is_allowed(context: *context::Context, pointer_type: usize) -> bool;
export fn emit_negated_usize(context: *context::Context, node: syntax::SyntaxNode, value_id: usize) -> usize;
export fn emit_pointer_offset(
    context: *context::Context, node: syntax::SyntaxNode, pointer_value: usize, pointer_type: usize, count_value: usize
) -> usize;
export fn lower_binary(context: *context::Context, node_id: usize, node: syntax::SyntaxNode, expected_type: usize,
    lowerer: api::Lowerer) -> context::Expression;
export fn lower_conditional(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize,
    lowerer: api::Lowerer, into_lowerer: api::IntoLowerer) -> context::Expression;
export fn lower_conditional_into(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize, destination: usize,
    lowerer: api::Lowerer, into_lowerer: api::IntoLowerer) -> context::Expression;
export fn lower_va_arg(context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer) -> context::Expression;
export fn lower_layout_query(context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer) -> context::Expression;
