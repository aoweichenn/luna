export module luna.bootstrap.middleend.semantic.expr.probe;

import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.semantic.callable as callable;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.value as category;

export enum Status: usize {
    incompatible, compatible, ambiguous, invalid,
}

export struct Result {
    status: Status;
    type_id: usize;
    function_id: usize;
    category: category::Category;
}

export enum ResolutionStatus: usize {
    no_match, selected, ambiguous, invalid,
}

export struct Resolution {
    status: ResolutionStatus;
    function_id: usize;
}

export enum ReceiverSource: usize {
    none, expression, current_object, construction,
}

export struct CallTarget {
    binding_id: usize;
    kind: callable::Kind;
    owner_type: usize;
    receiver_node: usize;
    receiver_type: usize;
    receiver_category: category::Category;
    receiver_source: ReceiverSource;
    name_token: usize;
    valid: bool;
}

export fn expression(context: *context::Context, node_id: usize, expected_type: usize) -> Result;
export fn resolve_call(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode, binding_id: usize) -> Resolution;
export fn direct_call_target(context: *context::Context, node: syntax::SyntaxNode) -> CallTarget;
export fn operator_call_target(context: *context::Context, node: syntax::SyntaxNode) -> CallTarget;
export fn member_value_target(context: *context::Context, node: syntax::SyntaxNode) -> CallTarget;
export fn resolve_bound_method(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> Resolution;
export fn resolve_call_target(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode, target: CallTarget) -> Resolution;
export fn call_target_visible_count(context: *context::Context, target: CallTarget) -> usize;
export fn resolve_function_value(
    context: *context::Context, binding_id: usize, request: syntax::SyntaxNode, expected_type: usize) -> Resolution;
