export module luna.bootstrap.middleend.semantic.expr.access;

import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.expr.api as api;

export fn function_value(
    context: *context::Context, node: syntax::SyntaxNode, function_id: usize) -> context::Expression;
export fn function_binding_value(
    context: *context::Context, node: syntax::SyntaxNode, binding_id: usize,
    expected_type: usize) -> context::Expression;
export fn lower_const_name(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression;
export fn lower_name(context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression;
export fn lower_this(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression;
export fn lower_enum_member(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression;
export fn store_bitfield(
    context: *context::Context, node: syntax::SyntaxNode, destination: usize, segment_id: usize,
    value: context::Expression) -> bool;
export fn lower_member(context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer) -> context::Expression;
export fn lower_index(context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer) -> context::Expression;
export fn lower_call(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode, lowerer: api::Lowerer) -> context::Expression;
