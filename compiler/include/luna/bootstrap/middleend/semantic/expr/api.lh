export module luna.bootstrap.middleend.semantic.expr.api;

import luna.bootstrap.middleend.semantic.context as context;

export type Lowerer = fn(*context::Context, usize, usize, *context::Expression) -> void;
export type IntoLowerer = fn(*context::Context, usize, usize, usize, *context::Expression) -> void;

export fn invoke(
    lowerer: Lowerer, context: *context::Context, node_id: usize, expected_type: usize) -> context::Expression;
export fn invoke_into(
    lowerer: IntoLowerer, context: *context::Context, node_id: usize,
    expected_type: usize, destination: usize) -> context::Expression;
