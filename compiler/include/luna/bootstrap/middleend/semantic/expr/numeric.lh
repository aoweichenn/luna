export module luna.bootstrap.middleend.semantic.expr.numeric;

import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.semantic.context as context;

export fn type_for_integer_literal(context: *context::Context, expected_type: usize) -> usize;
export fn lower_integer_literal(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression;
export fn lower_character_literal(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression;
export fn lower_negative_integer_literal(
    context: *context::Context, unary_node: syntax::SyntaxNode, literal_node: syntax::SyntaxNode, expected_type: usize
) -> context::Expression;
export fn lower_floating_literal(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression;
