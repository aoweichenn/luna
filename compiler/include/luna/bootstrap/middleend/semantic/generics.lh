export module luna.bootstrap.middleend.semantic.generics;

import luna.bootstrap.frontend.syntax;
import luna.bootstrap.middleend.semantic.context;
import luna.bootstrap.middleend.semantic.generics.model;

export fn parameters_node(context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode) -> usize;
export fn is_generic(context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode) -> bool;
export fn register_declaration(
    context: *context::Context, kind: model::DeclarationKind, module_id: usize,
    unit_index: usize, node_index: usize, binding_id: usize) -> usize;
export fn active_type(context: *context::Context, unit_index: usize, name_token: usize) -> usize;
export fn activate_instance(context: *context::Context, instance_id: usize) -> usize;
export fn restore_active_bindings(context: *context::Context, count: usize) -> bool;
