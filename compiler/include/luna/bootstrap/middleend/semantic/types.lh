export module luna.bootstrap.middleend.semantic.types;

import luna.bootstrap.frontend.syntax as syntax;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.type as type_info;

export fn declaration_type_kind( kind: syntax::SyntaxKind ) -> type_info::Kind;

export fn collect_types_in_unit( context: *context::Context, module_id: usize, unit_index: usize ) -> bool;

export fn collect_named_types( context: *context::Context ) -> bool;

export fn builtin_type( kind: lexer::TokenKind ) -> usize;

export fn resolve_type_node( context: *context::Context, unit_index: usize, node_index: usize ) -> usize;
export fn resolve_type_expression(context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> usize;
export fn resolve_class_expression(context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> usize;
export fn resolve_generic_expression_type(
    context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> usize;
export fn opaque_value_is_available(context: *context::Context, type_id: usize, unit_index: usize) -> bool;
export fn require_opaque_value_access(
    context: *context::Context, type_id: usize, unit_index: usize, span: lexer::SourceSpan) -> bool;

export fn find_type_symbol( context: *context::Context, type_id: usize ) -> usize;

export fn report_type_declaration(
    context: *context::Context, kind: context::DiagnosticKind, type_id: usize, detail: usize) -> bool;

export fn require_complete_type( context: *context::Context, type_id: usize ) -> bool;

export fn field_name_exists(
    context: *context::Context, owner_type: usize, unit_index: usize, name_token: usize) -> usize;

export fn resolve_record_field_types( context: *context::Context, record: type_info::Record ) -> bool;

export fn resolve_record_layout( context: *context::Context, type_id: usize, record: type_info::Record ) -> bool;

export fn enum_value(
    context: *context::Context, unit_index: usize, member: syntax::SyntaxNode, underlying_kind: type_info::Kind,
    implicit_value: u64, value: *u64, pending: *bool) -> bool;

export fn enum_can_increment( kind: type_info::Kind, value: u64 ) -> bool;

export fn resolve_enum_layout( context: *context::Context, type_id: usize, record: type_info::Record ) -> bool;

export fn resolve_alias( context: *context::Context, type_id: usize, record: type_info::Record ) -> bool;

export fn resolve_layout( context: *context::Context, type_id: usize ) -> bool;

export fn resolve_all_types( context: *context::Context ) -> bool;

export enum FieldStatus: usize {
    missing, found, ambiguous,
}

export struct FieldLookup {
    status: FieldStatus;
    field_id: usize;
    offset_bytes: usize;
}

export fn field_is_anonymous( context: *context::Context, field: type_info::Field ) -> bool;

export fn anonymous_record_type( context: *context::Context, unit_index: usize, node_index: usize ) -> usize;
export fn find_enum_member(context: *context::Context, type_id: usize, unit_index: usize, name_token: usize) -> usize;
