export module luna.bootstrap.middleend.semantic.callable;

export enum Kind: usize {
    free_function, static_method, instance_method, constructor, operator_method, destructor,
}

export enum ReceiverKind: usize {
    none, writable, read_only, writable_volatile, read_only_volatile,
}

export struct Identity {
    kind: Kind;
    owner_type: usize;
    receiver: ReceiverKind;
}

export fn no_owner() -> usize;
export fn free_function() -> Identity;
export fn has_owner(identity: Identity) -> bool;
export fn has_receiver(identity: Identity) -> bool;
export fn is_valid(identity: Identity, type_count: usize) -> bool;
export fn same_owner(left: Identity, right: Identity) -> bool;
export fn same_identity(left: Identity, right: Identity) -> bool;
