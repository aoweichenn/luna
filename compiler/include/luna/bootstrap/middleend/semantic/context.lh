export module luna.bootstrap.middleend.semantic.context;

import luna.bootstrap.frontend.syntax as syntax;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.callable as callable;
import luna.bootstrap.middleend.semantic.classes.model as class_model;
import luna.bootstrap.middleend.semantic.generics.model as generic_model;
import luna.bootstrap.middleend.semantic.value as value;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;

export enum DiagnosticKind: usize {
    invalid_input, duplicate_interface, duplicate_implementation, unknown_import, self_import, duplicate_import,
    import_cycle, unreachable_module, duplicate_name, ambiguous_import, invalid_export, private_type_exposure,
    unknown_type, duplicate_field, recursive_type, incomplete_type, object_too_large, invalid_enum_underlying,
    invalid_type_alias, invalid_enum_value, enum_value_overflow, duplicate_enum_member, duplicate_function,
    missing_definition, signature_mismatch, invalid_external, duplicate_parameter, unknown_name, duplicate_local,
    immutable_assignment, type_mismatch, invalid_condition, invalid_operator, invalid_cast, invalid_lvalue,
    invalid_call, argument_count, invalid_initializer, duplicate_initializer_field, unknown_field, invalid_index,
    invalid_member, invalid_layout_query, break_outside_control, continue_outside_loop, return_type, missing_return,
    invalid_switch, duplicate_case, duplicate_default, integer_overflow, floating_overflow, resource_limit,
    internal_invariant, unknown_attribute, invalid_attribute, noreturn_returns, assertion_failed, invalid_assert,
    unknown_intrinsic, invalid_alignment, unaligned_field_address, ambiguous_field, invalid_flexible_member,
    invalid_bitfield, invalid_character, invalid_string, non_constant_expression, invalid_const_function,
    invalid_array_length, duplicate_label, unknown_label, invalid_goto, non_loop_label, invalid_variadic,
    invalid_export_name, invalid_va_list, invalid_asm_function, invalid_embed, unknown_module_qualifier,
    ambiguous_module_qualifier, unknown_qualified_name, invalid_qualified_path, unknown_selective_import,
    invalid_selective_import, empty_selective_import, duplicate_selective_import_name,
    ambiguous_call, no_matching_overload, ambiguous_function_value,
    invalid_default_placement, invalid_default_expression, repeated_default, invalid_default_function,
    invalid_class_member, invalid_class_initialization, invalid_class_abi, invalid_class_composition,
    inaccessible_member, invalid_method, invalid_receiver, invalid_method_definition,
    invalid_base_class, inheritance_cycle, invalid_override, final_override, invalid_super, invalid_abstract_class,
    invalid_operator_method, invalid_bound_method, invalid_rtti, invalid_friend,
    invalid_opaque_class, invalid_opaque_use, invalid_member_initializer,
    invalid_generic_declaration, duplicate_generic_parameter, generic_argument_count,
    invalid_generic_use, generic_resource_limit, invalid_reference, invalid_destructor,
}

// path_offset/path_length name the source file (as the driver received it)
// inside the input's paths byte buffer; @file() emits those bytes.
export struct Unit {
    source: text::View;
    tokens: lexer::TokenBuffer;
    tree: syntax::SyntaxTree;
    path_offset: usize;
    path_length: usize;
}

export struct Input {
    units: bytes::Buffer;
    paths: bytes::Buffer;
    unit_count: usize;
    executable: bool;
}

export struct Diagnostic {
    kind: DiagnosticKind;
    unit_index: usize;
    span: lexer::SourceSpan;
    related_unit: usize;
    related_span: lexer::SourceSpan;
    detail: usize;
}

export struct DiagnosticBuffer {
    storage: bytes::Buffer;
    count: usize;
}

export struct Result {
    types: type_info::Table;
    ir: ir::Store;
    diagnostics: DiagnosticBuffer;
    error: runtime::Error;
}

export struct DiagnosticResult {
    diagnostic: Diagnostic;
    error: runtime::Error;
}

export enum Limit: usize {
    maximum_size = 18446744073709551615, maximum_modules = 1024, maximum_module_depth = 256, maximum_diagnostics = 4096,
    maximum_scope_depth = 256, maximum_type_depth = 256, target_maximum_alignment = 8,
    maximum_attribute_alignment = 4096, target_maximum_object_size = 2147483647, maximum_floating_digits = 1200,
    maximum_floating_limbs = 128, floating_exponent_margin = 2048, maximum_const_steps = 65536,
    maximum_const_call_depth = 128,
    maximum_generic_parameters = 32, maximum_generic_instances = 4096, maximum_generic_depth = 64,
}

export enum SymbolKind: usize {
    named_type, function, enum_member, constant, const_function, generic_type, generic_function,
}

export enum SymbolFlag: usize {
    none = 0, exported = 1, external = 2, interface_declaration = 4, no_return = 8, inline_hint = 16,
    constant_resolved = 32, constant_resolving = 64, enum_value_pending = 128, enum_values_resolving = 256,
    variadic = 512, asm_function = 1024, member_exported = 2048, abstract_method = 4096,
}

export enum LiteralFamily: usize {
    none, integer, floating, null_pointer,
}

export struct Module {
    interface_unit: usize;
    implementation_count: usize;
    name_unit: usize;
    name_node: usize;
    first_import: usize;
    import_count: usize;
    visit_state: usize;
    reachable: bool;
}

export struct UnitInfo {
    module_id: usize;
    interface_unit: usize;
}

export struct Import {
    owner_module: usize;
    source_unit: usize;
    declaration_node: usize;
    target_module: usize;
    interface_import: bool;
    // Token index (in source_unit) of the `as` alias, or no-id for a plain
    // import. An aliased import binds only the `<alias>::` qualifier and
    // contributes no flat names.
    alias_token: usize;
    // Node index (in source_unit) of the selective_import_names container
    // for `import a.b.c::{x, y};`, or no-id for a non-selective import. A
    // selective import binds only the listed names flat, plus the module's
    // last segment as a qualifier.
    selective_node: usize;
}

export struct Symbol {
    kind: SymbolKind;
    module_id: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    type_id: usize;
    function_id: usize;
    integer_value: u64;
    flags: usize;
}

export enum BindingKind: usize {
    invalid, callable_set,
}

export struct Binding {
    kind: BindingKind;
    module_id: usize;
    owner_type: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    first_candidate: usize;
    candidate_count: usize;
    first_generic_candidate: usize;
    generic_candidate_count: usize;
}

export struct Function {
    identity: callable::Identity;
    symbol_id: usize;
    binding_id: usize;
    interface_unit: usize;
    interface_node: usize;
    implementation_unit: usize;
    implementation_node: usize;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
    required_parameter_count: usize;
    signature_offset: usize;
    signature_length: usize;
    ir_function: usize;
    flags: usize;
}

export enum ParameterDefaultKind: usize {
    none, integer, boolean, null_pointer,
}

export struct Parameter {
    function_id: usize;
    type_id: usize;
    unit_index: usize;
    declaration_node: usize;
    name_token: usize;
    default_node: usize;
    default_value: u64;
    default_kind: ParameterDefaultKind;
}

export struct Local {
    function_id: usize;
    type_id: usize;
    slot_id: usize;
    unit_index: usize;
    declaration_node: usize;
    name_token: usize;
    scope_depth: usize;
    mutable_binding: bool;
    volatile_binding: bool;
    constant_binding: bool;
    integer_value: u64;
    cleanup_type_id: usize;
    cleanup_address: usize;
}

export struct Temporary {
    type_id: usize;
    address_id: usize;
    active: bool;
}

export struct LocalSnapshot {
    declaration_node: usize;
    type_id: usize;
}

// A `name:` label in the function being lowered. Labels share function
// scope; first_local/local_count slice the label_locals snapshot buffer
// holding the identity and type of every local live at the label.
export struct Label {
    name_token: usize;
    span: lexer::SourceSpan;
    block: usize;
    first_local: usize;
    local_count: usize;
    is_loop: bool;
    defined: bool;
}

// A `goto` whose label was not yet defined when the jump was lowered; its
// live-local snapshot (in goto_locals) is validated at definition time.
export struct PendingGoto {
    label_token: usize;
    span: lexer::SourceSpan;
    first_local: usize;
    local_count: usize;
    resolved: bool;
}

// One enclosing loop's label on the per-function stack; labeled
// break/continue walk it to find the loop's exit/continue blocks.
export struct LoopLabel {
    name_token: usize;
    break_block: usize;
    continue_block: usize;
    break_local_count: usize;
    continue_local_count: usize;
}

export struct Expression {
    type_id: usize;
    value_id: usize;
    address_id: usize;
    constant_value: u64;
    has_constant: bool;
    category: value::Category;
    valid: bool;
    // Bit segment id when the expression accesses an @bits segment; the
    // address is the storage field's and writes go through a masking
    // read-modify-write instead of a plain store.
    bitfield_segment: usize;
}

// One `name: width` segment of an @bits attribute. Segments are sema-level
// metadata keyed by the storage field's declaration; IR and codegen never
// see them because access lowers to shift/mask on the storage field.
export struct BitfieldSegment {
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    bit_offset: usize;
    bit_width: usize;
}

export struct BigUnsigned {
    limbs: [128]u64;
    count: usize;
}

export struct SignedMagnitude {
    magnitude: usize;
    negative: bool;
}

export struct DecimalFloating {
    coefficient: BigUnsigned;
    five_power: BigUnsigned;
    decimal_exponent: isize;
    truncated_nonzero: bool;
}

export struct AlignmentOverride {
    declaration_unit: usize;
    declaration_node: usize;
    alignment: usize;
}

// A `const fn` declaration: evaluator-only, never lowered to IR. Parameters
// reuse the shared parameter buffer (with function_id set to no-id so regular
// duplicate detection never matches them); the symbol's function_id indexes
// this table.
export struct ConstFunction {
    symbol_id: usize;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
}

// One live binding of the const-function interpreter. The stack is shared by
// every active call frame; frames truncate it on exit.
export struct ConstLocal {
    unit_index: usize;
    name_token: usize;
    type_id: usize;
    value: u64;
    is_boolean: bool;
    mutable_binding: bool;
}

// Cached constant value of an array length expression, filled by the consteval
// prescan so type resolution (which cannot import consteval) can read it.
export struct ArrayLength {
    unit_index: usize;
    node_index: usize;
    value: u64;
    valid: bool;
}

export struct Context {
    input: Input;
    units: bytes::Buffer;
    unit_count: usize;
    modules: bytes::Buffer;
    module_count: usize;
    imports: bytes::Buffer;
    import_count: usize;
    symbols: bytes::Buffer;
    symbol_count: usize;
    bindings: bytes::Buffer;
    binding_count: usize;
    callable_candidates: bytes::Buffer;
    callable_candidate_count: usize;
    generic_callable_candidates: bytes::Buffer;
    generic_callable_candidate_count: usize;
    call_selections: bytes::Buffer;
    call_selection_count: usize;
    functions: bytes::Buffer;
    function_count: usize;
    callable_signatures: bytes::Buffer;
    parameters: bytes::Buffer;
    parameter_count: usize;
    classes: class_model::Store;
    generics: generic_model::Store;
    locals: bytes::Buffer;
    local_count: usize;
    temporaries: bytes::Buffer;
    temporary_count: usize;
    alignment_overrides: bytes::Buffer;
    alignment_override_count: usize;
    bitfield_segments: bytes::Buffer;
    bitfield_segment_count: usize;
    const_functions: bytes::Buffer;
    const_function_count: usize;
    const_locals: bytes::Buffer;
    const_local_count: usize;
    array_lengths: bytes::Buffer;
    array_length_count: usize;
    labels: bytes::Buffer;
    label_count: usize;
    label_locals: bytes::Buffer;
    pending_gotos: bytes::Buffer;
    pending_goto_count: usize;
    goto_locals: bytes::Buffer;
    loop_labels: bytes::Buffer;
    loop_label_count: usize;
    pending_loop_label: usize;
    const_call_depth: usize;
    const_steps: usize;
    types: type_info::Table;
    ir: ir::Store;
    diagnostics: DiagnosticBuffer;
    error: runtime::Error;
    current_function: usize;
    current_unit: usize;
    current_block: usize;
    scope_depth: usize;
    type_depth: usize;
    break_block: usize;
    continue_block: usize;
    break_local_count: usize;
    continue_local_count: usize;
}

export fn no_id() -> usize;

export fn empty_span() -> lexer::SourceSpan;

export fn invalid_diagnostic() -> Diagnostic;

export fn input_empty( executable: bool ) -> Input;

export fn input_storage_is_valid( input: Input ) -> bool;

export fn source_is_valid( source: text::View ) -> bool;

export fn unit_is_valid( unit: Unit ) -> bool;

export fn input_is_valid( input: Input ) -> bool;

export fn input_add( input: *Input, unit: Unit, path: text::View ) -> bool;

export fn input_release( input: Input ) -> runtime::Error;

export fn diagnostics_empty() -> DiagnosticBuffer;

export fn diagnostics_storage_is_valid( diagnostics: DiagnosticBuffer ) -> bool;

export fn diagnostic_get( diagnostics: DiagnosticBuffer, index: usize ) -> DiagnosticResult;

export fn add_diagnostic(
    context: *Context, kind: DiagnosticKind, unit_index: usize, span: lexer::SourceSpan, related_unit: usize,
    related_span: lexer::SourceSpan, detail: usize) -> bool;

export fn result_is_success( result: Result ) -> bool;

export fn release_error( current: runtime::Error, next: runtime::Error ) -> runtime::Error;

export fn result_release( result: Result ) -> runtime::Error;

export fn context_storage_is_valid( context: *Context ) -> bool;

export fn context_init( input: Input ) -> Context;

export fn context_release_work( context: *Context ) -> runtime::Error;

export fn input_unit( context: *Context, unit_index: usize ) -> *const Unit;

export fn unit_path( context: *Context, unit_index: usize ) -> text::View;

export fn node( context: *Context, unit_index: usize, node_index: usize ) -> syntax::SyntaxNode;

export fn token( context: *Context, unit_index: usize, token_index: usize ) -> lexer::Token;

export fn text_equal(
    context: *Context, left_unit: usize, left_span: lexer::SourceSpan, right_unit: usize,
    right_span: lexer::SourceSpan) -> bool;

export fn tokens_equal(
    context: *Context, left_unit: usize, left_token: usize, right_unit: usize, right_token: usize) -> bool;

export fn module_names_equal(
    context: *Context, left_unit: usize, left_node: usize, right_unit: usize, right_node: usize) -> bool;

export fn parse_unsigned( context: *Context, unit_index: usize, token_index: usize, value: *u64 ) -> bool;

export fn decode_character( context: *Context, unit_index: usize, token_index: usize, value: *u64 ) -> bool;

export fn function_pointer_type(
    context: *Context, return_type: usize, parameter_types: *const usize, parameter_count: usize) -> usize;
export fn bound_method_type(
    context: *Context, return_type: usize, parameter_types: *const usize, parameter_count: usize) -> usize;

export fn align_up( value: usize, alignment: usize, result: *usize ) -> bool;

export fn integer_fits_type( kind: type_info::Kind, magnitude: u64, negative: bool ) -> bool;

export fn type_record( context: *Context, type_id: usize ) -> type_info::Record;

export fn token_equals_bytes(
    context: *Context, unit_index: usize, token_index: usize, bytes: *const u8, length: usize) -> bool;
