export module luna.bootstrap.middleend.semantic.intrinsics;

import luna.bootstrap.frontend.syntax as syntax;

import luna.bootstrap.middleend.semantic.context as context;

export enum IntrinsicOperandClass: usize {
    none, integer_scalar, integer_scalar_rotated, integer_scalar_wide, float_scalar, float_scalar_binary,
    integer_overflow, embedded_file,
}

export enum IntrinsicLowering: usize {
    source_file, source_line,
    count_leading_zeros, count_trailing_zeros, population_count, rotate_left, rotate_right, byte_swap,
    float_square_root, float_floor, float_ceiling, float_truncate, float_round, float_minimum, float_maximum,
    float_absolute, overflow_add, overflow_subtract, overflow_multiply, embed,
}

export enum IntrinsicLimit: usize {
    entries = 20,
}

export struct IntrinsicEntry {
    name: *const u8;
    name_length: usize;
    arity: usize;
    operand_class: IntrinsicOperandClass;
    lowering: IntrinsicLowering;
}

export fn intrinsic_entry(index: usize) -> IntrinsicEntry;

export fn intrinsic_resolve( context: *context::Context, node: syntax::SyntaxNode ) -> usize;

export fn lower_intrinsic(
    context: *context::Context, node: syntax::SyntaxNode, intrinsic_index: usize, operand: context::Expression,
    count: context::Expression, destination: context::Expression) -> context::Expression;
