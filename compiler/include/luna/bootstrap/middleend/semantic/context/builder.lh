export module luna.bootstrap.middleend.semantic.context.builder;

import luna.bootstrap.middleend.semantic.context as context;
import luna.compiler.ir as ir;
import luna.compiler.syntax as syntax;
import luna.std.bytes as bytes;

export fn current_ir_function(context: *context::Context) -> usize;
export fn current_function_is_variadic(context: *context::Context) -> bool;
export fn instruction(opcode: ir::Opcode, node: syntax::SyntaxNode) -> ir::Instruction;
export fn emit_value(context: *context::Context, instruction: ir::Instruction, type_id: usize) -> usize;
export fn emit_void(context: *context::Context, instruction: ir::Instruction) -> usize;
export fn emit_integer_constant(context: *context::Context, node: syntax::SyntaxNode, type_id: usize,
    value: u64) -> context::Expression;
export fn emit_boolean_constant(context: *context::Context, node: syntax::SyntaxNode,
    value: bool) -> context::Expression;
export fn emit_null_constant(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize) -> context::Expression;
export fn append_local(context: *context::Context, local: context::Local) -> usize;
export fn append_temporary(context: *context::Context, temporary: context::Temporary) -> usize;
export fn append_alignment_override(
    context: *context::Context, declaration_unit: usize, declaration_node: usize, alignment: usize) -> bool;
export fn alignment_override(context: *context::Context, declaration_unit: usize, declaration_node: usize) -> usize;
export fn append_bitfield_segment(context: *context::Context, segment: context::BitfieldSegment) -> bool;
export fn find_array_length(context: *context::Context, unit_index: usize, node_index: usize) -> usize;
export fn bitfield_segment(context: *context::Context, segment_id: usize) -> context::BitfieldSegment;
export fn bitfield_storage_field(context: *context::Context, segment: context::BitfieldSegment) -> usize;
export fn lookup_bitfield_segment(context: *context::Context, owner_type: usize, unit_index: usize,
    name_token: usize) -> usize;
export fn find_local(context: *context::Context, unit_index: usize, name_token: usize) -> usize;
export fn local_in_current_scope(context: *context::Context, unit_index: usize, name_token: usize) -> usize;
export fn address_of_slot(
    context: *context::Context, node: syntax::SyntaxNode, slot_id: usize, value_type: usize, read_only: bool,
    volatile_pointee: bool) -> usize;
export fn load_lvalue(context: *context::Context, node: syntax::SyntaxNode,
    expression: context::Expression) -> context::Expression;
export fn mask_integer(value: u64, bits: usize) -> u64;
export fn store_to_address(
    context: *context::Context, node: syntax::SyntaxNode, destination: usize, type_id: usize,
        value: context::Expression) -> bool;
export fn zero_slot(context: *context::Context, node: syntax::SyntaxNode, slot_id: usize, type_id: usize) -> bool;
export fn emit_jump(context: *context::Context, node: syntax::SyntaxNode, target_block: usize) -> bool;
export fn emit_branch(
    context: *context::Context, node: syntax::SyntaxNode, condition: usize, true_block: usize,
        false_block: usize) -> bool;
export fn add_current_block(context: *context::Context) -> usize;
export fn set_current_block(context: *context::Context, block_id: usize) -> bool;
export fn block_is_terminated(context: *context::Context, block_id: usize) -> bool;
export fn enqueue_reachable_block(
    context: *context::Context, function: ir::Function, block_id: usize, reached: *bytes::Buffer,
        pending: *bytes::Buffer) -> bool;
export fn block_is_reachable(context: *context::Context, function: ir::Function, target_block: usize) -> bool;
export fn terminate_unreachable_blocks(context: *context::Context, function: ir::Function,
    node: syntax::SyntaxNode) -> bool;
export fn enter_scope(context: *context::Context) -> usize;
export fn leave_scope(context: *context::Context, local_start: usize) -> bool;
