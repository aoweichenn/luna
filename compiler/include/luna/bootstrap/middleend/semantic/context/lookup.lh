export module luna.bootstrap.middleend.semantic.context.lookup;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.syntax as syntax;
import luna.std.bytes as bytes;

import luna.bootstrap.middleend.semantic.context as context;

export fn append_record(context: *context::Context, destination: *bytes::Buffer, data: *const u8,
    length: usize) -> bool;
export fn append_unit_info(context: *context::Context, info: context::UnitInfo) -> bool;
export fn append_module(context: *context::Context, module_record: context::Module) -> usize;
export fn find_module_by_name(context: *context::Context, unit_index: usize, name_node: usize) -> usize;
export fn program_module_node(context: *context::Context, unit_index: usize) -> usize;
export fn append_import(context: *context::Context, record: context::Import) -> usize;
export fn append_symbol(context: *context::Context, symbol: context::Symbol) -> usize;
export fn find_local_symbol(
    context: *context::Context, module_id: usize, unit_index: usize, name_token: usize, kind: context::SymbolKind,
        interface_scope: bool) -> usize;
export fn find_any_local_symbol(context: *context::Context, module_id: usize, unit_index: usize,
    name_token: usize) -> usize;
export fn unit_module(context: *context::Context, unit_index: usize) -> usize;
export fn unit_is_interface(context: *context::Context, unit_index: usize) -> bool;
export fn import_binds_name(context: *context::Context, import_record: context::Import, unit_index: usize,
    name_token: usize) -> bool;
export fn import_binds_symbol(context: *context::Context, import_record: context::Import,
    symbol: context::Symbol) -> bool;
export fn find_imported_symbol(context: *context::Context, unit_index: usize, name_token: usize,
    kind: context::SymbolKind) -> usize;
export fn lookup_symbol(context: *context::Context, unit_index: usize, name_token: usize,
    kind: context::SymbolKind) -> usize;
export fn find_qualifier_target(context: *context::Context, unit_index: usize, qualifier_token: usize,
    ambiguous: *bool) -> usize;
export fn resolve_module_qualifier(
    context: *context::Context, unit_index: usize, qualifier_token: usize, qualifier_span: lexer::SourceSpan) -> usize;
export fn find_module_symbol(
    context: *context::Context, unit_index: usize, module_id: usize, name_token: usize,
        kind: context::SymbolKind) -> usize;
export fn lookup_qualified_symbol(
    context: *context::Context, unit_index: usize, path: syntax::SyntaxNode, kind: context::SymbolKind,
        diagnose: bool) -> usize;
export fn first_declaration(context: *context::Context, unit_index: usize) -> usize;
