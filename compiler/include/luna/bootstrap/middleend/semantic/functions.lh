export module luna.bootstrap.middleend.semantic.functions;

import luna.bootstrap.frontend.syntax as syntax;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.value as category;

export enum GenericResolutionStatus: usize {
    no_match, selected, ambiguous, invalid,
}

export struct GenericResolution {
    status: GenericResolutionStatus;
    function_id: usize;
}

export enum SpecialMemberStatus: usize {
    unavailable, trivial, selected, ambiguous,
}

export struct SpecialMemberResolution {
    status: SpecialMemberStatus;
    function_id: usize;
}

export type ArgumentTypeProbe = fn(*context::Context, usize, usize) -> usize;

export fn function_parts(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, parameter_count: *usize,
    return_node: *usize, body_node: *usize) -> bool;

export fn collect_functions( context: *context::Context ) -> bool;
export fn build_instance_signature(context: *context::Context, function_id: usize) -> bool;
export fn first_parameter_node(context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode) -> usize;

export fn lookup_callable_binding(context: *context::Context, unit_index: usize, name_token: usize) -> usize;
export fn lookup_qualified_callable_binding(
    context: *context::Context, unit_index: usize, path: syntax::SyntaxNode, diagnose: bool) -> usize;
export fn lookup_owned_callable_binding(
    context: *context::Context, unit_index: usize, owner_type: usize, name_token: usize) -> usize;
export fn lookup_constructor_binding(context: *context::Context, owner_type: usize) -> usize;
export fn destructor(context: *context::Context, owner_type: usize) -> usize;
export fn resolve_special_constructor(
    context: *context::Context, owner_type: usize,
    source_type: usize, source_category: category::Category) -> SpecialMemberResolution;
export fn type_is_trivially_copyable(context: *context::Context, type_id: usize) -> bool;
export fn type_requires_explicit_initialization(context: *context::Context, type_id: usize) -> bool;
export fn binding_single_function(context: *context::Context, binding_id: usize, unit_index: usize) -> usize;
export fn binding_candidate(context: *context::Context, binding_id: usize, candidate_index: usize) -> usize;
export fn generic_binding_candidate(context: *context::Context, binding_id: usize, candidate_index: usize) -> usize;
export fn bind_function_instances(context: *context::Context, first_function: usize, owner_type: usize) -> bool;
export fn instantiate_generic_class(context: *context::Context, type_id: usize) -> bool;
export fn function_is_visible(context: *context::Context, function_id: usize, unit_index: usize) -> bool;
export fn binding_visible_count(context: *context::Context, binding_id: usize, unit_index: usize) -> usize;
export fn ordered_function_id(context: *context::Context, index: usize) -> usize;
export fn function_receiver_parameter_count(function: context::Function) -> usize;
export fn function_receiver_type(context: *context::Context, function: context::Function) -> usize;
export fn function_argument_parameter_count(function: context::Function) -> usize;
export fn function_required_argument_count(function: context::Function) -> usize;
export fn function_first_argument_parameter(function: context::Function) -> usize;
export fn function_accepts_arity(context: *context::Context, function_id: usize, argument_count: usize) -> bool;
export fn resolve_generic_call(
    context: *context::Context, binding_id: usize, call_node: syntax::SyntaxNode,
    explicit_arguments: usize, probe: ArgumentTypeProbe) -> GenericResolution;
export fn resolve_generic_function_value(
    context: *context::Context, binding_id: usize,
    request: syntax::SyntaxNode, expected_type: usize) -> GenericResolution;

export fn collect_const_functions( context: *context::Context ) -> bool;
export fn function_export_name_token(context: *context::Context, function: context::Function) -> usize;
