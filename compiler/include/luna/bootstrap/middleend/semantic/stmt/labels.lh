export module luna.bootstrap.middleend.semantic.stmt.labels;

import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.stmt.api as api;
import luna.compiler.syntax as syntax;

export fn push_loop_label(context: *context::Context) -> bool;
export fn pop_loop_label(context: *context::Context) -> bool;
export fn lower_labeled_control(
    context: *context::Context, node: syntax::SyntaxNode, is_break: bool, cleanup: api::Cleanup) -> bool;
export fn lower_labeled(
    context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer, needs_cleanup: api::NeedsCleanup) -> bool;
export fn lower_goto(context: *context::Context, node: syntax::SyntaxNode, needs_cleanup: api::NeedsCleanup) -> bool;
export fn validate_labels(context: *context::Context) -> bool;
