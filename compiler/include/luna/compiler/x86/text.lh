export module luna.compiler.x86.text;

import luna.runtime;
import luna.std.bytes as bytes;

export struct Text {
    buffer: bytes::Buffer;
    error: runtime::Error;
}

export fn empty() -> Text;
export fn is_valid(text: Text) -> bool;
export fn append(text: *Text, data: *const u8, length: usize) -> bool;
export fn append_c_string(text: *Text, data: *const u8, maximum_length: usize) -> bool;
export fn append_u64(text: *Text, value: u64) -> bool;
export fn append_usize(text: *Text, value: usize) -> bool;
export fn append_hex(text: *Text, value: u64, digit_count: usize) -> bool;
export fn append_hex_bytes(text: *Text, data: *const u8, length: usize) -> bool;
export fn take(text: *Text) -> bytes::BufferResult;
export fn release(text: Text) -> runtime::Error;
