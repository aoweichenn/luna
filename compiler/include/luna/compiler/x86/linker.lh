export module luna.compiler.x86.linker;

import luna.compiler.x86.object as object;
import luna.runtime;
import luna.std.binary as binary;
import luna.std.buffer as buffer;
import luna.std.bytes as bytes;
import luna.std.checked as checked;
import luna.std.map as map;
import luna.std.string_view as string_views;
import luna.std.vector as vector;

enum Limit: usize {
    maximum_inputs = 128, maximum_output = 268435456, page_size = 4096, image_base = 4194304, text_offset = 4096,
    maximum_signed_address = 9223372036854775807,
}

enum Elf: usize {
    header_size = 64, program_header_size = 56, machine_x86_64 = 62,
    executable_type = 2, load_segment = 1, maximum_load_segments = 3, flag_execute = 1, flag_write = 2, flag_read = 4,
}

enum RelocationLimit: usize {
    address_width = 8, word_width = 4, maximum_unsigned_32 = 4294967295, maximum_signed_32 = 2147483647,
}

enum Fill: u8 {
    zero = 0, nop = 144,
}

struct Placement {
    text: usize;
    rodata: usize;
    data: usize;
    bss: usize;
}

struct Global {
    object_index: usize;
    symbol_index: usize;
}

struct RelocationRegion {
    storage: *buffer::byte_buffer;
    placement_offset: usize;
    virtual_address: usize;
}

struct LoadSegment {
    content: *const buffer::byte_buffer;
    flags: u32;
    offset: usize;
    virtual_address: usize;
    file_size: usize;
    memory_size: usize;
    enabled: bool;
}

export class GlobalName {
    priv name: string_views::string_view;

    pub init(name: string_views::string_view);
    pub operator <(right: GlobalName) const -> bool;
}

class StaticLinker {
    priv objects: *const object::ObjectSet;
    priv object_count: usize;
    priv placements: vector::vector<Placement>;
    priv globals: map::map<GlobalName, Global>;
    priv text: buffer::byte_buffer;
    priv rodata: buffer::byte_buffer;
    priv data: buffer::byte_buffer;
    priv executable: buffer::byte_buffer;
    priv bss_size: usize;
    priv bss_alignment: usize;
    priv text_address: usize;
    priv rodata_address: usize;
    priv data_address: usize;
    priv bss_address: usize;
    priv entry_address: usize;
    priv error_code: runtime::Error;
    priv input_index: usize;

    pub init(objects: object::ObjectSet const&);
    pub fn run();
    pub fn take_result() -> Result;
    pub deinit();
}

export struct Result {
    executable: bytes::Buffer;
    error: runtime::Error;
    input_index: usize;
}

export fn link(objects: object::ObjectSet const&) -> Result;
