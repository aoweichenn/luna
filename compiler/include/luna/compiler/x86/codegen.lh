export module luna.compiler.x86.codegen;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.ir.verify as ir_check;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.ascii as ascii;
import luna.std.bytes as bytes;
import luna.std.charconv as charconv;
import luna.std.checked as checked;
import luna.std.string as strings;
import luna.std.string_view as string_views;
import luna.std.vector as vector;

enum Class: usize {
    invalid, no_class, integer, sse, memory,
}

enum LocationKind: usize {
    invalid, general_register, vector_register, stack,
}

struct Classification {
    eightbyte_count: usize;
    first: Class;
    second: Class;
}

struct Piece {
    abi_class: Class;
    location: LocationKind;
    register_index: usize;
    value_offset_bytes: usize;
    size_bytes: usize;
}

struct Parameter {
    function_id: usize;
    parameter_index: usize;
    abi_class: Class;
    location: LocationKind;
    register_index: usize;
    stack_offset_bytes: usize;
    stack_size_bytes: usize;
    type_id: usize;
    size_bytes: usize;
    alignment_bytes: usize;
    first_piece: usize;
    piece_count: usize;
    aggregate: bool;
}

struct Function {
    function_id: usize;
    first_parameter: usize;
    parameter_count: usize;
    first_return_piece: usize;
    return_piece_count: usize;
    return_type: usize;
    return_size_bytes: usize;
    return_alignment_bytes: usize;
    return_aggregate: bool;
    hidden_return_pointer: bool;
    general_register_count: usize;
    vector_register_count: usize;
    stack_argument_size_bytes: usize;
    call_frame_size_bytes: usize;
}

class AbiLayout {
    priv functions: vector::vector<Function>;
    priv parameters: vector::vector<Parameter>;
    priv pieces: vector::vector<Piece>;
    priv error_code: runtime::Error;

    pub init();
    pub fn build(ir: ir::Store, types: type_info::Table) -> bool;
    pub fn is_valid(ir: ir::Store, types: type_info::Table) const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn function_count() const -> usize;
    pub fn parameter_count() const -> usize;
    pub fn piece_count() const -> usize;
    pub fn function_data() const -> *const Function;
    pub fn parameter_data() const -> *const Parameter;
    pub fn piece_data() const -> *const Piece;
    pub fn function_at(function_id: usize) const -> FunctionResult;
    pub fn parameter_at(parameter_id: usize) const -> ParameterResult;
    pub fn piece_at(piece_id: usize) const -> PieceResult;
    pub deinit();
}

struct FunctionResult {
    function: Function;
    error: runtime::Error;
}

struct ParameterResult {
    parameter: Parameter;
    error: runtime::Error;
}

struct PieceResult {
    piece: Piece;
    error: runtime::Error;
}

enum StorageKind: usize {
    invalid, slot, value, aggregate_call_result, hidden_return_pointer, register_save_area,
}

struct Storage {
    function_id: usize;
    kind: StorageKind;
    source_id: usize;
    type_id: usize;
    offset_bytes: usize;
    size_bytes: usize;
    alignment_bytes: usize;
}

struct Frame {
    function_id: usize;
    first_storage: usize;
    storage_count: usize;
    frame_size_bytes: usize;
    // 超过 16 字节的动态对齐会在序言中下调 rsp，所有 frame 引用因此改用 rsp 相对地址。
    dynamic_alignment: usize;
}

class FramePlan {
    priv frames: vector::vector<Frame>;
    priv storage: vector::vector<Storage>;
    priv error_code: runtime::Error;

    pub init();
    pub fn build(ir: ir::Store, types: type_info::Table, abi: AbiLayout const&) -> bool;
    pub fn is_valid(ir: ir::Store, types: type_info::Table, abi: AbiLayout const&) const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn frame_count() const -> usize;
    pub fn storage_count() const -> usize;
    pub fn frame_data() const -> *const Frame;
    pub fn storage_data() const -> *const Storage;
    pub fn frame_at(function_id: usize) const -> FrameResult;
    pub fn find_storage(function_id: usize, kind: StorageKind, source_id: usize) const -> StorageResult;
    pub deinit();
}

struct FrameResult {
    frame: Frame;
    error: runtime::Error;
}

struct StorageResult {
    storage: Storage;
    error: runtime::Error;
}

enum CodegenLimit: usize {
    maximum_size = 18446744073709551615, maximum_assembly_size = 8388608, maximum_literal_size = 4096,
    general_argument_registers = 6, vector_argument_registers = 8, variadic_stack_slot = 8, call_stack_alignment = 16,
}

class CodeGenerator {
    priv semantic_input: context::Input;
    priv ir: ir::Store;
    priv types: type_info::Table;
    priv abi: AbiLayout;
    priv frames: FramePlan;
    priv assembly: strings::string;
    priv current_function: usize;
    // 该值只在 call 的 subq 与匹配 addq 之间非零，记录当前 outgoing 参数区字节数。
    priv call_frame_depth: usize;
    priv error: runtime::Error;

    pub init(semantic_input: context::Input, ir: ir::Store, types: type_info::Table);
    pub fn run();
    pub fn take_result() -> BackendResult;
    pub deinit();
}

export struct BackendResult {
    assembly: bytes::Buffer;
    error: runtime::Error;
}

export fn backend_empty() -> BackendResult;
export fn backend_is_success(
    result: BackendResult, semantic_input: context::Input, ir: ir::Store, types: type_info::Table) -> bool;
export fn emit_assembly(semantic_input: context::Input, ir: ir::Store, types: type_info::Table) -> BackendResult;
export fn backend_release(result: BackendResult) -> runtime::Error;
