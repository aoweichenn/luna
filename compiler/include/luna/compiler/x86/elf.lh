export module luna.compiler.x86.elf;

import luna.compiler.x86.object as object;
import luna.runtime as runtime;
import luna.std.binary as binary;
import luna.std.bytes as bytes;
import luna.std.checked as checked;
import luna.std.span as span;
import luna.std.string_view as string_views;
import luna.std.vector as vector;

enum SectionType: usize {
    none = 0, progbits = 1, symtab = 2, strtab = 3, rela = 4, note = 7, nobits = 8, rel = 9,
    unsupported = 18446744073709551615,
}

enum SectionFlag: usize {
    write = 1, alloc = 2, execute = 4, group = 512, tls = 1024,
}

enum SectionPlacement: usize {
    read_only = 0, writable = 1, executable = 4,
}

enum SectionIndex: usize {
    undefined = 0, reserve_low = 65280, absolute = 65521, common = 65522,
}

enum SymbolSectionKind: u8 {
    ordinary, undefined, common, reserved,
}

enum SymbolBind: usize {
    local = 0, global = 1, weak = 2,
}

enum SymbolType: usize {
    notype = 0, object = 1, function = 2, section = 3, file = 4, common = 5, tls = 6,
    unsupported = 18446744073709551615,
}

enum RelocationType: usize {
    unsupported = 0, absolute64 = 1, pc32 = 2, plt32 = 4, absolute32 = 10, signed32 = 11,
}

enum Limit: usize {
    header_size = 64, section_size = 64, symbol_size = 24, relocation_size = 24, maximum_sections = 4096,
    maximum_records = 65536, maximum_payload = 67108864, maximum_alignment = 4096, maximum_name = 4096,
    no_symbol = 18446744073709551615,
}

struct InputSection {
    region: object::Section;
    region_offset: usize;
    symbol: usize;
    kind: SectionType;
    flags: usize;
    offset: usize;
    size: usize;
    link: usize;
    info: usize;
    alignment: usize;
    entry_size: usize;
}

enum SectionSource: u8 {
    none, text, rodata, data, symtab, strtab, shstrtab, rela_text, rela_rodata, rela_data,
}

struct OutputSection {
    name: usize;
    kind: SectionType;
    flags: usize;
    offset: usize;
    size: usize;
    link: usize;
    info: usize;
    alignment: usize;
    entry_size: usize;
    source: SectionSource;
}

struct SavePlan {
    text_section: usize;
    rodata_section: usize;
    data_section: usize;
    bss_section: usize;
    symtab_section: usize;
    strtab_section: usize;
    shstrtab_section: usize;
    rela_text_section: usize;
    rela_rodata_section: usize;
    rela_data_section: usize;
    note_section: usize;
    section_count: usize;
    first_global: usize;
    section_offset: usize;
}

struct SymbolMapping {
    index: usize;
}

class ElfReader {
    priv input: *const u8;
    priv input_size: usize;
    priv sections: vector::vector<InputSection>;
    priv symbol_map: vector::vector<SymbolMapping>;
    priv symtab_index: usize;
    priv has_symtab: bool;
    priv storage: object::ObjectBuilder;
    priv error_code: runtime::Error;

    pub init(input: *const u8, input_size: usize);
    pub fn run();
    pub fn take_result() -> object::Result;
    pub deinit();
}

class ElfWriter {
    priv source: *const object::Object;
    priv sections: vector::vector<OutputSection>;
    priv symbol_map: vector::vector<SymbolMapping>;
    priv shstrtab: bytes::Buffer;
    priv strtab: bytes::Buffer;
    priv symtab: bytes::Buffer;
    priv rela_text: bytes::Buffer;
    priv rela_rodata: bytes::Buffer;
    priv rela_data: bytes::Buffer;
    priv output: bytes::Buffer;
    priv plan: SavePlan;
    priv error_code: runtime::Error;

    pub init(source: *const object::Object);
    pub fn run();
    pub fn take_result() -> bytes::BufferResult;
    pub deinit();
}

export fn load(bytes: *const u8, length: usize) -> object::Result;
export fn save(object: object::Object const&) -> bytes::BufferResult;
