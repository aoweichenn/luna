export module luna.compiler.x86.assembler;

import luna.compiler.x86.object as object;
import luna.runtime as runtime;
import luna.std.binary as binary;
import luna.std.bytes as bytes;
import luna.std.checked as checked;
import luna.std.map as map;
import luna.std.text as text;

enum RegisterClass: usize {
    general = 0, vector = 1,
}

enum OperandKind: usize {
    none = 0, immediate = 1, register = 2, memory = 3, label = 4,
}

struct Register {
    register_class: RegisterClass;
    code: u8;
    width: usize;
}

struct Memory {
    symbol: text::View;
    displacement: isize;
    base: Register;
    index: Register;
    scale: u8;
    rip_relative: bool;
    has_index: bool;
}

struct Operand {
    kind: OperandKind;
    immediate: u64;
    register: Register;
    memory: Memory;
    label: text::View;
}

struct Operands {
    values: [3]Operand;
    count: usize;
}

enum Limit: usize {
    maximum_source = 67108864, maximum_line = 1048576, maximum_fixups = 1048576, maximum_numeric_labels = 1048576,
}

enum FixupKind: usize {
    branch = 0, call = 1, rip_relative = 2, absolute64 = 3,
}

export struct SymbolBinding {
    name: text::View;
    index: usize;
    materialized: bool;
}

export struct SymbolBindingResult {
    binding: *SymbolBinding;
    error: runtime::Error;
}

export class SymbolName {
    priv name: text::View;

    pub init(name: text::View);
    pub operator <(right: SymbolName) const -> bool;
}

export class SymbolTable {
    priv symbols_by_name: map::map<SymbolName, SymbolBinding>;

    pub init();
    pub fn is_valid() const -> bool;
    pub fn size() const -> usize;
    pub fn find(name: text::View) const -> object::IndexResult;
    pub fn reference(name: text::View) -> SymbolBindingResult;
    pub fn materialize(storage: *object::Object, binding: *SymbolBinding) -> object::IndexResult;
    pub deinit();
}

struct Fixup {
    section: object::Section;
    offset: usize;
    line: usize;
    kind: FixupKind;
    symbol: *SymbolBinding;
    numeric_label: usize;
    numeric_forward: bool;
    is_numeric: bool;
}

struct NumericLabel {
    section: object::Section;
    offset: usize;
    number: usize;
}

struct State {
    object: object::Object;
    symbol_table: *SymbolTable;
    section: object::Section;
    fixups: bytes::Buffer;
    numeric_labels: bytes::Buffer;
    line: usize;
    error: runtime::Error;
}

export struct Result {
    object: object::Object;
    error: runtime::Error;
    line: usize;
}

export fn assemble(assembly: text::View) -> Result;
