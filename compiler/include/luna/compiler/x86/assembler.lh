export module luna.compiler.x86.assembler;

import luna.compiler.x86.object as object;
import luna.runtime as runtime;
import luna.std.binary as binary;
import luna.std.checked as checked;
import luna.std.map as map;
import luna.std.string_view as string_views;
import luna.std.vector as vector;

enum RegisterClass: usize {
    general = 0, vector = 1,
}

enum OperandKind: usize {
    none = 0, immediate = 1, register = 2, memory = 3, label = 4,
}

struct Register {
    register_class: RegisterClass;
    code: u8;
    width: usize;
}

struct Memory {
    symbol: string_views::string_view;
    displacement: isize;
    base: Register;
    index: Register;
    scale: u8;
    rip_relative: bool;
    has_index: bool;
}

struct Operand {
    kind: OperandKind;
    immediate: u64;
    register: Register;
    memory: Memory;
    label: string_views::string_view;
}

struct Operands {
    values: [3]Operand;
    count: usize;
}

enum Limit: usize {
    maximum_source = 67108864, maximum_line = 1048576, maximum_fixups = 1048576, maximum_numeric_labels = 1048576,
}

enum FixupKind: usize {
    branch = 0, call = 1, rip_relative = 2, absolute64 = 3,
}

export struct SymbolBinding {
    name: string_views::string_view;
    index: usize;
    materialized: bool;
}

export struct SymbolBindingResult {
    binding: *SymbolBinding;
    error: runtime::Error;
}

export class SymbolName {
    priv name: string_views::string_view;

    pub init(name: string_views::string_view);
    pub operator <(right: SymbolName) const -> bool;
}

export class SymbolTable {
    priv symbols_by_name: map::map<SymbolName, SymbolBinding>;

    pub init();
    pub fn is_valid() const -> bool;
    pub fn size() const -> usize;
    pub fn find(name: string_views::string_view) const -> object::IndexResult;
    pub fn reference(name: string_views::string_view) -> SymbolBindingResult;
    pub fn materialize(storage: *object::ObjectBuilder, binding: *SymbolBinding) -> object::IndexResult;
    pub deinit();
}

struct Fixup {
    section: object::Section;
    offset: usize;
    line: usize;
    kind: FixupKind;
    symbol: *SymbolBinding;
    numeric_label: usize;
    numeric_forward: bool;
    is_numeric: bool;
}

struct NumericLabel {
    section: object::Section;
    offset: usize;
    number: usize;
}

enum EncodingKind: u8 {
    invalid, fixed, repeat, push, transfer, move, movd, xmm_move, extend, movslq, lea,
    binary_alu, compare, unary, multiply, shift, ldmxcsr, sse_binary, conversion, movabs,
}

enum EncodingLimit: usize {
    rule_count = 87, condition_count = 30,
}

struct EncodingRule {
    name: *const u8;
    name_length: u8;
    kind: EncodingKind;
    width: u8;
    target_width: u8;
    first: u8;
    second: u8;
    count: u8;
    primary: bool;
    secondary: bool;
}

struct ConditionRule {
    name: *const u8;
    name_length: u8;
    code: u8;
}

export struct Result {
    object: object::Object;
    error: runtime::Error;
    line: usize;
}

class Assembler {
    priv storage: object::ObjectBuilder;
    priv symbols: SymbolTable;
    priv fixups: vector::vector<Fixup>;
    priv numeric_labels: vector::vector<NumericLabel>;
    priv encodings: [EncodingLimit.rule_count]EncodingRule;
    priv conditions: [EncodingLimit.condition_count]ConditionRule;
    priv current_section: object::Section;
    priv current_line: usize;
    priv error_code: runtime::Error;

    pub init();
    pub fn run(assembly: string_views::string_view);
    pub fn take_result() -> Result;
    pub deinit();
}

export fn assemble(assembly: string_views::string_view) -> Result;
