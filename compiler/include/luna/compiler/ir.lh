export module luna.compiler.ir;

import luna.compiler.lexer as lexer;
import luna.compiler.types as type_info;
import luna.runtime;
import luna.std.buffer as buffer;
import luna.std.checked as checked;
import luna.std.vector as vector;

export enum Limit: usize {
    maximum_size = 18446744073709551615, maximum_alignment = 8, function_address_bytes = 8,
    maximum_slot_alignment = 4096, maximum_type_depth = 256,
}

export enum Linkage: usize {
    internal, module_export, module_import, external_c,
}

export enum Opcode: usize {
    invalid, constant_integer, constant_float, constant_boolean, constant_null, address_of_slot, member_address,
    global_address, zero_slot, memory_copy, load, store, load_indirect, store_indirect, null_check, bounds_check,
    pointer_offset, unary_integer, unary_float, boolean_not, convert, binary_integer, binary_float, compare, call,
    call_indirect, function_address, jump, branch, return_value, return_void, unreachable, float_sqrt, float_min,
    float_max, overflow_flag, va_list_start, va_list_arg,
}

export struct Global {
    byte_offset: usize;
    byte_count: usize;
    alignment_bytes: usize;
    first_reference: usize;
    reference_count: usize;
    read_only: bool;
}

export enum GlobalReferenceKind: usize {
    function, global,
}

export struct GlobalReference {
    global_id: usize;
    // 相对于所属全局起点的字节偏移；每项固定占用一个机器字。
    byte_offset: usize;
    kind: GlobalReferenceKind;
    target_id: usize;
}

export struct Function {
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    linkage: Linkage;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
    signature_offset: usize;
    signature_length: usize;
    first_slot: usize;
    slot_count: usize;
    first_block: usize;
    block_count: usize;
    first_value: usize;
    value_count: usize;
    has_body: bool;
    // 可变参数函数由 ABI 阶段负责额外实参和寄存器保存区。
    variadic: bool;
    // export_name 与 asm body 均用 no-id 表示不存在。
    export_name_unit: usize;
    export_name_token: usize;
    asm_body_unit: usize;
    asm_body_node: usize;
}

export struct Parameter {
    function_id: usize;
    type_id: usize;
    slot_id: usize;
    // 隐式方法接收者没有源码声明，因此名称可以为 no-id。
    name_token: usize;
}

export struct Slot {
    function_id: usize;
    type_id: usize;
    // 显式 slot 对齐；零表示使用类型的自然对齐。
    alignment_bytes: usize;
    mutable_binding: bool;
    // volatile slot 的每次读写都是不可消除、合并或重排的可观察访问。
    volatile_binding: bool;
}

export struct Value {
    function_id: usize;
    block_id: usize;
    type_id: usize;
    definition: usize;
}

export struct Block {
    function_id: usize;
    first_instruction: usize;
    last_instruction: usize;
    instruction_count: usize;
    predecessor_count: usize;
    terminated: bool;
}

export struct Instruction {
    opcode: Opcode;
    operation: lexer::TokenKind;
    type_id: usize;
    result: usize;
    left: usize;
    right: usize;
    third: usize;
    auxiliary: usize;
    immediate: u64;
    floating: f64;
    block_id: usize;
    next_instruction: usize;
    span: lexer::SourceSpan;
}

export struct Argument {
    instruction_id: usize;
    value_id: usize;
}

export struct View {
    globals: *const Global;
    global_count: usize;
    global_bytes: *const u8;
    global_byte_count: usize;
    global_references: *const GlobalReference;
    global_reference_count: usize;
    functions: *const Function;
    function_count: usize;
    callable_signatures: *const u8;
    callable_signature_count: usize;
    parameters: *const Parameter;
    parameter_count: usize;
    slots: *const Slot;
    slot_count: usize;
    values: *const Value;
    value_count: usize;
    blocks: *const Block;
    block_count: usize;
    instructions: *const Instruction;
    instruction_count: usize;
    arguments: *const Argument;
    argument_count: usize;
    entry_function: usize;
}

export struct FunctionResult {
    function: Function;
    error: runtime::Error;
}

export struct BlockResult {
    block: Block;
    error: runtime::Error;
}

export struct InstructionResult {
    instruction: Instruction;
    error: runtime::Error;
}

export class Module {
    priv globals: vector::vector<Global>;
    priv global_bytes: buffer::byte_buffer;
    priv global_references: vector::vector<GlobalReference>;
    priv functions: vector::vector<Function>;
    priv callable_signatures: buffer::byte_buffer;
    priv parameters: vector::vector<Parameter>;
    priv slots: vector::vector<Slot>;
    priv values: vector::vector<Value>;
    priv blocks: vector::vector<Block>;
    priv instructions: vector::vector<Instruction>;
    priv arguments: vector::vector<Argument>;
    priv entry_function: usize;

    friend class Builder;

    pub init();
    pub init(other: Module&&);
    pub operator =(other: Module&&);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid(types: type_info::TypeTable const&) const -> bool;
    pub fn view() const -> View;
    pub fn function(function_id: usize) const -> FunctionResult;
    pub fn block(block_id: usize) const -> BlockResult;
    pub fn instruction(instruction_id: usize) const -> InstructionResult;
    pub fn global_bytes_data() -> *u8;
    pub fn global_reference_data() -> *GlobalReference;
    pub deinit();
}

export class Builder {
    priv storage: Module;
    priv error_code: runtime::Error;
    priv active: bool;

    pub init();
    pub init(source: Module&&);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid() const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn view() const -> View;
    pub fn block(block_id: usize) const -> BlockResult;
    pub fn add_global(data: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize;
    pub fn add_global_reference(global_id: usize, byte_offset: usize, target_global_id: usize) -> bool;
    pub fn add_global_function_reference(global_id: usize, byte_offset: usize, function_id: usize) -> bool;
    pub fn add_function(function: Function, signature: *const u8, signature_length: usize) -> usize;
    pub fn add_parameter(function_id: usize, type_id: usize, name_token: usize) -> usize;
    pub fn add_slot(
        function_id: usize, type_id: usize, mutable_binding: bool,
        volatile_binding: bool, alignment_bytes: usize) -> usize;
    pub fn add_block(function_id: usize) -> usize;
    pub fn add_value(function_id: usize, block_id: usize, type_id: usize) -> usize;
    pub fn emit(instruction: Instruction) -> usize;
    pub fn add_argument(instruction_id: usize, value_id: usize) -> bool;
    pub fn set_entry(function_id: usize) -> bool;
    pub fn take_module() -> Module;
    pub deinit();
}

export fn no_id() -> usize;
export fn opcode_is_terminator(opcode: Opcode) -> bool;
