export module luna.compiler.syntax;

import luna.compiler.lexer as lexer;
import luna.runtime;
import luna.std.vector as vector;

export enum SyntaxKind: usize {
    invalid, program, module_declaration, import_declaration, structure_declaration, union_declaration,
    enum_declaration, enum_member, type_alias_declaration, field_declaration, function_declaration, parameter,
    type_builtin, type_named, type_pointer, type_array, type_function, block_statement, variable_declaration,
    assignment_statement, expression_statement, if_statement, while_statement, do_statement, for_statement,
    loop_statement, for_initializer, for_condition, for_update, switch_statement, switch_arm, break_statement,
    continue_statement, return_statement, integer_expression, floating_expression, boolean_expression,
    string_expression, null_expression, name_expression, zero_initializer, aggregate_initializer, initializer_field,
    parenthesized_expression, call_expression, index_expression, member_expression, unary_expression, cast_expression,
    binary_expression, conditional_expression, sizeof_expression, alignof_expression, offsetof_expression, attribute,
    assert_statement, intrinsic_expression, named_argument, character_expression, initializer_element,
    const_declaration, labeled_statement, goto_statement, va_start_statement, va_arg_expression,
    selective_import_names, class_declaration, impl_declaration, this_expression, super_expression,
    friend_declaration, type_method_function, constructor_initializer, generic_parameters, generic_parameter,
    generic_arguments, type_generic, generic_expression, type_reference,
}

export enum SyntaxFlag: usize {
    none = 0, exported = 1, external = 2, interface_unit = 4, mutable_binding = 8, bodyless = 16, default_arm = 32,
    read_only = 64, has_return_type = 128, has_arguments = 256, volatile_ = 512, anonymous = 1024, flexible = 2048,
    indexed = 4096, inferred_type = 8192, const_function = 16384, variadic = 32768, asm_function = 65536,
    aliased_import = 131072, selective_import = 262144, public_access = 524288, protected_access = 1048576,
    private_access = 2097152, static_method = 4194304, constructor = 8388608, member_function = 16777216,
    has_base = 33554432, final_class = 67108864, virtual_method = 134217728,
    abstract_method = 268435456, override_method = 536870912, final_method = 1073741824,
    operator_method = 2147483648, opaque_class = 4294967296, rvalue_reference = 8589934592, destructor = 17179869184,
}

export struct SyntaxNode {
    kind: SyntaxKind;
    span: lexer::SourceSpan;
    token_index: usize;
    parent: usize;
    first_child: usize;
    last_child: usize;
    next_sibling: usize;
    child_count: usize;
    flags: usize;
}

export struct SyntaxNodeResult {
    node: SyntaxNode;
    error: runtime::Error;
}

export struct SyntaxIndexResult {
    index: usize;
    error: runtime::Error;
}

export class SyntaxView {
    priv data_pointer: *const SyntaxNode;
    priv node_count: usize;
    priv source_token_count: usize;
    priv root_index: usize;

    pub init(data: *const SyntaxNode, count: usize, token_count: usize, root: usize);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn token_count() const -> usize;
    pub fn root() const -> usize;
    pub fn get(index: usize) const -> SyntaxNodeResult;
}

export class SyntaxTree {
    priv nodes: vector::vector<SyntaxNode>;
    priv source_token_count: usize;
    priv root_index: usize;

    friend class SyntaxBuilder;

    pub init();
    pub init(other: SyntaxTree&&);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn token_count() const -> usize;
    pub fn root() const -> usize;
    pub fn view() const -> SyntaxView;
    pub fn get(index: usize) const -> SyntaxNodeResult;
    pub deinit();
}

export class SyntaxBuilder {
    priv storage: SyntaxTree;
    priv error_code: runtime::Error;

    pub init(token_count: usize);
    pub fn is_valid() const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn size() const -> usize;
    pub fn root() const -> usize;
    pub fn view() const -> SyntaxView;
    pub fn get(index: usize) const -> SyntaxNodeResult;
    pub fn add(kind: SyntaxKind, span: lexer::SourceSpan, token_index: usize) -> SyntaxIndexResult;
    pub fn set_span(index: usize, span: lexer::SourceSpan) -> bool;
    pub fn set_token(index: usize, token_index: usize) -> bool;
    pub fn add_flags(index: usize, flags: usize) -> bool;
    pub fn add_child(parent: usize, child: usize) -> bool;
    pub fn set_root(index: usize) -> bool;
    pub fn mark() const -> usize;
    pub fn restore(mark: usize) -> bool;
    pub fn take_tree() -> SyntaxTree;
    pub deinit();
}

enum SyntaxLimit: usize {
    maximum_size = 18446744073709551615, maximum_nodes = 262144,
}

export fn no_index() -> usize;
export fn maximum_nodes() -> usize;
