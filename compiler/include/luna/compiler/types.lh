export module luna.compiler.types;

import luna.runtime;
import luna.std.vector as vector;

export enum Kind: usize {
    invalid, type_void, boolean, signed_8, signed_16, signed_32, signed_64, signed_size, unsigned_8, unsigned_16,
    unsigned_32, unsigned_64, unsigned_size, float_32, float_64, pointer, array, structure, record_union, enumeration,
    alias, function_pointer, va_list_type, class_type, bound_method, reference,
}

export enum BuiltinType: usize {
    invalid = 0, type_void = 1, boolean = 2, signed_8 = 3, signed_16 = 4, signed_32 = 5, signed_64 = 6, signed_size = 7,
    unsigned_8 = 8, unsigned_16 = 9, unsigned_32 = 10, unsigned_64 = 11, unsigned_size = 12, float_32 = 13,
    float_64 = 14, va_list_type = 15, count = 16,
}

export enum Flag: usize {
    none = 0, read_only = 1, complete = 2, resolving = 4, exported = 8, volatile_pointee = 16, packed = 32,
    flexible = 64, header = 128, opaque_class = 256, opaque_definition = 512, rvalue_reference = 1024,
}

export struct Record {
    kind: Kind;
    element_type: usize;
    element_count: usize;
    // 仅 class_type 可设置单一基类；其他类型恒为 no-id。
    base_type: usize;
    // 仅多态 class_type 使用；它是对象内隐藏 vptr 的确定字节偏移。
    vptr_offset: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    first_field: usize;
    field_count: usize;
    size_bytes: usize;
    alignment_bytes: usize;
    flags: usize;
}

export struct Field {
    owner_type: usize;
    type_id: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    offset_bytes: usize;
    // 显式字段对齐；零表示使用类型的自然对齐。
    alignment_bytes: usize;
}

export struct RecordResult {
    record: Record;
    error: runtime::Error;
}

export struct FieldResult {
    field: Field;
    error: runtime::Error;
}

export struct IdResult {
    type_id: usize;
    error: runtime::Error;
}

export class TypeTable {
    priv records: vector::vector<Record>;
    priv fields: vector::vector<Field>;
    priv error_code: runtime::Error;

    pub init();
    pub init(other: TypeTable&&);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid(require_complete: bool = true) const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn size() const -> usize;
    pub fn field_size() const -> usize;
    pub fn record_data() -> *Record;
    pub fn record_data() const -> *const Record;
    pub fn field_data() -> *Field;
    pub fn field_data() const -> *const Field;
    pub fn record(type_id: usize) const -> RecordResult;
    pub fn field(field_id: usize) const -> FieldResult;
    pub fn add_named(
        kind: Kind, declaration_unit: usize, declaration_node: usize, name_token: usize, exported: bool) -> IdResult;
    pub fn add_opaque_class(
        declaration_unit: usize, declaration_node: usize, name_token: usize, exported: bool) -> IdResult;
    pub fn define_opaque_class(
        type_id: usize, definition_unit: usize, definition_node: usize, name_token: usize) -> runtime::Error;
    pub fn pointer(element_type: usize, read_only: bool = false, volatile_pointee: bool = false) -> IdResult;
    pub fn reference(element_type: usize, read_only: bool = false, rvalue: bool = false) -> IdResult;
    pub fn array(element_type: usize, element_count: usize) -> IdResult;
    pub fn flexible_array(element_type: usize) -> IdResult;
    pub fn add_field(field: Field) -> runtime::Error;
    pub fn add_function_pointer(return_type: usize) -> IdResult;
    pub fn add_bound_method(return_type: usize) -> IdResult;
    pub fn add_parameter(owner_type: usize, parameter_type: usize) -> runtime::Error;
    pub fn set_layout(type_id: usize, size_bytes: usize, alignment_bytes: usize) -> runtime::Error;
    pub fn set_packed(type_id: usize, packed: bool) -> runtime::Error;
    pub fn set_header(type_id: usize, header: bool) -> runtime::Error;
    pub fn set_enum_underlying(type_id: usize, underlying_type: usize) -> runtime::Error;
    pub fn set_alias_target(type_id: usize, target_type: usize) -> runtime::Error;
    pub fn set_base(type_id: usize, base_type: usize) -> runtime::Error;
    pub fn set_vptr(type_id: usize, vptr_offset: usize) -> runtime::Error;
    pub fn set_resolving(type_id: usize, resolving: bool) -> runtime::Error;
    pub deinit();
}

export fn no_id() -> usize;
export fn is_integer(kind: Kind) -> bool;
export fn is_signed_integer(kind: Kind) -> bool;
export fn is_float(kind: Kind) -> bool;
export fn is_named(kind: Kind) -> bool;
export fn is_record(kind: Kind) -> bool;
export fn is_scalar(kind: Kind) -> bool;
export fn is_memory(kind: Kind) -> bool;
export fn is_opaque_class(record: Record) -> bool;
export fn has_opaque_definition(record: Record) -> bool;
export fn bit_width(kind: Kind) -> usize;
