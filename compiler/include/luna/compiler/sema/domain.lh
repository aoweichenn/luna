export module luna.compiler.sema.domain;

import luna.compiler.types as type_info;

export enum CallableKind: usize {
    free_function, static_method, instance_method, constructor, operator_method, destructor,
}

export enum ReceiverKind: usize {
    none, writable, read_only, writable_volatile, read_only_volatile,
}

export struct CallableIdentity {
    kind: CallableKind;
    owner_type: usize;
    receiver: ReceiverKind;
}

export enum ValueCategory: usize {
    rvalue, temporary, read_only_lvalue, writable_lvalue, volatile_lvalue, writable_volatile_lvalue,
    read_only_bitfield, writable_bitfield, volatile_bitfield, writable_volatile_bitfield, temporary_bitfield,
    xvalue, read_only_xvalue,
}

export enum ReferenceRank: usize {
    exact = 0, qualified = 1, temporary = 2,
}

export enum ClassAccess: usize {
    invalid, public_access, protected_access, private_access,
}

export enum MethodDispatch: usize {
    invalid, static_method, direct, virtual_method, abstract_method,
}

export enum ClassFlag: usize {
    none = 0, exported = 1, final_class = 2, abstract_class = 4, polymorphic = 8, rtti = 16,
}

export enum MethodFlag: usize {
    none = 0, final_method = 1,
}

export enum ClassLayout: usize {
    vptr_size_bytes = 8, vptr_alignment_bytes = 8,
}

export enum CallDispatch: usize {
    direct, virtual_call,
}

export struct DispatchPlan {
    kind: CallDispatch;
    vptr_offset: usize;
    virtual_slot: usize;
}

export struct ClassRecord {
    type_id: usize;
    first_field: usize;
    field_count: usize;
    first_method: usize;
    method_count: usize;
    first_friend: usize;
    friend_count: usize;
    descriptor_global: usize;
    vtable_global: usize;
    flags: usize;
}

export struct ClassField {
    field_id: usize;
    access: ClassAccess;
}

export struct ClassMethod {
    function_id: usize;
    access: ClassAccess;
    dispatch: MethodDispatch;
    // 槽位是层次内的稳定调用身份；具体类据此生成最终覆写者表。
    virtual_slot: usize;
    flags: usize;
}

export struct ClassFriend {
    owner_type: usize;
    friend_type: usize;
}

export enum GenericDeclarationKind: usize {
    invalid, type_declaration, function_declaration,
}

export enum GenericInstanceState: usize {
    requested, resolving, complete, failed,
}

export struct GenericDeclaration {
    kind: GenericDeclarationKind;
    module_id: usize;
    unit_index: usize;
    node_index: usize;
    name_token: usize;
    first_parameter: usize;
    parameter_count: usize;
    binding_id: usize;
    flags: usize;
}

export struct GenericParameter {
    declaration_id: usize;
    unit_index: usize;
    node_index: usize;
    name_token: usize;
    position: usize;
}

export struct GenericInstance {
    declaration_id: usize;
    owner_type: usize;
    first_argument: usize;
    argument_count: usize;
    type_id: usize;
    function_id: usize;
    expansion_depth: usize;
    state: GenericInstanceState;
}

export struct GenericActiveBinding {
    unit_index: usize;
    name_token: usize;
    type_id: usize;
}

export fn no_owner() -> usize;
export fn free_function() -> CallableIdentity;
export fn has_owner(identity: CallableIdentity) -> bool;
export fn has_receiver(identity: CallableIdentity) -> bool;
export fn callable_is_valid(identity: CallableIdentity, type_count: usize) -> bool;
export fn same_owner(left: CallableIdentity, right: CallableIdentity) -> bool;
export fn same_identity(left: CallableIdentity, right: CallableIdentity) -> bool;

export fn lvalue(writable: bool, volatile_access: bool) -> ValueCategory;
export fn xvalue(read_only: bool) -> ValueCategory;
export fn pointee(pointer: type_info::Record) -> ValueCategory;
export fn project(source: ValueCategory) -> ValueCategory;
export fn as_bitfield(source: ValueCategory) -> ValueCategory;
export fn is_lvalue(category: ValueCategory) -> bool;
export fn is_xvalue(category: ValueCategory) -> bool;
export fn is_expiring(category: ValueCategory) -> bool;
export fn has_storage(category: ValueCategory) -> bool;
export fn is_addressable(category: ValueCategory) -> bool;
export fn is_assignable(category: ValueCategory) -> bool;
export fn is_writable(category: ValueCategory) -> bool;
export fn is_volatile(category: ValueCategory) -> bool;
export fn is_temporary(category: ValueCategory) -> bool;
export fn reference_binding_rank(reference: type_info::Record, actual: ValueCategory) -> usize;
