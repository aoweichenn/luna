export module luna.compiler.sema.callables;

import luna.compiler.sema.domain as domain;
import luna.runtime;
import luna.std.buffer as buffer;
import luna.std.vector as vector;

export fn no_id() -> usize;

export struct IndexResult {
    index: usize;
    error: runtime::Error;
}

// 当前导出类 ABI 要求私有索引元素可见；该记录不属于 CallableTable 的公共领域模型。
export struct IndexEntry {
    value: usize;
}

export class CallableTable {
    priv functions: vector::vector<domain::Function>;
    priv parameters: vector::vector<domain::Parameter>;
    priv bindings: vector::vector<domain::Binding>;
    priv candidates: vector::vector<IndexEntry>;
    priv generic_candidates: vector::vector<IndexEntry>;
    priv signatures: buffer::byte_buffer;
    priv error_code: runtime::Error;
    priv order_is_published: bool;

    pub init();
    pub init(other: CallableTable&&);
    pub fn storage_is_valid() const -> bool;
    pub fn is_valid(generic_declaration_count: usize) const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn function_count() const -> usize;
    pub fn parameter_count() const -> usize;
    pub fn binding_count() const -> usize;
    pub fn candidate_count() const -> usize;
    pub fn generic_candidate_count() const -> usize;
    pub fn signature_size() const -> usize;
    pub fn function_data() const -> *const domain::Function;
    pub fn parameter_data() const -> *const domain::Parameter;
    pub fn binding_data() const -> *const domain::Binding;
    pub fn candidate_data() const -> *const usize;
    pub fn generic_candidate_data() const -> *const usize;
    pub fn signature_data() const -> *const u8;
    pub fn append_function(record: domain::Function) -> IndexResult;
    pub fn append_parameter(function_id: usize, record: domain::Parameter) -> IndexResult;
    pub fn append_signature(function_id: usize, data: *const u8, length: usize) -> runtime::Error;
    pub fn set_required_parameter_count(function_id: usize, count: usize) -> runtime::Error;
    pub fn set_return_type(function_id: usize, type_id: usize) -> runtime::Error;
    pub fn attach_definition(
        function_id: usize, unit_index: usize, node_index: usize, additional_flags: usize) -> runtime::Error;
    pub fn add_function_flags(function_id: usize, flags: usize) -> runtime::Error;
    pub fn remove_function_flags(function_id: usize, flags: usize) -> runtime::Error;
    pub fn set_function_binding(function_id: usize, binding_id: usize) -> runtime::Error;
    pub fn set_ir_function(function_id: usize, ir_function: usize) -> runtime::Error;
    pub fn publish_function_order(data: *const usize, count: usize) -> runtime::Error;
    pub fn append_ordered_function(function_id: usize) -> IndexResult;
    pub fn append_binding(record: domain::Binding) -> IndexResult;
    pub fn extend_binding(binding_id: usize) -> runtime::Error;
    pub fn append_generic_candidate(binding_id: usize, declaration_id: usize) -> runtime::Error;
    pub deinit();
}
