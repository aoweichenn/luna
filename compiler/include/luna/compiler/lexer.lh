export module luna.compiler.lexer;

import luna.runtime;
import luna.std.string_view as string_views;
import luna.std.vector as vector;

export enum TokenKind: usize {
    invalid, end,

    identifier, integer, floating, character, string, string_u16, string_u32,

    keyword_import, keyword_module, keyword_export, keyword_extern, keyword_const, keyword_let, keyword_var, keyword_fn,
    keyword_struct, keyword_union, keyword_enum, keyword_if, keyword_else, keyword_switch, keyword_case,
    keyword_default, keyword_while, keyword_do, keyword_for, keyword_loop, keyword_break, keyword_continue,
    keyword_return, keyword_as, keyword_sizeof, keyword_alignof, keyword_offsetof, keyword_true, keyword_false,
    keyword_null,

    keyword_bool, keyword_i8, keyword_i16, keyword_i32, keyword_i64, keyword_u8, keyword_u16, keyword_u32, keyword_u64,
    keyword_isize, keyword_usize, keyword_f32, keyword_f64, keyword_void,

    left_parenthesis, right_parenthesis, left_brace, right_brace, left_bracket, right_bracket, comma, dot, semicolon,
    colon, question,

    plus, minus, star, slash, percent, ampersand, pipe, caret, tilde, bang, equal, less, greater,

    arrow, plus_equal, minus_equal, star_equal, slash_equal, percent_equal, ampersand_equal, pipe_equal, caret_equal,
    shift_left, shift_right, shift_left_equal, shift_right_equal, equal_equal, bang_equal, less_equal, greater_equal,
    logical_and, logical_or, at_sign, keyword_assert, keyword_volatile, keyword_goto, dot_dot_dot,
    keyword_va_list, keyword_va_start, keyword_va_arg, keyword_asm, colon_colon, keyword_class,
    keyword_pub, keyword_prot, keyword_priv, keyword_static, keyword_impl, keyword_this,
    keyword_final, keyword_virtual, keyword_abstract, keyword_override, keyword_super,
    keyword_operator, keyword_method, keyword_friend, keyword_opaque,
}

export enum DiagnosticKind: usize {
    unexpected_character, unterminated_block_comment, unterminated_string, unterminated_character, expected_token,
    expected_type, expected_expression, expected_declaration, invalid_integer, invalid_floating,
    invalid_external_declaration, invalid_switch_arm, nesting_limit, resource_limit,
}

export struct SourceSpan {
    offset: usize;
    length: usize;
    line: usize;
    column: usize;
}

export struct Token {
    kind: TokenKind;
    span: SourceSpan;
}

export struct Diagnostic {
    kind: DiagnosticKind;
    span: SourceSpan;
    expected: TokenKind;
    found: TokenKind;
    detail: usize;
}

export struct TokenResult {
    token: Token;
    error: runtime::Error;
}

export struct DiagnosticResult {
    diagnostic: Diagnostic;
    error: runtime::Error;
}

export class TokenView {
    priv data_pointer: *const Token;
    priv element_count: usize;

    pub init(data: *const Token, count: usize);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn get(index: usize) const -> TokenResult;
}

export class DiagnosticView {
    priv data_pointer: *const Diagnostic;
    priv element_count: usize;

    pub init(data: *const Diagnostic, count: usize);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn get(index: usize) const -> DiagnosticResult;
}

export class DiagnosticBuffer {
    priv values: vector::vector<Diagnostic>;

    friend class Lexer;

    pub init();
    pub init(other: DiagnosticBuffer&&);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn add(diagnostic: Diagnostic) -> runtime::Error;
    pub fn truncate(count: usize) -> runtime::Error;
    pub fn view() const -> DiagnosticView;
    pub deinit();
}

export struct LexView {
    tokens: TokenView;
    diagnostics: DiagnosticView;
    error: runtime::Error;
}

export class LexResult {
    priv token_storage: vector::vector<Token>;
    priv diagnostic_storage: DiagnosticBuffer;
    priv error_code: runtime::Error;

    friend class Lexer;

    pub init();
    pub init(other: LexResult&&);
    pub fn is_valid() const -> bool;
    pub fn tokens() const -> TokenView;
    pub fn diagnostics() const -> DiagnosticView;
    pub fn view() const -> LexView;
    pub fn error() const -> runtime::Error;
    pub deinit();
}

struct KeywordEntry {
    text: *const u8;
    length: usize;
    kind: TokenKind;
}

enum Ascii: u8 {
    double_quote = 34, single_quote = 39, percent = 37, ampersand = 38,
    left_parenthesis = 40, right_parenthesis = 41, star = 42, plus = 43,
    comma = 44, minus = 45, dot = 46, slash = 47, colon = 58, semicolon = 59,
    less = 60, equal = 61, greater = 62, question = 63, at_sign = 64,
    upper_b = 66, upper_o = 79, upper_x = 88, left_bracket = 91,
    right_bracket = 93, caret = 94, lower_b = 98, left_brace = 123,
    pipe = 124, right_brace = 125, tilde = 126, lower_o = 111, lower_x = 120, bang = 33,
}

enum LexerLimit: usize {
    maximum_size = 18446744073709551615, maximum_tokens = 131072, maximum_diagnostics = 4096,
    maximum_token_length = 65536, keyword_count = 67,
}

class KeywordTable {
    priv entries: [LexerLimit.keyword_count]KeywordEntry;

    pub init();
    pub fn lookup(source: string_views::string_view, start: usize, length: usize) const -> TokenKind;
}

class Lexer {
    priv source: string_views::string_view;
    priv offset: usize;
    priv line: usize;
    priv column: usize;
    priv keywords: KeywordTable;
    priv result: LexResult;

    pub init(source: string_views::string_view);
    pub fn run();
    pub fn take_result() -> LexResult;
    pub deinit();
}

export fn lex(source: string_views::string_view) -> LexResult;
