module luna.bootstrap.middleend.type;

enum Limit: usize {
    maximum_size = 18446744073709551615, target_pointer_bytes = 8, target_pointer_alignment = 8,
    bound_method_bytes = 16, maximum_alignment = 4096,
}

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn invalid_record() -> Record {
    let none: usize = no_id();
    return {
        kind = Kind.invalid, element_type = none, element_count = 0, base_type = none, vptr_offset = none,
        declaration_unit = none, declaration_node = none, name_token = none, first_field = none, field_count = 0,
            size_bytes = 0, alignment_bytes = 0, flags = Flag.none as usize,
    };
}

fn invalid_field() -> Field {
    let none: usize = no_id();
    return {
        owner_type = none, type_id = none, declaration_unit = none, declaration_node = none, name_token = none,
        offset_bytes = 0, alignment_bytes = 0,
    };
}

fn table_empty() -> Table {
    return {
        types = bytes::empty(), type_count = 0, fields = bytes::empty(), field_count = 0,
    };
}

fn table_storage_is_valid(table: Table) -> bool {
    let buffers_are_valid: bool = bytes::is_valid(table.types) && bytes::is_valid(table.fields);
    let lengths_are_aligned: bool =
        table.types.length % sizeof(Record) == 0 && table.fields.length % sizeof(Field) == 0;
    let counts_match: bool = table.type_count == table.types.length / sizeof(Record) &&
        table.field_count == table.fields.length / sizeof(Field);
    let storage_is_valid: bool = buffers_are_valid && lengths_are_aligned;
    return storage_is_valid && counts_match;
}

fn table_get(table: Table, type_id: usize) -> RecordResult {
    if (!table_storage_is_valid(table) || type_id >= table.type_count) {
        return {
            record = invalid_record(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const Record = table.types.data as *const Record;
    return {
        record = records[type_id], error = runtime::Error.none,
    };
}

fn table_get_field(table: Table, field_id: usize) -> FieldResult {
    if (!table_storage_is_valid(table) || field_id >= table.field_count) {
        return {
            field = invalid_field(), error = runtime::Error.invalid_argument,
        };
    }
    let fields: *const Field = table.fields.data as *const Field;
    return {
        field = fields[field_id], error = runtime::Error.none,
    };
}

fn append_record(table: Table, record: Record) -> TableResult {
    if (!table_storage_is_valid(table) || table.type_count == (Limit.maximum_size as usize)) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let appended: bytes::BufferResult = bytes::append(
        table.types, (&record) as *const Record as *const u8, sizeof(Record));
    var result: Table = table;
    result.types = appended.buffer;
    if (appended.error == runtime::Error.none) {
        result.type_count += 1;
    }
    return {
        table = result, error = appended.error,
    };
}

fn builtin_record(kind: Kind, size_bytes: usize, alignment_bytes: usize) -> Record {
    var record: Record = invalid_record();
    record.kind = kind;
    record.size_bytes = size_bytes;
    record.alignment_bytes = alignment_bytes;
    record.flags = Flag.complete as usize;
    return record;
}

fn builtin_kind(index: usize) -> Kind {
    if (index == BuiltinType.type_void as usize) {
        return Kind.type_void;
    }
    if (index == BuiltinType.boolean as usize) {
        return Kind.boolean;
    }
    if (index == BuiltinType.signed_8 as usize) {
        return Kind.signed_8;
    }
    if (index == BuiltinType.signed_16 as usize) {
        return Kind.signed_16;
    }
    if (index == BuiltinType.signed_32 as usize) {
        return Kind.signed_32;
    }
    if (index == BuiltinType.signed_64 as usize) {
        return Kind.signed_64;
    }
    if (index == BuiltinType.signed_size as usize) {
        return Kind.signed_size;
    }
    if (index == BuiltinType.unsigned_8 as usize) {
        return Kind.unsigned_8;
    }
    if (index == BuiltinType.unsigned_16 as usize) {
        return Kind.unsigned_16;
    }
    if (index == BuiltinType.unsigned_32 as usize) {
        return Kind.unsigned_32;
    }
    if (index == BuiltinType.unsigned_64 as usize) {
        return Kind.unsigned_64;
    }
    if (index == BuiltinType.unsigned_size as usize) {
        return Kind.unsigned_size;
    }
    if (index == BuiltinType.float_32 as usize) {
        return Kind.float_32;
    }
    if (index == BuiltinType.float_64 as usize) {
        return Kind.float_64;
    }
    if (index == BuiltinType.va_list_type as usize) {
        return Kind.va_list_type;
    }
    return Kind.invalid;
}

fn builtin_size(index: usize) -> usize {
    if (index == BuiltinType.type_void as usize || index == BuiltinType.invalid as usize) {
        return 0;
    }
    // The System V va_list object: u32 gp_offset, u32 fp_offset, then the
    // overflow_arg_area and reg_save_area pointers.
    if (index == BuiltinType.va_list_type as usize) {
        return 24;
    }
    return bit_width(builtin_kind(index)) / 8;
}

fn builtin_alignment(index: usize) -> usize {
    if (index == BuiltinType.va_list_type as usize) {
        return 8;
    }
    return builtin_size(index);
}

fn table_create() -> TableResult {
    var table: Table = table_empty();
    for (var index: usize = 0; index < BuiltinType.count as usize; index += 1) {
        let size_bytes: usize = builtin_size(index);
        let added: TableResult =
            append_record(table, builtin_record(builtin_kind(index), size_bytes, builtin_alignment(index)));
        table = added.table;
        if (added.error != runtime::Error.none) {
            table_release(table);
            return {
                table = table_empty(), error = added.error,
            };
        }
    }
    return {
        table = table, error = runtime::Error.none,
    };
}

fn is_named(kind: Kind) -> bool {
    switch (kind) {
    case Kind.structure, Kind.record_union, Kind.enumeration, Kind.class_type {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_record(kind: Kind) -> bool {
    switch (kind) {
    case Kind.structure, Kind.record_union, Kind.class_type {
        return true;
    }
    default {
        return false;
    }
    }
}

fn kind_is_declared(kind: Kind) -> bool {
    return is_named(kind) || kind == Kind.alias;
}

fn table_add_named(
    table: Table, kind: Kind, declaration_unit: usize, declaration_node: usize,
    name_token: usize, exported: bool) -> TableResult {
    let declaration_exists: bool = declaration_unit != no_id() && declaration_node != no_id();
    let declaration_is_valid: bool = declaration_exists && name_token != no_id();
    if (!kind_is_declared(kind) || !declaration_is_valid) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    var record: Record = invalid_record();
    record.kind = kind;
    record.declaration_unit = declaration_unit;
    record.declaration_node = declaration_node;
    record.name_token = name_token;
    if (exported) {
        record.flags = Flag.exported as usize;
    }
    return append_record(table, record);
}

fn table_add_opaque_class(
    table: Table, declaration_unit: usize, declaration_node: usize, name_token: usize, exported: bool) -> TableResult {
    let added: TableResult = table_add_named(
        table, Kind.class_type, declaration_unit, declaration_node, name_token, exported);
    if (added.error != runtime::Error.none) {
        return added;
    }
    var result: Table = added.table;
    let records: *Record = result.types.data as *Record;
    records[result.type_count - 1].flags |= Flag.opaque_class as usize;
    return {table = result, error = runtime::Error.none};
}

fn table_define_opaque_class(
    table: Table, type_id: usize, definition_unit: usize, definition_node: usize, name_token: usize) -> runtime::Error {
    if (!table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let none: usize = no_id();
    let definition_exists: bool = definition_unit != none && definition_node != none;
    if (!definition_exists || name_token == none) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    let record: Record = records[type_id];
    let opaque_class: bool = is_opaque_class(record);
    let definition_is_missing: bool = !has_opaque_definition(record);
    let incomplete: bool = (record.flags & (Flag.complete as usize)) == 0;
    if (!opaque_class || !definition_is_missing) {
        return runtime::Error.invalid_argument;
    }
    if (!incomplete || (record.flags & (Flag.resolving as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].declaration_unit = definition_unit;
    records[type_id].declaration_node = definition_node;
    records[type_id].name_token = name_token;
    records[type_id].flags |= Flag.opaque_definition as usize;
    return runtime::Error.none;
}

fn table_pointer(table: *Table, element_type: usize, read_only: bool, volatile_pointee: bool) -> IdResult {
    let table_is_available: bool = table != null && table_storage_is_valid(*table);
    if (!table_is_available || element_type >= table->type_count) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const Record = table->types.data as *const Record;
    if (records[element_type].kind == Kind.invalid) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    for (var index: usize = BuiltinType.count as usize; index < table->type_count; index += 1) {
        let record: Record = records[index];
        let record_read_only: bool = (record.flags & (Flag.read_only as usize)) != 0;
        let record_volatile: bool = (record.flags & (Flag.volatile_pointee as usize)) != 0;
        let identity_matches: bool = record.kind == Kind.pointer && record.element_type == element_type;
        let qualifiers_match: bool = record_read_only == read_only && record_volatile == volatile_pointee;
        if (identity_matches && qualifiers_match) {
            return {
                type_id = index, error = runtime::Error.none,
            };
        }
    }

    var record: Record = invalid_record();
    record.kind = Kind.pointer;
    record.element_type = element_type;
    record.size_bytes = Limit.target_pointer_bytes as usize;
    record.alignment_bytes = Limit.target_pointer_alignment as usize;
    record.flags = Flag.complete as usize;
    if (read_only) {
        record.flags |= Flag.read_only as usize;
    }
    if (volatile_pointee) {
        record.flags |= Flag.volatile_pointee as usize;
    }
    let type_id: usize = table->type_count;
    let added: TableResult = append_record(*table, record);
    *table = added.table;
    return {
        type_id = added.error == runtime::Error.none ? type_id : no_id(), error = added.error,
    };
}

fn table_reference(table: *Table, element_type: usize, read_only: bool, rvalue: bool) -> IdResult {
    let table_is_available: bool = table != null && table_storage_is_valid(*table);
    if (!table_is_available || element_type >= table->type_count) {
        return {type_id = no_id(), error = runtime::Error.invalid_argument};
    }
    let records: *const Record = table->types.data as *const Record;
    var target_type: usize = element_type;
    var target_read_only: bool = read_only;
    var target_rvalue: bool = rvalue;
    if (records[target_type].kind == Kind.reference) {
        target_read_only = target_read_only || (records[target_type].flags & (Flag.read_only as usize)) != 0;
        target_rvalue = target_rvalue && (records[target_type].flags & (Flag.rvalue_reference as usize)) != 0;
        target_type = records[target_type].element_type;
    }
    if (records[target_type].kind == Kind.invalid || records[target_type].kind == Kind.type_void) {
        return {type_id = no_id(), error = runtime::Error.invalid_argument};
    }
    for (var index: usize = BuiltinType.count as usize; index < table->type_count; index += 1) {
        let record: Record = records[index];
        let record_read_only: bool = (record.flags & (Flag.read_only as usize)) != 0;
        let record_rvalue: bool = (record.flags & (Flag.rvalue_reference as usize)) != 0;
        let identity_matches: bool = record.kind == Kind.reference && record.element_type == target_type;
        let qualifiers_match: bool = record_read_only == target_read_only && record_rvalue == target_rvalue;
        if (identity_matches && qualifiers_match) {
            return {type_id = index, error = runtime::Error.none};
        }
    }
    var record: Record = invalid_record();
    record.kind = Kind.reference;
    record.element_type = target_type;
    record.size_bytes = Limit.target_pointer_bytes as usize;
    record.alignment_bytes = Limit.target_pointer_alignment as usize;
    record.flags = Flag.complete as usize;
    if (target_read_only) {
        record.flags |= Flag.read_only as usize;
    }
    if (target_rvalue) {
        record.flags |= Flag.rvalue_reference as usize;
    }
    let type_id: usize = table->type_count;
    let added: TableResult = append_record(*table, record);
    *table = added.table;
    return {type_id = added.error == runtime::Error.none ? type_id : no_id(), error = added.error};
}

fn table_array(table: *Table, element_type: usize, element_count: usize) -> IdResult {
    let table_is_available: bool = table != null && table_storage_is_valid(*table);
    let request_is_valid: bool = table_is_available && element_type < table->type_count;
    if (!request_is_valid || element_count == 0) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const Record = table->types.data as *const Record;
    let element: Record = records[element_type];
    if (!fixed_array_element_is_valid(*table, records, element_type)) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    if (element_count > (Limit.maximum_size as usize) / element.size_bytes) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    for (var index: usize = BuiltinType.count as usize; index < table->type_count; index += 1) {
        let record: Record = records[index];
        let identity_matches: bool = record.kind == Kind.array && record.element_type == element_type;
        if (identity_matches && record.element_count == element_count) {
            return {
                type_id = index, error = runtime::Error.none,
            };
        }
    }

    var record: Record = invalid_record();
    record.kind = Kind.array;
    record.element_type = element_type;
    record.element_count = element_count;
    record.size_bytes = element.size_bytes * element_count;
    record.alignment_bytes = element.alignment_bytes;
    record.flags = Flag.complete as usize;
    let type_id: usize = table->type_count;
    let added: TableResult = append_record(*table, record);
    *table = added.table;
    return {
        type_id = added.error == runtime::Error.none ? type_id : no_id(), error = added.error,
    };
}

fn table_flexible_array(table: *Table, element_type: usize) -> IdResult {
    let table_is_available: bool = table != null && table_storage_is_valid(*table);
    if (!table_is_available || element_type >= table->type_count) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const Record = table->types.data as *const Record;
    let element: Record = records[element_type];
    if (!flexible_array_element_is_valid(*table, records, element_type)) {
        return {
            type_id = no_id(), error = runtime::Error.invalid_argument,
        };
    }
    for (var index: usize = BuiltinType.count as usize; index < table->type_count; index += 1) {
        let record: Record = records[index];
        let identity_matches: bool = record.kind == Kind.array && record.element_type == element_type;
        if (identity_matches && record.element_count == 0) {
            return {
                type_id = index, error = runtime::Error.none,
            };
        }
    }

    var record: Record = invalid_record();
    record.kind = Kind.array;
    record.element_type = element_type;
    record.element_count = 0;
    record.size_bytes = 0;
    record.alignment_bytes = element.alignment_bytes;
    record.flags = (Flag.complete as usize) | (Flag.flexible as usize);
    let type_id: usize = table->type_count;
    let added: TableResult = append_record(*table, record);
    *table = added.table;
    return {
        type_id = added.error == runtime::Error.none ? type_id : no_id(), error = added.error,
    };
}

fn field_slice_is_appendable(owner: Record, next_field: usize) -> bool {
    if (owner.field_count == 0) {
        return owner.first_field == no_id();
    }
    return owner.first_field <= next_field && owner.field_count == next_field - owner.first_field;
}

fn table_add_field(table: Table, field: Field) -> TableResult {
    let owner_is_valid: bool = table_storage_is_valid(table) && field.owner_type < table.type_count;
    let declaration_is_valid: bool = field.declaration_unit != no_id() && field.declaration_node != no_id();
    let field_is_valid: bool = field.type_id < table.type_count && field.name_token != no_id();
    let alignment_is_bounded: bool = field.alignment_bytes <= (Limit.maximum_alignment as usize);
    let no_alignment_override: bool = field.alignment_bytes == 0;
    let nonzero_power_of_two: bool = field.alignment_bytes != 0 &&
        (field.alignment_bytes & (field.alignment_bytes - 1)) == 0;
    let alignment_is_power: bool = no_alignment_override || nonzero_power_of_two;
    let identity_is_valid: bool = declaration_is_valid && field_is_valid;
    let alignment_is_valid: bool = alignment_is_bounded && alignment_is_power;
    let input_is_valid: bool = owner_is_valid && identity_is_valid;
    if (!input_is_valid || !alignment_is_valid) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let records: *Record = table.types.data as *Record;
    let owner: Record = records[field.owner_type];
    let owner_is_open: bool = is_named(owner.kind) && (owner.flags & (Flag.complete as usize)) == 0;
    if (!owner_is_open || !field_slice_is_appendable(owner, table.field_count)) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }

    let appended: bytes::BufferResult = bytes::append(
        table.fields, (&field) as *const Field as *const u8, sizeof(Field));
    var result: Table = table;
    result.fields = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return {
            table = result, error = appended.error,
        };
    }
    let result_records: *Record = result.types.data as *Record;
    if (result_records[field.owner_type].field_count == 0) {
        result_records[field.owner_type].first_field = result.field_count;
    }
    result_records[field.owner_type].field_count += 1;
    result.field_count += 1;
    return {
        table = result, error = runtime::Error.none,
    };
}

fn table_add_callable_value(table: Table, kind: Kind, return_type: usize, size_bytes: usize) -> TableResult {
    if (!table_storage_is_valid(table) || return_type >= table.type_count) {
        return {table = table, error = runtime::Error.invalid_argument};
    }
    if (kind != Kind.function_pointer && kind != Kind.bound_method) {
        return {table = table, error = runtime::Error.invalid_argument};
    }
    let records: *const Record = table.types.data as *const Record;
    let result: Record = records[return_type];
    let result_kind_is_valid: bool = result.kind != Kind.invalid && result.kind != Kind.alias;
    let result_shape_is_valid: bool = result.kind != Kind.array && (result.flags & (Flag.complete as usize)) != 0;
    if (!result_kind_is_valid || !result_shape_is_valid) {
        return {table = table, error = runtime::Error.invalid_argument};
    }
    var record: Record = invalid_record();
    record.kind = kind;
    record.element_type = return_type;
    record.size_bytes = size_bytes;
    record.alignment_bytes = Limit.target_pointer_alignment as usize;
    return append_record(table, record);
}

fn table_add_function_pointer(table: Table, return_type: usize) -> TableResult {
    return table_add_callable_value(table, Kind.function_pointer, return_type, Limit.target_pointer_bytes as usize);
}

fn table_add_bound_method(table: Table, return_type: usize) -> TableResult {
    return table_add_callable_value(table, Kind.bound_method, return_type, Limit.bound_method_bytes as usize);
}

fn callable_owner_is_appendable(owner: Record, next_field: usize) -> bool {
    let callable: bool = owner.kind == Kind.function_pointer || owner.kind == Kind.bound_method;
    let incomplete: bool = (owner.flags & (Flag.complete as usize)) == 0;
    if (!callable || !incomplete) {
        return false;
    }
    if (owner.field_count == 0) {
        return owner.first_field == no_id();
    }
    return owner.first_field + owner.field_count == next_field;
}

fn callable_parameter_is_valid(parameter: Record) -> bool {
    switch (parameter.kind) {
    case Kind.invalid, Kind.type_void, Kind.alias, Kind.array {
        return false;
    }
    default {}
    }
    let complete: bool = (parameter.flags & (Flag.complete as usize)) != 0;
    return complete && parameter.size_bytes != 0;
}

fn table_add_parameter(table: Table, owner_type: usize, parameter_type: usize) -> TableResult {
    if (!table_storage_is_valid(table) || owner_type >= table.type_count) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    if (parameter_type >= table.type_count) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let records: *Record = table.types.data as *Record;
    let owner: Record = records[owner_type];
    let parameter: Record = records[parameter_type];
    let owner_is_valid: bool = callable_owner_is_appendable(owner, table.field_count);
    let parameter_is_valid: bool = callable_parameter_is_valid(parameter);
    if (!owner_is_valid || !parameter_is_valid) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    if (owner.field_count == Limit.maximum_size as usize) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }

    var field: Field = invalid_field();
    field.owner_type = owner_type;
    field.type_id = parameter_type;
    field.offset_bytes = 0;
    let appended: bytes::BufferResult =
        bytes::append(table.fields, (&field) as *const Field as *const u8, sizeof(Field));
    var result: Table = table;
    result.fields = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return {
            table = result, error = appended.error,
        };
    }
    let result_records: *Record = result.types.data as *Record;
    if (result_records[owner_type].field_count == 0) {
        result_records[owner_type].first_field = result.field_count;
    }
    result_records[owner_type].field_count += 1;
    result.field_count += 1;
    return {
        table = result, error = runtime::Error.none,
    };
}

fn layout_parameters_are_valid(record: Record, size_bytes: usize, alignment_bytes: usize) -> bool {
    let callable: bool = record.kind == Kind.function_pointer || record.kind == Kind.bound_method;
    let declared: bool = kind_is_declared(record.kind) || callable;
    let incomplete: bool = (record.flags & (Flag.complete as usize)) == 0;
    if (!declared || !incomplete) {
        return false;
    }
    if (size_bytes == 0 || alignment_bytes == 0) {
        return false;
    }
    let alignment_is_bounded: bool = alignment_bytes <= Limit.maximum_alignment as usize;
    let alignment_is_power_of_two: bool = (alignment_bytes & (alignment_bytes - 1)) == 0;
    let alignment_is_valid: bool = alignment_is_bounded && alignment_is_power_of_two;
    return alignment_is_valid && size_bytes % alignment_bytes == 0;
}

fn table_set_layout(table: Table, type_id: usize, size_bytes: usize, alignment_bytes: usize) -> runtime::Error {
    if (!table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    if (!layout_parameters_are_valid(
            records[type_id], size_bytes, alignment_bytes)) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].size_bytes = size_bytes;
    records[type_id].alignment_bytes = alignment_bytes;
    records[type_id].flags &= ~(Flag.resolving as usize);
    records[type_id].flags |= Flag.complete as usize;
    return runtime::Error.none;
}

fn table_set_packed(table: Table, type_id: usize, packed: bool) -> runtime::Error {
    if (!table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    if (records[type_id].kind != Kind.structure || (records[type_id].flags & (Flag.complete as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    if (packed) {
        records[type_id].flags |= Flag.packed as usize;
    } else {
        records[type_id].flags &= ~(Flag.packed as usize);
    }
    return runtime::Error.none;
}

fn table_set_header(table: Table, type_id: usize, header: bool) -> runtime::Error {
    if (!table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    if (records[type_id].kind != Kind.structure || (records[type_id].flags & (Flag.complete as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    if (header) {
        records[type_id].flags |= Flag.header as usize;
    } else {
        records[type_id].flags &= ~(Flag.header as usize);
    }
    return runtime::Error.none;
}

fn table_set_enum_underlying(table: Table, type_id: usize, underlying_type: usize) -> runtime::Error {
    let types_are_in_range: bool = type_id < table.type_count && underlying_type < table.type_count;
    if (!table_storage_is_valid(table) || !types_are_in_range) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    let kinds_are_valid: bool = records[type_id].kind == Kind.enumeration && is_integer(records[underlying_type].kind);
    if (!kinds_are_valid || records[type_id].element_type != no_id()) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].element_type = underlying_type;
    return runtime::Error.none;
}

fn table_set_alias_target(table: Table, type_id: usize, target_type: usize) -> runtime::Error {
    let types_are_in_range: bool = type_id < table.type_count && target_type < table.type_count;
    if (!table_storage_is_valid(table) || !types_are_in_range) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    let alias_is_incomplete: bool = (records[type_id].flags & (Flag.complete as usize)) == 0;
    let alias_is_empty: bool = records[type_id].element_type == no_id();
    let alias_is_valid: bool = records[type_id].kind == Kind.alias && alias_is_incomplete;
    if (!alias_is_valid || !alias_is_empty) {
        return runtime::Error.invalid_argument;
    }
    let target: Record = records[target_type];
    let target_is_complete: bool = (target.flags & (Flag.complete as usize)) != 0;
    let target_kind_is_valid: bool = target.kind != Kind.invalid && target.kind != Kind.type_void;
    let target_layout_exists: bool = target.size_bytes != 0 && target.alignment_bytes != 0;
    let target_type_is_valid: bool = target_is_complete && target_kind_is_valid;
    if (!target_type_is_valid || !target_layout_exists) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].element_type = target_type;
    records[type_id].size_bytes = target.size_bytes;
    records[type_id].alignment_bytes = target.alignment_bytes;
    records[type_id].flags &= ~(Flag.resolving as usize);
    records[type_id].flags |= Flag.complete as usize;
    return runtime::Error.none;
}

fn table_set_base(table: Table, type_id: usize, base_type: usize) -> runtime::Error {
    let types_are_in_range: bool = type_id < table.type_count && base_type < table.type_count;
    if (!table_storage_is_valid(table) || !types_are_in_range) {
        return runtime::Error.invalid_argument;
    }
    var records: *Record = table.types.data as *Record;
    let derived: Record = records[type_id];
    let base: Record = records[base_type];
    let classes_are_valid: bool = derived.kind == Kind.class_type && base.kind == Kind.class_type;
    let relation_is_empty: bool = derived.base_type == no_id() && type_id != base_type;
    if (!classes_are_valid || !relation_is_empty) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].base_type = base_type;
    return runtime::Error.none;
}

fn table_set_vptr(table: Table, type_id: usize, vptr_offset: usize) -> runtime::Error {
    if (!table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let pointer_alignment: usize = Limit.target_pointer_alignment as usize;
    let pointer_size: usize = Limit.target_pointer_bytes as usize;
    let offset_is_aligned: bool = (vptr_offset & (pointer_alignment - 1)) == 0;
    let offset_is_bounded: bool = vptr_offset <= (Limit.maximum_size as usize) - pointer_size;
    if (!offset_is_aligned || !offset_is_bounded) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    let record: Record = records[type_id];
    let shape_is_valid: bool = record.kind == Kind.class_type && record.vptr_offset == no_id();
    let state_is_incomplete: bool = (record.flags & (Flag.complete as usize)) == 0;
    let state_is_resolving: bool = (record.flags & (Flag.resolving as usize)) != 0;
    let state_is_valid: bool = state_is_incomplete && state_is_resolving;
    if (!shape_is_valid || !state_is_valid) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].vptr_offset = vptr_offset;
    return runtime::Error.none;
}

fn table_set_resolving(table: Table, type_id: usize, resolving: bool) -> runtime::Error {
    let type_is_user_defined: bool = type_id >= BuiltinType.count as usize && type_id < table.type_count;
    if (!table_storage_is_valid(table) || !type_is_user_defined) {
        return runtime::Error.invalid_argument;
    }
    let records: *Record = table.types.data as *Record;
    if (!kind_is_declared(records[type_id].kind) || (records[type_id].flags & (Flag.complete as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    if (resolving) {
        records[type_id].flags |= Flag.resolving as usize;
    } else {
        records[type_id].flags &= ~(Flag.resolving as usize);
    }
    return runtime::Error.none;
}

fn is_integer(kind: Kind) -> bool {
    switch (kind) {
    case Kind.signed_8, Kind.signed_16, Kind.signed_32, Kind.signed_64, Kind.signed_size,
        Kind.unsigned_8, Kind.unsigned_16, Kind.unsigned_32, Kind.unsigned_64, Kind.unsigned_size {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_signed_integer(kind: Kind) -> bool {
    switch (kind) {
    case Kind.signed_8, Kind.signed_16, Kind.signed_32, Kind.signed_64, Kind.signed_size {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_float(kind: Kind) -> bool {
    return kind == Kind.float_32 || kind == Kind.float_64;
}

fn is_scalar(kind: Kind) -> bool {
    switch (kind) {
    case Kind.boolean, Kind.pointer, Kind.enumeration, Kind.function_pointer, Kind.reference {
        return true;
    }
    default {
        return is_integer(kind) || is_float(kind);
    }
    }
}

fn is_memory(kind: Kind) -> bool {
    switch (kind) {
    case Kind.array, Kind.structure, Kind.record_union, Kind.va_list_type, Kind.class_type, Kind.bound_method {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_opaque_class(record: Record) -> bool {
    return record.kind == Kind.class_type && (record.flags & (Flag.opaque_class as usize)) != 0;
}

fn has_opaque_definition(record: Record) -> bool {
    return is_opaque_class(record) && (record.flags & (Flag.opaque_definition as usize)) != 0;
}

fn bit_width(kind: Kind) -> usize {
    switch (kind) {
    case Kind.boolean, Kind.signed_8, Kind.unsigned_8 {
        return 8;
    }
    case Kind.signed_16, Kind.unsigned_16 {
        return 16;
    }
    case Kind.signed_32, Kind.unsigned_32, Kind.float_32 {
        return 32;
    }
    case Kind.signed_64, Kind.signed_size, Kind.unsigned_64, Kind.unsigned_size,
        Kind.float_64, Kind.pointer, Kind.function_pointer, Kind.reference {
        return 64;
    }
    default {
        return 0;
    }
    }
}

fn callable_record_is_valid(table: Table, records: *const Record, record: Record, expected_size: usize) -> bool {
    let complete: bool = (record.flags & (Flag.complete as usize)) != 0;
    let result_is_valid: bool = record.element_type < table.type_count &&
        records[record.element_type].kind != Kind.invalid;
    if (!complete || !result_is_valid) {
        return false;
    }
    let count_and_unit_are_empty: bool = record.element_count == 0 && record.declaration_unit == no_id();
    let node_and_name_are_empty: bool = record.declaration_node == no_id() && record.name_token == no_id();
    if (!count_and_unit_are_empty || !node_and_name_are_empty) {
        return false;
    }
    let size_is_valid: bool = record.size_bytes == expected_size;
    let alignment_is_valid: bool = record.alignment_bytes == Limit.target_pointer_alignment as usize;
    return size_is_valid && alignment_is_valid;
}

fn field_record_is_valid(table: Table, records: *const Record, field: Field) -> bool {
    if (field.owner_type >= table.type_count || field.type_id >= table.type_count) {
        return false;
    }
    let owner: Record = records[field.owner_type];
    let value: Record = records[field.type_id];
    let parameter_owner: bool = owner.kind == Kind.function_pointer || owner.kind == Kind.bound_method;
    let owner_accepts_fields: bool = parameter_owner || is_memory(owner.kind);
    if (!owner_accepts_fields || value.kind == Kind.invalid) {
        return false;
    }
    if (value.kind == Kind.type_void) {
        return false;
    }
    if (!parameter_owner) {
        let declaration_exists: bool = field.declaration_unit != no_id() && field.declaration_node != no_id();
        if (!declaration_exists || field.name_token == no_id()) {
            return false;
        }
    }
    if (field.offset_bytes > owner.size_bytes) {
        return false;
    }
    let value_is_complete: bool = (value.flags & (Flag.complete as usize)) != 0;
    let flexible_zero_size: bool = (value.flags & (Flag.flexible as usize)) != 0;
    let invalid_zero_size: bool = value.size_bytes == 0 && !flexible_zero_size;
    if (!value_is_complete || invalid_zero_size) {
        return false;
    }
    if (parameter_owner) {
        return true;
    }
    return value.size_bytes <= owner.size_bytes - field.offset_bytes;
}

fn opaque_state_is_valid(record: Record, complete: bool, require_complete: bool) -> bool {
    let opaque_class: bool = is_opaque_class(record);
    let definition_flag: bool = (record.flags & (Flag.opaque_definition as usize)) != 0;
    if (!opaque_class) {
        return !definition_flag;
    }
    let exported: bool = (record.flags & (Flag.exported as usize)) != 0;
    if (record.kind != Kind.class_type || !exported) {
        return false;
    }
    if (definition_flag) {
        return true;
    }
    return !complete && !require_complete;
}

fn reference_record_is_valid(record: Record, records: *const Record, type_count: usize) -> bool {
    if (record.element_type >= type_count) {
        return false;
    }
    let element_kind: Kind = records[record.element_type].kind;
    let element_is_valid: bool = element_kind != Kind.invalid && element_kind != Kind.type_void;
    let identity_is_empty: bool = record.element_count == 0 && record.declaration_unit == no_id();
    let declaration_is_empty: bool = record.declaration_node == no_id() && record.name_token == no_id();
    let fields_are_empty: bool = record.first_field == no_id() && record.field_count == 0;
    let layout_is_valid: bool = record.size_bytes == 8 && record.alignment_bytes == 8;
    let complete: bool = (record.flags & (Flag.complete as usize)) != 0;
    let qualifier_mask: usize = (Flag.read_only as usize) | (Flag.rvalue_reference as usize);
    let flags_are_valid: bool = (record.flags & ~(qualifier_mask | (Flag.complete as usize))) == 0;
    let identity_is_valid: bool = identity_is_empty && declaration_is_empty;
    let representation_is_valid: bool = fields_are_empty && layout_is_valid;
    let type_is_valid: bool = element_is_valid && identity_is_valid;
    let storage_is_valid: bool = representation_is_valid && complete;
    let record_is_valid: bool = type_is_valid && storage_is_valid;
    return record_is_valid && flags_are_valid;
}

fn declaration_identity_is_empty(record: Record) -> bool {
    let source_is_empty: bool = record.declaration_unit == no_id() && record.declaration_node == no_id();
    return source_is_empty && record.name_token == no_id();
}

fn fields_are_empty(record: Record) -> bool {
    return record.first_field == no_id() && record.field_count == 0;
}

fn base_relationship_is_valid(table: Table, records: *const Record, index: usize, record: Record) -> bool {
    if (record.base_type == no_id()) {
        return true;
    }
    if (record.kind != Kind.class_type) {
        return false;
    }
    if (record.base_type >= table.type_count || record.base_type == index) {
        return false;
    }
    let base: Record = records[record.base_type];
    let base_is_complete: bool = (base.flags & (Flag.complete as usize)) != 0;
    let derived_is_complete: bool = (record.flags & (Flag.complete as usize)) != 0;
    let completeness_matches: bool = !derived_is_complete || base_is_complete;
    return base.kind == Kind.class_type && completeness_matches;
}

fn record_header_is_valid(table: Table, records: *const Record, index: usize, record: Record) -> bool {
    let maximum_flags: usize = (Flag.rvalue_reference as usize) * 2 - 1;
    let kind_is_known: bool = (record.kind as usize) <= (Kind.reference as usize);
    let flags_are_known: bool = record.flags <= maximum_flags;
    if (!kind_is_known || !flags_are_known) {
        return false;
    }
    let vptr_is_allowed: bool = record.kind == Kind.class_type || record.vptr_offset == no_id();
    return vptr_is_allowed && base_relationship_is_valid(table, records, index, record);
}

fn field_slice_is_valid(table: Table, record: Record) -> bool {
    if (record.field_count == 0) {
        return record.first_field == no_id();
    }
    if (record.first_field >= table.field_count) {
        return false;
    }
    return record.field_count <= table.field_count - record.first_field;
}

fn builtin_record_is_valid(record: Record, index: usize) -> bool {
    let type_identity_is_empty: bool = record.element_type == no_id() && record.element_count == 0;
    let declaration_is_empty: bool = declaration_identity_is_empty(record);
    let representation_is_empty: bool = fields_are_empty(record);
    let kind_matches: bool = record.kind == builtin_kind(index);
    let size_matches: bool = record.size_bytes == builtin_size(index);
    let alignment_matches: bool = record.alignment_bytes == builtin_alignment(index);
    let type_identity_is_valid: bool = kind_matches && type_identity_is_empty;
    let source_identity_is_valid: bool = declaration_is_empty && representation_is_empty;
    let layout_is_valid: bool = size_matches && alignment_matches;
    let identity_is_valid: bool = type_identity_is_valid && source_identity_is_valid;
    let storage_is_valid: bool = layout_is_valid && record.flags == Flag.complete as usize;
    return identity_is_valid && storage_is_valid;
}

fn pointer_identity_matches(left: Record, right: Record) -> bool {
    let qualifier_mask: usize = (Flag.read_only as usize) | (Flag.volatile_pointee as usize);
    let kind_and_type_match: bool = left.kind == Kind.pointer && left.element_type == right.element_type;
    return kind_and_type_match && (left.flags & qualifier_mask) == (right.flags & qualifier_mask);
}

fn has_prior_pointer(records: *const Record, index: usize, record: Record) -> bool {
    for (var previous: usize = BuiltinType.count as usize; previous < index; previous += 1) {
        if (pointer_identity_matches(records[previous], record)) {
            return true;
        }
    }
    return false;
}

fn pointer_record_is_valid(table: Table, records: *const Record, index: usize, record: Record) -> bool {
    if (record.element_type >= table.type_count) {
        return false;
    }
    let target_is_valid: bool = records[record.element_type].kind != Kind.invalid;
    let count_is_empty: bool = record.element_count == 0;
    let identity_is_empty: bool = declaration_identity_is_empty(record) && fields_are_empty(record);
    let size_is_valid: bool = record.size_bytes == Limit.target_pointer_bytes as usize;
    let alignment_is_valid: bool = record.alignment_bytes == Limit.target_pointer_alignment as usize;
    let complete: bool = (record.flags & (Flag.complete as usize)) != 0;
    let allowed_flags: usize = (Flag.complete as usize) | (Flag.read_only as usize) | (Flag.volatile_pointee as usize);
    let flags_are_valid: bool = (record.flags & ~allowed_flags) == 0;
    let type_is_valid: bool = target_is_valid && count_is_empty;
    let storage_is_valid: bool = size_is_valid && alignment_is_valid;
    let shape_is_valid: bool = identity_is_empty && storage_is_valid;
    let record_is_valid: bool = type_is_valid && shape_is_valid;
    let state_is_valid: bool = complete && flags_are_valid;
    let unique: bool = !has_prior_pointer(records, index, record);
    let shape_and_state_are_valid: bool = record_is_valid && state_is_valid;
    return shape_and_state_are_valid && unique;
}

fn reference_identity_matches(left: Record, right: Record) -> bool {
    let qualifier_mask: usize = (Flag.read_only as usize) | (Flag.rvalue_reference as usize);
    let kind_and_type_match: bool = left.kind == Kind.reference && left.element_type == right.element_type;
    return kind_and_type_match && (left.flags & qualifier_mask) == (right.flags & qualifier_mask);
}

fn has_prior_reference(records: *const Record, index: usize, record: Record) -> bool {
    for (var previous: usize = BuiltinType.count as usize; previous < index; previous += 1) {
        if (reference_identity_matches(records[previous], record)) {
            return true;
        }
    }
    return false;
}

fn fixed_array_element_is_valid(table: Table, records: *const Record, element_type: usize) -> bool {
    if (element_type >= table.type_count) {
        return false;
    }
    let element: Record = records[element_type];
    let defined_kind: bool = element.kind != Kind.invalid && element.kind != Kind.type_void;
    let kind_is_valid: bool = defined_kind && element.kind != Kind.reference;
    let complete: bool = (element.flags & (Flag.complete as usize)) != 0;
    let storage_exists: bool = complete && element.size_bytes != 0;
    return kind_is_valid && storage_exists;
}

fn flexible_array_element_is_valid(table: Table, records: *const Record, element_type: usize) -> bool {
    if (!fixed_array_element_is_valid(table, records, element_type)) {
        return false;
    }
    let element: Record = records[element_type];
    let forbidden_flags: usize = (Flag.flexible as usize) | (Flag.header as usize);
    return (element.flags & forbidden_flags) == 0;
}

fn flexible_array_record_is_valid(table: Table, records: *const Record, record: Record) -> bool {
    let element_is_valid: bool = flexible_array_element_is_valid(table, records, record.element_type);
    if (!element_is_valid) {
        return false;
    }
    let element: Record = records[record.element_type];
    let identity_is_empty: bool = declaration_identity_is_empty(record) && fields_are_empty(record);
    let count_and_size_are_empty: bool = record.element_count == 0 && record.size_bytes == 0;
    let alignment_matches: bool = record.alignment_bytes == element.alignment_bytes;
    let expected_flags: usize = (Flag.complete as usize) | (Flag.flexible as usize);
    let representation_is_valid: bool = count_and_size_are_empty && alignment_matches;
    let storage_is_valid: bool = representation_is_valid && record.flags == expected_flags;
    return identity_is_empty && storage_is_valid;
}

fn fixed_array_record_is_valid(table: Table, records: *const Record, record: Record) -> bool {
    if (!fixed_array_element_is_valid(table, records, record.element_type)) {
        return false;
    }
    let element: Record = records[record.element_type];
    let identity_is_empty: bool = declaration_identity_is_empty(record) && fields_are_empty(record);
    let count_and_size_exist: bool = record.element_count != 0 && record.size_bytes != 0;
    if (!identity_is_empty || !count_and_size_exist) {
        return false;
    }
    if (record.element_count > (Limit.maximum_size as usize) / element.size_bytes) {
        return false;
    }
    let size_matches: bool = record.size_bytes == element.size_bytes * record.element_count;
    let alignment_matches: bool = record.alignment_bytes == element.alignment_bytes;
    let layout_matches: bool = size_matches && alignment_matches;
    return layout_matches && record.flags == Flag.complete as usize;
}

fn has_prior_array(records: *const Record, index: usize, record: Record) -> bool {
    for (var previous: usize = BuiltinType.count as usize; previous < index; previous += 1) {
        let kind_and_type_match: bool =
            records[previous].kind == Kind.array && records[previous].element_type == record.element_type;
        if (kind_and_type_match && records[previous].element_count == record.element_count) {
            return true;
        }
    }
    return false;
}

fn array_record_is_valid(table: Table, records: *const Record, index: usize, record: Record) -> bool {
    let flexible: bool = (record.flags & (Flag.flexible as usize)) != 0;
    let shape_is_valid: bool = flexible ? flexible_array_record_is_valid(table, records, record) :
        fixed_array_record_is_valid(table, records, record);
    return shape_is_valid && !has_prior_array(records, index, record);
}

fn callable_parameters_match(fields: *const Field, left: Record, right: Record) -> bool {
    if (left.field_count != right.field_count) {
        return false;
    }
    for (var parameter: usize = 0; parameter < left.field_count; parameter += 1) {
        let left_type: usize = fields[left.first_field + parameter].type_id;
        let right_type: usize = fields[right.first_field + parameter].type_id;
        if (left_type != right_type) {
            return false;
        }
    }
    return true;
}

fn has_prior_callable(records: *const Record, fields: *const Field, index: usize, record: Record) -> bool {
    for (var previous: usize = BuiltinType.count as usize; previous < index; previous += 1) {
        let candidate: Record = records[previous];
        let kind_and_result_match: bool =
            candidate.kind == record.kind && candidate.element_type == record.element_type;
        if (kind_and_result_match && callable_parameters_match(fields, candidate, record)) {
            return true;
        }
    }
    return false;
}

fn callable_value_record_is_valid(
    table: Table, records: *const Record, fields: *const Field, index: usize, record: Record) -> bool {
    let expected_size: usize = record.kind == Kind.function_pointer ?
        Limit.target_pointer_bytes as usize : Limit.bound_method_bytes as usize;
    let shape_is_valid: bool = callable_record_is_valid(table, records, record, expected_size);
    return shape_is_valid && !has_prior_callable(records, fields, index, record);
}

fn alias_target_is_valid(table: Table, records: *const Record, record: Record) -> bool {
    if (record.element_type >= table.type_count) {
        return false;
    }
    let target: Record = records[record.element_type];
    let target_is_complete: bool = (target.flags & (Flag.complete as usize)) != 0;
    let target_kind_is_valid: bool = target.kind != Kind.invalid && target.kind != Kind.type_void;
    let size_matches: bool = record.size_bytes == target.size_bytes;
    let alignment_matches: bool = record.alignment_bytes == target.alignment_bytes;
    let target_is_valid: bool = target_is_complete && target_kind_is_valid;
    let layout_matches: bool = size_matches && alignment_matches;
    return target_is_valid && layout_matches;
}

fn alias_record_is_valid(table: Table, records: *const Record, record: Record) -> bool {
    let declaration_exists: bool = record.declaration_unit != no_id() && record.declaration_node != no_id();
    let identity_exists: bool = declaration_exists && record.name_token != no_id();
    let representation_is_empty: bool = record.element_count == 0 && fields_are_empty(record);
    if (!identity_exists || !representation_is_empty) {
        return false;
    }
    let complete: bool = (record.flags & (Flag.complete as usize)) != 0;
    let target_presence_matches: bool = complete ? record.element_type != no_id() : record.element_type == no_id();
    if (!target_presence_matches) {
        return false;
    }
    if (!complete) {
        return true;
    }
    let resolving: bool = (record.flags & (Flag.resolving as usize)) != 0;
    let layout_exists: bool = record.size_bytes != 0 && record.alignment_bytes != 0;
    let target_is_valid: bool = alias_target_is_valid(table, records, record);
    let representation_is_valid: bool = layout_exists && target_is_valid;
    return !resolving && representation_is_valid;
}

fn named_record_is_valid(table: Table, records: *const Record, record: Record, require_complete: bool) -> bool {
    let complete: bool = (record.flags & (Flag.complete as usize)) != 0;
    if (!opaque_state_is_valid(record, complete, require_complete)) {
        return false;
    }
    let declaration_exists: bool = record.declaration_unit != no_id() && record.declaration_node != no_id();
    let identity_exists: bool = declaration_exists && record.name_token != no_id();
    let requires_completion: bool = require_complete && !complete;
    if (!identity_exists || requires_completion) {
        return false;
    }
    if (record.element_count != 0) {
        return false;
    }
    if (complete) {
        let layout_exists: bool = record.size_bytes != 0 && record.alignment_bytes != 0;
        let resolving: bool = (record.flags & (Flag.resolving as usize)) != 0;
        if (!layout_exists || resolving) {
            return false;
        }
    }
    if (record.kind == Kind.enumeration && complete) {
        if (record.element_type >= table.type_count) {
            return false;
        }
        return is_integer(records[record.element_type].kind);
    }
    return record.kind == Kind.enumeration || record.element_type == no_id();
}

fn record_kind_is_valid(
    table: Table, records: *const Record, fields: *const Field,
    index: usize, record: Record, require_complete: bool) -> bool {
    switch (record.kind) {
    case Kind.pointer {
        return pointer_record_is_valid(table, records, index, record);
    }
    case Kind.reference {
        let shape_is_valid: bool = reference_record_is_valid(record, records, table.type_count);
        return shape_is_valid && !has_prior_reference(records, index, record);
    }
    case Kind.array {
        return array_record_is_valid(table, records, index, record);
    }
    case Kind.function_pointer, Kind.bound_method {
        return callable_value_record_is_valid(table, records, fields, index, record);
    }
    case Kind.alias {
        return alias_record_is_valid(table, records, record);
    }
    case Kind.structure, Kind.record_union, Kind.enumeration, Kind.class_type {
        return named_record_is_valid(table, records, record, require_complete);
    }
    default {
        return false;
    }
    }
}

fn record_is_valid(
    table: Table, records: *const Record, fields: *const Field, index: usize, require_complete: bool) -> bool {
    let record: Record = records[index];
    if (!record_header_is_valid(table, records, index, record)) {
        return false;
    }
    let kind_is_valid: bool = index < BuiltinType.count as usize ? builtin_record_is_valid(record, index) :
        record_kind_is_valid(table, records, fields, index, record, require_complete);
    return kind_is_valid && field_slice_is_valid(table, record);
}

fn records_are_valid(table: Table, records: *const Record, fields: *const Field, require_complete: bool) -> bool {
    for (var index: usize = 0; index < table.type_count; index += 1) {
        if (!record_is_valid(table, records, fields, index, require_complete)) {
            return false;
        }
    }
    return true;
}

fn fields_are_valid(table: Table, records: *const Record, fields: *const Field) -> bool {
    for (var index: usize = 0; index < table.field_count; index += 1) {
        let field: Field = fields[index];
        if (!field_record_is_valid(table, records, field)) {
            return false;
        }
        let owner: Record = records[field.owner_type];
        if (owner.field_count == 0) {
            return false;
        }
        let precedes_slice: bool = index < owner.first_field;
        let follows_slice: bool = index >= owner.first_field + owner.field_count;
        if (precedes_slice || follows_slice) {
            return false;
        }
    }
    return true;
}

struct RecordLayout {
    size: usize;
    alignment: usize;
    has_flexible_field: bool;
    valid: bool;
}

fn initial_record_layout(records: *const Record, record: Record) -> RecordLayout {
    var layout: RecordLayout = {size = 0, alignment = 1, has_flexible_field = false, valid = true};
    let class_has_base: bool = record.kind == Kind.class_type && record.base_type != no_id();
    if (class_has_base) {
        layout.size = records[record.base_type].size_bytes;
        layout.alignment = records[record.base_type].alignment_bytes;
    }
    let class_has_vptr: bool = record.kind == Kind.class_type && record.vptr_offset != no_id();
    if (!class_has_vptr) {
        if (class_has_base && records[record.base_type].vptr_offset != no_id()) {
            layout.valid = false;
        }
        return layout;
    }
    let base_vptr: usize = class_has_base ? records[record.base_type].vptr_offset : no_id();
    if (base_vptr != no_id()) {
        layout.valid = record.vptr_offset == base_vptr;
        return layout;
    }
    let pointer_alignment: usize = Limit.target_pointer_alignment as usize;
    let pointer_mask: usize = pointer_alignment - 1;
    if (layout.size > (Limit.maximum_size as usize) - pointer_mask) {
        layout.valid = false;
        return layout;
    }
    let expected_vptr: usize = (layout.size + pointer_mask) & ~pointer_mask;
    let offset_matches: bool = record.vptr_offset == expected_vptr;
    let size_is_bounded: bool = expected_vptr <= (Limit.maximum_size as usize) - (Limit.target_pointer_bytes as usize);
    if (!offset_matches || !size_is_bounded) {
        layout.valid = false;
        return layout;
    }
    layout.size = expected_vptr + (Limit.target_pointer_bytes as usize);
    if (layout.alignment < pointer_alignment) {
        layout.alignment = pointer_alignment;
    }
    return layout;
}

fn field_alignment_is_valid(alignment: usize) -> bool {
    if (alignment == 0) {
        return true;
    }
    let is_power_of_two: bool = (alignment & (alignment - 1)) == 0;
    return alignment <= (Limit.maximum_alignment as usize) && is_power_of_two;
}

fn append_field_layout(
    layout: RecordLayout, record_id: usize, record: Record, field_index: usize,
    field: Field, field_type: Record, is_union: bool, is_packed: bool) -> RecordLayout {
    var result: RecordLayout = layout;
    if (field.owner_type != record_id || !field_alignment_is_valid(field.alignment_bytes)) {
        result.valid = false;
        return result;
    }
    let flexible: bool = (field_type.flags & (Flag.flexible as usize)) != 0;
    let flexible_position_is_invalid: bool = is_union || field_index + 1 != record.field_count;
    if (flexible && flexible_position_is_invalid) {
        result.valid = false;
        return result;
    }
    result.has_flexible_field = result.has_flexible_field || flexible;
    var alignment: usize = field.alignment_bytes > field_type.alignment_bytes ?
        field.alignment_bytes : field_type.alignment_bytes;
    if (is_packed) {
        alignment = 1;
    }
    if (alignment > result.alignment) {
        result.alignment = alignment;
    }
    if (is_union) {
        if (field.offset_bytes != 0) {
            result.valid = false;
            return result;
        }
        if (field_type.size_bytes > result.size) {
            result.size = field_type.size_bytes;
        }
        return result;
    }
    let mask: usize = alignment - 1;
    if (result.size > (Limit.maximum_size as usize) - mask) {
        result.valid = false;
        return result;
    }
    let expected_offset: usize = (result.size + mask) & ~mask;
    let offset_matches: bool = field.offset_bytes == expected_offset;
    let field_fits: bool = field_type.size_bytes <= (Limit.maximum_size as usize) - expected_offset;
    if (!offset_matches || !field_fits) {
        result.valid = false;
        return result;
    }
    result.size = expected_offset + field_type.size_bytes;
    return result;
}

fn final_record_layout_is_valid(record: Record, layout: RecordLayout) -> bool {
    var expected_size: usize = layout.size == 0 ? 1 : layout.size;
    let header: bool = (record.flags & (Flag.header as usize)) != 0;
    if (header != layout.has_flexible_field) {
        return false;
    }
    let alignment_is_power: bool =
        record.alignment_bytes != 0 && (record.alignment_bytes & (record.alignment_bytes - 1)) == 0;
    let alignment_is_large_enough: bool = record.alignment_bytes >= layout.alignment;
    let alignment_is_bounded: bool = record.alignment_bytes <= (Limit.maximum_alignment as usize);
    let alignment_range_is_valid: bool = alignment_is_large_enough && alignment_is_bounded;
    if (!alignment_is_power || !alignment_range_is_valid) {
        return false;
    }
    let alignment_mask: usize = record.alignment_bytes - 1;
    if (expected_size > (Limit.maximum_size as usize) - alignment_mask) {
        return false;
    }
    expected_size = (expected_size + alignment_mask) & ~alignment_mask;
    return record.size_bytes == expected_size;
}

fn record_layout_is_valid(records: *const Record, fields: *const Field, record_id: usize, record: Record) -> bool {
    var layout: RecordLayout = initial_record_layout(records, record);
    if (!layout.valid) {
        return false;
    }
    let is_union: bool = record.kind == Kind.record_union;
    let is_packed: bool = (record.flags & (Flag.packed as usize)) != 0;
    for (var field_index: usize = 0; field_index < record.field_count; field_index += 1) {
        let field: Field = fields[record.first_field + field_index];
        layout = append_field_layout(
            layout, record_id, record, field_index, field, records[field.type_id], is_union, is_packed);
        if (!layout.valid) {
            return false;
        }
    }
    return final_record_layout_is_valid(record, layout);
}

fn enum_layout_is_valid(records: *const Record, record: Record) -> bool {
    let underlying: Record = records[record.element_type];
    let size_matches: bool = record.size_bytes == underlying.size_bytes;
    let alignment_matches: bool = record.alignment_bytes == underlying.alignment_bytes;
    let layout_matches: bool = size_matches && alignment_matches;
    return layout_matches && record.field_count == 0;
}

fn layouts_are_valid(table: Table, records: *const Record, fields: *const Field) -> bool {
    for (var index: usize = BuiltinType.count as usize; index < table.type_count; index += 1) {
        let record: Record = records[index];
        if (record.kind == Kind.enumeration && !enum_layout_is_valid(records, record)) {
            return false;
        }
        if (is_record(record.kind) && !record_layout_is_valid(records, fields, index, record)) {
            return false;
        }
    }
    return true;
}

fn table_is_valid(table: Table, require_complete: bool) -> bool {
    if (!table_storage_is_valid(table) || table.type_count < BuiltinType.count as usize) {
        return false;
    }
    let records: *const Record = table.types.data as *const Record;
    let fields: *const Field = table.fields.data as *const Field;
    if (!records_are_valid(table, records, fields, require_complete)) {
        return false;
    }
    if (!fields_are_valid(table, records, fields)) {
        return false;
    }
    return layouts_are_valid(table, records, fields);
}
fn table_release(table: Table) -> runtime::Error {
    if (!table_storage_is_valid(table)) {
        return runtime::Error.invalid_argument;
    }
    let type_error: runtime::Error = bytes::release(table.types);
    let field_error: runtime::Error = bytes::release(table.fields);
    return type_error != runtime::Error.none ? type_error : field_error;
}
