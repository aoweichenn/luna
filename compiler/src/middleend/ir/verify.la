module luna.compiler.ir;

class Verifier {
    priv source: View;
    priv types: *const type_info::TypeTable;
    priv type_records: *const type_info::Record;
    priv type_fields: *const type_info::Field;
    priv globals: *const Global;
    priv global_references: *const GlobalReference;
    priv functions: *const Function;
    priv parameters: *const Parameter;
    priv slots: *const Slot;
    priv values: *const Value;
    priv blocks: *const Block;
    priv instructions: *const Instruction;
    priv arguments: *const Argument;
    priv counted_parameters: usize;
    priv counted_slots: usize;
    priv counted_blocks: usize;
    priv counted_values: usize;

    pub init(source: View, types: type_info::TypeTable const&);
    pub fn run() -> bool;
}

impl Verifier {
    init(source: View, types: type_info::TypeTable const&) {
        this->source = source;
        this->types = &types;
        this->type_records = types.record_data() as *const type_info::Record;
        this->type_fields = types.field_data() as *const type_info::Field;
        this->globals = source.globals;
        this->global_references = source.global_references;
        this->functions = source.functions;
        this->parameters = source.parameters;
        this->slots = source.slots;
        this->values = source.values;
        this->blocks = source.blocks;
        this->instructions = source.instructions;
        this->arguments = source.arguments;
        this->counted_parameters = 0;
        this->counted_slots = 0;
        this->counted_blocks = 0;
        this->counted_values = 0;
    }

    priv fn storage_is_valid() const -> bool {
        let global_records_exist: bool = this->globals != null || this->source.global_count == 0;
        let global_bytes_exist: bool = this->source.global_bytes != null || this->source.global_byte_count == 0;
        let global_storage_is_valid: bool = global_records_exist && global_bytes_exist;
        let references_exist: bool = this->global_references != null || this->source.global_reference_count == 0;
        let functions_exist: bool = this->functions != null || this->source.function_count == 0;
        let callable_records_are_valid: bool = references_exist && functions_exist;
        let signatures_exist: bool = this->source.callable_signatures != null ||
            this->source.callable_signature_count == 0;
        let parameters_exist: bool = this->parameters != null || this->source.parameter_count == 0;
        let signature_storage_is_valid: bool = signatures_exist && parameters_exist;
        let slots_exist: bool = this->slots != null || this->source.slot_count == 0;
        let values_exist: bool = this->values != null || this->source.value_count == 0;
        let local_storage_is_valid: bool = slots_exist && values_exist;
        let blocks_exist: bool = this->blocks != null || this->source.block_count == 0;
        let instructions_exist: bool = this->instructions != null || this->source.instruction_count == 0;
        let control_storage_is_valid: bool = blocks_exist && instructions_exist;
        let arguments_exist: bool = this->arguments != null || this->source.argument_count == 0;
        let global_and_callable_are_valid: bool = global_storage_is_valid && callable_records_are_valid;
        let signature_and_local_are_valid: bool = signature_storage_is_valid && local_storage_is_valid;
        let records_are_valid: bool = global_and_callable_are_valid && signature_and_local_are_valid;
        let control_is_valid: bool = control_storage_is_valid && arguments_exist;
        return records_are_valid && control_is_valid;
    }

    priv fn signature_is_valid(function: Function, expected_offset: usize) const -> bool {
        if (expected_offset > this->source.callable_signature_count) {
            return false;
        }
        let position_is_valid: bool = function.signature_length != 0 && function.signature_offset == expected_offset;
        let remaining: usize = this->source.callable_signature_count - expected_offset;
        return position_is_valid && function.signature_length <= remaining;
    }

    priv fn signatures_are_valid() const -> bool {
        var expected_offset: usize = 0;
        for (var index: usize = 0; index < this->source.function_count; index += 1) {
            let function: Function = this->functions[index];
            if (!this->signature_is_valid(function, expected_offset)) {
                return false;
            }
            expected_offset += function.signature_length;
        }
        return expected_offset == this->source.callable_signature_count;
    }

    priv fn input_is_valid() const -> bool {
        let storage_is_valid: bool = this->storage_is_valid();
        let type_model_is_valid: bool = this->types->is_valid(true);
        if (!storage_is_valid || !type_model_is_valid) {
            return false;
        }
        let signatures_are_valid: bool = this->signatures_are_valid();
        let entry_is_in_range: bool = this->source.entry_function == no_id() ||
            this->source.entry_function < this->source.function_count;
        return signatures_are_valid && entry_is_in_range;
    }

    priv fn global_shape_is_valid(
        global: Global, expected_byte_offset: usize, expected_reference: usize) const -> bool {
        let byte_position_is_valid: bool = global.byte_count != 0 && global.byte_offset == expected_byte_offset;
        let byte_range_is_valid: bool = checked::range_is_valid(
            global.byte_offset, global.byte_count, this->source.global_byte_count);
        let alignment_is_bounded: bool = global.alignment_bytes != 0 &&
            global.alignment_bytes <= Limit.maximum_alignment as usize;
        let alignment_is_power: bool = alignment_is_bounded ?
                (global.alignment_bytes & (global.alignment_bytes - 1)) == 0 : false;
        let alignment_is_valid: bool = alignment_is_bounded && alignment_is_power;
        let reference_range_is_valid: bool = range_is_valid(
            global.first_reference, global.reference_count, this->source.global_reference_count);
        let reference_position_is_valid: bool = global.reference_count == 0 ?
                global.first_reference == no_id() : global.first_reference == expected_reference;
        let byte_shape_is_valid: bool = byte_position_is_valid && byte_range_is_valid;
        let reference_shape_is_valid: bool = reference_range_is_valid && reference_position_is_valid;
        let storage_shape_is_valid: bool = byte_shape_is_valid && alignment_is_valid;
        return storage_shape_is_valid && reference_shape_is_valid;
    }

    priv fn global_reference_target_is_valid(reference: GlobalReference) const -> bool {
        switch (reference.kind) {
        case GlobalReferenceKind.function {
            return reference.target_id < this->source.function_count;
        }
        case GlobalReferenceKind.global {
            return reference.target_id < this->source.global_count;
        }
        default {
            return false;
        }
        }
    }

    priv fn global_reference_bytes_are_zero(global: Global, reference: GlobalReference) const -> bool {
        let address_bytes: usize = Limit.function_address_bytes as usize;
        let storage_offset: usize = global.byte_offset + reference.byte_offset;
        for (var index: usize = 0; index < address_bytes; index += 1) {
            if (this->source.global_bytes[storage_offset + index] != 0) {
                return false;
            }
        }
        return true;
    }

    priv fn global_references_are_valid(global: Global, global_id: usize) const -> bool {
        var previous_end: usize = 0;
        let address_bytes: usize = Limit.function_address_bytes as usize;
        let reference_end: usize = global.first_reference + global.reference_count;
        for (var index: usize = global.first_reference; index < reference_end; index += 1) {
            let reference: GlobalReference = this->global_references[index];
            let owner_is_valid: bool = reference.global_id == global_id;
            let target_is_valid: bool = this->global_reference_target_is_valid(reference);
            let range_is_valid: bool = checked::range_is_valid(reference.byte_offset, address_bytes, global.byte_count);
            let alignment_matches: bool = global.alignment_bytes == address_bytes;
            let offset_is_aligned: bool = (reference.byte_offset & (address_bytes - 1)) == 0;
            let alignment_is_valid: bool = alignment_matches && offset_is_aligned;
            let position_is_valid: bool = reference.byte_offset >= previous_end;
            let identity_is_valid: bool = owner_is_valid && target_is_valid;
            let placement_is_valid: bool = range_is_valid && alignment_is_valid;
            if (!identity_is_valid || !placement_is_valid) {
                return false;
            }
            if (!position_is_valid || !this->global_reference_bytes_are_zero(global, reference)) {
                return false;
            }
            previous_end = reference.byte_offset + address_bytes;
        }
        return true;
    }

    priv fn globals_are_valid() const -> bool {
        var expected_byte_offset: usize = 0;
        var expected_reference: usize = 0;
        for (var index: usize = 0; index < this->source.global_count; index += 1) {
            let global: Global = this->globals[index];
            if (!this->global_shape_is_valid(global, expected_byte_offset, expected_reference)) {
                return false;
            }
            let has_references: bool = global.reference_count != 0;
            if (has_references && !global.read_only) {
                return false;
            }
            if (has_references && !this->global_references_are_valid(global, index)) {
                return false;
            }
            expected_byte_offset += global.byte_count;
            expected_reference += global.reference_count;
        }
        let all_bytes_are_owned: bool = expected_byte_offset == this->source.global_byte_count;
        let all_references_are_owned: bool = expected_reference == this->source.global_reference_count;
        return all_bytes_are_owned && all_references_are_owned;
    }

    priv fn function_shape_is_valid(function: Function) const -> bool {
        let declaration_exists: bool = function.declaration_unit != no_id() && function.declaration_node != no_id();
        let name_exists: bool = function.name_token != no_id();
        let linkage_is_valid: bool = (function.linkage as usize) <= (Linkage.external_c as usize);
        let return_type_exists: bool = function.return_type < this->types->size();
        let return_type_is_valid: bool = return_type_exists &&
            this->type_records[function.return_type].kind != type_info::Kind.invalid;
        let source_is_valid: bool = declaration_exists && name_exists;
        let identity_is_valid: bool = source_is_valid && linkage_is_valid;
        if (!identity_is_valid || !return_type_is_valid) {
            return false;
        }
        let parameters_are_valid: bool = range_is_valid(
            function.first_parameter, function.parameter_count, this->source.parameter_count);
        let blocks_are_valid: bool = range_is_valid(
            function.first_block, function.block_count, this->source.block_count);
        let values_are_valid: bool = range_is_valid(
            function.first_value, function.value_count, this->source.value_count);
        let control_ranges_are_valid: bool = blocks_are_valid && values_are_valid;
        if (!parameters_are_valid || !control_ranges_are_valid) {
            return false;
        }
        if (function.has_body) {
            let has_lowered_body: bool = function.block_count != 0;
            let has_assembly_body: bool = function.asm_body_node != no_id();
            return has_lowered_body || has_assembly_body;
        }
        let control_is_empty: bool = function.block_count == 0 && function.value_count == 0;
        let locals_are_parameters: bool = function.slot_count == function.parameter_count;
        return control_is_empty && locals_are_parameters;
    }

    priv fn parameter_is_valid(parameter: Parameter, function_id: usize) const -> bool {
        let owner_matches: bool = parameter.function_id == function_id;
        let type_exists: bool = parameter.type_id < this->types->size();
        if (!owner_matches || !type_exists) {
            return false;
        }
        let value_type_is_valid: bool = type_can_be_value(*this->types, parameter.type_id);
        let slot_exists: bool = parameter.slot_id < this->source.slot_count;
        if (!value_type_is_valid || !slot_exists) {
            return false;
        }
        let slot: Slot = this->slots[parameter.slot_id];
        return slot.function_id == function_id && slot.type_id == parameter.type_id;
    }

    priv fn parameters_are_valid(function: Function, function_id: usize) const -> bool {
        for (var index: usize = 0; index < function.parameter_count; index += 1) {
            let parameter: Parameter = this->parameters[function.first_parameter + index];
            if (!this->parameter_is_valid(parameter, function_id)) {
                return false;
            }
        }
        return true;
    }

    priv fn function_slots_are_valid(function: Function, function_id: usize) const -> bool {
        var owned_slot_count: usize = 0;
        var first_owned_slot: usize = no_id();
        for (var index: usize = 0; index < this->source.slot_count; index += 1) {
            if (this->slots[index].function_id == function_id) {
                if (owned_slot_count == 0) {
                    first_owned_slot = index;
                }
                owned_slot_count += 1;
            }
        }
        return owned_slot_count == function.slot_count && first_owned_slot == function.first_slot;
    }

    priv fn value_is_valid(value: Value, function_id: usize) const -> bool {
        let owner_matches: bool = value.function_id == function_id;
        let block_exists: bool = value.block_id < this->source.block_count;
        let identity_is_valid: bool = owner_matches && block_exists;
        let type_is_valid: bool = type_can_be_value(*this->types, value.type_id);
        let definition_exists: bool = value.definition < this->source.instruction_count;
        let content_is_valid: bool = type_is_valid && definition_exists;
        return identity_is_valid && content_is_valid;
    }

    priv fn values_are_valid(function: Function, function_id: usize) const -> bool {
        for (var index: usize = 0; index < function.value_count; index += 1) {
            let value: Value = this->values[function.first_value + index];
            if (!this->value_is_valid(value, function_id)) {
                return false;
            }
        }
        return true;
    }

    priv fn function_is_valid(function: Function, function_id: usize) const -> bool {
        if (!this->function_shape_is_valid(function)) {
            return false;
        }
        let parameters_are_valid: bool = this->parameters_are_valid(function, function_id);
        let slots_are_valid: bool = this->function_slots_are_valid(function, function_id);
        if (!parameters_are_valid || !slots_are_valid) {
            return false;
        }
        return this->values_are_valid(function, function_id);
    }

    priv fn functions_are_valid() -> bool {
        for (var index: usize = 0; index < this->source.function_count; index += 1) {
            let function: Function = this->functions[index];
            if (!this->function_is_valid(function, index)) {
                return false;
            }
            this->counted_parameters += function.parameter_count;
            this->counted_slots += function.slot_count;
            this->counted_blocks += function.block_count;
            this->counted_values += function.value_count;
        }
        return true;
    }

    priv fn function_totals_are_valid() const -> bool {
        let parameters_match: bool = this->counted_parameters == this->source.parameter_count;
        let slots_match: bool = this->counted_slots == this->source.slot_count;
        let blocks_match: bool = this->counted_blocks == this->source.block_count;
        let values_match: bool = this->counted_values == this->source.value_count;
        let callable_totals_match: bool = parameters_match && slots_match;
        let control_totals_match: bool = blocks_match && values_match;
        return callable_totals_match && control_totals_match;
    }

    priv fn entry_parameters_are_valid(entry: Function) const -> bool {
        let argument_count: Parameter = this->parameters[entry.first_parameter];
        let argument_vector: Parameter = this->parameters[entry.first_parameter + 1];
        let count_type_is_valid: bool = argument_count.type_id == type_info::BuiltinType.unsigned_size as usize;
        let outer: type_info::Record = this->type_records[argument_vector.type_id];
        let outer_is_pointer: bool = outer.kind == type_info::Kind.pointer;
        let outer_is_mutable: bool = (outer.flags & (type_info::Flag.read_only as usize)) == 0;
        let outer_is_valid: bool = outer_is_pointer && outer_is_mutable;
        if (!count_type_is_valid || !outer_is_valid) {
            return false;
        }
        let inner: type_info::Record = this->type_records[outer.element_type];
        let inner_is_pointer: bool = inner.kind == type_info::Kind.pointer;
        let inner_is_read_only: bool = (inner.flags & (type_info::Flag.read_only as usize)) != 0;
        let character_type_is_valid: bool = inner.element_type == type_info::BuiltinType.unsigned_8 as usize;
        let inner_is_valid: bool = inner_is_pointer && inner_is_read_only;
        return inner_is_valid && character_type_is_valid;
    }

    priv fn entry_is_valid() const -> bool {
        if (this->source.entry_function == no_id()) {
            return true;
        }
        let entry: Function = this->functions[this->source.entry_function];
        let body_is_internal: bool = entry.has_body && entry.linkage == Linkage.internal;
        let return_type_is_valid: bool = entry.return_type == type_info::BuiltinType.signed_32 as usize;
        if (!body_is_internal || !return_type_is_valid) {
            return false;
        }
        switch (entry.parameter_count) {
        case 0 {
            return true;
        }
        case 2 {
            return this->entry_parameters_are_valid(entry);
        }
        default {
            return false;
        }
        }
    }

    priv fn slot_is_valid(slot: Slot) const -> bool {
        let owner_exists: bool = slot.function_id < this->source.function_count;
        let type_is_valid: bool = type_can_be_value(*this->types, slot.type_id);
        let alignment_is_bounded: bool = slot.alignment_bytes <= Limit.maximum_slot_alignment as usize;
        let alignment_is_power: bool = slot.alignment_bytes == 0 ||
            (slot.alignment_bytes & (slot.alignment_bytes - 1)) == 0;
        let identity_is_valid: bool = owner_exists && type_is_valid;
        let alignment_is_valid: bool = alignment_is_bounded && alignment_is_power;
        return identity_is_valid && alignment_is_valid;
    }

    priv fn slots_are_valid() const -> bool {
        for (var index: usize = 0; index < this->source.slot_count; index += 1) {
            if (!this->slot_is_valid(this->slots[index])) {
                return false;
            }
        }
        return true;
    }

    priv fn block_shape_is_valid(block: Block) const -> bool {
        if (block.function_id >= this->source.function_count) {
            return false;
        }
        if (block.instruction_count == 0) {
            let endpoints_are_empty: bool = block.first_instruction == no_id() && block.last_instruction == no_id();
            return endpoints_are_empty && !block.terminated;
        }
        let first_exists: bool = block.first_instruction < this->source.instruction_count;
        let last_exists: bool = block.last_instruction < this->source.instruction_count;
        let endpoints_exist: bool = first_exists && last_exists;
        return endpoints_exist && block.terminated;
    }

    priv fn block_chain_is_valid(block: Block, block_id: usize) const -> bool {
        var instruction_id: usize = block.first_instruction;
        var previous: usize = no_id();
        for (var visited: usize = 0; visited < block.instruction_count; visited += 1) {
            if (instruction_id >= this->source.instruction_count ||
                this->instructions[instruction_id].block_id != block_id) {
                return false;
            }
            let terminates_early: bool = opcode_is_terminator(this->instructions[instruction_id].opcode) &&
                visited + 1 != block.instruction_count;
            if (terminates_early) {
                return false;
            }
            previous = instruction_id;
            instruction_id = this->instructions[instruction_id].next_instruction;
        }
        if (block.instruction_count == 0) {
            return true;
        }
        let tail_matches: bool = previous == block.last_instruction && instruction_id == no_id();
        let tail_terminates: bool = opcode_is_terminator(this->instructions[block.last_instruction].opcode);
        return tail_matches && tail_terminates;
    }

    priv fn blocks_are_valid() const -> bool {
        var counted_instructions: usize = 0;
        for (var index: usize = 0; index < this->source.block_count; index += 1) {
            let block: Block = this->blocks[index];
            if (!this->block_shape_is_valid(block) || !this->block_chain_is_valid(block, index)) {
                return false;
            }
            counted_instructions += block.instruction_count;
        }
        return counted_instructions == this->source.instruction_count;
    }

    priv fn predecessor_count(block_id: usize) const -> usize {
        var count: usize = 0;
        for (var index: usize = 0; index < this->source.instruction_count; index += 1) {
            let instruction: Instruction = this->instructions[index];
            switch (instruction.opcode) {
            case Opcode.jump {
                if (instruction.auxiliary == block_id) {
                    count += 1;
                }
            }
            case Opcode.branch {
                if (instruction.auxiliary == block_id) {
                    count += 1;
                }
                if (instruction.third == block_id) {
                    count += 1;
                }
            }
            default {}
            }
        }
        return count;
    }

    priv fn predecessors_are_valid() const -> bool {
        for (var index: usize = 0; index < this->source.block_count; index += 1) {
            if (this->blocks[index].predecessor_count != this->predecessor_count(index)) {
                return false;
            }
        }
        return true;
    }

    priv fn instruction_result_is_valid(instruction: Instruction, instruction_id: usize) const -> bool {
        if (instruction.result == no_id()) {
            return true;
        }
        if (instruction.result >= this->source.value_count) {
            return false;
        }
        let value: Value = this->values[instruction.result];
        let definition_matches: bool = value.definition == instruction_id;
        let block_matches: bool = value.block_id == instruction.block_id;
        let type_matches: bool = value.type_id == instruction.type_id;
        let ownership_matches: bool = definition_matches && block_matches;
        return ownership_matches && type_matches;
    }

    priv fn instruction_is_valid(instruction: Instruction, instruction_id: usize) const -> bool {
        let opcode_is_in_range: bool = (instruction.opcode as usize) <= (Opcode.va_list_arg as usize);
        let opcode_is_valid: bool = opcode_is_in_range && instruction.opcode != Opcode.invalid;
        let block_exists: bool = instruction.block_id < this->source.block_count;
        let span_is_valid: bool = instruction.span.line != 0 && instruction.span.column != 0;
        let location_is_valid: bool = block_exists && span_is_valid;
        let type_is_valid: bool = instruction.type_id == no_id() || instruction.type_id < this->types->size();
        let identity_is_valid: bool = opcode_is_valid && location_is_valid;
        if (!identity_is_valid || !type_is_valid) {
            return false;
        }
        if (!this->instruction_result_is_valid(instruction, instruction_id)) {
            return false;
        }
        let function_id: usize = this->blocks[instruction.block_id].function_id;
        if (!instruction_operands_are_valid(
                instruction, instruction_id, function_id, this->source, this->values)) {
            return false;
        }
        return instruction_types_are_valid(
            instruction, function_id, *this->types, this->values, this->functions, this->slots);
    }

    priv fn call_parameter_count(instruction: Instruction) const -> usize {
        switch (instruction.opcode) {
        case Opcode.call {
            return this->functions[instruction.auxiliary].parameter_count;
        }
        case Opcode.call_indirect {
            let callee: type_info::Record = this->type_records[this->values[instruction.left].type_id];
            return callee.field_count;
        }
        default {
            return 0;
        }
        }
    }

    priv fn call_is_variadic(instruction: Instruction) const -> bool {
        switch (instruction.opcode) {
        case Opcode.call {
            return this->functions[instruction.auxiliary].variadic;
        }
        default {
            return false;
        }
        }
    }

    priv fn call_parameter_type(instruction: Instruction, parameter_index: usize) const -> usize {
        switch (instruction.opcode) {
        case Opcode.call {
            let function: Function = this->functions[instruction.auxiliary];
            return this->parameters[function.first_parameter + parameter_index].type_id;
        }
        case Opcode.call_indirect {
            let callee: type_info::Record = this->type_records[this->values[instruction.left].type_id];
            return this->type_fields[callee.first_field + parameter_index].type_id;
        }
        default {
            return no_id();
        }
        }
    }

    priv fn call_argument_value_is_valid(
        argument: Argument, instruction: Instruction, instruction_id: usize) const -> bool {
        if (argument.value_id >= this->source.value_count) {
            return false;
        }
        let value: Value = this->values[argument.value_id];
        let function_id: usize = this->blocks[instruction.block_id].function_id;
        let owner_matches: bool = value.function_id == function_id;
        let definition_precedes_call: bool = value.definition < instruction_id;
        return owner_matches && definition_precedes_call;
    }

    priv fn call_argument_is_valid(
        argument: Argument, instruction: Instruction, instruction_id: usize,
        parameter_index: usize, parameter_count: usize, variadic: bool) const -> bool {
        if (!this->call_argument_value_is_valid(argument, instruction, instruction_id)) {
            return false;
        }
        // 额外可变实参没有声明参数类型，调用点按其自身位宽分类。
        if (parameter_index >= parameter_count) {
            return variadic;
        }
        let parameter_type: usize = this->call_parameter_type(instruction, parameter_index);
        return carrier_matches_type(*this->types, this->values[argument.value_id].type_id, parameter_type);
    }

    priv fn call_arguments_are_valid(instruction: Instruction, instruction_id: usize) const -> bool {
        let parameter_count: usize = this->call_parameter_count(instruction);
        let variadic: bool = this->call_is_variadic(instruction);
        var argument_count: usize = 0;
        for (var index: usize = 0; index < this->source.argument_count; index += 1) {
            let argument: Argument = this->arguments[index];
            if (argument.instruction_id != instruction_id) {
                continue;
            }
            if (!this->call_argument_is_valid(
                    argument, instruction, instruction_id, argument_count, parameter_count, variadic)) {
                return false;
            }
            argument_count += 1;
        }
        return variadic ? argument_count >= parameter_count : argument_count == parameter_count;
    }

    priv fn instructions_are_valid() const -> bool {
        for (var index: usize = 0; index < this->source.instruction_count; index += 1) {
            let instruction: Instruction = this->instructions[index];
            if (!this->instruction_is_valid(instruction, index)) {
                return false;
            }
            if (instruction_is_call(instruction.opcode) && !this->call_arguments_are_valid(instruction, index)) {
                return false;
            }
        }
        return true;
    }

    priv fn argument_is_valid(argument: Argument) const -> bool {
        let instruction_exists: bool = argument.instruction_id < this->source.instruction_count;
        let value_exists: bool = argument.value_id < this->source.value_count;
        if (!instruction_exists || !value_exists) {
            return false;
        }
        return instruction_is_call(this->instructions[argument.instruction_id].opcode);
    }

    priv fn arguments_are_valid() const -> bool {
        for (var index: usize = 0; index < this->source.argument_count; index += 1) {
            if (!this->argument_is_valid(this->arguments[index])) {
                return false;
            }
        }
        return true;
    }

    fn run() -> bool {
        if (!this->input_is_valid()) {
            return false;
        }
        if (!this->globals_are_valid() || !this->functions_are_valid()) {
            return false;
        }
        if (!this->function_totals_are_valid() || !this->entry_is_valid()) {
            return false;
        }
        if (!this->slots_are_valid() || !this->blocks_are_valid()) {
            return false;
        }
        if (!this->predecessors_are_valid() || !this->instructions_are_valid()) {
            return false;
        }
        return this->arguments_are_valid();
    }
}

impl Module {
    fn is_valid(types: type_info::TypeTable const&) const -> bool {
        if (!this->storage_is_valid()) {
            return false;
        }
        var verifier: Verifier = Verifier(this->view(), types);
        return verifier.run();
    }
}
