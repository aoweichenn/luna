module luna.compiler.types;

struct RecordLayout {
    size: usize;
    alignment: usize;
    has_flexible_field: bool;
    valid: bool;
}

fn initial_record_layout(records: *const Record, record: Record) -> RecordLayout {
    var layout: RecordLayout = {size = 0, alignment = 1, has_flexible_field = false, valid = true};
    let class_has_base: bool = record.kind == Kind.class_type && record.base_type != no_id();
    if (class_has_base) {
        layout.size = records[record.base_type].size_bytes;
        layout.alignment = records[record.base_type].alignment_bytes;
    }
    let class_has_vptr: bool = record.kind == Kind.class_type && record.vptr_offset != no_id();
    if (!class_has_vptr) {
        if (class_has_base && records[record.base_type].vptr_offset != no_id()) {
            layout.valid = false;
        }
        return layout;
    }
    let base_vptr: usize = class_has_base ? records[record.base_type].vptr_offset : no_id();
    if (base_vptr != no_id()) {
        layout.valid = record.vptr_offset == base_vptr;
        return layout;
    }
    let pointer_alignment: usize = TypeLimit.target_pointer_alignment as usize;
    let pointer_mask: usize = pointer_alignment - 1;
    if (layout.size > (TypeLimit.maximum_size as usize) - pointer_mask) {
        layout.valid = false;
        return layout;
    }
    let expected_vptr: usize = (layout.size + pointer_mask) & ~pointer_mask;
    let offset_matches: bool = record.vptr_offset == expected_vptr;
    let size_is_bounded: bool = expected_vptr <= (TypeLimit.maximum_size as usize) - (TypeLimit.target_pointer_bytes as
        usize);
    if (!offset_matches || !size_is_bounded) {
        layout.valid = false;
        return layout;
    }
    layout.size = expected_vptr + (TypeLimit.target_pointer_bytes as usize);
    if (layout.alignment < pointer_alignment) {
        layout.alignment = pointer_alignment;
    }
    return layout;
}

fn field_alignment_is_valid(alignment: usize) -> bool {
    if (alignment == 0) {
        return true;
    }
    let is_power_of_two: bool = (alignment & (alignment - 1)) == 0;
    return alignment <= (TypeLimit.maximum_alignment as usize) && is_power_of_two;
}

fn append_field_layout(
    layout: RecordLayout, record_id: usize, record: Record, field_index: usize,
    field: Field, field_type: Record, is_union: bool, is_packed: bool) -> RecordLayout {
    var result: RecordLayout = layout;
    if (field.owner_type != record_id || !field_alignment_is_valid(field.alignment_bytes)) {
        result.valid = false;
        return result;
    }
    let flexible: bool = (field_type.flags & (Flag.flexible as usize)) != 0;
    let flexible_position_is_invalid: bool = is_union || field_index + 1 != record.field_count;
    if (flexible && flexible_position_is_invalid) {
        result.valid = false;
        return result;
    }
    result.has_flexible_field = result.has_flexible_field || flexible;
    var alignment: usize = field.alignment_bytes > field_type.alignment_bytes ?
        field.alignment_bytes : field_type.alignment_bytes;
    if (is_packed) {
        alignment = 1;
    }
    if (alignment > result.alignment) {
        result.alignment = alignment;
    }
    if (is_union) {
        if (field.offset_bytes != 0) {
            result.valid = false;
            return result;
        }
        if (field_type.size_bytes > result.size) {
            result.size = field_type.size_bytes;
        }
        return result;
    }
    let mask: usize = alignment - 1;
    if (result.size > (TypeLimit.maximum_size as usize) - mask) {
        result.valid = false;
        return result;
    }
    let expected_offset: usize = (result.size + mask) & ~mask;
    let offset_matches: bool = field.offset_bytes == expected_offset;
    let field_fits: bool = field_type.size_bytes <= (TypeLimit.maximum_size as usize) - expected_offset;
    if (!offset_matches || !field_fits) {
        result.valid = false;
        return result;
    }
    result.size = expected_offset + field_type.size_bytes;
    return result;
}

fn final_record_layout_is_valid(record: Record, layout: RecordLayout) -> bool {
    var expected_size: usize = layout.size == 0 ? 1 : layout.size;
    let header: bool = (record.flags & (Flag.header as usize)) != 0;
    if (header != layout.has_flexible_field) {
        return false;
    }
    let alignment_is_power: bool =
        record.alignment_bytes != 0 && (record.alignment_bytes & (record.alignment_bytes - 1)) == 0;
    let alignment_is_large_enough: bool = record.alignment_bytes >= layout.alignment;
    let alignment_is_bounded: bool = record.alignment_bytes <= (TypeLimit.maximum_alignment as usize);
    let alignment_range_is_valid: bool = alignment_is_large_enough && alignment_is_bounded;
    if (!alignment_is_power || !alignment_range_is_valid) {
        return false;
    }
    let alignment_mask: usize = record.alignment_bytes - 1;
    if (expected_size > (TypeLimit.maximum_size as usize) - alignment_mask) {
        return false;
    }
    expected_size = (expected_size + alignment_mask) & ~alignment_mask;
    return record.size_bytes == expected_size;
}

fn record_layout_is_valid(records: *const Record, fields: *const Field, record_id: usize, record: Record) -> bool {
    var layout: RecordLayout = initial_record_layout(records, record);
    if (!layout.valid) {
        return false;
    }
    let is_union: bool = record.kind == Kind.record_union;
    let is_packed: bool = (record.flags & (Flag.packed as usize)) != 0;
    for (var field_index: usize = 0; field_index < record.field_count; field_index += 1) {
        let field: Field = fields[record.first_field + field_index];
        layout = append_field_layout(
            layout, record_id, record, field_index, field, records[field.type_id], is_union, is_packed);
        if (!layout.valid) {
            return false;
        }
    }
    return final_record_layout_is_valid(record, layout);
}

fn enum_layout_is_valid(records: *const Record, record: Record) -> bool {
    let underlying: Record = records[record.element_type];
    let size_matches: bool = record.size_bytes == underlying.size_bytes;
    let alignment_matches: bool = record.alignment_bytes == underlying.alignment_bytes;
    let layout_matches: bool = size_matches && alignment_matches;
    return layout_matches && record.field_count == 0;
}

fn layouts_are_valid(table: TypeTable const&, records: *const Record, fields: *const Field) -> bool {
    for (var index: usize = BuiltinType.count as usize; index < table.size(); index += 1) {
        let record: Record = records[index];
        if (record.kind == Kind.enumeration && !enum_layout_is_valid(records, record)) {
            return false;
        }
        if (is_record(record.kind) && !record_layout_is_valid(records, fields, index, record)) {
            return false;
        }
    }
    return true;
}

fn validate_table(table: TypeTable const&, require_complete: bool) -> bool {
    let storage_is_ready: bool = table.storage_is_valid() && table.error() == runtime::Error.none;
    if (!storage_is_ready || table.size() < BuiltinType.count as usize) {
        return false;
    }
    let records: *const Record = table.record_data() as *const Record;
    let fields: *const Field = table.field_data() as *const Field;
    if (!records_are_valid(table, records, fields, require_complete)) {
        return false;
    }
    if (!fields_are_valid(table, records, fields)) {
        return false;
    }
    return layouts_are_valid(table, records, fields);
}

impl TypeTable {
    priv fn fixed_array_element_is_valid(element_type: usize) const -> bool {
        return fixed_array_element_is_valid(*this, this->record_data(), element_type);
    }

    priv fn flexible_array_element_is_valid(element_type: usize) const -> bool {
        return flexible_array_element_is_valid(*this, this->record_data(), element_type);
    }

    fn is_valid(require_complete: bool) const -> bool {
        return validate_table(*this, require_complete);
    }
}
