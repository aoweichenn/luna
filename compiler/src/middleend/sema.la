module luna.bootstrap.middleend.sema;

import luna.bootstrap.middleend.semantic.types.visibility as visibility;

import luna.bootstrap.middleend.semantic.context.lookup as names;

import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.classes as classes;
import luna.bootstrap.middleend.semantic.consteval as consteval;
import luna.bootstrap.middleend.semantic.consteval.engine as const_engine;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.bootstrap.middleend.semantic.functions.ir as function_ir;
import luna.bootstrap.middleend.semantic.generics.model as generic_model;
import luna.bootstrap.middleend.semantic.modules as modules;
import luna.bootstrap.middleend.semantic.stmt as stmt;
import luna.bootstrap.middleend.semantic.types as types;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime as runtime;

fn select_entry(context: *context::Context) -> bool {
    if (!context->input.executable) {
        return modules::validate_reachability(context, names::unit_module(context, 0));
    }
    let none: usize = context::no_id();
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    var entry: usize = none;
    var function_id: usize = 0;
    while (function_id < context->function_count) {
        let function: context::Function = functions[function_id];
        let symbol: context::Symbol = symbols[function.symbol_id];
        if (function.implementation_unit != none &&
            context::token_equals_bytes(
                context, symbol.declaration_unit, symbol.name_token, "main", 4)) {
            if (entry != none) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.duplicate_function, symbol.declaration_unit,
                    context::token(context, symbol.declaration_unit, symbol.name_token).span,
                    symbols[functions[entry].symbol_id].declaration_unit,
                    context::token(
                        context, symbols[functions[entry].symbol_id].declaration_unit,
                        symbols[functions[entry].symbol_id].name_token).span, function_id);
            }
            entry = function_id;
        }
        function_id += 1;
    }
    if (entry == none) {
        context::add_diagnostic(
            context, context::DiagnosticKind.missing_definition, 0, context::empty_span(), none, context::empty_span(),
            0);
        return false;
    }
    let entry_function: context::Function = functions[entry];
    var has_command_line_parameters: bool = false;
    if (entry_function.parameter_count == 2) {
        let parameters: *const context::Parameter = context->parameters.data as
                *const context::Parameter;
        let argument_count_type: usize = parameters[entry_function.first_parameter].type_id;
        let argument_vector_type: usize = parameters[entry_function.first_parameter + 1].type_id;
        let outer: type_info::Record = context::type_record(context, argument_vector_type);
        if (outer.kind == type_info::Kind.pointer && (outer.flags & (type_info::Flag.read_only as usize)) == 0) {
            let inner: type_info::Record = context::type_record(context, outer.element_type);
            has_command_line_parameters = argument_count_type == type_info::BuiltinType.unsigned_size as usize &&
                inner.kind == type_info::Kind.pointer && (inner.flags & (type_info::Flag.read_only as usize)) != 0 &&
                inner.element_type == type_info::BuiltinType.unsigned_8 as usize;
        }
    }
    if ((entry_function.parameter_count != 0 && !has_command_line_parameters) || entry_function.return_type !=
            type_info::BuiltinType.signed_32 as usize || (entry_function.flags &
            (context::SymbolFlag.external as usize)) != 0) {
        let symbol: context::Symbol = symbols[entry_function.symbol_id];
        context::add_diagnostic(
            context, context::DiagnosticKind.signature_mismatch, symbol.declaration_unit,
            context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
            none, context::empty_span(), entry);
        return false;
    }
    ir::set_entry(&context->ir, entry_function.ir_function);
    return modules::validate_reachability(context, names::unit_module(context, entry_function.implementation_unit));
}

fn check(input: context::Input) -> context::Result {
    var context: context::Context = context::context_init(input);
    if (!context::input_is_valid(input)) {
        context::add_diagnostic(
            &context, context::DiagnosticKind.invalid_input, context::no_id(), context::empty_span(), context::no_id(),
            context::empty_span(), 0);
        return {
            types = context.types, ir = context.ir, diagnostics = context.diagnostics, error = context.error,
        };
    }

    modules::collect_modules(&context);
    modules::collect_imports(&context);
    modules::validate_import_graph(&context);
    attributes::validate_attributes(&context);
    types::collect_named_types(&context);
    classes::collect_classes(&context);
    classes::collect_bases(&context);
    classes::prepare_layouts(&context);
    functions::collect_const_functions(&context);
    consteval::collect_constant_declarations(&context);
    consteval::prescan_array_lengths(&context);
    consteval::resolve_alignment_attributes(&context);
    consteval::resolve_bitfield_attributes(&context);
    types::resolve_all_types(&context);
    classes::collect_friends(&context);
    classes::collect_fields(&context);
    classes::validate_classes(&context);
    consteval::validate_bitfields(&context);
    const_engine::resolve_constants(&context);
    consteval::finalize_enum_constants(&context);
    functions::collect_functions(&context);
    classes::collect_methods(&context);
    classes::validate_methods(&context);
    consteval::check_module_asserts(&context);
    modules::validate_imported_names(&context);
    visibility::validate_public_types(&context);
    function_ir::create_ir_functions(&context);
    classes::create_vtables(&context);
    stmt::lower_functions(&context);
    select_entry(&context);
    if (context.error == runtime::Error.none && !generic_model::is_valid(context.generics)) {
        context.error = runtime::Error.invalid_argument;
    }

    let work_error: runtime::Error = context::context_release_work(&context);
    if (context.error == runtime::Error.none) {
        context.error = work_error;
    }
    return {
        types = context.types, ir = context.ir, diagnostics = context.diagnostics, error = context.error,
    };
}
