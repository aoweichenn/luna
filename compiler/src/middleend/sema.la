module luna.bootstrap.middleend.sema;

import luna.bootstrap.middleend.semantic.context.lookup as names;

import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.classes as classes;
import luna.bootstrap.middleend.semantic.consteval as consteval;
import luna.bootstrap.middleend.semantic.consteval.engine as const_engine;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.bootstrap.middleend.semantic.modules as modules;
import luna.bootstrap.middleend.semantic.stmt as stmt;
import luna.bootstrap.middleend.semantic.types as types;
import luna.compiler.ir as ir;
import luna.compiler.types as type_info;
import luna.runtime as runtime;

enum SemanticPhase: usize {
    ready, complete, transferred,
}

type SemanticPass = fn(*context::Context) -> bool;

class SemanticSession {
    priv state: context::Context;
    priv phase: SemanticPhase;

    pub init(input: context::InputView);
    pub fn run();
    pub fn take_result() -> context::SemanticResult;
    pub deinit();
}

impl SemanticSession {
    init(input: context::InputView): state = context::context_init(input) {
        this->phase = SemanticPhase.ready;
    }

    priv fn run_pass(pass: SemanticPass) {
        if (this->state.error != runtime::Error.none) {
            return;
        }
        let completed: bool = pass(&this->state);
        if (!completed && this->state.error == runtime::Error.none) {
            this->state.error = runtime::Error.invalid_argument;
        }
    }

    priv fn validate_reachability(root_module: usize) {
        let diagnostic_count: usize = this->state.diagnostics.size();
        let completed: bool = modules::validate_reachability(&this->state, root_module);
        let no_runtime_error: bool = this->state.error == runtime::Error.none;
        let no_diagnostic: bool = this->state.diagnostics.size() == diagnostic_count;
        let unexplained_failure: bool = !completed && no_runtime_error;
        if (unexplained_failure && no_diagnostic) {
            this->state.error = runtime::Error.invalid_argument;
        }
    }

    priv fn select_entry() {
        let session: *context::Context = &this->state;
        if (session->error != runtime::Error.none) {
            return;
        }
        if (!session->input.executable()) {
            this->validate_reachability(names::unit_module(session, 0));
            return;
        }
        let none: usize = context::no_id();
        let functions: *const context::Function = session->functions.data as *const context::Function;
        let symbols: *const context::Symbol = session->symbols.data as *const context::Symbol;
        var entry: usize = none;
        for (var function_id: usize = 0; function_id < session->function_count; function_id += 1) {
            let function: context::Function = functions[function_id];
            let symbol: context::Symbol = symbols[function.symbol_id];
            let has_implementation: bool = function.implementation_unit != none;
            let is_main: bool = context::token_equals_bytes(
                session, symbol.declaration_unit, symbol.name_token, "main", 4);
            if (has_implementation && is_main) {
                if (entry != none) {
                    context::add_diagnostic(
                        session, context::DiagnosticKind.duplicate_function, symbol.declaration_unit,
                        context::token(session, symbol.declaration_unit, symbol.name_token).span,
                        symbols[functions[entry].symbol_id].declaration_unit,
                        context::token(
                            session, symbols[functions[entry].symbol_id].declaration_unit,
                            symbols[functions[entry].symbol_id].name_token).span, function_id);
                }
                entry = function_id;
            }
        }
        if (entry == none) {
            context::add_diagnostic(
                session, context::DiagnosticKind.missing_definition, 0, context::empty_span(), none,
                context::empty_span(), 0);
            return;
        }
        let entry_function: context::Function = functions[entry];
        var has_command_line_parameters: bool = false;
        if (entry_function.parameter_count == 2) {
            let parameters: *const context::Parameter = session->parameters.data as *const context::Parameter;
            let argument_count_type: usize = parameters[entry_function.first_parameter].type_id;
            let argument_vector_type: usize = parameters[entry_function.first_parameter + 1].type_id;
            let outer: type_info::Record = context::type_record(session, argument_vector_type);
            let outer_is_pointer: bool = outer.kind == type_info::Kind.pointer;
            let outer_is_mutable: bool = (outer.flags & (type_info::Flag.read_only as usize)) == 0;
            if (outer_is_pointer && outer_is_mutable) {
                let inner: type_info::Record = context::type_record(session, outer.element_type);
                let count_type_is_valid: bool = argument_count_type == type_info::BuiltinType.unsigned_size as usize;
                let inner_is_pointer: bool = inner.kind == type_info::Kind.pointer;
                let inner_is_read_only: bool = (inner.flags & (type_info::Flag.read_only as usize)) != 0;
                let character_type_is_valid: bool = inner.element_type == type_info::BuiltinType.unsigned_8 as usize;
                let inner_pointer_is_valid: bool = inner_is_pointer && inner_is_read_only;
                has_command_line_parameters = count_type_is_valid && inner_pointer_is_valid;
                has_command_line_parameters = has_command_line_parameters && character_type_is_valid;
            }
        }
        let parameters_are_valid: bool = entry_function.parameter_count == 0 || has_command_line_parameters;
        let return_type_is_valid: bool = entry_function.return_type == type_info::BuiltinType.signed_32 as usize;
        let function_is_external: bool = (entry_function.flags & (context::SymbolFlag.external as usize)) != 0;
        let signature_is_valid: bool = parameters_are_valid && return_type_is_valid;
        if (!signature_is_valid || function_is_external) {
            let symbol: context::Symbol = symbols[entry_function.symbol_id];
            context::add_diagnostic(
                session, context::DiagnosticKind.signature_mismatch, symbol.declaration_unit,
                context::node(session, symbol.declaration_unit, symbol.declaration_node).span,
                none, context::empty_span(), entry);
            return;
        }
        if (!session->ir.set_entry(entry_function.ir_function)) {
            session->error = session->ir.error();
            return;
        }
        this->validate_reachability(names::unit_module(session, entry_function.implementation_unit));
    }

    priv fn finish() {
        let work_error: runtime::Error = context::context_release_work(&this->state);
        if (this->state.error == runtime::Error.none) {
            this->state.error = work_error;
        }
        this->phase = SemanticPhase.complete;
    }

    fn run() {
        if (this->phase != SemanticPhase.ready) {
            this->state.error = runtime::Error.invalid_argument;
            return;
        }
        if (!this->state.input.is_valid()) {
            context::add_diagnostic(
                &this->state, context::DiagnosticKind.invalid_input, context::no_id(), context::empty_span(),
                context::no_id(), context::empty_span(), 0);
            this->finish();
            return;
        }

        this->run_pass(modules::collect_modules);
        this->run_pass(modules::collect_imports);
        this->run_pass(modules::validate_import_graph);
        this->run_pass(attributes::validate_attributes);
        this->run_pass(types::collect_named_types);
        this->run_pass(classes::collect_classes);
        this->run_pass(classes::collect_bases);
        this->run_pass(classes::prepare_layouts);
        this->run_pass(functions::collect_const_functions);
        this->run_pass(consteval::collect_constant_declarations);
        this->run_pass(consteval::prescan_array_lengths);
        this->run_pass(consteval::resolve_alignment_attributes);
        this->run_pass(consteval::resolve_bitfield_attributes);
        this->run_pass(types::resolve_all_types);
        this->run_pass(classes::collect_friends);
        this->run_pass(classes::collect_fields);
        this->run_pass(classes::validate_classes);
        this->run_pass(consteval::validate_bitfields);
        this->run_pass(const_engine::resolve_constants);
        this->run_pass(consteval::finalize_enum_constants);
        this->run_pass(functions::collect_functions);
        this->run_pass(classes::collect_methods);
        this->run_pass(classes::validate_methods);
        this->run_pass(consteval::check_module_asserts);
        this->run_pass(modules::validate_imported_names);
        this->run_pass(types::validate_public_types);
        this->run_pass(functions::create_ir_functions);
        this->run_pass(classes::create_vtables);
        this->run_pass(stmt::lower_functions);
        this->select_entry();
        if (this->state.error == runtime::Error.none && !this->state.generics.is_valid()) {
            this->state.error = runtime::Error.invalid_argument;
        }
        this->finish();
    }

    fn take_result() -> context::SemanticResult {
        if (this->phase != SemanticPhase.complete) {
            return {
                types = type_info::TypeTable(), ir = ir::Module(), diagnostics = context::DiagnosticBuffer(),
                error = runtime::Error.invalid_argument,
            };
        }
        var built_ir: ir::Module = this->state.ir.take_module();
        this->phase = SemanticPhase.transferred;
        return {
            types = this->state.types as type_info::TypeTable&&, ir = built_ir as ir::Module&&,
            diagnostics = this->state.diagnostics as context::DiagnosticBuffer&&, error = this->state.error,
        };
    }

    deinit() {
        if (this->phase == SemanticPhase.ready) {
            context::context_release_work(&this->state);
        }
    }
}

fn check(input: context::InputView) -> context::SemanticResult {
    var session: SemanticSession = SemanticSession(input);
    session.run();
    return session.take_result();
}
