module luna.bootstrap.middleend.ir;

import luna.std.checked as checked;

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty_span() -> lexer::SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn invalid_function() -> Function {
    let none: usize = no_id();
    return {
        declaration_unit = none, declaration_node = none, name_token = none, linkage = Linkage.internal,
        return_type = none, first_parameter = none, parameter_count = 0, first_slot = none, slot_count = 0,
        first_block = none, block_count = 0, first_value = none, value_count = 0, has_body = false, variadic = false,
        signature_offset = none, signature_length = 0, export_name_unit = none, export_name_token = none,
        asm_body_unit = none, asm_body_node = none,
    };
}

fn invalid_block() -> Block {
    let none: usize = no_id();
    return {
        function_id = none, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
}

fn invalid_instruction()
    -> Instruction {
    let none: usize = no_id();
    return {
        opcode = Opcode.invalid, operation = lexer::TokenKind.invalid, type_id = none, result = none,
        left = none, right = none, third = none, auxiliary = none, immediate = 0, floating = 0.0, block_id = none,
        next_instruction = none, span = empty_span(),
    };
}

fn empty() -> Store {
    return {
        globals = bytes::empty(), global_count = 0, global_bytes = bytes::empty(),
        global_references = bytes::empty(), global_reference_count = 0,
        functions = bytes::empty(), function_count = 0, callable_signatures = bytes::empty(),
            parameters = bytes::empty(),
        parameter_count = 0, slots = bytes::empty(), slot_count = 0, values = bytes::empty(),
        value_count = 0, blocks = bytes::empty(), block_count = 0, instructions = bytes::empty(),
        instruction_count = 0, arguments = bytes::empty(), argument_count = 0,
        entry_function = no_id(), error = runtime::Error.none,
    };
}

fn buffer_matches(buffer: bytes::Buffer, count: usize, record_size: usize) -> bool {
    let storage_is_valid: bool = bytes::is_valid(buffer) && record_size != 0;
    if (!storage_is_valid) {
        return false;
    }
    let shape_is_valid: bool = buffer.length % record_size == 0;
    return shape_is_valid && count == buffer.length / record_size;
}

struct StoreValidator {
    valid: bool;
}

fn store_require(validator: *StoreValidator, requirement: bool) {
    validator->valid = validator->valid && requirement;
}

fn function_signature_is_valid(function: Function, expected_offset: usize, signatures: bytes::Buffer) -> bool {
    let position_is_valid: bool = function.signature_length != 0 && function.signature_offset == expected_offset;
    let range_is_valid: bool = checked::range_is_valid(
        function.signature_offset, function.signature_length, signatures.length);
    return position_is_valid && range_is_valid;
}

fn function_signatures_are_valid(ir: Store) -> bool {
    if (!bytes::is_valid(ir.callable_signatures) || !buffer_matches(ir.functions, ir.function_count,
        sizeof(Function))) {
        return false;
    }
    let functions: *const Function = ir.functions.data as *const Function;
    var expected_offset: usize = 0;
    for (var index: usize = 0; index < ir.function_count; index += 1) {
        let function: Function = functions[index];
        if (!function_signature_is_valid(function, expected_offset, ir.callable_signatures)) {
            return false;
        }
        expected_offset += function.signature_length;
    }
    return expected_offset == ir.callable_signatures.length;
}

fn storage_is_valid(ir: Store) -> bool {
    var validator: StoreValidator = {valid = true};
    store_require(&validator, buffer_matches(ir.globals, ir.global_count, sizeof(Global)) &&
        bytes::is_valid(ir.global_bytes));
    store_require(&validator, buffer_matches(
        ir.global_references, ir.global_reference_count, sizeof(GlobalReference)));
    store_require(&validator, buffer_matches(ir.functions, ir.function_count, sizeof(Function)) &&
        bytes::is_valid(ir.callable_signatures));
    store_require(&validator, buffer_matches(ir.parameters, ir.parameter_count, sizeof(Parameter)));
    store_require(&validator, buffer_matches(ir.slots, ir.slot_count, sizeof(Slot)));
    store_require(&validator, buffer_matches(ir.values, ir.value_count, sizeof(Value)));
    store_require(&validator, buffer_matches(ir.blocks, ir.block_count, sizeof(Block)));
    store_require(&validator, buffer_matches(ir.instructions, ir.instruction_count, sizeof(Instruction)));
    store_require(&validator, buffer_matches(ir.arguments, ir.argument_count, sizeof(Argument)));
    return validator.valid;
}

fn get_function(ir: Store, function_id: usize) -> FunctionResult {
    if (!storage_is_valid(ir) || function_id >= ir.function_count) {
        return {
            function = invalid_function(), error = runtime::Error.invalid_argument,
        };
    }
    let functions: *const Function = ir.functions.data as *const Function;
    return {
        function = functions[function_id], error = runtime::Error.none,
    };
}

fn get_block(ir: Store, block_id: usize) -> BlockResult {
    if (!storage_is_valid(ir) || block_id >= ir.block_count) {
        return {
            block = invalid_block(), error = runtime::Error.invalid_argument,
        };
    }
    let blocks: *const Block = ir.blocks.data as *const Block;
    return {
        block = blocks[block_id], error = runtime::Error.none,
    };
}

fn get_instruction(ir: Store, instruction_id: usize) -> InstructionResult {
    if (!storage_is_valid(ir) || instruction_id >= ir.instruction_count) {
        return {
            instruction = invalid_instruction(), error = runtime::Error.invalid_argument,
        };
    }
    let instructions: *const Instruction = ir.instructions.data as *const Instruction;
    return {
        instruction = instructions[instruction_id], error = runtime::Error.none,
    };
}

fn append(buffer: bytes::Buffer, data: *const u8, length: usize) -> bytes::BufferResult {
    if (length == 0 || data == null) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }
    return bytes::append(buffer, data, length);
}

fn set_error(ir: *Store, error: runtime::Error) -> bool {
    if (ir == null) {
        return false;
    }
    if (ir->error == runtime::Error.none) {
        ir->error = error;
    }
    return false;
}

fn first_error(current: runtime::Error, next: runtime::Error) -> runtime::Error {
    return current == runtime::Error.none ? next : current;
}

fn empty_function_shape_is_valid(function: Function) -> bool {
    let none: usize = no_id();
    var validator: StoreValidator = {valid = true};
    store_require(&validator, function.declaration_unit != none && function.declaration_node != none);
    store_require(&validator, function.name_token != none && function.return_type != none);
    store_require(&validator, function.parameter_count == 0 && function.slot_count == 0);
    store_require(&validator, function.block_count == 0 && function.value_count == 0);
    store_require(&validator, function.signature_offset == none && function.signature_length == 0);
    return validator.valid;
}

fn function_add_request_is_valid(
    ir: *const Store, function: Function, signature: *const u8, signature_length: usize) -> bool {
    var validator: StoreValidator = {valid = true};
    store_require(&validator, ir->error == runtime::Error.none && storage_is_valid(*ir));
    store_require(&validator, empty_function_shape_is_valid(function));
    store_require(&validator, signature != null && signature_length != 0);
    return validator.valid;
}

fn alignment_is_valid(alignment_bytes: usize) -> bool {
    let alignment_is_bounded: bool = alignment_bytes != 0 && alignment_bytes <= Limit.maximum_alignment as usize;
    return alignment_is_bounded && (alignment_bytes & (alignment_bytes - 1)) == 0;
}

fn global_add_request_is_valid(ir: *const Store, data: *const u8, byte_count: usize, alignment_bytes: usize) -> bool {
    var validator: StoreValidator = {valid = true};
    store_require(&validator, ir->error == runtime::Error.none && storage_is_valid(*ir));
    store_require(&validator, data != null && byte_count != 0);
    store_require(&validator, alignment_is_valid(alignment_bytes));
    return validator.valid;
}

fn add_global(ir: *Store, data: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize {
    let none: usize = no_id();
    if (ir == null) {
        return none;
    }
    if (!global_add_request_is_valid(ir as *const Store, data, byte_count, alignment_bytes)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let byte_offset: usize = ir->global_bytes.length;
    let appended_bytes: bytes::BufferResult = bytes::append(ir->global_bytes, data, byte_count);
    ir->global_bytes = appended_bytes.buffer;
    if (appended_bytes.error != runtime::Error.none) {
        set_error(ir, appended_bytes.error);
        return none;
    }
    let global: Global = {
        byte_offset = byte_offset, byte_count = byte_count, alignment_bytes = alignment_bytes,
        first_reference = none, reference_count = 0, read_only = read_only,
    };
    let appended: bytes::BufferResult = append(ir->globals, (&global) as *const Global as *const u8, sizeof(Global));
    ir->globals = appended.buffer;
    if (appended.error != runtime::Error.none) {
        let truncated: bytes::BufferResult = bytes::truncate(ir->global_bytes, byte_offset);
        ir->global_bytes = truncated.buffer;
        set_error(ir, appended.error);
        return none;
    }
    let global_id: usize = ir->global_count;
    ir->global_count += 1;
    return global_id;
}

fn global_reference_range_is_valid(global: Global, byte_offset: usize) -> bool {
    let address_bytes: usize = Limit.function_address_bytes as usize;
    let placeholder_fits: bool = checked::range_is_valid(byte_offset, address_bytes, global.byte_count);
    let placeholder_is_aligned: bool = global.alignment_bytes == address_bytes &&
        (byte_offset & (address_bytes - 1)) == 0;
    return placeholder_fits && placeholder_is_aligned;
}

fn global_reference_bytes_are_zero(ir: *const Store, global: Global, byte_offset: usize) -> bool {
    var storage_offset: usize = 0;
    let address_bytes: usize = Limit.function_address_bytes as usize;
    let offset_is_valid: bool = checked::add(global.byte_offset, byte_offset, &storage_offset);
    let range_is_valid: bool = offset_is_valid && checked::range_is_valid(
        storage_offset, address_bytes, ir->global_bytes.length);
    if (!range_is_valid) {
        return false;
    }
    for (var index: usize = 0; index < address_bytes; index += 1) {
        if (ir->global_bytes.data[storage_offset + index] != 0) {
            return false;
        }
    }
    return true;
}

fn global_reference_extends_slice(ir: *const Store, global: Global, global_id: usize, byte_offset: usize) -> bool {
    if (global.reference_count == 0) {
        return global.first_reference == no_id();
    }
    var expected_next: usize = 0;
    if (!checked::add(global.first_reference, global.reference_count, &expected_next)) {
        return false;
    }
    if (expected_next != ir->global_reference_count) {
        return false;
    }
    let references: *const GlobalReference = ir->global_references.data as *const GlobalReference;
    let previous: GlobalReference = references[expected_next - 1];
    var previous_end: usize = 0;
    if (!checked::add(previous.byte_offset, Limit.function_address_bytes as usize, &previous_end)) {
        return false;
    }
    let same_global: bool = previous.global_id == global_id;
    let follows_previous: bool = previous_end <= byte_offset;
    return same_global && follows_previous;
}

fn global_reference_target_is_valid(ir: *const Store, kind: GlobalReferenceKind, target_id: usize) -> bool {
    switch (kind) {
    case GlobalReferenceKind.function {
        return target_id < ir->function_count;
    }
    case GlobalReferenceKind.global {
        return target_id < ir->global_count;
    }
    default {
        return false;
    }
    }
}

fn global_reference_request_is_valid(
    ir: *const Store, global_id: usize, byte_offset: usize, kind: GlobalReferenceKind, target_id: usize) -> bool {
    var validator: StoreValidator = {valid = true};
    store_require(&validator, ir->error == runtime::Error.none && storage_is_valid(*ir));
    store_require(&validator, global_id < ir->global_count && global_reference_target_is_valid(ir, kind, target_id));
    if (!validator.valid) {
        return false;
    }
    let globals: *const Global = ir->globals.data as *const Global;
    let global: Global = globals[global_id];
    store_require(&validator, global.read_only && global_reference_range_is_valid(global, byte_offset));
    store_require(&validator, global_reference_bytes_are_zero(ir, global, byte_offset));
    store_require(&validator, global_reference_extends_slice(ir, global, global_id, byte_offset));
    return validator.valid;
}

fn add_global_reference_kind(
    ir: *Store, global_id: usize, byte_offset: usize, kind: GlobalReferenceKind, target_id: usize) -> bool {
    if (ir == null) {
        return false;
    }
    if (!global_reference_request_is_valid(
            ir as *const Store, global_id, byte_offset, kind, target_id)) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let reference: GlobalReference = {
        global_id = global_id, byte_offset = byte_offset, kind = kind, target_id = target_id,
    };
    let appended: bytes::BufferResult = append(
        ir->global_references, (&reference) as *const GlobalReference as *const u8, sizeof(GlobalReference));
    ir->global_references = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return set_error(ir, appended.error);
    }
    let globals: *Global = ir->globals.data as *Global;
    if (globals[global_id].reference_count == 0) {
        globals[global_id].first_reference = ir->global_reference_count;
    }
    globals[global_id].reference_count += 1;
    ir->global_reference_count += 1;
    return true;
}

fn add_global_reference(ir: *Store, global_id: usize, byte_offset: usize, target_global_id: usize) -> bool {
    return add_global_reference_kind(ir, global_id, byte_offset, GlobalReferenceKind.global, target_global_id);
}

fn add_global_function_reference(ir: *Store, global_id: usize, byte_offset: usize, function_id: usize) -> bool {
    return add_global_reference_kind(ir, global_id, byte_offset, GlobalReferenceKind.function, function_id);
}

fn add_function(ir: *Store, function: Function, signature: *const u8, signature_length: usize) -> usize {
    let none: usize = no_id();
    if (ir == null) {
        return none;
    }
    if (!function_add_request_is_valid(ir as *const Store, function, signature, signature_length)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    var record: Function = function;
    record.first_parameter = none;
    record.first_slot = none;
    record.first_block = none;
    record.first_value = none;
    record.signature_offset = ir->callable_signatures.length;
    record.signature_length = signature_length;
    let appended_signature: bytes::BufferResult = bytes::append(ir->callable_signatures, signature, signature_length);
    ir->callable_signatures = appended_signature.buffer;
    if (appended_signature.error != runtime::Error.none) {
        set_error(ir, appended_signature.error);
        return none;
    }
    let appended: bytes::BufferResult = append(
        ir->functions, (&record) as *const Function as *const u8, sizeof(Function));
    ir->functions = appended.buffer;
    if (appended.error != runtime::Error.none) {
        let truncated: bytes::BufferResult = bytes::truncate(ir->callable_signatures, record.signature_offset);
        ir->callable_signatures = truncated.buffer;
        set_error(ir, appended.error);
        return none;
    }
    let function_id: usize = ir->function_count;
    ir->function_count += 1;
    return function_id;
}

fn function_can_extend_range(first: usize, count: usize, next: usize) -> bool {
    return count == 0 ? first == no_id() : first + count == next;
}

fn add_slot(
    ir: *Store, function_id: usize, type_id: usize, mutable_binding: bool,
    volatile_binding: bool, alignment_bytes: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none ||
        alignment_bytes > (Limit.maximum_slot_alignment as usize) || (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    let slot: Slot = {
        function_id = function_id, type_id = type_id, alignment_bytes = alignment_bytes,
        mutable_binding = mutable_binding, volatile_binding = volatile_binding,
    };
    let appended: bytes::BufferResult = append(ir->slots, (&slot) as *const Slot as *const u8, sizeof(Slot));
    ir->slots = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].slot_count == 0) {
        result_functions[function_id].first_slot = ir->slot_count;
    }
    result_functions[function_id].slot_count += 1;
    let slot_id: usize = ir->slot_count;
    ir->slot_count += 1;
    return slot_id;
}

fn add_parameter(ir: *Store, function_id: usize, type_id: usize, name_token: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    if (!function_can_extend_range(
            functions[function_id].first_parameter, functions[function_id].parameter_count, ir->parameter_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let slot_id: usize = add_slot(ir, function_id, type_id, false, false, 0);
    if (slot_id == none) {
        return none;
    }
    let parameter: Parameter = {
        function_id = function_id, type_id = type_id, slot_id = slot_id, name_token = name_token,
    };
    let appended: bytes::BufferResult = append(
        ir->parameters, (&parameter) as *const Parameter as *const u8, sizeof(Parameter));
    ir->parameters = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].parameter_count == 0) {
        result_functions[function_id].first_parameter = ir->parameter_count;
    }
    result_functions[function_id].parameter_count += 1;
    let parameter_id: usize = ir->parameter_count;
    ir->parameter_count += 1;
    return parameter_id;
}

fn add_block(ir: *Store, function_id: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) || function_id >= ir->function_count) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    if (!functions[function_id].has_body ||
        !function_can_extend_range(
            functions[function_id].first_block, functions[function_id].block_count, ir->block_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let block: Block = {
        function_id = function_id, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
    let appended: bytes::BufferResult = append(ir->blocks, (&block) as *const Block as *const u8, sizeof(Block));
    ir->blocks = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].block_count == 0) {
        result_functions[function_id].first_block = ir->block_count;
    }
    result_functions[function_id].block_count += 1;
    let block_id: usize = ir->block_count;
    ir->block_count += 1;
    return block_id;
}

fn add_value(ir: *Store, function_id: usize, block_id: usize, type_id: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || block_id >= ir->block_count || type_id == none) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let blocks: *const Block = ir->blocks.data as *const Block;
    let functions: *Function = ir->functions.data as *Function;
    if (blocks[block_id].function_id != function_id ||
        !function_can_extend_range(
            functions[function_id].first_value, functions[function_id].value_count, ir->value_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let value: Value = {
        function_id = function_id, block_id = block_id, type_id = type_id, definition = none,
    };
    let appended: bytes::BufferResult = append(ir->values, (&value) as *const Value as *const u8, sizeof(Value));
    ir->values = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].value_count == 0) {
        result_functions[function_id].first_value = ir->value_count;
    }
    result_functions[function_id].value_count += 1;
    let value_id: usize = ir->value_count;
    ir->value_count += 1;
    return value_id;
}

fn opcode_is_terminator(opcode: Opcode) -> bool {
    return opcode == Opcode.jump || opcode == Opcode.branch ||
        opcode == Opcode.return_value || opcode == Opcode.return_void || opcode == Opcode.unreachable;
}

fn increment_predecessor(ir: *Store, source_block: usize, target_block: usize) -> bool {
    if (target_block >= ir->block_count) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let blocks: *Block = ir->blocks.data as *Block;
    if (blocks[source_block].function_id != blocks[target_block].function_id ||
        blocks[target_block].predecessor_count == Limit.maximum_size as usize) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    blocks[target_block].predecessor_count += 1;
    return true;
}

fn emit(ir: *Store, instruction: Instruction) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        instruction.opcode == Opcode.invalid || instruction.block_id >= ir->block_count ||
        instruction.next_instruction != none || instruction.span.line == 0 || instruction.span.column == 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let blocks: *Block = ir->blocks.data as *Block;
    if (blocks[instruction.block_id].terminated) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    if (instruction.result != none) {
        if (instruction.result >= ir->value_count) {
            set_error(ir, runtime::Error.invalid_argument);
            return none;
        }
        let values: *const Value = ir->values.data as *const Value;
        if (values[instruction.result].block_id != instruction.block_id ||
            values[instruction.result].definition != none || values[instruction.result].type_id !=
                instruction.type_id) {
            set_error(ir, runtime::Error.invalid_argument);
            return none;
        }
    }
    let instruction_id: usize = ir->instruction_count;
    let appended: bytes::BufferResult = append(
        ir->instructions, (&instruction) as *const Instruction as *const u8, sizeof(Instruction));
    ir->instructions = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_blocks: *Block = ir->blocks.data as *Block;
    if (result_blocks[instruction.block_id].instruction_count == 0) {
        result_blocks[instruction.block_id].first_instruction = instruction_id;
    } else {
        let instructions: *Instruction = ir->instructions.data as *Instruction;
        instructions[ result_blocks[instruction.block_id].last_instruction].next_instruction = instruction_id;
    }
    result_blocks[instruction.block_id].last_instruction = instruction_id;
    result_blocks[instruction.block_id].instruction_count += 1;
    if (instruction.result != none) {
        let values: *Value = ir->values.data as *Value;
        values[instruction.result].definition = instruction_id;
    }
    ir->instruction_count += 1;

    if (instruction.opcode == Opcode.jump) {
        if (!increment_predecessor(
                ir, instruction.block_id, instruction.auxiliary)) {
            return none;
        }
    } else if (instruction.opcode == Opcode.branch) {
        if (!increment_predecessor(ir, instruction.block_id, instruction.auxiliary) ||
            !increment_predecessor(
                ir, instruction.block_id, instruction.third)) {
            return none;
        }
    }
    if (opcode_is_terminator(
            instruction.opcode)) {
        result_blocks[instruction.block_id].terminated = true;
    }
    return instruction_id;
}

fn add_argument(ir: *Store, instruction_id: usize, value_id: usize) -> bool {
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        instruction_id >= ir->instruction_count || value_id >= ir->value_count) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return false;
    }
    let instructions: *const Instruction = ir->instructions.data as *const Instruction;
    let values: *const Value = ir->values.data as *const Value;
    if ((instructions[instruction_id].opcode != Opcode.call && instructions[instruction_id].opcode !=
            Opcode.call_indirect) || values[value_id].function_id !=
            (ir->blocks.data as *const Block)[ instructions[instruction_id].block_id].function_id) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let argument: Argument = {
        instruction_id = instruction_id, value_id = value_id,
    };
    let appended: bytes::BufferResult = append(
        ir->arguments, (&argument) as *const Argument as *const u8, sizeof(Argument));
    ir->arguments = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return set_error(ir, appended.error);
    }
    ir->argument_count += 1;
    return true;
}

fn set_entry(ir: *Store, function_id: usize) -> bool {
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || ir->entry_function != no_id()) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return false;
    }
    let functions: *const Function = ir->functions.data as *const Function;
    if (!functions[function_id].has_body) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    ir->entry_function = function_id;
    return true;
}

fn release(ir: Store) -> runtime::Error {
    if (!storage_is_valid(ir)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(ir.globals);
    error = first_error(error, bytes::release(ir.global_bytes));
    error = first_error(error, bytes::release(ir.global_references));
    error = first_error(error, bytes::release(ir.functions));
    error = first_error(error, bytes::release(ir.callable_signatures));
    error = first_error(error, bytes::release(ir.parameters));
    error = first_error(error, bytes::release(ir.slots));
    error = first_error(error, bytes::release(ir.values));
    error = first_error(error, bytes::release(ir.blocks));
    error = first_error(error, bytes::release(ir.instructions));
    error = first_error(error, bytes::release(ir.arguments));
    return error;
}
