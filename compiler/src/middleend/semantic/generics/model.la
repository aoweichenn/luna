module luna.bootstrap.middleend.semantic.generics.model;

enum Limit: usize {
    maximum_size = 18446744073709551615, initial_bucket_count = 16,
    hash_offset = 14695981039346656037, hash_prime = 1099511628211,
    maximum_instances = 4096, maximum_expansion_depth = 64,
}

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty() -> Store {
    return {
        declarations = bytes::empty(), declaration_count = 0, parameters = bytes::empty(), parameter_count = 0,
        instances = bytes::empty(), instance_count = 0, arguments = bytes::empty(), argument_count = 0,
        buckets = bytes::empty(), bucket_count = 0, type_instances = bytes::empty(), type_instance_count = 0,
        function_instances = bytes::empty(), function_instance_count = 0,
        active_bindings = bytes::empty(), active_binding_count = 0,
    };
}

fn buffer_matches(buffer: bytes::Buffer, count: usize, record_size: usize) -> bool {
    let storage_is_valid: bool = bytes::is_valid(buffer) && record_size != 0;
    if (!storage_is_valid) {
        return false;
    }
    let shape_is_valid: bool = buffer.length % record_size == 0;
    return shape_is_valid && count == buffer.length / record_size;
}

fn bucket_storage_is_valid(store: Store) -> bool {
    if (!buffer_matches(store.buckets, store.bucket_count, sizeof(usize))) {
        return false;
    }
    if (store.bucket_count == 0) {
        return store.instance_count == 0;
    }
    return (store.bucket_count & (store.bucket_count - 1)) == 0;
}

fn instance_map_is_valid(buffer: bytes::Buffer, count: usize, instance_count: usize) -> bool {
    if (!buffer_matches(buffer, count, sizeof(usize))) {
        return false;
    }
    let entries: *const usize = buffer.data as *const usize;
    for (var index: usize = 0; index < count; index += 1) {
        if (entries[index] != no_id() && entries[index] >= instance_count) {
            return false;
        }
    }
    return true;
}

fn declaration_records_are_valid(store: Store) -> bool {
    let declarations: *const Declaration = store.declarations.data as *const Declaration;
    let parameters: *const Parameter = store.parameters.data as *const Parameter;
    var expected_parameter: usize = 0;
    for (var declaration_id: usize = 0; declaration_id < store.declaration_count; declaration_id += 1) {
        let declaration: Declaration = declarations[declaration_id];
        let kind_is_valid: bool = declaration.kind == DeclarationKind.type_declaration ||
            declaration.kind == DeclarationKind.function_declaration;
        let source_is_valid: bool = declaration.unit_index != no_id() && declaration.node_index != no_id();
        let identity_is_valid: bool = declaration.module_id != no_id() && declaration.name_token != no_id();
        let source_identity_is_valid: bool = source_is_valid && identity_is_valid;
        if (!kind_is_valid || !source_identity_is_valid) {
            return false;
        }
        if (declaration.parameter_count == 0) {
            let open_declaration: bool = declaration_id + 1 == store.declaration_count &&
                declaration.first_parameter == no_id();
            if (!open_declaration || expected_parameter != store.parameter_count) {
                return false;
            }
            continue;
        }
        if (declaration.first_parameter != expected_parameter) {
            return false;
        }
        let range_is_valid: bool = declaration.first_parameter <= store.parameter_count &&
            declaration.parameter_count <= store.parameter_count - declaration.first_parameter;
        if (!range_is_valid) {
            return false;
        }
        for (var index: usize = 0; index < declaration.parameter_count; index += 1) {
            let parameter: Parameter = parameters[declaration.first_parameter + index];
            let owner_is_valid: bool = parameter.declaration_id == declaration_id && parameter.position == index;
            let source_is_valid: bool = parameter.unit_index != no_id() && parameter.node_index != no_id();
            let identity_is_valid: bool = source_is_valid && parameter.name_token != no_id();
            if (!owner_is_valid || !identity_is_valid) {
                return false;
            }
        }
        expected_parameter += declaration.parameter_count;
    }
    return expected_parameter == store.parameter_count;
}

fn instance_record_is_valid(store: Store, instance: Instance) -> bool {
    if (instance.declaration_id >= store.declaration_count) {
        return false;
    }
    let declarations: *const Declaration = store.declarations.data as *const Declaration;
    if (instance.argument_count != declarations[instance.declaration_id].parameter_count) {
        return false;
    }
    let range_is_valid: bool = instance.first_argument <= store.argument_count &&
        instance.argument_count <= store.argument_count - instance.first_argument;
    if (!range_is_valid || instance.expansion_depth >= Limit.maximum_expansion_depth as usize) {
        return false;
    }
    let result_is_distinct: bool = instance.type_id == no_id() || instance.function_id == no_id();
    if (!result_is_distinct) {
        return false;
    }
    let has_result: bool = instance.type_id != no_id() || instance.function_id != no_id();
    switch (instance.state) {
    case InstanceState.requested {
        return !has_result;
    }
    case InstanceState.resolving, InstanceState.complete {
        return has_result;
    }
    case InstanceState.failed {
        return true;
    }
    default {
        return false;
    }
    }
}

fn instance_records_are_valid(store: Store) -> bool {
    let instances: *const Instance = store.instances.data as *const Instance;
    var expected_argument: usize = 0;
    for (var instance_id: usize = 0; instance_id < store.instance_count; instance_id += 1) {
        let instance: Instance = instances[instance_id];
        if (!instance_record_is_valid(store, instance) || instance.first_argument != expected_argument) {
            return false;
        }
        expected_argument += instance.argument_count;
    }
    return expected_argument == store.argument_count;
}

fn bucket_records_are_valid(store: Store) -> bool {
    if (store.bucket_count == 0) {
        return store.instance_count == 0;
    }
    let buckets: *const usize = store.buckets.data as *const usize;
    var occupied: usize = 0;
    for (var index: usize = 0; index < store.bucket_count; index += 1) {
        if (buckets[index] == no_id()) {
            continue;
        }
        if (buckets[index] >= store.instance_count) {
            return false;
        }
        occupied += 1;
    }
    if (occupied != store.instance_count) {
        return false;
    }
    let instances: *const Instance = store.instances.data as *const Instance;
    let arguments: *const usize = store.arguments.data as *const usize;
    let mask: usize = store.bucket_count - 1;
    for (var instance_id: usize = 0; instance_id < store.instance_count; instance_id += 1) {
        let instance: Instance = instances[instance_id];
        let values: *const usize = &arguments[instance.first_argument];
        var bucket: usize = instance_hash(
            instance.declaration_id, instance.owner_type, values, instance.argument_count) & mask;
        var found: bool = false;
        for (var visited: usize = 0; visited < store.bucket_count; visited += 1) {
            if (buckets[bucket] == no_id()) {
                break;
            }
            if (buckets[bucket] == instance_id) {
                found = true;
                break;
            }
            bucket = (bucket + 1) & mask;
        }
        if (!found) {
            return false;
        }
    }
    return true;
}

fn storage_is_valid(store: Store) -> bool {
    let declarations_are_valid: bool = buffer_matches(store.declarations, store.declaration_count, sizeof(Declaration));
    let parameters_are_valid: bool = buffer_matches(store.parameters, store.parameter_count, sizeof(Parameter));
    let instances_are_valid: bool = buffer_matches(store.instances, store.instance_count, sizeof(Instance));
    let arguments_are_valid: bool = buffer_matches(store.arguments, store.argument_count, sizeof(usize));
    let active_are_valid: bool = buffer_matches(
        store.active_bindings, store.active_binding_count, sizeof(ActiveBinding));
    let type_map_is_valid: bool = instance_map_is_valid(
        store.type_instances, store.type_instance_count, store.instance_count);
    let function_map_is_valid: bool = instance_map_is_valid(
        store.function_instances, store.function_instance_count, store.instance_count);
    let declaration_storage_is_valid: bool = declarations_are_valid && parameters_are_valid;
    let instance_storage_is_valid: bool = instances_are_valid && arguments_are_valid;
    let indexed_instances_are_valid: bool = instance_storage_is_valid && bucket_storage_is_valid(store);
    let instance_maps_are_valid: bool = type_map_is_valid && function_map_is_valid;
    let persistent_storage_is_valid: bool = declaration_storage_is_valid && indexed_instances_are_valid;
    let indexed_storage_is_valid: bool = persistent_storage_is_valid && instance_maps_are_valid;
    return indexed_storage_is_valid && active_are_valid;
}

fn is_valid(store: Store) -> bool {
    if (!storage_is_valid(store)) {
        return false;
    }
    let declaration_records_valid: bool = declaration_records_are_valid(store);
    let instance_records_valid: bool = instance_records_are_valid(store) && bucket_records_are_valid(store);
    return declaration_records_valid && instance_records_valid;
}

fn append_declaration(store: *Store, declaration: Declaration) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    let appended: bytes::BufferResult = bytes::append(
        store->declarations, (&declaration) as *const Declaration as *const u8, sizeof(Declaration));
    store->declarations = appended.buffer;
    if (appended.error == runtime::Error.none) {
        store->declaration_count += 1;
    }
    return appended.error;
}

fn declaration_parameter_slice_is_open(store: Store, declaration: Declaration) -> bool {
    if (declaration.parameter_count == 0) {
        return declaration.first_parameter == no_id();
    }
    return declaration.first_parameter <= store.parameter_count &&
        declaration.parameter_count == store.parameter_count - declaration.first_parameter;
}

fn append_parameter(store: *Store, declaration_id: usize, parameter: Parameter) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    if (declaration_id >= store->declaration_count || parameter.declaration_id != declaration_id) {
        return runtime::Error.invalid_argument;
    }
    var declarations: *Declaration = store->declarations.data as *Declaration;
    if (!declaration_parameter_slice_is_open(*store, declarations[declaration_id])) {
        return runtime::Error.invalid_argument;
    }
    let appended: bytes::BufferResult = bytes::append(
        store->parameters, (&parameter) as *const Parameter as *const u8, sizeof(Parameter));
    store->parameters = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return appended.error;
    }
    declarations = store->declarations.data as *Declaration;
    if (declarations[declaration_id].parameter_count == 0) {
        declarations[declaration_id].first_parameter = store->parameter_count;
    }
    declarations[declaration_id].parameter_count += 1;
    store->parameter_count += 1;
    return runtime::Error.none;
}

fn hash_word(hash: usize, value: usize) -> usize {
    return (hash ^ value) * (Limit.hash_prime as usize);
}

fn instance_hash(declaration_id: usize, owner_type: usize, arguments: *const usize, argument_count: usize) -> usize {
    var hash: usize = hash_word(Limit.hash_offset as usize, declaration_id);
    hash = hash_word(hash, owner_type);
    for (var index: usize = 0; index < argument_count; index += 1) {
        hash = hash_word(hash, arguments[index]);
    }
    return hash;
}

fn instance_matches(
    store: Store, instance: Instance, declaration_id: usize, owner_type: usize,
    arguments: *const usize, argument_count: usize) -> bool {
    let identity_matches: bool = instance.declaration_id == declaration_id && instance.owner_type == owner_type;
    if (!identity_matches || instance.argument_count != argument_count) {
        return false;
    }
    let stored: *const usize = store.arguments.data as *const usize;
    for (var index: usize = 0; index < argument_count; index += 1) {
        if (stored[instance.first_argument + index] != arguments[index]) {
            return false;
        }
    }
    return true;
}

fn find_instance(
    store: Store, declaration_id: usize, owner_type: usize, arguments: *const usize, argument_count: usize) -> usize {
    if (!storage_is_valid(store) || store.bucket_count == 0) {
        return no_id();
    }
    if (argument_count != 0 && arguments == null) {
        return no_id();
    }
    let buckets: *const usize = store.buckets.data as *const usize;
    let instances: *const Instance = store.instances.data as *const Instance;
    let mask: usize = store.bucket_count - 1;
    var bucket: usize = instance_hash(declaration_id, owner_type, arguments, argument_count) & mask;
    for (var visited: usize = 0; visited < store.bucket_count; visited += 1) {
        let instance_id: usize = buckets[bucket];
        if (instance_id == no_id()) {
            return no_id();
        }
        if (instance_id >= store.instance_count) {
            return no_id();
        }
        if (instance_matches(
                store, instances[instance_id], declaration_id, owner_type, arguments, argument_count)) {
            return instance_id;
        }
        bucket = (bucket + 1) & mask;
    }
    return no_id();
}

fn initialize_buckets(bucket_count: usize) -> bytes::BufferResult {
    if (bucket_count == 0 || (bucket_count & (bucket_count - 1)) != 0) {
        return {buffer = bytes::empty(), error = runtime::Error.invalid_argument};
    }
    var byte_count: usize = 0;
    if (@mul_overflow(bucket_count, sizeof(usize), &byte_count)) {
        return {buffer = bytes::empty(), error = runtime::Error.out_of_memory};
    }
    let created: bytes::BufferResult = bytes::with_capacity(byte_count);
    var buckets: bytes::Buffer = created.buffer;
    if (created.error != runtime::Error.none) {
        return created;
    }
    buckets.length = byte_count;
    let entries: *usize = buckets.data as *usize;
    for (var index: usize = 0; index < bucket_count; index += 1) {
        entries[index] = no_id();
    }
    return {buffer = buckets, error = runtime::Error.none};
}

fn insert_instance_bucket(store: *Store, instance_id: usize) -> runtime::Error {
    if (instance_id >= store->instance_count || store->bucket_count == 0) {
        return runtime::Error.invalid_argument;
    }
    let instances: *const Instance = store->instances.data as *const Instance;
    let arguments: *const usize = store->arguments.data as *const usize;
    let instance: Instance = instances[instance_id];
    let instance_arguments: *const usize = instance.argument_count == 0 ? null : &arguments[instance.first_argument];
    let mask: usize = store->bucket_count - 1;
    var bucket: usize = instance_hash(
        instance.declaration_id, instance.owner_type, instance_arguments, instance.argument_count) & mask;
    let buckets: *usize = store->buckets.data as *usize;
    for (var visited: usize = 0; visited < store->bucket_count; visited += 1) {
        if (buckets[bucket] == no_id()) {
            buckets[bucket] = instance_id;
            return runtime::Error.none;
        }
        bucket = (bucket + 1) & mask;
    }
    return runtime::Error.invalid_argument;
}

fn rebuild_buckets(store: *Store, bucket_count: usize) -> runtime::Error {
    let created: bytes::BufferResult = initialize_buckets(bucket_count);
    if (created.error != runtime::Error.none) {
        return created.error;
    }
    let previous: bytes::Buffer = store->buckets;
    let previous_count: usize = store->bucket_count;
    store->buckets = created.buffer;
    store->bucket_count = bucket_count;
    for (var instance_id: usize = 0; instance_id < store->instance_count; instance_id += 1) {
        let error: runtime::Error = insert_instance_bucket(store, instance_id);
        if (error != runtime::Error.none) {
            let failed: bytes::Buffer = store->buckets;
            store->buckets = previous;
            store->bucket_count = previous_count;
            bytes::release(failed);
            return error;
        }
    }
    return bytes::release(previous);
}

fn ensure_instance_capacity(store: *Store) -> runtime::Error {
    if (store->instance_count >= Limit.maximum_instances as usize) {
        return runtime::Error.out_of_memory;
    }
    if (store->bucket_count == 0) {
        return rebuild_buckets(store, Limit.initial_bucket_count as usize);
    }
    let growth_boundary: usize = store->bucket_count - store->bucket_count / 4;
    if (store->instance_count + 1 < growth_boundary) {
        return runtime::Error.none;
    }
    if (store->bucket_count > (Limit.maximum_size as usize) / 2) {
        return runtime::Error.out_of_memory;
    }
    return rebuild_buckets(store, store->bucket_count * 2);
}

fn append_instance(
    store: *Store, declaration_id: usize, owner_type: usize,
    arguments: *const usize, argument_count: usize, expansion_depth: usize) -> InstanceResult {
    if (store == null || !storage_is_valid(*store)) {
        return {instance_id = no_id(), error = runtime::Error.invalid_argument};
    }
    if (declaration_id >= store->declaration_count) {
        return {instance_id = no_id(), error = runtime::Error.invalid_argument};
    }
    let declarations: *const Declaration = store->declarations.data as *const Declaration;
    let arity_is_valid: bool = argument_count == declarations[declaration_id].parameter_count;
    let depth_is_valid: bool = expansion_depth < Limit.maximum_expansion_depth as usize;
    if (!arity_is_valid || !depth_is_valid) {
        return {instance_id = no_id(), error = runtime::Error.invalid_argument};
    }
    if (argument_count != 0 && arguments == null) {
        return {instance_id = no_id(), error = runtime::Error.invalid_argument};
    }
    let existing: usize = find_instance(*store, declaration_id, owner_type, arguments, argument_count);
    if (existing != no_id()) {
        return {instance_id = existing, error = runtime::Error.none};
    }
    let capacity_error: runtime::Error = ensure_instance_capacity(store);
    if (capacity_error != runtime::Error.none) {
        return {instance_id = no_id(), error = capacity_error};
    }
    var argument_bytes: usize = 0;
    if (@mul_overflow(argument_count, sizeof(usize), &argument_bytes)) {
        return {instance_id = no_id(), error = runtime::Error.out_of_memory};
    }
    let appended_arguments: bytes::BufferResult = bytes::append(
        store->arguments, arguments as *const u8, argument_bytes);
    store->arguments = appended_arguments.buffer;
    if (appended_arguments.error != runtime::Error.none) {
        return {instance_id = no_id(), error = appended_arguments.error};
    }
    let instance: Instance = {
        declaration_id = declaration_id, owner_type = owner_type,
        first_argument = store->argument_count, argument_count = argument_count,
        type_id = no_id(), function_id = no_id(), expansion_depth = expansion_depth, state = InstanceState.requested,
    };
    let appended_instance: bytes::BufferResult = bytes::append(
        store->instances, (&instance) as *const Instance as *const u8, sizeof(Instance));
    store->instances = appended_instance.buffer;
    if (appended_instance.error != runtime::Error.none) {
        store->arguments.length -= argument_bytes;
        return {instance_id = no_id(), error = appended_instance.error};
    }
    let instance_id: usize = store->instance_count;
    store->argument_count += argument_count;
    store->instance_count += 1;
    let insert_error: runtime::Error = insert_instance_bucket(store, instance_id);
    if (insert_error != runtime::Error.none) {
        store->instances.length -= sizeof(Instance);
        store->instance_count -= 1;
        store->arguments.length -= argument_bytes;
        store->argument_count -= argument_count;
        return {instance_id = no_id(), error = insert_error};
    }
    return {instance_id = instance_id, error = runtime::Error.none};
}

fn set_instance_result(
    store: *Store, instance_id: usize, type_id: usize, function_id: usize, state: InstanceState) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    if (instance_id >= store->instance_count) {
        return runtime::Error.invalid_argument;
    }
    let results_are_empty: bool = type_id == no_id() && function_id == no_id();
    let results_are_distinct: bool = type_id == no_id() || function_id == no_id();
    if (!results_are_distinct) {
        return runtime::Error.invalid_argument;
    }
    if (state == InstanceState.complete && results_are_empty) {
        return runtime::Error.invalid_argument;
    }
    let type_map_error: runtime::Error = type_id == no_id() ? runtime::Error.none :
        set_instance_map(&store->type_instances, &store->type_instance_count, type_id, instance_id);
    if (type_map_error != runtime::Error.none) {
        return type_map_error;
    }
    let function_map_error: runtime::Error = function_id == no_id() ? runtime::Error.none :
        set_instance_map(&store->function_instances, &store->function_instance_count, function_id, instance_id);
    if (function_map_error != runtime::Error.none) {
        return function_map_error;
    }
    let instances: *Instance = store->instances.data as *Instance;
    instances[instance_id].type_id = type_id;
    instances[instance_id].function_id = function_id;
    instances[instance_id].state = state;
    return runtime::Error.none;
}

fn append_empty_instance_map_entry(buffer: *bytes::Buffer, count: *usize) -> runtime::Error {
    let empty_id: usize = no_id();
    let appended: bytes::BufferResult = bytes::append(*buffer, (&empty_id) as *const usize as *const u8, sizeof(usize));
    *buffer = appended.buffer;
    if (appended.error == runtime::Error.none) {
        *count += 1;
    }
    return appended.error;
}

fn set_instance_map(buffer: *bytes::Buffer, count: *usize, key: usize, instance_id: usize) -> runtime::Error {
    if (buffer == null || count == null) {
        return runtime::Error.invalid_argument;
    }
    if (key == no_id() || instance_id == no_id()) {
        return runtime::Error.invalid_argument;
    }
    for (; *count <= key;) {
        let error: runtime::Error = append_empty_instance_map_entry(buffer, count);
        if (error != runtime::Error.none) {
            return error;
        }
    }
    let entries: *usize = buffer->data as *usize;
    if (entries[key] != no_id() && entries[key] != instance_id) {
        return runtime::Error.invalid_argument;
    }
    entries[key] = instance_id;
    return runtime::Error.none;
}

fn instance_from_map(buffer: bytes::Buffer, count: usize, key: usize) -> usize {
    if (!buffer_matches(buffer, count, sizeof(usize)) || key >= count) {
        return no_id();
    }
    let entries: *const usize = buffer.data as *const usize;
    return entries[key];
}

fn instance_for_type(store: Store, type_id: usize) -> usize {
    return instance_from_map(store.type_instances, store.type_instance_count, type_id);
}

fn instance_for_function(store: Store, function_id: usize) -> usize {
    return instance_from_map(store.function_instances, store.function_instance_count, function_id);
}

fn map_function_instance(store: *Store, function_id: usize, instance_id: usize) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    if (instance_id >= store->instance_count) {
        return runtime::Error.invalid_argument;
    }
    return set_instance_map(&store->function_instances, &store->function_instance_count, function_id, instance_id);
}

fn append_active_binding(store: *Store, binding: ActiveBinding) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    let appended: bytes::BufferResult = bytes::append(
        store->active_bindings, (&binding) as *const ActiveBinding as *const u8, sizeof(ActiveBinding));
    store->active_bindings = appended.buffer;
    if (appended.error == runtime::Error.none) {
        store->active_binding_count += 1;
    }
    return appended.error;
}

fn truncate_active_bindings(store: *Store, count: usize) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    if (count > store->active_binding_count) {
        return runtime::Error.invalid_argument;
    }
    store->active_binding_count = count;
    store->active_bindings.length = count * sizeof(ActiveBinding);
    return runtime::Error.none;
}

fn first_error(current: runtime::Error, next: runtime::Error) -> runtime::Error {
    return current != runtime::Error.none ? current : next;
}

fn release(store: Store) -> runtime::Error {
    if (!storage_is_valid(store)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(store.declarations);
    error = first_error(error, bytes::release(store.parameters));
    error = first_error(error, bytes::release(store.instances));
    error = first_error(error, bytes::release(store.arguments));
    error = first_error(error, bytes::release(store.buckets));
    error = first_error(error, bytes::release(store.type_instances));
    error = first_error(error, bytes::release(store.function_instances));
    error = first_error(error, bytes::release(store.active_bindings));
    return error;
}
