module luna.bootstrap.middleend.semantic.attributes;

import luna.compiler.lexer as lexer;
import luna.runtime as runtime;
import luna.std.ascii as ascii;

struct AttributeEntry {
    name: *const u8;
    name_length: usize;
    mounts: usize;
    arguments: AttributeArgumentPolicy;
}

struct AttributeMountEntry {
    kind: syntax::SyntaxKind;
    mount: usize;
}

enum AttributeLimit: usize {
    entries = 7, mount_entries = 8,
}

fn attribute_entry(index: usize) -> AttributeEntry {
    var table: [AttributeLimit.entries]AttributeEntry = {};
    table[0] = {
        name = "inline", name_length = 6, mounts = AttributeMount.function as usize,
        arguments = AttributeArgumentPolicy.none,
    };
    table[1] = {
        name = "noreturn", name_length = 8, mounts = AttributeMount.function as usize,
        arguments = AttributeArgumentPolicy.none,
    };
    table[2] = {
        name = "align", name_length = 5, mounts = (AttributeMount.variable as usize) | (AttributeMount.field as usize) |
            (AttributeMount.record as usize), arguments = AttributeArgumentPolicy.one_constant_integer,
    };
    table[3] = {
        name = "packed", name_length = 6, mounts = AttributeMount.structure as usize,
        arguments = AttributeArgumentPolicy.none,
    };
    table[4] = {
        name = "bits", name_length = 4, mounts = AttributeMount.field as usize,
        arguments = AttributeArgumentPolicy.named_bitfields,
    };
    table[5] = {
        name = "export_name", name_length = 11, mounts = AttributeMount.function as usize,
        arguments = AttributeArgumentPolicy.one_string_literal,
    };
    table[6] = {
        name = "rtti", name_length = 4, mounts = AttributeMount.class_type as usize,
        arguments = AttributeArgumentPolicy.none,
    };
    let entry: AttributeEntry = table[index];
    return entry;
}

fn attribute_mount_for(kind: syntax::SyntaxKind) -> usize {
    var table: [AttributeLimit.mount_entries]AttributeMountEntry = {};
    table[0] = {
        kind = syntax::SyntaxKind.function_declaration, mount = AttributeMount.function as usize,
    };
    table[1] = {
        kind = syntax::SyntaxKind.structure_declaration, mount = (AttributeMount.record as usize) |
            (AttributeMount.structure as usize),
    };
    table[2] = {
        kind = syntax::SyntaxKind.union_declaration, mount = AttributeMount.record as usize,
    };
    table[3] = {
        kind = syntax::SyntaxKind.enum_declaration, mount = AttributeMount.enumeration as usize,
    };
    table[4] = {
        kind = syntax::SyntaxKind.field_declaration, mount = AttributeMount.field as usize,
    };
    table[5] = {
        kind = syntax::SyntaxKind.variable_declaration, mount = AttributeMount.variable as usize,
    };
    table[6] = {
        kind = syntax::SyntaxKind.type_alias_declaration, mount = AttributeMount.alias as usize,
    };
    table[7] = {
        kind = syntax::SyntaxKind.class_declaration, mount = AttributeMount.class_type as usize,
    };
    for (var index: usize = 0; index < AttributeLimit.mount_entries as usize; index += 1) {
        if (table[index].kind == kind) {
            return table[index].mount;
        }
    }
    return AttributeMount.none as usize;
}

fn find_attribute(context: *context::Context, unit_index: usize, name_token: usize) -> usize {
    for (var index: usize = 0; index < AttributeLimit.entries as usize; index += 1) {
        let entry: AttributeEntry = attribute_entry(index);
        if (context::token_equals_bytes(
                context, unit_index, name_token, entry.name, entry.name_length)) {
            return index;
        }
    }
    return context::no_id();
}

fn attribute_arguments_are_valid(entry: AttributeEntry, has_arguments: bool, child_count: usize) -> bool {
    switch (entry.arguments) {
    case AttributeArgumentPolicy.none {
        return !has_arguments;
    }
    case AttributeArgumentPolicy.one_constant_integer, AttributeArgumentPolicy.one_string_literal {
        return has_arguments && child_count == 1;
    }
    case AttributeArgumentPolicy.named_bitfields {
        return has_arguments && child_count != 0;
    }
    default {
        return false;
    }
    }
}

fn count_attribute_children(context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode) -> usize {
    let none: usize = context::no_id();
    var count: usize = 0;
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (node.kind == syntax::SyntaxKind.attribute) {
            count += 1;
        }
        child = node.next_sibling;
    }
    return count;
}

fn declaration_has_attribute(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, attribute: Attribute) -> bool {
    let entry: AttributeEntry = attribute_entry(attribute as usize);
    let none: usize = context::no_id();
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (node.kind == syntax::SyntaxKind.attribute &&
            context::token_equals_bytes(
                context, unit_index, node.token_index, entry.name, entry.name_length)) {
            return true;
        }
        child = node.next_sibling;
    }
    return false;
}

fn declaration_attribute_argument(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, attribute: Attribute) -> usize {
    let entry: AttributeEntry = attribute_entry(attribute as usize);
    let none: usize = context::no_id();
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (node.kind == syntax::SyntaxKind.attribute &&
            context::token_equals_bytes(
                context, unit_index, node.token_index, entry.name, entry.name_length)) {
            if ((node.flags & (syntax::SyntaxFlag.has_arguments as usize)) != 0 && node.child_count == 1) {
                return node.first_child;
            }
            return none;
        }
        child = node.next_sibling;
    }
    return none;
}

// A one_string_literal argument must be a plain u8 string literal whose raw
// bytes form a nonempty C identifier; escapes and wide prefixes can never
// qualify, so the raw token bytes (quotes included in the span) are checked
// directly instead of decoding.
fn attribute_string_is_identifier(context: *context::Context, unit_index: usize, token_index: usize) -> bool {
    let token: lexer::Token = context::token(context, unit_index, token_index);
    let unit: *const context::Unit = context::input_unit(context, unit_index);
    if (unit == null || token.kind != lexer::TokenKind.string || token.span.length < 3 ||
        token.span.offset > unit->source.length || token.span.length > unit->source.length - token.span.offset) {
        return false;
    }
    var index: usize = 1;
    while (index + 1 < token.span.length) {
        let byte: u8 = unit->source.data[token.span.offset + index];
        let letter = ascii::is_letter(byte) || byte == '_';
        let digit = ascii::is_decimal_digit(byte);
        if ((!letter && !digit) || (index == 1 && digit)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn attribute_string_matches(
    unit: *const context::Unit, token: lexer::Token, expected: *const u8, expected_length: usize) -> bool {
    if (unit == null || token.span.length != expected_length + 2 || token.span.offset > unit->source.length ||
        token.span.length > unit->source.length - token.span.offset) {
        return false;
    }
    var index: usize = 0;
    while (index < expected_length) {
        if (unit->source.data[token.span.offset + 1 + index] != expected[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Reserved export names collide with the runtime entry point or the normal
// module/function mangling scheme ("_L<module-hex>_<name-hex>"); the same rule
// already applies to extern symbol names.
fn attribute_string_is_reserved(context: *context::Context, unit_index: usize, token_index: usize) -> bool {
    let token: lexer::Token = context::token(context, unit_index, token_index);
    let unit: *const context::Unit = context::input_unit(context, unit_index);
    if (unit == null || token.span.length < 4 || token.span.offset > unit->source.length ||
        token.span.length > unit->source.length - token.span.offset) {
        return false;
    }
    return attribute_string_matches(unit, token, "_start", 6) ||
        (unit->source.data[token.span.offset + 1] == '_' && unit->source.data[token.span.offset + 2] == 'L');
}

fn validate_attribute(context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    var mount: usize = AttributeMount.none as usize;
    if (node.parent != none) {
        mount = attribute_mount_for(context::node(context, unit_index, node.parent).kind);
    }
    let table_index: usize = find_attribute(context, unit_index, node.token_index);
    if (table_index == none) {
        return context::add_diagnostic(
            context, context::DiagnosticKind.unknown_attribute, unit_index, node.span, none, context::empty_span(), 0);
    }
    let entry: AttributeEntry = attribute_entry(table_index);
    let has_arguments: bool = (node.flags & (syntax::SyntaxFlag.has_arguments as usize)) != 0;
    let mount_is_valid: bool = mount != AttributeMount.none as usize && (entry.mounts & mount) != 0;
    let arguments_are_valid: bool = attribute_arguments_are_valid(entry, has_arguments, node.child_count);
    if (!mount_is_valid || !arguments_are_valid) {
        return context::add_diagnostic(
            context, context::DiagnosticKind.invalid_attribute, unit_index, node.span, none, context::empty_span(),
            table_index);
    }
    // Positional policies take plain expressions; named arguments are left
    // for the named_bitfields consumer to validate so it can report
    // invalid_bitfield rather than a framework error.
    let expects_named: bool = entry.arguments == AttributeArgumentPolicy.named_bitfields;
    var argument: usize = node.first_child;
    while (!expects_named && argument != none) {
        let argument_node: syntax::SyntaxNode = context::node(context, unit_index, argument);
        if ((argument_node.kind == syntax::SyntaxKind.named_argument) != expects_named || (entry.arguments ==
                    AttributeArgumentPolicy.one_string_literal && argument_node.kind !=
                    syntax::SyntaxKind.string_expression)) {
            return context::add_diagnostic(
                context, context::DiagnosticKind.invalid_attribute, unit_index, argument_node.span, none,
                context::empty_span(), table_index);
        }
        argument = argument_node.next_sibling;
    }
    if (table_index == (Attribute.packed as usize) && node.parent != none) {
        let parent: syntax::SyntaxNode = context::node(context, unit_index, node.parent);
        if (parent.kind == syntax::SyntaxKind.structure_declaration &&
            declaration_has_attribute(
                context, unit_index, parent, Attribute.align)) {
            return context::add_diagnostic(
                context, context::DiagnosticKind.invalid_attribute, unit_index, node.span, none, context::empty_span(),
                table_index);
        }
    }
    // @export_name mounts only on a definition with a body (never on
    // extern, const fn or bodyless declarations) and takes one string
    // literal holding a valid, non-reserved C identifier; the emitted
    // symbol is that name verbatim, bypassing the _L mangling scheme.
    if (table_index == (Attribute.export_name as usize) && node.parent != none) {
        let parent: syntax::SyntaxNode = context::node(context, unit_index, node.parent);
        if ((parent.flags & ((syntax::SyntaxFlag.external as usize) | (syntax::SyntaxFlag.const_function as usize) |
                    (syntax::SyntaxFlag.bodyless as usize))) != 0) {
            return context::add_diagnostic(
                context, context::DiagnosticKind.invalid_attribute, unit_index, node.span, none, context::empty_span(),
                table_index);
        }
        let argument_node: syntax::SyntaxNode = context::node(context, unit_index, node.first_child);
        if (argument_node.child_count != 0 ||
            !attribute_string_is_identifier(
                context, unit_index, argument_node.token_index)) {
            return context::add_diagnostic(
                context, context::DiagnosticKind.invalid_attribute, unit_index, argument_node.span, none,
                context::empty_span(), table_index);
        }
        if (attribute_string_is_reserved(
                context, unit_index, argument_node.token_index)) {
            return context::add_diagnostic(
                context, context::DiagnosticKind.invalid_export_name, unit_index, argument_node.span, none,
                context::empty_span(), table_index);
        }
    }
    return true;
}

fn validate_attributes(context: *context::Context) -> bool {
    var unit_index: usize = 0;
    while (unit_index < context->input.unit_count && context->error == runtime::Error.none) {
        let unit: *const context::Unit = context::input_unit(context, unit_index);
        var node_index: usize = 0;
        while (node_index < unit->tree.count && context->error == runtime::Error.none) {
            let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
            if (node.kind == syntax::SyntaxKind.attribute &&
                !validate_attribute(
                    context, unit_index, node)) {
                return false;
            }
            node_index += 1;
        }
        unit_index += 1;
    }
    return context->error == runtime::Error.none;
}
