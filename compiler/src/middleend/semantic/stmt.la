module luna.bootstrap.middleend.semantic.stmt;

import luna.bootstrap.middleend.semantic.context.builder as builder;

import luna.bootstrap.middleend.semantic.context.lookup as names;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.syntax as syntax;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.callable as callable;
import luna.bootstrap.middleend.semantic.classes as classes;
import luna.bootstrap.middleend.semantic.consteval as consteval;
import luna.bootstrap.middleend.semantic.consteval.engine as const_engine;
import luna.bootstrap.middleend.semantic.consteval.model as const_model;
import luna.bootstrap.middleend.semantic.expr as expr;
import luna.bootstrap.middleend.semantic.expr.access as access;
import luna.bootstrap.middleend.semantic.expr.base as base;
import luna.bootstrap.middleend.semantic.expr.numeric as numeric;
import luna.bootstrap.middleend.semantic.expr.operators as operators;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.bootstrap.middleend.semantic.stmt.labels as labels;
import luna.bootstrap.middleend.semantic.types as types;
import luna.bootstrap.middleend.semantic.value as category;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime as runtime;
import luna.std.bytes as bytes;

fn memory_initializer_kind_is_valid(kind: syntax::SyntaxKind) -> bool {
    switch (kind) {
    case syntax::SyntaxKind.zero_initializer, syntax::SyntaxKind.aggregate_initializer,
        syntax::SyntaxKind.name_expression, syntax::SyntaxKind.member_expression,
        syntax::SyntaxKind.index_expression, syntax::SyntaxKind.call_expression,
        syntax::SyntaxKind.intrinsic_expression, syntax::SyntaxKind.conditional_expression,
        syntax::SyntaxKind.parenthesized_expression, syntax::SyntaxKind.unary_expression,
        syntax::SyntaxKind.binary_expression {
        return true;
    }
    default {
        return false;
    }
    }
}

fn lower_variable(context: *context::Context, node_id: usize, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    let inferred: bool = (node.flags & (syntax::SyntaxFlag.inferred_type as usize)) != 0;
    if (node.child_count !=
        (inferred ? 1 : 2) + attributes::count_attribute_children(
            context, context->current_unit, node)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let duplicate: usize = builder::local_in_current_scope(context, context->current_unit, node.token_index);
    if (duplicate != none) {
        let locals: *const context::Local = context->locals.data as
                *const context::Local;
        context::add_diagnostic(
            context, context::DiagnosticKind.duplicate_local, context->current_unit, node.span,
            locals[duplicate].unit_index,
            context::node(context, locals[duplicate].unit_index, locals[duplicate].declaration_node).span, duplicate);
        return false;
    }
    var type_id: usize = none;
    var initializer: context::Expression = base::invalid_expression();
    if (inferred) {
        let inferred_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
        if (inferred_node.kind == syntax::SyntaxKind.zero_initializer || inferred_node.kind ==
                syntax::SyntaxKind.aggregate_initializer || inferred_node.kind == syntax::SyntaxKind.null_expression) {
            // These forms are context-directed and have no standalone type.
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_initializer, context->current_unit, inferred_node.span, none,
                context::empty_span(), none);
            return false;
        }
        initializer = expr::lower_expression(context, node.first_child, none);
        if (!initializer.valid || initializer.type_id == none) {
            return false;
        }
        type_id = initializer.type_id;
    } else {
        let declared_type: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
        if (declared_type.kind == syntax::SyntaxKind.type_builtin &&
            context::token(
                context, context->current_unit, declared_type.token_index).kind == lexer::TokenKind.keyword_va_list) {
            // A va_list mounts only as a local var inside a variadic
            // function; every other position (parameters, fields, return
            // types, aliases, pointers to it, ...) is rejected with
            // invalid_va_list at type resolution.
            if ((node.flags & (syntax::SyntaxFlag.mutable_binding as usize)) == 0 ||
                !builder::current_function_is_variadic(
                    context)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_va_list, context->current_unit, node.span, none,
                    context::empty_span(), 0);
                return false;
            }
            type_id = type_info::BuiltinType.va_list_type as usize;
        } else {
            type_id = types::resolve_type_node(context, context->current_unit, node.first_child);
        }
        if (type_id == none) {
            return false;
        }
    }
    if (!types::require_opaque_value_access(context, type_id, context->current_unit, node.span)) {
        return false;
    }
    let type_record: type_info::Record = context::type_record(context, type_id);
    if (classes::class_is_abstract(context, type_id)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_abstract_class, context->current_unit, node.span,
            none, context::empty_span(), type_id);
        return false;
    }
    if (type_record.kind == type_info::Kind.type_void || (type_record.flags & ((type_info::Flag.header as usize) |
                (type_info::Flag.flexible as usize))) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.incomplete_type, context->current_unit, node.span, none,
            context::empty_span(), type_id);
        return false;
    }
    if (!inferred) {
        let type_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
        let initializer_node: syntax::SyntaxNode =
            context::node(context, context->current_unit, type_node.next_sibling);
        let initializer_kind_is_valid: bool = memory_initializer_kind_is_valid(initializer_node.kind);
        if (type_info::is_memory(type_record.kind) && !initializer_kind_is_valid) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_initializer, context->current_unit, initializer_node.span,
                none, context::empty_span(), type_id);
            return false;
        }
        initializer = expr::lower_expression(context, type_node.next_sibling, type_id);
        if (!initializer.valid || initializer.type_id != type_id) {
            context::add_diagnostic(
                context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span, none,
                context::empty_span(), type_id);
            return false;
        }
    }
    let mutable_binding: bool = (node.flags & (syntax::SyntaxFlag.mutable_binding as usize)) != 0;
    let volatile_binding: bool = (node.flags & (syntax::SyntaxFlag.volatile_ as usize)) != 0;
    let alignment: const_model::Alignment = consteval::declaration_alignment(context, context->current_unit, node_id);
    if (!alignment.valid) {
        return false;
    }
    let slot_id: usize = ir::add_slot(
        &context->ir, builder::current_ir_function(context), type_id, mutable_binding, volatile_binding,
        alignment.alignment);
    let address: usize = builder::address_of_slot(context, node, slot_id, type_id, false, volatile_binding);
    if (!builder::store_to_address(
            context, node, address, type_id, initializer)) {
        return false;
    }
    return builder::append_local(
        context, {
            function_id = context->current_function, type_id = type_id, slot_id = slot_id,
            unit_index = context->current_unit, declaration_node = node_id, name_token = node.token_index,
            scope_depth = context->scope_depth, mutable_binding = mutable_binding, volatile_binding = volatile_binding,
            constant_binding = false, integer_value = 0,
        }) != none;
}

fn lower_constant(context: *context::Context, node_id: usize, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    if (node.child_count !=
        2 + attributes::count_attribute_children(
            context, context->current_unit, node)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let duplicate: usize = builder::local_in_current_scope(context, context->current_unit, node.token_index);
    if (duplicate != none) {
        let locals: *const context::Local = context->locals.data as *const context::Local;
        context::add_diagnostic(
            context, context::DiagnosticKind.duplicate_local, context->current_unit, node.span,
            locals[duplicate].unit_index,
            context::node(context, locals[duplicate].unit_index, locals[duplicate].declaration_node).span, duplicate);
        return false;
    }
    let type_id: usize = types::resolve_type_node(context, context->current_unit, node.first_child);
    if (type_id == none) {
        return false;
    }
    if (!types::require_opaque_value_access(context, type_id, context->current_unit, node.span)) {
        return false;
    }
    let type_record: type_info::Record = context::type_record(context, type_id);
    if (!type_info::is_integer(type_record.kind) && type_record.kind != type_info::Kind.boolean) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit,
            context::node(context, context->current_unit, node.first_child).span, none, context::empty_span(), type_id);
        return false;
    }
    let initializer_id: usize = context::node(context, context->current_unit, node.first_child).next_sibling;
    let value: const_model::Value = const_engine::expression(context, context->current_unit, initializer_id);
    if (!value.is_constant || value.error) {
        context::add_diagnostic(
            context, context::DiagnosticKind.non_constant_expression, context->current_unit,
            context::node(context, context->current_unit, initializer_id).span, none, context::empty_span(), node_id);
        return false;
    }
    if (!const_engine::const_value_conforms(
            context, context->current_unit, context::node(context, context->current_unit, initializer_id).span,
            type_id, value)) {
        return false;
    }
    return builder::append_local(
        context, {
            function_id = context->current_function, type_id = type_id, slot_id = none,
            unit_index = context->current_unit, declaration_node = node_id, name_token = node.token_index,
            scope_depth = context->scope_depth, mutable_binding = false, volatile_binding = false,
            constant_binding = true, integer_value = value.value,
        }) != none;
}

fn assignment_operation(operation: lexer::TokenKind) -> lexer::TokenKind {
    if (operation == lexer::TokenKind.plus_equal) {
        return lexer::TokenKind.plus;
    }
    if (operation == lexer::TokenKind.minus_equal) {
        return lexer::TokenKind.minus;
    }
    if (operation == lexer::TokenKind.star_equal) {
        return lexer::TokenKind.star;
    }
    if (operation == lexer::TokenKind.slash_equal) {
        return lexer::TokenKind.slash;
    }
    if (operation == lexer::TokenKind.percent_equal) {
        return lexer::TokenKind.percent;
    }
    if (operation == lexer::TokenKind.ampersand_equal) {
        return lexer::TokenKind.ampersand;
    }
    if (operation == lexer::TokenKind.pipe_equal) {
        return lexer::TokenKind.pipe;
    }
    if (operation == lexer::TokenKind.caret_equal) {
        return lexer::TokenKind.caret;
    }
    if (operation == lexer::TokenKind.shift_left_equal) {
        return lexer::TokenKind.shift_left;
    }
    if (operation == lexer::TokenKind.shift_right_equal) {
        return lexer::TokenKind.shift_right;
    }
    return lexer::TokenKind.invalid;
}

fn lower_assignment(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    if (node.child_count != 2) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let target_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let target: context::Expression = expr::lower_expression(context, node.first_child, context::no_id());
    if (!target.valid || !category::is_assignable(target.category)) {
        context::add_diagnostic(
            context, category::is_lvalue(target.category) ? context::DiagnosticKind.immutable_assignment :
                context::DiagnosticKind.invalid_lvalue, context->current_unit, target_node.span, context::no_id(),
            context::empty_span(), target.type_id);
        return false;
    }
    let target_record: type_info::Record = context::type_record(context, target.type_id);
    if ((target_record.flags & ((type_info::Flag.header as usize) | (type_info::Flag.flexible as usize))) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.incomplete_type, context->current_unit, target_node.span, context::no_id(),
            context::empty_span(), target.type_id);
        return false;
    }
    let assignment: lexer::TokenKind = context::token(context, context->current_unit, node.token_index).kind;
    let compound_operation: lexer::TokenKind = assignment != lexer::TokenKind.equal ? assignment_operation(assignment) :
            lexer::TokenKind.invalid;
    let pointer_additive: bool = compound_operation == lexer::TokenKind.plus ||
        compound_operation == lexer::TokenKind.minus;
    let value_expected: usize = pointer_additive &&
        context::type_record(context, target.type_id).kind == type_info::Kind.pointer ?
            type_info::BuiltinType.unsigned_size as usize : target.type_id;
    let value: context::Expression = expr::lower_expression(context, target_node.next_sibling, value_expected);
    if (!value.valid || value.type_id != value_expected) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span, context::no_id(),
            context::empty_span(), target.type_id);
        return false;
    }
    var stored: context::Expression = value;
    if (assignment != lexer::TokenKind.equal) {
        let type_record: type_info::Record = context::type_record(context, target.type_id);
        if (type_record.kind == type_info::Kind.pointer && pointer_additive) {
            if (!operators::pointer_arithmetic_is_allowed(
                    context, target.type_id)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_operator, context->current_unit, node.span,
                    context::no_id(), context::empty_span(), target.type_id);
                return false;
            }
            var count_value: usize = value.value_id;
            if (compound_operation == lexer::TokenKind.minus) {
                count_value = operators::emit_negated_usize(context, node, value.value_id);
            }
            let result_value: usize =
                operators::emit_pointer_offset(context, node, target.value_id, target.type_id, count_value);
            stored.type_id = target.type_id;
            stored.address_id = context::no_id();
            stored.category = category::Category.rvalue;
            stored.value_id = result_value;
            stored.valid = result_value != context::no_id();
        } else {
        var opcode: ir::Opcode = ir::Opcode.invalid;
        if (type_info::is_integer(type_record.kind) && (operators::binary_is_arithmetic(compound_operation) ||
                operators::binary_is_bitwise(compound_operation))) {
            opcode = ir::Opcode.binary_integer;
        } else if (type_info::is_float(type_record.kind) && operators::binary_is_arithmetic(compound_operation) &&
            compound_operation != lexer::TokenKind.percent) {
            opcode = ir::Opcode.binary_float;
        }
        if (opcode == ir::Opcode.invalid) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_operator, context->current_unit, node.span, context::no_id(),
                context::empty_span(), target.type_id);
            return false;
        }
        var instruction: ir::Instruction = builder::instruction(opcode, node);
        instruction.operation = compound_operation;
        instruction.left = target.value_id;
        instruction.right = value.value_id;
        let result_value: usize = builder::emit_value(context, instruction, target.type_id);
        stored.value_id = result_value;
        stored.valid = result_value != context::no_id();
        }
    }
    if (target.bitfield_segment != context::no_id()) {
        return access::store_bitfield(context, node, target.address_id, target.bitfield_segment, stored);
    }
    return builder::store_to_address(context, node, target.address_id, target.type_id, stored);
}

fn lower_if(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    if (node.child_count < 2 || node.child_count > 3) {
        return false;
    }
    let condition_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let condition: context::Expression =
        expr::lower_expression(context, node.first_child, type_info::BuiltinType.boolean as usize);
    if (!condition.valid || condition.type_id != type_info::BuiltinType.boolean as usize) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_condition, context->current_unit, condition_node.span, none,
            context::empty_span(), condition.type_id);
        return false;
    }
    let then_block: usize = builder::add_current_block(context);
    let else_block: usize = builder::add_current_block(context);
    let merge_block: usize = builder::add_current_block(context);
    builder::emit_branch(context, node, condition.value_id, then_block, else_block);
    context->current_block = then_block;
    lower_block(context, condition_node.next_sibling);
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, merge_block);
    }
    context->current_block = else_block;
    if (node.child_count == 3) {
        let then_node: syntax::SyntaxNode = context::node(context, context->current_unit, condition_node.next_sibling);
        let else_node: syntax::SyntaxNode = context::node(context, context->current_unit, then_node.next_sibling);
        if (else_node.kind == syntax::SyntaxKind.if_statement) {
            lower_if(context, else_node);
        } else {
            lower_block(context, then_node.next_sibling);
        }
    }
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, merge_block);
    }
    context->current_block = merge_block;
    return true;
}

fn lower_while(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    if (node.child_count != 2) {
        return false;
    }
    let condition_block: usize = builder::add_current_block(context);
    let body_block: usize = builder::add_current_block(context);
    let exit_block: usize = builder::add_current_block(context);
    builder::emit_jump(context, node, condition_block);
    context->current_block = condition_block;
    let condition_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let condition: context::Expression =
        expr::lower_expression(context, node.first_child, type_info::BuiltinType.boolean as usize);
    if (!condition.valid || condition.type_id != type_info::BuiltinType.boolean as usize) {
        return false;
    }
    builder::emit_branch(context, node, condition.value_id, body_block, exit_block);
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = condition_block;
    let pushed_label: bool = labels::push_loop_label(context);
    context->current_block = body_block;
    lower_block(context, condition_node.next_sibling);
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, condition_block);
    }
    if (pushed_label) {
        labels::pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn lower_do(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    if (node.child_count != 2) {
        return false;
    }
    let body_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let body_block: usize = builder::add_current_block(context);
    let condition_block: usize = builder::add_current_block(context);
    let exit_block: usize = builder::add_current_block(context);
    builder::emit_jump(context, node, body_block);
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = condition_block;
    let pushed_label: bool = labels::push_loop_label(context);
    context->current_block = body_block;
    lower_block(context, node.first_child);
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, condition_block);
    }
    context->current_block = condition_block;
    let condition: context::Expression =
        expr::lower_expression(context, body_node.next_sibling, type_info::BuiltinType.boolean as usize);
    if (!condition.valid || condition.type_id != type_info::BuiltinType.boolean as usize) {
        return false;
    }
    builder::emit_branch(context, node, condition.value_id, body_block, exit_block);
    if (pushed_label) {
        labels::pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn lower_loop(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    if (node.child_count != 1) {
        return false;
    }
    let body_block: usize = builder::add_current_block(context);
    let exit_block: usize = builder::add_current_block(context);
    builder::emit_jump(context, node, body_block);
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = body_block;
    let pushed_label: bool = labels::push_loop_label(context);
    context->current_block = body_block;
    lower_block(context, node.first_child);
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, body_block);
    }
    if (pushed_label) {
        labels::pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn lower_for_clause(context: *context::Context, wrapper_id: usize) -> bool {
    let wrapper: syntax::SyntaxNode = context::node(context, context->current_unit, wrapper_id);
    if (wrapper.child_count == 0) {
        return true;
    }
    if (wrapper.child_count != 1) {
        return false;
    }
    let child: syntax::SyntaxNode = context::node(context, context->current_unit, wrapper.first_child);
    if (child.kind == syntax::SyntaxKind.variable_declaration) {
        return lower_variable(context, wrapper.first_child, child);
    }
    if (child.kind == syntax::SyntaxKind.assignment_statement) {
        return lower_assignment(context, child);
    }
    if (child.kind == syntax::SyntaxKind.expression_statement && child.child_count == 1) {
        return expr::lower_expression(context, child.first_child, context::no_id()).valid;
    }
    return false;
}

fn lower_for(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    if (node.child_count != 4) {
        return false;
    }
    let local_start: usize = builder::enter_scope(context);
    if (local_start == context::no_id()) {
        return false;
    }
    let initializer: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let condition_wrapper: syntax::SyntaxNode = context::node(context, context->current_unit, initializer.next_sibling);
    let update_wrapper: syntax::SyntaxNode =
        context::node(context, context->current_unit, condition_wrapper.next_sibling);
    lower_for_clause(context, node.first_child);
    let condition_block: usize = builder::add_current_block(context);
    let body_block: usize = builder::add_current_block(context);
    let update_block: usize = builder::add_current_block(context);
    let exit_block: usize = builder::add_current_block(context);
    builder::emit_jump(context, node, condition_block);
    context->current_block = condition_block;
    if (condition_wrapper.child_count == 0) {
        builder::emit_jump(context, node, body_block);
    } else {
        let condition: context::Expression =
            expr::lower_expression(context, condition_wrapper.first_child, type_info::BuiltinType.boolean as usize);
        if (!condition.valid || condition.type_id != type_info::BuiltinType.boolean as usize) {
            builder::leave_scope(context, local_start);
            return false;
        }
        builder::emit_branch(context, node, condition.value_id, body_block, exit_block);
    }
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = update_block;
    let pushed_label: bool = labels::push_loop_label(context);
    context->current_block = body_block;
    lower_block(context, update_wrapper.next_sibling);
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, update_block);
    }
    context->current_block = update_block;
    lower_for_clause(context, condition_wrapper.next_sibling);
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, condition_block);
    }
    if (pushed_label) {
        labels::pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    builder::leave_scope(context, local_start);
    return true;
}

fn switch_label(context: *context::Context, node_id: usize, control_type: usize) -> context::Expression {
    let node: syntax::SyntaxNode = context::node(context, context->current_unit, node_id);
    let control_record: type_info::Record = context::type_record(context, control_type);
    if (control_record.kind == type_info::Kind.enumeration) {
        let result: context::Expression = access::lower_enum_member(context, node);
        if (result.type_id == control_type) {
            return result;
        }
        return base::invalid_expression();
    }
    if (node.kind == syntax::SyntaxKind.integer_expression) {
        return numeric::lower_integer_literal(context, node, control_type);
    }
    if (node.kind == syntax::SyntaxKind.name_expression) {
        return access::lower_const_name(context, node);
    }
    if (node.kind == syntax::SyntaxKind.unary_expression) {
        return expr::lower_unary(context, node, control_type);
    }
    return base::invalid_expression();
}

fn lower_switch(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    if (node.child_count < 2) {
        return false;
    }
    let expression_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let control: context::Expression = expr::lower_expression(context, node.first_child, none);
    if (!control.valid) {
        return false;
    }
    let control_record: type_info::Record = context::type_record(context, control.type_id);
    if (!type_info::is_integer(control_record.kind) && control_record.kind != type_info::Kind.enumeration) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_switch, context->current_unit, node.span, none,
            context::empty_span(), control.type_id);
        return false;
    }
    var arm_blocks: bytes::Buffer = bytes::empty();
    var arm_node: usize = expression_node.next_sibling;
    var default_block: usize = none;
    while (arm_node != none && context->error == runtime::Error.none) {
        let arm: syntax::SyntaxNode = context::node(context, context->current_unit, arm_node);
        let block_id: usize = builder::add_current_block(context);
        let appended: bytes::BufferResult =
            bytes::append(arm_blocks, (&block_id) as *const usize as *const u8, sizeof(usize));
        arm_blocks = appended.buffer;
        context->error = appended.error;
        if ((arm.flags & (syntax::SyntaxFlag.default_arm as usize)) != 0) {
            if (default_block != none) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.duplicate_default, context->current_unit, arm.span, none,
                    context::empty_span(), 0);
            }
            default_block = block_id;
        }
        arm_node = arm.next_sibling;
    }
    var seen_values: bytes::Buffer = bytes::empty();
    let blocks: *const usize = arm_blocks.data as *const usize;
    arm_node = expression_node.next_sibling;
    var arm_index: usize = 0;
    while (arm_node != none && context->error == runtime::Error.none) {
        let arm: syntax::SyntaxNode = context::node(context, context->current_unit, arm_node);
        let is_default: bool = (arm.flags & (syntax::SyntaxFlag.default_arm as usize)) != 0;
        var child: usize = arm.first_child;
        let label_count: usize = is_default ? 0 : arm.child_count - 1;
        var label_index: usize = 0;
        while (label_index < label_count) {
            let label: context::Expression = switch_label(context, child, control.type_id);
            if (!label.valid || label.type_id != control.type_id) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_switch, context->current_unit,
                    context::node(context, context->current_unit, child).span,
                    none, context::empty_span(), control.type_id);
            } else {
                let values: *const u64 = seen_values.data as *const u64;
                var duplicate: bool = false;
                var value_index: usize = 0;
                while (value_index < seen_values.length / sizeof(u64)) {
                    if (values[value_index] == label.constant_value) {
                        duplicate = true;
                        break;
                    }
                    value_index += 1;
                }
                if (duplicate) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.duplicate_case, context->current_unit,
                        context::node(context, context->current_unit, child).span,
                        none, context::empty_span(), value_index);
                }
                let appended: bytes::BufferResult =
                    bytes::append(seen_values, (&label.constant_value) as *const u64 as *const u8, sizeof(u64));
                seen_values = appended.buffer;
                context->error = appended.error;
                var comparison: ir::Instruction = builder::instruction(ir::Opcode.compare, arm);
                comparison.operation = lexer::TokenKind.equal_equal;
                comparison.left = control.value_id;
                comparison.right = label.value_id;
                let comparison_value: usize =
                    builder::emit_value(context, comparison, type_info::BuiltinType.boolean as usize);
                let next_test: usize = builder::add_current_block(context);
                builder::emit_branch(context, arm, comparison_value, blocks[arm_index], next_test);
                context->current_block = next_test;
            }
            child = context::node(context, context->current_unit, child).next_sibling;
            label_index += 1;
        }
        arm_node = arm.next_sibling;
        arm_index += 1;
    }
    let exit_block: usize = builder::add_current_block(context);
    builder::emit_jump(context, node, default_block != none ? default_block : exit_block);
    let saved_break: usize = context->break_block;
    context->break_block = exit_block;
    arm_node = expression_node.next_sibling;
    arm_index = 0;
    while (arm_node != none) {
        let arm: syntax::SyntaxNode = context::node(context, context->current_unit, arm_node);
        context->current_block = blocks[arm_index];
        lower_block(context, arm.last_child);
        if (!builder::block_is_terminated(
                context, context->current_block)) {
            builder::emit_jump(context, arm, exit_block);
        }
        arm_node = arm.next_sibling;
        arm_index += 1;
    }
    context->break_block = saved_break;
    context->current_block = exit_block;
    var release_error: runtime::Error = bytes::release(arm_blocks);
    release_error = context::release_error(release_error, bytes::release(seen_values));
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return true;
}

fn lower_return(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let return_type: usize = functions[context->current_function].return_type;
    let return_record: type_info::Record = context::type_record(context, return_type);
    if ((functions[context->current_function].flags & (context::SymbolFlag.no_return as usize)) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.noreturn_returns, context->current_unit, node.span, context::no_id(),
            context::empty_span(), 0);
    }
    var instruction: ir::Instruction =
        builder::instruction(
            return_record.kind == type_info::Kind.type_void ? ir::Opcode.return_void : ir::Opcode.return_value, node);
    instruction.type_id = return_type;
    if (return_record.kind == type_info::Kind.type_void) {
        if (node.child_count != 0) {
            context::add_diagnostic(
                context, context::DiagnosticKind.return_type, context->current_unit, node.span, context::no_id(),
                context::empty_span(), return_type);
            return false;
        }
    } else {
        if (node.child_count != 1) {
            context::add_diagnostic(
                context, context::DiagnosticKind.return_type, context->current_unit, node.span, context::no_id(),
                context::empty_span(), return_type);
            return false;
        }
        let value: context::Expression = expr::lower_expression(context, node.first_child, return_type);
        if (!value.valid || value.type_id != return_type) {
            context::add_diagnostic(
                context, context::DiagnosticKind.return_type, context->current_unit, node.span, context::no_id(),
                context::empty_span(), return_type);
            return false;
        }
        instruction.left = type_info::is_memory(return_record.kind) ? value.address_id : value.value_id;
    }
    builder::emit_void(context, instruction);
    context->current_block = builder::add_current_block(context);
    return true;
}

fn lower_va_start(context: *context::Context, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    // va_start initializes a local va_list against the variadic function's
    // register save area; outside a variadic function there is nothing to
    // bind it to.
    if (!builder::current_function_is_variadic(context)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_va_list, context->current_unit, node.span, none,
            context::empty_span(), 0);
        return false;
    }
    let list: context::Expression = expr::lower_expression(context, node.first_child, none);
    if (!list.valid) {
        return false;
    }
    if (!category::is_assignable(list.category) || list.type_id != (type_info::BuiltinType.va_list_type as usize)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_va_list, context->current_unit, node.span, none,
            context::empty_span(), 0);
        return false;
    }
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.va_list_start, node);
    instruction.left = list.address_id;
    return builder::emit_void(context, instruction) != none;
}

fn lower_statement(context: *context::Context, node_id: usize) -> bool {
    let node: syntax::SyntaxNode = context::node(context, context->current_unit, node_id);
    if (node.kind == syntax::SyntaxKind.variable_declaration) {
        return lower_variable(context, node_id, node);
    }
    if (node.kind == syntax::SyntaxKind.const_declaration) {
        return lower_constant(context, node_id, node);
    }
    if (node.kind == syntax::SyntaxKind.assignment_statement) {
        return lower_assignment(context, node);
    }
    if (node.kind == syntax::SyntaxKind.expression_statement) {
        return node.child_count == 1 && expr::lower_expression(context, node.first_child, context::no_id()).valid;
    }
    if (node.kind == syntax::SyntaxKind.block_statement) {
        return lower_block(context, node_id);
    }
    if (node.kind == syntax::SyntaxKind.if_statement) {
        return lower_if(context, node);
    }
    if (node.kind == syntax::SyntaxKind.while_statement) {
        return lower_while(context, node);
    }
    if (node.kind == syntax::SyntaxKind.do_statement) {
        return lower_do(context, node);
    }
    if (node.kind == syntax::SyntaxKind.for_statement) {
        return lower_for(context, node);
    }
    if (node.kind == syntax::SyntaxKind.loop_statement) {
        return lower_loop(context, node);
    }
    if (node.kind == syntax::SyntaxKind.switch_statement) {
        return lower_switch(context, node);
    }
    if (node.kind == syntax::SyntaxKind.break_statement) {
        if (node.child_count == 1) {
            return labels::lower_labeled_control(context, node, true);
        }
        if (context->break_block == context::no_id()) {
            context::add_diagnostic(
                context, context::DiagnosticKind.break_outside_control, context->current_unit, node.span,
                context::no_id(), context::empty_span(), 0);
            return false;
        }
        builder::emit_jump(context, node, context->break_block);
        context->current_block = builder::add_current_block(context);
        return true;
    }
    if (node.kind == syntax::SyntaxKind.continue_statement) {
        if (node.child_count == 1) {
            return labels::lower_labeled_control(context, node, false);
        }
        if (context->continue_block == context::no_id()) {
            context::add_diagnostic(
                context, context::DiagnosticKind.continue_outside_loop, context->current_unit, node.span,
                context::no_id(), context::empty_span(), 0);
            return false;
        }
        builder::emit_jump(context, node, context->continue_block);
        context->current_block = builder::add_current_block(context);
        return true;
    }
    if (node.kind == syntax::SyntaxKind.return_statement) {
        return lower_return(context, node);
    }
    if (node.kind == syntax::SyntaxKind.labeled_statement) {
        return labels::lower_labeled(context, node, lower_statement);
    }
    if (node.kind == syntax::SyntaxKind.goto_statement) {
        return labels::lower_goto(context, node);
    }
    if (node.kind == syntax::SyntaxKind.assert_statement) {
        return consteval::check_assert(context, context->current_unit, node_id);
    }
    if (node.kind == syntax::SyntaxKind.va_start_statement) {
        return lower_va_start(context, node);
    }
    context::add_diagnostic(
        context, context::DiagnosticKind.internal_invariant, context->current_unit, node.span, context::no_id(),
        context::empty_span(), node.kind as usize);
    return false;
}

fn next_constructor_initializer(context: *context::Context, declaration_unit: usize, child: usize) -> usize {
    var current: usize = child;
    for (; current != context::no_id();
        current = context::node(context, declaration_unit, current).next_sibling) {
        if (context::node(
                context, declaration_unit, current).kind == syntax::SyntaxKind.constructor_initializer) {
            return current;
        }
    }
    return context::no_id();
}

fn lower_member_initializers(context: *context::Context, function: context::Function) -> bool {
    let declaration: syntax::SyntaxNode = context::node(
        context, function.implementation_unit, function.implementation_node);
    var initializer_id: usize = next_constructor_initializer(
        context, function.implementation_unit, declaration.first_child);
    if (initializer_id == context::no_id()) {
        return true;
    }
    let receiver: context::Expression = access::lower_this(
        context, context::node(context, function.implementation_unit, initializer_id));
    if (!receiver.valid) {
        return false;
    }
    let owner: type_info::Record = context::type_record(context, function.identity.owner_type);
    let fields: *const type_info::Field = context->types.fields.data as *const type_info::Field;
    for (var index: usize = 0; index < owner.field_count && initializer_id != context::no_id(); index += 1) {
        let field: type_info::Field = fields[owner.first_field + index];
        let initializer: syntax::SyntaxNode = context::node(context, function.implementation_unit, initializer_id);
        let matches: bool = context::tokens_equal(
            context, function.implementation_unit, initializer.token_index, field.declaration_unit, field.name_token);
        if (!matches) {
            continue;
        }
        let pointer: type_info::IdResult = type_info::table_pointer(&context->types, field.type_id, false, false);
        context->error = pointer.error;
        var address: ir::Instruction = builder::instruction(ir::Opcode.member_address, initializer);
        address.left = receiver.value_id;
        address.auxiliary = field.offset_bytes;
        let field_address: usize = builder::emit_value(context, address, pointer.type_id);
        let value: context::Expression = expr::lower_expression_into(
            context, initializer.first_child, field.type_id, field_address);
        if (!value.valid || value.type_id != field.type_id) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_member_initializer,
                function.implementation_unit, initializer.span, field.declaration_unit,
                context::node(context, field.declaration_unit, field.declaration_node).span, owner.first_field + index);
            return false;
        }
        if (!builder::store_to_address(context, initializer, field_address, field.type_id, value)) {
            return false;
        }
        initializer_id = next_constructor_initializer(context, function.implementation_unit, initializer.next_sibling);
    }
    return initializer_id == context::no_id();
}

fn lower_constructor_block(context: *context::Context, body_id: usize, function: context::Function) -> bool {
    let body: syntax::SyntaxNode = context::node(context, context->current_unit, body_id);
    if (body.kind != syntax::SyntaxKind.block_statement) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let local_start: usize = builder::enter_scope(context);
    if (local_start == context::no_id()) {
        return false;
    }
    var child: usize = body.first_child;
    let owner: type_info::Record = context::type_record(context, function.identity.owner_type);
    if (owner.base_type != context::no_id() && child != context::no_id()) {
        lower_statement(context, child);
        child = context::node(context, context->current_unit, child).next_sibling;
    }
    if (!lower_member_initializers(context, function)) {
        builder::leave_scope(context, local_start);
        return false;
    }
    for (; child != context::no_id() && context->error == runtime::Error.none;
        child = context::node(context, context->current_unit, child).next_sibling) {
        lower_statement(context, child);
    }
    builder::leave_scope(context, local_start);
    return context->error == runtime::Error.none;
}

fn lower_block(context: *context::Context, node_id: usize) -> bool {
    let node: syntax::SyntaxNode = context::node(context, context->current_unit, node_id);
    if (node.kind != syntax::SyntaxKind.block_statement) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let local_start: usize = builder::enter_scope(context);
    if (local_start == context::no_id()) {
        return false;
    }
    for (var child: usize = node.first_child;
        child != context::no_id() && context->error == runtime::Error.none;
        child = context::node(context, context->current_unit, child).next_sibling) {
        lower_statement(context, child);
    }
    builder::leave_scope(context, local_start);
    return context->error == runtime::Error.none;
}

fn function_body(context: *context::Context, function: context::Function) -> usize {
    if (function.implementation_unit == context::no_id()) {
        return context::no_id();
    }
    let declaration: syntax::SyntaxNode =
        context::node(context, function.implementation_unit, function.implementation_node);
    var parameter_count: usize = 0;
    var return_node: usize = context::no_id();
    var body_node: usize = context::no_id();
    functions::function_parts(
        context, function.implementation_unit, declaration, &parameter_count, &return_node, &body_node);
    return body_node;
}

fn add_parameter_locals(context: *context::Context, function_id: usize) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[function_id];
    let declaration: syntax::SyntaxNode =
        context::node(context, function.implementation_unit, function.implementation_node);
    let ir_functions: *const ir::Function = context->ir.functions.data as
            *const ir::Function;
    let ir_function: ir::Function = ir_functions[function.ir_function];
    let ir_parameters: *const ir::Parameter = context->ir.parameters.data as
            *const ir::Parameter;
    let semantic_parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    var child: usize = declaration.first_child;
    let receiver_count: usize = functions::function_receiver_parameter_count(function);
    for (var index: usize = 0; index < function.parameter_count; index += 1) {
        let parameter_node: syntax::SyntaxNode = context::node(context, function.implementation_unit, child);
        let parameter: context::Parameter = semantic_parameters[ function.first_parameter + index];
        let ir_parameter: ir::Parameter = ir_parameters[ir_function.first_parameter + receiver_count + index];
        builder::append_local(
            context, {
                function_id = function_id, type_id = parameter.type_id, slot_id = ir_parameter.slot_id,
                unit_index = function.implementation_unit, declaration_node = child,
                name_token = parameter_node.token_index, scope_depth = 0, mutable_binding = false,
                volatile_binding = false, constant_binding = false, integer_value = 0,
            });
        child = parameter_node.next_sibling;
    }
    return context->error == runtime::Error.none;
}

fn lower_function(context: *context::Context, function_id: usize) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[function_id];
    let body_node: usize = function_body(context, function);
    if (body_node == context::no_id()) {
        return true;
    }
    // An asm fn body is raw assembly text spliced into the emitted
    // assembly by the backend; it lowers to no IR blocks at all (the
    // semantic pass already validated that it holds only string literals).
    if ((function.flags & (context::SymbolFlag.asm_function as usize)) != 0) {
        return context->error == runtime::Error.none;
    }
    context->current_function = function_id;
    context->current_unit = function.implementation_unit;
    context->scope_depth = 0;
    context->local_count = 0;
    let cleared: bytes::BufferResult = bytes::clear(context->locals);
    context->locals = cleared.buffer;
    context->error = cleared.error;
    labels::clear_label_state(context);
    context->break_block = context::no_id();
    context->continue_block = context::no_id();
    context->current_block = builder::add_current_block(context);
    add_parameter_locals(context, function_id);
    if (function.identity.kind == callable::Kind.constructor) {
        lower_constructor_block(context, body_node, function);
    } else {
        lower_block(context, body_node);
    }
    labels::validate_labels(context);
    let return_record: type_info::Record = context::type_record(context, function.return_type);
    let ir_functions: *const ir::Function = context->ir.functions.data as
            *const ir::Function;
    let reachable: bool =
        builder::block_is_reachable(context, ir_functions[function.ir_function], context->current_block);
    if (!builder::block_is_terminated(
            context, context->current_block) && reachable) {
        if ((function.flags & (context::SymbolFlag.no_return as usize)) != 0) {
            context::add_diagnostic(
                context, context::DiagnosticKind.noreturn_returns, context->current_unit,
                context::node(context, context->current_unit, body_node).span,
                context::no_id(), context::empty_span(), 0);
        } else if (return_record.kind == type_info::Kind.type_void) {
            let body: syntax::SyntaxNode = context::node(context, context->current_unit, body_node);
            var instruction: ir::Instruction = builder::instruction(ir::Opcode.return_void, body);
            instruction.type_id = function.return_type;
            builder::emit_void(context, instruction);
        } else {
            context::add_diagnostic(
                context, context::DiagnosticKind.missing_return, context->current_unit,
                context::node(context, context->current_unit, body_node).span,
                context::no_id(), context::empty_span(), function.return_type);
        }
    }
    builder::terminate_unreachable_blocks(
        context, ir_functions[function.ir_function], context::node(context, context->current_unit, body_node));
    return context->error == runtime::Error.none;
}

fn lower_functions(context: *context::Context) -> bool {
    for (var order_index: usize = 0;
        order_index < context->callable_candidate_count && context->error == runtime::Error.none;
        order_index += 1) {
        lower_function(context, functions::ordered_function_id(context, order_index));
    }
    return context->error == runtime::Error.none;
}
