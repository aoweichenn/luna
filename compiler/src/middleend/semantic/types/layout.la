module luna.bootstrap.middleend.semantic.types;

import luna.bootstrap.middleend.semantic.classes.model as class_model;

fn class_record_id(context: *context::Context, type_id: usize) -> usize {
    let records: *const class_model::Record = context->classes.records.data as *const class_model::Record;
    for (var record_id: usize = 0; record_id < context->classes.record_count; record_id += 1) {
        if (records[record_id].type_id == type_id) {
            return record_id;
        }
    }
    return context::no_id();
}

fn extend_class_layout(
    context: *context::Context, type_id: usize, size_bytes: *usize, alignment_bytes: *usize) -> bool {
    let record_id: usize = class_record_id(context, type_id);
    let record_is_valid: bool = record_id != context::no_id();
    let outputs_are_valid: bool = size_bytes != null && alignment_bytes != null;
    if (!record_is_valid || !outputs_are_valid) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var records: *class_model::Record = context->classes.records.data as *class_model::Record;
    let record: class_model::Record = records[record_id];
    let polymorphic: bool = (record.flags & (class_model::Flag.polymorphic as usize)) != 0;
    if (!polymorphic) {
        if (record.vptr_offset != context::no_id()) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        return true;
    }
    let base_record_id: usize = class_record_id(context, record.base_type);
    if (base_record_id != context::no_id()) {
        let base: class_model::Record = records[base_record_id];
        let base_is_polymorphic: bool = (base.flags & (class_model::Flag.polymorphic as usize)) != 0;
        if (base_is_polymorphic) {
            if (base.vptr_offset == context::no_id()) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
            context->error = type_info::table_set_vptr(context->types, type_id, base.vptr_offset);
            if (context->error != runtime::Error.none) {
                return false;
            }
            records[record_id].vptr_offset = base.vptr_offset;
            return true;
        }
    }
    var vptr_offset: usize = 0;
    if (!context::align_up(*size_bytes, class_model::Layout.vptr_alignment_bytes as usize, &vptr_offset)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let maximum_object_size: usize = context::Limit.target_maximum_object_size as usize;
    let pointer_size: usize = class_model::Layout.vptr_size_bytes as usize;
    if (vptr_offset > maximum_object_size || pointer_size > maximum_object_size - vptr_offset) {
        report_type_declaration(context, context::DiagnosticKind.object_too_large, type_id, vptr_offset);
        return false;
    }
    records = context->classes.records.data as *class_model::Record;
    context->error = type_info::table_set_vptr(context->types, type_id, vptr_offset);
    if (context->error != runtime::Error.none) {
        return false;
    }
    records[record_id].vptr_offset = vptr_offset;
    *size_bytes = vptr_offset + pointer_size;
    if (*alignment_bytes < class_model::Layout.vptr_alignment_bytes as usize) {
        *alignment_bytes = class_model::Layout.vptr_alignment_bytes as usize;
    }
    return true;
}

fn field_is_anonymous(context: *context::Context, field: type_info::Field) -> bool {
    if (field.declaration_unit == context::no_id() || field.declaration_node == context::no_id()) {
        return false;
    }
    let node: syntax::SyntaxNode = context::node(context, field.declaration_unit, field.declaration_node);
    return node.kind == syntax::SyntaxKind.field_declaration && (node.flags &
            (syntax::SyntaxFlag.anonymous as usize)) != 0;
}

fn anonymous_record_type(context: *context::Context, unit_index: usize, node_index: usize) -> usize {
    let none: usize = context::no_id();
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
    let kind: type_info::Kind = node.kind == syntax::SyntaxKind.structure_declaration ? type_info::Kind.structure :
            type_info::Kind.record_union;
    let records: *const type_info::Record = context->types.types.data as *const type_info::Record;
    var type_id: usize = type_info::BuiltinType.count as usize;
    while (type_id < context->types.type_count) {
        if (records[type_id].kind == kind && records[type_id].declaration_unit == unit_index &&
            records[type_id].declaration_node == node_index) {
            return type_id;
        }
        type_id += 1;
    }
    let added: type_info::TableResult =
        type_info::table_add_named(context->types, kind, unit_index, node_index, node.token_index, false);
    context->types = added.table;
    context->error = added.error;
    if (added.error != runtime::Error.none) {
        return none;
    }
    return context->types.type_count - 1;
}

fn find_type_symbol(context: *context::Context, type_id: usize) -> usize {
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        if (symbols[index].kind == context::SymbolKind.named_type && symbols[index].type_id == type_id) {
            return index;
        }
        index += 1;
    }
    return context::no_id();
}

fn report_type_declaration(
    context: *context::Context, kind: context::DiagnosticKind, type_id: usize, detail: usize) -> bool {
    let symbol_id: usize = find_type_symbol(context, type_id);
    if (symbol_id == context::no_id()) {
        let record: type_info::Record = context::type_record(context, type_id);
        if (record.declaration_unit == context::no_id() || record.declaration_node == context::no_id()) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        return context::add_diagnostic(
            context, kind, record.declaration_unit,
            context::node(context, record.declaration_unit, record.declaration_node).span,
            context::no_id(), context::empty_span(), detail);
    }
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let symbol: context::Symbol = symbols[symbol_id];
    return context::add_diagnostic(
        context, kind, symbol.declaration_unit,
        context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
        context::no_id(), context::empty_span(), detail);
}

fn require_complete_type(context: *context::Context, type_id: usize) -> bool {
    if (type_id >= context->types.type_count) {
        return false;
    }
    let record: type_info::RecordResult = type_info::table_get(context->types, type_id);
    if (record.error != runtime::Error.none) {
        context->error = record.error;
        return false;
    }
    if ((record.record.flags & (type_info::Flag.complete as usize)) != 0) {
        return true;
    }
    return resolve_layout(context, type_id);
}

fn field_name_exists(context: *context::Context, owner_type: usize, unit_index: usize, name_token: usize) -> usize {
    let fields: *const type_info::Field = context->types.fields.data as
            *const type_info::Field;
    var current: usize = owner_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record: type_info::Record = context::type_record(context, current);
        for (var index: usize = 0; index < record.field_count; index += 1) {
            let field_id: usize = record.first_field + index;
            if (context::tokens_equal(
                    context, unit_index, name_token, fields[field_id].declaration_unit, fields[field_id].name_token)) {
                return field_id;
            }
        }
        current = record.base_type;
        if (current == context::no_id()) {
            return context::no_id();
        }
    }
    return context::no_id();
}

fn resolve_record_field_types(context: *context::Context, record: type_info::Record) -> bool {
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    if (record.base_type != context::no_id() && !require_complete_type(context, record.base_type)) {
        return false;
    }
    let base_node: usize = record.base_type != context::no_id() ? declaration.first_child : context::no_id();
    var field_node: usize = declaration.first_child;
    while (field_node != context::no_id() && context->error == runtime::Error.none) {
        let field_declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, field_node);
        if (field_node == base_node) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        let class_method: bool = record.kind == type_info::Kind.class_type &&
            field_declaration.kind == syntax::SyntaxKind.function_declaration;
        let class_policy: bool = record.kind == type_info::Kind.class_type &&
            field_declaration.kind == syntax::SyntaxKind.friend_declaration;
        let class_metadata: bool = class_method || class_policy;
        let generic_metadata: bool = field_declaration.kind == syntax::SyntaxKind.generic_parameters;
        let declaration_metadata: bool = field_declaration.kind == syntax::SyntaxKind.attribute || generic_metadata;
        if (declaration_metadata || class_metadata) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        if (field_declaration.kind != syntax::SyntaxKind.field_declaration || field_declaration.child_count !=
                1 + attributes::count_attribute_children(
                    context, record.declaration_unit, field_declaration)) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        let field_type: usize = resolve_type_node(context, record.declaration_unit, field_declaration.first_child);
        if (field_type != context::no_id()) {
            let value_access: bool = require_opaque_value_access(
                context, field_type, record.declaration_unit, field_declaration.span);
            if (value_access) {
                require_complete_type(context, field_type);
            }
        }
        field_node = field_declaration.next_sibling;
    }
    return context->error == runtime::Error.none;
}

fn resolve_record_layout(context: *context::Context, type_id: usize, record: type_info::Record) -> bool {
    if (!resolve_record_field_types(
            context, record)) {
        return false;
    }
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    let is_union: bool = record.kind == type_info::Kind.record_union;
    let supports_packed: bool = record.kind == type_info::Kind.structure;
    let packed: bool = supports_packed &&
        attributes::declaration_has_attribute(
            context, record.declaration_unit, declaration, attributes::Attribute.packed);
    if (packed) {
        context->error = type_info::table_set_packed(context->types, type_id, true);
        if (context->error != runtime::Error.none) {
            return false;
        }
    }
    var size_bytes: usize = 0;
    var alignment_bytes: usize = 1;
    if (record.base_type != context::no_id()) {
        let base: type_info::Record = context::type_record(context, record.base_type);
        size_bytes = base.size_bytes;
        alignment_bytes = base.alignment_bytes;
    }
    if (record.kind == type_info::Kind.class_type &&
        !extend_class_layout(
            context, type_id, &size_bytes, &alignment_bytes)) {
        return false;
    }
    var has_flexible: bool = false;
    let base_node: usize = record.base_type != context::no_id() ? declaration.first_child : context::no_id();
    var field_node: usize = declaration.first_child;
    while (field_node != context::no_id()) {
        let field_declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, field_node);
        if (field_node == base_node) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        let class_method: bool = record.kind == type_info::Kind.class_type &&
            field_declaration.kind == syntax::SyntaxKind.function_declaration;
        let class_policy: bool = record.kind == type_info::Kind.class_type &&
            field_declaration.kind == syntax::SyntaxKind.friend_declaration;
        let class_metadata: bool = class_method || class_policy;
        let generic_metadata: bool = field_declaration.kind == syntax::SyntaxKind.generic_parameters;
        let declaration_metadata: bool = field_declaration.kind == syntax::SyntaxKind.attribute || generic_metadata;
        if (declaration_metadata || class_metadata) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        if (field_declaration.kind != syntax::SyntaxKind.field_declaration || field_declaration.child_count !=
                1 + attributes::count_attribute_children(
                    context, record.declaration_unit, field_declaration)) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        let anonymous: bool = (field_declaration.flags & (syntax::SyntaxFlag.anonymous as usize)) != 0;
        let duplicate: usize = anonymous ? context::no_id() :
            field_name_exists(context, type_id, record.declaration_unit, field_declaration.token_index);
        if (duplicate != context::no_id()) {
            let fields: *const type_info::Field = context->types.fields.data as
                    *const type_info::Field;
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_field, record.declaration_unit,
                context::token(context, record.declaration_unit, field_declaration.token_index).span,
                fields[duplicate].declaration_unit,
                context::token(context, fields[duplicate].declaration_unit, fields[duplicate].name_token).span,
                duplicate);
            field_node = field_declaration.next_sibling;
            continue;
        }
        let field_type: usize = resolve_type_node(context, record.declaration_unit, field_declaration.first_child);
        if (field_type == context::no_id()) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        let value_access: bool = require_opaque_value_access(
            context, field_type, record.declaration_unit, field_declaration.span);
        if (!value_access || !require_complete_type(context, field_type)) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        let field_record: type_info::RecordResult = type_info::table_get(context->types, field_type);
        if (field_record.error != runtime::Error.none) {
            context->error = field_record.error;
            return false;
        }
        let field_flexible: bool = field_record.record.kind == type_info::Kind.array && (field_record.record.flags &
                (type_info::Flag.flexible as usize)) != 0;
        if (field_flexible) {
            if (record.kind == type_info::Kind.class_type) {
                field_node = field_declaration.next_sibling;
                continue;
            }
            // A flexible member is legal solely in last position of a
            // structure; the record then becomes a header type.
            var last: bool = true;
            var following: usize = field_declaration.next_sibling;
            while (following != context::no_id()) {
                let following_node: syntax::SyntaxNode = context::node(context, record.declaration_unit, following);
                if (following_node.kind == syntax::SyntaxKind.field_declaration) {
                    last = false;
                }
                following = following_node.next_sibling;
            }
            if (is_union || !last) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_flexible_member, record.declaration_unit,
                    field_declaration.span, context::no_id(), context::empty_span(), field_type);
                field_node = field_declaration.next_sibling;
                continue;
            }
            has_flexible = true;
        } else if (field_record.record.kind == type_info::Kind.type_void || field_record.record.size_bytes == 0 ||
            (field_record.record.flags & (type_info::Flag.header as usize)) != 0) {
            context::add_diagnostic(
                context, context::DiagnosticKind.incomplete_type, record.declaration_unit, field_declaration.span,
                context::no_id(), context::empty_span(), field_type);
            field_node = field_declaration.next_sibling;
            continue;
        }
        var field_offset: usize = 0;
        let field_override: usize = builder::alignment_override(context, record.declaration_unit, field_node);
        var field_alignment: usize = field_record.record.alignment_bytes;
        if (field_override > field_alignment) {
            field_alignment = field_override;
        }
        if (packed) {
            field_alignment = 1;
        }
        if (is_union) {
            if (field_record.record.size_bytes > size_bytes) {
                size_bytes = field_record.record.size_bytes;
            }
        } else {
            if (!context::align_up(size_bytes, field_alignment, &field_offset) ||
                field_offset > context::Limit.target_maximum_object_size as usize || field_record.record.size_bytes >
                    (context::Limit.target_maximum_object_size as usize) - field_offset) {
                report_type_declaration(context, context::DiagnosticKind.object_too_large, type_id, field_type);
                return false;
            }
            size_bytes = field_offset + field_record.record.size_bytes;
        }
        if (field_alignment > alignment_bytes) {
            alignment_bytes = field_alignment;
        }
        let added: type_info::TableResult =
            type_info::table_add_field(
                context->types, {
                    owner_type = type_id, type_id = field_type, declaration_unit = record.declaration_unit,
                    declaration_node = field_node, name_token = field_declaration.token_index,
                    offset_bytes = field_offset, alignment_bytes = field_override,
                });
        context->types = added.table;
        context->error = added.error;
        field_node = field_declaration.next_sibling;
    }
    let type_override: usize = builder::alignment_override(context, record.declaration_unit, record.declaration_node);
    if (packed) {
        alignment_bytes = 1;
    } else if (type_override > alignment_bytes) {
        alignment_bytes = type_override;
    }
    if (size_bytes == 0) {
        size_bytes = 1;
    }
    if (has_flexible && record.kind == type_info::Kind.structure) {
        context->error = type_info::table_set_header(context->types, type_id, true);
        if (context->error != runtime::Error.none) {
            return false;
        }
    }
    var aligned_size: usize = 0;
    if (!context::align_up(size_bytes, alignment_bytes, &aligned_size) ||
        aligned_size > context::Limit.target_maximum_object_size as usize) {
        report_type_declaration(context, context::DiagnosticKind.object_too_large, type_id, size_bytes);
        return false;
    }
    context->error = type_info::table_set_layout(context->types, type_id, aligned_size, alignment_bytes);
    return context->error == runtime::Error.none;
}

fn enum_value(
    context: *context::Context, unit_index: usize, member: syntax::SyntaxNode, underlying_kind: type_info::Kind,
    implicit_value: u64, value: *u64, pending: *bool) -> bool {
    *pending = false;
    if (member.child_count == 0) {
        *value = implicit_value;
        return true;
    }
    let initializer: syntax::SyntaxNode = context::node(context, unit_index, member.first_child);
    var literal: syntax::SyntaxNode = initializer;
    var negative: bool = false;
    if (initializer.kind == syntax::SyntaxKind.unary_expression) {
        let operation: lexer::TokenKind = context::token(context, unit_index, initializer.token_index).kind;
        if (initializer.child_count != 1 || (operation != lexer::TokenKind.plus &&
                operation != lexer::TokenKind.minus)) {
            return false;
        }
        negative = operation == lexer::TokenKind.minus;
        literal = context::node(context, unit_index, initializer.first_child);
    }
    if (literal.kind != syntax::SyntaxKind.integer_expression) {
        // A general constant expression (typed const, const fn call, cast,
        // arithmetic): consteval folds it once enum layout is complete.
        *pending = true;
        return true;
    }
    var magnitude: u64 = 0;
    if (!context::parse_unsigned(context, unit_index, literal.token_index, &magnitude) ||
        !context::integer_fits_type(
            underlying_kind, magnitude, negative)) {
        return false;
    }
    *value = builder::mask_integer(negative ? 0 - magnitude : magnitude, type_info::bit_width(underlying_kind));
    return true;
}

fn enum_can_increment(kind: type_info::Kind, value: u64) -> bool {
    let bits: usize = type_info::bit_width(kind);
    if (type_info::is_signed_integer(kind)) {
        let maximum: u64 = bits == 64 ? 9223372036854775807 : ((1 as u64) << ((bits - 1) as u64)) - 1;
        return value != maximum;
    }
    let maximum: u64 = bits == 64 ? 18446744073709551615 : ((1 as u64) << (bits as u64)) - 1;
    return value != maximum;
}

fn resolve_enum_layout(context: *context::Context, type_id: usize, record: type_info::Record) -> bool {
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    if (declaration.child_count == 0) {
        return false;
    }
    let underlying_type: usize = resolve_type_node(context, record.declaration_unit, declaration.first_child);
    if (underlying_type == context::no_id()) {
        return false;
    }
    let underlying: type_info::RecordResult = type_info::table_get(context->types, underlying_type);
    if (underlying.error != runtime::Error.none) {
        context->error = underlying.error;
        return false;
    }
    if (!type_info::is_integer(underlying.record.kind)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_enum_underlying, record.declaration_unit,
            context::node(context, record.declaration_unit, declaration.first_child).span,
            context::no_id(), context::empty_span(), underlying_type);
        return false;
    }
    context->error = type_info::table_set_enum_underlying(context->types, type_id, underlying_type);
    var member_id: usize = context::node(context, record.declaration_unit, declaration.first_child).next_sibling;
    var next_value: u64 = 0;
    var next_value_valid: bool = true;
    var chain_pending: bool = false;
    while (member_id != context::no_id()) {
        let member: syntax::SyntaxNode = context::node(context, record.declaration_unit, member_id);
        if (member.kind == syntax::SyntaxKind.attribute) {
            member_id = member.next_sibling;
            continue;
        }
        let duplicate: usize = find_enum_member(context, type_id, record.declaration_unit, member.token_index);
        if (duplicate != context::no_id()) {
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_enum_member, record.declaration_unit, member.span,
                context::no_id(), context::empty_span(), duplicate);
        } else {
            var value: u64 = next_value;
            var pending: bool = false;
            let implicit_overflow: bool = member.child_count == 0 && !next_value_valid && !chain_pending;
            if (implicit_overflow ||
                !enum_value(
                    context, record.declaration_unit, member, underlying.record.kind, next_value, &value, &pending)) {
                context::add_diagnostic(
                    context, implicit_overflow ? context::DiagnosticKind.enum_value_overflow : context::DiagnosticKind
                            .invalid_enum_value, record.declaration_unit, member.span, context::no_id(),
                    context::empty_span(), type_id);
            } else {
                var flags: usize = context::SymbolFlag.none as usize;
                if (pending || chain_pending) {
                    // The value is folded by consteval once layout is done
                    // (see consteval::resolve_enum_constant_values).
                    flags |= context::SymbolFlag.enum_value_pending as usize;
                }
                names::append_symbol(
                    context, {
                        kind = context::SymbolKind.enum_member,
                        module_id = names::unit_module(context, record.declaration_unit),
                        declaration_unit = record.declaration_unit, declaration_node = member_id,
                        name_token = member.token_index, type_id = type_id, function_id = context::no_id(),
                        integer_value = value, flags = flags,
                    });
                if (pending || chain_pending) {
                    chain_pending = true;
                    next_value_valid = false;
                } else {
                    next_value = builder::mask_integer(value + 1, type_info::bit_width(underlying.record.kind));
                    next_value_valid = enum_can_increment(underlying.record.kind, value);
                }
            }
        }
        member_id = member.next_sibling;
    }
    context->error = type_info::table_set_layout(
        context->types, type_id, underlying.record.size_bytes, underlying.record.alignment_bytes);
    return context->error == runtime::Error.none;
}

fn resolve_alias(context: *context::Context, type_id: usize, record: type_info::Record) -> bool {
    let none: usize = context::no_id();
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    let first: syntax::SyntaxNode = context::node(context, record.declaration_unit, declaration.first_child);
    let generic: bool = first.kind == syntax::SyntaxKind.generic_parameters;
    let metadata_count: usize = attributes::count_attribute_children(
        context, record.declaration_unit, declaration) + (generic ? 1 : 0);
    if (declaration.child_count != 1 + metadata_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let target_node: usize = generic ? first.next_sibling : declaration.first_child;
    let target_type: usize = resolve_type_node(context, record.declaration_unit, target_node);
    if (target_type == none) {
        return false;
    }
    let value_access: bool = require_opaque_value_access(
        context, target_type, record.declaration_unit,
        context::node(context, record.declaration_unit, target_node).span);
    if (!value_access || !require_complete_type(context, target_type)) {
        return false;
    }
    let target: type_info::Record = context::type_record(context, target_type);
    if (target.kind == type_info::Kind.type_void || target.size_bytes == 0 || target.kind == type_info::Kind.alias) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_type_alias, record.declaration_unit,
            context::node(context, record.declaration_unit, target_node).span,
            none, context::empty_span(), target_type);
        return false;
    }
    context->error = type_info::table_set_alias_target(context->types, type_id, target_type);
    return context->error == runtime::Error.none;
}

fn resolve_layout_active(context: *context::Context, type_id: usize) -> bool {
    let result: type_info::RecordResult = type_info::table_get(context->types, type_id);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
        return false;
    }
    let record: type_info::Record = result.record;
    if ((record.flags & (type_info::Flag.complete as usize)) != 0) {
        return true;
    }
    if ((record.flags & (type_info::Flag.resolving as usize)) != 0) {
        report_type_declaration(context, context::DiagnosticKind.recursive_type, type_id, type_id);
        return false;
    }
    if (context->type_depth >= context::Limit.maximum_type_depth as usize) {
        report_type_declaration(context, context::DiagnosticKind.resource_limit, type_id, context->type_depth);
        return false;
    }
    context->type_depth += 1;
    context->error = type_info::table_set_resolving(context->types, type_id, true);
    if (context->error != runtime::Error.none) {
        context->type_depth -= 1;
        return false;
    }
    var success: bool = false;
    if (record.kind == type_info::Kind.enumeration) {
        success = resolve_enum_layout(context, type_id, record);
    } else if (record.kind == type_info::Kind.alias) {
        success = resolve_alias(context, type_id, record);
    } else {
        success = resolve_record_layout(context, type_id, record);
    }
    context->type_depth -= 1;
    return success;
}

fn resolve_layout(context: *context::Context, type_id: usize) -> bool {
    let instance_id: usize = generic_model::instance_for_type(context->generics, type_id);
    if (instance_id == context::no_id()) {
        return resolve_layout_active(context, type_id);
    }
    let mark: usize = generics::activate_instance(context, instance_id);
    if (mark == context::no_id()) {
        return false;
    }
    let success: bool = resolve_layout_active(context, type_id);
    let state: generic_model::InstanceState = success ?
        generic_model::InstanceState.complete : generic_model::InstanceState.failed;
    let state_error: runtime::Error = generic_model::set_instance_result(
        &context->generics, instance_id, type_id, context::no_id(), state);
    let restored: bool = generics::restore_active_bindings(context, mark);
    if (context->error == runtime::Error.none) {
        context->error = state_error;
    }
    let finalization_is_valid: bool = restored && state_error == runtime::Error.none;
    return success && finalization_is_valid;
}

fn resolve_all_types(context: *context::Context) -> bool {
    var type_id: usize = type_info::BuiltinType.count as usize;
    while (type_id < context->types.type_count && context->error == runtime::Error.none) {
        resolve_layout(context, type_id);
        type_id += 1;
    }
    return context->error == runtime::Error.none;
}

fn find_enum_member(context: *context::Context, type_id: usize, unit_index: usize, name_token: usize) -> usize {
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        if (symbols[index].kind == context::SymbolKind.enum_member && symbols[index].type_id == type_id &&
            context::tokens_equal(
                context, unit_index, name_token, symbols[index].declaration_unit, symbols[index].name_token)) {
            return index;
        }
        index += 1;
    }
    return context::no_id();
}
