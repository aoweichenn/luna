module luna.bootstrap.middleend.semantic.types.visibility;

import luna.bootstrap.middleend.type as type_info;
import luna.runtime as runtime;

fn public_type_is_valid(context: *context::Context, type_id: usize) -> bool {
    var current: usize = type_id;
    var record: type_info::Record = context::type_record(context, current);
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let wrapper: bool = record.kind == type_info::Kind.pointer || record.kind == type_info::Kind.array;
        if (!wrapper) {
            break;
        }
        current = record.element_type;
        record = context::type_record(context, current);
    }
    if (!type_info::is_named(record.kind)) {
        return true;
    }
    let symbol_id: usize = types::find_type_symbol(context, current);
    if (symbol_id == context::no_id()) {
        return false;
    }
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    return (symbols[symbol_id].flags & (context::SymbolFlag.exported as usize)) != 0;
}

fn public_anonymous_fields_valid(context: *context::Context, type_id: usize, symbol: context::Symbol) -> bool {
    var valid: bool = true;
    let record: type_info::Record = context::type_record(context, type_id);
    let fields: *const type_info::Field = context->types.fields.data as *const type_info::Field;
    for (var index: usize = 0;
        index < record.field_count && context->error == runtime::Error.none;
        index += 1) {
        let field: type_info::Field = fields[record.first_field + index];
        if (types::field_is_anonymous(context, field)) {
            if (!public_anonymous_fields_valid(
                    context, field.type_id, symbol)) {
                valid = false;
            }
        } else if (!public_type_is_valid(
                context, field.type_id)) {
            context::add_diagnostic(
                context, context::DiagnosticKind.private_type_exposure, field.declaration_unit,
                context::node(context, field.declaration_unit, field.declaration_node).span, symbol.declaration_unit,
                context::node(context, symbol.declaration_unit, symbol.declaration_node).span, field.type_id);
            valid = false;
        }
    }
    return valid;
}

fn validate_public_types(context: *context::Context) -> bool {
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let fields: *const type_info::Field = context->types.fields.data as
            *const type_info::Field;
    let public_flags: usize = (context::SymbolFlag.exported as usize) | (context::SymbolFlag.member_exported as usize);
    for (var symbol_id: usize = 0; symbol_id < context->symbol_count; symbol_id += 1) {
        let symbol: context::Symbol = symbols[symbol_id];
        let symbol_is_public: bool = (symbol.flags & public_flags) != 0;
        if (symbol_is_public && symbol.kind == context::SymbolKind.named_type) {
            let record: type_info::Record = context::type_record(context, symbol.type_id);
            let complete_alias: bool = record.kind == type_info::Kind.alias &&
                (record.flags & (type_info::Flag.complete as usize)) != 0;
            if (complete_alias && !public_type_is_valid(context, record.element_type)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.private_type_exposure, symbol.declaration_unit,
                    context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                    symbol.declaration_unit, context::empty_span(), record.element_type);
            }
            if (record.base_type != context::no_id() && !public_type_is_valid(context, record.base_type)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.private_type_exposure, symbol.declaration_unit,
                    context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                    symbol.declaration_unit, context::empty_span(), record.base_type);
            }
            for (var index: usize = 0; index < record.field_count; index += 1) {
                let field: type_info::Field = fields[record.first_field + index];
                if (types::field_is_anonymous(
                        context, field)) {
                    public_anonymous_fields_valid(context, field.type_id, symbol);
                } else if (!public_type_is_valid(
                        context, field.type_id)) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.private_type_exposure, field.declaration_unit,
                        context::node(context, field.declaration_unit, field.declaration_node).span,
                        symbol.declaration_unit,
                        context::node(context, symbol.declaration_unit, symbol.declaration_node).span, field.type_id);
                }
            }
        } else if (symbol_is_public && symbol.kind == context::SymbolKind.function) {
            let function: context::Function = functions[symbol.function_id];
            if (!public_type_is_valid(
                    context, function.return_type)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.private_type_exposure, symbol.declaration_unit,
                    context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                    context::no_id(), context::empty_span(), function.return_type);
            }
            for (var index: usize = 0; index < function.parameter_count; index += 1) {
                let parameter: context::Parameter = parameters[function.first_parameter + index];
                if (!public_type_is_valid(
                        context, parameter.type_id)) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.private_type_exposure, parameter.unit_index,
                        context::node(context, parameter.unit_index, parameter.declaration_node).span,
                        symbol.declaration_unit,
                        context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                        parameter.type_id);
                }
            }
        }
    }
    return context->error == runtime::Error.none;
}
