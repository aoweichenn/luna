module luna.bootstrap.middleend.semantic.types;

fn find_field(context: *context::Context, type_id: usize, unit_index: usize, name_token: usize) -> usize {
    let record: type_info::Record = context::type_record(context, type_id);
    if (record.field_count == 0) {
        return context::no_id();
    }
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    for (var index: usize = 0; index < record.field_count; index += 1) {
        let field_id: usize = record.first_field + index;
        if (context::tokens_equal(
                context, unit_index, name_token, fields[field_id].declaration_unit, fields[field_id].name_token)) {
            return field_id;
        }
    }
    return context::no_id();
}

fn lookup_promoted_field(
    context: *context::Context, type_id: usize, unit_index: usize, name_token: usize, base_offset: usize,
    result: *FieldLookup) -> void {
    let record: type_info::Record = context::type_record(context, type_id);
    let fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
    for (var index: usize = 0;
        index < record.field_count && result->status != FieldStatus.ambiguous; index += 1) {
        let field: type_info::Field = fields[record.first_field + index];
        if (field_is_anonymous(context, field)) {
            let direct: usize = find_field(context, field.type_id, unit_index, name_token);
            if (direct != context::no_id()) {
                if (result->status == FieldStatus.found) {
                    result->status = FieldStatus.ambiguous;
                } else {
                    result->status = FieldStatus.found;
                    result->field_id = direct;
                    result->offset_bytes = base_offset + field.offset_bytes + fields[direct].offset_bytes;
                }
            } else {
                lookup_promoted_field(
                    context, field.type_id, unit_index, name_token, base_offset + field.offset_bytes, result);
            }
        }
    }
}

fn lookup_field(context: *context::Context, type_id: usize, unit_index: usize, name_token: usize) -> FieldLookup {
    let none: usize = context::no_id();
    let direct: usize = find_field(context, type_id, unit_index, name_token);
    if (direct != none) {
        let fields: *const type_info::Field = context->types.field_data() as
                *const type_info::Field;
        return {
            status = FieldStatus.found, field_id = direct, offset_bytes = fields[direct].offset_bytes,
        };
    }
    var result: FieldLookup = {
        status = FieldStatus.missing, field_id = none, offset_bytes = 0,
    };
    lookup_promoted_field(context, type_id, unit_index, name_token, 0, &result);
    if (result.status != FieldStatus.missing) {
        return result;
    }
    var current: usize = context::type_record(context, type_id).base_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        if (current == none) {
            return result;
        }
        let inherited: usize = find_field(context, current, unit_index, name_token);
        if (inherited != none) {
            let fields: *const type_info::Field = context->types.field_data() as
                    *const type_info::Field;
            return {
                status = FieldStatus.found, field_id = inherited, offset_bytes = fields[inherited].offset_bytes,
            };
        }
        lookup_promoted_field(context, current, unit_index, name_token, 0, &result);
        if (result.status != FieldStatus.missing) {
            return result;
        }
        current = context::type_record(context, current).base_type;
    }
    return result;
}
