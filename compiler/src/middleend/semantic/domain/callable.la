module luna.compiler.sema.domain;

fn no_owner() -> usize {
    return type_info::no_id();
}

fn free_function() -> CallableIdentity {
    return {
        kind = CallableKind.free_function, owner_type = no_owner(), receiver = ReceiverKind.none,
    };
}

fn has_owner(identity: CallableIdentity) -> bool {
    return identity.owner_type != no_owner();
}

fn has_receiver(identity: CallableIdentity) -> bool {
    return identity.receiver != ReceiverKind.none;
}

fn receiver_is_valid(receiver: ReceiverKind) -> bool {
    switch (receiver) {
    case ReceiverKind.none, ReceiverKind.writable, ReceiverKind.read_only,
        ReceiverKind.writable_volatile, ReceiverKind.read_only_volatile {
        return true;
    }
    default {
        return false;
    }
    }
}

fn callable_shape_is_valid(identity: CallableIdentity) -> bool {
    let owner_exists: bool = has_owner(identity);
    let receiver_exists: bool = has_receiver(identity);
    switch (identity.kind) {
    case CallableKind.free_function {
        return !owner_exists && !receiver_exists;
    }
    case CallableKind.static_method {
        return owner_exists && !receiver_exists;
    }
    case CallableKind.instance_method, CallableKind.operator_method {
        return owner_exists && receiver_exists;
    }
    case CallableKind.constructor, CallableKind.destructor {
        return owner_exists && identity.receiver == ReceiverKind.writable;
    }
    default {
        return false;
    }
    }
}

fn callable_is_valid(identity: CallableIdentity, type_count: usize) -> bool {
    if (!receiver_is_valid(identity.receiver) || !callable_shape_is_valid(identity)) {
        return false;
    }
    return !has_owner(identity) || identity.owner_type < type_count;
}

fn same_owner(left: CallableIdentity, right: CallableIdentity) -> bool {
    return left.owner_type == right.owner_type;
}

fn same_identity(left: CallableIdentity, right: CallableIdentity) -> bool {
    let callable_shape_matches: bool = left.kind == right.kind && left.receiver == right.receiver;
    return callable_shape_matches && same_owner(left, right);
}
