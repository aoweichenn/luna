module luna.bootstrap.middleend.semantic.context;

fn invalid_diagnostic() -> Diagnostic {
    let none: usize = no_id();
    return {
        kind = DiagnosticKind.invalid_input, unit_index = none, span = empty_span(), related_unit = none,
        related_span = empty_span(), detail = 0,
    };
}

impl DiagnosticView {
    init(data: *const Diagnostic, count: usize) {
        this->data_pointer = data;
        this->element_count = count;
    }

    fn is_valid() const -> bool {
        let storage_exists: bool = this->data_pointer != null || this->element_count == 0;
        return storage_exists && this->element_count <= Limit.maximum_diagnostics as usize;
    }

    fn empty() const -> bool {
        return this->element_count == 0;
    }

    fn size() const -> usize {
        return this->element_count;
    }

    fn get(index: usize) const -> DiagnosticResult {
        if (!this->is_valid() || index >= this->element_count) {
            return {diagnostic = invalid_diagnostic(), error = runtime::Error.invalid_argument};
        }
        return {diagnostic = this->data_pointer[index], error = runtime::Error.none};
    }
}

impl DiagnosticBuffer {
    init(): values = vector::vector<Diagnostic>() {
    }

    init(other: DiagnosticBuffer&&): values = other.values as vector::vector<Diagnostic>&& {
    }

    fn is_valid() const -> bool {
        return this->values.is_valid() && this->values.size() <= Limit.maximum_diagnostics as usize;
    }

    fn empty() const -> bool {
        return this->values.empty();
    }

    fn size() const -> usize {
        return this->values.size();
    }

    fn add(diagnostic: Diagnostic) -> runtime::Error {
        if (!this->is_valid()) {
            return runtime::Error.invalid_argument;
        }
        if (this->values.size() >= Limit.maximum_diagnostics as usize) {
            return runtime::Error.out_of_memory;
        }
        return this->values.push_back(diagnostic);
    }

    fn view() const -> DiagnosticView {
        let data: *const Diagnostic = this->values.empty() ? null : &this->values.get(0);
        return DiagnosticView(data, this->values.size());
    }

    deinit() {
    }
}

fn result_is_success(result: SemanticResult const&) -> bool {
    let status_is_success: bool = result.error == runtime::Error.none && result.diagnostics.empty();
    let model_is_valid: bool = result.types.is_valid(true) && result.ir.is_valid(result.types);
    return status_is_success && model_is_valid;
}
