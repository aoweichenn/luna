module luna.bootstrap.middleend.semantic.context;

fn append_record(context: *Context, destination: *bytes::Buffer, data: *const u8, length: usize) -> bool {
    if (context == null || destination == null) {
        return false;
    }
    if (data == null || length == 0) {
        return false;
    }
    if (context->error != runtime::Error.none) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(*destination, data, length);
    *destination = appended.buffer;
    context->error = appended.error;
    return appended.error == runtime::Error.none;
}

fn program_module_node(context: *Context, unit_index: usize) -> usize {
    let unit: *const Unit = input_unit(context, unit_index);
    if (unit == null) {
        return no_id();
    }
    let root: syntax::SyntaxNode = node(context, unit_index, unit->tree.root());
    if (root.kind != syntax::SyntaxKind.program || root.child_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }
    let declaration: syntax::SyntaxNode = node(context, unit_index, root.first_child);
    if (declaration.kind != syntax::SyntaxKind.module_declaration) {
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }
    return root.first_child;
}

fn first_declaration(context: *Context, unit_index: usize) -> usize {
    let none: usize = no_id();
    if (unit_index == none) {
        return none;
    }
    let unit: *const Unit = input_unit(context, unit_index);
    if (unit == null) {
        return none;
    }
    let root: syntax::SyntaxNode = node(context, unit_index, unit->tree.root());
    var child: usize = root.first_child;
    while (child != none) {
        let declaration: syntax::SyntaxNode = node(context, unit_index, child);
        let is_preamble: bool = declaration.kind == syntax::SyntaxKind.module_declaration ||
            declaration.kind == syntax::SyntaxKind.import_declaration;
        if (!is_preamble) {
            return child;
        }
        child = declaration.next_sibling;
    }
    return none;
}

fn lookup_result(value: usize, status: LookupStatus) -> LookupResult {
    return {value = value, status = status};
}

impl SymbolTable {
    priv fn lookup_is_ready(context: *Context) const -> bool {
        if (context == null) {
            return false;
        }
        if (this->ready()) {
            return true;
        }
        context->error = this->error_code == runtime::Error.none ? runtime::Error.invalid_argument : this->error_code;
        return false;
    }

    fn find_module_by_name(context: *Context, unit_index: usize, name_node: usize) const -> usize {
        if (!this->lookup_is_ready(context)) {
            return no_id();
        }
        for (var index: usize = 0; index < this->modules.size(); index += 1) {
            let candidate: Module = this->modules.get(index);
            if (module_names_equal(
                    context, unit_index, name_node, candidate.name_unit, candidate.name_node)) {
                return index;
            }
        }
        return no_id();
    }

    priv fn find_local_symbol(
        context: *Context, module_id: usize, unit_index: usize, name_token: usize,
        kind: SymbolKind, interface_scope: bool) const -> usize {
        if (!this->lookup_is_ready(context)) {
            return no_id();
        }
        for (var index: usize = 0; index < this->symbols.size(); index += 1) {
            let symbol: Symbol = this->symbols.get(index);
            if (symbol.module_id != module_id || symbol.kind != kind) {
                continue;
            }
            let interface_declaration: bool = (symbol.flags & (SymbolFlag.interface_declaration as usize)) != 0;
            if (interface_scope && !interface_declaration) {
                continue;
            }
            if (tokens_equal(
                    context, unit_index, name_token, symbol.declaration_unit, symbol.name_token)) {
                return index;
            }
        }
        return no_id();
    }

    fn find_any_local_symbol(context: *Context, module_id: usize, unit_index: usize, name_token: usize) const -> usize {
        if (!this->lookup_is_ready(context)) {
            return no_id();
        }
        for (var index: usize = 0; index < this->symbols.size(); index += 1) {
            let symbol: Symbol = this->symbols.get(index);
            if (symbol.module_id != module_id || symbol.kind == SymbolKind.enum_member) {
                continue;
            }
            if (tokens_equal(
                    context, unit_index, name_token, symbol.declaration_unit, symbol.name_token)) {
                return index;
            }
        }
        return no_id();
    }

    fn unit_module(context: *Context, unit_index: usize) const -> usize {
        if (!this->lookup_is_ready(context) || unit_index >= this->units.size()) {
            if (context != null) {
                context->error = runtime::Error.invalid_argument;
            }
            return no_id();
        }
        return this->units.get(unit_index).module_id;
    }

    fn unit_is_interface(context: *Context, unit_index: usize) const -> bool {
        if (!this->lookup_is_ready(context) || unit_index >= this->units.size()) {
            if (context != null) {
                context->error = runtime::Error.invalid_argument;
            }
            return false;
        }
        return this->units.get(unit_index).interface_unit != 0;
    }

    fn module_implementation_unit(context: *Context, module_id: usize, implementation_index: usize) const -> usize {
        if (!this->lookup_is_ready(context) || module_id >= this->modules.size()) {
            if (context != null) {
                context->error = runtime::Error.invalid_argument;
            }
            return no_id();
        }
        let module_record: Module = this->modules.get(module_id);
        if (implementation_index >= module_record.implementation_count) {
            context->error = runtime::Error.invalid_argument;
            return no_id();
        }
        var found: usize = 0;
        for (var unit_index: usize = 0; unit_index < this->units.size(); unit_index += 1) {
            let unit: UnitInfo = this->units.get(unit_index);
            if (unit.module_id != module_id || unit.interface_unit != 0) {
                continue;
            }
            if (found == implementation_index) {
                return unit_index;
            }
            found += 1;
        }
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }

    fn import_binds_name(context: *Context, import_record: Import, unit_index: usize, name_token: usize) const -> bool {
        if (!this->lookup_is_ready(context)) {
            return false;
        }
        if (import_record.alias_token != no_id() || import_record.selective_node == no_id()) {
            return false;
        }
        var child: usize = node(context, import_record.source_unit, import_record.selective_node).first_child;
        while (child != no_id()) {
            let name_node: syntax::SyntaxNode = node(context, import_record.source_unit, child);
            if (tokens_equal(
                    context, unit_index, name_token, import_record.source_unit, name_node.token_index)) {
                return true;
            }
            child = name_node.next_sibling;
        }
        return false;
    }

    fn import_binds_symbol(context: *Context, import_record: Import, symbol: Symbol) const -> bool {
        return this->import_binds_name(context, import_record, symbol.declaration_unit, symbol.name_token);
    }

    priv fn find_imported_symbol(
        context: *Context, unit_index: usize, name_token: usize, kind: SymbolKind) const -> LookupResult {
        let none: usize = no_id();
        let module_id: usize = this->unit_module(context, unit_index);
        if (module_id == none || module_id >= this->modules.size()) {
            return lookup_result(none, LookupStatus.invalid);
        }
        let interface_scope: bool = this->unit_is_interface(context, unit_index);
        let module_record: Module = this->modules.get(module_id);
        var found: usize = none;
        for (var import_index: usize = 0; import_index < module_record.import_count; import_index += 1) {
            let import_record: Import = this->imports.get(module_record.first_import + import_index);
            if (interface_scope && !import_record.interface_import) {
                continue;
            }
            if (!this->import_binds_name(context, import_record, unit_index, name_token)) {
                continue;
            }
            for (var symbol_index: usize = 0; symbol_index < this->symbols.size(); symbol_index += 1) {
                let symbol: Symbol = this->symbols.get(symbol_index);
                let exported: bool = (symbol.flags & (SymbolFlag.exported as usize)) != 0;
                if (symbol.module_id != import_record.target_module || symbol.kind != kind) {
                    continue;
                }
                if (!exported || !tokens_equal(
                        context, unit_index, name_token, symbol.declaration_unit, symbol.name_token)) {
                    continue;
                }
                if (found != none && found != symbol_index) {
                    let previous: Symbol = this->symbols.get(found);
                    add_diagnostic(
                        context, DiagnosticKind.ambiguous_import, unit_index,
                        token(context, unit_index, name_token).span, previous.declaration_unit,
                        token(context, previous.declaration_unit, previous.name_token).span, symbol_index);
                    return lookup_result(none, LookupStatus.ambiguous);
                }
                found = symbol_index;
            }
        }
        return found == none ? lookup_result(none, LookupStatus.not_found) : lookup_result(found, LookupStatus.found);
    }

    fn lookup_symbol(context: *Context, unit_index: usize, name_token: usize, kind: SymbolKind) const -> LookupResult {
        let module_id: usize = this->unit_module(context, unit_index);
        if (module_id == no_id()) {
            return lookup_result(no_id(), LookupStatus.invalid);
        }
        let local: usize = this->find_local_symbol(
            context, module_id, unit_index, name_token, kind, this->unit_is_interface(context, unit_index));
        if (local != no_id()) {
            return lookup_result(local, LookupStatus.found);
        }
        return this->find_imported_symbol(context, unit_index, name_token, kind);
    }

    priv fn import_matches_qualifier(
        context: *Context, import_record: Import, unit_index: usize, qualifier_token: usize) const -> bool {
        if (import_record.alias_token != no_id()) {
            return tokens_equal(
                context, unit_index, qualifier_token, import_record.source_unit, import_record.alias_token);
        }
        let target: Module = this->modules.get(import_record.target_module);
        let name_node: syntax::SyntaxNode = node(context, target.name_unit, target.name_node);
        if (name_node.child_count == 0) {
            return false;
        }
        let last_segment: syntax::SyntaxNode = node(context, target.name_unit, name_node.last_child);
        return tokens_equal(context, unit_index, qualifier_token, target.name_unit, last_segment.token_index);
    }

    fn find_qualifier_target(context: *Context, unit_index: usize, qualifier_token: usize) const -> LookupResult {
        let none: usize = no_id();
        let module_id: usize = this->unit_module(context, unit_index);
        if (module_id == none || module_id >= this->modules.size()) {
            return lookup_result(none, LookupStatus.invalid);
        }
        let interface_scope: bool = this->unit_is_interface(context, unit_index);
        let module_record: Module = this->modules.get(module_id);
        var found: usize = none;
        for (var import_index: usize = 0; import_index < module_record.import_count; import_index += 1) {
            let import_record: Import = this->imports.get(module_record.first_import + import_index);
            if (interface_scope && !import_record.interface_import) {
                continue;
            }
            if (!this->import_matches_qualifier(context, import_record, unit_index, qualifier_token)) {
                continue;
            }
            if (found != none && found != import_record.target_module) {
                return lookup_result(none, LookupStatus.ambiguous);
            }
            found = import_record.target_module;
        }
        return found == none ? lookup_result(none, LookupStatus.not_found) : lookup_result(found, LookupStatus.found);
    }

    fn resolve_module_qualifier(
        context: *Context, unit_index: usize, qualifier_token: usize,
        qualifier_span: lexer::SourceSpan) const -> LookupResult {
        let result: LookupResult = this->find_qualifier_target(context, unit_index, qualifier_token);
        if (result.status == LookupStatus.not_found || result.status == LookupStatus.ambiguous) {
            let kind: DiagnosticKind = result.status == LookupStatus.ambiguous ?
                DiagnosticKind.ambiguous_module_qualifier : DiagnosticKind.unknown_module_qualifier;
            add_diagnostic(context, kind, unit_index, qualifier_span, no_id(), empty_span(), qualifier_token);
        }
        return result;
    }

    priv fn find_module_symbol(
        context: *Context, unit_index: usize, module_id: usize, name_token: usize, kind: SymbolKind) const -> usize {
        if (!this->lookup_is_ready(context) || module_id >= this->modules.size()) {
            return no_id();
        }
        for (var index: usize = 0; index < this->symbols.size(); index += 1) {
            let symbol: Symbol = this->symbols.get(index);
            let exported: bool = (symbol.flags & (SymbolFlag.exported as usize)) != 0;
            if (symbol.module_id != module_id || symbol.kind != kind) {
                continue;
            }
            if (exported && tokens_equal(
                    context, unit_index, name_token, symbol.declaration_unit, symbol.name_token)) {
                return index;
            }
        }
        return no_id();
    }

    fn lookup_qualified_symbol(
        context: *Context, unit_index: usize, path: syntax::SyntaxNode, kind: SymbolKind,
        diagnose: bool) const -> LookupResult {
        let none: usize = no_id();
        if (path.child_count == 0) {
            return this->lookup_symbol(context, unit_index, path.token_index, kind);
        }
        if (path.child_count > 1) {
            if (diagnose) {
                add_diagnostic(
                    context, DiagnosticKind.invalid_qualified_path, unit_index, path.span, none,
                    empty_span(), path.token_index);
            }
            return lookup_result(none, LookupStatus.invalid);
        }
        let qualifier: syntax::SyntaxNode = node(context, unit_index, path.first_child);
        let target: LookupResult = this->find_qualifier_target(context, unit_index, qualifier.token_index);
        if (target.status == LookupStatus.invalid) {
            return target;
        }
        if (target.status != LookupStatus.found) {
            if (diagnose) {
                let diagnostic: DiagnosticKind = target.status == LookupStatus.ambiguous ?
                    DiagnosticKind.ambiguous_module_qualifier : DiagnosticKind.unknown_module_qualifier;
                add_diagnostic(
                    context, diagnostic, unit_index, qualifier.span, none, empty_span(), qualifier.token_index);
            }
            return target;
        }
        let symbol_id: usize = this->find_module_symbol(context, unit_index, target.value, path.token_index, kind);
        if (symbol_id != none) {
            return lookup_result(symbol_id, LookupStatus.found);
        }
        if (diagnose) {
            let module_record: Module = this->modules.get(target.value);
            add_diagnostic(
                context, DiagnosticKind.unknown_qualified_name, unit_index, path.span, module_record.name_unit,
                node(context, module_record.name_unit, module_record.name_node).span, path.token_index);
        }
        return lookup_result(none, LookupStatus.not_found);
    }
}
