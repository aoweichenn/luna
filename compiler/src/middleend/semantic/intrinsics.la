module luna.bootstrap.middleend.semantic.intrinsics;

import luna.bootstrap.middleend.semantic.context.builder as builder;

import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.classes as classes;
import luna.bootstrap.middleend.semantic.types as types;
import luna.bootstrap.middleend.semantic.value as category;
import luna.compiler.lexer as lexer;
import luna.compiler.types as type_info;
import luna.runtime as runtime;
import luna.std.bytes as bytes;
import luna.std.string_view as string_views;

struct IntrinsicIntegerInfo {
    kind: type_info::Kind;
    unsigned_type: usize;
    width: usize;
}

struct IntrinsicFloatInfo {
    kind: type_info::Kind;
    // Values with |x| >= limit are already integral (or NaN/inf); below it the guarded expansions apply.
    limit: f64;
    // 1.5 * limit: adding then subtracting it forces a round-to-nearest-even at the unit bit.
    magic: f64;
}

fn intrinsic_invalid_expression() -> context::Expression {
    let none: usize = context::no_id();
    return {
        type_id = none, value_id = none, address_id = none, constant_value = 0, has_constant = false,
        category = category::Category.rvalue, valid = false, bitfield_segment = context::no_id(),
    };
}

fn intrinsic_entry(index: usize) -> IntrinsicEntry {
    var table: [IntrinsicLimit.entries]IntrinsicEntry = {};
    table[0] = {
        name = "file", name_length = 4, arity = 0, operand_class = IntrinsicOperandClass.none,
        lowering = IntrinsicLowering.source_file,
    };
    table[1] = {
        name = "line", name_length = 4, arity = 0, operand_class = IntrinsicOperandClass.none,
        lowering = IntrinsicLowering.source_line,
    };
    table[2] = {
        name = "clz", name_length = 3, arity = 1, operand_class = IntrinsicOperandClass.integer_scalar,
        lowering = IntrinsicLowering.count_leading_zeros,
    };
    table[3] = {
        name = "ctz", name_length = 3, arity = 1, operand_class = IntrinsicOperandClass.integer_scalar,
        lowering = IntrinsicLowering.count_trailing_zeros,
    };
    table[4] = {
        name = "popcount", name_length = 8, arity = 1, operand_class = IntrinsicOperandClass.integer_scalar,
        lowering = IntrinsicLowering.population_count,
    };
    table[5] = {
        name = "rotate_left", name_length = 11, arity = 2, operand_class = IntrinsicOperandClass.integer_scalar_rotated,
        lowering = IntrinsicLowering.rotate_left,
    };
    table[6] = {
        name = "rotate_right", name_length = 12, arity = 2,
        operand_class = IntrinsicOperandClass.integer_scalar_rotated, lowering = IntrinsicLowering.rotate_right,
    };
    table[7] = {
        name = "byte_swap", name_length = 9, arity = 1, operand_class = IntrinsicOperandClass.integer_scalar_wide,
        lowering = IntrinsicLowering.byte_swap,
    };
    table[8] = {
        name = "sqrt", name_length = 4, arity = 1, operand_class = IntrinsicOperandClass.float_scalar,
        lowering = IntrinsicLowering.float_square_root,
    };
    table[9] = {
        name = "floor", name_length = 5, arity = 1, operand_class = IntrinsicOperandClass.float_scalar,
        lowering = IntrinsicLowering.float_floor,
    };
    table[10] = {
        name = "ceil", name_length = 4, arity = 1, operand_class = IntrinsicOperandClass.float_scalar,
        lowering = IntrinsicLowering.float_ceiling,
    };
    table[11] = {
        name = "trunc", name_length = 5, arity = 1, operand_class = IntrinsicOperandClass.float_scalar,
        lowering = IntrinsicLowering.float_truncate,
    };
    table[12] = {
        name = "round", name_length = 5, arity = 1, operand_class = IntrinsicOperandClass.float_scalar,
        lowering = IntrinsicLowering.float_round,
    };
    table[13] = {
        name = "min", name_length = 3, arity = 2, operand_class = IntrinsicOperandClass.float_scalar_binary,
        lowering = IntrinsicLowering.float_minimum,
    };
    table[14] = {
        name = "max", name_length = 3, arity = 2, operand_class = IntrinsicOperandClass.float_scalar_binary,
        lowering = IntrinsicLowering.float_maximum,
    };
    table[15] = {
        name = "abs", name_length = 3, arity = 1, operand_class = IntrinsicOperandClass.float_scalar,
        lowering = IntrinsicLowering.float_absolute,
    };
    table[16] = {
        name = "add_overflow", name_length = 12, arity = 3, operand_class = IntrinsicOperandClass.integer_overflow,
        lowering = IntrinsicLowering.overflow_add,
    };
    table[17] = {
        name = "sub_overflow", name_length = 12, arity = 3, operand_class = IntrinsicOperandClass.integer_overflow,
        lowering = IntrinsicLowering.overflow_subtract,
    };
    table[18] = {
        name = "mul_overflow", name_length = 12, arity = 3, operand_class = IntrinsicOperandClass.integer_overflow,
        lowering = IntrinsicLowering.overflow_multiply,
    };
    table[19] = {
        name = "embed", name_length = 5, arity = 1, operand_class = IntrinsicOperandClass.embedded_file,
        lowering = IntrinsicLowering.embed,
    };
    table[20] = {
        name = "type_is", name_length = 7, arity = 2, operand_class = IntrinsicOperandClass.rtti,
        lowering = IntrinsicLowering.type_is,
    };
    table[21] = {
        name = "type_cast", name_length = 9, arity = 2, operand_class = IntrinsicOperandClass.rtti,
        lowering = IntrinsicLowering.type_cast,
    };
    table[22] = {
        name = "is_trivially_relocatable", name_length = 24, arity = 1,
        operand_class = IntrinsicOperandClass.type_property, lowering = IntrinsicLowering.trivially_relocatable,
    };
    return table[index];
}

fn intrinsic_integer_info(index: usize) -> IntrinsicIntegerInfo {
    var table: [10]IntrinsicIntegerInfo = {};
    table[0] = {
        kind = type_info::Kind.signed_8, unsigned_type = type_info::BuiltinType.unsigned_8 as usize, width = 8,
    };
    table[1] = {
        kind = type_info::Kind.signed_16, unsigned_type = type_info::BuiltinType.unsigned_16 as usize, width = 16,
    };
    table[2] = {
        kind = type_info::Kind.signed_32, unsigned_type = type_info::BuiltinType.unsigned_32 as usize, width = 32,
    };
    table[3] = {
        kind = type_info::Kind.signed_64, unsigned_type = type_info::BuiltinType.unsigned_64 as usize, width = 64,
    };
    table[4] = {
        kind = type_info::Kind.signed_size, unsigned_type = type_info::BuiltinType.unsigned_size as usize, width = 64,
    };
    table[5] = {
        kind = type_info::Kind.unsigned_8, unsigned_type = type_info::BuiltinType.unsigned_8 as usize, width = 8,
    };
    table[6] = {
        kind = type_info::Kind.unsigned_16, unsigned_type = type_info::BuiltinType.unsigned_16 as usize, width = 16,
    };
    table[7] = {
        kind = type_info::Kind.unsigned_32, unsigned_type = type_info::BuiltinType.unsigned_32 as usize, width = 32,
    };
    table[8] = {
        kind = type_info::Kind.unsigned_64, unsigned_type = type_info::BuiltinType.unsigned_64 as usize, width = 64,
    };
    table[9] = {
        kind = type_info::Kind.unsigned_size, unsigned_type = type_info::BuiltinType.unsigned_size as usize, width = 64,
    };
    return table[index];
}

fn intrinsic_float_info(index: usize) -> IntrinsicFloatInfo {
    var table: [2]IntrinsicFloatInfo = {};
    table[0] = { kind = type_info::Kind.float_32, limit = 8388608.0, magic = 12582912.0 };
    table[1] = { kind = type_info::Kind.float_64, limit = 4503599627370496.0, magic = 6755399441055744.0 };
    return table[index];
}

fn intrinsic_constant(context: *context::Context, node: syntax::SyntaxNode, type_id: usize, value: u64) -> usize {
    let constant: context::Expression = builder::emit_integer_constant(context, node, type_id, value);
    return constant.value_id;
}

fn intrinsic_binary(
    context: *context::Context, node: syntax::SyntaxNode, operation: lexer::TokenKind, type_id: usize,
    left: usize, right: usize) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.binary_integer, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return builder::emit_value(context, instruction, type_id);
}

fn intrinsic_shift(
    context: *context::Context, node: syntax::SyntaxNode, operation: lexer::TokenKind, type_id: usize,
    value: usize, amount: usize) -> usize {
    let count: usize = intrinsic_constant(context, node, type_id, amount as u64);
    return intrinsic_binary(context, node, operation, type_id, value, count);
}

fn intrinsic_convert(
    context: *context::Context, node: syntax::SyntaxNode, value: usize, source_type: usize, target_type: usize
) -> usize {
    if (source_type == target_type) {
        return value;
    }
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.convert, node);
    instruction.left = value;
    instruction.auxiliary = source_type;
    return builder::emit_value(context, instruction, target_type);
}

// Sets every bit below the most significant set bit: x |= x >> 1; x |= x >> 2; ... x |= x >> (width / 2).
fn intrinsic_smear(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, width: usize, value: usize) -> usize {
    var result: usize = value;
    var shift: usize = 1;
    while (shift < width) {
        let shifted: usize = intrinsic_shift(context, node, lexer::TokenKind.shift_right, type_id, result, shift);
        result = intrinsic_binary(context, node, lexer::TokenKind.pipe, type_id, result, shifted);
        shift *= 2;
    }
    return result;
}

fn intrinsic_popcount(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, width: usize, value: usize) -> usize {
    let even_bits: usize = intrinsic_constant(context, node, type_id, builder::mask_integer(0x5555555555555555, width));
    let pair_bits: usize = intrinsic_constant(context, node, type_id, builder::mask_integer(0x3333333333333333, width));
    let nibble_bits: usize = intrinsic_constant(
        context, node, type_id, builder::mask_integer(0x0F0F0F0F0F0F0F0F, width));
    let lane_bits: usize = intrinsic_constant(context, node, type_id, builder::mask_integer(0x0101010101010101, width));
    var x: usize = intrinsic_binary(
        context, node, lexer::TokenKind.minus, type_id, value,
        intrinsic_binary(
            context, node, lexer::TokenKind.ampersand, type_id,
            intrinsic_shift(context, node, lexer::TokenKind.shift_right, type_id, value, 1), even_bits));
    x = intrinsic_binary(
        context, node, lexer::TokenKind.plus, type_id,
        intrinsic_binary(context, node, lexer::TokenKind.ampersand, type_id, x, pair_bits),
        intrinsic_binary(
            context, node, lexer::TokenKind.ampersand, type_id,
            intrinsic_shift(context, node, lexer::TokenKind.shift_right, type_id, x, 2), pair_bits));
    x = intrinsic_binary(
        context, node, lexer::TokenKind.ampersand, type_id,
        intrinsic_binary(
            context, node, lexer::TokenKind.plus, type_id, x,
            intrinsic_shift(context, node, lexer::TokenKind.shift_right, type_id, x, 4)), nibble_bits);
    return intrinsic_shift(
        context, node, lexer::TokenKind.shift_right, type_id,
        intrinsic_binary(context, node, lexer::TokenKind.star, type_id, x, lane_bits), width - 8);
}

// s = n & (width - 1); rotated = (x << s) | (x >> ((width - s) & (width - 1))); every shift count stays in
// [0, width - 1]. rotate_right mirrors the two shift directions.
fn intrinsic_rotate(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, width: usize, value: usize,
    count: usize, count_type: usize, left: bool) -> usize {
    let mask: usize = intrinsic_constant(context, node, type_id, (width - 1) as u64);
    let n: usize = intrinsic_convert(context, node, count, count_type, type_id);
    let amount: usize = intrinsic_binary(context, node, lexer::TokenKind.ampersand, type_id, n, mask);
    let complement: usize = intrinsic_binary(
        context, node, lexer::TokenKind.ampersand, type_id,
        intrinsic_binary(
            context, node, lexer::TokenKind.minus, type_id,
            intrinsic_constant(context, node, type_id, width as u64), amount), mask);
    let forward: usize = intrinsic_binary(
        context, node, left ? lexer::TokenKind.shift_left : lexer::TokenKind.shift_right, type_id, value, amount);
    let backward: usize = intrinsic_binary(
        context, node, left ? lexer::TokenKind.shift_right : lexer::TokenKind.shift_left, type_id, value, complement);
    return intrinsic_binary(context, node, lexer::TokenKind.pipe, type_id, forward, backward);
}

// Isolates each byte and shifts it to the mirrored byte lane; shift amounts stay within [0, width - 8].
fn intrinsic_byte_swap(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, width: usize, value: usize) -> usize {
    let none: usize = context::no_id();
    let byte_mask: usize = intrinsic_constant(context, node, type_id, 0xFF);
    let bytes: usize = width / 8;
    var result: usize = none;
    var index: usize = 0;
    while (index < bytes) {
        var term: usize = value;
        if (index != 0) {
            term = intrinsic_shift(context, node, lexer::TokenKind.shift_right, type_id, term, index * 8);
        }
        term = intrinsic_binary(context, node, lexer::TokenKind.ampersand, type_id, term, byte_mask);
        let target: usize = (bytes - 1 - index) * 8;
        if (target != 0) {
            term = intrinsic_shift(context, node, lexer::TokenKind.shift_left, type_id, term, target);
        }
        if (result == none) {
            result = term;
        } else {
            result = intrinsic_binary(context, node, lexer::TokenKind.pipe, type_id, result, term);
        }
        index += 1;
    }
    return result;
}

fn intrinsic_float_constant(context: *context::Context, node: syntax::SyntaxNode, type_id: usize, value: f64) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.constant_float, node);
    instruction.floating = value;
    return builder::emit_value(context, instruction, type_id);
}

fn intrinsic_float_negate(context: *context::Context, node: syntax::SyntaxNode, type_id: usize, value: usize) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.unary_float, node);
    instruction.operation = lexer::TokenKind.minus;
    instruction.left = value;
    return builder::emit_value(context, instruction, type_id);
}

fn intrinsic_float_binary(
    context: *context::Context, node: syntax::SyntaxNode, opcode: ir::Opcode,
    operation: lexer::TokenKind, type_id: usize, left: usize, right: usize) -> usize {
    var instruction: ir::Instruction = builder::instruction(opcode, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return builder::emit_value(context, instruction, type_id);
}

fn intrinsic_float_compare(
    context: *context::Context, node: syntax::SyntaxNode, operation: lexer::TokenKind, left: usize, right: usize
) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.compare, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return builder::emit_value(context, instruction, type_info::BuiltinType.boolean as usize);
}

fn intrinsic_float_rvalue(type_id: usize, value_id: usize) -> context::Expression {
    return {
        type_id = type_id, value_id = value_id, address_id = context::no_id(), constant_value = 0, has_constant = false,
        category = category::Category.rvalue, valid = value_id != context::no_id(), bitfield_segment = context::no_id(),
    };
}

// Emits `|x| < limit ? expansion(x) : x` through a temporary slot, mirroring the conditional-expression
// lowering. The ordered-less guard is false for NaN and for already-integral magnitudes, so the expansion
// path's trapping float->integer conversion only ever runs on finite values below 2^(precision - 1).
fn intrinsic_float_guarded(
    context: *context::Context, node: syntax::SyntaxNode, lowering: IntrinsicLowering,
    type_id: usize, info: IntrinsicFloatInfo, x: usize) -> usize {
    let none: usize = context::no_id();
    let magnitude: usize = intrinsic_float_binary(
        context, node, ir::Opcode.float_max, lexer::TokenKind.invalid, type_id, x,
        intrinsic_float_negate(context, node, type_id, x));
    let in_range: usize = intrinsic_float_compare(
        context, node, lexer::TokenKind.less, magnitude, intrinsic_float_constant(context, node, type_id, info.limit));
    let result_slot: usize = ir::add_slot(&context->ir, builder::current_ir_function(context), type_id, true, false, 0);
    let compute_block: usize = builder::add_current_block(context);
    let merge_block: usize = builder::add_current_block(context);
    builder::store_to_address(
        context, node, builder::address_of_slot(context, node, result_slot, type_id, false, false),
        type_id, intrinsic_float_rvalue(type_id, x));
    builder::emit_branch(context, node, in_range, compute_block, merge_block);
    context->current_block = compute_block;
    var result: usize = none;
    if (lowering == IntrinsicLowering.float_round) {
        let magic: usize = intrinsic_float_constant(context, node, type_id, info.magic);
        result = intrinsic_float_binary(
            context, node, ir::Opcode.binary_float, lexer::TokenKind.minus, type_id,
            intrinsic_float_binary(context, node, ir::Opcode.binary_float, lexer::TokenKind.plus, type_id, x, magic),
            magic);
    } else {
        let integer_type: usize = type_info::BuiltinType.signed_64 as usize;
        let truncated: usize = intrinsic_convert(context, node, x, type_id, integer_type);
        let integral: usize = intrinsic_convert(context, node, truncated, integer_type, type_id);
        if (lowering == IntrinsicLowering.float_truncate) {
            result = integral;
        } else {
            let downward: bool = lowering == IntrinsicLowering.float_floor;
            let adjust: usize = intrinsic_float_compare(
                context, node, downward ? lexer::TokenKind.greater : lexer::TokenKind.less, integral, x);
            let adjustment: usize = intrinsic_convert(
                context, node, adjust, type_info::BuiltinType.boolean as usize, type_id);
            result = intrinsic_float_binary(
                context, node, ir::Opcode.binary_float,
                downward ? lexer::TokenKind.minus : lexer::TokenKind.plus, type_id, integral, adjustment);
        }
    }
    builder::store_to_address(
        context, node, builder::address_of_slot(context, node, result_slot, type_id, false, false),
        type_id, intrinsic_float_rvalue(type_id, result));
    builder::emit_jump(context, node, merge_block);
    context->current_block = merge_block;
    let source: context::Expression = {
        type_id = type_id, value_id = none,
        address_id = builder::address_of_slot(context, node, result_slot, type_id, false, false), constant_value = 0,
        has_constant = false, category = category::lvalue(false, false), valid = true,
        bitfield_segment = context::no_id(),
    };
    return builder::load_lvalue(context, node, source).value_id;
}

fn lower_float_intrinsic(
    context: *context::Context, node: syntax::SyntaxNode, entry: IntrinsicEntry,
    operand: context::Expression, second: context::Expression) -> context::Expression {
    let none: usize = context::no_id();
    let record: type_info::Record = context::type_record(context, operand.type_id);
    var info: IntrinsicFloatInfo = intrinsic_float_info(0);
    var float_operand: bool = false;
    var info_index: usize = 0;
    while (info_index < 2) {
        info = intrinsic_float_info(info_index);
        if (info.kind == record.kind) {
            float_operand = true;
            break;
        }
        info_index += 1;
    }
    if (!float_operand || (entry.operand_class == IntrinsicOperandClass.float_scalar_binary &&
            second.type_id != operand.type_id)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            context::empty_span(), operand.type_id);
        return intrinsic_invalid_expression();
    }
    let type_id: usize = operand.type_id;
    var result: usize = none;
    switch (entry.lowering) {
    case IntrinsicLowering.float_square_root {
        var instruction: ir::Instruction = builder::instruction(ir::Opcode.float_sqrt, node);
        instruction.left = operand.value_id;
        result = builder::emit_value(context, instruction, type_id);
    }
    case IntrinsicLowering.float_minimum {
        result = intrinsic_float_binary(
            context, node, ir::Opcode.float_min, lexer::TokenKind.invalid, type_id, operand.value_id, second.value_id);
    }
    case IntrinsicLowering.float_maximum {
        result = intrinsic_float_binary(
            context, node, ir::Opcode.float_max, lexer::TokenKind.invalid, type_id, operand.value_id, second.value_id);
    }
    case IntrinsicLowering.float_absolute {
        // maxsd(x, -x) clears the sign bit except that +0.0 compares equal to -0.0 and the second operand
        // (-0.0) wins; the final add of +0.0 maps -0.0 back to +0.0 and is otherwise exact. NaN stays NaN.
        let magnitude: usize = intrinsic_float_binary(
            context, node, ir::Opcode.float_max, lexer::TokenKind.invalid, type_id, operand.value_id,
            intrinsic_float_negate(context, node, type_id, operand.value_id));
        result = intrinsic_float_binary(
            context, node, ir::Opcode.binary_float, lexer::TokenKind.plus, type_id, magnitude,
            intrinsic_float_constant(context, node, type_id, 0.0));
    }
    case IntrinsicLowering.float_floor {
        result = intrinsic_float_guarded(context, node, entry.lowering, type_id, info, operand.value_id);
    }
    case IntrinsicLowering.float_ceiling {
        result = intrinsic_float_guarded(context, node, entry.lowering, type_id, info, operand.value_id);
    }
    case IntrinsicLowering.float_truncate {
        result = intrinsic_float_guarded(context, node, entry.lowering, type_id, info, operand.value_id);
    }
    case IntrinsicLowering.float_round {
        result = intrinsic_float_guarded(context, node, entry.lowering, type_id, info, operand.value_id);
    }
    }
    return {
        type_id = type_id, value_id = result, address_id = none, constant_value = 0, has_constant = false,
        category = category::Category.rvalue, valid = result != none, bitfield_segment = context::no_id(),
    };
}

// @add_overflow/@sub_overflow/@mul_overflow: both operands share an integer scalar type T and the third
// argument is a mutable *T. The wrapped result is always stored through the pointer; the intrinsic returns
// whether the operation overflowed T.
fn lower_overflow_intrinsic(
    context: *context::Context, node: syntax::SyntaxNode, entry: IntrinsicEntry,
    operand: context::Expression, count: context::Expression, destination: context::Expression) -> context::Expression {
    let none: usize = context::no_id();
    let record: type_info::Record = context::type_record(context, operand.type_id);
    var width: usize = 0;
    var info_index: usize = 0;
    while (info_index < 10) {
        let info: IntrinsicIntegerInfo = intrinsic_integer_info(info_index);
        if (info.kind == record.kind) {
            width = info.width;
            break;
        }
        info_index += 1;
    }
    let destination_record: type_info::Record = context::type_record(context, destination.type_id);
    if (width == 0 || count.type_id != operand.type_id || destination_record.kind != type_info::Kind.pointer ||
        destination_record.element_type != operand.type_id ||
        (destination_record.flags & (type_info::Flag.read_only as usize)) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            context::empty_span(), operand.type_id);
        return intrinsic_invalid_expression();
    }
    let operation: lexer::TokenKind = entry.lowering == IntrinsicLowering.overflow_add ?
        lexer::TokenKind.plus : entry.lowering == IntrinsicLowering.overflow_subtract ?
        lexer::TokenKind.minus : lexer::TokenKind.star;
    let type_id: usize = operand.type_id;
    let boolean_type: usize = type_info::BuiltinType.boolean as usize;
    // The narrow result wraps at width T in a plain binary_integer, so the wrapped value is available
    // whether or not the operation overflowed.
    let wrapped: usize = intrinsic_binary(context, node, operation, type_id, operand.value_id, count.value_id);
    var overflow: usize = none;
    if (width < 64) {
        // Redo the operation in the i64 domain (sign- or zero-extended per T), where it is exact, and
        // compare against the re-widened wrapped value; every conversion here widens and never traps.
        let wide_type: usize = type_info::BuiltinType.signed_64 as usize;
        let wide: usize = intrinsic_binary(
            context, node, operation, wide_type, intrinsic_convert(context, node, operand.value_id, type_id, wide_type),
            intrinsic_convert(context, node, count.value_id, type_id, wide_type));
        overflow = intrinsic_float_compare(
            context, node, lexer::TokenKind.bang_equal, wide,
            intrinsic_convert(context, node, wrapped, type_id, wide_type));
    } else if (entry.lowering == IntrinsicLowering.overflow_multiply && !type_info::is_signed_integer(record.kind)) {
        // Two-operand imul sets OF on signed significance only, so it misses unsigned 64-bit overflows
        // (0xFFFFFFFFFFFFFFFF * 2 reads as -1 * 2 = -2, which "fits"). Expand instead: overflow iff
        // a != 0 && wrapped / a != b. The divisor is forced to 1 when a == 0 (a | (a == 0)), so the
        // division never traps; a == 0 cannot overflow and is masked out of the result.
        let zero: usize = intrinsic_constant(context, node, type_id, 0);
        let is_zero: usize = intrinsic_convert(
            context, node, intrinsic_float_compare(context, node, lexer::TokenKind.equal_equal, operand.value_id, zero),
            boolean_type, type_id);
        let divisor: usize = intrinsic_binary(context, node, lexer::TokenKind.pipe, type_id, operand.value_id, is_zero);
        let quotient: usize = intrinsic_binary(context, node, lexer::TokenKind.slash, type_id, wrapped, divisor);
        let mismatch: usize = intrinsic_convert(
            context, node,
            intrinsic_float_compare(context, node, lexer::TokenKind.bang_equal, quotient, count.value_id),
            boolean_type, type_id);
        let nonzero: usize = intrinsic_convert(
            context, node, intrinsic_float_compare(context, node, lexer::TokenKind.bang_equal, operand.value_id, zero),
            boolean_type, type_id);
        overflow = intrinsic_float_compare(
            context, node, lexer::TokenKind.bang_equal,
            intrinsic_binary(context, node, lexer::TokenKind.ampersand, type_id, mismatch, nonzero), zero);
    } else {
        // overflow_flag must be emitted immediately after the arithmetic: codegen for binary_integer ends
        // with a mov store, so the add/sub/imul flags reach the setcc unclobbered. Only signed operations
        // and unsigned add/sub come here: signed uses seto, unsigned add/sub uses setc.
        var flag: ir::Instruction = builder::instruction(ir::Opcode.overflow_flag, node);
        flag.auxiliary = type_info::is_signed_integer(record.kind) ? 1 : 0;
        overflow = builder::emit_value(context, flag, boolean_type);
    }
    if (wrapped == none || overflow == none ||
        !builder::store_to_address(
            context, node, destination.value_id, type_id, intrinsic_float_rvalue(type_id, wrapped))) {
        return intrinsic_invalid_expression();
    }
    return intrinsic_float_rvalue(boolean_type, overflow);
}

fn intrinsic_resolve(context: *context::Context, node: syntax::SyntaxNode) -> usize {
    let none: usize = context::no_id();
    for (var index: usize = 0; index < IntrinsicLimit.entries as usize; index += 1) {
        let entry: IntrinsicEntry = intrinsic_entry(index);
        if (context::token_equals_bytes(
                context, context->current_unit, node.token_index, entry.name, entry.name_length)) {
            if (node.child_count != entry.arity) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.argument_count, context->current_unit, node.span, none,
                    context::empty_span(), entry.arity);
                return none;
            }
            return index;
        }
    }
    context::add_diagnostic(
        context, context::DiagnosticKind.unknown_intrinsic, context->current_unit, node.span, none,
        context::empty_span(), 0);
    return none;
}

// @file() yields a *const u8 to a NUL-terminated global holding the unit's path as the driver recorded
// it; @line() yields the 1-based line of the intrinsic's own span as a usize constant.
fn lower_source_intrinsic(
    context: *context::Context, node: syntax::SyntaxNode, entry: IntrinsicEntry) -> context::Expression {
    let none: usize = context::no_id();
    if (entry.lowering == IntrinsicLowering.source_line) {
        return builder::emit_integer_constant(
            context, node, type_info::BuiltinType.unsigned_size as usize, node.span.line as u64);
    }
    let path: string_views::string_view = context::unit_path(context, context->current_unit);
    var bytes: bytes::Buffer = bytes::empty();
    var step: bytes::BufferResult = bytes::append(bytes, path.data, path.length);
    bytes = step.buffer;
    if (step.error == runtime::Error.none) {
        step = bytes::push(bytes, 0);
        bytes = step.buffer;
    }
    if (step.error != runtime::Error.none) {
        context->error = step.error;
        let discard_error: runtime::Error = bytes::release(bytes);
        return intrinsic_invalid_expression();
    }
    let global_id: usize = ir::add_global(&context->ir, bytes.data as *const u8, bytes.length, 1, true);
    let release_error: runtime::Error = bytes::release(bytes);
    if (global_id == none) {
        if (context->error == runtime::Error.none) {
            context->error = context->ir.error;
        }
        return intrinsic_invalid_expression();
    }
    if (release_error != runtime::Error.none) {
        context->error = release_error;
        return intrinsic_invalid_expression();
    }
    let pointer: type_info::IdResult = context->types.pointer(type_info::BuiltinType.unsigned_8 as usize, true, false);
    context->error = pointer.error;
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.global_address, node);
    instruction.auxiliary = global_id;
    let value_id: usize = builder::emit_value(context, instruction, pointer.type_id);
    return {
        type_id = pointer.type_id, value_id = value_id, address_id = none, constant_value = 0, has_constant = false,
        category = category::Category.rvalue, valid = value_id != none, bitfield_segment = none,
    };
}

struct RttiTypes {
    source_class: usize;
    target_class: usize;
    result_type: usize;
    valid: bool;
}

fn invalid_rtti_types() -> RttiTypes {
    let none: usize = context::no_id();
    return {source_class = none, target_class = none, result_type = none, valid = false};
}

fn resolve_rtti_types(
    context: *context::Context, node: syntax::SyntaxNode,
    entry: IntrinsicEntry, source: context::Expression) -> RttiTypes {
    if (!source.valid || source.type_id >= context->types.size()) {
        return invalid_rtti_types();
    }
    let source_pointer: type_info::Record = context::type_record(context, source.type_id);
    if (source_pointer.kind != type_info::Kind.pointer) {
        return invalid_rtti_types();
    }
    let source_class: usize = source_pointer.element_type;
    let source_is_class: bool = context::type_record(context, source_class).kind == type_info::Kind.class_type;
    let source_has_rtti: bool = source_is_class && classes::rtti_is_enabled(context, source_class);
    if (!source_has_rtti || node.child_count != entry.arity) {
        return invalid_rtti_types();
    }
    let source_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let target_node: syntax::SyntaxNode = context::node(context, context->current_unit, source_node.next_sibling);
    let target_class: usize = types::resolve_class_expression(context, context->current_unit, target_node);
    if (target_class == context::no_id() || !classes::rtti_is_enabled(context, target_class)) {
        return invalid_rtti_types();
    }
    let source_is_base: bool = classes::is_base_of(context, source_class, target_class);
    let target_is_base: bool = classes::is_base_of(context, target_class, source_class);
    if (!source_is_base && !target_is_base) {
        return invalid_rtti_types();
    }
    var result_type: usize = type_info::BuiltinType.boolean as usize;
    if (entry.lowering == IntrinsicLowering.type_cast) {
        let read_only: bool = (source_pointer.flags & (type_info::Flag.read_only as usize)) != 0;
        let volatile_pointee: bool = (source_pointer.flags & (type_info::Flag.volatile_pointee as usize)) != 0;
        let result: type_info::IdResult = context->types.pointer(target_class, read_only, volatile_pointee);
        context->error = result.error;
        result_type = result.type_id;
    }
    return {
        source_class = source_class, target_class = target_class,
        result_type = result_type, valid = context->error == runtime::Error.none,
    };
}

fn intrinsic_pointer_type(context: *context::Context, element_type: usize, read_only: bool) -> usize {
    let result: type_info::IdResult = context->types.pointer(element_type, read_only, false);
    context->error = result.error;
    return result.error == runtime::Error.none ? result.type_id : context::no_id();
}

fn intrinsic_pointer_offset(
    context: *context::Context, node: syntax::SyntaxNode,
    pointer_value: usize, pointer_type: usize, byte_offset: usize) -> usize {
    if (byte_offset == 0) {
        return pointer_value;
    }
    let offset: usize = intrinsic_constant(
        context, node, type_info::BuiltinType.unsigned_size as usize, byte_offset as u64);
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.pointer_offset, node);
    instruction.left = pointer_value;
    instruction.right = offset;
    instruction.auxiliary = 1;
    return builder::emit_value(context, instruction, pointer_type);
}

fn intrinsic_load(context: *context::Context, node: syntax::SyntaxNode, address: usize, type_id: usize) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.load_indirect, node);
    instruction.left = address;
    return builder::emit_value(context, instruction, type_id);
}

fn intrinsic_compare(
    context: *context::Context, node: syntax::SyntaxNode,
    operation: lexer::TokenKind, left: usize, right: usize) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.compare, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return builder::emit_value(context, instruction, type_info::BuiltinType.boolean as usize);
}

fn intrinsic_rvalue(type_id: usize, value_id: usize) -> context::Expression {
    return {
        type_id = type_id, value_id = value_id, address_id = context::no_id(), constant_value = 0,
        has_constant = false, category = category::Category.rvalue,
        valid = value_id != context::no_id(), bitfield_segment = context::no_id(),
    };
}

fn store_rtti_value(
    context: *context::Context, node: syntax::SyntaxNode, address: usize, type_id: usize, value_id: usize) -> bool {
    return builder::store_to_address(context, node, address, type_id, intrinsic_rvalue(type_id, value_id));
}

fn descriptor_from_object(
    context: *context::Context, node: syntax::SyntaxNode,
    source: context::Expression, source_class: usize, byte_pointer: usize, pointer_storage: usize) -> usize {
    let object_bytes: usize = intrinsic_convert(context, node, source.value_id, source.type_id, byte_pointer);
    let vptr_bytes: usize = intrinsic_pointer_offset(
        context, node, object_bytes, byte_pointer, classes::vptr_offset(context, source_class));
    let vptr_storage: usize = intrinsic_convert(context, node, vptr_bytes, byte_pointer, pointer_storage);
    let vtable: usize = intrinsic_load(context, node, vptr_storage, byte_pointer);
    let address_type: usize = type_info::BuiltinType.unsigned_size as usize;
    let vtable_address: usize = intrinsic_convert(context, node, vtable, byte_pointer, address_type);
    let prefix_bytes: usize = ir::Limit.function_address_bytes as usize;
    let prefix: usize = intrinsic_constant(context, node, address_type, prefix_bytes as u64);
    let descriptor_storage_address: usize = intrinsic_binary(
        context, node, lexer::TokenKind.minus, address_type, vtable_address, prefix);
    let descriptor_storage: usize = intrinsic_convert(
        context, node, descriptor_storage_address, address_type, pointer_storage);
    return intrinsic_load(context, node, descriptor_storage, byte_pointer);
}

fn descriptor_base(
    context: *context::Context, node: syntax::SyntaxNode,
    descriptor: usize, byte_pointer: usize, pointer_storage: usize) -> usize {
    let storage: usize = intrinsic_convert(context, node, descriptor, byte_pointer, pointer_storage);
    return intrinsic_load(context, node, storage, byte_pointer);
}

fn descriptor_global_address(
    context: *context::Context, node: syntax::SyntaxNode, target_class: usize, byte_pointer: usize) -> usize {
    let global_id: usize = classes::descriptor_global(context, target_class);
    if (global_id == context::no_id()) {
        return context::no_id();
    }
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.global_address, node);
    instruction.auxiliary = global_id;
    return builder::emit_value(context, instruction, byte_pointer);
}

fn rtti_success_value(
    context: *context::Context, node: syntax::SyntaxNode,
    entry: IntrinsicEntry, source: context::Expression, result_type: usize) -> usize {
    if (entry.lowering == IntrinsicLowering.type_is) {
        return builder::emit_boolean_constant(context, node, true).value_id;
    }
    return intrinsic_convert(context, node, source.value_id, source.type_id, result_type);
}

fn rtti_failure_value(
    context: *context::Context, node: syntax::SyntaxNode, entry: IntrinsicEntry, result_type: usize) -> usize {
    return entry.lowering == IntrinsicLowering.type_is ? builder::emit_boolean_constant(context, node, false).value_id :
        builder::emit_null_constant(context, node, result_type).value_id;
}

fn lower_rtti_intrinsic(
    context: *context::Context, node: syntax::SyntaxNode,
    intrinsic_index: usize, source: context::Expression) -> context::Expression {
    let entry: IntrinsicEntry = intrinsic_entry(intrinsic_index);
    let resolved: RttiTypes = resolve_rtti_types(context, node, entry, source);
    if (!resolved.valid) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_rtti, context->current_unit, node.span,
            context::no_id(), context::empty_span(), source.type_id);
        return intrinsic_invalid_expression();
    }
    let byte_pointer: usize = intrinsic_pointer_type(context, type_info::BuiltinType.unsigned_8 as usize, true);
    let pointer_storage: usize = intrinsic_pointer_type(context, byte_pointer, true);
    let state_slot: usize = ir::add_slot(
        &context->ir, builder::current_ir_function(context), byte_pointer, true, false, 0);
    let result_slot: usize = ir::add_slot(
        &context->ir, builder::current_ir_function(context), resolved.result_type, true, false, 0);
    let state_address: usize = builder::address_of_slot(context, node, state_slot, byte_pointer, false, false);
    let result_address: usize = builder::address_of_slot(
        context, node, result_slot, resolved.result_type, false, false);
    let storage_is_valid: bool = state_address != context::no_id() && result_address != context::no_id();
    if (!storage_is_valid || pointer_storage == context::no_id()) {
        return intrinsic_invalid_expression();
    }

    let setup_block: usize = builder::add_current_block(context);
    let compare_block: usize = builder::add_current_block(context);
    let advance_block: usize = builder::add_current_block(context);
    let continue_block: usize = builder::add_current_block(context);
    let success_block: usize = builder::add_current_block(context);
    let failure_block: usize = builder::add_current_block(context);
    let merge_block: usize = builder::add_current_block(context);
    let null_source: usize = builder::emit_null_constant(context, node, source.type_id).value_id;
    let source_exists: usize = intrinsic_compare(
        context, node, lexer::TokenKind.bang_equal, source.value_id, null_source);
    builder::emit_branch(context, node, source_exists, setup_block, failure_block);

    context->current_block = setup_block;
    let descriptor: usize = descriptor_from_object(
        context, node, source, resolved.source_class, byte_pointer, pointer_storage);
    store_rtti_value(context, node, state_address, byte_pointer, descriptor);
    builder::emit_jump(context, node, compare_block);

    context->current_block = compare_block;
    let current_descriptor: usize = intrinsic_load(context, node, state_address, byte_pointer);
    let target_descriptor: usize = descriptor_global_address(context, node, resolved.target_class, byte_pointer);
    let matches: usize = intrinsic_compare(
        context, node, lexer::TokenKind.equal_equal, current_descriptor, target_descriptor);
    builder::emit_branch(context, node, matches, success_block, advance_block);

    context->current_block = advance_block;
    let base_descriptor: usize = descriptor_base(context, node, current_descriptor, byte_pointer, pointer_storage);
    let null_descriptor: usize = builder::emit_null_constant(context, node, byte_pointer).value_id;
    let has_base: usize = intrinsic_compare(
        context, node, lexer::TokenKind.bang_equal, base_descriptor, null_descriptor);
    builder::emit_branch(context, node, has_base, continue_block, failure_block);

    context->current_block = continue_block;
    store_rtti_value(context, node, state_address, byte_pointer, base_descriptor);
    builder::emit_jump(context, node, compare_block);

    context->current_block = success_block;
    let success_value: usize = rtti_success_value(context, node, entry, source, resolved.result_type);
    store_rtti_value(context, node, result_address, resolved.result_type, success_value);
    builder::emit_jump(context, node, merge_block);

    context->current_block = failure_block;
    let failure_value: usize = rtti_failure_value(context, node, entry, resolved.result_type);
    store_rtti_value(context, node, result_address, resolved.result_type, failure_value);
    builder::emit_jump(context, node, merge_block);

    context->current_block = merge_block;
    let result: usize = intrinsic_load(context, node, result_address, resolved.result_type);
    return intrinsic_rvalue(resolved.result_type, result);
}

fn lower_intrinsic(
    context: *context::Context, node: syntax::SyntaxNode, intrinsic_index: usize,
    operand: context::Expression, count: context::Expression, destination: context::Expression) -> context::Expression {
    let none: usize = context::no_id();
    let entry: IntrinsicEntry = intrinsic_entry(intrinsic_index);
    if ((entry.arity >= 1 && !operand.valid) || (entry.arity >= 2 && !count.valid) ||
        (entry.arity == 3 && !destination.valid)) {
        return intrinsic_invalid_expression();
    }
    if (entry.operand_class == IntrinsicOperandClass.none) {
        return lower_source_intrinsic(context, node, entry);
    }
    let syntax_owned: bool = entry.operand_class == IntrinsicOperandClass.embedded_file ||
        entry.operand_class == IntrinsicOperandClass.rtti;
    if (syntax_owned || entry.operand_class == IntrinsicOperandClass.type_property) {
        // @embed is intercepted in expr::lower_expression and lowered by
        // expr_literals::lower_embed (expr.la), which owns the string decoding helpers.
        return intrinsic_invalid_expression();
    }
    if (entry.operand_class == IntrinsicOperandClass.integer_overflow) {
        return lower_overflow_intrinsic(context, node, entry, operand, count, destination);
    }
    if (entry.operand_class == IntrinsicOperandClass.float_scalar ||
        entry.operand_class == IntrinsicOperandClass.float_scalar_binary) {
        return lower_float_intrinsic(context, node, entry, operand, count);
    }
    let record: type_info::Record = context::type_record(context, operand.type_id);
    var width: usize = 0;
    var work_type: usize = none;
    var info_index: usize = 0;
    while (info_index < 10) {
        let info: IntrinsicIntegerInfo = intrinsic_integer_info(info_index);
        if (info.kind == record.kind) {
            width = info.width;
            work_type = info.unsigned_type;
            break;
        }
        info_index += 1;
    }
    if (work_type == none || (entry.operand_class == IntrinsicOperandClass.integer_scalar_wide && width < 16) ||
        (entry.operand_class == IntrinsicOperandClass.integer_scalar_rotated &&
            count.type_id != type_info::BuiltinType.unsigned_size as usize)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            context::empty_span(), operand.type_id);
        return intrinsic_invalid_expression();
    }
    // Signed operands are evaluated in the unsigned type of the same width so every expansion shift is
    // logical; the same-width conversions preserve the bit pattern and never trap.
    let x: usize = intrinsic_convert(context, node, operand.value_id, operand.type_id, work_type);
    var result: usize = none;
    switch (entry.lowering) {
    case IntrinsicLowering.count_leading_zeros {
        let ones: usize = intrinsic_constant(
            context, node, work_type, builder::mask_integer(0xFFFFFFFFFFFFFFFF, width));
        let smeared: usize = intrinsic_smear(context, node, work_type, width, x);
        let inverted: usize = intrinsic_binary(context, node, lexer::TokenKind.caret, work_type, smeared, ones);
        result = intrinsic_popcount(context, node, work_type, width, inverted);
    }
    case IntrinsicLowering.count_trailing_zeros {
        let ones: usize = intrinsic_constant(
            context, node, work_type, builder::mask_integer(0xFFFFFFFFFFFFFFFF, width));
        let inverted: usize = intrinsic_binary(context, node, lexer::TokenKind.caret, work_type, x, ones);
        let decremented: usize = intrinsic_binary(
            context, node, lexer::TokenKind.minus, work_type, x, intrinsic_constant(context, node, work_type, 1));
        let isolated: usize = intrinsic_binary(
            context, node, lexer::TokenKind.ampersand, work_type, inverted, decremented);
        result = intrinsic_popcount(context, node, work_type, width, isolated);
    }
    case IntrinsicLowering.population_count {
        result = intrinsic_popcount(context, node, work_type, width, x);
    }
    case IntrinsicLowering.rotate_left {
        result = intrinsic_rotate(context, node, work_type, width, x, count.value_id, count.type_id, true);
    }
    case IntrinsicLowering.rotate_right {
        result = intrinsic_rotate(context, node, work_type, width, x, count.value_id, count.type_id, false);
    }
    case IntrinsicLowering.byte_swap {
        result = intrinsic_byte_swap(context, node, work_type, width, x);
    }
    }
    if (result != none) {
        result = intrinsic_convert(context, node, result, work_type, operand.type_id);
    }
    return {
        type_id = operand.type_id, value_id = result, address_id = none, constant_value = 0, has_constant = false,
        category = category::Category.rvalue, valid = result != none, bitfield_segment = context::no_id(),
    };
}
