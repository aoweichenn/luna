module luna.bootstrap.middleend.semantic.context;

import luna.bootstrap.middleend.ir.verify as ir_check;

import luna.std.ascii as ascii;
import luna.std.checked as checked;

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty_span() -> lexer::SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn invalid_diagnostic()
    -> Diagnostic {
    let none: usize = no_id();
    return {
        kind = DiagnosticKind.invalid_input, unit_index = none, span = empty_span(), related_unit = none,
        related_span = empty_span(), detail = 0,
    };
}

fn input_empty(executable: bool) -> Input {
    return {
        units = bytes::empty(), paths = bytes::empty(), unit_count = 0, executable = executable,
    };
}

fn input_storage_is_valid(input: Input) -> bool {
    return bytes::is_valid(input.units) && bytes::is_valid(input.paths) && input.units.length % sizeof(Unit) == 0 &&
        input.unit_count <= Limit.maximum_modules as usize * 2 && input.unit_count == input.units.length / sizeof(Unit);
}

fn source_is_valid(source: text::View) -> bool {
    if (!text::is_valid_utf8(source)) {
        return false;
    }
    var index: usize = 0;
    while (index < source.length) {
        if (source.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn unit_is_valid(unit: Unit) -> bool {
    return source_is_valid(unit.source) && lexer::token_buffer_is_valid(unit.tokens) &&
        syntax::syntax_tree_is_valid(unit.tree) && unit.tokens.count == unit.tree.token_count;
}

fn input_is_valid(input: Input) -> bool {
    if (!input_storage_is_valid(input) || input.unit_count == 0 || input.unit_count >
            Limit.maximum_modules as usize * 2) {
        return false;
    }
    let units: *const Unit = input.units.data as *const Unit;
    var index: usize = 0;
    while (index < input.unit_count) {
        if (!unit_is_valid(units[index]) || units[index].path_length > input.paths.length || units[index].path_offset >
                input.paths.length - units[index].path_length) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn input_add(input: *Input, unit: Unit, path: text::View) -> bool {
    if (input == null || !input_storage_is_valid(*input) || !unit_is_valid(unit) ||
        (path.length != 0 && path.data == null) || input->unit_count >= Limit.maximum_modules as usize * 2) {
        return false;
    }
    var record: Unit = unit;
    record.path_offset = input->paths.length;
    record.path_length = path.length;
    let path_appended: bytes::BufferResult = bytes::append(input->paths, path.data, path.length);
    input->paths = path_appended.buffer;
    if (path_appended.error != runtime::Error.none) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(
        input->units, (&record) as *const Unit as *const u8, sizeof(Unit));
    input->units = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return false;
    }
    input->unit_count += 1;
    return true;
}

fn input_release(input: Input) -> runtime::Error {
    if (!input_storage_is_valid(input)) {
        return runtime::Error.invalid_argument;
    }
    let units_error: runtime::Error = bytes::release(input.units);
    let paths_error: runtime::Error = bytes::release(input.paths);
    return units_error != runtime::Error.none ? units_error : paths_error;
}

fn diagnostics_empty()
    -> DiagnosticBuffer {
    return {
        storage = bytes::empty(), count = 0,
    };
}

fn diagnostics_storage_is_valid(diagnostics: DiagnosticBuffer) -> bool {
    return bytes::is_valid(diagnostics.storage) && diagnostics.storage.length % sizeof(Diagnostic) == 0 &&
        diagnostics.count <= Limit.maximum_diagnostics as usize && diagnostics.count == diagnostics.storage.length /
                sizeof(Diagnostic);
}

fn diagnostic_get(diagnostics: DiagnosticBuffer, index: usize) -> DiagnosticResult {
    if (!diagnostics_storage_is_valid(
            diagnostics) || index >= diagnostics.count) {
        return {
            diagnostic = invalid_diagnostic(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const Diagnostic = diagnostics.storage.data as
            *const Diagnostic;
    return {
        diagnostic = records[index], error = runtime::Error.none,
    };
}

fn add_diagnostic(
    context: *Context, kind: DiagnosticKind, unit_index: usize, span: lexer::SourceSpan, related_unit: usize,
    related_span: lexer::SourceSpan, detail: usize) -> bool {
    if (context->error != runtime::Error.none) {
        return false;
    }
    if (context->diagnostics.count >= Limit.maximum_diagnostics as usize) {
        context->error = runtime::Error.out_of_memory;
        return false;
    }
    let diagnostic: Diagnostic = {
        kind = kind, unit_index = unit_index, span = span, related_unit = related_unit, related_span = related_span,
        detail = detail,
    };
    let appended: bytes::BufferResult = bytes::append(
        context->diagnostics.storage, (&diagnostic) as
            *const Diagnostic as *const u8, sizeof(Diagnostic));
    context->diagnostics.storage = appended.buffer;
    context->error = appended.error;
    if (appended.error == runtime::Error.none) {
        context->diagnostics.count += 1;
        return true;
    }
    return false;
}

fn result_is_success(result: Result) -> bool {
    return result.error == runtime::Error.none && result.diagnostics.count == 0 &&
        type_info::table_is_valid(result.types, true) && ir_check::is_valid(result.ir, result.types);
}

fn release_error(current: runtime::Error, next: runtime::Error) -> runtime::Error {
    return current == runtime::Error.none ? next : current;
}

fn result_release(result: Result) -> runtime::Error {
    if (!diagnostics_storage_is_valid(result.diagnostics) ||
        !type_info::table_storage_is_valid(result.types) || !ir::storage_is_valid(result.ir)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = type_info::table_release(result.types);
    error = release_error(error, ir::release(result.ir));
    error = release_error(error, bytes::release(result.diagnostics.storage));
    return error;
}

enum ContextStorageCount: usize {
    records = 21,
}

struct ContextStorageRecord {
    buffer: bytes::Buffer;
    count: usize;
    record_size: usize;
}

struct ContextStorageValidator {
    valid: bool;
}

fn context_storage_require(validator: *ContextStorageValidator, requirement: bool) {
    validator->valid = validator->valid && requirement;
}

fn storage_record_is_valid(record: ContextStorageRecord) -> bool {
    let shape_is_valid: bool = bytes::is_valid(record.buffer) && record.record_size != 0;
    if (!shape_is_valid) {
        return false;
    }
    let length_is_valid: bool = record.buffer.length % record.record_size == 0;
    return length_is_valid && record.count == record.buffer.length / record.record_size;
}

fn storage_records_are_valid(records: *const ContextStorageRecord, count: usize) -> bool {
    if (records == null) {
        return false;
    }
    for (var index: usize = 0; index < count; index += 1) {
        if (!storage_record_is_valid(records[index])) {
            return false;
        }
    }
    return true;
}

fn context_record_storage_is_valid(context: *const Context) -> bool {
    var records: [ContextStorageCount.records]ContextStorageRecord = {};
    records[0] = {buffer = context->units, count = context->unit_count, record_size = sizeof(UnitInfo)};
    records[1] = {buffer = context->modules, count = context->module_count, record_size = sizeof(Module)};
    records[2] = {buffer = context->imports, count = context->import_count, record_size = sizeof(Import)};
    records[3] = {buffer = context->symbols, count = context->symbol_count, record_size = sizeof(Symbol)};
    records[4] = {buffer = context->bindings, count = context->binding_count, record_size = sizeof(Binding)};
    records[5] = {
        buffer = context->callable_candidates, count = context->callable_candidate_count, record_size = sizeof(usize),
    };
    records[6] = {buffer = context->functions, count = context->function_count, record_size = sizeof(Function)};
    records[7] = {buffer = context->parameters, count = context->parameter_count, record_size = sizeof(Parameter)};
    records[8] = {buffer = context->locals, count = context->local_count, record_size = sizeof(Local)};
    records[9] = {
        buffer = context->alignment_overrides, count = context->alignment_override_count,
        record_size = sizeof(AlignmentOverride),
    };
    records[10] = {
        buffer = context->bitfield_segments, count = context->bitfield_segment_count,
        record_size = sizeof(BitfieldSegment),
    };
    records[11] = {
        buffer = context->const_functions, count = context->const_function_count, record_size = sizeof(ConstFunction),
    };
    records[12] = {
        buffer = context->const_locals, count = context->const_local_count, record_size = sizeof(ConstLocal),
    };
    records[13] = {
        buffer = context->array_lengths, count = context->array_length_count, record_size = sizeof(ArrayLength),
    };
    records[14] = {buffer = context->labels, count = context->label_count, record_size = sizeof(Label)};
    records[15] = {
        buffer = context->pending_gotos, count = context->pending_goto_count, record_size = sizeof(PendingGoto),
    };
    records[16] = {
        buffer = context->loop_labels, count = context->loop_label_count, record_size = sizeof(LoopLabel),
    };
    records[17] = {
        buffer = context->label_locals, count = context->label_locals.length / sizeof(usize),
        record_size = sizeof(usize),
    };
    records[18] = {
        buffer = context->goto_locals, count = context->goto_locals.length / sizeof(usize), record_size = sizeof(usize),
    };
    records[19] = {
        buffer = context->call_selections, count = context->call_selection_count, record_size = sizeof(usize),
    };
    records[20] = {
        buffer = context->generic_callable_candidates, count = context->generic_callable_candidate_count,
        record_size = sizeof(usize),
    };
    return storage_records_are_valid(
        (&records[0]) as *const ContextStorageRecord, ContextStorageCount.records as usize);
}

fn context_storage_is_valid(context: *Context) -> bool {
    if (context == null) {
        return false;
    }
    var validator: ContextStorageValidator = {valid = true};
    context_storage_require(&validator, context_record_storage_is_valid(context as *const Context));
    context_storage_require(&validator, bytes::is_valid(context->callable_signatures));
    context_storage_require(&validator, class_model::storage_is_valid(context->classes));
    context_storage_require(&validator, generic_model::storage_is_valid(context->generics));
    context_storage_require(&validator, context->scope_depth <= Limit.maximum_scope_depth as usize &&
        context->type_depth <= Limit.maximum_type_depth as usize);
    context_storage_require(&validator, diagnostics_storage_is_valid(context->diagnostics));
    context_storage_require(&validator, type_info::table_storage_is_valid(context->types));
    context_storage_require(&validator, ir::storage_is_valid(context->ir));
    return validator.valid;
}

fn context_init(input: Input) -> Context {
    return {
        input = input, units = bytes::empty(), unit_count = 0, modules = bytes::empty(), module_count = 0,
        imports = bytes::empty(), import_count = 0, symbols = bytes::empty(), symbol_count = 0,
        bindings = bytes::empty(), binding_count = 0, callable_candidates = bytes::empty(),
            callable_candidate_count = 0, generic_callable_candidates = bytes::empty(),
            generic_callable_candidate_count = 0, call_selections = bytes::empty(), call_selection_count = 0,
        functions = bytes::empty(), function_count = 0, callable_signatures = bytes::empty(),
        parameters = bytes::empty(), parameter_count = 0, classes = class_model::empty(),
        generics = generic_model::empty(),
        locals = bytes::empty(), local_count = 0, alignment_overrides = bytes::empty(), alignment_override_count = 0,
        bitfield_segments = bytes::empty(), bitfield_segment_count = 0, const_functions = bytes::empty(),
        const_function_count = 0, const_locals = bytes::empty(), const_local_count = 0, array_lengths = bytes::empty(),
        array_length_count = 0, labels = bytes::empty(), label_count = 0, label_locals = bytes::empty(),
        pending_gotos = bytes::empty(), pending_goto_count = 0, goto_locals = bytes::empty(),
        loop_labels = bytes::empty(), loop_label_count = 0, pending_loop_label = no_id(), const_call_depth = 0,
        const_steps = 0, types = type_info::table_empty(), ir = ir::empty(), diagnostics = diagnostics_empty(),
        error = runtime::Error.none, current_function = no_id(), current_unit = no_id(),
        scope_depth = 0, type_depth = 0, break_block = no_id(), continue_block = no_id(),
    };
}

fn context_release_work(context: *Context) -> runtime::Error {
    if (!context_storage_is_valid(context)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(context->units);
    error = release_error(error, bytes::release(context->modules));
    error = release_error(error, bytes::release(context->imports));
    error = release_error(error, bytes::release(context->symbols));
    error = release_error(error, bytes::release(context->bindings));
    error = release_error(error, bytes::release(context->callable_candidates));
    error = release_error(error, bytes::release(context->generic_callable_candidates));
    error = release_error(error, bytes::release(context->call_selections));
    error = release_error(error, bytes::release(context->functions));
    error = release_error(error, bytes::release(context->callable_signatures));
    error = release_error(error, bytes::release(context->parameters));
    error = release_error(error, class_model::release(context->classes));
    error = release_error(error, generic_model::release(context->generics));
    error = release_error(error, bytes::release(context->locals));
    error = release_error(error, bytes::release(context->alignment_overrides));
    error = release_error(error, bytes::release(context->bitfield_segments));
    error = release_error(error, bytes::release(context->const_functions));
    error = release_error(error, bytes::release(context->const_locals));
    error = release_error(error, bytes::release(context->array_lengths));
    error = release_error(error, bytes::release(context->labels));
    error = release_error(error, bytes::release(context->label_locals));
    error = release_error(error, bytes::release(context->pending_gotos));
    error = release_error(error, bytes::release(context->goto_locals));
    error = release_error(error, bytes::release(context->loop_labels));
    return error;
}

fn input_unit(context: *Context, unit_index: usize) -> *const Unit {
    if (context == null || unit_index >= context->input.unit_count) {
        return null;
    }
    let units: *const Unit = context->input.units.data as
            *const Unit;
    return &units[unit_index];
}

fn unit_path(context: *Context, unit_index: usize) -> text::View {
    let unit: *const Unit = input_unit(context, unit_index);
    if (unit == null || unit->path_length == 0) {
        return { data = null, length = 0 };
    }
    let paths: *const u8 = context->input.paths.data as *const u8;
    return {
        data = &paths[unit->path_offset], length = unit->path_length,
    };
}

fn node(context: *Context, unit_index: usize, node_index: usize) -> syntax::SyntaxNode {
    let unit: *const Unit = input_unit(context, unit_index);
    if (unit == null) {
        return {
            kind = syntax::SyntaxKind.invalid, span = empty_span(), token_index = no_id(), parent = no_id(),
            first_child = no_id(), last_child = no_id(), next_sibling = no_id(), child_count = 0, flags = 0,
        };
    }
    let result: syntax::SyntaxNodeResult = syntax::syntax_tree_get(unit->tree, node_index);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
    }
    return result.node;
}

fn token(context: *Context, unit_index: usize, token_index: usize) -> lexer::Token {
    let unit: *const Unit = input_unit(context, unit_index);
    if (unit == null) {
        return {
            kind = lexer::TokenKind.invalid, span = empty_span(),
        };
    }
    let result: lexer::TokenResult = lexer::token_buffer_get(unit->tokens, token_index);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
    }
    return result.token;
}

fn text_equal(
    context: *Context, left_unit: usize, left_span: lexer::SourceSpan, right_unit: usize, right_span: lexer::SourceSpan
) -> bool {
    if (left_span.length != right_span.length) {
        return false;
    }
    let left: *const Unit = input_unit(context, left_unit);
    let right: *const Unit = input_unit(context, right_unit);
    if (left == null || right == null || left_span.offset > left->source.length || left_span.length >
            left->source.length - left_span.offset || right_span.offset > right->source.length || right_span.length >
            right->source.length - right_span.offset) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var index: usize = 0;
    while (index < left_span.length) {
        if (left->source.data[left_span.offset + index] != right->source.data[right_span.offset + index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn tokens_equal(context: *Context, left_unit: usize, left_token: usize, right_unit: usize, right_token: usize) -> bool {
    return text_equal(
        context, left_unit, token(context, left_unit, left_token).span, right_unit,
        token(context, right_unit, right_token).span);
}

// Children of an import declaration beyond the dotted module name — the
// `as` alias and the selective_import_names container — are not part of the
// module name being matched.
fn module_name_segment_count(node: syntax::SyntaxNode) -> usize {
    var count: usize = node.child_count;
    if ((node.flags & (syntax::SyntaxFlag.aliased_import as usize)) != 0 && count != 0) {
        count -= 1;
    }
    if ((node.flags & (syntax::SyntaxFlag.selective_import as usize)) != 0 && count != 0) {
        count -= 1;
    }
    return count;
}

fn module_names_equal(
    context: *Context, left_unit: usize, left_node: usize, right_unit: usize, right_node: usize) -> bool {
    let left: syntax::SyntaxNode = node(context, left_unit, left_node);
    let right: syntax::SyntaxNode = node(context, right_unit, right_node);
    let left_count: usize = module_name_segment_count(left);
    let right_count: usize = module_name_segment_count(right);
    if (left_count != right_count || left_count == 0) {
        return false;
    }
    var left_child: usize = left.first_child;
    var right_child: usize = right.first_child;
    var index: usize = 0;
    while (index < left_count) {
        let left_name: syntax::SyntaxNode = node(context, left_unit, left_child);
        let right_name: syntax::SyntaxNode = node(context, right_unit, right_child);
        if (!tokens_equal(
                context, left_unit, left_name.token_index, right_unit, right_name.token_index)) {
            return false;
        }
        left_child = left_name.next_sibling;
        right_child = right_name.next_sibling;
        index += 1;
    }
    return true;
}

fn parse_unsigned(context: *Context, unit_index: usize, token_index: usize, value: *u64) -> bool {
    let token: lexer::Token = token(context, unit_index, token_index);
    let unit: *const Unit = input_unit(context, unit_index);
    if (token.kind != lexer::TokenKind.integer || value == null || token.span.length == 0) {
        return false;
    }
    var base: u64 = 10;
    var index: usize = 0;
    if (token.span.length >= 2 && unit->source.data[token.span.offset] == '0') {
        let prefix: u8 = unit->source.data[token.span.offset + 1];
        if (prefix == 'b' || prefix == 'B') {
            base = 2;
            index = 2;
        } else if (prefix == 'o' || prefix == 'O') {
            base = 8;
            index = 2;
        } else if (prefix == 'x' || prefix == 'X') {
            base = 16;
            index = 2;
        }
    }
    var result: u64 = 0;
    while (index < token.span.length) {
        let byte: u8 = unit->source.data[token.span.offset + index];
        if (byte == '_') {
            index += 1;
            continue;
        }
        var digit: u64 = 0;
        if (!ascii::digit_value(byte, base, &digit)) {
            return false;
        }
        if (result > (18446744073709551615 - digit) / base) {
            return false;
        }
        result = result * base + digit;
        index += 1;
    }
    *value = result;
    return true;
}

// Decodes a character literal token (quotes included in the span) into its
// single code unit. The escape set matches string literals; anything that
// does not decode to exactly one code unit (empty, multi-code-unit content or
// an unknown escape) is rejected so C-style multi-character constants never
// reach lowering.
fn decode_character(context: *Context, unit_index: usize, token_index: usize, value: *u64) -> bool {
    let token: lexer::Token = token(context, unit_index, token_index);
    let unit: *const Unit = input_unit(context, unit_index);
    if (token.kind != lexer::TokenKind.character || value == null || token.span.length < 3) {
        return false;
    }
    var code: u64 = 0;
    var next: usize = 0;
    let first: u8 = unit->source.data[token.span.offset + 1];
    if (first != '\\') {
        code = first as u64;
        next = 2;
    } else {
        if (token.span.length < 4) {
            return false;
        }
        let escape: u8 = unit->source.data[token.span.offset + 2];
        if (escape == 'n') {
            code = '\n';
            next = 3;
        } else if (escape == 'r') {
            code = '\r';
            next = 3;
        } else if (escape == 't') {
            code = '\t';
            next = 3;
        } else if (escape == '0') {
            code = 0;
            next = 3;
        } else if (escape == '\\' || escape == '\x27' || escape == '"') {
            code = escape as u64;
            next = 3;
        } else if (escape == 'x') {
            if (token.span.length < 6) {
                return false;
            }
            let high = ascii::hex_value(unit->source.data[token.span.offset + 3]);
            let low = ascii::hex_value(unit->source.data[token.span.offset + 4]);
            if (high >= 16 || low >= 16) {
                return false;
            }
            code = (high * 16 + low) as u64;
            next = 5;
        } else {
            return false;
        }
    }
    if (next != token.span.length - 1) {
        return false;
    }
    *value = code;
    return true;
}

fn callable_value_type(
    context: *Context, kind: type_info::Kind, return_type: usize,
    parameter_types: *const usize, parameter_count: usize) -> usize {
    let none: usize = no_id();
    if (parameter_count != 0 && parameter_types == null) {
        context->error = runtime::Error.invalid_argument;
        return none;
    }
    let records: *const type_info::Record = context->types.types.data as
            *const type_info::Record;
    let fields: *const type_info::Field = context->types.fields.data as
            *const type_info::Field;
    for (var candidate: usize = type_info::BuiltinType.count as usize;
        candidate < context->types.type_count;
        candidate += 1) {
        let record: type_info::Record = records[candidate];
        let identity_matches: bool = record.kind == kind && record.element_type == return_type;
        let shape_matches: bool = identity_matches && record.field_count == parameter_count;
        if (shape_matches) {
            var same: bool = true;
            for (var index: usize = 0; index < parameter_count && same; index += 1) {
                if (fields[record.first_field + index].type_id != parameter_types[index]) {
                    same = false;
                }
            }
            if (same) {
                return candidate;
            }
        }
    }
    let type_id: usize = context->types.type_count;
    let created: type_info::TableResult = kind == type_info::Kind.function_pointer ?
        type_info::table_add_function_pointer(context->types, return_type) :
        type_info::table_add_bound_method(context->types, return_type);
    context->types = created.table;
    if (created.error != runtime::Error.none) {
        context->error = created.error;
        return none;
    }
    for (var index: usize = 0; index < parameter_count; index += 1) {
        let added: type_info::TableResult =
            type_info::table_add_parameter(context->types, type_id, parameter_types[index]);
        context->types = added.table;
        if (added.error != runtime::Error.none) {
            add_diagnostic(
                context, DiagnosticKind.invalid_external, context->current_unit, empty_span(), none, empty_span(),
                parameter_types[index]);
            return none;
        }
    }
    let size_bytes: usize = kind == type_info::Kind.function_pointer ? sizeof(usize) : sizeof(usize) * 2;
    context->error = type_info::table_set_layout(context->types, type_id, size_bytes, alignof(usize));
    if (context->error != runtime::Error.none) {
        return none;
    }
    return type_id;
}

fn function_pointer_type(
    context: *Context, return_type: usize, parameter_types: *const usize, parameter_count: usize) -> usize {
    return callable_value_type(
        context, type_info::Kind.function_pointer, return_type, parameter_types, parameter_count);
}

fn bound_method_type(
    context: *Context, return_type: usize, parameter_types: *const usize, parameter_count: usize) -> usize {
    return callable_value_type(context, type_info::Kind.bound_method, return_type, parameter_types, parameter_count);
}

fn align_up(value: usize, alignment: usize, result: *usize) -> bool {
    return checked::align_up(value, alignment, result);
}

fn integer_fits_type(kind: type_info::Kind, magnitude: u64, negative: bool) -> bool {
    let bits: usize = type_info::bit_width(kind);
    if (bits == 0 || bits > 64) {
        return false;
    }
    if (!type_info::is_signed_integer(kind)) {
        return !negative && (bits == 64 || magnitude < (1 as u64) << (bits as u64));
    }
    if (bits == 64) {
        return negative ? magnitude <= 9223372036854775808 : magnitude <= 9223372036854775807;
    }
    let maximum: u64 = (1 as u64) << ((bits - 1) as u64);
    return negative ? magnitude <= maximum : magnitude < maximum;
}

fn type_record(context: *Context, type_id: usize) -> type_info::Record {
    let result: type_info::RecordResult = type_info::table_get(context->types, type_id);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
    }
    return result.record;
}

fn token_equals_bytes(
    context: *Context, unit_index: usize, token_index: usize, bytes: *const u8, length: usize) -> bool {
    if (bytes == null) {
        return false;
    }
    let token: lexer::Token = token(context, unit_index, token_index);
    let unit: *const Unit = input_unit(context, unit_index);
    if (token.span.length != length) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (unit->source.data[token.span.offset + index] != bytes[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}
