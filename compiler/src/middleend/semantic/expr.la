module luna.bootstrap.middleend.semantic.expr;

import luna.bootstrap.middleend.semantic.context.builder as builder;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.expr.access as access;
import luna.bootstrap.middleend.semantic.expr.base as base;
import luna.bootstrap.middleend.semantic.expr.initializer as initializer;
import luna.bootstrap.middleend.semantic.expr.numeric as numeric;
import luna.bootstrap.middleend.semantic.expr.operators as operators;
import luna.bootstrap.middleend.semantic.expr.probe as probe;
import luna.bootstrap.middleend.semantic.expr.strings as strings;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.bootstrap.middleend.semantic.intrinsics as intrinsics;
import luna.bootstrap.middleend.semantic.types as types;
import luna.bootstrap.middleend.semantic.value as category;
import luna.bootstrap.middleend.type as type_info;

fn lower_into_destination(
    context: *context::Context, node_id: usize, expected_type: usize,
    destination: usize, result: *context::Expression) -> void {
    if (result != null) {
        *result = lower_expression_into(context, node_id, expected_type, destination);
    }
}

fn lower_type_property(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression {
    if (node.child_count != 1) {
        return base::invalid_expression();
    }
    let argument: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let type_id: usize = types::resolve_type_expression(context, context->current_unit, argument);
    if (type_id == context::no_id()) {
        return base::invalid_expression();
    }
    let relocatable: bool = functions::type_is_trivially_relocatable(context, type_id);
    return builder::emit_boolean_constant(context, node, relocatable);
}

fn lower_expression(context: *context::Context, node_id: usize, expected_type: usize) -> context::Expression {
    let node: syntax::SyntaxNode = context::node(context, context->current_unit, node_id);
    if (node.kind == syntax::SyntaxKind.integer_expression) {
        return numeric::lower_integer_literal(context, node, expected_type);
    }
    if (node.kind == syntax::SyntaxKind.character_expression) {
        return numeric::lower_character_literal(context, node, expected_type);
    }
    if (node.kind == syntax::SyntaxKind.floating_expression) {
        return numeric::lower_floating_literal(context, node, expected_type);
    }
    if (node.kind == syntax::SyntaxKind.boolean_expression) {
        return builder::emit_boolean_constant(
            context, node,
            context::token(context, context->current_unit, node.token_index).kind == lexer::TokenKind.keyword_true);
    }
    if (node.kind == syntax::SyntaxKind.string_expression) {
        return strings::lower_string_literal(context, node);
    }
    if (node.kind == syntax::SyntaxKind.null_expression) {
        if (expected_type >= context->types.type_count ||
            (context::type_record(context, expected_type).kind != type_info::Kind.pointer &&
                context::type_record(context, expected_type).kind != type_info::Kind.function_pointer)) {
            context::add_diagnostic(
                context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span, context::no_id(),
                context::empty_span(), expected_type);
            return base::invalid_expression();
        }
        return builder::emit_null_constant(context, node, expected_type);
    }
    if (node.kind == syntax::SyntaxKind.name_expression) {
        return access::lower_name(context, node, expected_type);
    }
    if (node.kind == syntax::SyntaxKind.this_expression) {
        return access::lower_this(context, node);
    }
    if (node.kind == syntax::SyntaxKind.parenthesized_expression) {
        if (node.child_count != 1) {
            return base::invalid_expression();
        }
        return lower_expression(context, node.first_child, expected_type);
    }
    if (node.kind == syntax::SyntaxKind.call_expression) {
        return access::lower_call(context, node_id, node, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.intrinsic_expression) {
        let intrinsic: usize = intrinsics::intrinsic_resolve(context, node);
        if (intrinsic == context::no_id()) {
            return base::invalid_expression();
        }
        if (intrinsics::intrinsic_entry(intrinsic).operand_class == intrinsics::IntrinsicOperandClass.embedded_file) {
            // @embed needs the argument's syntax node (string decoding lives here, and the import
            // order forbids intrinsics.la from reaching it), so it lowers before the operands.
            return strings::lower_embed(context, node);
        }
        if (intrinsics::intrinsic_entry(intrinsic).operand_class == intrinsics::IntrinsicOperandClass.rtti) {
            let source: context::Expression = node.child_count == 0 ? base::invalid_expression() :
                lower_expression(context, node.first_child, context::no_id());
            return intrinsics::lower_rtti_intrinsic(context, node, intrinsic, source);
        }
        if (intrinsics::intrinsic_entry(intrinsic).operand_class == intrinsics::IntrinsicOperandClass.type_property) {
            return lower_type_property(context, node);
        }
        var operand: context::Expression = base::invalid_expression();
        if (node.child_count != 0) {
            operand = lower_expression(context, node.first_child, context::no_id());
        }
        var count: context::Expression = base::invalid_expression();
        var destination: context::Expression = base::invalid_expression();
        if (operand.valid && node.child_count >= 2) {
            let second: usize = context::node(context, context->current_unit, node.first_child).next_sibling;
            count = lower_expression(
                context, second, node.child_count == 3 ? operand.type_id : type_info::BuiltinType.unsigned_size as usize
            );
            if (count.valid && node.child_count == 3) {
                destination = lower_expression(
                    context, context::node(context, context->current_unit, second).next_sibling, context::no_id());
            }
        }
        return intrinsics::lower_intrinsic(context, node, intrinsic, operand, count, destination);
    }
    if (node.kind == syntax::SyntaxKind.index_expression) {
        return access::lower_index(context, node, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.member_expression) {
        return access::lower_member(context, node, expected_type, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.unary_expression) {
        return operators::lower_unary(context, node_id, node, expected_type, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.cast_expression) {
        return operators::lower_cast(context, node, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.binary_expression) {
        return operators::lower_binary(context, node_id, node, expected_type, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.conditional_expression) {
        return operators::lower_conditional(context, node, expected_type, lower_into, lower_into_destination);
    }
    if (node.kind == syntax::SyntaxKind.zero_initializer || node.kind == syntax::SyntaxKind.aggregate_initializer) {
        return initializer::lower_initializer(context, node_id, expected_type, lower_into_destination);
    }
    if (node.kind == syntax::SyntaxKind.sizeof_expression || node.kind == syntax::SyntaxKind.alignof_expression ||
        node.kind == syntax::SyntaxKind.offsetof_expression) {
        return operators::lower_layout_query(context, node, lower_into);
    }
    if (node.kind == syntax::SyntaxKind.va_arg_expression) {
        return operators::lower_va_arg(context, node, lower_into);
    }
    context::add_diagnostic(
        context, context::DiagnosticKind.internal_invariant, context->current_unit, node.span, context::no_id(),
        context::empty_span(), node.kind as usize);
    return base::invalid_expression();
}

fn lower_expression_into(
    context: *context::Context, node_id: usize, expected_type: usize, destination: usize) -> context::Expression {
    let node: syntax::SyntaxNode = context::node(context, context->current_unit, node_id);
    let expected: type_info::Record = context::type_record(context, expected_type);
    let class_result: bool = expected.kind == type_info::Kind.class_type;
    let nontrivial_result: bool = !functions::type_is_trivially_copyable(context, expected_type);
    let semantic_object: bool = class_result || nontrivial_result;
    if (node.kind == syntax::SyntaxKind.call_expression) {
        let result: probe::Result = probe::expression(context, node_id, expected_type);
        let type_matches: bool = result.status == probe::Status.compatible && result.type_id == expected_type;
        let direct_result: bool = type_matches && category::is_temporary(result.category);
        if (direct_result && semantic_object) {
            return access::lower_call_into(context, node_id, node, destination, expected_type, lower_into);
        }
    }
    if (node.kind == syntax::SyntaxKind.conditional_expression && semantic_object) {
        return operators::lower_conditional_into(
            context, node, expected_type, destination, lower_into, lower_into_destination);
    }
    let initializer: bool = node.kind == syntax::SyntaxKind.zero_initializer ||
        node.kind == syntax::SyntaxKind.aggregate_initializer;
    if (initializer && semantic_object) {
        return initializer::lower_initializer_into(
            context, node_id, expected_type, destination, lower_into_destination);
    }
    let source: context::Expression = lower_expression(context, node_id, expected_type);
    if (!source.valid || source.type_id != expected_type) {
        return source;
    }
    if (expected.kind == type_info::Kind.class_type) {
        return access::lower_special_construction(context, node, destination, expected_type, source);
    }
    if (type_info::is_memory(expected.kind) && nontrivial_result) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span,
            context::no_id(), context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    return source;
}

fn lower_into(context: *context::Context, node_id: usize, expected_type: usize, result: *context::Expression) -> void {
    if (result != null) {
        *result = lower_expression(context, node_id, expected_type);
    }
}

fn lower_unary(context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression {
    return operators::lower_unary(context, context::no_id(), node, expected_type, lower_into);
}
