module luna.bootstrap.middleend.semantic.expr.access;

import luna.bootstrap.middleend.semantic.context.builder as builder;

import luna.bootstrap.middleend.semantic.classes as classes;
import luna.bootstrap.middleend.semantic.expr.base as base;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.bootstrap.middleend.semantic.lifetime as lifetime;
import luna.bootstrap.middleend.semantic.types as types;
import luna.compiler.ir as ir;
import luna.compiler.lexer as lexer;
import luna.compiler.sema.domain as domain;
import luna.compiler.types as type_info;
import luna.runtime as runtime;
import luna.std.bytes as bytes;

fn function_value(context: *context::Context, node: syntax::SyntaxNode, function_id: usize) -> context::Expression {
    let none: usize = context::no_id();
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[function_id];
    var parameter_types: bytes::Buffer = bytes::empty();
    for (var index: usize = 0;
        index < function.parameter_count && context->error == runtime::Error.none;
        index += 1) {
        let parameters: *const context::Parameter = context->parameters.data as
                *const context::Parameter;
        let parameter_type: usize = parameters[function.first_parameter + index].type_id;
        let appended: bytes::BufferResult =
            bytes::append(parameter_types, (&parameter_type) as *const usize as *const u8, sizeof(usize));
        parameter_types = appended.buffer;
        context->error = appended.error;
    }
    if (context->error != runtime::Error.none) {
        let release_error: runtime::Error = bytes::release(parameter_types);
        if (context->error == runtime::Error.none) {
            context->error = release_error;
        }
        return base::invalid_expression();
    }
    let parameters: *const usize = parameter_types.data as *const usize;
    let pointer_type: usize =
        context::function_pointer_type(context, function.return_type, parameters, function.parameter_count);
    let release_error: runtime::Error = bytes::release(parameter_types);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (pointer_type == none || function.ir_function == none) {
        return base::invalid_expression();
    }
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.function_address, node);
    instruction.auxiliary = function.ir_function;
    let value_id: usize = builder::emit_value(context, instruction, pointer_type);
    return {
        type_id = pointer_type, value_id = value_id, address_id = none, constant_value = 0, has_constant = false,
        category = domain::ValueCategory.rvalue, valid = value_id != none, bitfield_segment = context::no_id(),
    };
}

fn add_callable_diagnostic(
    context: *context::Context, kind: context::DiagnosticKind, node: syntax::SyntaxNode, binding_id: usize) {
    let none: usize = context::no_id();
    var related_unit: usize = none;
    var related_span: lexer::SourceSpan = context::empty_span();
    if (binding_id < context->binding_count) {
        let bindings: *const context::Binding = context->bindings.data as
                *const context::Binding;
        let candidate_count: usize = bindings[binding_id].candidate_count;
        for (var candidate_index: usize = 0; candidate_index < candidate_count; candidate_index += 1) {
            let function_id: usize = functions::binding_candidate(context, binding_id, candidate_index);
            if (functions::function_is_visible(context, function_id, context->current_unit)) {
                let functions_data: *const context::Function = context->functions.data as
                        *const context::Function;
                let symbols: *const context::Symbol = context->symbols.symbol_data() as
                        *const context::Symbol;
                let symbol: context::Symbol = symbols[functions_data[function_id].symbol_id];
                related_unit = symbol.declaration_unit;
                related_span = context::node(context, related_unit, symbol.declaration_node).span;
                break;
            }
        }
    }
    context::add_diagnostic(context, kind, context->current_unit, node.span, related_unit, related_span, binding_id);
}

fn function_binding_value(
    context: *context::Context, node: syntax::SyntaxNode, binding_id: usize,
    expected_type: usize) -> context::Expression {
    let resolution: probe::Resolution = probe::resolve_function_value(context, binding_id, node, expected_type);
    if (resolution.status != probe::ResolutionStatus.selected) {
        let kind: context::DiagnosticKind = resolution.status == probe::ResolutionStatus.ambiguous ?
            context::DiagnosticKind.ambiguous_function_value : context::DiagnosticKind.no_matching_overload;
        add_callable_diagnostic(context, kind, node, binding_id);
        return base::invalid_expression();
    }
    return function_value(context, node, resolution.function_id);
}

// Emits the resolved value of a module-level constant symbol (flat or
// qualified lookup), mirroring the literal lowering of a local constant.
fn emit_symbol_constant(context: *context::Context, node: syntax::SyntaxNode, symbol_id: usize) -> context::Expression {
    let symbols: *const context::Symbol = context->symbols.symbol_data() as *const context::Symbol;
    let type_id: usize = symbols[symbol_id].type_id;
    let value: u64 = symbols[symbol_id].integer_value;
    if (type_id == (type_info::BuiltinType.boolean as usize)) {
        return builder::emit_boolean_constant(context, node, value != 0);
    }
    let kind: type_info::Kind = context::type_record(context, type_id).kind;
    return builder::emit_integer_constant(
        context, node, type_id, builder::mask_integer(value, type_info::bit_width(kind)));
}

fn lower_const_name(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression {
    let none: usize = context::no_id();
    if (node.child_count != 0) {
        // Qualified `qual::name`: only a module-level constant of the named
        // module applies; the lookup diagnoses failures itself.
        let qualified_symbol: usize =
            context->symbols.lookup_qualified_symbol(
                context, context->current_unit, node, context::SymbolKind.constant, true).value;
        if (qualified_symbol == none) {
            return base::invalid_expression();
        }
        return emit_symbol_constant(context, node, qualified_symbol);
    }
    var type_id: usize = none;
    var value: u64 = 0;
    let local_id: usize = builder::find_local(context, context->current_unit, node.token_index);
    if (local_id != none) {
        let locals: *const context::Local = context->locals.data as *const context::Local;
        let local: context::Local = locals[local_id];
        if (!local.constant_binding) {
            return base::invalid_expression();
        }
        type_id = local.type_id;
        value = local.integer_value;
    } else {
        let symbol_id: usize = context->symbols.lookup_symbol(
            context, context->current_unit, node.token_index, context::SymbolKind.constant).value;
        if (symbol_id == none) {
            return base::invalid_expression();
        }
        let symbols: *const context::Symbol = context->symbols.symbol_data() as *const context::Symbol;
        type_id = symbols[symbol_id].type_id;
        value = symbols[symbol_id].integer_value;
    }
    if (type_id == (type_info::BuiltinType.boolean as usize)) {
        return builder::emit_boolean_constant(context, node, value != 0);
    }
    let kind: type_info::Kind = context::type_record(context, type_id).kind;
    return builder::emit_integer_constant(
        context, node, type_id, builder::mask_integer(value, type_info::bit_width(kind)));
}

// Lowers a qualified `qual::name` expression: constant first, then function,
// probing quietly so a name found under either kind yields exactly one
// result; only a total miss re-runs the diagnosing lookup to report the
// qualifier or name failure once.
fn lower_qualified_name(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression {
    let none: usize = context::no_id();
    var symbol_id: usize =
        context->symbols.lookup_qualified_symbol(
            context, context->current_unit, node, context::SymbolKind.constant, false).value;
    if (symbol_id != none) {
        return emit_symbol_constant(context, node, symbol_id);
    }
    let binding_id: usize = functions::lookup_qualified_callable_binding(context, context->current_unit, node, false);
    if (binding_id != none) {
        return function_binding_value(context, node, binding_id, expected_type);
    }
    context->symbols.lookup_qualified_symbol(context, context->current_unit, node, context::SymbolKind.constant, true);
    return base::invalid_expression();
}

fn lower_name(context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> context::Expression {
    if (node.child_count != 0) {
        return lower_qualified_name(context, node, expected_type);
    }
    let const_name: context::Expression = lower_const_name(context, node);
    if (const_name.valid) {
        return const_name;
    }
    let local_id: usize = builder::find_local(context, context->current_unit, node.token_index);
    if (local_id == context::no_id()) {
        let binding_id: usize = functions::lookup_callable_binding(context, context->current_unit, node.token_index);
        if (binding_id != context::no_id()) {
            return function_binding_value(context, node, binding_id, expected_type);
        }
        context::add_diagnostic(
            context, context::DiagnosticKind.unknown_name, context->current_unit, node.span, context::no_id(),
            context::empty_span(), node.token_index);
        return base::invalid_expression();
    }
    let locals: *const context::Local = context->locals.data as
            *const context::Local;
    let local: context::Local = locals[local_id];
    let address_id: usize = builder::address_of_slot(
        context, node, local.slot_id, local.type_id, !local.mutable_binding, local.volatile_binding);
    let expression: context::Expression = {
        type_id = local.type_id, value_id = context::no_id(), address_id = address_id, constant_value = 0,
        has_constant = false, category = domain::lvalue(local.mutable_binding, local.volatile_binding),
        valid = address_id != context::no_id(), bitfield_segment = context::no_id(),
    };
    let loaded: context::Expression = builder::load_lvalue(context, node, expression);
    let local_type: type_info::Record = context::type_record(context, local.type_id);
    if (local_type.kind != type_info::Kind.reference || !loaded.valid) {
        return loaded;
    }
    let read_only: bool = (local_type.flags & (type_info::Flag.read_only as usize)) != 0;
    let rvalue: bool = (local_type.flags & (type_info::Flag.rvalue_reference as usize)) != 0;
    let address_type: usize = pointer_type(context, local_type.element_type, read_only);
    let target_address: usize = convert_value(context, node, loaded.value_id, address_type);
    let result: context::Expression = {
        type_id = local_type.element_type, value_id = context::no_id(), address_id = target_address,
        constant_value = 0, has_constant = false,
        category = rvalue ? domain::xvalue(read_only) : domain::lvalue(!read_only, false),
        valid = target_address != context::no_id(), bitfield_segment = context::no_id(),
    };
    return builder::load_lvalue(context, node, result);
}

fn lower_this(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression {
    let none: usize = context::no_id();
    if (context->current_function >= context->function_count) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_receiver, context->current_unit, node.span, none,
            context::empty_span(), none);
        return base::invalid_expression();
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[context->current_function];
    if (!domain::has_receiver(function.identity)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_receiver, context->current_unit, node.span, none,
            context::empty_span(), context->current_function);
        return base::invalid_expression();
    }
    let receiver_type: usize = functions::function_receiver_type(context, function);
    let ir_functions: *const ir::Function = context->ir.view().functions as
            *const ir::Function;
    let ir_function: ir::Function = ir_functions[function.ir_function];
    let ir_parameters: *const ir::Parameter = context->ir.view().parameters as
            *const ir::Parameter;
    let receiver: ir::Parameter = ir_parameters[ir_function.first_parameter];
    let address_id: usize = builder::address_of_slot(context, node, receiver.slot_id, receiver_type, true, false);
    let expression: context::Expression = {
        type_id = receiver_type, value_id = none, address_id = address_id, constant_value = 0,
        has_constant = false, category = domain::ValueCategory.read_only_lvalue,
        valid = address_id != none, bitfield_segment = none,
    };
    return builder::load_lvalue(context, node, expression);
}

fn lower_enum_member(context: *context::Context, node: syntax::SyntaxNode) -> context::Expression {
    if (node.child_count != 2) {
        return base::invalid_expression();
    }
    let owner_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let member_node: syntax::SyntaxNode = context::node(context, context->current_unit, owner_node.next_sibling);
    if (owner_node.kind != syntax::SyntaxKind.name_expression || member_node.kind !=
            syntax::SyntaxKind.name_expression) {
        return base::invalid_expression();
    }
    let type_symbol: usize =
        context->symbols.lookup_qualified_symbol(
            context, context->current_unit, owner_node, context::SymbolKind.named_type, false).value;
    if (type_symbol == context::no_id()) {
        return base::invalid_expression();
    }
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    var type_id: usize = symbols[type_symbol].type_id;
    let alias_record: type_info::Record = context::type_record(context, type_id);
    if (alias_record.kind == type_info::Kind.alias &&
        types::require_complete_type(
            context, type_id)) {
        type_id = context::type_record(context, type_id).element_type;
    }
    if (context::type_record(
            context, type_id).kind != type_info::Kind.enumeration) {
        return base::invalid_expression();
    }
    let member_symbol: usize =
        types::find_enum_member(context, type_id, context->current_unit, member_node.token_index);
    if (member_symbol == context::no_id()) {
        context::add_diagnostic(
            context, context::DiagnosticKind.unknown_field, context->current_unit, member_node.span, context::no_id(),
            context::empty_span(), type_id);
        return base::invalid_expression();
    }
    return builder::emit_integer_constant(context, node, type_id, symbols[member_symbol].integer_value);
}

fn emit_integer_binary(
    context: *context::Context, node: syntax::SyntaxNode, operation: lexer::TokenKind, type_id: usize, left: usize,
    right: usize) -> usize {
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.binary_integer, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return builder::emit_value(context, instruction, type_id);
}

fn emit_integer_shift(
    context: *context::Context, node: syntax::SyntaxNode, operation: lexer::TokenKind, type_id: usize, value: usize,
    amount: usize) -> usize {
    let count: context::Expression = builder::emit_integer_constant(context, node, type_id, amount as u64);
    return emit_integer_binary(context, node, operation, type_id, value, count.value_id);
}

fn emit_integer_mask(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, value: usize, mask: u64) -> usize {
    let mask_expression: context::Expression = builder::emit_integer_constant(context, node, type_id, mask);
    return emit_integer_binary(context, node, lexer::TokenKind.ampersand, type_id, value, mask_expression.value_id);
}

fn bitfield_bit_mask(bits: usize) -> u64 {
    return builder::mask_integer(0xFFFFFFFFFFFFFFFF, bits);
}

// (raw >> offset) & mask(width) for unsigned storage; signed storage shifts
// the segment to the top of the word and arithmetic-shifts it back down so
// the segment's own sign bit extends.
fn emit_bitfield_extract(
    context: *context::Context, node: syntax::SyntaxNode, type_id: usize, raw: usize, bit_offset: usize,
    bit_width: usize) -> usize {
    let record: type_info::Record = context::type_record(context, type_id);
    let width: usize = type_info::bit_width(record.kind);
    var value: usize = raw;
    if (type_info::is_signed_integer(record.kind)) {
        if (bit_offset + bit_width < width) {
            value = emit_integer_shift(
                context, node, lexer::TokenKind.shift_left, type_id, value, width - bit_offset - bit_width);
        }
        if (bit_width < width) {
            value = emit_integer_shift(context, node, lexer::TokenKind.shift_right, type_id, value, width - bit_width);
        }
        return value;
    }
    if (bit_offset > 0) {
        value = emit_integer_shift(context, node, lexer::TokenKind.shift_right, type_id, value, bit_offset);
    }
    if (bit_width < width) {
        value = emit_integer_mask(context, node, type_id, value, bitfield_bit_mask(bit_width));
    }
    return value;
}

fn lower_bitfield_member(
    context: *context::Context, node: syntax::SyntaxNode, owner_address: usize,
    segment_id: usize, member_category: domain::ValueCategory) -> context::Expression {
    let none: usize = context::no_id();
    let segment: context::BitfieldSegment = builder::bitfield_segment(context, segment_id);
    let field_id: usize = builder::bitfield_storage_field(context, segment);
    if (field_id == none) {
        return base::invalid_expression();
    }
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    let field: type_info::Field = fields[field_id];
    let pointer: type_info::IdResult = context->types.pointer(field.type_id, !domain::is_writable(member_category),
            domain::is_volatile(member_category));
    context->error = pointer.error;
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.member_address, node);
    instruction.left = owner_address;
    instruction.auxiliary = field.offset_bytes;
    let address_id: usize = builder::emit_value(context, instruction, pointer.type_id);
    let loaded: context::Expression =
        builder::load_lvalue(
            context, node, {
                type_id = field.type_id, value_id = none, address_id = address_id, constant_value = 0,
                has_constant = false, category = member_category, valid = address_id != none, bitfield_segment = none,
            });
    if (!loaded.valid) {
        return base::invalid_expression();
    }
    let extracted: usize =
        emit_bitfield_extract(context, node, field.type_id, loaded.value_id, segment.bit_offset, segment.bit_width);
    return {
        type_id = field.type_id, value_id = extracted, address_id = address_id, constant_value = 0,
        has_constant = false, category = domain::as_bitfield(member_category),
        valid = extracted != none, bitfield_segment = segment_id,
    };
}

// Read-modify-write of the storage field: load the raw word, clear the
// segment's bits, insert the new value masked to its width, store back.
fn store_bitfield(
    context: *context::Context, node: syntax::SyntaxNode, destination: usize, segment_id: usize,
    value: context::Expression) -> bool {
    let none: usize = context::no_id();
    let segment: context::BitfieldSegment = builder::bitfield_segment(context, segment_id);
    let field_id: usize = builder::bitfield_storage_field(context, segment);
    let destination_is_valid: bool = field_id != none && destination != none;
    if (!value.valid || !destination_is_valid) {
        return false;
    }
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    let field: type_info::Field = fields[field_id];
    if (value.type_id != field.type_id) {
        return false;
    }
    let record: type_info::Record = context::type_record(context, field.type_id);
    let width: usize = type_info::bit_width(record.kind);
    var load_instruction: ir::Instruction = builder::instruction(ir::Opcode.load_indirect, node);
    load_instruction.left = destination;
    let raw: usize = builder::emit_value(context, load_instruction, field.type_id);
    if (raw == none) {
        return false;
    }
    var inserted: usize = value.value_id;
    if (segment.bit_width < width) {
        inserted = emit_integer_mask(context, node, field.type_id, inserted, bitfield_bit_mask(segment.bit_width));
    }
    if (segment.bit_offset > 0) {
        inserted = emit_integer_shift(
            context, node, lexer::TokenKind.shift_left, field.type_id, inserted, segment.bit_offset);
    }
    var combined: usize = inserted;
    if (segment.bit_offset != 0 || segment.bit_width != width) {
        let clear_mask: u64 = builder::mask_integer(
            bitfield_bit_mask(width) ^
                (bitfield_bit_mask(
                    segment.bit_width) << (segment.bit_offset as u64)), width);
        let cleared: usize = emit_integer_mask(context, node, field.type_id, raw, clear_mask);
        combined = emit_integer_binary(context, node, lexer::TokenKind.pipe, field.type_id, cleared, inserted);
    }
    var store_instruction: ir::Instruction = builder::instruction(ir::Opcode.store_indirect, node);
    store_instruction.left = destination;
    store_instruction.right = combined;
    store_instruction.type_id = field.type_id;
    store_instruction.auxiliary = record.size_bytes;
    return builder::emit_void(context, store_instruction) != none;
}

fn bound_method_entry(
    context: *context::Context, node: syntax::SyntaxNode, target: probe::CallTarget,
    function_id: usize, receiver_address: usize) -> usize {
    let functions_data: *const context::Function = context->functions.data as *const context::Function;
    let function: context::Function = functions_data[function_id];
    let plan: domain::DispatchPlan = classes::dispatch_plan(
        context, target.owner_type, function_id, call_has_exact_dynamic_type(context, target));
    if (plan.kind == domain::CallDispatch.virtual_call) {
        return load_virtual_callee(context, node, plan, function, receiver_address);
    }
    if (classes::method_is_abstract(context, function_id)) {
        return context::no_id();
    }
    let function_type: usize = virtual_function_type(context, function);
    if (function_type == context::no_id()) {
        return context::no_id();
    }
    var address: ir::Instruction = builder::instruction(ir::Opcode.function_address, node);
    address.auxiliary = function.ir_function;
    return builder::emit_value(context, address, function_type);
}

fn store_bound_word(
    context: *context::Context, node: syntax::SyntaxNode,
    bound_address: usize, byte_offset: usize, value_id: usize) -> bool {
    let bytes_type: usize = byte_pointer_type(context, false);
    let word_storage_type: usize = pointer_type(context, type_info::BuiltinType.unsigned_size as usize, false);
    let bound_bytes: usize = convert_value(context, node, bound_address, bytes_type);
    let word_bytes: usize = offset_byte_pointer(context, node, bound_bytes, bytes_type, byte_offset);
    let word_storage: usize = convert_value(context, node, word_bytes, word_storage_type);
    let word_value: usize = convert_value(context, node, value_id, type_info::BuiltinType.unsigned_size as usize);
    let value: context::Expression = {
        type_id = type_info::BuiltinType.unsigned_size as usize, value_id = word_value,
        address_id = context::no_id(), constant_value = 0, has_constant = false,
        category = domain::ValueCategory.rvalue, valid = word_value != context::no_id(),
        bitfield_segment = context::no_id(),
    };
    return builder::store_to_address(context, node, word_storage, type_info::BuiltinType.unsigned_size as usize, value);
}

fn lower_bound_method(
    context: *context::Context, node: syntax::SyntaxNode,
    expected_type: usize, lowerer: api::Lowerer) -> context::Expression {
    let none: usize = context::no_id();
    let target: probe::CallTarget = probe::member_value_target(context, node);
    let resolution: probe::Resolution = probe::resolve_bound_method(context, node, expected_type);
    if (!target.valid || resolution.status != probe::ResolutionStatus.selected) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_bound_method, context->current_unit, node.span,
            none, context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    let functions_data: *const context::Function = context->functions.data as *const context::Function;
    let function: context::Function = functions_data[resolution.function_id];
    let receiver_type: usize = functions::function_receiver_type(context, function);
    let receiver_address: usize = instance_receiver_address(context, node, target, receiver_type, lowerer);
    let entry: usize = bound_method_entry(context, node, target, resolution.function_id, receiver_address);
    if (receiver_address == none || entry == none) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_bound_method, context->current_unit, node.span,
            none, context::empty_span(), resolution.function_id);
        return base::invalid_expression();
    }
    let slot_id: usize = context->ir.add_slot(builder::current_ir_function(context), expected_type, true, false, 0);
    let bound_address: usize = builder::address_of_slot(context, node, slot_id, expected_type, false, false);
    let word_bytes: usize = sizeof(usize);
    let receiver_is_stored: bool = store_bound_word(context, node, bound_address, 0, receiver_address);
    let entry_is_stored: bool = store_bound_word(context, node, bound_address, word_bytes, entry);
    if (!receiver_is_stored || !entry_is_stored) {
        return base::invalid_expression();
    }
    return {
        type_id = expected_type, value_id = none, address_id = bound_address, constant_value = 0,
        has_constant = false, category = domain::ValueCategory.temporary, valid = true, bitfield_segment = none,
    };
}

fn lower_member(
    context: *context::Context, node: syntax::SyntaxNode,
    expected_type: usize, lowerer: api::Lowerer) -> context::Expression {
    let enum_member: context::Expression = lower_enum_member(context, node);
    if (enum_member.valid) {
        return enum_member;
    }
    if (expected_type < context->types.size() &&
        context::type_record(context, expected_type).kind == type_info::Kind.bound_method) {
        return lower_bound_method(context, node, expected_type, lowerer);
    }
    if (node.child_count != 2) {
        return base::invalid_expression();
    }
    let base_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let name_node: syntax::SyntaxNode = context::node(context, context->current_unit, base_node.next_sibling);
    let operation: lexer::TokenKind = context::token(context, context->current_unit, node.token_index).kind;
    let base: context::Expression = api::invoke(lowerer, context, node.first_child, context::no_id());
    if (!base.valid) {
        return base;
    }
    var owner_type: usize = base.type_id;
    var owner_address: usize = base.address_id;
    var member_category: domain::ValueCategory = domain::project(base.category);
    if (operation == lexer::TokenKind.arrow) {
        let pointer_record: type_info::Record = context::type_record(context, base.type_id);
        if (pointer_record.kind != type_info::Kind.pointer) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_member, context->current_unit, node.span, context::no_id(),
                context::empty_span(), base.type_id);
            return base::invalid_expression();
        }
        owner_type = pointer_record.element_type;
        owner_address = base.value_id;
        member_category = domain::pointee(pointer_record);
        var check: ir::Instruction = builder::instruction(ir::Opcode.null_check, node);
        check.left = owner_address;
        builder::emit_void(context, check);
    } else if (operation != lexer::TokenKind.dot || base.address_id == context::no_id()) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_member, context->current_unit, node.span, context::no_id(),
            context::empty_span(), base.type_id);
        return base::invalid_expression();
    }
    if (!types::require_complete_type(context, owner_type)) {
        return base::invalid_expression();
    }
    let owner_record: type_info::Record = context::type_record(context, owner_type);
    if (!type_info::is_record(owner_record.kind)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_member, context->current_unit, node.span, context::no_id(),
            context::empty_span(), owner_type);
        return base::invalid_expression();
    }
    if (!types::require_opaque_value_access(
            context, owner_type, context->current_unit, name_node.span)) {
        return base::invalid_expression();
    }
    let lookup: types::FieldLookup =
        types::lookup_field(context, owner_type, context->current_unit, name_node.token_index);
    if (lookup.status == types::FieldStatus.ambiguous) {
        context::add_diagnostic(
            context, context::DiagnosticKind.ambiguous_field, context->current_unit, name_node.span, context::no_id(),
            context::empty_span(), owner_type);
        return base::invalid_expression();
    }
    if (lookup.status != types::FieldStatus.found) {
        let segment_id: usize =
            builder::lookup_bitfield_segment(context, owner_type, context->current_unit, name_node.token_index);
        if (segment_id != context::no_id()) {
            return lower_bitfield_member(context, node, owner_address, segment_id, member_category);
        }
        context::add_diagnostic(
            context, context::DiagnosticKind.unknown_field, context->current_unit, name_node.span, context::no_id(),
            context::empty_span(), owner_type);
        return base::invalid_expression();
    }
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    let field: type_info::Field = fields[lookup.field_id];
    if (owner_record.kind == type_info::Kind.class_type && !classes::field_is_accessible(context, lookup.field_id)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.inaccessible_member, context->current_unit, name_node.span,
            field.declaration_unit, context::node(context, field.declaration_unit, field.declaration_node).span,
            lookup.field_id);
        return base::invalid_expression();
    }
    let field_record: type_info::Record = context::type_record(context, field.type_id);
    if (field_record.kind == type_info::Kind.array && (field_record.flags & (type_info::Flag.flexible as usize)) != 0) {
        // A flexible member access yields *T at the member offset, not an
        // array lvalue; it composes with raw-pointer indexing and arithmetic.
        let element_pointer: type_info::IdResult =
            context->types.pointer(field_record.element_type, !domain::is_writable(member_category),
                domain::is_volatile(member_category));
        context->error = element_pointer.error;
        var flexible_instruction: ir::Instruction = builder::instruction(ir::Opcode.member_address, node);
        flexible_instruction.left = owner_address;
        flexible_instruction.auxiliary = lookup.offset_bytes;
        let flexible_address: usize = builder::emit_value(context, flexible_instruction, element_pointer.type_id);
        return {
            type_id = element_pointer.type_id, value_id = flexible_address, address_id = context::no_id(),
            constant_value = 0, has_constant = false, category = domain::ValueCategory.rvalue,
            valid = flexible_address != context::no_id(), bitfield_segment = context::no_id(),
        };
    }
    let pointer: type_info::IdResult = context->types.pointer(field.type_id, !domain::is_writable(member_category),
            domain::is_volatile(member_category));
    context->error = pointer.error;
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.member_address, node);
    instruction.left = owner_address;
    instruction.auxiliary = lookup.offset_bytes;
    let address_id: usize = builder::emit_value(context, instruction, pointer.type_id);
    let result: context::Expression = {
        type_id = field.type_id, value_id = context::no_id(), address_id = address_id, constant_value = 0,
        has_constant = false, category = member_category,
        valid = address_id != context::no_id(), bitfield_segment = context::no_id(),
    };
    return builder::load_lvalue(context, node, result);
}

fn lower_index(context: *context::Context, node: syntax::SyntaxNode, lowerer: api::Lowerer) -> context::Expression {
    if (node.child_count != 2) {
        return base::invalid_expression();
    }
    let base_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let index_node: usize = base_node.next_sibling;
    let base: context::Expression = api::invoke(lowerer, context, node.first_child, context::no_id());
    let index: context::Expression = api::invoke(lowerer, context, index_node,
        type_info::BuiltinType.unsigned_size as usize);
    let operands_are_valid: bool = base.valid && index.valid;
    if (!operands_are_valid || index.type_id != type_info::BuiltinType.unsigned_size as usize) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_index, context->current_unit, node.span, context::no_id(),
            context::empty_span(), index.type_id);
        return base::invalid_expression();
    }
    let base_record: type_info::Record = context::type_record(context, base.type_id);
    var element_type: usize = context::no_id();
    var base_address: usize = context::no_id();
    var element_category: domain::ValueCategory = domain::ValueCategory.rvalue;
    if (base_record.kind == type_info::Kind.array && base.address_id != context::no_id()) {
        element_type = base_record.element_type;
        base_address = base.address_id;
        element_category = domain::project(base.category);
        let bound: context::Expression =
            builder::emit_integer_constant(
                context, node, type_info::BuiltinType.unsigned_size as usize, base_record.element_count as u64);
        var check: ir::Instruction = builder::instruction(ir::Opcode.bounds_check, node);
        check.left = index.value_id;
        check.right = bound.value_id;
        builder::emit_void(context, check);
    } else if (base_record.kind == type_info::Kind.pointer) {
        element_type = base_record.element_type;
        base_address = base.value_id;
        element_category = domain::pointee(base_record);
        if (context::type_record(
                context, element_type).kind == type_info::Kind.type_void) {
            element_type = context::no_id();
        } else {
            var check: ir::Instruction = builder::instruction(ir::Opcode.null_check, node);
            check.left = base_address;
            builder::emit_void(context, check);
        }
    }
    if (element_type == context::no_id()) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_index, context->current_unit, node.span, context::no_id(),
            context::empty_span(), base.type_id);
        return base::invalid_expression();
    }
    if (!types::require_opaque_value_access(
            context, element_type, context->current_unit, node.span)) {
        return base::invalid_expression();
    }
    let element_record: type_info::Record = context::type_record(context, element_type);
    let pointer: type_info::IdResult = context->types.pointer(element_type, !domain::is_writable(element_category),
            domain::is_volatile(element_category));
    context->error = pointer.error;
    var offset: ir::Instruction = builder::instruction(ir::Opcode.pointer_offset, node);
    offset.left = base_address;
    offset.right = index.value_id;
    offset.auxiliary = element_record.size_bytes;
    let address_id: usize = builder::emit_value(context, offset, pointer.type_id);
    let result: context::Expression = {
        type_id = element_type, value_id = context::no_id(), address_id = address_id, constant_value = 0,
        has_constant = false, category = element_category,
        valid = address_id != context::no_id(), bitfield_segment = context::no_id(),
    };
    return builder::load_lvalue(context, node, result);
}

fn resolve_selected_function(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode, target: probe::CallTarget) -> usize {
    let resolution: probe::Resolution = probe::resolve_call_target(context, node_id, node, target);
    if (resolution.status == probe::ResolutionStatus.selected) {
        return resolution.function_id;
    }
    let visible_count: usize = probe::call_target_visible_count(context, target);
    let inaccessible: bool = target.owner_type != context::no_id() && visible_count == 0;
    let kind: context::DiagnosticKind = inaccessible ? context::DiagnosticKind.inaccessible_member :
        (resolution.status == probe::ResolutionStatus.ambiguous ?
            context::DiagnosticKind.ambiguous_call : context::DiagnosticKind.no_matching_overload);
    add_callable_diagnostic(context, kind, node, target.binding_id);
    return context::no_id();
}

fn append_call_argument(context: *context::Context, values: *bytes::Buffer, value: usize) -> bool {
    let appended: bytes::BufferResult = bytes::append(*values, (&value) as *const usize as *const u8, sizeof(usize));
    *values = appended.buffer;
    context->error = appended.error;
    return appended.error == runtime::Error.none;
}

fn call_argument_value(context: *context::Context, node: syntax::SyntaxNode, argument: context::Expression) -> usize {
    let argument_type: type_info::Record = context::type_record(context, argument.type_id);
    if (!type_info::is_memory(argument_type.kind)) {
        return argument.value_id;
    }
    let snapshot_slot: usize = context->ir.add_slot(builder::current_ir_function(context), argument.type_id, true,
        false, 0);
    let snapshot_address: usize = builder::address_of_slot(
        context, node, snapshot_slot, argument.type_id, false, false);
    let snapshot_is_valid: bool = snapshot_slot != context::no_id() && snapshot_address != context::no_id();
    if (!snapshot_is_valid) {
        return context::no_id();
    }
    let class_argument: bool = argument_type.kind == type_info::Kind.class_type;
    let nontrivial_argument: bool = !functions::type_is_trivially_copyable(context, argument.type_id);
    let semantic_argument: bool = class_argument || nontrivial_argument;
    if (semantic_argument && !builder::zero_slot(context, node, snapshot_slot, argument.type_id)) {
        return context::no_id();
    }
    if (argument_type.kind == type_info::Kind.class_type) {
        let constructed: context::Expression = lower_special_construction(
            context, node, snapshot_address, argument.type_id, argument);
        if (!constructed.valid) {
            return context::no_id();
        }
        if (constructed.address_id == snapshot_address) {
            return snapshot_address;
        }
    }
    if (!functions::type_is_trivially_copyable(context, argument.type_id)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span,
            context::no_id(), context::empty_span(), argument.type_id);
        return context::no_id();
    }
    return builder::store_to_address(context, node, snapshot_address, argument.type_id, argument) ?
        snapshot_address : context::no_id();
}

fn collect_fixed_call_argument(
    context: *context::Context, node: syntax::SyntaxNode, argument: context::Expression,
    parameter_type: usize, values: *bytes::Buffer) {
    let parameter: type_info::Record = context::type_record(context, parameter_type);
    if (parameter.kind == type_info::Kind.reference) {
        let binding_rank: usize = domain::reference_binding_rank(parameter, argument.category);
        let type_matches: bool = argument.valid && argument.type_id == parameter.element_type;
        if (!type_matches || binding_rank == type_info::no_id()) {
            context::add_diagnostic(
                context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span,
                context::no_id(), context::empty_span(), parameter_type);
            return;
        }
        let value: usize = convert_value(context, node, argument.address_id, parameter_type);
        if (value == context::no_id()) {
            context->error = runtime::Error.invalid_argument;
            return;
        }
        append_call_argument(context, values, value);
        return;
    }
    if (!argument.valid || argument.type_id != parameter_type) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span,
            context::no_id(), context::empty_span(), parameter_type);
        return;
    }
    let value: usize = call_argument_value(context, node, argument);
    if (value == context::no_id()) {
        context->error = runtime::Error.invalid_argument;
        return;
    }
    append_call_argument(context, values, value);
}

fn collect_variadic_call_argument(
    context: *context::Context, node: syntax::SyntaxNode, argument: context::Expression, values: *bytes::Buffer) {
    var scalar: bool = false;
    if (argument.valid) {
        scalar = type_info::is_scalar(context::type_record(context, argument.type_id).kind);
    }
    if (!scalar) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_call, context->current_unit, node.span,
            context::no_id(), context::empty_span(), argument.valid ? argument.type_id : context::no_id());
        return;
    }
    append_call_argument(context, values, argument.value_id);
}

fn default_call_argument(context: *context::Context, parameter: context::Parameter) -> context::Expression {
    if (parameter.default_node == context::no_id()) {
        return base::invalid_expression();
    }
    let node: syntax::SyntaxNode = context::node(context, parameter.unit_index, parameter.default_node);
    switch (parameter.default_kind) {
    case context::ParameterDefaultKind.integer {
        return builder::emit_integer_constant(context, node, parameter.type_id, parameter.default_value);
    }
    case context::ParameterDefaultKind.boolean {
        return builder::emit_boolean_constant(context, node, parameter.default_value != 0);
    }
    case context::ParameterDefaultKind.null_pointer {
        return builder::emit_null_constant(context, node, parameter.type_id);
    }
    default {
        return base::invalid_expression();
    }
    }
}

fn collect_default_call_arguments(
    context: *context::Context, function: context::Function, explicit_count: usize, values: *bytes::Buffer) {
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let parameter_count: usize = functions::function_argument_parameter_count(function);
    let first_parameter: usize = functions::function_first_argument_parameter(function);
    for (var index: usize = explicit_count;
        index < parameter_count && context->error == runtime::Error.none;
        index += 1) {
        let parameter: context::Parameter = parameters[first_parameter + index];
        if (parameter.default_node == context::no_id()) {
            context->error = runtime::Error.invalid_argument;
            return;
        }
        let argument: context::Expression = default_call_argument(context, parameter);
        let node: syntax::SyntaxNode = context::node(context, parameter.unit_index, parameter.default_node);
        collect_fixed_call_argument(context, node, argument, parameter.type_id, values);
    }
}

fn call_parameter_type(
    parameters: *const context::Parameter, fields: *const type_info::Field,
    first_parameter: usize, index: usize, parameters_from_fields: bool) -> usize {
    return parameters_from_fields ? fields[first_parameter + index].type_id :
        parameters[first_parameter + index].type_id;
}

fn convert_value(context: *context::Context, node: syntax::SyntaxNode, value_id: usize, target_type: usize) -> usize {
    if (value_id == context::no_id()) {
        return context::no_id();
    }
    let values: *const ir::Value = context->ir.view().values as *const ir::Value;
    let source_type: usize = values[value_id].type_id;
    if (source_type == target_type) {
        return value_id;
    }
    var conversion: ir::Instruction = builder::instruction(ir::Opcode.convert, node);
    conversion.left = value_id;
    conversion.auxiliary = source_type;
    return builder::emit_value(context, conversion, target_type);
}

fn pointer_type(context: *context::Context, element_type: usize, read_only: bool) -> usize {
    if (context->error != runtime::Error.none) {
        return context::no_id();
    }
    let result: type_info::IdResult = context->types.pointer(element_type, read_only, false);
    context->error = result.error;
    return result.error == runtime::Error.none ? result.type_id : context::no_id();
}

fn byte_pointer_type(context: *context::Context, read_only: bool) -> usize {
    return pointer_type(context, type_info::BuiltinType.unsigned_8 as usize, read_only);
}

fn offset_byte_pointer(
    context: *context::Context, node: syntax::SyntaxNode,
    pointer_value: usize, pointer_type_id: usize, byte_offset: usize) -> usize {
    if (pointer_value == context::no_id() || pointer_type_id == context::no_id()) {
        return context::no_id();
    }
    if (byte_offset == 0) {
        return pointer_value;
    }
    let offset: context::Expression = builder::emit_integer_constant(
        context, node, type_info::BuiltinType.unsigned_size as usize, byte_offset as u64);
    if (!offset.valid) {
        return context::no_id();
    }
    let byte_size: usize = context::type_record(context, type_info::BuiltinType.unsigned_8 as usize).size_bytes;
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.pointer_offset, node);
    instruction.left = pointer_value;
    instruction.right = offset.value_id;
    instruction.auxiliary = byte_size;
    return builder::emit_value(context, instruction, pointer_type_id);
}

fn load_indirect_value(
    context: *context::Context, node: syntax::SyntaxNode, address: usize, value_type: usize) -> usize {
    if (address == context::no_id() || value_type == context::no_id()) {
        return context::no_id();
    }
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.load_indirect, node);
    instruction.left = address;
    return builder::emit_value(context, instruction, value_type);
}

fn load_bound_word(
    context: *context::Context, node: syntax::SyntaxNode, bound_address: usize, byte_offset: usize) -> usize {
    let bytes_type: usize = byte_pointer_type(context, true);
    let word_storage_type: usize = pointer_type(context, type_info::BuiltinType.unsigned_size as usize, true);
    let bound_bytes: usize = convert_value(context, node, bound_address, bytes_type);
    let word_bytes: usize = offset_byte_pointer(context, node, bound_bytes, bytes_type, byte_offset);
    let word_storage: usize = convert_value(context, node, word_bytes, word_storage_type);
    return load_indirect_value(context, node, word_storage, type_info::BuiltinType.unsigned_size as usize);
}

fn bound_call_type(context: *context::Context, bound_type: usize) -> usize {
    let record: type_info::Record = context::type_record(context, bound_type);
    if (record.kind != type_info::Kind.bound_method) {
        return context::no_id();
    }
    var parameter_types: bytes::Buffer = bytes::empty();
    let receiver_type: usize = type_info::BuiltinType.unsigned_size as usize;
    let receiver: bytes::BufferResult = bytes::append(
        parameter_types, (&receiver_type) as *const usize as *const u8, sizeof(usize));
    parameter_types = receiver.buffer;
    context->error = receiver.error;
    let fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
    for (var index: usize = 0;
        index < record.field_count && context->error == runtime::Error.none;
        index += 1) {
        let parameter_type: usize = fields[record.first_field + index].type_id;
        let appended: bytes::BufferResult = bytes::append(
            parameter_types, (&parameter_type) as *const usize as *const u8, sizeof(usize));
        parameter_types = appended.buffer;
        context->error = appended.error;
    }
    let parameters: *const usize = parameter_types.data as *const usize;
    let parameter_count: usize = parameter_types.length / sizeof(usize);
    let result: usize = context->error == runtime::Error.none ?
        context::function_pointer_type(context, record.element_type, parameters, parameter_count) : context::no_id();
    let release_error: runtime::Error = bytes::release(parameter_types);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none ? result : context::no_id();
}

fn initialize_class_vptr(
    context: *context::Context, node: syntax::SyntaxNode, owner_type: usize, object_address: usize) -> bool {
    let global_id: usize = classes::vtable_global(context, owner_type);
    if (global_id == context::no_id()) {
        return true;
    }
    let table_pointer: usize = byte_pointer_type(context, true);
    let object_bytes_type: usize = byte_pointer_type(context, false);
    let table_storage_type: usize = pointer_type(context, table_pointer, false);
    let types_are_valid: bool = table_pointer != context::no_id() && object_bytes_type != context::no_id();
    if (!types_are_valid || table_storage_type == context::no_id()) {
        return false;
    }
    var global_address: ir::Instruction = builder::instruction(ir::Opcode.global_address, node);
    global_address.auxiliary = global_id;
    let global_start: usize = builder::emit_value(context, global_address, table_pointer);
    let table_address: usize = offset_byte_pointer(
        context, node, global_start, table_pointer, classes::vtable_slot_offset(context, owner_type));
    let object_bytes: usize = convert_value(context, node, object_address, object_bytes_type);
    let vptr_offset: usize = classes::vptr_offset(context, owner_type);
    let addresses_are_valid: bool = table_address != context::no_id() && object_bytes != context::no_id();
    if (!addresses_are_valid || vptr_offset == context::no_id()) {
        return false;
    }
    let vptr_bytes: usize = offset_byte_pointer(context, node, object_bytes, object_bytes_type, vptr_offset);
    let vptr_storage: usize = convert_value(context, node, vptr_bytes, table_storage_type);
    let table_value: context::Expression = {
        type_id = table_pointer, value_id = table_address, address_id = context::no_id(), constant_value = 0,
        has_constant = false, category = domain::ValueCategory.rvalue,
        valid = table_address != context::no_id(), bitfield_segment = context::no_id(),
    };
    return builder::store_to_address(context, node, vptr_storage, table_pointer, table_value);
}

fn virtual_function_type(context: *context::Context, function: context::Function) -> usize {
    var parameter_types: bytes::Buffer = bytes::empty();
    let receiver_type: usize = functions::function_receiver_type(context, function);
    if (receiver_type == context::no_id()) {
        return context::no_id();
    }
    let receiver_appended: bytes::BufferResult = bytes::append(
        parameter_types, (&receiver_type) as *const usize as *const u8, sizeof(usize));
    parameter_types = receiver_appended.buffer;
    context->error = receiver_appended.error;
    let parameters: *const context::Parameter = context->parameters.data as *const context::Parameter;
    for (var index: usize = 0;
        index < function.parameter_count && context->error == runtime::Error.none;
        index += 1) {
        let type_id: usize = parameters[function.first_parameter + index].type_id;
        let appended: bytes::BufferResult = bytes::append(
            parameter_types, (&type_id) as *const usize as *const u8, sizeof(usize));
        parameter_types = appended.buffer;
        context->error = appended.error;
    }
    let type_ids: *const usize = parameter_types.data as *const usize;
    let parameter_count: usize = parameter_types.length / sizeof(usize);
    let result: usize = context->error == runtime::Error.none ?
        context::function_pointer_type(context, function.return_type, type_ids, parameter_count) : context::no_id();
    let release_error: runtime::Error = bytes::release(parameter_types);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none ? result : context::no_id();
}

fn load_virtual_callee(
    context: *context::Context, node: syntax::SyntaxNode, plan: domain::DispatchPlan,
    function: context::Function, receiver_address: usize) -> usize {
    let byte_pointer: usize = byte_pointer_type(context, true);
    let table_storage_type: usize = pointer_type(context, byte_pointer, true);
    if (byte_pointer == context::no_id() || table_storage_type == context::no_id()) {
        return context::no_id();
    }
    let object_bytes: usize = convert_value(context, node, receiver_address, byte_pointer);
    let vptr_bytes: usize = offset_byte_pointer(context, node, object_bytes, byte_pointer, plan.vptr_offset);
    let vptr_storage: usize = convert_value(context, node, vptr_bytes, table_storage_type);
    let table_address: usize = load_indirect_value(context, node, vptr_storage, byte_pointer);
    var slot_offset: usize = 0;
    let address_bytes: usize = ir::Limit.function_address_bytes as usize;
    if (@mul_overflow(plan.virtual_slot, address_bytes, &slot_offset)) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let slot_bytes: usize = offset_byte_pointer(context, node, table_address, byte_pointer, slot_offset);
    let function_type: usize = virtual_function_type(context, function);
    let function_storage_type: usize = pointer_type(context, function_type, true);
    if (function_type == context::no_id() || function_storage_type == context::no_id()) {
        return context::no_id();
    }
    let function_storage: usize = convert_value(context, node, slot_bytes, function_storage_type);
    return load_indirect_value(context, node, function_storage, function_type);
}

fn call_has_exact_dynamic_type(context: *context::Context, target: probe::CallTarget) -> bool {
    if (target.receiver_source != probe::ReceiverSource.expression) {
        return true;
    }
    return context::type_record(context, target.receiver_type).kind != type_info::Kind.pointer;
}

fn constructor_receiver(
    context: *context::Context, node: syntax::SyntaxNode, owner_type: usize, values: *bytes::Buffer) -> usize {
    let slot_id: usize = context->ir.add_slot(builder::current_ir_function(context), owner_type, true, false, 0);
    let address_id: usize = builder::address_of_slot(context, node, slot_id, owner_type, false, false);
    let storage_is_valid: bool = slot_id != context::no_id() && address_id != context::no_id();
    if (!storage_is_valid || !builder::zero_slot(context, node, slot_id, owner_type)) {
        return context::no_id();
    }
    if (!initialize_class_vptr(context, node, owner_type, address_id)) {
        return context::no_id();
    }
    if (!append_call_argument(context, values, address_id)) {
        return context::no_id();
    }
    return lifetime::register_temporary(context, owner_type, address_id) ? address_id : context::no_id();
}

fn receiver_storage_address(
    context: *context::Context, node: syntax::SyntaxNode, receiver: context::Expression) -> usize {
    if (receiver.address_id == context::no_id()) {
        return context::no_id();
    }
    let values: *const ir::Value = context->ir.view().values as
            *const ir::Value;
    let storage_type: usize = values[receiver.address_id].type_id;
    if (context::type_record(context, storage_type).kind == type_info::Kind.pointer) {
        return receiver.address_id;
    }
    if (storage_type != receiver.type_id) {
        return context::no_id();
    }
    let slot_id: usize = context->ir.add_slot(builder::current_ir_function(context), receiver.type_id, true, false, 0);
    let address_id: usize = builder::address_of_slot(context, node, slot_id, receiver.type_id, false, false);
    let storage_is_valid: bool = slot_id != context::no_id() && address_id != context::no_id();
    if (!storage_is_valid) {
        return context::no_id();
    }
    return builder::store_to_address(context, node, address_id, receiver.type_id, receiver) ?
        address_id : context::no_id();
}

fn instance_receiver_address(
    context: *context::Context, node: syntax::SyntaxNode, target: probe::CallTarget,
    receiver_type: usize, lowerer: api::Lowerer) -> usize {
    let receiver: context::Expression = api::invoke(lowerer, context, target.receiver_node, context::no_id());
    if (!receiver.valid) {
        return context::no_id();
    }
    let access_node: syntax::SyntaxNode = node.kind == syntax::SyntaxKind.call_expression ?
        context::node(context, context->current_unit, node.first_child) : node;
    let operation: lexer::TokenKind = context::token(context, context->current_unit, access_node.token_index).kind;
    var address_id: usize = context::no_id();
    if (operation == lexer::TokenKind.arrow) {
        address_id = receiver.value_id;
        var check: ir::Instruction = builder::instruction(ir::Opcode.null_check, node);
        check.left = address_id;
        builder::emit_void(context, check);
    } else {
        address_id = receiver_storage_address(context, node, receiver);
    }
    if (address_id == context::no_id()) {
        return address_id;
    }
    let ir_values: *const ir::Value = context->ir.view().values as
            *const ir::Value;
    let source_type: usize = ir_values[address_id].type_id;
    if (source_type != receiver_type) {
        var conversion: ir::Instruction = builder::instruction(ir::Opcode.convert, node);
        conversion.left = address_id;
        conversion.auxiliary = source_type;
        address_id = builder::emit_value(context, conversion, receiver_type);
    }
    return address_id;
}

fn instance_receiver(
    context: *context::Context, node: syntax::SyntaxNode, target: probe::CallTarget,
    receiver_type: usize, lowerer: api::Lowerer, values: *bytes::Buffer) -> usize {
    let address_id: usize = instance_receiver_address(context, node, target, receiver_type, lowerer);
    if (address_id == context::no_id()) {
        return address_id;
    }
    return append_call_argument(context, values, address_id) ? address_id : context::no_id();
}

fn current_receiver(
    context: *context::Context, node: syntax::SyntaxNode, receiver_type: usize, values: *bytes::Buffer) -> usize {
    let receiver: context::Expression = lower_this(context, node);
    if (!receiver.valid) {
        return context::no_id();
    }
    var address_id: usize = receiver.value_id;
    let ir_values: *const ir::Value = context->ir.view().values as
            *const ir::Value;
    let source_type: usize = ir_values[address_id].type_id;
    if (source_type != receiver_type) {
        var conversion: ir::Instruction = builder::instruction(ir::Opcode.convert, node);
        conversion.left = address_id;
        conversion.auxiliary = source_type;
        address_id = builder::emit_value(context, conversion, receiver_type);
    }
    return append_call_argument(context, values, address_id) ? address_id : context::no_id();
}

fn collect_direct_receiver(
    context: *context::Context, node: syntax::SyntaxNode, target: probe::CallTarget,
    receiver_type: usize, construction_address: usize, lowerer: api::Lowerer, values: *bytes::Buffer) -> usize {
    switch (target.receiver_source) {
    case probe::ReceiverSource.construction {
        if (construction_address != context::no_id()) {
            return append_call_argument(context, values, construction_address) ?
                construction_address : context::no_id();
        }
        return constructor_receiver(context, node, target.owner_type, values);
    }
    case probe::ReceiverSource.expression {
        if (construction_address != context::no_id()) {
            let adjusted: usize = convert_value(context, node, construction_address, receiver_type);
            if (adjusted == context::no_id()) {
                return context::no_id();
            }
            return append_call_argument(context, values, adjusted) ? adjusted : context::no_id();
        }
        return instance_receiver(context, node, target, receiver_type, lowerer, values);
    }
    case probe::ReceiverSource.current_object {
        return current_receiver(context, node, receiver_type, values);
    }
    default {
        return context::no_id();
    }
    }
}

fn lower_target_call_with_receiver(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode,
    target: probe::CallTarget, receiver_address: usize,
    result_address: usize, expected_result: usize, lowerer: api::Lowerer) -> context::Expression {
    let none: usize = context::no_id();
    if (node.child_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return base::invalid_expression();
    }
    let callee_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    var selected_function: usize = none;
    var callee_value: usize = none;
    var call_dispatch: domain::DispatchPlan = {
        kind = domain::CallDispatch.direct, vptr_offset = none, virtual_slot = none,
    };
    let constructor_is_unbound: bool = target.kind == domain::CallableKind.constructor && !target.valid;
    if (target.receiver_source == probe::ReceiverSource.current_object && !target.valid) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_super, context->current_unit, node.span, none,
            context::empty_span(), target.owner_type);
        return base::invalid_expression();
    }
    if (constructor_is_unbound && target.owner_type != none) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_class_initialization, context->current_unit, node.span, none,
            context::empty_span(), target.owner_type);
        return base::invalid_expression();
    }
    if (target.valid) {
        selected_function = resolve_selected_function(context, node_id, node, target);
        if (selected_function == none) {
            return base::invalid_expression();
        }
        call_dispatch = classes::dispatch_plan(
            context, target.owner_type, selected_function, call_has_exact_dynamic_type(context, target));
        let direct_abstract_call: bool = classes::method_is_abstract(context, selected_function) &&
            call_dispatch.kind == domain::CallDispatch.direct;
        if (direct_abstract_call) {
            add_callable_diagnostic(context, context::DiagnosticKind.invalid_method, node, target.binding_id);
            return base::invalid_expression();
        }
    }
    var return_type: usize = none;
    var ir_callee: usize = none;
    var parameter_count: usize = 0;
    var required_parameter_count: usize = 0;
    var first_parameter: usize = none;
    var parameters_from_fields: bool = false;
    var callee_no_return: bool = false;
    var bound_receiver: usize = none;
    var selected_record: context::Function = {};
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    if (selected_function != none) {
        let function_data: *const context::Function = context->functions.data as *const context::Function;
        selected_record = function_data[selected_function];
        return_type = selected_record.return_type;
        ir_callee = selected_record.ir_function;
        parameter_count = functions::function_argument_parameter_count(selected_record);
        required_parameter_count = functions::function_required_argument_count(selected_record);
        first_parameter = functions::function_first_argument_parameter(selected_record);
        callee_no_return = (selected_record.flags & (context::SymbolFlag.no_return as usize)) != 0;
    } else {
        let callee: context::Expression = api::invoke(lowerer, context, node.first_child, none);
        if (!callee.valid) {
            return callee;
        }
        let callee_record: type_info::Record = context::type_record(context, callee.type_id);
        let ordinary_pointer: bool = callee_record.kind == type_info::Kind.function_pointer;
        let bound_method: bool = callee_record.kind == type_info::Kind.bound_method;
        if (!ordinary_pointer && !bound_method) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_call, context->current_unit, node.span, none,
                context::empty_span(), callee.type_id);
            return base::invalid_expression();
        }
        if (ordinary_pointer) {
            callee_value = callee.value_id;
        } else {
            bound_receiver = load_bound_word(context, node, callee.address_id, 0);
            let entry_word: usize = load_bound_word(context, node, callee.address_id, sizeof(usize));
            callee_value = convert_value(context, node, entry_word, bound_call_type(context, callee.type_id));
        }
        return_type = callee_record.element_type;
        parameter_count = callee_record.field_count;
        required_parameter_count = parameter_count;
        first_parameter = callee_record.first_field;
        parameters_from_fields = true;
    }
    if (result_address != none && return_type != expected_result) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, context->current_unit, node.span,
            none, context::empty_span(), expected_result);
        return base::invalid_expression();
    }
    let argument_total: usize = node.child_count - 1;
    let arity_is_valid: bool = selected_function == none ? argument_total == parameter_count :
        functions::function_accepts_arity(context, selected_function, argument_total);
    if (!arity_is_valid) {
        let related_unit: usize = selected_function == none ? none :
            symbols[selected_record.symbol_id].declaration_unit;
        context::add_diagnostic(
            context, context::DiagnosticKind.argument_count, context->current_unit, node.span,
            related_unit, context::empty_span(), required_parameter_count);
        return base::invalid_expression();
    }
    var argument_values: bytes::Buffer = bytes::empty();
    if (bound_receiver != none) {
        append_call_argument(context, &argument_values, bound_receiver);
    }
    var constructed_address: usize = none;
    let target_has_receiver: bool = target.receiver_source != probe::ReceiverSource.none;
    if (selected_function != none && target_has_receiver) {
        let receiver_type: usize = functions::function_receiver_type(context, selected_record);
        constructed_address = collect_direct_receiver(
            context, node, target, receiver_type, receiver_address, lowerer, &argument_values);
        if (constructed_address == none) {
            bytes::release(argument_values);
            return base::invalid_expression();
        }
        if (call_dispatch.kind == domain::CallDispatch.virtual_call) {
            callee_value = load_virtual_callee(context, node, call_dispatch, selected_record, constructed_address);
            if (callee_value == none) {
                bytes::release(argument_values);
                return base::invalid_expression();
            }
        }
    }
    var child: usize = callee_node.next_sibling;
    for (var index: usize = 0;
        index < argument_total && context->error == runtime::Error.none;
        index += 1) {
        let variadic_extra: bool = index >= parameter_count;
        var parameter_type: usize = none;
        if (!variadic_extra) {
            let parameters: *const context::Parameter = context->parameters.data as *const context::Parameter;
            let type_fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
            parameter_type = call_parameter_type(
                parameters, type_fields, first_parameter, index, parameters_from_fields);
        }
        var expected_type: usize = parameter_type;
        if (!variadic_extra) {
            let parameter_record: type_info::Record = context::type_record(context, parameter_type);
            if (parameter_record.kind == type_info::Kind.reference) {
                expected_type = parameter_record.element_type;
            }
        }
        let argument: context::Expression = api::invoke(lowerer, context, child, expected_type);
        let argument_node: syntax::SyntaxNode = context::node(context, context->current_unit, child);
        if (variadic_extra) {
            collect_variadic_call_argument(context, argument_node, argument, &argument_values);
        } else {
            collect_fixed_call_argument(context, argument_node, argument, parameter_type, &argument_values);
        }
        child = argument_node.next_sibling;
    }
    if (selected_function != none && argument_total < parameter_count) {
        collect_default_call_arguments(context, selected_record, argument_total, &argument_values);
    }
    let indirect_call: bool = callee_value != none;
    var instruction: ir::Instruction = builder::instruction(
        indirect_call ? ir::Opcode.call_indirect : ir::Opcode.call, node);
    if (!indirect_call) {
        instruction.auxiliary = ir_callee;
    } else {
        if (selected_function == none) {
            var check: ir::Instruction = builder::instruction(ir::Opcode.null_check, node);
            check.left = callee_value;
            builder::emit_void(context, check);
        }
        instruction.left = callee_value;
    }
    let return_record: type_info::Record = context::type_record(context, return_type);
    if (result_address != none && !type_info::is_memory(return_record.kind)) {
        context->error = runtime::Error.invalid_argument;
        bytes::release(argument_values);
        return base::invalid_expression();
    }
    instruction.right = result_address;
    let has_result: bool = return_record.kind != type_info::Kind.type_void;
    var result_value: usize = none;
    var instruction_id: usize = none;
    if (has_result) {
        result_value = builder::emit_value(context, instruction, return_type);
        if (result_value != none) {
            let values: *const ir::Value = context->ir.view().values as
                    *const ir::Value;
            instruction_id = values[result_value].definition;
        }
    } else {
        instruction.type_id = return_type;
        instruction_id = builder::emit_void(context, instruction);
    }
    let arguments: *const usize = argument_values.data as *const usize;
    for (var index: usize = 0; index < argument_values.length / sizeof(usize); index += 1) {
        context->ir.add_argument(instruction_id, arguments[index]);
    }
    let release_error: runtime::Error = bytes::release(argument_values);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (callee_no_return && instruction_id != context::no_id()) {
        var marker: ir::Instruction = builder::instruction(ir::Opcode.unreachable, node);
        builder::emit_void(context, marker);
        context->current_block = builder::add_current_block(context);
    }
    if (target.receiver_source == probe::ReceiverSource.construction && instruction_id != none) {
        return {
            type_id = target.owner_type, value_id = none, address_id = constructed_address,
            constant_value = 0, has_constant = false, category = domain::ValueCategory.temporary,
            valid = true, bitfield_segment = none,
        };
    }
    if (return_record.kind == type_info::Kind.reference && result_value != none) {
        let read_only: bool = (return_record.flags & (type_info::Flag.read_only as usize)) != 0;
        let rvalue: bool = (return_record.flags & (type_info::Flag.rvalue_reference as usize)) != 0;
        let address_type: usize = pointer_type(context, return_record.element_type, read_only);
        let result_address: usize = convert_value(context, node, result_value, address_type);
        let result_category: domain::ValueCategory = rvalue ?
            domain::xvalue(read_only) : domain::lvalue(!read_only, false);
        let result: context::Expression = {
            type_id = return_record.element_type, value_id = none, address_id = result_address,
            constant_value = 0, has_constant = false, category = result_category,
            valid = result_address != none, bitfield_segment = context::no_id(),
        };
        return builder::load_lvalue(context, node, result);
    }
    let temporary_result: bool = type_info::is_memory(return_record.kind) && result_value != none;
    if (temporary_result && result_address == none) {
        if (!lifetime::register_temporary(context, return_type, result_value)) {
            return base::invalid_expression();
        }
    }
    let result_category: domain::ValueCategory = type_info::is_memory(return_record.kind) ?
        domain::ValueCategory.temporary : domain::ValueCategory.rvalue;
    let memory_address: usize = result_address != none ? result_address : result_value;
    return {
        type_id = return_type, value_id = type_info::is_memory(return_record.kind) ? none : result_value,
        address_id = type_info::is_memory(return_record.kind) ? memory_address : none,
        constant_value = 0, has_constant = false,
        category = result_category, valid = instruction_id != none, bitfield_segment = context::no_id(),
    };
}

fn lower_target_call(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode,
    target: probe::CallTarget, lowerer: api::Lowerer) -> context::Expression {
    return lower_target_call_with_receiver(
        context, node_id, node, target, context::no_id(), context::no_id(), context::no_id(), lowerer);
}

fn lower_target_call_at(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode,
    target: probe::CallTarget, receiver_address: usize, lowerer: api::Lowerer) -> context::Expression {
    return lower_target_call_with_receiver(
        context, node_id, node, target, receiver_address, context::no_id(), context::no_id(), lowerer);
}

fn lower_call_into(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode,
    destination: usize, expected_type: usize, lowerer: api::Lowerer) -> context::Expression {
    let target: probe::CallTarget = probe::direct_call_target(context, node);
    let constructor: bool = target.receiver_source == probe::ReceiverSource.construction;
    if (constructor) {
        let target_matches: bool = target.owner_type == expected_type;
        if (!target_matches) {
            return base::invalid_expression();
        }
        if (!target.valid) {
            return lower_target_call_with_receiver(
                context, node_id, node, target, destination, context::no_id(), context::no_id(), lowerer);
        }
        if (!initialize_class_vptr(context, node, expected_type, destination)) {
            return base::invalid_expression();
        }
        return lower_target_call_with_receiver(
            context, node_id, node, target, destination, context::no_id(), context::no_id(), lowerer);
    }
    return lower_target_call_with_receiver(
        context, node_id, node, target, context::no_id(), destination, expected_type, lowerer);
}

fn lower_special_construction(
    context: *context::Context, node: syntax::SyntaxNode,
    destination: usize, expected_type: usize, source: context::Expression) -> context::Expression {
    let none: usize = context::no_id();
    let resolution: functions::SpecialMemberResolution = functions::resolve_special_constructor(
        context, expected_type, source.type_id, source.category);
    if (resolution.status == functions::SpecialMemberStatus.trivial) {
        return source;
    }
    if (resolution.status != functions::SpecialMemberStatus.selected) {
        let binding_id: usize = functions::lookup_constructor_binding(context, expected_type);
        let diagnostic: context::DiagnosticKind = resolution.status == functions::SpecialMemberStatus.ambiguous ?
            context::DiagnosticKind.ambiguous_call : context::DiagnosticKind.no_matching_overload;
        add_callable_diagnostic(context, diagnostic, node, binding_id);
        return base::invalid_expression();
    }
    let function_data: *const context::Function = context->functions.data as *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as *const context::Parameter;
    let function: context::Function = function_data[resolution.function_id];
    let receiver_type: usize = functions::function_receiver_type(context, function);
    let receiver: usize = convert_value(context, node, destination, receiver_type);
    if (receiver == none || !initialize_class_vptr(context, node, expected_type, destination)) {
        return base::invalid_expression();
    }
    var arguments: bytes::Buffer = bytes::empty();
    append_call_argument(context, &arguments, receiver);
    collect_fixed_call_argument(context, node, source, parameters[function.first_parameter].type_id, &arguments);
    var call: ir::Instruction = builder::instruction(ir::Opcode.call, node);
    call.type_id = type_info::BuiltinType.type_void as usize;
    call.auxiliary = function.ir_function;
    let instruction_id: usize = context->error == runtime::Error.none ? builder::emit_void(context, call) : none;
    let values: *const usize = arguments.data as *const usize;
    for (var index: usize = 0; index < arguments.length / sizeof(usize); index += 1) {
        context->ir.add_argument(instruction_id, values[index]);
    }
    let release_error: runtime::Error = bytes::release(arguments);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return {
        type_id = expected_type, value_id = none, address_id = destination,
        constant_value = 0, has_constant = false, category = domain::ValueCategory.temporary,
        valid = instruction_id != none && context->error == runtime::Error.none, bitfield_segment = none,
    };
}

fn lower_call(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode,
    lowerer: api::Lowerer) -> context::Expression {
    return lower_target_call(context, node_id, node, probe::direct_call_target(context, node), lowerer);
}
