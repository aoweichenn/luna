module luna.bootstrap.middleend.semantic.expr.initializer;

import luna.bootstrap.middleend.semantic.types.lookup as type_lookup;

import luna.bootstrap.middleend.semantic.context.builder as builder;

import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.consteval as consteval;
import luna.bootstrap.middleend.semantic.consteval.engine as const_engine;
import luna.bootstrap.middleend.semantic.consteval.model as const_model;
import luna.bootstrap.middleend.semantic.expr.base as base;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.bootstrap.middleend.semantic.lifetime as lifetime;
import luna.bootstrap.middleend.semantic.types as types;
import luna.bootstrap.middleend.semantic.value as category;
import luna.compiler.syntax as syntax;
import luna.compiler.types as type_info;
import luna.runtime as runtime;
import luna.std.vector::{vector};

struct InitializerInsertResult {
    inserted: bool;
    error: runtime::Error;
}

class InitializerIndexSet {
    priv values: vector<usize>;

    pub init();
    pub fn contains(value: usize) const -> bool;
    pub fn insert(value: usize) -> InitializerInsertResult;
    pub fn size() const -> usize;
    pub deinit();
}

impl InitializerIndexSet {
    init(): values = vector<usize>() {
    }

    fn contains(value: usize) const -> bool {
        for (var index: usize = 0; index < this->values.size(); index += 1) {
            if (this->values.get(index) == value) {
                return true;
            }
        }
        return false;
    }

    fn insert(value: usize) -> InitializerInsertResult {
        if (this->contains(value)) {
            return { inserted = false, error = runtime::Error.none };
        }
        let error: runtime::Error = this->values.push_back(value);
        return { inserted = error == runtime::Error.none, error = error };
    }

    fn size() const -> usize {
        return this->values.size();
    }

    deinit() {
    }
}

fn lower_scalar_zero_initializer(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize, type_record: type_info::Record
) -> context::Expression {
    if (type_record.kind == type_info::Kind.boolean) {
        return builder::emit_boolean_constant(context, node, false);
    }
    if (type_info::is_integer(type_record.kind) || type_record.kind == type_info::Kind.enumeration) {
        return builder::emit_integer_constant(context, node, expected_type, 0);
    }
    var instruction: ir::Instruction = builder::instruction(ir::Opcode.invalid, node);
    if (type_info::is_float(type_record.kind)) {
        instruction.opcode = ir::Opcode.constant_float;
        instruction.floating = 0.0;
    } else if (type_record.kind == type_info::Kind.pointer) {
        instruction.opcode = ir::Opcode.constant_null;
    } else {
        return base::invalid_expression();
    }
    let value_id: usize = builder::emit_value(context, instruction, expected_type);
    return {
        type_id = expected_type, value_id = value_id, address_id = context::no_id(), constant_value = 0,
        has_constant = false, category = category::Category.rvalue,
        valid = value_id != context::no_id(), bitfield_segment = context::no_id(),
    };
}

fn type_accepts_aggregate_initializer(kind: type_info::Kind) -> bool {
    switch (kind) {
    case type_info::Kind.structure, type_info::Kind.record_union, type_info::Kind.array {
        return true;
    }
    default {
        return false;
    }
    }
}

fn validate_initializer_fields(
    context: *context::Context, node: syntax::SyntaxNode, expected_type: usize, type_record: type_info::Record
) -> bool {
    let none: usize = context::no_id();
    var seen_fields: InitializerIndexSet = InitializerIndexSet();
    var child: usize = node.first_child;
    var initializer_count: usize = 0;
    var valid: bool = true;
    while (child != none && context->error == runtime::Error.none) {
        let initializer: syntax::SyntaxNode = context::node(context, context->current_unit, child);
        if (initializer.kind == syntax::SyntaxKind.initializer_element) {
            // 位置项和带下标项只适用于数组初始化器。
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_initializer, context->current_unit, initializer.span, none,
                context::empty_span(), expected_type);
            valid = false;
            child = initializer.next_sibling;
            continue;
        }
        let lookup: types::FieldLookup =
            type_lookup::lookup_field(context, expected_type, context->current_unit, initializer.token_index);
        if (lookup.status == types::FieldStatus.ambiguous) {
            context::add_diagnostic(
                context, context::DiagnosticKind.ambiguous_field, context->current_unit, initializer.span, none,
                context::empty_span(), expected_type);
            valid = false;
        } else if (lookup.status != types::FieldStatus.found) {
            let segment_id: usize =
                builder::lookup_bitfield_segment(
                    context, expected_type, context->current_unit, initializer.token_index);
            // 位段段组尚不能直接初始化；命中段组应报告位段错误，而不是未知字段。
            context::add_diagnostic(
                context, segment_id != none ? context::DiagnosticKind.invalid_bitfield :
                    context::DiagnosticKind.unknown_field, context->current_unit, initializer.span, none,
                context::empty_span(), segment_id != none ? segment_id : expected_type);
            valid = false;
        } else {
            let field_id: usize = lookup.field_id;
            let union_already_initialized: bool = type_record.kind == type_info::Kind.record_union &&
                initializer_count != 0;
            let inserted: InitializerInsertResult = union_already_initialized ?
                { inserted = false, error = runtime::Error.none } : seen_fields.insert(field_id);
            context->error = inserted.error;
            if (!inserted.inserted && inserted.error == runtime::Error.none) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.duplicate_initializer_field, context->current_unit,
                    initializer.span, none, context::empty_span(), field_id);
                valid = false;
            } else if (inserted.inserted) {
                initializer_count += 1;
            }
        }
        child = initializer.next_sibling;
    }
    let fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
    if (valid && type_record.kind == type_info::Kind.structure) {
        for (var index: usize = 0; index < type_record.field_count; index += 1) {
            let field_id: usize = type_record.first_field + index;
            let requires_value: bool = functions::type_requires_explicit_initialization(
                context, fields[field_id].type_id);
            if (requires_value && !seen_fields.contains(field_id)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span,
                    none, context::empty_span(), field_id);
                valid = false;
                break;
            }
        }
    }
    return valid && context->error == runtime::Error.none;
}

fn lower_array_initializer(
    context: *context::Context, node: syntax::SyntaxNode, address_id: usize, expected_type: usize,
    type_record: type_info::Record, lowerer: api::IntoLowerer) -> bool {
    let none: usize = context::no_id();
    let element_type: usize = type_record.element_type;
    let element_count: usize = type_record.element_count;
    let element_record: type_info::Record = context::type_record(context, element_type);
    let pointer: type_info::IdResult = context->types.pointer(element_type, false, false);
    context->error = pointer.error;
    if (context->error != runtime::Error.none) {
        return false;
    }
    var seen_indices: InitializerIndexSet = InitializerIndexSet();
    var cursor: usize = 0;
    var valid: bool = true;
    var child: usize = node.first_child;
    while (child != none && context->error == runtime::Error.none) {
        let element: syntax::SyntaxNode = context::node(context, context->current_unit, child);
        if (element.kind != syntax::SyntaxKind.initializer_element) {
            // `field =`具名项只适用于记录初始化器。
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_initializer, context->current_unit, element.span, none,
                context::empty_span(), expected_type);
            valid = false;
            child = element.next_sibling;
            continue;
        }
        var position: u64 = cursor as u64;
        var value_child: usize = element.first_child;
        if ((element.flags & (syntax::SyntaxFlag.indexed as usize)) != 0) {
            if (element.child_count != 2) {
                context->error = runtime::Error.invalid_argument;
                break;
            }
            let index: const_model::Value = const_engine::expression(context, context->current_unit,
                element.first_child);
            let index_shape_is_invalid: bool = !index.is_constant || index.is_boolean;
            if (index.error || index_shape_is_invalid) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_index, context->current_unit,
                    context::node(context, context->current_unit, element.first_child).span,
                    none, context::empty_span(), expected_type);
                valid = false;
                child = element.next_sibling;
                continue;
            }
            position = index.value;
            value_child = context::node(context, context->current_unit, element.first_child).next_sibling;
        }
        if (position >= element_count as u64) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_index, context->current_unit, element.span, none,
                context::empty_span(), expected_type);
            valid = false;
            child = element.next_sibling;
            continue;
        }
        let slot: usize = position as usize;
        let inserted: InitializerInsertResult = seen_indices.insert(slot);
        context->error = inserted.error;
        if (inserted.error != runtime::Error.none) {
            break;
        }
        if (!inserted.inserted) {
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_initializer_field, context->current_unit, element.span, none,
                context::empty_span(), expected_type);
            valid = false;
            child = element.next_sibling;
            continue;
        }
        cursor = slot + 1;
        // 元素地址使用常量下标的 pointer_offset，与数组索引保持同一 IR 形状；
        // member_address 只验证记录字段，不能用于这里。
        let index_constant: context::Expression =
            builder::emit_integer_constant(
                context, element, type_info::BuiltinType.unsigned_size as usize, slot as u64);
        var element_instruction: ir::Instruction = builder::instruction(ir::Opcode.pointer_offset, element);
        element_instruction.left = address_id;
        element_instruction.right = index_constant.value_id;
        element_instruction.auxiliary = element_record.size_bytes;
        let element_address: usize = builder::emit_value(context, element_instruction, pointer.type_id);
        let value: context::Expression = api::invoke_into(lowerer, context, value_child, element_type, element_address);
        if (value.type_id != element_type) {
            context::add_diagnostic(
                context, context::DiagnosticKind.type_mismatch, context->current_unit, element.span, none,
                context::empty_span(), element_type);
            valid = false;
        } else if (value.address_id != element_address) {
            builder::store_to_address(context, element, element_address, element_type, value);
        }
        child = element.next_sibling;
    }
    let requires_every_element: bool = functions::type_requires_explicit_initialization(context, element_type);
    let initialized_count: usize = seen_indices.size();
    if (requires_every_element && initialized_count != element_count) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span,
            none, context::empty_span(), expected_type);
        valid = false;
    }
    return valid && context->error == runtime::Error.none;
}

fn lower_initializer_at(
    context: *context::Context, node_id: usize, expected_type: usize,
    destination: usize, lowerer: api::IntoLowerer) -> context::Expression {
    let none: usize = context::no_id();
    let node: syntax::SyntaxNode = context::node(context, context->current_unit, node_id);
    let type_record: type_info::Record = context::type_record(context, expected_type);
    let nontrivial_union: bool = type_record.kind == type_info::Kind.record_union &&
        functions::type_requires_explicit_initialization(context, expected_type);
    if (nontrivial_union) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span,
            none, context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    let composite: bool = type_record.kind == type_info::Kind.structure || type_record.kind == type_info::Kind.array;
    let requires_aggregate: bool = composite && functions::type_requires_explicit_initialization(
        context, expected_type);
    if (requires_aggregate && node.kind != syntax::SyntaxKind.aggregate_initializer) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span,
            none, context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    if (type_record.kind == type_info::Kind.class_type) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_class_initialization, context->current_unit, node.span, none,
            context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    let aggregate_target_is_valid: bool = type_accepts_aggregate_initializer(type_record.kind);
    if (node.kind == syntax::SyntaxKind.aggregate_initializer && !aggregate_target_is_valid) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span, none,
            context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    let record_initializer: bool = node.kind == syntax::SyntaxKind.aggregate_initializer &&
        type_record.kind != type_info::Kind.array;
    if (record_initializer && !validate_initializer_fields(context, node, expected_type, type_record)) {
        return base::invalid_expression();
    }
    if (!type_info::is_memory(type_record.kind)) {
        if (node.kind == syntax::SyntaxKind.zero_initializer) {
            let zero: context::Expression = lower_scalar_zero_initializer(context, node, expected_type, type_record);
            if (zero.valid) {
                return zero;
            }
        }
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_initializer, context->current_unit, node.span, none,
            context::empty_span(), expected_type);
        return base::invalid_expression();
    }
    let owns_destination: bool = destination != none;
    var slot_id: usize = none;
    var address_id: usize = destination;
    if (!owns_destination) {
        slot_id = ir::add_slot(&context->ir, builder::current_ir_function(context), expected_type, true, false, 0);
        address_id = builder::address_of_slot(context, node, slot_id, expected_type, false, false);
        let storage_is_valid: bool = slot_id != none && address_id != none;
        if (!storage_is_valid || !builder::zero_slot(context, node, slot_id, expected_type)) {
            return base::invalid_expression();
        }
    }
    if (node.kind == syntax::SyntaxKind.aggregate_initializer && type_record.kind == type_info::Kind.array) {
        if (!lower_array_initializer(
                context, node, address_id, expected_type, type_record, lowerer)) {
            return base::invalid_expression();
        }
    } else if (node.kind == syntax::SyntaxKind.aggregate_initializer) {
        let fields: *const type_info::Field = context->types.field_data() as
                *const type_info::Field;
        var seen_fields: InitializerIndexSet = InitializerIndexSet();
        var child: usize = node.first_child;
        var initializer_count: usize = 0;
        while (child != none && context->error == runtime::Error.none) {
            let initializer: syntax::SyntaxNode = context::node(context, context->current_unit, child);
            let lookup: types::FieldLookup =
                type_lookup::lookup_field(context, expected_type, context->current_unit, initializer.token_index);
            if (lookup.status == types::FieldStatus.ambiguous) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.ambiguous_field, context->current_unit, initializer.span, none,
                    context::empty_span(), expected_type);
            } else if (lookup.status != types::FieldStatus.found) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.unknown_field, context->current_unit, initializer.span, none,
                    context::empty_span(), expected_type);
            } else {
                let field_id: usize = lookup.field_id;
                let union_already_initialized: bool = type_record.kind == type_info::Kind.record_union &&
                    initializer_count != 0;
                if (union_already_initialized) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.duplicate_initializer_field, context->current_unit,
                        initializer.span, none, context::empty_span(), field_id);
                } else if (initializer.child_count == 1) {
                    let inserted: InitializerInsertResult = seen_fields.insert(field_id);
                    context->error = inserted.error;
                    if (!inserted.inserted && inserted.error == runtime::Error.none) {
                        context::add_diagnostic(
                            context, context::DiagnosticKind.duplicate_initializer_field, context->current_unit,
                            initializer.span, none, context::empty_span(), field_id);
                    } else if (inserted.inserted) {
                        let field: type_info::Field = fields[field_id];
                        let pointer: type_info::IdResult = context->types.pointer(field.type_id, false, false);
                        context->error = pointer.error;
                        var member_instruction: ir::Instruction =
                            builder::instruction(ir::Opcode.member_address, initializer);
                        member_instruction.left = address_id;
                        member_instruction.auxiliary = lookup.offset_bytes;
                        let field_address: usize = builder::emit_value(context, member_instruction, pointer.type_id);
                        let value: context::Expression = api::invoke_into(
                            lowerer, context, initializer.first_child, field.type_id, field_address);
                        if (value.type_id != field.type_id) {
                            context::add_diagnostic(
                                context, context::DiagnosticKind.type_mismatch, context->current_unit,
                                initializer.span, none, context::empty_span(), field.type_id);
                        } else if (value.address_id != field_address) {
                            builder::store_to_address(context, initializer, field_address, field.type_id, value);
                        }
                        initializer_count += 1;
                    }
                }
            }
            child = initializer.next_sibling;
        }
    }
    let temporary_result: bool = !owns_destination && lifetime::type_needs_cleanup(context, expected_type);
    if (temporary_result && !lifetime::register_temporary(context, expected_type, address_id)) {
        return base::invalid_expression();
    }
    return {
        type_id = expected_type, value_id = none, address_id = address_id, constant_value = 0, has_constant = false,
        category = category::Category.temporary, valid = address_id != none, bitfield_segment = context::no_id(),
    };
}

fn lower_initializer(context: *context::Context, node_id: usize, expected_type: usize,
    lowerer: api::IntoLowerer) -> context::Expression {
    return lower_initializer_at(context, node_id, expected_type, context::no_id(), lowerer);
}

fn lower_initializer_into(
    context: *context::Context, node_id: usize, expected_type: usize,
    destination: usize, lowerer: api::IntoLowerer) -> context::Expression {
    return lower_initializer_at(context, node_id, expected_type, destination, lowerer);
}
