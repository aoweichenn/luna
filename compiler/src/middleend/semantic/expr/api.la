module luna.bootstrap.middleend.semantic.expr.api;

import luna.bootstrap.middleend.semantic.value as category;

fn invoke(lowerer: Lowerer, context: *context::Context, node_id: usize, expected_type: usize) -> context::Expression {
    let none: usize = context::no_id();
    var result: context::Expression = {
        type_id = none, value_id = none, address_id = none, constant_value = 0, has_constant = false,
        category = category::Category.rvalue, valid = false, bitfield_segment = none,
    };
    lowerer(context, node_id, expected_type, &result);
    return result;
}
