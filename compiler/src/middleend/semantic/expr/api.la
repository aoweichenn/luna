module luna.bootstrap.middleend.semantic.expr.api;

import luna.bootstrap.middleend.semantic.expr.base as base;

fn invoke(lowerer: Lowerer, context: *context::Context, node_id: usize, expected_type: usize) -> context::Expression {
    var result: context::Expression = base::invalid_expression();
    lowerer(context, node_id, expected_type, &result);
    return result;
}

fn invoke_into(
    lowerer: IntoLowerer, context: *context::Context, node_id: usize,
    expected_type: usize, destination: usize) -> context::Expression {
    var result: context::Expression = base::invalid_expression();
    lowerer(context, node_id, expected_type, destination, &result);
    return result;
}
