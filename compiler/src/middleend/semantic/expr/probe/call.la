module luna.bootstrap.middleend.semantic.expr.probe;

fn function_type(context: *context::Context, function_id: usize) -> usize {
    if (function_id >= context->function_count) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let function_records: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = function_records[function_id];
    if ((function.flags & (context::SymbolFlag.variadic as usize)) != 0) {
        return context::no_id();
    }
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    var parameter_types: bytes::Buffer = bytes::empty();
    for (var index: usize = 0;
        index < function.parameter_count && context->error == runtime::Error.none;
        index += 1) {
        let parameter_type: usize = parameters[function.first_parameter + index].type_id;
        let appended: bytes::BufferResult =
            bytes::append(parameter_types, (&parameter_type) as *const usize as *const u8, sizeof(usize));
        parameter_types = appended.buffer;
        context->error = appended.error;
    }
    let parameter_data: *const usize = parameter_types.data as *const usize;
    let type_id: usize = context->error == runtime::Error.none ?
        context::function_pointer_type(context, function.return_type, parameter_data, function.parameter_count) :
        context::no_id();
    let release_error: runtime::Error = bytes::release(parameter_types);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return type_id;
}

fn function_matches_type(context: *context::Context, function_id: usize, target_type: usize) -> bool {
    if (!type_is_valid(context, target_type) || function_id >= context->function_count) {
        return false;
    }
    let target: type_info::Record = context::type_record(context, target_type);
    if (target.kind != type_info::Kind.function_pointer) {
        return false;
    }
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions_data[function_id];
    let variadic: bool = (function.flags & (context::SymbolFlag.variadic as usize)) != 0;
    let parameter_count: usize = functions::function_argument_parameter_count(function);
    let first_parameter: usize = functions::function_first_argument_parameter(function);
    let shape_matches: bool = parameter_count == target.field_count && function.return_type == target.element_type;
    if (variadic || !shape_matches) {
        return false;
    }
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let fields: *const type_info::Field = context->types.fields.data as
            *const type_info::Field;
    for (var index: usize = 0; index < parameter_count; index += 1) {
        if (parameters[first_parameter + index].type_id != fields[target.first_field + index].type_id) {
            return false;
        }
    }
    return true;
}

fn resolve_function_value(context: *context::Context, binding_id: usize, expected_type: usize) -> Resolution {
    let visible_count: usize = functions::binding_visible_count(context, binding_id, context->current_unit);
    if (context->error != runtime::Error.none || visible_count == 0) {
        return {status = ResolutionStatus.invalid, function_id = context::no_id()};
    }
    if (expected_type == context::no_id()) {
        let function_id: usize = functions::binding_single_function(context, binding_id, context->current_unit);
        if (visible_count != 1) {
            return {status = ResolutionStatus.ambiguous, function_id = context::no_id()};
        }
        let functions_data: *const context::Function = context->functions.data as
                *const context::Function;
        let variadic: bool = (functions_data[function_id].flags & (context::SymbolFlag.variadic as usize)) != 0;
        return variadic ? {status = ResolutionStatus.no_match, function_id = context::no_id()} :
            {status = ResolutionStatus.selected, function_id = function_id};
    }
    var selected: usize = context::no_id();
    let bindings: *const context::Binding = context->bindings.data as
            *const context::Binding;
    let candidate_count: usize = bindings[binding_id].candidate_count;
    for (var candidate_index: usize = 0; candidate_index < candidate_count; candidate_index += 1) {
        let function_id: usize = functions::binding_candidate(context, binding_id, candidate_index);
        let visible: bool = functions::function_is_visible(context, function_id, context->current_unit);
        if (visible && function_matches_type(context, function_id, expected_type)) {
            if (selected != context::no_id()) {
                return {status = ResolutionStatus.ambiguous, function_id = context::no_id()};
            }
            selected = function_id;
        }
    }
    return selected == context::no_id() ? {status = ResolutionStatus.no_match, function_id = context::no_id()} :
        {status = ResolutionStatus.selected, function_id = selected};
}

fn function_value_expression(context: *context::Context, binding_id: usize, expected_type: usize) -> Result {
    let resolution: Resolution = resolve_function_value(context, binding_id, expected_type);
    switch (resolution.status) {
    case ResolutionStatus.ambiguous {
        return result(Status.ambiguous, context::no_id(), context::no_id());
    }
    case ResolutionStatus.invalid {
        return invalid_result();
    }
    case ResolutionStatus.no_match {
        return incompatible_result();
    }
    default {}
    }
    let type_id: usize = expected_type == context::no_id() ?
        function_type(context, resolution.function_id) : expected_type;
    if (type_id == context::no_id()) {
        return invalid_result();
    }
    return result(Status.compatible, type_id, resolution.function_id);
}

fn invalid_call_target() -> CallTarget {
    return {
        binding_id = context::no_id(), kind = callable::Kind.free_function, owner_type = context::no_id(),
        receiver_node = context::no_id(), receiver_type = context::no_id(),
        receiver_category = category::Category.rvalue, receiver_source = ReceiverSource.none,
        name_token = context::no_id(), valid = false,
    };
}

fn named_class_type(context: *context::Context, node: syntax::SyntaxNode) -> usize {
    if (node.kind != syntax::SyntaxKind.name_expression) {
        return context::no_id();
    }
    let symbol_id: usize = node.child_count == 0 ? names::lookup_symbol(
            context, context->current_unit, node.token_index, context::SymbolKind.named_type) :
        names::lookup_qualified_symbol(context, context->current_unit, node, context::SymbolKind.named_type, false);
    if (symbol_id == context::no_id()) {
        return context::no_id();
    }
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    var type_id: usize = symbols[symbol_id].type_id;
    let record: type_info::Record = context::type_record(context, type_id);
    if (record.kind == type_info::Kind.alias) {
        type_id = record.element_type;
    }
    return context::type_record(context, type_id).kind == type_info::Kind.class_type ? type_id : context::no_id();
}

fn constructor_call_target(context: *context::Context, callee: syntax::SyntaxNode) -> CallTarget {
    let owner_type: usize = named_class_type(context, callee);
    if (owner_type == context::no_id()) {
        return invalid_call_target();
    }
    let binding_id: usize = functions::lookup_constructor_binding(context, owner_type);
    let constructible: bool = !classes::class_is_abstract(context, owner_type);
    return {
        binding_id = binding_id, kind = callable::Kind.constructor, owner_type = owner_type,
        receiver_node = context::no_id(), receiver_type = owner_type,
        receiver_category = category::Category.writable_lvalue, receiver_source = ReceiverSource.construction,
        name_token = context::no_id(), valid = binding_id != context::no_id() && constructible,
    };
}

fn lookup_member_binding(context: *context::Context, owner_type: usize, name_token: usize) -> usize {
    var current: usize = owner_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let binding_id: usize = functions::lookup_owned_callable_binding(
            context, context->current_unit, current, name_token);
        if (binding_id != context::no_id()) {
            return binding_id;
        }
        current = classes::base_type(context, current);
        if (current == context::no_id()) {
            return context::no_id();
        }
    }
    return context::no_id();
}

fn static_call_target(context: *context::Context, base: syntax::SyntaxNode, member: syntax::SyntaxNode) -> CallTarget {
    let owner_type: usize = named_class_type(context, base);
    if (owner_type == context::no_id()) {
        return invalid_call_target();
    }
    let binding_id: usize = lookup_member_binding(context, owner_type, member.token_index);
    return {
        binding_id = binding_id, kind = callable::Kind.static_method, owner_type = owner_type,
        receiver_node = context::no_id(), receiver_type = context::no_id(),
        receiver_category = category::Category.rvalue, receiver_source = ReceiverSource.none,
        name_token = member.token_index, valid = binding_id != context::no_id(),
    };
}

fn instance_call_target(
    context: *context::Context, callee: syntax::SyntaxNode,
    base_node: syntax::SyntaxNode, member: syntax::SyntaxNode) -> CallTarget {
    let base: Result = expression(context, callee.first_child, context::no_id());
    if (base.status != Status.compatible) {
        return invalid_call_target();
    }
    let operation: lexer::TokenKind = context::token(context, context->current_unit, callee.token_index).kind;
    var owner_type: usize = base.type_id;
    var receiver_category: category::Category = base.category;
    if (operation == lexer::TokenKind.arrow) {
        let pointer: type_info::Record = context::type_record(context, base.type_id);
        if (pointer.kind != type_info::Kind.pointer) {
            return invalid_call_target();
        }
        owner_type = pointer.element_type;
        receiver_category = category::pointee(pointer);
    } else if (operation != lexer::TokenKind.dot || !category::has_storage(base.category)) {
        return invalid_call_target();
    }
    if (context::type_record(context, owner_type).kind != type_info::Kind.class_type) {
        return invalid_call_target();
    }
    let binding_id: usize = lookup_member_binding(context, owner_type, member.token_index);
    return {
        binding_id = binding_id, kind = callable::Kind.instance_method, owner_type = owner_type,
        receiver_node = callee.first_child, receiver_type = base_node.kind == syntax::SyntaxKind.invalid ?
            context::no_id() : base.type_id, receiver_category = receiver_category,
        receiver_source = ReceiverSource.expression, name_token = member.token_index,
        valid = binding_id != context::no_id(),
    };
}

fn current_receiver_category(context: *context::Context) -> category::Category {
    if (context->current_function >= context->function_count) {
        return category::Category.rvalue;
    }
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions_data[context->current_function];
    switch (function.identity.receiver) {
    case callable::ReceiverKind.writable {
        return category::Category.writable_lvalue;
    }
    case callable::ReceiverKind.read_only {
        return category::Category.read_only_lvalue;
    }
    case callable::ReceiverKind.writable_volatile {
        return category::Category.writable_volatile_lvalue;
    }
    case callable::ReceiverKind.read_only_volatile {
        return category::Category.volatile_lvalue;
    }
    default {
        return category::Category.rvalue;
    }
    }
}

fn super_call_target(context: *context::Context, base: syntax::SyntaxNode, member: syntax::SyntaxNode) -> CallTarget {
    var invalid: CallTarget = invalid_call_target();
    invalid.kind = callable::Kind.instance_method;
    invalid.receiver_source = ReceiverSource.current_object;
    invalid.name_token = member.token_index;
    if (base.kind != syntax::SyntaxKind.super_expression) {
        return invalid;
    }
    if (context->current_function >= context->function_count) {
        return invalid;
    }
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let current: context::Function = functions_data[context->current_function];
    let owner_type: usize = classes::base_type(context, current.identity.owner_type);
    invalid.owner_type = owner_type;
    if (!callable::has_receiver(current.identity) || owner_type == context::no_id()) {
        return invalid;
    }
    let constructor: bool = context::token_equals_bytes(context, context->current_unit, member.token_index, "init", 4);
    if (constructor && current.identity.kind != callable::Kind.constructor) {
        invalid.kind = callable::Kind.constructor;
        invalid.name_token = context::no_id();
        return invalid;
    }
    let binding_id: usize = constructor ? functions::lookup_constructor_binding(context, owner_type) :
        lookup_member_binding(context, owner_type, member.token_index);
    return {
        binding_id = binding_id, kind = constructor ? callable::Kind.constructor : callable::Kind.instance_method,
        owner_type = owner_type, receiver_node = context::no_id(), receiver_type = current.identity.owner_type,
        receiver_category = current_receiver_category(context), receiver_source = ReceiverSource.current_object,
        name_token = constructor ? context::no_id() : member.token_index, valid = binding_id != context::no_id(),
    };
}

fn member_call_target(context: *context::Context, callee: syntax::SyntaxNode) -> CallTarget {
    if (callee.kind != syntax::SyntaxKind.member_expression || callee.child_count != 2) {
        return invalid_call_target();
    }
    let base: syntax::SyntaxNode = context::node(context, context->current_unit, callee.first_child);
    let member: syntax::SyntaxNode = context::node(context, context->current_unit, base.next_sibling);
    let operation: lexer::TokenKind = context::token(context, context->current_unit, callee.token_index).kind;
    if (operation == lexer::TokenKind.dot) {
        let super_target: CallTarget = super_call_target(context, base, member);
        if (base.kind == syntax::SyntaxKind.super_expression) {
            return super_target;
        }
    }
    if (operation == lexer::TokenKind.dot) {
        let static_target: CallTarget = static_call_target(context, base, member);
        if (static_target.valid) {
            return static_target;
        }
    }
    return instance_call_target(context, callee, base, member);
}

fn direct_call_target(context: *context::Context, node: syntax::SyntaxNode) -> CallTarget {
    if (node.child_count == 0) {
        return invalid_call_target();
    }
    let callee: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let constructor: CallTarget = constructor_call_target(context, callee);
    if (constructor.owner_type != context::no_id()) {
        return constructor;
    }
    let member: CallTarget = member_call_target(context, callee);
    let super_call: bool = member.receiver_source == ReceiverSource.current_object;
    if (member.valid || super_call) {
        return member;
    }
    let binding_id: usize = direct_call_binding(context, callee);
    return {
        binding_id = binding_id, kind = callable::Kind.free_function, owner_type = callable::no_owner(),
        receiver_node = context::no_id(), receiver_type = context::no_id(),
        receiver_category = category::Category.rvalue, receiver_source = ReceiverSource.none,
        name_token = context::no_id(), valid = binding_id != context::no_id(),
    };
}

fn receiver_is_compatible(required: callable::ReceiverKind, actual: category::Category) -> bool {
    switch (required) {
    case callable::ReceiverKind.writable {
        return actual == category::Category.writable_lvalue;
    }
    case callable::ReceiverKind.read_only {
        return category::has_storage(actual) && !category::is_volatile(actual);
    }
    case callable::ReceiverKind.writable_volatile {
        return actual == category::Category.writable_volatile_lvalue;
    }
    case callable::ReceiverKind.read_only_volatile {
        return category::is_volatile(actual);
    }
    default {
        return false;
    }
    }
}

fn candidate_owner_is_compatible(context: *context::Context, function: context::Function, target: CallTarget) -> bool {
    if (!target.valid || function.identity.kind != target.kind) {
        return false;
    }
    if (target.name_token == context::no_id()) {
        return function.identity.owner_type == target.owner_type;
    }
    return classes::is_base_of(context, function.identity.owner_type, target.owner_type);
}

fn candidate_target_is_compatible(context: *context::Context, function: context::Function, target: CallTarget) -> bool {
    if (!candidate_owner_is_compatible(context, function, target)) {
        return false;
    }
    if (target.kind != callable::Kind.instance_method) {
        return true;
    }
    return receiver_is_compatible(function.identity.receiver, target.receiver_category);
}

fn candidate_call_status(
    context: *context::Context, node: syntax::SyntaxNode, function_id: usize, target: CallTarget) -> Status {
    if (function_id >= context->function_count || node.child_count == 0) {
        return Status.invalid;
    }
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions_data[function_id];
    if (!candidate_target_is_compatible(context, function, target)) {
        return Status.incompatible;
    }
    let variadic: bool = (function.flags & (context::SymbolFlag.variadic as usize)) != 0;
    let parameter_count: usize = functions::function_argument_parameter_count(function);
    let first_parameter: usize = functions::function_first_argument_parameter(function);
    let argument_count: usize = node.child_count - 1;
    if (!functions::function_accepts_arity(context, function_id, argument_count)) {
        return Status.incompatible;
    }
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let callee: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    var child: usize = callee.next_sibling;
    var candidate_status: Status = Status.compatible;
    for (var argument_index: usize = 0; argument_index < argument_count; argument_index += 1) {
        let variadic_extra: bool = argument_index >= parameter_count;
        let expected_type: usize = variadic_extra ? context::no_id() :
            parameters[first_parameter + argument_index].type_id;
        let argument: Result = expression(context, child, expected_type);
        switch (argument.status) {
        case Status.incompatible {
            return Status.incompatible;
        }
        case Status.ambiguous {
            candidate_status = Status.ambiguous;
        }
        case Status.invalid {
            if (candidate_status == Status.compatible) {
                candidate_status = Status.invalid;
            }
        }
        default {}
        }
        if (variadic_extra && argument.status == Status.compatible) {
            let argument_record: type_info::Record = context::type_record(context, argument.type_id);
            if (!type_info::is_scalar(argument_record.kind)) {
                return Status.incompatible;
            }
        }
        child = context::node(context, context->current_unit, child).next_sibling;
    }
    return candidate_status;
}

struct CandidateResolution {
    selected_function: usize;
    compatible_count: usize;
    deferred_status: ResolutionStatus;
}

fn candidate_resolution() -> CandidateResolution {
    return {
        selected_function = context::no_id(), compatible_count = 0, deferred_status = ResolutionStatus.no_match,
    };
}

fn consider_candidate(resolution: *CandidateResolution, function_id: usize, status: Status) {
    switch (status) {
    case Status.compatible {
        if (resolution->compatible_count == 0) {
            resolution->selected_function = function_id;
        }
        resolution->compatible_count += 1;
    }
    case Status.ambiguous {
        resolution->deferred_status = ResolutionStatus.ambiguous;
    }
    case Status.invalid {
        if (resolution->deferred_status == ResolutionStatus.no_match) {
            resolution->deferred_status = ResolutionStatus.invalid;
        }
    }
    default {}
    }
}

fn finish_candidate_resolution(resolution: CandidateResolution) -> Resolution {
    let multiple_matches: bool = resolution.compatible_count > 1;
    let nested_ambiguity: bool = resolution.deferred_status == ResolutionStatus.ambiguous;
    if (multiple_matches || nested_ambiguity) {
        return {status = ResolutionStatus.ambiguous, function_id = context::no_id()};
    }
    if (resolution.compatible_count == 1) {
        return {status = ResolutionStatus.selected, function_id = resolution.selected_function};
    }
    return {status = resolution.deferred_status, function_id = context::no_id()};
}

enum CallSelectionByte: u8 {
    unset = 255,
}

fn initialize_call_selections(context: *context::Context) -> bool {
    if (context->call_selection_count != 0) {
        return context->call_selections.length == context->call_selection_count * sizeof(usize);
    }
    let units: *const context::Unit = context->input.units.data as
            *const context::Unit;
    var selection_count: usize = 0;
    for (var unit_index: usize = 0; unit_index < context->input.unit_count; unit_index += 1) {
        if (@add_overflow(selection_count, units[unit_index].tree.count, &selection_count)) {
            context->error = runtime::Error.out_of_memory;
            return false;
        }
    }
    var byte_count: usize = 0;
    if (@mul_overflow(selection_count, sizeof(usize), &byte_count)) {
        context->error = runtime::Error.out_of_memory;
        return false;
    }
    let created: bytes::BufferResult = bytes::with_capacity(byte_count);
    context->call_selections = created.buffer;
    context->error = created.error;
    if (created.error != runtime::Error.none) {
        return false;
    }
    context->call_selections.length = byte_count;
    context->call_selection_count = selection_count;
    context->error = memory::fill(
        context->call_selections.data, CallSelectionByte.unset as u8, context->call_selections.length);
    return context->error == runtime::Error.none;
}

fn call_selection_index(context: *context::Context, node_id: usize, result: *usize) -> bool {
    if (!initialize_call_selections(context)) {
        return false;
    }
    if (result == null || context->current_unit >= context->input.unit_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let units: *const context::Unit = context->input.units.data as
            *const context::Unit;
    if (node_id >= units[context->current_unit].tree.count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var index: usize = node_id;
    for (var unit_index: usize = 0; unit_index < context->current_unit; unit_index += 1) {
        if (@add_overflow(index, units[unit_index].tree.count, &index)) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
    }
    if (index >= context->call_selection_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    *result = index;
    return true;
}

fn selected_call(context: *context::Context, node_id: usize) -> usize {
    var index: usize = 0;
    if (!call_selection_index(context, node_id, &index)) {
        return context::no_id();
    }
    let selections: *const usize = context->call_selections.data as
            *const usize;
    return selections[index];
}

fn remember_call_selection(context: *context::Context, node_id: usize, function_id: usize) -> bool {
    var index: usize = 0;
    if (!call_selection_index(context, node_id, &index)) {
        return false;
    }
    let selections: *usize = context->call_selections.data as *usize;
    let existing: usize = selections[index];
    if (existing != context::no_id() && existing != function_id) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    selections[index] = function_id;
    return true;
}

fn target_binding(context: *context::Context, target: CallTarget, owner_type: usize) -> usize {
    if (target.name_token == context::no_id()) {
        return owner_type == target.owner_type ? target.binding_id : context::no_id();
    }
    return functions::lookup_owned_callable_binding(context, context->current_unit, owner_type, target.name_token);
}

fn target_candidate_is_visible(context: *context::Context, target: CallTarget, function_id: usize) -> bool {
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions_data[function_id];
    if (!candidate_owner_is_compatible(context, function, target)) {
        return false;
    }
    if (target.name_token != context::no_id() && classes::method_is_shadowed(context, target.owner_type, function_id)) {
        return false;
    }
    return functions::function_is_visible(context, function_id, context->current_unit);
}

fn visit_target_candidates(
    context: *context::Context, node: syntax::SyntaxNode, target: CallTarget, candidates: *CandidateResolution) {
    var owner_type: usize = target.owner_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let binding_id: usize = target_binding(context, target, owner_type);
        if (binding_id != context::no_id()) {
            let bindings: *const context::Binding = context->bindings.data as
                    *const context::Binding;
            let candidate_count: usize = bindings[binding_id].candidate_count;
            for (var index: usize = 0; index < candidate_count; index += 1) {
                let function_id: usize = functions::binding_candidate(context, binding_id, index);
                if (target_candidate_is_visible(context, target, function_id)) {
                    consider_candidate(
                        candidates, function_id, candidate_call_status(context, node, function_id, target));
                }
            }
        }
        if (target.name_token == context::no_id()) {
            return;
        }
        owner_type = classes::base_type(context, owner_type);
        if (owner_type == context::no_id()) {
            return;
        }
    }
}

fn call_target_visible_count(context: *context::Context, target: CallTarget) -> usize {
    var count: usize = 0;
    var owner_type: usize = target.owner_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let binding_id: usize = target_binding(context, target, owner_type);
        if (binding_id != context::no_id()) {
            let bindings: *const context::Binding = context->bindings.data as
                    *const context::Binding;
            for (var index: usize = 0; index < bindings[binding_id].candidate_count; index += 1) {
                let function_id: usize = functions::binding_candidate(context, binding_id, index);
                if (functions::function_is_visible(context, function_id, context->current_unit)) {
                    count += 1;
                }
            }
        }
        if (target.name_token == context::no_id()) {
            return count;
        }
        owner_type = classes::base_type(context, owner_type);
        if (owner_type == context::no_id()) {
            return count;
        }
    }
    return count;
}

fn resolve_call_target(
    context: *context::Context, node_id: usize, node: syntax::SyntaxNode, target: CallTarget) -> Resolution {
    if (!target.valid) {
        context->error = runtime::Error.invalid_argument;
        return {status = ResolutionStatus.invalid, function_id = context::no_id()};
    }
    let cached: usize = selected_call(context, node_id);
    if (context->error != runtime::Error.none) {
        return {status = ResolutionStatus.invalid, function_id = context::no_id()};
    }
    if (cached != context::no_id()) {
        let functions_data: *const context::Function = context->functions.data as
                *const context::Function;
        if (cached >= context->function_count ||
            !candidate_target_is_compatible(context, functions_data[cached], target)) {
            context->error = runtime::Error.invalid_argument;
            return {status = ResolutionStatus.invalid, function_id = context::no_id()};
        }
        return {status = ResolutionStatus.selected, function_id = cached};
    }
    var candidates: CandidateResolution = candidate_resolution();
    visit_target_candidates(context, node, target, &candidates);
    let resolution: Resolution = finish_candidate_resolution(candidates);
    if (resolution.status == ResolutionStatus.selected) {
        if (!remember_call_selection(context, node_id, resolution.function_id)) {
            return {status = ResolutionStatus.invalid, function_id = context::no_id()};
        }
    }
    return resolution;
}

fn resolve_call(context: *context::Context, node_id: usize, node: syntax::SyntaxNode, binding_id: usize) -> Resolution {
    let target: CallTarget = {
        binding_id = binding_id, kind = callable::Kind.free_function, owner_type = callable::no_owner(),
        receiver_node = context::no_id(), receiver_type = context::no_id(),
        receiver_category = category::Category.rvalue, receiver_source = ReceiverSource.none,
        name_token = context::no_id(), valid = binding_id != context::no_id(),
    };
    return resolve_call_target(context, node_id, node, target);
}

fn direct_call_binding(context: *context::Context, callee: syntax::SyntaxNode) -> usize {
    if (callee.kind != syntax::SyntaxKind.name_expression) {
        return context::no_id();
    }
    if (callee.child_count != 0) {
        return functions::lookup_qualified_callable_binding(context, context->current_unit, callee, false);
    }
    let local_id: usize = builder::find_local(context, context->current_unit, callee.token_index);
    return local_id == context::no_id() ?
        functions::lookup_callable_binding(context, context->current_unit, callee.token_index) : context::no_id();
}

fn probe_indirect_call(
    context: *context::Context, node: syntax::SyntaxNode,
    callee_node: syntax::SyntaxNode, expected_type: usize) -> Result {
    let callee: Result = expression(context, node.first_child, context::no_id());
    if (callee.status != Status.compatible) {
        return failure_result(callee);
    }
    if (!type_is_valid(context, callee.type_id)) {
        return invalid_result();
    }
    let function_type: type_info::Record = context::type_record(context, callee.type_id);
    if (function_type.kind != type_info::Kind.function_pointer) {
        return incompatible_result();
    }
    let argument_count: usize = node.child_count - 1;
    if (argument_count != function_type.field_count) {
        return incompatible_result();
    }
    let fields: *const type_info::Field = context->types.fields.data as
            *const type_info::Field;
    var child: usize = callee_node.next_sibling;
    for (var argument_index: usize = 0; argument_index < argument_count; argument_index += 1) {
        let parameter_type: usize = fields[function_type.first_field + argument_index].type_id;
        let argument: Result = expression(context, child, parameter_type);
        if (argument.status != Status.compatible) {
            return failure_result(argument);
        }
        child = context::node(context, context->current_unit, child).next_sibling;
    }
    return materialized_result(context, expected_type, function_type.element_type);
}

fn probe_call(context: *context::Context, node_id: usize, node: syntax::SyntaxNode, expected_type: usize) -> Result {
    if (node.child_count == 0) {
        return invalid_result();
    }
    let callee: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let target: CallTarget = direct_call_target(context, node);
    if (!target.valid) {
        if (target.kind == callable::Kind.constructor && target.owner_type != context::no_id()) {
            return incompatible_result();
        }
        return probe_indirect_call(context, node, callee, expected_type);
    }
    let resolution: Resolution = resolve_call_target(context, node_id, node, target);
    if (resolution.status == ResolutionStatus.ambiguous) {
        return result(Status.ambiguous, context::no_id(), context::no_id());
    }
    if (resolution.status != ResolutionStatus.selected) {
        return resolution.status == ResolutionStatus.invalid ? invalid_result() : incompatible_result();
    }
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let result_type: usize = target.receiver_source == ReceiverSource.construction ? target.owner_type :
        functions_data[resolution.function_id].return_type;
    var call_result: Result = materialized_result(context, expected_type, result_type);
    call_result.function_id = resolution.function_id;
    return call_result;
}

fn probe_va_arg(context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> Result {
    if (node.child_count != 2) {
        return invalid_result();
    }
    let list_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let list: Result = expression(context, node.first_child, type_info::BuiltinType.va_list_type as usize);
    if (list.status != Status.compatible) {
        return failure_result(list);
    }
    let type_id: usize = types::resolve_type_node(context, context->current_unit, list_node.next_sibling);
    if (!type_is_valid(context, type_id)) {
        return invalid_result();
    }
    return type_info::is_scalar(context::type_record(context, type_id).kind) ?
        type_result(expected_type, type_id) : incompatible_result();
}

fn intrinsic_index(context: *context::Context, node: syntax::SyntaxNode) -> usize {
    for (var index: usize = 0; index < intrinsics::IntrinsicLimit.entries as usize; index += 1) {
        let entry: intrinsics::IntrinsicEntry = intrinsics::intrinsic_entry(index);
        if (context::token_equals_bytes(
                context, context->current_unit, node.token_index, entry.name, entry.name_length)) {
            return index;
        }
    }
    return context::no_id();
}

fn probe_source_intrinsic(
    context: *context::Context, entry: intrinsics::IntrinsicEntry, expected_type: usize) -> Result {
    if (entry.lowering == intrinsics::IntrinsicLowering.source_line) {
        return type_result(expected_type, type_info::BuiltinType.unsigned_size as usize);
    }
    let pointer: type_info::IdResult = type_info::table_pointer(
        &context->types, type_info::BuiltinType.unsigned_8 as usize, true, false);
    context->error = pointer.error;
    return pointer.error == runtime::Error.none ? type_result(expected_type, pointer.type_id) : invalid_result();
}

fn probe_intrinsic(context: *context::Context, node: syntax::SyntaxNode, expected_type: usize) -> Result {
    let index: usize = intrinsic_index(context, node);
    if (index == context::no_id()) {
        return invalid_result();
    }
    let entry: intrinsics::IntrinsicEntry = intrinsics::intrinsic_entry(index);
    if (node.child_count != entry.arity) {
        return invalid_result();
    }
    if (entry.operand_class == intrinsics::IntrinsicOperandClass.none) {
        return probe_source_intrinsic(context, entry, expected_type);
    }
    if (entry.operand_class == intrinsics::IntrinsicOperandClass.embedded_file) {
        return invalid_result();
    }
    let first_expected: usize = entry.operand_class == intrinsics::IntrinsicOperandClass.integer_overflow ?
        context::no_id() : expected_type;
    let first: Result = expression(context, node.first_child, first_expected);
    if (first.status != Status.compatible) {
        return first;
    }
    if (entry.operand_class == intrinsics::IntrinsicOperandClass.integer_overflow) {
        return type_result(expected_type, type_info::BuiltinType.boolean as usize);
    }
    let first_record: type_info::Record = context::type_record(context, first.type_id);
    let integer_class: bool = entry.operand_class == intrinsics::IntrinsicOperandClass.integer_scalar ||
        entry.operand_class == intrinsics::IntrinsicOperandClass.integer_scalar_rotated;
    let wide_integer: bool = entry.operand_class == intrinsics::IntrinsicOperandClass.integer_scalar_wide;
    let float_class: bool = entry.operand_class == intrinsics::IntrinsicOperandClass.float_scalar ||
        entry.operand_class == intrinsics::IntrinsicOperandClass.float_scalar_binary;
    let accepted_integer_class: bool = integer_class || wide_integer;
    let integer_is_valid: bool = type_info::is_integer(first_record.kind) && accepted_integer_class;
    let float_is_valid: bool = type_info::is_float(first_record.kind) && float_class;
    let operand_is_valid: bool = integer_is_valid || float_is_valid;
    if (!operand_is_valid) {
        return incompatible_result();
    }
    if (entry.arity >= 2) {
        let first_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
        let second_expected: usize = integer_class ? type_info::BuiltinType.unsigned_size as usize : first.type_id;
        let second: Result = expression(context, first_node.next_sibling, second_expected);
        if (second.status != Status.compatible) {
            return failure_result(second);
        }
    }
    return type_result(expected_type, first.type_id);
}
