module luna.bootstrap.middleend.semantic.expr.base;

import luna.compiler.sema.domain as domain;

fn invalid_expression()
    -> context::Expression {
    let none: usize = context::no_id();
    return {
        type_id = none, value_id = none, address_id = none, constant_value = 0, has_constant = false,
        category = domain::ValueCategory.rvalue, valid = false, bitfield_segment = context::no_id(),
    };
}
