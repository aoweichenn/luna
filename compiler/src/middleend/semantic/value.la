module luna.bootstrap.middleend.semantic.value;

fn lvalue(writable: bool, volatile_access: bool) -> Category {
    if (volatile_access) {
        return writable ? Category.writable_volatile_lvalue : Category.volatile_lvalue;
    }
    return writable ? Category.writable_lvalue : Category.read_only_lvalue;
}

fn xvalue(read_only: bool) -> Category {
    return read_only ? Category.read_only_xvalue : Category.xvalue;
}

fn pointee(pointer: type_info::Record) -> Category {
    if (pointer.kind != type_info::Kind.pointer) {
        return Category.rvalue;
    }
    let writable: bool = (pointer.flags & (type_info::Flag.read_only as usize)) == 0;
    let volatile_access: bool = (pointer.flags & (type_info::Flag.volatile_pointee as usize)) != 0;
    return lvalue(writable, volatile_access);
}

fn project(source: Category) -> Category {
    switch (source) {
    case Category.temporary, Category.temporary_bitfield {
        return Category.temporary;
    }
    case Category.read_only_lvalue, Category.read_only_bitfield {
        return Category.read_only_lvalue;
    }
    case Category.writable_lvalue, Category.writable_bitfield {
        return Category.writable_lvalue;
    }
    case Category.volatile_lvalue, Category.volatile_bitfield {
        return Category.volatile_lvalue;
    }
    case Category.writable_volatile_lvalue, Category.writable_volatile_bitfield {
        return Category.writable_volatile_lvalue;
    }
    case Category.xvalue, Category.read_only_xvalue {
        return source;
    }
    default {
        return Category.rvalue;
    }
    }
}

fn as_bitfield(source: Category) -> Category {
    switch (source) {
    case Category.read_only_lvalue, Category.read_only_bitfield {
        return Category.read_only_bitfield;
    }
    case Category.writable_lvalue, Category.writable_bitfield {
        return Category.writable_bitfield;
    }
    case Category.volatile_lvalue, Category.volatile_bitfield {
        return Category.volatile_bitfield;
    }
    case Category.writable_volatile_lvalue, Category.writable_volatile_bitfield {
        return Category.writable_volatile_bitfield;
    }
    case Category.temporary, Category.temporary_bitfield {
        return Category.temporary_bitfield;
    }
    case Category.xvalue, Category.read_only_xvalue {
        return Category.temporary_bitfield;
    }
    default {
        return Category.rvalue;
    }
    }
}

fn is_lvalue(category: Category) -> bool {
    switch (category) {
    case Category.read_only_lvalue, Category.writable_lvalue,
        Category.volatile_lvalue, Category.writable_volatile_lvalue,
        Category.read_only_bitfield, Category.writable_bitfield,
        Category.volatile_bitfield, Category.writable_volatile_bitfield {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_xvalue(category: Category) -> bool {
    return category == Category.xvalue || category == Category.read_only_xvalue;
}

fn is_expiring(category: Category) -> bool {
    return is_xvalue(category) || is_temporary(category);
}

fn has_storage(category: Category) -> bool {
    return category != Category.rvalue;
}

fn is_addressable(category: Category) -> bool {
    switch (category) {
    case Category.read_only_lvalue, Category.writable_lvalue,
        Category.volatile_lvalue, Category.writable_volatile_lvalue, Category.xvalue, Category.read_only_xvalue {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_assignable(category: Category) -> bool {
    switch (category) {
    case Category.writable_lvalue, Category.writable_volatile_lvalue,
        Category.writable_bitfield, Category.writable_volatile_bitfield, Category.xvalue {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_writable(category: Category) -> bool {
    return is_assignable(category);
}

fn is_volatile(category: Category) -> bool {
    switch (category) {
    case Category.volatile_lvalue, Category.writable_volatile_lvalue,
        Category.volatile_bitfield, Category.writable_volatile_bitfield {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_temporary(category: Category) -> bool {
    return category == Category.temporary || category == Category.temporary_bitfield;
}

fn reference_binding_rank(reference: type_info::Record, actual: Category) -> usize {
    if (reference.kind != type_info::Kind.reference) {
        return type_info::no_id();
    }
    let read_only: bool = (reference.flags & (type_info::Flag.read_only as usize)) != 0;
    let rvalue: bool = (reference.flags & (type_info::Flag.rvalue_reference as usize)) != 0;
    if (rvalue) {
        if (!is_expiring(actual)) {
            return type_info::no_id();
        }
        return read_only ? ReferenceRank.qualified as usize : ReferenceRank.exact as usize;
    }
    if (is_lvalue(actual)) {
        if (!read_only && !is_writable(actual)) {
            return type_info::no_id();
        }
        return read_only && is_writable(actual) ? ReferenceRank.qualified as usize : ReferenceRank.exact as usize;
    }
    return read_only && is_expiring(actual) ? ReferenceRank.temporary as usize : type_info::no_id();
}
