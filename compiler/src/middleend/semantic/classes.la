module luna.bootstrap.middleend.semantic.classes;

import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.types as types;
import luna.compiler.ir as ir;
import luna.compiler.lexer as lexer;
import luna.compiler.syntax as syntax;
import luna.compiler.types as type_info;
import luna.runtime as runtime;
import luna.std.bytes as bytes;
import luna.std.memory as memory;

struct RecordValidator {
    valid: bool;
}

enum AccessFlagEncoding: usize {
    public_access = 524288, protected_access = 1048576, private_access = 2097152,
}

fn require(validator: *RecordValidator, condition: bool) {
    validator->valid = validator->valid && condition;
}

fn access_from_flags(flags: usize) -> domain::ClassAccess {
    let restricted: usize = (syntax::SyntaxFlag.protected_access as usize) |
        (syntax::SyntaxFlag.private_access as usize);
    let access_flags: usize = flags & ((syntax::SyntaxFlag.public_access as usize) | restricted);
    switch (access_flags as AccessFlagEncoding) {
    case AccessFlagEncoding.public_access {
        return domain::ClassAccess.public_access;
    }
    case AccessFlagEncoding.protected_access {
        return domain::ClassAccess.protected_access;
    }
    case AccessFlagEncoding.private_access {
        return domain::ClassAccess.private_access;
    }
    default {
        return domain::ClassAccess.invalid;
    }
    }
}

fn class_flags(context: *context::Context, record: type_info::Record) -> usize {
    var flags: usize = (record.flags & (type_info::Flag.exported as usize)) != 0 ?
        domain::ClassFlag.exported as usize : domain::ClassFlag.none as usize;
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    if ((declaration.flags & (syntax::SyntaxFlag.final_class as usize)) != 0) {
        flags |= domain::ClassFlag.final_class as usize;
    }
    return flags;
}

fn append_class(context: *context::Context, type_id: usize, record: type_info::Record) -> bool {
    context->error = context->classes.append_record(type_id, class_flags(context, record));
    return context->error == runtime::Error.none;
}

fn report_class_member(context: *context::Context, record: type_info::Record, member: syntax::SyntaxNode) {
    context::add_diagnostic(
        context, context::DiagnosticKind.invalid_class_member, record.declaration_unit, member.span,
        context::no_id(), context::empty_span(), record.declaration_node);
}

fn field_declaration_is_valid(context: *context::Context, unit_index: usize, field: syntax::SyntaxNode) -> bool {
    if (field.kind != syntax::SyntaxKind.field_declaration ||
        access_from_flags(field.flags) == domain::ClassAccess.invalid) {
        return false;
    }
    let unsupported_flags: usize = (syntax::SyntaxFlag.anonymous as usize) | (syntax::SyntaxFlag.flexible as usize);
    if (field.child_count != 1 || (field.flags & unsupported_flags) != 0) {
        return false;
    }
    let type_node: syntax::SyntaxNode = context::node(context, unit_index, field.first_child);
    let flexible_array: bool = type_node.kind == syntax::SyntaxKind.type_array &&
        (type_node.flags & (syntax::SyntaxFlag.flexible as usize)) != 0;
    return !flexible_array;
}

fn class_members_are_valid(context: *context::Context, record: type_info::Record, diagnose: bool) -> bool {
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    let base_node: usize = (declaration.flags & (syntax::SyntaxFlag.has_base as usize)) != 0 ?
        declaration.first_child : context::no_id();
    var valid: bool = true;
    for (var child: usize = declaration.first_child; child != context::no_id();
        child = context::node(context, record.declaration_unit, child).next_sibling) {
        if (child == base_node) {
            continue;
        }
        let member: syntax::SyntaxNode = context::node(context, record.declaration_unit, child);
        let field_is_invalid: bool = member.kind == syntax::SyntaxKind.field_declaration &&
            !field_declaration_is_valid(context, record.declaration_unit, member);
        let data_or_method: bool = member.kind == syntax::SyntaxKind.field_declaration ||
            member.kind == syntax::SyntaxKind.function_declaration;
        let class_metadata: bool = member.kind == syntax::SyntaxKind.friend_declaration ||
            member.kind == syntax::SyntaxKind.attribute;
        let kind_is_invalid: bool = !data_or_method && !class_metadata;
        if (field_is_invalid || kind_is_invalid) {
            if (diagnose) {
                report_class_member(context, record, member);
            }
            valid = false;
        }
    }
    return valid;
}

fn find_record(context: *context::Context, type_id: usize) -> usize {
    let records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    for (var record_id: usize = 0; record_id < context->classes.record_count(); record_id += 1) {
        if (records[record_id].type_id == type_id) {
            return record_id;
        }
    }
    return context::no_id();
}

fn report_base_error(
    context: *context::Context, kind: context::DiagnosticKind, derived: type_info::Record,
    base_node: usize, detail: usize) {
    context::add_diagnostic(
        context, kind, derived.declaration_unit, context::node(context, derived.declaration_unit, base_node).span,
        context::no_id(), context::empty_span(), detail);
}

fn set_base_relation(
    context: *context::Context, record_id: usize, derived: type_info::Record, base_node: usize, base_type: usize) {
    let base: type_info::Record = context::type_record(context, base_type);
    let base_record: usize = find_record(context, base_type);
    let base_is_class: bool = base.kind == type_info::Kind.class_type && base_record != context::no_id();
    if (!base_is_class) {
        report_base_error(context, context::DiagnosticKind.invalid_base_class, derived, base_node, base_type);
        return;
    }
    let opaque_relation: bool = type_info::is_opaque_class(derived) || type_info::is_opaque_class(base);
    if (opaque_relation) {
        report_base_error(context, context::DiagnosticKind.invalid_base_class, derived, base_node, base_type);
        return;
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    let base_is_final: bool = (records[base_record].flags & (domain::ClassFlag.final_class as usize)) != 0;
    if (base_is_final) {
        report_base_error(context, context::DiagnosticKind.invalid_base_class, derived, base_node, base_type);
        return;
    }
    context->error = context->types.set_base(records[record_id].type_id, base_type);
}

fn collect_class_base(context: *context::Context, record_id: usize, record: type_info::Record) {
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    if ((declaration.flags & (syntax::SyntaxFlag.has_base as usize)) == 0) {
        return;
    }
    let base_node: usize = declaration.first_child;
    let base_type: usize = types::resolve_type_node(context, record.declaration_unit, base_node);
    if (base_type != context::no_id()) {
        set_base_relation(context, record_id, record, base_node, base_type);
    }
}

fn validate_base_chain(context: *context::Context, record: domain::ClassRecord) {
    var current: usize = context::type_record(context, record.type_id).base_type;
    for (var depth: usize = 0; current != context::no_id(); depth += 1) {
        if (depth >= context::Limit.maximum_type_depth as usize || current == record.type_id) {
            let derived: type_info::Record = context::type_record(context, record.type_id);
            let declaration: syntax::SyntaxNode =
                context::node(context, derived.declaration_unit, derived.declaration_node);
            report_base_error(
                context, context::DiagnosticKind.inheritance_cycle, derived, declaration.first_child, current);
            return;
        }
        current = context::type_record(context, current).base_type;
    }
}

fn collect_bases(context: *context::Context) -> bool {
    var records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        let type_record: type_info::Record = context::type_record(context, records[record_id].type_id);
        collect_class_base(context, record_id, type_record);
    }
    records = context->classes.record_data() as *const domain::ClassRecord;
    for (var record_id: usize = 0; record_id < context->classes.record_count(); record_id += 1) {
        validate_base_chain(context, records[record_id]);
    }
    return context->error == runtime::Error.none;
}

fn base_type(context: *context::Context, type_id: usize) -> usize {
    if (type_id >= context->types.size()) {
        return context::no_id();
    }
    let record: type_info::Record = context::type_record(context, type_id);
    if (record.kind != type_info::Kind.class_type) {
        return context::no_id();
    }
    return record.base_type;
}

fn is_base_of(context: *context::Context, candidate_base: usize, derived_type: usize) -> bool {
    var current: usize = derived_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        if (current == candidate_base) {
            return true;
        }
        current = base_type(context, current);
        if (current == context::no_id()) {
            return false;
        }
    }
    return false;
}

fn collect_classes(context: *context::Context) -> bool {
    let store_is_empty: bool = context->classes.record_count() == 0 && context->classes.field_count() == 0;
    if (!store_is_empty || context->classes.method_count() != 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let records: *const type_info::Record = context->types.record_data() as
            *const type_info::Record;
    for (var type_id: usize = type_info::BuiltinType.count as usize;
        type_id < context->types.size() && context->error == runtime::Error.none;
        type_id += 1) {
        let record: type_info::Record = records[type_id];
        if (record.kind == type_info::Kind.class_type) {
            class_members_are_valid(context, record, true);
            append_class(context, type_id, record);
        }
    }
    return context->error == runtime::Error.none;
}

fn type_contains_class_value(context: *context::Context, type_id: usize) -> bool {
    var current: usize = type_id;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record: type_info::Record = context::type_record(context, current);
        if (record.kind == type_info::Kind.class_type) {
            return true;
        }
        if (record.kind != type_info::Kind.array) {
            return false;
        }
        current = record.element_type;
    }
    return true;
}

fn collect_fields(context: *context::Context) -> bool {
    if (context->classes.field_count() != 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let class_records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    let type_records: *const type_info::Record = context->types.record_data() as
            *const type_info::Record;
    let type_fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        let owner: type_info::Record = type_records[class_records[record_id].type_id];
        for (var index: usize = 0; index < owner.field_count; index += 1) {
            let field_id: usize = owner.first_field + index;
            let field: type_info::Field = type_fields[field_id];
            let declaration: syntax::SyntaxNode =
                context::node(context, field.declaration_unit, field.declaration_node);
            let access: domain::ClassAccess = access_from_flags(declaration.flags);
            context->error = context->classes.append_field(record_id, {field_id = field_id, access = access});
        }
    }
    return context->error == runtime::Error.none;
}

fn prepare_generic_class(context: *context::Context, type_id: usize) -> bool {
    let record_id: usize = find_record(context, type_id);
    if (record_id == context::no_id()) {
        return false;
    }
    if (!types::require_complete_type(context, type_id)) {
        return false;
    }
    let type_record: type_info::Record = context::type_record(context, type_id);
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    if (records[record_id].field_count == type_record.field_count) {
        return true;
    }
    if (records[record_id].field_count != 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
    for (var index: usize = 0; index < type_record.field_count; index += 1) {
        let field_id: usize = type_record.first_field + index;
        let field: type_info::Field = fields[field_id];
        let declaration: syntax::SyntaxNode = context::node(context, field.declaration_unit, field.declaration_node);
        let class_field: domain::ClassField = {
            field_id = field_id, access = access_from_flags(declaration.flags),
        };
        context->error = context->classes.append_field(record_id, class_field);
        if (context->error != runtime::Error.none) {
            return false;
        }
    }
    return true;
}

fn report_friend(
    context: *context::Context, type_record: type_info::Record, declaration: syntax::SyntaxNode, detail: usize) {
    context::add_diagnostic(
        context, context::DiagnosticKind.invalid_friend, type_record.declaration_unit, declaration.span,
        context::no_id(), context::empty_span(), detail);
}

fn friend_is_duplicate(context: *context::Context, record: domain::ClassRecord, friend_type: usize) -> bool {
    let friends: *const domain::ClassFriend = context->classes.friend_data() as *const domain::ClassFriend;
    for (var index: usize = 0; index < record.friend_count; index += 1) {
        if (friends[record.first_friend + index].friend_type == friend_type) {
            return true;
        }
    }
    return false;
}

fn collect_class_friends(context: *context::Context, record_id: usize, record: domain::ClassRecord) {
    let owner: type_info::Record = context::type_record(context, record.type_id);
    let declaration: syntax::SyntaxNode = context::node(context, owner.declaration_unit, owner.declaration_node);
    for (var child: usize = declaration.first_child;
        child != context::no_id() && context->error == runtime::Error.none;
        child = context::node(context, owner.declaration_unit, child).next_sibling) {
        let friend_declaration: syntax::SyntaxNode = context::node(context, owner.declaration_unit, child);
        if (friend_declaration.kind != syntax::SyntaxKind.friend_declaration) {
            continue;
        }
        if (friend_declaration.child_count != 1) {
            report_friend(context, owner, friend_declaration, context::no_id());
            continue;
        }
        let target_node: syntax::SyntaxNode = context::node(
            context, owner.declaration_unit, friend_declaration.first_child);
        if (target_node.kind != syntax::SyntaxKind.type_named || target_node.child_count != 0) {
            report_friend(context, owner, friend_declaration, context::no_id());
            continue;
        }
        let friend_type: usize = types::resolve_type_node(
            context, owner.declaration_unit, friend_declaration.first_child);
        let target: type_info::Record = context::type_record(context, friend_type);
        let classes_are_distinct: bool = friend_type != record.type_id && target.kind == type_info::Kind.class_type;
        let modules_match: bool = context->symbols.unit_module(context, owner.declaration_unit) ==
            context->symbols.unit_module(context, target.declaration_unit);
        let current: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
        let duplicate: bool = friend_is_duplicate(context, current[record_id], friend_type);
        let relationship_is_valid: bool = classes_are_distinct && modules_match;
        if (!relationship_is_valid || duplicate) {
            report_friend(context, owner, friend_declaration, friend_type);
            continue;
        }
        let friend_record: domain::ClassFriend = {
            owner_type = record.type_id, friend_type = friend_type,
        };
        context->error = context->classes.append_friend(record_id, friend_record);
    }
}

fn collect_friends(context: *context::Context) -> bool {
    if (context->classes.friend_count() != 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        collect_class_friends(context, record_id, records[record_id]);
    }
    return context->error == runtime::Error.none;
}

fn empty_slice_is_valid(first: usize, count: usize) -> bool {
    return first == context::no_id() && count == 0;
}

fn field_slice_is_valid(context: *context::Context, record: domain::ClassRecord,
    type_record: type_info::Record) -> bool {
    if (record.field_count != type_record.field_count) {
        return false;
    }
    if (record.field_count == 0) {
        return empty_slice_is_valid(record.first_field, record.field_count);
    }
    if (record.first_field >= context->classes.field_count()) {
        return false;
    }
    let fields: *const domain::ClassField = context->classes.field_data() as
            *const domain::ClassField;
    for (var index: usize = 0; index < record.field_count; index += 1) {
        let field: domain::ClassField = fields[record.first_field + index];
        let expected: usize = type_record.first_field + index;
        if (field.field_id != expected || field.access == domain::ClassAccess.invalid) {
            return false;
        }
    }
    return true;
}

fn friend_slice_is_valid(context: *context::Context, record: domain::ClassRecord, expected_first: usize) -> bool {
    if (record.friend_count == 0) {
        return record.first_friend == context::no_id();
    }
    if (record.first_friend != expected_first || record.first_friend >= context->classes.friend_count()) {
        return false;
    }
    let friends: *const domain::ClassFriend = context->classes.friend_data() as *const domain::ClassFriend;
    for (var index: usize = 0; index < record.friend_count; index += 1) {
        let friend_record: domain::ClassFriend = friends[record.first_friend + index];
        if (friend_record.owner_type != record.type_id || friend_record.friend_type == record.type_id) {
            return false;
        }
    }
    return true;
}

fn class_layout_is_valid(context: *context::Context, record: domain::ClassRecord,
    type_record: type_info::Record) -> bool {
    let polymorphic: bool = (record.flags & (domain::ClassFlag.polymorphic as usize)) != 0;
    if (!polymorphic) {
        return type_record.vptr_offset == context::no_id();
    }
    if (type_record.vptr_offset == context::no_id()) {
        return false;
    }
    let pointer_size: usize = domain::ClassLayout.vptr_size_bytes as usize;
    let pointer_alignment: usize = domain::ClassLayout.vptr_alignment_bytes as usize;
    let pointer_range_is_valid: bool = type_record.vptr_offset <= type_record.size_bytes &&
        pointer_size <= type_record.size_bytes - type_record.vptr_offset;
    let pointer_alignment_is_valid: bool = type_record.alignment_bytes >= pointer_alignment &&
        (type_record.vptr_offset & (pointer_alignment - 1)) == 0;
    if (!pointer_range_is_valid || !pointer_alignment_is_valid) {
        return false;
    }
    let inherited_type: usize = type_record.base_type;
    let base_record_id: usize = find_record(context, inherited_type);
    if (base_record_id != context::no_id()) {
        let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
        let base: domain::ClassRecord = records[base_record_id];
        let base_is_polymorphic: bool = (base.flags & (domain::ClassFlag.polymorphic as usize)) != 0;
        if (base_is_polymorphic) {
            return type_record.vptr_offset == context::type_record(context, inherited_type).vptr_offset;
        }
    }
    let base_size: usize = inherited_type == context::no_id() ? 0 :
        context::type_record(context, inherited_type).size_bytes;
    var expected_offset: usize = 0;
    return context::align_up(base_size, pointer_alignment, &expected_offset) &&
        type_record.vptr_offset == expected_offset;
}

fn record_is_valid(
    context: *context::Context, record: domain::ClassRecord, type_id: usize,
    type_record: type_info::Record, expected_friend: usize) -> bool {
    var validator: RecordValidator = {valid = true};
    require(&validator, record.type_id == type_id);
    require(&validator, type_record.kind == type_info::Kind.class_type);
    require(&validator, (type_record.flags & (type_info::Flag.complete as usize)) != 0);
    require(&validator, type_record.size_bytes != 0 && type_record.alignment_bytes != 0);
    require(&validator, record.descriptor_global == context::no_id() && record.vtable_global == context::no_id());
    require(&validator, class_layout_is_valid(context, record, type_record));
    require(&validator, field_slice_is_valid(context, record, type_record));
    require(&validator, empty_slice_is_valid(record.first_method, record.method_count));
    require(&validator, friend_slice_is_valid(context, record, expected_friend));
    let layout_flags: usize = type_record.vptr_offset == context::no_id() ? domain::ClassFlag.none as usize :
        domain::ClassFlag.polymorphic as usize;
    require(&validator, record.flags == (class_flags(context, type_record) | layout_flags));
    return validator.valid;
}

fn validate_classes(context: *context::Context) -> bool {
    let types: *const type_info::Record = context->types.record_data() as
            *const type_info::Record;
    let classes: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    var class_index: usize = 0;
    var expected_friend: usize = 0;
    for (var type_id: usize = type_info::BuiltinType.count as usize; type_id < context->types.size();
        type_id += 1) {
        let type_record: type_info::Record = types[type_id];
        if (type_record.kind != type_info::Kind.class_type) {
            continue;
        }
        if (class_index >= context->classes.record_count()) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        if (class_members_are_valid(context, type_record, false) &&
            !record_is_valid(context, classes[class_index], type_id, type_record, expected_friend)) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        expected_friend += classes[class_index].friend_count;
        class_index += 1;
    }
    let all_classes_are_valid: bool = class_index == context->classes.record_count();
    let all_friends_are_owned: bool = expected_friend == context->classes.friend_count();
    if (!all_classes_are_valid || !all_friends_are_owned) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    return true;
}

fn field_access(context: *context::Context, field_id: usize) -> domain::ClassAccess {
    let fields: *const domain::ClassField = context->classes.field_data() as
            *const domain::ClassField;
    for (var index: usize = 0; index < context->classes.field_count(); index += 1) {
        if (fields[index].field_id == field_id) {
            return fields[index].access;
        }
    }
    return domain::ClassAccess.invalid;
}

fn current_owner_type(context: *context::Context) -> usize {
    if (context->current_function >= context->function_count) {
        return context::no_id();
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    return functions[context->current_function].identity.owner_type;
}

fn access_is_available(context: *context::Context, access: domain::ClassAccess, declaring_type: usize) -> bool {
    if (access == domain::ClassAccess.public_access) {
        return true;
    }
    if (access == domain::ClassAccess.invalid) {
        return false;
    }
    let current: usize = current_owner_type(context);
    if (access == domain::ClassAccess.private_access) {
        if (current == declaring_type) {
            return true;
        }
        let record_id: usize = find_record(context, declaring_type);
        if (record_id == context::no_id()) {
            return false;
        }
        let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
        let friends: *const domain::ClassFriend = context->classes.friend_data() as *const domain::ClassFriend;
        let record: domain::ClassRecord = records[record_id];
        for (var index: usize = 0; index < record.friend_count; index += 1) {
            if (friends[record.first_friend + index].friend_type == current) {
                return true;
            }
        }
        return false;
    }
    return is_base_of(context, declaring_type, current);
}

fn field_is_accessible(context: *context::Context, field_id: usize) -> bool {
    if (field_id >= context->types.field_size()) {
        return false;
    }
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    if (!types::opaque_value_is_available(context, fields[field_id].owner_type, context->current_unit)) {
        return false;
    }
    return access_is_available(context, field_access(context, field_id), fields[field_id].owner_type);
}

fn method_declaration_unit(function: context::Function) -> usize {
    return function.interface_unit != context::no_id() ? function.interface_unit : function.implementation_unit;
}

fn method_declaration(context: *context::Context, function: context::Function) -> syntax::SyntaxNode {
    let node_index: usize = function.interface_node != context::no_id() ?
        function.interface_node : function.implementation_node;
    return context::node(context, method_declaration_unit(function), node_index);
}

fn method_access_from_function(context: *context::Context, function: context::Function) -> domain::ClassAccess {
    return access_from_flags(method_declaration(context, function).flags);
}

fn method_dispatch(context: *context::Context, function: context::Function) -> domain::MethodDispatch {
    if (function.identity.kind == domain::CallableKind.static_method) {
        return domain::MethodDispatch.static_method;
    }
    let declaration: syntax::SyntaxNode = method_declaration(context, function);
    if ((declaration.flags & (syntax::SyntaxFlag.abstract_method as usize)) != 0) {
        return domain::MethodDispatch.abstract_method;
    }
    let virtual_flags: usize = (syntax::SyntaxFlag.virtual_method as usize) |
        (syntax::SyntaxFlag.override_method as usize);
    return (declaration.flags & virtual_flags) != 0 ? domain::MethodDispatch.virtual_method :
        domain::MethodDispatch.direct;
}

fn method_flags(context: *context::Context, function: context::Function) -> usize {
    let declaration: syntax::SyntaxNode = method_declaration(context, function);
    return (declaration.flags & (syntax::SyntaxFlag.final_method as usize)) != 0 ?
        domain::MethodFlag.final_method as usize : domain::MethodFlag.none as usize;
}

fn method_field_collision(context: *context::Context, function: context::Function) -> usize {
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    let symbol: context::Symbol = symbols[function.symbol_id];
    var current: usize = function.identity.owner_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let owner: type_info::Record = context::type_record(context, current);
        for (var index: usize = 0; index < owner.field_count; index += 1) {
            let field_id: usize = owner.first_field + index;
            let field: type_info::Field = fields[field_id];
            if (context::tokens_equal(
                    context, symbol.declaration_unit, symbol.name_token, field.declaration_unit, field.name_token)) {
                return field_id;
            }
        }
        current = owner.base_type;
        if (current == context::no_id()) {
            return context::no_id();
        }
    }
    return context::no_id();
}

fn report_method_field_collision(context: *context::Context, function: context::Function, field_id: usize) {
    let unit_index: usize = method_declaration_unit(function);
    let declaration: syntax::SyntaxNode = method_declaration(context, function);
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    let field: type_info::Field = fields[field_id];
    context::add_diagnostic(
        context, context::DiagnosticKind.invalid_class_member, unit_index, declaration.span,
        field.declaration_unit, context::node(context, field.declaration_unit, field.declaration_node).span, field_id);
}

fn append_record_methods(
    context: *context::Context, record_id: usize, record: domain::ClassRecord,
    functions: *const context::Function, ordered: *const usize) {
    for (var order_index: usize = 0;
        order_index < context->callable_candidate_count && context->error == runtime::Error.none;
        order_index += 1) {
        let function_id: usize = ordered[order_index];
        let function: context::Function = functions[function_id];
        if (function.identity.owner_type != record.type_id) {
            continue;
        }
        let collision: usize = method_field_collision(context, function);
        if (collision != context::no_id()) {
            report_method_field_collision(context, function, collision);
            continue;
        }
        context->error = context->classes.append_method(record_id, {
                function_id = function_id, access = method_access_from_function(context, function),
                dispatch = method_dispatch(context, function), virtual_slot = context::no_id(),
                flags = method_flags(context, function),
            });
    }
}

fn collect_methods(context: *context::Context) -> bool {
    if (context->classes.method_count() != 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let ordered: *const usize = context->callable_candidates.data as
            *const usize;
    let records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        append_record_methods(context, record_id, records[record_id], functions, ordered);
    }
    return context->error == runtime::Error.none;
}

fn collect_generic_methods(context: *context::Context, type_id: usize) -> bool {
    let record_id: usize = find_record(context, type_id);
    if (record_id == context::no_id()) {
        return false;
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    if (records[record_id].method_count != 0) {
        return true;
    }
    let functions: *const context::Function = context->functions.data as *const context::Function;
    let ordered: *const usize = context->callable_candidates.data as *const usize;
    append_record_methods(context, record_id, records[record_id], functions, ordered);
    return context->error == runtime::Error.none;
}

enum HierarchyState: u8 {
    unvisited, visiting, complete,
}

fn class_declares_virtual_contract(context: *context::Context, record: domain::ClassRecord) -> bool {
    let type_record: type_info::Record = context::type_record(context, record.type_id);
    let declaration: syntax::SyntaxNode = context::node(
        context, type_record.declaration_unit, type_record.declaration_node);
    for (var child: usize = declaration.first_child; child != context::no_id();
        child = context::node(context, type_record.declaration_unit, child).next_sibling) {
        let member: syntax::SyntaxNode = context::node(context, type_record.declaration_unit, child);
        if (member.kind != syntax::SyntaxKind.function_declaration) {
            continue;
        }
        let virtual_flags: usize = (syntax::SyntaxFlag.virtual_method as usize) |
            (syntax::SyntaxFlag.abstract_method as usize);
        if ((member.flags & virtual_flags) != 0) {
            return true;
        }
    }
    return false;
}

fn prepare_class_layout(context: *context::Context, record_id: usize, states: *u8, depth: usize) {
    if (states[record_id] == HierarchyState.complete as u8) {
        return;
    }
    if (depth >= context::Limit.maximum_type_depth as usize) {
        context->error = runtime::Error.invalid_argument;
        return;
    }
    if (states[record_id] == HierarchyState.visiting as u8) {
        return;
    }
    states[record_id] = HierarchyState.visiting as u8;
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let record: domain::ClassRecord = records[record_id];
    let base_record_id: usize = find_record(context, base_type(context, record.type_id));
    if (base_record_id != context::no_id()) {
        prepare_class_layout(context, base_record_id, states, depth + 1);
    }
    let updated_records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let inherits_polymorphism: bool = base_record_id != context::no_id() &&
        (updated_records[base_record_id].flags & (domain::ClassFlag.polymorphic as usize)) != 0;
    let introduces_polymorphism: bool = class_declares_virtual_contract(context, record);
    if (inherits_polymorphism || introduces_polymorphism) {
        context->error = context->classes.mark_polymorphic(record_id);
    }
    states[record_id] = HierarchyState.complete as u8;
}

fn prepare_layouts(context: *context::Context) -> bool {
    let created: bytes::BufferResult = bytes::with_capacity(context->classes.record_count());
    var states: bytes::Buffer = created.buffer;
    context->error = created.error;
    if (created.error != runtime::Error.none) {
        return false;
    }
    states.length = context->classes.record_count();
    context->error = memory::fill(states.data, HierarchyState.unvisited as u8, states.length);
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        prepare_class_layout(context, record_id, states.data, 0);
    }
    let release_error: runtime::Error = bytes::release(states);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none;
}

fn method_key_matches(context: *context::Context, left_id: usize, right_id: usize) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    let left: context::Function = functions[left_id];
    let right: context::Function = functions[right_id];
    let kinds_match: bool = left.identity.kind == right.identity.kind;
    let receivers_match: bool = left.identity.receiver == right.identity.receiver;
    let shapes_match: bool = kinds_match && receivers_match;
    if (!shapes_match || left.parameter_count != right.parameter_count) {
        return false;
    }
    let left_symbol: context::Symbol = symbols[left.symbol_id];
    let right_symbol: context::Symbol = symbols[right.symbol_id];
    if (!context::tokens_equal(
            context, left_symbol.declaration_unit, left_symbol.name_token,
            right_symbol.declaration_unit, right_symbol.name_token)) {
        return false;
    }
    for (var index: usize = 0; index < left.parameter_count; index += 1) {
        let left_type: usize = parameters[left.first_parameter + index].type_id;
        let right_type: usize = parameters[right.first_parameter + index].type_id;
        if (left_type != right_type) {
            return false;
        }
    }
    return true;
}

fn method_is_shadowed(context: *context::Context, lookup_type: usize, function_id: usize) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let declaring_type: usize = functions[function_id].identity.owner_type;
    var current: usize = lookup_type;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        if (current == declaring_type || current == context::no_id()) {
            return false;
        }
        let record_id: usize = find_record(context, current);
        if (record_id == context::no_id()) {
            return false;
        }
        let records: *const domain::ClassRecord = context->classes.record_data() as
                *const domain::ClassRecord;
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        let record: domain::ClassRecord = records[record_id];
        for (var index: usize = 0; index < record.method_count; index += 1) {
            let derived_function: usize = methods[record.first_method + index].function_id;
            if (method_key_matches(context, derived_function, function_id)) {
                return true;
            }
        }
        current = base_type(context, record.type_id);
    }
    return false;
}

fn method_is_abstract(context: *context::Context, function_id: usize) -> bool {
    let methods: *const domain::ClassMethod = context->classes.method_data() as
            *const domain::ClassMethod;
    for (var index: usize = 0; index < context->classes.method_count(); index += 1) {
        if (methods[index].function_id == function_id) {
            return methods[index].dispatch == domain::MethodDispatch.abstract_method;
        }
    }
    return false;
}

fn class_is_abstract(context: *context::Context, type_id: usize) -> bool {
    let record_id: usize = find_record(context, type_id);
    if (record_id == context::no_id()) {
        return false;
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    return (records[record_id].flags & (domain::ClassFlag.abstract_class as usize)) != 0;
}

fn inherited_method_named_like_field(context: *context::Context, owner_type: usize, field: type_info::Field) -> usize {
    var current: usize = base_type(context, owner_type);
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record_id: usize = find_record(context, current);
        if (record_id == context::no_id()) {
            return context::no_id();
        }
        let records: *const domain::ClassRecord = context->classes.record_data() as
                *const domain::ClassRecord;
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        let functions: *const context::Function = context->functions.data as
                *const context::Function;
        let symbols: *const context::Symbol = context->symbols.symbol_data() as
                *const context::Symbol;
        let record: domain::ClassRecord = records[record_id];
        for (var index: usize = 0; index < record.method_count; index += 1) {
            let method_index: usize = record.first_method + index;
            let symbol: context::Symbol = symbols[functions[methods[method_index].function_id].symbol_id];
            if (context::tokens_equal(
                    context, field.declaration_unit, field.name_token, symbol.declaration_unit, symbol.name_token)) {
                return method_index;
            }
        }
        current = base_type(context, record.type_id);
    }
    return context::no_id();
}

fn validate_inherited_field_names(context: *context::Context, record: domain::ClassRecord) {
    let type_record: type_info::Record = context::type_record(context, record.type_id);
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    for (var index: usize = 0; index < type_record.field_count; index += 1) {
        let field: type_info::Field = fields[type_record.first_field + index];
        let method_index: usize = inherited_method_named_like_field(context, record.type_id, field);
        if (method_index != context::no_id()) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_class_member, field.declaration_unit,
                context::node(context, field.declaration_unit, field.declaration_node).span,
                context::no_id(), context::empty_span(), method_index);
        }
    }
}

fn inherited_method(context: *context::Context, owner_type: usize, function_id: usize) -> usize {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let lifecycle_method: bool = functions[function_id].identity.kind == domain::CallableKind.constructor ||
        functions[function_id].identity.kind == domain::CallableKind.destructor;
    if (lifecycle_method) {
        return context::no_id();
    }
    var current: usize = base_type(context, owner_type);
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record_id: usize = find_record(context, current);
        if (record_id == context::no_id()) {
            return context::no_id();
        }
        let records: *const domain::ClassRecord = context->classes.record_data() as
                *const domain::ClassRecord;
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        let record: domain::ClassRecord = records[record_id];
        for (var index: usize = 0; index < record.method_count; index += 1) {
            let method_index: usize = record.first_method + index;
            if (method_key_matches(context, function_id, methods[method_index].function_id)) {
                return method_index;
            }
        }
        current = base_type(context, record.type_id);
    }
    return context::no_id();
}

fn method_requests_override(context: *context::Context, function: context::Function) -> bool {
    let declaration: syntax::SyntaxNode = method_declaration(context, function);
    return (declaration.flags & (syntax::SyntaxFlag.override_method as usize)) != 0;
}

fn dispatch_is_virtual(dispatch: domain::MethodDispatch) -> bool {
    return dispatch == domain::MethodDispatch.virtual_method || dispatch == domain::MethodDispatch.abstract_method;
}

fn hierarchy_slot_count(context: *context::Context, type_id: usize) -> usize {
    var count: usize = 0;
    var current: usize = type_id;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record_id: usize = find_record(context, current);
        if (record_id == context::no_id()) {
            return count;
        }
        let records: *const domain::ClassRecord = context->classes.record_data() as
                *const domain::ClassRecord;
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        let record: domain::ClassRecord = records[record_id];
        for (var index: usize = 0; index < record.method_count; index += 1) {
            let method_record: domain::ClassMethod = methods[record.first_method + index];
            if (method_record.virtual_slot != context::no_id() && method_record.virtual_slot >= count) {
                count = method_record.virtual_slot + 1;
            }
        }
        current = base_type(context, record.type_id);
    }
    return count;
}

fn report_override(
    context: *context::Context, kind: context::DiagnosticKind, function: context::Function, inherited_index: usize) {
    let declaration: syntax::SyntaxNode = method_declaration(context, function);
    var related_unit: usize = context::no_id();
    var related_span: lexer::SourceSpan = context::empty_span();
    if (inherited_index != context::no_id()) {
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        let functions: *const context::Function = context->functions.data as
                *const context::Function;
        let inherited: context::Function = functions[methods[inherited_index].function_id];
        related_unit = method_declaration_unit(inherited);
        related_span = method_declaration(context, inherited).span;
    }
    context::add_diagnostic(
        context, kind, method_declaration_unit(function), declaration.span,
        related_unit, related_span, inherited_index);
}

fn override_is_valid(
    context: *context::Context, function: context::Function, inherited_index: usize, requested: bool) -> bool {
    if (inherited_index == context::no_id()) {
        if (requested) {
            report_override(context, context::DiagnosticKind.invalid_override, function, inherited_index);
        }
        return false;
    }
    let methods: *const domain::ClassMethod = context->classes.method_data() as
            *const domain::ClassMethod;
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let inherited: domain::ClassMethod = methods[inherited_index];
    let virtual_base: bool = dispatch_is_virtual(inherited.dispatch);
    let returns_match: bool = function.return_type == functions[inherited.function_id].return_type;
    let override_relation_is_valid: bool = requested && virtual_base;
    let override_contract_is_valid: bool = override_relation_is_valid && returns_match;
    if (!override_contract_is_valid) {
        report_override(context, context::DiagnosticKind.invalid_override, function, inherited_index);
        return false;
    }
    if ((inherited.flags & (domain::MethodFlag.final_method as usize)) != 0) {
        report_override(context, context::DiagnosticKind.final_override, function, inherited_index);
        return false;
    }
    return true;
}

fn analyze_method(context: *context::Context, method_index: usize, next_slot: *usize) {
    let methods: *const domain::ClassMethod = context->classes.method_data() as *const domain::ClassMethod;
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let method_record: domain::ClassMethod = methods[method_index];
    let function: context::Function = functions[method_record.function_id];
    let inherited_index: usize = inherited_method(context, function.identity.owner_type, method_record.function_id);
    let requested: bool = method_requests_override(context, function);
    let has_override_relation: bool = inherited_index != context::no_id() || requested;
    var valid_override: bool = false;
    if (has_override_relation) {
        valid_override = override_is_valid(context, function, inherited_index, requested);
    }
    if (valid_override) {
        context->error = context->classes.assign_virtual_slot(method_index, methods[inherited_index].virtual_slot);
        return;
    }
    if (dispatch_is_virtual(method_record.dispatch)) {
        context->error = context->classes.assign_virtual_slot(method_index, *next_slot);
        if (context->error == runtime::Error.none) {
            *next_slot += 1;
        }
    }
}

fn effective_method_for_slot(context: *context::Context, type_id: usize, slot: usize) -> usize {
    var current: usize = type_id;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record_id: usize = find_record(context, current);
        if (record_id == context::no_id()) {
            return context::no_id();
        }
        let records: *const domain::ClassRecord = context->classes.record_data() as
                *const domain::ClassRecord;
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        let record: domain::ClassRecord = records[record_id];
        for (var index: usize = 0; index < record.method_count; index += 1) {
            let method_index: usize = record.first_method + index;
            if (methods[method_index].virtual_slot == slot) {
                return method_index;
            }
        }
        current = base_type(context, record.type_id);
    }
    return context::no_id();
}

fn update_hierarchy_flags(context: *context::Context, record_id: usize) {
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let type_id: usize = records[record_id].type_id;
    let slot_count: usize = hierarchy_slot_count(context, type_id);
    if (slot_count != 0) {
        context->error = context->classes.mark_polymorphic(record_id);
    }
    for (var slot: usize = 0; slot < slot_count && context->error == runtime::Error.none; slot += 1) {
        let method_index: usize = effective_method_for_slot(context, type_id, slot);
        if (method_index == context::no_id()) {
            continue;
        }
        let methods: *const domain::ClassMethod = context->classes.method_data() as
                *const domain::ClassMethod;
        if (methods[method_index].dispatch == domain::MethodDispatch.abstract_method) {
            context->error = context->classes.mark_abstract(record_id);
            return;
        }
    }
}

fn update_rtti_flag(context: *context::Context, record_id: usize) {
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let record: domain::ClassRecord = records[record_id];
    let type_record: type_info::Record = context::type_record(context, record.type_id);
    let declaration: syntax::SyntaxNode = context::node(
        context, type_record.declaration_unit, type_record.declaration_node);
    let explicitly_enabled: bool = attributes::declaration_has_attribute(
        context, type_record.declaration_unit, declaration, attributes::Attribute.rtti);
    let base_record_id: usize = find_record(context, base_type(context, record.type_id));
    var inherited: bool = false;
    if (base_record_id != context::no_id()) {
        inherited = (records[base_record_id].flags & (domain::ClassFlag.rtti as usize)) != 0;
    }
    let non_root_annotation: bool = explicitly_enabled && base_record_id != context::no_id();
    let invalid_non_root: bool = non_root_annotation && !inherited;
    let enabled: bool = explicitly_enabled || inherited;
    let polymorphic: bool = (records[record_id].flags & (domain::ClassFlag.polymorphic as usize)) != 0;
    let invalid_shape: bool = enabled && !polymorphic;
    if (invalid_non_root || invalid_shape) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_rtti, type_record.declaration_unit, declaration.span,
            context::no_id(), context::empty_span(), record.type_id);
        return;
    }
    if (enabled) {
        context->error = context->classes.enable_rtti(record_id);
    }
}

fn analyze_class_hierarchy(context: *context::Context, record_id: usize, states: *u8, depth: usize) {
    if (states[record_id] == HierarchyState.complete as u8) {
        return;
    }
    if (depth >= context::Limit.maximum_type_depth as usize) {
        context->error = runtime::Error.invalid_argument;
        return;
    }
    if (states[record_id] == HierarchyState.visiting as u8) {
        return;
    }
    states[record_id] = HierarchyState.visiting as u8;
    let records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    let record: domain::ClassRecord = records[record_id];
    validate_inherited_field_names(context, record);
    let inherited_type: usize = base_type(context, record.type_id);
    let base_record: usize = find_record(context, inherited_type);
    if (base_record != context::no_id()) {
        analyze_class_hierarchy(context, base_record, states, depth + 1);
    }
    var next_slot: usize = inherited_type == context::no_id() ? 0 : hierarchy_slot_count(context, inherited_type);
    for (var index: usize = 0;
        index < record.method_count && context->error == runtime::Error.none; index += 1) {
        analyze_method(context, record.first_method + index, &next_slot);
    }
    if (context->error == runtime::Error.none) {
        update_hierarchy_flags(context, record_id);
    }
    if (context->error == runtime::Error.none) {
        update_rtti_flag(context, record_id);
    }
    states[record_id] = HierarchyState.complete as u8;
}

fn analyze_method_hierarchy(context: *context::Context) -> bool {
    let created: bytes::BufferResult = bytes::with_capacity(context->classes.record_count());
    var states: bytes::Buffer = created.buffer;
    context->error = created.error;
    if (created.error != runtime::Error.none) {
        return false;
    }
    states.length = context->classes.record_count();
    context->error = memory::fill(states.data, HierarchyState.unvisited as u8, states.length);
    let state_data: *u8 = states.data;
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        analyze_class_hierarchy(context, record_id, state_data, 0);
    }
    let release_error: runtime::Error = bytes::release(states);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none;
}

fn method_record_is_valid(context: *context::Context, owner_type: usize, method_record: domain::ClassMethod) -> bool {
    if (method_record.function_id >= context->function_count || method_record.access == domain::ClassAccess.invalid) {
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[method_record.function_id];
    let owner_matches: bool = function.identity.owner_type == owner_type;
    let dispatch_matches: bool = method_record.dispatch == method_dispatch(context, function);
    let direct_shape_is_valid: bool = owner_matches && dispatch_matches;
    let virtual_dispatch: bool = dispatch_is_virtual(method_record.dispatch);
    let slot_is_valid: bool = virtual_dispatch ? method_record.virtual_slot != context::no_id() :
        method_record.virtual_slot == context::no_id();
    let flags_are_valid: bool = method_record.flags <= domain::MethodFlag.final_method as usize;
    let method_shape_is_valid: bool = direct_shape_is_valid && slot_is_valid;
    return method_shape_is_valid && flags_are_valid;
}

fn validate_abstract_function_types(context: *context::Context) {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    for (var function_id: usize = 0; function_id < context->function_count; function_id += 1) {
        let function: context::Function = functions[function_id];
        let symbol: context::Symbol = symbols[function.symbol_id];
        if (class_is_abstract(context, function.return_type)) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_abstract_class, symbol.declaration_unit,
                context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                context::no_id(), context::empty_span(), function.return_type);
        }
        for (var index: usize = 0; index < function.parameter_count; index += 1) {
            let parameter: context::Parameter = parameters[function.first_parameter + index];
            if (class_is_abstract(context, parameter.type_id)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_abstract_class, parameter.unit_index,
                    context::node(context, parameter.unit_index, parameter.declaration_node).span,
                    symbol.declaration_unit,
                    context::node(context, symbol.declaration_unit, symbol.declaration_node).span, parameter.type_id);
            }
        }
    }
}

fn class_storage_is_abstract(context: *context::Context, type_id: usize) -> bool {
    var current: usize = type_id;
    for (var depth: usize = 0; depth < context::Limit.maximum_type_depth as usize; depth += 1) {
        let record: type_info::Record = context::type_record(context, current);
        if (record.kind == type_info::Kind.class_type) {
            return class_is_abstract(context, current);
        }
        if (record.kind != type_info::Kind.array) {
            return false;
        }
        current = record.element_type;
    }
    return true;
}

fn validate_abstract_class_fields(context: *context::Context) {
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let type_records: *const type_info::Record = context->types.record_data() as *const type_info::Record;
    let fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
    for (var record_id: usize = 0; record_id < context->classes.record_count(); record_id += 1) {
        let owner: type_info::Record = type_records[records[record_id].type_id];
        for (var index: usize = 0; index < owner.field_count; index += 1) {
            let field: type_info::Field = fields[owner.first_field + index];
            if (!class_storage_is_abstract(context, field.type_id)) {
                continue;
            }
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_abstract_class,
                field.declaration_unit, context::node(context, field.declaration_unit, field.declaration_node).span,
                owner.declaration_unit, context::node(context, owner.declaration_unit, owner.declaration_node).span,
                field.type_id);
        }
    }
}

fn validate_methods(context: *context::Context) -> bool {
    if (!analyze_method_hierarchy(context)) {
        return false;
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as
            *const domain::ClassRecord;
    let methods: *const domain::ClassMethod = context->classes.method_data() as
            *const domain::ClassMethod;
    var expected_method: usize = 0;
    for (var record_id: usize = 0; record_id < context->classes.record_count(); record_id += 1) {
        let record: domain::ClassRecord = records[record_id];
        if (record.method_count == 0) {
            if (record.first_method != context::no_id()) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
            continue;
        }
        if (record.first_method != expected_method) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        for (var index: usize = 0; index < record.method_count; index += 1) {
            if (!method_record_is_valid(context, record.type_id, methods[record.first_method + index])) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
        }
        expected_method += record.method_count;
    }
    if (expected_method != context->classes.method_count()) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    validate_abstract_class_fields(context);
    validate_abstract_function_types(context);
    return true;
}

fn create_descriptor(context: *context::Context, record_id: usize, states: *u8, depth: usize) -> bool {
    if (states[record_id] == HierarchyState.complete as u8) {
        return true;
    }
    if (depth >= context::Limit.maximum_type_depth as usize) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    if (states[record_id] == HierarchyState.visiting as u8) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    states[record_id] = HierarchyState.visiting as u8;
    var records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let record: domain::ClassRecord = records[record_id];
    let enabled: bool = (record.flags & (domain::ClassFlag.rtti as usize)) != 0;
    if (!enabled) {
        states[record_id] = HierarchyState.complete as u8;
        return record.descriptor_global == context::no_id();
    }
    let base_record_id: usize = find_record(context, base_type(context, record.type_id));
    if (base_record_id != context::no_id() && !create_descriptor(context, base_record_id, states, depth + 1)) {
        return false;
    }
    let address_bytes: usize = ir::Limit.function_address_bytes as usize;
    let placeholder: [ir::Limit.function_address_bytes]u8 = {};
    let global_id: usize = context->ir.add_global(&placeholder[0] as *const u8, address_bytes, address_bytes, true);
    if (global_id == context::no_id()) {
        context->error = context->ir.error();
        return false;
    }
    if (base_record_id != context::no_id()) {
        records = context->classes.record_data() as *const domain::ClassRecord;
        let base_descriptor: usize = records[base_record_id].descriptor_global;
        if (base_descriptor == context::no_id() || !context->ir.add_global_reference(global_id, 0, base_descriptor)) {
            context->error = base_descriptor == context::no_id() ? runtime::Error.invalid_argument :
                context->ir.error();
            return false;
        }
    }
    context->error = context->classes.publish_descriptor(record_id, global_id);
    if (context->error != runtime::Error.none) {
        return false;
    }
    states[record_id] = HierarchyState.complete as u8;
    return true;
}

fn create_descriptors(context: *context::Context) -> bool {
    if (context->classes.record_count() == 0) {
        return true;
    }
    let created: bytes::BufferResult = bytes::with_capacity(context->classes.record_count());
    var states: bytes::Buffer = created.buffer;
    context->error = created.error;
    if (created.error != runtime::Error.none) {
        return false;
    }
    states.length = context->classes.record_count();
    context->error = memory::fill(states.data, HierarchyState.unvisited as u8, states.length);
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        create_descriptor(context, record_id, states.data, 0);
    }
    let release_error: runtime::Error = bytes::release(states);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none;
}

fn create_vtable(context: *context::Context, record_id: usize) -> bool {
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let record: domain::ClassRecord = records[record_id];
    let polymorphic: bool = (record.flags & (domain::ClassFlag.polymorphic as usize)) != 0;
    let abstract_class: bool = (record.flags & (domain::ClassFlag.abstract_class as usize)) != 0;
    if (!polymorphic || abstract_class) {
        if (record.vtable_global != context::no_id()) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        return true;
    }
    let address_bytes: usize = ir::Limit.function_address_bytes as usize;
    let slot_count: usize = hierarchy_slot_count(context, record.type_id);
    if (slot_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var slot_bytes: usize = 0;
    if (@mul_overflow(slot_count, address_bytes, &slot_bytes)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let has_descriptor: bool = (record.flags & (domain::ClassFlag.rtti as usize)) != 0;
    let prefix_bytes: usize = has_descriptor ? address_bytes : 0;
    var byte_count: usize = 0;
    if (@add_overflow(prefix_bytes, slot_bytes, &byte_count)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let created: bytes::BufferResult = bytes::with_capacity(byte_count);
    var placeholders: bytes::Buffer = created.buffer;
    context->error = created.error;
    if (created.error != runtime::Error.none) {
        return false;
    }
    placeholders.length = byte_count;
    context->error = memory::fill(placeholders.data, 0, placeholders.length);
    let global_id: usize = context->error == runtime::Error.none ?
        context->ir.add_global(placeholders.data as *const u8, byte_count, address_bytes, true) : context::no_id();
    if (global_id == context::no_id() && context->error == runtime::Error.none) {
        context->error = context->ir.error();
    }
    let release_error: runtime::Error = bytes::release(placeholders);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (context->error != runtime::Error.none) {
        return false;
    }
    if (has_descriptor && !context->ir.add_global_reference(global_id, 0, record.descriptor_global)) {
        context->error = context->ir.error();
        return false;
    }
    let methods: *const domain::ClassMethod = context->classes.method_data() as *const domain::ClassMethod;
    let functions: *const context::Function = context->functions.data as *const context::Function;
    for (var slot: usize = 0; slot < slot_count && context->error == runtime::Error.none; slot += 1) {
        let method_index: usize = effective_method_for_slot(context, record.type_id, slot);
        if (method_index == context::no_id()) {
            context->error = runtime::Error.invalid_argument;
            break;
        }
        let method_record: domain::ClassMethod = methods[method_index];
        let function: context::Function = functions[method_record.function_id];
        let target_is_valid: bool = method_record.dispatch != domain::MethodDispatch.abstract_method &&
            function.ir_function != context::no_id();
        let slot_offset: usize = prefix_bytes + slot * address_bytes;
        if (!target_is_valid || !context->ir.add_global_function_reference(global_id, slot_offset,
            function.ir_function)) {
            context->error = target_is_valid ? context->ir.error() : runtime::Error.invalid_argument;
        }
    }
    if (context->error != runtime::Error.none) {
        return false;
    }
    context->error = context->classes.publish_vtable(record_id, global_id);
    return context->error == runtime::Error.none;
}

fn create_vtables(context: *context::Context) -> bool {
    if (!create_descriptors(context)) {
        return false;
    }
    for (var record_id: usize = 0;
        record_id < context->classes.record_count() && context->error == runtime::Error.none;
        record_id += 1) {
        create_vtable(context, record_id);
    }
    return context->error == runtime::Error.none;
}

fn rtti_is_enabled(context: *context::Context, type_id: usize) -> bool {
    let record_id: usize = find_record(context, type_id);
    if (record_id == context::no_id()) {
        return false;
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    return (records[record_id].flags & (domain::ClassFlag.rtti as usize)) != 0;
}

fn descriptor_global(context: *context::Context, type_id: usize) -> usize {
    let record_id: usize = find_record(context, type_id);
    if (record_id == context::no_id()) {
        return context::no_id();
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    return records[record_id].descriptor_global;
}

fn vtable_slot_offset(context: *context::Context, type_id: usize) -> usize {
    return rtti_is_enabled(context, type_id) ? ir::Limit.function_address_bytes as usize : 0;
}

fn vtable_global(context: *context::Context, type_id: usize) -> usize {
    let record_id: usize = find_record(context, type_id);
    if (record_id == context::no_id()) {
        return context::no_id();
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    return records[record_id].vtable_global;
}

fn vptr_offset(context: *context::Context, type_id: usize) -> usize {
    if (find_record(context, type_id) == context::no_id()) {
        return context::no_id();
    }
    return context::type_record(context, type_id).vptr_offset;
}

fn method_record(context: *context::Context, function_id: usize) -> domain::ClassMethod {
    let methods: *const domain::ClassMethod = context->classes.method_data() as *const domain::ClassMethod;
    for (var index: usize = 0; index < context->classes.method_count(); index += 1) {
        if (methods[index].function_id == function_id) {
            return methods[index];
        }
    }
    return {
        function_id = context::no_id(), access = domain::ClassAccess.invalid, dispatch = domain::MethodDispatch.invalid,
        virtual_slot = context::no_id(), flags = domain::MethodFlag.none as usize,
    };
}

fn direct_dispatch_plan() -> domain::DispatchPlan {
    return {
        kind = domain::CallDispatch.direct, vptr_offset = context::no_id(), virtual_slot = context::no_id(),
    };
}

fn dispatch_plan(
    context: *context::Context, static_type: usize, function_id: usize,
    exact_dynamic_type: bool) -> domain::DispatchPlan {
    if (exact_dynamic_type) {
        return direct_dispatch_plan();
    }
    let record_id: usize = find_record(context, static_type);
    if (record_id == context::no_id()) {
        return direct_dispatch_plan();
    }
    let records: *const domain::ClassRecord = context->classes.record_data() as *const domain::ClassRecord;
    let record: domain::ClassRecord = records[record_id];
    let selected_method: domain::ClassMethod = method_record(context, function_id);
    let class_is_final: bool = (record.flags & (domain::ClassFlag.final_class as usize)) != 0;
    let method_is_final: bool = (selected_method.flags & (domain::MethodFlag.final_method as usize)) != 0;
    if (class_is_final || method_is_final) {
        return direct_dispatch_plan();
    }
    let method_is_virtual: bool = dispatch_is_virtual(selected_method.dispatch);
    let layout_vptr_offset: usize = vptr_offset(context, static_type);
    let layout_is_valid: bool = layout_vptr_offset != context::no_id() &&
        selected_method.virtual_slot != context::no_id();
    if (!method_is_virtual || !layout_is_valid) {
        return direct_dispatch_plan();
    }
    return {
        kind = domain::CallDispatch.virtual_call, vptr_offset = layout_vptr_offset,
        virtual_slot = selected_method.virtual_slot,
    };
}

fn method_is_accessible(context: *context::Context, function_id: usize) -> bool {
    let methods: *const domain::ClassMethod = context->classes.method_data() as
            *const domain::ClassMethod;
    for (var index: usize = 0; index < context->classes.method_count(); index += 1) {
        if (methods[index].function_id != function_id) {
            continue;
        }
        if (methods[index].access == domain::ClassAccess.public_access) {
            return true;
        }
        let functions: *const context::Function = context->functions.data as
                *const context::Function;
        return access_is_available(context, methods[index].access, functions[function_id].identity.owner_type);
    }
    return false;
}
