module luna.bootstrap.middleend.semantic.stmt.labels;

import luna.bootstrap.middleend.semantic.context.builder as builder;
import luna.runtime as runtime;
import luna.std.bytes as bytes;

fn find_label(context: *context::Context, name_token: usize) -> usize {
    let labels: *const context::Label = context->labels.data as *const context::Label;
    for (var index: usize = 0; index < context->label_count; index += 1) {
        if (context::tokens_equal(
                context, context->current_unit, name_token, context->current_unit, labels[index].name_token)) {
            return index;
        }
    }
    return context::no_id();
}

fn append_label(context: *context::Context, label: context::Label) -> usize {
    let result: usize = context->label_count;
    if (!context::append_record(
            context, &context->labels, (&label) as *const context::Label as *const u8, sizeof(context::Label))) {
        return context::no_id();
    }
    context->label_count += 1;
    return result;
}

// Appends the identity and type of every live local of the current function
// to destination and returns the first snapshot index.
fn snapshot_locals(context: *context::Context, destination: *bytes::Buffer) -> usize {
    let first: usize = destination->length / sizeof(context::LocalSnapshot);
    let locals: *const context::Local = context->locals.data as *const context::Local;
    for (var index: usize = 0;
        index < context->local_count && context->error == runtime::Error.none;
        index += 1) {
        let snapshot: context::LocalSnapshot = {
            declaration_node = locals[index].declaration_node, type_id = locals[index].cleanup_type_id,
        };
        let appended: bytes::BufferResult = bytes::append(
            *destination, (&snapshot) as *const context::LocalSnapshot as *const u8, sizeof(context::LocalSnapshot));
        *destination = appended.buffer;
        context->error = appended.error;
    }
    return first;
}

fn snapshot_contains(
    snapshots: *const context::LocalSnapshot, first: usize, count: usize, declaration_node: usize) -> bool {
    for (var index: usize = 0; index < count; index += 1) {
        if (snapshots[first + index].declaration_node == declaration_node) {
            return true;
        }
    }
    return false;
}

fn label_is_subset_of_source(context: *context::Context, label: context::Label, source: context::PendingGoto) -> bool {
    let labels: *const context::LocalSnapshot = context->label_locals.data as *const context::LocalSnapshot;
    let sources: *const context::LocalSnapshot = context->goto_locals.data as *const context::LocalSnapshot;
    for (var index: usize = 0; index < label.local_count; index += 1) {
        let identity: usize = labels[label.first_local + index].declaration_node;
        if (!snapshot_contains(sources, source.first_local, source.local_count, identity)) {
            return false;
        }
    }
    return true;
}

fn source_crosses_nontrivial_lifetime(
    context: *context::Context, label: context::Label,
    source: context::PendingGoto, needs_cleanup: api::NeedsCleanup) -> bool {
    let labels: *const context::LocalSnapshot = context->label_locals.data as *const context::LocalSnapshot;
    let sources: *const context::LocalSnapshot = context->goto_locals.data as *const context::LocalSnapshot;
    for (var index: usize = 0; index < source.local_count; index += 1) {
        let snapshot: context::LocalSnapshot = sources[source.first_local + index];
        let remains_live: bool = snapshot_contains(
            labels, label.first_local, label.local_count, snapshot.declaration_node);
        if (!remains_live && needs_cleanup(context, snapshot.type_id)) {
            return true;
        }
    }
    return false;
}

fn jump_is_valid(
    context: *context::Context, label: context::Label,
    source: context::PendingGoto, needs_cleanup: api::NeedsCleanup) -> bool {
    if (needs_cleanup == null) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    if (!label_is_subset_of_source(context, label, source)) {
        return false;
    }
    return !source_crosses_nontrivial_lifetime(context, label, source, needs_cleanup);
}

// Pushes the label carried by pending_loop_label (set when a labeled
// statement wraps a loop) onto the loop-label stack; returns whether an
// entry was pushed so the caller can pop it when the loop is done.
fn push_loop_label(context: *context::Context) -> bool {
    if (context->pending_loop_label == context::no_id()) {
        return false;
    }
    let entry: context::LoopLabel = {
        name_token = context->pending_loop_label, break_block = context->break_block,
        continue_block = context->continue_block, break_local_count = context->break_local_count,
        continue_local_count = context->continue_local_count,
    };
    context->pending_loop_label = context::no_id();
    if (!context::append_record(
            context, &context->loop_labels, (&entry) as *const context::LoopLabel as *const u8,
            sizeof(context::LoopLabel))) {
        return false;
    }
    context->loop_label_count += 1;
    return true;
}

fn pop_loop_label(context: *context::Context) -> bool {
    if (context->loop_label_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let truncated: bytes::BufferResult =
        bytes::truncate(context->loop_labels, (context->loop_label_count - 1) * sizeof(context::LoopLabel));
    context->loop_labels = truncated.buffer;
    context->error = truncated.error;
    context->loop_label_count -= 1;
    return context->error == runtime::Error.none;
}

fn lower_labeled_control(
    context: *context::Context, node: syntax::SyntaxNode, is_break: bool, cleanup: api::Cleanup) -> bool {
    let none: usize = context::no_id();
    let name_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let entries: *const context::LoopLabel = context->loop_labels.data as *const context::LoopLabel;
    for (var remaining: usize = context->loop_label_count; remaining != 0; remaining -= 1) {
        let index: usize = remaining - 1;
        if (context::tokens_equal(
                context, context->current_unit, name_node.token_index, context->current_unit, entries[index].name_token
            )) {
            let local_count: usize = is_break ? entries[index].break_local_count : entries[index].continue_local_count;
            if (cleanup == null || !cleanup(context, local_count, node)) {
                return false;
            }
            builder::emit_jump(context, node, is_break ? entries[index].break_block : entries[index].continue_block);
            context->current_block = builder::add_current_block(context);
            return context->error == runtime::Error.none;
        }
    }
    context::add_diagnostic(
        context, find_label(context, name_node.token_index) != none ? context::DiagnosticKind.non_loop_label :
            context::DiagnosticKind.unknown_label, context->current_unit, name_node.span, none, context::empty_span(), 0
    );
    return false;
}

fn lower_labeled(
    context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer, needs_cleanup: api::NeedsCleanup) -> bool {
    let none: usize = context::no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let statement: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    let pre_test_loop: bool = statement.kind == syntax::SyntaxKind.while_statement ||
        statement.kind == syntax::SyntaxKind.for_statement;
    let post_test_loop: bool = statement.kind == syntax::SyntaxKind.do_statement ||
        statement.kind == syntax::SyntaxKind.loop_statement;
    let is_loop: bool = pre_test_loop || post_test_loop;
    var label_index: usize = find_label(context, node.token_index);
    if (label_index != none) {
        let labels: *context::Label = context->labels.data as *context::Label;
        if (labels[label_index].defined) {
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_label, context->current_unit, node.span,
                context->current_unit, labels[label_index].span, label_index);
            return false;
        }
        labels[label_index].defined = true;
        labels[label_index].is_loop = is_loop;
        labels[label_index].span = node.span;
    } else {
        let block: usize = builder::add_current_block(context);
        if (block == none) {
            return false;
        }
        label_index = append_label(
            context, {
                name_token = node.token_index, span = node.span, block = block, first_local = 0, local_count = 0,
                is_loop = is_loop, defined = true,
            });
        if (label_index == none) {
            return false;
        }
    }
    let labels: *context::Label = context->labels.data as *context::Label;
    let first_local: usize = snapshot_locals(context, &context->label_locals);
    if (context->error != runtime::Error.none) {
        return false;
    }
    labels[label_index].first_local = first_local;
    labels[label_index].local_count = context->local_count;
    let label: context::Label = labels[label_index];
    let pendings: *context::PendingGoto = context->pending_gotos.data as *context::PendingGoto;
    for (var pending_index: usize = 0; pending_index < context->pending_goto_count; pending_index += 1) {
        let unresolved: bool = !pendings[pending_index].resolved;
        let names_match: bool = context::tokens_equal(
            context, context->current_unit, pendings[pending_index].label_token,
            context->current_unit, label.name_token);
        if (unresolved && names_match) {
            if (!jump_is_valid(context, label, pendings[pending_index], needs_cleanup)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_goto, context->current_unit, pendings[pending_index].span,
                    context->current_unit, label.span, label_index);
            }
            pendings[pending_index].resolved = true;
        }
    }
    if (!builder::block_is_terminated(
            context, context->current_block)) {
        builder::emit_jump(context, node, label.block);
    }
    context->current_block = label.block;
    if (is_loop) {
        context->pending_loop_label = node.token_index;
    }
    let result: bool = lowerer(context, node.first_child);
    context->pending_loop_label = none;
    return result;
}

fn lower_goto(context: *context::Context, node: syntax::SyntaxNode, needs_cleanup: api::NeedsCleanup) -> bool {
    let none: usize = context::no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let name_node: syntax::SyntaxNode = context::node(context, context->current_unit, node.first_child);
    var label_index: usize = find_label(context, name_node.token_index);
    if (label_index != none) {
        let labels: *const context::Label = context->labels.data as *const context::Label;
        if (labels[label_index].defined) {
            let first_local: usize = snapshot_locals(context, &context->goto_locals);
            if (context->error != runtime::Error.none) {
                return false;
            }
            let source: context::PendingGoto = {
                label_token = name_node.token_index, span = name_node.span, first_local = first_local,
                local_count = context->local_count, resolved = true,
            };
            if (!jump_is_valid(context, labels[label_index], source, needs_cleanup)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_goto, context->current_unit, name_node.span,
                    context->current_unit, labels[label_index].span, label_index);
                return false;
            }
            builder::emit_jump(context, node, labels[label_index].block);
            context->current_block = builder::add_current_block(context);
            return context->error == runtime::Error.none;
        }
    }
    var block: usize = none;
    if (label_index == none) {
        block = builder::add_current_block(context);
        if (block == none) {
            return false;
        }
        label_index = append_label(
            context, {
                name_token = name_node.token_index, span = name_node.span, block = block, first_local = 0,
                local_count = 0, is_loop = false, defined = false,
            });
        if (label_index == none) {
            return false;
        }
    } else {
        let labels: *const context::Label = context->labels.data as *const context::Label;
        block = labels[label_index].block;
    }
    let first_local: usize = snapshot_locals(context, &context->goto_locals);
    if (context->error != runtime::Error.none) {
        return false;
    }
    let pending: context::PendingGoto = {
        label_token = name_node.token_index, span = name_node.span, first_local = first_local,
        local_count = context->local_count, resolved = false,
    };
    if (!context::append_record(
            context, &context->pending_gotos, (&pending) as *const context::PendingGoto as *const u8,
            sizeof(context::PendingGoto))) {
        return false;
    }
    context->pending_goto_count += 1;
    builder::emit_jump(context, node, block);
    context->current_block = builder::add_current_block(context);
    return context->error == runtime::Error.none;
}

fn validate_labels(context: *context::Context) -> bool {
    let none: usize = context::no_id();
    let labels: *const context::Label = context->labels.data as *const context::Label;
    for (var index: usize = 0; index < context->label_count; index += 1) {
        if (!labels[index].defined) {
            context::add_diagnostic(
                context, context::DiagnosticKind.unknown_label, context->current_unit, labels[index].span, none,
                context::empty_span(), index);
        }
    }
    return context->error == runtime::Error.none;
}

fn clear_label_state(context: *context::Context) -> bool {
    var error: runtime::Error = runtime::Error.none;
    let cleared_labels: bytes::BufferResult = bytes::clear(context->labels);
    context->labels = cleared_labels.buffer;
    error = context::release_error(error, cleared_labels.error);
    let cleared_label_locals: bytes::BufferResult = bytes::clear(context->label_locals);
    context->label_locals = cleared_label_locals.buffer;
    error = context::release_error(error, cleared_label_locals.error);
    let cleared_gotos: bytes::BufferResult = bytes::clear(context->pending_gotos);
    context->pending_gotos = cleared_gotos.buffer;
    error = context::release_error(error, cleared_gotos.error);
    let cleared_goto_locals: bytes::BufferResult = bytes::clear(context->goto_locals);
    context->goto_locals = cleared_goto_locals.buffer;
    error = context::release_error(error, cleared_goto_locals.error);
    let cleared_loops: bytes::BufferResult = bytes::clear(context->loop_labels);
    context->loop_labels = cleared_loops.buffer;
    error = context::release_error(error, cleared_loops.error);
    context->label_count = 0;
    context->pending_goto_count = 0;
    context->loop_label_count = 0;
    context->pending_loop_label = context::no_id();
    if (context->error == runtime::Error.none) {
        context->error = error;
    }
    return context->error == runtime::Error.none;
}
