module luna.bootstrap.middleend.semantic.stmt.labels;

import luna.bootstrap.middleend.semantic.context.builder as builder;
import luna.runtime as runtime;

fn find_label(context: *context::Context, name_token: usize) -> usize {
    let labels: *const context::Label = context->lowering.label_data();
    for (var index: usize = 0; index < context->lowering.label_count(); index += 1) {
        if (context::tokens_equal(
                context, context->lowering.current_unit(), name_token, context->lowering.current_unit(),
                    labels[index].name_token)) {
            return index;
        }
    }
    return context::no_id();
}

fn append_label(context: *context::Context, label: context::Label) -> usize {
    let result: usize = context->lowering.append_label(label);
    if (result == context::no_id()) {
        context->error = context::release_error(context->error, context->lowering.error());
    }
    return result;
}

// Appends the identity and type of every live local of the current function
// to destination and returns the first snapshot index.
fn snapshot_locals(context: *context::Context, label_snapshot: bool) -> usize {
    let first: usize = label_snapshot ? context->lowering.label_snapshot_count() :
        context->lowering.goto_snapshot_count();
    let locals: *const context::Local = context->lowering.local_data();
    for (var index: usize = 0;
        index < context->lowering.local_count() && context->error == runtime::Error.none;
        index += 1) {
        let snapshot: context::LocalSnapshot = {
            declaration_node = locals[index].declaration_node, type_id = locals[index].cleanup_type_id,
        };
        let snapshot_id: usize = label_snapshot ? context->lowering.append_label_snapshot(snapshot) :
            context->lowering.append_goto_snapshot(snapshot);
        if (snapshot_id == context::no_id()) {
            context->error = context::release_error(context->error, context->lowering.error());
        }
    }
    return first;
}

fn snapshot_contains(
    snapshots: *const context::LocalSnapshot, first: usize, count: usize, declaration_node: usize) -> bool {
    for (var index: usize = 0; index < count; index += 1) {
        if (snapshots[first + index].declaration_node == declaration_node) {
            return true;
        }
    }
    return false;
}

fn label_is_subset_of_source(context: *context::Context, label: context::Label, source: context::PendingGoto) -> bool {
    let labels: *const context::LocalSnapshot = context->lowering.label_snapshot_data();
    let sources: *const context::LocalSnapshot = context->lowering.goto_snapshot_data();
    for (var index: usize = 0; index < label.local_count; index += 1) {
        let identity: usize = labels[label.first_local + index].declaration_node;
        if (!snapshot_contains(sources, source.first_local, source.local_count, identity)) {
            return false;
        }
    }
    return true;
}

fn source_crosses_nontrivial_lifetime(
    context: *context::Context, label: context::Label,
    source: context::PendingGoto, needs_cleanup: api::NeedsCleanup) -> bool {
    let labels: *const context::LocalSnapshot = context->lowering.label_snapshot_data();
    let sources: *const context::LocalSnapshot = context->lowering.goto_snapshot_data();
    for (var index: usize = 0; index < source.local_count; index += 1) {
        let snapshot: context::LocalSnapshot = sources[source.first_local + index];
        let remains_live: bool = snapshot_contains(
            labels, label.first_local, label.local_count, snapshot.declaration_node);
        if (!remains_live && needs_cleanup(context, snapshot.type_id)) {
            return true;
        }
    }
    return false;
}

fn jump_is_valid(
    context: *context::Context, label: context::Label,
    source: context::PendingGoto, needs_cleanup: api::NeedsCleanup) -> bool {
    if (needs_cleanup == null) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    if (!label_is_subset_of_source(context, label, source)) {
        return false;
    }
    return !source_crosses_nontrivial_lifetime(context, label, source, needs_cleanup);
}

// Pushes the label carried by pending_loop_label (set when a labeled
// statement wraps a loop) onto the loop-label stack; returns whether an
// entry was pushed so the caller can pop it when the loop is done.
fn push_loop_label(context: *context::Context) -> bool {
    let name_token: usize = context->lowering.pending_loop_label();
    if (name_token == context::no_id()) {
        return false;
    }
    let targets: context::ControlTargets = context->lowering.control_targets();
    let entry: context::LoopLabel = {
        name_token = name_token, break_block = targets.break_target.block,
        continue_block = targets.continue_target.block, break_local_count = targets.break_target.local_count,
        continue_local_count = targets.continue_target.local_count,
    };
    context->error = context::release_error(context->error, context->lowering.set_pending_loop_label(context::no_id()));
    if (context->error != runtime::Error.none) {
        return false;
    }
    context->error = context::release_error(context->error, context->lowering.append_loop_label(entry));
    return context->error == runtime::Error.none;
}

fn pop_loop_label(context: *context::Context) -> bool {
    context->error = context::release_error(context->error, context->lowering.pop_loop_label());
    return context->error == runtime::Error.none;
}

fn lower_labeled_control(
    context: *context::Context, node: syntax::SyntaxNode, is_break: bool, cleanup: api::Cleanup) -> bool {
    let none: usize = context::no_id();
    let name_node: syntax::SyntaxNode = context::node(context, context->lowering.current_unit(), node.first_child);
    let entries: *const context::LoopLabel = context->lowering.loop_label_data();
    for (var remaining: usize = context->lowering.loop_label_count(); remaining != 0; remaining -= 1) {
        let index: usize = remaining - 1;
        if (context::tokens_equal(
                context, context->lowering.current_unit(), name_node.token_index, context->lowering.current_unit(),
                    entries[index].name_token)) {
            let local_count: usize = is_break ? entries[index].break_local_count : entries[index].continue_local_count;
            if (cleanup == null || !cleanup(context, local_count, node)) {
                return false;
            }
            builder::emit_jump(context, node, is_break ? entries[index].break_block : entries[index].continue_block);
            builder::set_current_block(context, builder::add_current_block(context));
            return context->error == runtime::Error.none;
        }
    }
    context::add_diagnostic(
        context, find_label(context, name_node.token_index) != none ? context::DiagnosticKind.non_loop_label :
            context::DiagnosticKind.unknown_label, context->lowering.current_unit(), name_node.span, none,
                context::empty_span(), 0);
    return false;
}

fn lower_labeled(
    context: *context::Context, node: syntax::SyntaxNode,
    lowerer: api::Lowerer, needs_cleanup: api::NeedsCleanup) -> bool {
    let none: usize = context::no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let statement: syntax::SyntaxNode = context::node(context, context->lowering.current_unit(), node.first_child);
    let pre_test_loop: bool = statement.kind == syntax::SyntaxKind.while_statement ||
        statement.kind == syntax::SyntaxKind.for_statement;
    let post_test_loop: bool = statement.kind == syntax::SyntaxKind.do_statement ||
        statement.kind == syntax::SyntaxKind.loop_statement;
    let is_loop: bool = pre_test_loop || post_test_loop;
    var label_index: usize = find_label(context, node.token_index);
    if (label_index != none) {
        let labels: *const context::Label = context->lowering.label_data();
        var existing_label: context::Label = labels[label_index];
        if (existing_label.defined) {
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_label, context->lowering.current_unit(), node.span,
                context->lowering.current_unit(), existing_label.span, label_index);
            return false;
        }
        existing_label.defined = true;
        existing_label.is_loop = is_loop;
        existing_label.span = node.span;
        context->error = context::release_error(context->error, context->lowering.set_label(label_index,
            existing_label));
        if (context->error != runtime::Error.none) {
            return false;
        }
    } else {
        let block: usize = builder::add_current_block(context);
        if (block == none) {
            return false;
        }
        label_index = append_label(
            context, {
                name_token = node.token_index, span = node.span, block = block, first_local = 0, local_count = 0,
                is_loop = is_loop, defined = true,
            });
        if (label_index == none) {
            return false;
        }
    }
    let labels: *const context::Label = context->lowering.label_data();
    let first_local: usize = snapshot_locals(context, true);
    if (context->error != runtime::Error.none) {
        return false;
    }
    var current_label: context::Label = labels[label_index];
    current_label.first_local = first_local;
    current_label.local_count = context->lowering.local_count();
    context->error = context::release_error(context->error, context->lowering.set_label(label_index, current_label));
    if (context->error != runtime::Error.none) {
        return false;
    }
    let label: context::Label = current_label;
    let pendings: *const context::PendingGoto = context->lowering.pending_goto_data();
    for (var pending_index: usize = 0;
        pending_index < context->lowering.pending_goto_count(); pending_index += 1) {
        let unresolved: bool = !pendings[pending_index].resolved;
        let names_match: bool = context::tokens_equal(
            context, context->lowering.current_unit(), pendings[pending_index].label_token,
            context->lowering.current_unit(), label.name_token);
        if (unresolved && names_match) {
            if (!jump_is_valid(context, label, pendings[pending_index], needs_cleanup)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_goto, context->lowering.current_unit(),
                        pendings[pending_index].span, context->lowering.current_unit(), label.span, label_index);
            }
            context->error = context::release_error(
                context->error, context->lowering.set_pending_goto_resolved(pending_index));
            if (context->error != runtime::Error.none) {
                return false;
            }
        }
    }
    if (!builder::block_is_terminated(
            context, context->lowering.current_block())) {
        builder::emit_jump(context, node, label.block);
    }
    builder::set_current_block(context, label.block);
    if (is_loop) {
        context->error = context::release_error(
            context->error, context->lowering.set_pending_loop_label(node.token_index));
    }
    let result: bool = lowerer(context, node.first_child);
    context->error = context::release_error(context->error, context->lowering.set_pending_loop_label(none));
    return result;
}

fn lower_goto(context: *context::Context, node: syntax::SyntaxNode, needs_cleanup: api::NeedsCleanup) -> bool {
    let none: usize = context::no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let name_node: syntax::SyntaxNode = context::node(context, context->lowering.current_unit(), node.first_child);
    var label_index: usize = find_label(context, name_node.token_index);
    if (label_index != none) {
        let labels: *const context::Label = context->lowering.label_data();
        if (labels[label_index].defined) {
            let first_local: usize = snapshot_locals(context, false);
            if (context->error != runtime::Error.none) {
                return false;
            }
            let source: context::PendingGoto = {
                label_token = name_node.token_index, span = name_node.span, first_local = first_local,
                local_count = context->lowering.local_count(), resolved = true,
            };
            let jump_is_allowed: bool = jump_is_valid(context, labels[label_index], source, needs_cleanup);
            let discard_error: runtime::Error = context->lowering.discard_goto_snapshots(first_local);
            context->error = context::release_error(context->error, discard_error);
            if (!jump_is_allowed) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_goto, context->lowering.current_unit(), name_node.span,
                    context->lowering.current_unit(), labels[label_index].span, label_index);
                return false;
            }
            if (context->error != runtime::Error.none) {
                return false;
            }
            builder::emit_jump(context, node, labels[label_index].block);
            let block: usize = builder::add_current_block(context);
            builder::set_current_block(context, block);
            return context->error == runtime::Error.none;
        }
    }
    var block: usize = none;
    if (label_index == none) {
        block = builder::add_current_block(context);
        if (block == none) {
            return false;
        }
        label_index = append_label(
            context, {
                name_token = name_node.token_index, span = name_node.span, block = block, first_local = 0,
                local_count = 0, is_loop = false, defined = false,
            });
        if (label_index == none) {
            return false;
        }
    } else {
        let labels: *const context::Label = context->lowering.label_data();
        block = labels[label_index].block;
    }
    let first_local: usize = snapshot_locals(context, false);
    if (context->error != runtime::Error.none) {
        return false;
    }
    let pending: context::PendingGoto = {
        label_token = name_node.token_index, span = name_node.span, first_local = first_local,
        local_count = context->lowering.local_count(), resolved = false,
    };
    if (context->lowering.append_pending_goto(pending) == none) {
        context->error = context::release_error(context->error, context->lowering.error());
        return false;
    }
    builder::emit_jump(context, node, block);
    builder::set_current_block(context, builder::add_current_block(context));
    return context->error == runtime::Error.none;
}

fn validate_labels(context: *context::Context) -> bool {
    let none: usize = context::no_id();
    let labels: *const context::Label = context->lowering.label_data();
    for (var index: usize = 0; index < context->lowering.label_count(); index += 1) {
        if (!labels[index].defined) {
            context::add_diagnostic(
                context, context::DiagnosticKind.unknown_label, context->lowering.current_unit(), labels[index].span,
                    none, context::empty_span(), index);
        }
    }
    return context->error == runtime::Error.none;
}
