module luna.bootstrap.middleend.semantic.classes.model;

enum Limit: usize {
    maximum_size = 18446744073709551615,
}

fn class_slice_is_empty(first: usize, count: usize) -> bool {
    return first == Limit.maximum_size as usize && count == 0;
}

fn class_slice_is_appendable(first: usize, count: usize, next: usize) -> bool {
    if (count == 0) {
        return class_slice_is_empty(first, count);
    }
    return first <= next && count == next - first;
}

fn declaration_flags_are_valid(flags: usize) -> bool {
    let allowed: usize = (domain::ClassFlag.exported as usize) | (domain::ClassFlag.final_class as usize);
    return (flags & ~allowed) == 0;
}

fn class_record(type_id: usize, flags: usize) -> domain::ClassRecord {
    let none: usize = Limit.maximum_size as usize;
    return {
        type_id = type_id, first_field = none, field_count = 0, first_method = none, method_count = 0,
        first_friend = none, friend_count = 0, descriptor_global = none, vtable_global = none, flags = flags,
    };
}

impl ClassTable {
    init(): records = vector::vector<domain::ClassRecord>(), fields = vector::vector<domain::ClassField>(),
            methods = vector::vector<domain::ClassMethod>(), friends = vector::vector<domain::ClassFriend>() {
        this->error_code = runtime::Error.none;
    }

    init(other: ClassTable&&): records = other.records as vector::vector<domain::ClassRecord>&&,
            fields = other.fields as vector::vector<domain::ClassField>&&,
                methods = other.methods as vector::vector<domain::ClassMethod>&&,
            friends = other.friends as vector::vector<domain::ClassFriend>&& {
        this->error_code = other.error_code;
        other.error_code = runtime::Error.none;
    }

    priv fn ready() const -> bool {
        return this->error_code == runtime::Error.none && this->storage_is_valid();
    }

    priv fn can_append_record(type_id: usize, flags: usize) const -> bool {
        let capacity_is_available: bool = this->records.size() != Limit.maximum_size as usize;
        let storage_is_ready: bool = this->ready() && capacity_is_available;
        let identity_is_valid: bool = type_id != Limit.maximum_size as usize;
        let declaration_is_valid: bool = identity_is_valid && declaration_flags_are_valid(flags);
        return storage_is_ready && declaration_is_valid;
    }

    priv fn fail(error: runtime::Error) -> runtime::Error {
        if (this->error_code == runtime::Error.none) {
            this->error_code = error;
        }
        return this->error_code;
    }

    fn storage_is_valid() const -> bool {
        let declarations_are_valid: bool = this->records.is_valid() && this->fields.is_valid();
        let policies_are_valid: bool = this->methods.is_valid() && this->friends.is_valid();
        return declarations_are_valid && policies_are_valid;
    }

    fn error() const -> runtime::Error {
        return this->error_code;
    }

    fn record_count() const -> usize {
        return this->records.size();
    }

    fn field_count() const -> usize {
        return this->fields.size();
    }

    fn method_count() const -> usize {
        return this->methods.size();
    }

    fn friend_count() const -> usize {
        return this->friends.size();
    }

    fn record_data() const -> *const domain::ClassRecord {
        return this->records.empty() ? null : &this->records.get(0) as *const domain::ClassRecord;
    }

    fn field_data() const -> *const domain::ClassField {
        return this->fields.empty() ? null : &this->fields.get(0) as *const domain::ClassField;
    }

    fn method_data() const -> *const domain::ClassMethod {
        return this->methods.empty() ? null : &this->methods.get(0) as *const domain::ClassMethod;
    }

    fn friend_data() const -> *const domain::ClassFriend {
        return this->friends.empty() ? null : &this->friends.get(0) as *const domain::ClassFriend;
    }

    fn append_record(type_id: usize, flags: usize) -> runtime::Error {
        if (!this->can_append_record(type_id, flags)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let error: runtime::Error = this->records.push_back(class_record(type_id, flags));
        return error == runtime::Error.none ? error : this->fail(error);
    }

    fn append_field(record_id: usize, field: domain::ClassField) -> runtime::Error {
        if (!this->ready() || record_id >= this->records.size()) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record: domain::ClassRecord = this->records.get(record_id);
        let field_id: usize = this->fields.size();
        if (!class_slice_is_appendable(record.first_field, record.field_count, field_id)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let error: runtime::Error = this->fields.push_back(field);
        if (error != runtime::Error.none) {
            return this->fail(error);
        }
        if (record.field_count == 0) {
            this->records.get(record_id).first_field = field_id;
        }
        this->records.get(record_id).field_count += 1;
        return runtime::Error.none;
    }

    fn append_method(record_id: usize, method_record: domain::ClassMethod) -> runtime::Error {
        if (!this->ready() || record_id >= this->records.size()) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record: domain::ClassRecord = this->records.get(record_id);
        let method_id: usize = this->methods.size();
        if (!class_slice_is_appendable(record.first_method, record.method_count, method_id)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let error: runtime::Error = this->methods.push_back(method_record);
        if (error != runtime::Error.none) {
            return this->fail(error);
        }
        if (record.method_count == 0) {
            this->records.get(record_id).first_method = method_id;
        }
        this->records.get(record_id).method_count += 1;
        return runtime::Error.none;
    }

    fn append_friend(record_id: usize, friend_record: domain::ClassFriend) -> runtime::Error {
        if (!this->ready() || record_id >= this->records.size()) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record: domain::ClassRecord = this->records.get(record_id);
        let friend_id: usize = this->friends.size();
        if (!class_slice_is_appendable(record.first_friend, record.friend_count, friend_id)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let error: runtime::Error = this->friends.push_back(friend_record);
        if (error != runtime::Error.none) {
            return this->fail(error);
        }
        if (record.friend_count == 0) {
            this->records.get(record_id).first_friend = friend_id;
        }
        this->records.get(record_id).friend_count += 1;
        return runtime::Error.none;
    }

    priv fn add_flag(record_id: usize, flag: domain::ClassFlag) -> runtime::Error {
        if (!this->ready() || record_id >= this->records.size()) {
            return this->fail(runtime::Error.invalid_argument);
        }
        this->records.get(record_id).flags |= flag as usize;
        return runtime::Error.none;
    }

    fn mark_polymorphic(record_id: usize) -> runtime::Error {
        return this->add_flag(record_id, domain::ClassFlag.polymorphic);
    }

    fn mark_abstract(record_id: usize) -> runtime::Error {
        if (!this->ready() || record_id >= this->records.size()) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let flags: usize = this->records.get(record_id).flags;
        if ((flags & (domain::ClassFlag.polymorphic as usize)) == 0) {
            return this->fail(runtime::Error.invalid_argument);
        }
        return this->add_flag(record_id, domain::ClassFlag.abstract_class);
    }

    fn enable_rtti(record_id: usize) -> runtime::Error {
        if (!this->ready() || record_id >= this->records.size()) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let flags: usize = this->records.get(record_id).flags;
        if ((flags & (domain::ClassFlag.polymorphic as usize)) == 0) {
            return this->fail(runtime::Error.invalid_argument);
        }
        return this->add_flag(record_id, domain::ClassFlag.rtti);
    }

    fn assign_virtual_slot(method_id: usize, virtual_slot: usize) -> runtime::Error {
        let method_is_in_range: bool = method_id < this->methods.size();
        let slot_is_valid: bool = virtual_slot != Limit.maximum_size as usize;
        if (!this->ready() || !method_is_in_range) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let method_record: domain::ClassMethod = this->methods.get(method_id);
        let virtual_dispatch: bool = method_record.dispatch == domain::MethodDispatch.virtual_method ||
            method_record.dispatch == domain::MethodDispatch.abstract_method;
        let slot_is_empty: bool = method_record.virtual_slot == Limit.maximum_size as usize;
        let assignment_is_valid: bool = slot_is_valid && slot_is_empty;
        if (!virtual_dispatch || !assignment_is_valid) {
            return this->fail(runtime::Error.invalid_argument);
        }
        this->methods.get(method_id).virtual_slot = virtual_slot;
        return runtime::Error.none;
    }

    fn publish_descriptor(record_id: usize, global_id: usize) -> runtime::Error {
        let record_is_in_range: bool = record_id < this->records.size();
        let global_is_valid: bool = global_id != Limit.maximum_size as usize;
        if (!this->ready() || !record_is_in_range) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record: domain::ClassRecord = this->records.get(record_id);
        let rtti_is_enabled: bool = (record.flags & (domain::ClassFlag.rtti as usize)) != 0;
        let metadata_is_empty: bool = record.descriptor_global == Limit.maximum_size as usize;
        let publication_is_valid: bool = global_is_valid && metadata_is_empty;
        if (!rtti_is_enabled || !publication_is_valid) {
            return this->fail(runtime::Error.invalid_argument);
        }
        this->records.get(record_id).descriptor_global = global_id;
        return runtime::Error.none;
    }

    fn publish_vtable(record_id: usize, global_id: usize) -> runtime::Error {
        let record_is_in_range: bool = record_id < this->records.size();
        let global_is_valid: bool = global_id != Limit.maximum_size as usize;
        if (!this->ready() || !record_is_in_range) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record: domain::ClassRecord = this->records.get(record_id);
        let polymorphic: bool = (record.flags & (domain::ClassFlag.polymorphic as usize)) != 0;
        let abstract_class: bool = (record.flags & (domain::ClassFlag.abstract_class as usize)) != 0;
        let metadata_is_empty: bool = record.vtable_global == Limit.maximum_size as usize;
        let class_is_concrete: bool = polymorphic && !abstract_class;
        let publication_is_valid: bool = global_is_valid && metadata_is_empty;
        if (!class_is_concrete || !publication_is_valid) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let rtti_is_enabled: bool = (record.flags & (domain::ClassFlag.rtti as usize)) != 0;
        let descriptor_is_ready: bool = !rtti_is_enabled || record.descriptor_global != Limit.maximum_size as usize;
        if (!descriptor_is_ready) {
            return this->fail(runtime::Error.invalid_argument);
        }
        this->records.get(record_id).vtable_global = global_id;
        return runtime::Error.none;
    }

    deinit() {
    }
}
