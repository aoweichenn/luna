module luna.bootstrap.middleend.semantic.classes.model;

enum Limit: usize {
    maximum_size = 18446744073709551615,
}

fn empty() -> Store {
    return {
        records = bytes::empty(), record_count = 0, fields = bytes::empty(), field_count = 0,
        methods = bytes::empty(), method_count = 0,
    };
}

fn buffer_matches(buffer: bytes::Buffer, count: usize, record_size: usize) -> bool {
    let storage_is_valid: bool = bytes::is_valid(buffer) && record_size != 0;
    if (!storage_is_valid) {
        return false;
    }
    let shape_is_valid: bool = buffer.length % record_size == 0;
    return shape_is_valid && count == buffer.length / record_size;
}

fn storage_is_valid(store: Store) -> bool {
    let records_are_valid: bool = buffer_matches(store.records, store.record_count, sizeof(Record));
    let fields_are_valid: bool = buffer_matches(store.fields, store.field_count, sizeof(Field));
    let methods_are_valid: bool = buffer_matches(store.methods, store.method_count, sizeof(Method));
    let members_are_valid: bool = fields_are_valid && methods_are_valid;
    return records_are_valid && members_are_valid;
}

fn append_record(store: *Store, record: Record) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    let appended: bytes::BufferResult = bytes::append(
        store->records, (&record) as *const Record as *const u8, sizeof(Record));
    store->records = appended.buffer;
    if (appended.error == runtime::Error.none) {
        store->record_count += 1;
    }
    return appended.error;
}

fn class_slice_is_appendable(first: usize, count: usize, next: usize) -> bool {
    if (count == 0) {
        return first == Limit.maximum_size as usize;
    }
    return first <= next && count == next - first;
}

fn append_field(store: *Store, record_id: usize, field: Field) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    if (record_id >= store->record_count) {
        return runtime::Error.invalid_argument;
    }
    var records: *Record = store->records.data as *Record;
    if (!class_slice_is_appendable(records[record_id].first_field, records[record_id].field_count,
        store->field_count)) {
        return runtime::Error.invalid_argument;
    }
    let appended: bytes::BufferResult = bytes::append(
        store->fields, (&field) as *const Field as *const u8, sizeof(Field));
    store->fields = appended.buffer;
    if (appended.error == runtime::Error.none) {
        records = store->records.data as *Record;
        if (records[record_id].field_count == 0) {
            records[record_id].first_field = store->field_count;
        }
        records[record_id].field_count += 1;
        store->field_count += 1;
    }
    return appended.error;
}

fn append_method(store: *Store, record_id: usize, method: Method) -> runtime::Error {
    if (store == null || !storage_is_valid(*store)) {
        return runtime::Error.invalid_argument;
    }
    if (record_id >= store->record_count) {
        return runtime::Error.invalid_argument;
    }
    var records: *Record = store->records.data as *Record;
    if (!class_slice_is_appendable(
            records[record_id].first_method, records[record_id].method_count, store->method_count)) {
        return runtime::Error.invalid_argument;
    }
    let appended: bytes::BufferResult = bytes::append(
        store->methods, (&method) as *const Method as *const u8, sizeof(Method));
    store->methods = appended.buffer;
    if (appended.error == runtime::Error.none) {
        records = store->records.data as *Record;
        if (records[record_id].method_count == 0) {
            records[record_id].first_method = store->method_count;
        }
        records[record_id].method_count += 1;
        store->method_count += 1;
    }
    return appended.error;
}

fn first_error(current: runtime::Error, next: runtime::Error) -> runtime::Error {
    return current != runtime::Error.none ? current : next;
}

fn release(store: Store) -> runtime::Error {
    if (!storage_is_valid(store)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(store.records);
    error = first_error(error, bytes::release(store.fields));
    error = first_error(error, bytes::release(store.methods));
    return error;
}
