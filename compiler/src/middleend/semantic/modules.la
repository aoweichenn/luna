module luna.bootstrap.middleend.semantic.modules;

import luna.bootstrap.middleend.semantic.context.lookup as names;

import luna.compiler.syntax as syntax;

import luna.runtime as runtime;


fn collect_modules(context: *context::Context) -> bool {
    for (var unit_index: usize = 0;
        unit_index < context->input.unit_count && context->error == runtime::Error.none;
        unit_index += 1) {
        let unit: *const context::Unit = context::input_unit(context, unit_index);
        let root: syntax::SyntaxNode = context::node(context, unit_index, unit->tree.root());
        let interface_unit: bool = (root.flags & (syntax::SyntaxFlag.interface_unit as usize)) != 0;
        let name_node: usize = names::program_module_node(context, unit_index);
        var module_id: usize = names::find_module_by_name(context, unit_index, name_node);
        if (module_id == context::no_id()) {
            module_id = names::append_module(
                context, {
                    interface_unit = context::no_id(), implementation_count = 0, name_unit = unit_index,
                    name_node = name_node, first_import = context::no_id(), import_count = 0, visit_state = 0,
                    reachable = false,
                });
        }
        if (module_id == context::no_id()) {
            return false;
        }
        let modules: *context::Module = context->modules.data as *context::Module;
        let previous: usize = modules[module_id].interface_unit;
        if (interface_unit && previous != context::no_id()) {
            let previous_node: usize = names::program_module_node(context, previous);
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_interface, unit_index,
                context::node(context, unit_index, name_node).span,
                previous, context::node(context, previous, previous_node).span, module_id);
        } else if (interface_unit) {
            modules[module_id].interface_unit = unit_index;
        } else {
            modules[module_id].implementation_count += 1;
        }
        if (!names::append_unit_info(
                context, {
                    module_id = module_id, interface_unit = interface_unit ? 1 : 0,
                })) {
            return false;
        }
    }
    return context->error == runtime::Error.none;
}

struct ImportBinding {
    alias_token: usize;
    selective_node: usize;
    valid: bool;
}

fn find_import_to(context: *context::Context, module_id: usize, target_module: usize) -> usize {
    let modules: *const context::Module = context->modules.data as *const context::Module;
    let imports: *const context::Import = context->imports.data as *const context::Import;
    for (var index: usize = 0; index < modules[module_id].import_count; index += 1) {
        let import_id: usize = modules[module_id].first_import + index;
        if (imports[import_id].target_module == target_module) {
            return import_id;
        }
    }
    return context::no_id();
}

fn resolve_import_binding(
    context: *context::Context, unit_index: usize,
    declaration: syntax::SyntaxNode, target_module: usize) -> ImportBinding {
    let none: usize = context::no_id();
    let aliased: bool = (declaration.flags & (syntax::SyntaxFlag.aliased_import as usize)) != 0;
    let selective: bool = (declaration.flags & (syntax::SyntaxFlag.selective_import as usize)) != 0;
    if (aliased && selective) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_selective_import, unit_index, declaration.span,
            none, context::empty_span(), target_module);
        return {alias_token = none, selective_node = none, valid = false};
    }
    let has_binding_child: bool = declaration.last_child != none;
    let alias_token: usize = aliased && has_binding_child ?
        context::node(context, unit_index, declaration.last_child).token_index : none;
    let selective_node: usize = selective && has_binding_child ? declaration.last_child : none;
    return {alias_token = alias_token, selective_node = selective_node, valid = true};
}

fn append_module_import(
    context: *context::Context, module_id: usize, unit_index: usize, declaration_node: usize,
    target_module: usize, interface_import: bool, binding: ImportBinding) -> bool {
    let import_id: usize = names::append_import(
        context, {
            owner_module = module_id, source_unit = unit_index, declaration_node = declaration_node,
            target_module = target_module, interface_import = interface_import, alias_token = binding.alias_token,
            selective_node = binding.selective_node,
        });
    if (import_id == context::no_id()) {
        return false;
    }
    let modules: *context::Module = context->modules.data as *context::Module;
    if (modules[module_id].import_count == 0) {
        modules[module_id].first_import = import_id;
    }
    modules[module_id].import_count += 1;
    return true;
}

fn collect_unit_imports(
    context: *context::Context, module_id: usize, unit_index: usize, interface_import: bool) -> bool {
    let none: usize = context::no_id();
    if (unit_index == none) {
        return true;
    }
    let unit: *const context::Unit = context::input_unit(context, unit_index);
    let root: syntax::SyntaxNode = context::node(context, unit_index, unit->tree.root());
    for (var child: usize = context::node(context, unit_index, root.first_child).next_sibling;
        child != none;
        child = context::node(context, unit_index, child).next_sibling) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (declaration.kind != syntax::SyntaxKind.import_declaration) {
            break;
        }
        let target: usize = names::find_module_by_name(context, unit_index, child);
        if (target == none) {
            context::add_diagnostic(
                context, context::DiagnosticKind.unknown_import, unit_index, declaration.span, none,
                context::empty_span(), 0);
        } else if (target == module_id) {
            context::add_diagnostic(
                context, context::DiagnosticKind.self_import, unit_index, declaration.span, none, context::empty_span(),
                module_id);
        } else {
            let imports: *const context::Import = context->imports.data as
                    *const context::Import;
            let duplicate: usize = find_import_to(context, module_id, target);
            if (duplicate != none) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.duplicate_import, unit_index, declaration.span,
                    imports[duplicate].source_unit,
                    context::node(context, imports[duplicate].source_unit, imports[duplicate].declaration_node).span,
                    target);
            } else {
                let binding: ImportBinding = resolve_import_binding(context, unit_index, declaration, target);
                if (binding.valid && !append_module_import(
                        context, module_id, unit_index, child, target, interface_import, binding)) {
                    return false;
                }
            }
        }
    }
    return context->error == runtime::Error.none;
}

fn collect_imports(context: *context::Context) -> bool {
    for (var module_id: usize = 0;
        module_id < context->module_count && context->error == runtime::Error.none;
        module_id += 1) {
        let modules: *const context::Module = context->modules.data as
                *const context::Module;
        let interface_unit: usize = modules[module_id].interface_unit;
        if (!collect_unit_imports(context, module_id, interface_unit, true)) {
            return false;
        }
        for (var implementation_index: usize = 0;
            implementation_index < modules[module_id].implementation_count;
            implementation_index += 1) {
            let implementation_unit: usize =
                names::module_implementation_unit(context, module_id, implementation_index);
            if (implementation_unit == context::no_id() ||
                !collect_unit_imports(
                    context, module_id, implementation_unit, false)) {
                return false;
            }
        }
    }
    return validate_import_qualifiers(context);
}

fn import_qualifier_location(
    context: *context::Context, record: context::Import, unit_index: *usize, token_index: *usize) -> bool {
    if (unit_index == null || token_index == null) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    if (record.alias_token != context::no_id()) {
        *unit_index = record.source_unit;
        *token_index = record.alias_token;
        return true;
    }
    let modules: *const context::Module = context->modules.data as
            *const context::Module;
    let target: context::Module = modules[record.target_module];
    let name: syntax::SyntaxNode = context::node(context, target.name_unit, target.name_node);
    if (name.child_count == 0 || name.last_child == context::no_id()) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    *unit_index = target.name_unit;
    *token_index = context::node(context, target.name_unit, name.last_child).token_index;
    return true;
}

fn import_qualifiers_equal(context: *context::Context, left: context::Import, right: context::Import) -> bool {
    var left_unit: usize = context::no_id();
    var left_token: usize = context::no_id();
    var right_unit: usize = context::no_id();
    var right_token: usize = context::no_id();
    return import_qualifier_location(context, left, &left_unit, &left_token) &&
        import_qualifier_location(context, right, &right_unit, &right_token) &&
        context::tokens_equal(context, left_unit, left_token, right_unit, right_token);
}

fn validate_import_qualifiers(context: *context::Context) -> bool {
    let modules: *const context::Module = context->modules.data as
            *const context::Module;
    let imports: *const context::Import = context->imports.data as
            *const context::Import;
    for (var module_id: usize = 0;
        module_id < context->module_count && context->error == runtime::Error.none;
        module_id += 1) {
        let module_record: context::Module = modules[module_id];
        for (var right_index: usize = 1; right_index < module_record.import_count; right_index += 1) {
            let right: context::Import = imports[module_record.first_import + right_index];
            var conflict: bool = false;
            for (var left_index: usize = 0; left_index < right_index && !conflict; left_index += 1) {
                let left: context::Import = imports[module_record.first_import + left_index];
                if (import_qualifiers_equal(context, left, right)) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.ambiguous_module_qualifier, right.source_unit,
                        context::node(context, right.source_unit, right.declaration_node).span, left.source_unit,
                        context::node(context, left.source_unit, left.declaration_node).span, right.target_module);
                    conflict = true;
                }
            }
        }
    }
    return context->error == runtime::Error.none;
}

fn visit_imports(context: *context::Context, module_id: usize, depth: usize) -> bool {
    var modules: *context::Module = context->modules.data as *context::Module;
    if (modules[module_id].visit_state == 2) {
        return true;
    }
    if (modules[module_id].visit_state == 1) {
        return false;
    }
    if (depth >= context::Limit.maximum_module_depth as usize) {
        context::add_diagnostic(
            context, context::DiagnosticKind.resource_limit, modules[module_id].name_unit,
            context::node(context, modules[module_id].name_unit, modules[module_id].name_node).span,
            context::no_id(), context::empty_span(), depth);
        return false;
    }
    modules[module_id].visit_state = 1;
    let first_import: usize = modules[module_id].first_import;
    let import_count: usize = modules[module_id].import_count;
    for (var index: usize = 0; index < import_count; index += 1) {
        let imports: *const context::Import = context->imports.data as
                *const context::Import;
        let record: context::Import = imports[first_import + index];
        let diagnostic_count: usize = context->diagnostics.count;
        if (!visit_imports(
                context, record.target_module, depth + 1)) {
            if (context->error != runtime::Error.none || context->diagnostics.count != diagnostic_count) {
                return false;
            }
            context::add_diagnostic(
                context, context::DiagnosticKind.import_cycle, record.source_unit,
                context::node(context, record.source_unit, record.declaration_node).span,
                modules[record.target_module].name_unit,
                context::node(
                    context, modules[record.target_module].name_unit, modules[record.target_module].name_node).span,
                record.target_module);
            return false;
        }
    }
    modules = context->modules.data as
        *context::Module;
    modules[module_id].visit_state = 2;
    return true;
}

fn validate_import_graph(context: *context::Context) -> bool {
    for (var module_id: usize = 0; module_id < context->module_count; module_id += 1) {
        let modules: *const context::Module = context->modules.data as
                *const context::Module;
        if (modules[module_id].visit_state == 0) {
            visit_imports(context, module_id, 0);
        }
    }
    return context->error == runtime::Error.none;
}

fn symbols_have_same_name(context: *context::Context, left: context::Symbol, right: context::Symbol) -> bool {
    return left.kind != context::SymbolKind.enum_member && right.kind != context::SymbolKind.enum_member &&
        context::tokens_equal(
            context, left.declaration_unit, left.name_token, right.declaration_unit, right.name_token);
}

fn previous_selective_name(
    context: *context::Context, import_record: context::Import, container: syntax::SyntaxNode,
    current_child: usize) -> usize {
    let current: syntax::SyntaxNode = context::node(context, import_record.source_unit, current_child);
    for (var child: usize = container.first_child;
        child != context::no_id() && child != current_child;
        child = context::node(context, import_record.source_unit, child).next_sibling) {
        let candidate: syntax::SyntaxNode = context::node(context, import_record.source_unit, child);
        if (context::tokens_equal(
                context, import_record.source_unit, candidate.token_index, import_record.source_unit,
                current.token_index)) {
            return child;
        }
    }
    return context::no_id();
}

fn symbol_is_exported_from(symbol: context::Symbol, module_id: usize) -> bool {
    let exported: bool = (symbol.flags & (context::SymbolFlag.exported as usize)) != 0;
    return symbol.module_id == module_id && exported;
}

fn import_exposes_symbol(context: *context::Context, import_record: context::Import, symbol: context::Symbol) -> bool {
    return symbol_is_exported_from(symbol, import_record.target_module) &&
        names::import_binds_symbol(context, import_record, symbol);
}

fn diagnose_import_collision(
    context: *context::Context, left: context::Import, right: context::Import, symbol_id: usize) {
    context::add_diagnostic(
        context, context::DiagnosticKind.ambiguous_import, right.source_unit,
        context::node(context, right.source_unit, right.declaration_node).span, left.source_unit,
        context::node(context, left.source_unit, left.declaration_node).span, symbol_id);
}

fn validate_selective_import_pair(
    context: *context::Context, left: context::Import, right: context::Import, symbols: *const context::Symbol) {
    let none: usize = context::no_id();
    if (left.selective_node == none || right.selective_node == none) {
        return;
    }
    for (var left_symbol_id: usize = 0; left_symbol_id < context->symbol_count; left_symbol_id += 1) {
        let left_symbol: context::Symbol = symbols[left_symbol_id];
        if (!import_exposes_symbol(context, left, left_symbol)) {
            continue;
        }
        for (var right_symbol_id: usize = 0; right_symbol_id < context->symbol_count; right_symbol_id += 1) {
            let right_symbol: context::Symbol = symbols[right_symbol_id];
            let right_is_exposed: bool = import_exposes_symbol(context, right, right_symbol);
            let names_match: bool = symbols_have_same_name(context, left_symbol, right_symbol);
            if (right_is_exposed && names_match) {
                diagnose_import_collision(context, left, right, right_symbol_id);
            }
        }
    }
}

fn validate_import_collisions(
    context: *context::Context, module_record: context::Module,
    imports: *const context::Import, symbols: *const context::Symbol) {
    for (var left_index: usize = 0; left_index < module_record.import_count; left_index += 1) {
        let left: context::Import = imports[module_record.first_import + left_index];
        for (var right_index: usize = left_index + 1; right_index < module_record.import_count; right_index += 1) {
            let right: context::Import = imports[module_record.first_import + right_index];
            validate_selective_import_pair(context, left, right, symbols);
        }
    }
}

fn local_symbol_is_visible(symbol: context::Symbol, module_id: usize) -> bool {
    return symbol.module_id == module_id && symbol.kind != context::SymbolKind.enum_member;
}

fn diagnose_local_import_collision(
    context: *context::Context, local: context::Symbol, imported: context::Symbol, imported_id: usize) {
    context::add_diagnostic(
        context, context::DiagnosticKind.duplicate_name, local.declaration_unit,
        context::token(context, local.declaration_unit, local.name_token).span, imported.declaration_unit,
        context::token(context, imported.declaration_unit, imported.name_token).span, imported_id);
}

fn validate_local_import_collisions(
    context: *context::Context, module_id: usize, module_record: context::Module,
    imports: *const context::Import, symbols: *const context::Symbol) {
    for (var local_id: usize = 0; local_id < context->symbol_count; local_id += 1) {
        let local: context::Symbol = symbols[local_id];
        if (!local_symbol_is_visible(local, module_id)) {
            continue;
        }
        for (var import_index: usize = 0; import_index < module_record.import_count; import_index += 1) {
            let import_record: context::Import = imports[module_record.first_import + import_index];
            if (import_record.selective_node == context::no_id()) {
                continue;
            }
            for (var imported_id: usize = 0; imported_id < context->symbol_count; imported_id += 1) {
                let imported: context::Symbol = symbols[imported_id];
                let imported_is_exposed: bool = import_exposes_symbol(context, import_record, imported);
                let names_match: bool = symbols_have_same_name(context, local, imported);
                if (imported_is_exposed && names_match) {
                    diagnose_local_import_collision(context, local, imported, imported_id);
                }
            }
        }
    }
}

fn selective_name_is_exported(
    context: *context::Context, import_record: context::Import,
    name: syntax::SyntaxNode, symbols: *const context::Symbol) -> bool {
    for (var symbol_id: usize = 0; symbol_id < context->symbol_count; symbol_id += 1) {
        let symbol: context::Symbol = symbols[symbol_id];
        if (!symbol_is_exported_from(symbol, import_record.target_module)) {
            continue;
        }
        if (context::tokens_equal(
                context, import_record.source_unit, name.token_index, symbol.declaration_unit, symbol.name_token)) {
            return true;
        }
    }
    return false;
}

fn validate_selective_import(
    context: *context::Context, import_record: context::Import, symbols: *const context::Symbol) {
    if (import_record.selective_node == context::no_id()) {
        return;
    }
    let container: syntax::SyntaxNode = context::node(context, import_record.source_unit, import_record.selective_node);
    if (container.child_count == 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.empty_selective_import, import_record.source_unit,
            context::node(context, import_record.source_unit, import_record.declaration_node).span,
            context::no_id(), context::empty_span(), 0);
    }
    for (var child: usize = container.first_child;
        child != context::no_id();
        child = context::node(context, import_record.source_unit, child).next_sibling) {
        let name: syntax::SyntaxNode = context::node(context, import_record.source_unit, child);
        let duplicate: usize = previous_selective_name(context, import_record, container, child);
        if (duplicate != context::no_id()) {
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_selective_import_name, import_record.source_unit,
                name.span, import_record.source_unit,
                context::node(context, import_record.source_unit, duplicate).span, name.token_index);
        }
        if (!selective_name_is_exported(context, import_record, name, symbols)) {
            context::add_diagnostic(
                context, context::DiagnosticKind.unknown_selective_import, import_record.source_unit,
                name.span, context::no_id(), context::empty_span(), name.token_index);
        }
    }
}

fn validate_selective_imports(
    context: *context::Context, module_record: context::Module,
    imports: *const context::Import, symbols: *const context::Symbol) {
    for (var index: usize = 0; index < module_record.import_count; index += 1) {
        validate_selective_import(context, imports[module_record.first_import + index], symbols);
    }
}

fn validate_imported_names(context: *context::Context) -> bool {
    let modules: *const context::Module = context->modules.data as *const context::Module;
    let imports: *const context::Import = context->imports.data as *const context::Import;
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    for (var module_id: usize = 0; module_id < context->module_count; module_id += 1) {
        let module_record: context::Module = modules[module_id];
        validate_import_collisions(context, module_record, imports, symbols);
        validate_local_import_collisions(context, module_id, module_record, imports, symbols);
        validate_selective_imports(context, module_record, imports, symbols);
    }
    return context->error == runtime::Error.none;
}

fn mark_reachable(context: *context::Context, module_id: usize, depth: usize) -> bool {
    if (module_id >= context->module_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let modules: *context::Module = context->modules.data as *context::Module;
    if (modules[module_id].reachable) {
        return true;
    }
    if (depth >= context::Limit.maximum_module_depth as usize) {
        context::add_diagnostic(
            context, context::DiagnosticKind.resource_limit, modules[module_id].name_unit,
            context::node(context, modules[module_id].name_unit, modules[module_id].name_node).span,
            context::no_id(), context::empty_span(), depth);
        return false;
    }
    modules[module_id].reachable = true;
    let first_import: usize = modules[module_id].first_import;
    let import_count: usize = modules[module_id].import_count;
    for (var index: usize = 0; index < import_count; index += 1) {
        let imports: *const context::Import = context->imports.data as
                *const context::Import;
        if (!mark_reachable(
            context, imports[first_import + index].target_module, depth + 1)) {
            return false;
        }
    }
    return true;
}

fn validate_reachability(context: *context::Context, root_module: usize) -> bool {
    if (root_module >= context->module_count) {
        return false;
    }
    if (!mark_reachable(
            context, root_module, 0)) {
        return false;
    }
    let modules: *const context::Module = context->modules.data as
            *const context::Module;
    for (var module_id: usize = 0; module_id < context->module_count; module_id += 1) {
        if (!modules[module_id].reachable) {
            context::add_diagnostic(
                context, context::DiagnosticKind.unreachable_module, modules[module_id].name_unit,
                context::node(context, modules[module_id].name_unit, modules[module_id].name_node).span,
                context::no_id(), context::empty_span(), module_id);
        }
    }
    return true;
}
