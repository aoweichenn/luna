module luna.bootstrap.middleend.semantic.callable;

import luna.compiler.types as type_info;

fn no_owner() -> usize {
    return type_info::no_id();
}

fn free_function() -> Identity {
    return {
        kind = Kind.free_function, owner_type = no_owner(), receiver = ReceiverKind.none,
    };
}

fn has_owner(identity: Identity) -> bool {
    return identity.owner_type != no_owner();
}

fn has_receiver(identity: Identity) -> bool {
    return identity.receiver != ReceiverKind.none;
}

fn receiver_is_valid(receiver: ReceiverKind) -> bool {
    switch (receiver) {
    case ReceiverKind.none, ReceiverKind.writable, ReceiverKind.read_only,
        ReceiverKind.writable_volatile, ReceiverKind.read_only_volatile {
        return true;
    }
    default {
        return false;
    }
    }
}

fn shape_is_valid(identity: Identity) -> bool {
    let owner_exists: bool = has_owner(identity);
    let receiver_exists: bool = has_receiver(identity);
    switch (identity.kind) {
    case Kind.free_function {
        return !owner_exists && !receiver_exists;
    }
    case Kind.static_method {
        return owner_exists && !receiver_exists;
    }
    case Kind.instance_method, Kind.operator_method {
        return owner_exists && receiver_exists;
    }
    case Kind.constructor, Kind.destructor {
        return owner_exists && identity.receiver == ReceiverKind.writable;
    }
    default {
        return false;
    }
    }
}

fn is_valid(identity: Identity, type_count: usize) -> bool {
    if (!receiver_is_valid(identity.receiver) || !shape_is_valid(identity)) {
        return false;
    }
    return !has_owner(identity) || identity.owner_type < type_count;
}

fn same_owner(left: Identity, right: Identity) -> bool {
    return left.owner_type == right.owner_type;
}

fn same_identity(left: Identity, right: Identity) -> bool {
    let callable_shape_matches: bool = left.kind == right.kind && left.receiver == right.receiver;
    return callable_shape_matches && same_owner(left, right);
}
