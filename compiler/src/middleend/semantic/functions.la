module luna.bootstrap.middleend.semantic.functions;

import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.classes as classes;
import luna.bootstrap.middleend.semantic.classes.model as class_model;
import luna.bootstrap.middleend.semantic.consteval.engine as const_engine;
import luna.bootstrap.middleend.semantic.consteval.model as const_model;
import luna.bootstrap.middleend.semantic.context.lookup as names;
import luna.bootstrap.middleend.semantic.generics.model as generic_model;
import luna.bootstrap.middleend.semantic.generics;
import luna.bootstrap.middleend.semantic.types as types;
import luna.compiler.types as type_info;
import luna.runtime as runtime;
import luna.std.bytes as bytes;
import luna.std.checked as checked;

fn append_function(context: *context::Context, function: context::Function) -> usize {
    let result: usize = context->function_count;
    if (!names::append_record(
            context, &context->functions, (&function) as
                *const context::Function as *const u8, sizeof(context::Function))) {
        return context::no_id();
    }
    context->function_count += 1;
    return result;
}

fn append_parameter(context: *context::Context, parameter: context::Parameter) -> usize {
    let result: usize = context->parameter_count;
    if (!names::append_record(
            context, &context->parameters, (&parameter) as
                *const context::Parameter as *const u8, sizeof(context::Parameter))) {
        return context::no_id();
    }
    context->parameter_count += 1;
    return result;
}

enum FunctionPartKind: usize {
    generic_parameters, parameter, return_type, initializer, body, asm_body, attribute, invalid,
}

fn function_part_kind(node: syntax::SyntaxNode) -> FunctionPartKind {
    switch (node.kind) {
    case syntax::SyntaxKind.generic_parameters {
        return FunctionPartKind.generic_parameters;
    }
    case syntax::SyntaxKind.parameter {
        return FunctionPartKind.parameter;
    }
    case syntax::SyntaxKind.type_builtin, syntax::SyntaxKind.type_named, syntax::SyntaxKind.type_pointer,
        syntax::SyntaxKind.type_array, syntax::SyntaxKind.type_function, syntax::SyntaxKind.type_method_function,
        syntax::SyntaxKind.type_generic, syntax::SyntaxKind.type_reference {
        return FunctionPartKind.return_type;
    }
    case syntax::SyntaxKind.constructor_initializer {
        return FunctionPartKind.initializer;
    }
    case syntax::SyntaxKind.block_statement {
        return FunctionPartKind.body;
    }
    case syntax::SyntaxKind.string_expression, syntax::SyntaxKind.invalid {
        return FunctionPartKind.asm_body;
    }
    case syntax::SyntaxKind.attribute {
        return FunctionPartKind.attribute;
    }
    default {
        return FunctionPartKind.invalid;
    }
    }
}

fn function_parts(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, parameter_count: *usize,
    return_node: *usize, body_node: *usize) -> bool {
    let none: usize = context::no_id();
    if (parameter_count == null || return_node == null || body_node == null) {
        return false;
    }
    *parameter_count = 0;
    *return_node = none;
    *body_node = none;
    for (var child: usize = declaration.first_child; child != none;
        child = context::node(context, unit_index, child).next_sibling) {
        let node: syntax::SyntaxNode = context::node(context, unit_index, child);
        let header_is_open: bool = *return_node == none && *body_node == none;
        switch (function_part_kind(node)) {
        case FunctionPartKind.generic_parameters {
            if (!header_is_open || *parameter_count != 0) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
        }
        case FunctionPartKind.parameter {
            if (!header_is_open) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
            *parameter_count += 1;
        }
        case FunctionPartKind.return_type {
            if (!header_is_open) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
            *return_node = child;
        }
        case FunctionPartKind.initializer {
            if (*body_node != none) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
        }
        case FunctionPartKind.body {
            if (*body_node != none) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
            *body_node = child;
        }
        case FunctionPartKind.asm_body {
            // asm fn 的相邻字符串在 parser 中合并为一个节点；非法正文也以 invalid 节点保留诊断位置。
            let asm_function: bool = (declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) != 0;
            if (*body_node != none || !asm_function) {
                context->error = runtime::Error.invalid_argument;
                return false;
            }
            *body_node = child;
        }
        case FunctionPartKind.attribute {}
        case FunctionPartKind.invalid {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        }
    }
    return true;
}

fn first_parameter_node(context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode) -> usize {
    for (var child: usize = declaration.first_child; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        if (context::node(context, unit_index, child).kind == syntax::SyntaxKind.parameter) {
            return child;
        }
    }
    return context::no_id();
}

fn parameter_name_exists(
    context: *context::Context, function_id: usize, unit_index: usize, name_token: usize) -> usize {
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    for (var index: usize = 0; index < context->parameter_count; index += 1) {
        if (parameters[index].function_id == function_id &&
            context::tokens_equal(
                context, unit_index, name_token, parameters[index].unit_index, parameters[index].name_token)) {
            return index;
        }
    }
    return context::no_id();
}

fn collect_function_parameters(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: syntax::SyntaxNode,
    expected_parameter_count: usize, defaults_are_enabled: bool) -> bool {
    var functions: *context::Function = context->functions.data as
            *context::Function;
    var child: usize = first_parameter_node(context, unit_index, declaration);
    var defaults_are_valid: bool = true;
    for (var index: usize = 0; index < expected_parameter_count; index += 1) {
        let parameter_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        let child_count_is_valid: bool = parameter_node.child_count == 1 || parameter_node.child_count == 2;
        if (parameter_node.kind != syntax::SyntaxKind.parameter || !child_count_is_valid) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        let duplicate: usize = parameter_name_exists(context, function_id, unit_index, parameter_node.token_index);
        if (duplicate != context::no_id()) {
            let parameters: *const context::Parameter = context->parameters.data as
                    *const context::Parameter;
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_parameter, unit_index,
                context::token(context, unit_index, parameter_node.token_index).span, parameters[duplicate].unit_index,
                context::token(context, parameters[duplicate].unit_index, parameters[duplicate].name_token).span,
                duplicate);
        }
        let type_id: usize = types::resolve_type_node(context, unit_index, parameter_node.first_child);
        if (type_id != context::no_id()) {
            types::require_opaque_value_access(context, type_id, unit_index, parameter_node.span);
            if (!types::require_complete_type(context, type_id)) {
                return false;
            }
            let type_record: type_info::RecordResult = context->types.record(type_id);
            if (type_record.error != runtime::Error.none) {
                context->error = type_record.error;
                return false;
            }
            if (type_record.record.kind == type_info::Kind.type_void || (type_record.record.flags &
                    ((type_info::Flag.header as usize) | (type_info::Flag.flexible as usize))) != 0) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.incomplete_type, unit_index, parameter_node.span, context::no_id(),
                    context::empty_span(), type_id);
            }
            if (functions[function_id].parameter_count == 0) {
                functions[function_id].first_parameter = context->parameter_count;
            }
            let default_node: usize = parameter_default_node(context, unit_index, parameter_node);
            let default_value: DefaultValue = collect_parameter_default(
                context, unit_index, declaration, parameter_node, type_id, defaults_are_enabled);
            if (default_node != context::no_id() && !default_value.valid) {
                defaults_are_valid = false;
            }
            append_parameter(
                context, {
                    function_id = function_id, type_id = type_id, unit_index = unit_index, declaration_node = child,
                    name_token = parameter_node.token_index,
                    default_node = default_value.valid ? default_node : context::no_id(),
                    default_value = default_value.value, default_kind = default_value.kind,
                });
            functions = context->functions.data as
                *context::Function;
            functions[function_id].parameter_count += 1;
        }
        child = parameter_node.next_sibling;
    }
    if (!defaults_are_valid) {
        functions = context->functions.data as *context::Function;
        functions[function_id].required_parameter_count = expected_parameter_count;
    }
    return context->error == runtime::Error.none;
}

fn external_name_is_reserved(context: *context::Context, unit_index: usize, token_index: usize) -> bool {
    let token: lexer::Token = context::token(context, unit_index, token_index);
    let unit: *const context::Unit = context::input_unit(context, unit_index);
    return context::token_equals_bytes(context, unit_index, token_index, "_start", 6) ||
        (unit != null && token.span.length >= 2 && unit->source.data[token.span.offset] == '_' &&
            unit->source.data[token.span.offset + 1] == 'L');
}

fn diagnose_external_type(
    context: *context::Context, type_id: usize, unit_index: usize, span: lexer::SourceSpan,
    related_unit: usize, related_span: lexer::SourceSpan) -> bool {
    if (type_id == context::no_id()) {
        return true;
    }
    let kind: type_info::Kind = context::type_record(context, type_id).kind;
    let aggregate_is_invalid: bool = kind == type_info::Kind.array || kind == type_info::Kind.class_type;
    let callable_is_invalid: bool = kind == type_info::Kind.bound_method || kind == type_info::Kind.reference;
    let type_is_invalid: bool = aggregate_is_invalid || callable_is_invalid;
    if (!type_is_invalid) {
        return true;
    }
    let diagnostic: context::DiagnosticKind = kind == type_info::Kind.class_type ?
        context::DiagnosticKind.invalid_class_abi : context::DiagnosticKind.invalid_external;
    return context::add_diagnostic(context, diagnostic, unit_index, span, related_unit, related_span, type_id);
}

fn validate_external_signature(context: *context::Context, function_id: usize) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let function: context::Function = functions[function_id];
    let symbol: context::Symbol = symbols[function.symbol_id];
    if (external_name_is_reserved(
            context, symbol.declaration_unit, symbol.name_token)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_external, symbol.declaration_unit,
            context::token(context, symbol.declaration_unit, symbol.name_token).span,
            context::no_id(), context::empty_span(), function_id);
    }
    diagnose_external_type(
        context, function.return_type, symbol.declaration_unit,
        context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
        context::no_id(), context::empty_span());
    for (var index: usize = 0; index < function.parameter_count; index += 1) {
        let parameter: context::Parameter = parameters[function.first_parameter + index];
        diagnose_external_type(
            context, parameter.type_id, parameter.unit_index,
            context::node(context, parameter.unit_index, parameter.declaration_node).span, symbol.declaration_unit,
            context::node(context, symbol.declaration_unit, symbol.declaration_node).span);
    }
    return context->error == runtime::Error.none;
}

// An `asm fn` is an implementation-unit definition whose entire body is
// one or more adjacent string literals (m1.4 concatenation included) and
// nothing else, carried as one string_expression of plain-width literals.
// Interface-unit, extern or bodyless asm declarations and any other body
// content are invalid_asm_function.
fn validate_asm_function(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if ((declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) == 0) {
        return true;
    }
    var valid: bool = !interface_unit && (declaration.flags & ((syntax::SyntaxFlag.external as usize) |
                (syntax::SyntaxFlag.bodyless as usize))) == 0;
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (valid && !function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    if (valid && body_node != none) {
        let body: syntax::SyntaxNode = context::node(context, unit_index, body_node);
        if (body.kind != syntax::SyntaxKind.string_expression ||
            context::token(context, unit_index, body.token_index).kind != lexer::TokenKind.string) {
            valid = false;
        }
        for (var part: usize = body.first_child; valid && part != none;
            part = context::node(context, unit_index, part).next_sibling) {
            let part_node: syntax::SyntaxNode = context::node(context, unit_index, part);
            if (part_node.kind != syntax::SyntaxKind.string_expression ||
                context::token(context, unit_index, part_node.token_index).kind != lexer::TokenKind.string) {
                valid = false;
                break;
            }
        }
    } else if (valid) {
        valid = false;
    }
    if (!valid) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_asm_function, unit_index, declaration.span, none,
            context::empty_span(), 0);
    }
    return context->error == runtime::Error.none;
}

fn validate_function_declaration_form(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode,
    interface_unit: bool, defaults: *DefaultProfile) -> bool {
    let none: usize = context::no_id();
    if (defaults == null) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    *defaults = function_default_profile(context, unit_index, declaration, parameter_count);
    let external: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.external);
    let exported: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.exported);
    let bodyless: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.bodyless);
    let visibility_is_invalid: bool = !interface_unit && exported;
    let external_body_is_invalid: bool = external && !bodyless;
    let interface_body_is_invalid: bool = interface_unit && !bodyless;
    let body_is_invalid: bool = external_body_is_invalid || interface_body_is_invalid;
    if (visibility_is_invalid || body_is_invalid) {
        let kind: context::DiagnosticKind = visibility_is_invalid ? context::DiagnosticKind.invalid_export :
            context::DiagnosticKind.invalid_external;
        context::add_diagnostic(context, kind, unit_index, declaration.span, none, context::empty_span(), 0);
    }
    let variadic: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.variadic);
    if (variadic && parameter_count == 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_variadic, unit_index, declaration.span, none,
            context::empty_span(), 0);
    }
    return context->error == runtime::Error.none;
}

fn add_function_declaration(
    context: *context::Context, identity: domain::CallableIdentity, module_id: usize, unit_index: usize,
    declaration_id: usize, declaration: syntax::SyntaxNode, interface_unit: bool, defaults: DefaultProfile) -> usize {
    let none: usize = context::no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return none;
    }
    let external: bool = (declaration.flags & (syntax::SyntaxFlag.external as usize)) != 0;
    let exported: bool = (declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0;
    // A `...` tail requires at least one named parameter; it is legal both
    // on extern declarations and on Luna-defined variadic functions (their
    // prologue builds the System V register save area for va_start/va_arg).
    let variadic: bool = (declaration.flags & (syntax::SyntaxFlag.variadic as usize)) != 0;
    var flags: usize = context::SymbolFlag.none as usize;
    if (exported) {
        flags |= context::SymbolFlag.exported as usize;
    }
    if (external) {
        flags |= context::SymbolFlag.external as usize;
    }
    if (variadic && parameter_count != 0) {
        flags |= context::SymbolFlag.variadic as usize;
    }
    if ((declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) != 0) {
        flags |= context::SymbolFlag.asm_function as usize;
    }
    if ((declaration.flags & (syntax::SyntaxFlag.abstract_method as usize)) != 0) {
        flags |= context::SymbolFlag.abstract_method as usize;
    }
    if (interface_unit) {
        flags |= context::SymbolFlag.interface_declaration as usize;
    }
    if (attributes::declaration_has_attribute(
            context, unit_index, declaration, attributes::Attribute.no_return)) {
        flags |= context::SymbolFlag.no_return as usize;
    }
    if (attributes::declaration_has_attribute(
            context, unit_index, declaration, attributes::Attribute.inline_hint)) {
        flags |= context::SymbolFlag.inline_hint as usize;
    }
    let symbol_id: usize = names::append_symbol(
        context, {
            kind = context::SymbolKind.function, module_id = module_id, declaration_unit = unit_index,
            declaration_node = declaration_id, name_token = declaration.token_index, type_id = none,
            function_id = context->function_count, integer_value = 0, flags = flags,
        });
    if (symbol_id == none) {
        return none;
    }
    let function_id: usize = append_function(
        context, {
            identity = identity, symbol_id = symbol_id, binding_id = none,
            interface_unit = interface_unit ? unit_index : none,
            interface_node = interface_unit ? declaration_id : none, implementation_unit = interface_unit ?
                none : unit_index, implementation_node = interface_unit ? none : declaration_id,
            return_type = type_info::BuiltinType.type_void as usize, first_parameter = none, parameter_count = 0,
            required_parameter_count = defaults.valid ? defaults.required_parameter_count : parameter_count,
            signature_offset = none, signature_length = 0, ir_function = none, flags = flags,
        });
    if (function_id == none) {
        return none;
    }
    if (return_node != none) {
        let return_type: usize = types::resolve_type_node(context, unit_index, return_node);
        if (return_type != none) {
            types::require_opaque_value_access(
                context, return_type, unit_index, context::node(context, unit_index, return_node).span);
            types::require_complete_type(context, return_type);
        }
        if (return_type != none && (context::type_record(context, return_type).flags &
                ((type_info::Flag.header as usize) | (type_info::Flag.flexible as usize))) != 0) {
            context::add_diagnostic(
                context, context::DiagnosticKind.incomplete_type, unit_index,
                context::node(context, unit_index, return_node).span, none, context::empty_span(), return_type);
        }
        let functions: *context::Function = context->functions.data as
                *context::Function;
        functions[function_id].return_type = return_type;
    }
    let defaults_are_enabled: bool = defaults.valid && defaults.default_count != 0;
    collect_function_parameters(context, function_id, unit_index, declaration, parameter_count, defaults_are_enabled);
    if (external) {
        validate_external_signature(context, function_id);
    }
    return function_id;
}

fn collect_function_declaration(
    context: *context::Context, identity: domain::CallableIdentity, module_id: usize, unit_index: usize,
    declaration_id: usize, declaration: syntax::SyntaxNode, interface_unit: bool, duplicate_name: usize) {
    var defaults: DefaultProfile = {
        required_parameter_count = 0, default_count = 0, valid = false,
    };
    validate_function_declaration_form(context, unit_index, declaration, interface_unit, &defaults);
    let lookup: FunctionDeclarationLookup =
        lookup_function_declaration(context, identity, module_id, unit_index, declaration);
    let match: FunctionDeclarationMatch = classify_function_declaration(
        context, unit_index, declaration, interface_unit, duplicate_name, lookup.named_function, lookup.overload);
    switch (match.action) {
    case FunctionDeclarationAction.add_candidate {
        add_function_declaration(
            context, identity, module_id, unit_index, declaration_id, declaration, interface_unit, defaults);
    }
    case FunctionDeclarationAction.attach_definition {
        reject_repeated_defaults(context, match.related_id, unit_index, declaration, defaults);
        attach_function_definition(context, match.related_id, unit_index, declaration_id, declaration);
    }
    case FunctionDeclarationAction.duplicate_overload {
        report_function_declaration_conflict(
            context, context::DiagnosticKind.duplicate_function, unit_index, declaration, match.related_id);
    }
    case FunctionDeclarationAction.contract_mismatch {
        report_function_declaration_conflict(
            context, context::DiagnosticKind.signature_mismatch, unit_index, declaration, match.related_id);
    }
    case FunctionDeclarationAction.non_callable_conflict {
        report_function_declaration_conflict(
            context, context::DiagnosticKind.duplicate_name, unit_index, declaration, match.related_id);
    }
    }
}

fn generic_function_form_is_valid(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, interface_unit: bool) -> bool {
    let exported: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.exported);
    let bodyless: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.bodyless);
    let visibility_is_valid: bool = interface_unit ? exported : !exported;
    let named_export: bool = attributes::declaration_has_attribute(
        context, unit_index, declaration, attributes::Attribute.export_name);
    let form_is_valid: bool = visibility_is_valid && !bodyless;
    if (!form_is_valid || named_export) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_generic_declaration,
            unit_index, declaration.span, context::no_id(), context::empty_span(), declaration.flags);
        return false;
    }
    return true;
}

fn generic_name_conflicts(
    context: *context::Context, module_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> usize {
    let duplicate: usize = names::find_any_local_symbol(context, module_id, unit_index, declaration.token_index);
    if (duplicate == context::no_id()) {
        return context::no_id();
    }
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    let callable_name: bool = symbols[duplicate].kind == context::SymbolKind.function ||
        symbols[duplicate].kind == context::SymbolKind.generic_function;
    return callable_name ? context::no_id() : duplicate;
}

fn collect_generic_function(
    context: *context::Context, module_id: usize, unit_index: usize,
    declaration_id: usize, declaration: syntax::SyntaxNode, interface_unit: bool) {
    if (!generic_function_form_is_valid(context, unit_index, declaration, interface_unit)) {
        return;
    }
    let conflict: usize = generic_name_conflicts(context, module_id, unit_index, declaration);
    if (conflict != context::no_id()) {
        report_function_declaration_conflict(
            context, context::DiagnosticKind.duplicate_name, unit_index, declaration, conflict);
        return;
    }
    let duplicate_generic: usize = duplicate_generic_function(context, module_id, unit_index, declaration);
    if (duplicate_generic != context::no_id()) {
        let declarations: *const generic_model::Declaration = context->generics.declarations.data as
                *const generic_model::Declaration;
        let previous: generic_model::Declaration = declarations[duplicate_generic];
        let result_matches: bool = generic_function_result_matches(context, duplicate_generic, unit_index, declaration);
        let diagnostic_kind: context::DiagnosticKind = result_matches ?
            context::DiagnosticKind.duplicate_function : context::DiagnosticKind.signature_mismatch;
        context::add_diagnostic(
            context, diagnostic_kind, unit_index, declaration.span,
            previous.unit_index, context::node(context, previous.unit_index, previous.node_index).span,
            duplicate_generic);
        return;
    }
    let generic_id: usize = generics::register_declaration(
        context, generic_model::DeclarationKind.function_declaration,
        module_id, unit_index, declaration_id, context::no_id());
    if (generic_id == context::no_id()) {
        return;
    }
    var flags: usize = context::SymbolFlag.none as usize;
    if (declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.exported)) {
        flags |= context::SymbolFlag.exported as usize;
    }
    if (interface_unit) {
        flags |= context::SymbolFlag.interface_declaration as usize;
    }
    let symbol: context::Symbol = {
        kind = context::SymbolKind.generic_function, module_id = module_id,
        declaration_unit = unit_index, declaration_node = declaration_id,
        name_token = declaration.token_index, type_id = context::no_id(),
        function_id = generic_id, integer_value = 0, flags = flags,
    };
    names::append_symbol(context, symbol);
}

fn collect_functions_in_unit(
    context: *context::Context, module_id: usize, unit_index: usize, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    let identity: domain::CallableIdentity = domain::free_function();
    if (unit_index == none) {
        return true;
    }
    for (var declaration_id: usize = names::first_declaration(context, unit_index);
        declaration_id != none && context->error == runtime::Error.none;
        declaration_id = context::node(context, unit_index, declaration_id).next_sibling) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        if (declaration.kind == syntax::SyntaxKind.function_declaration && (declaration.flags &
                (syntax::SyntaxFlag.const_function as usize)) == 0) {
            if (generics::is_generic(context, unit_index, declaration)) {
                collect_generic_function(context, module_id, unit_index, declaration_id, declaration, interface_unit);
                continue;
            }
            validate_asm_function(context, unit_index, declaration, interface_unit);
            let duplicate_name: usize =
                names::find_any_local_symbol(context, module_id, unit_index, declaration.token_index);
            collect_function_declaration(
                context, identity, module_id, unit_index, declaration_id, declaration, interface_unit, duplicate_name);
        }
    }
    return context->error == runtime::Error.none;
}

fn collect_functions(context: *context::Context) -> bool {
    for (var module_id: usize = 0;
        module_id < context->module_count && context->error == runtime::Error.none;
        module_id += 1) {
        let modules: *const context::Module = context->modules.data as
                *const context::Module;
        if (!collect_functions_in_unit(context, module_id, modules[module_id].interface_unit, true)) {
            return false;
        }
        for (var implementation_index: usize = 0;
            implementation_index < modules[module_id].implementation_count;
            implementation_index += 1) {
            let implementation_unit: usize =
                names::module_implementation_unit(context, module_id, implementation_index);
            if (implementation_unit == context::no_id() ||
                !collect_functions_in_unit(
                    context, module_id, implementation_unit, false)) {
                return false;
            }
        }
    }
    if (!collect_class_methods(context)) {
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let modules: *const context::Module = context->modules.data as
            *const context::Module;
    for (var function_id: usize = 0; function_id < context->function_count; function_id += 1) {
        let function: context::Function = functions[function_id];
        let symbol: context::Symbol = symbols[function.symbol_id];
        let definition_is_missing: bool = function.interface_unit != context::no_id() &&
            function.implementation_unit == context::no_id();
        let definition_is_required: bool = modules[symbol.module_id].implementation_count != 0 &&
            (function.flags & (context::SymbolFlag.external as usize)) == 0;
        let abstract_method: bool = (function.flags & (context::SymbolFlag.abstract_method as usize)) != 0;
        let body_is_required: bool = definition_is_required && !abstract_method;
        if (definition_is_missing && body_is_required) {
            context::add_diagnostic(
                context, context::DiagnosticKind.missing_definition, symbol.declaration_unit,
                context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                context::no_id(), context::empty_span(), function_id);
        }
        if (function.implementation_unit != context::no_id() && (function.flags &
                (context::SymbolFlag.external as usize)) == 0) {
            let implementation: syntax::SyntaxNode =
                context::node(context, function.implementation_unit, function.implementation_node);
            if ((implementation.flags & (syntax::SyntaxFlag.bodyless as usize)) != 0) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.missing_definition, function.implementation_unit,
                    implementation.span, context::no_id(), context::empty_span(), function_id);
            }
        }
    }
    // Export names live outside the module/function mangling scheme, so the
    // usual per-module name uniqueness cannot catch collisions: two functions
    // emitting the same verbatim symbol are a duplicate_function.
    for (var outer: usize = 0;
        outer < context->function_count && context->error == runtime::Error.none;
        outer += 1) {
        let outer_function: context::Function = functions[outer];
        let outer_token: usize = function_export_name_token(context, outer_function);
        if (outer_token != context::no_id()) {
            let outer_span: lexer::SourceSpan = context::token(
                context, outer_function.implementation_unit, outer_token).span;
            let outer_content: lexer::SourceSpan = {
                offset = outer_span.offset + 1, length = outer_span.length - 2, line = outer_span.line,
                column = outer_span.column,
            };
            for (var inner: usize = outer + 1;
                inner < context->function_count && context->error == runtime::Error.none;
                inner += 1) {
                let inner_function: context::Function = functions[inner];
                let inner_token: usize = function_export_name_token(context, inner_function);
                if (inner_token != context::no_id()) {
                    let inner_span: lexer::SourceSpan =
                        context::token(context, inner_function.implementation_unit, inner_token).span;
                    let inner_content: lexer::SourceSpan = {
                        offset = inner_span.offset + 1, length = inner_span.length - 2, line = inner_span.line,
                        column = inner_span.column,
                    };
                    if (context::text_equal(
                            context, outer_function.implementation_unit, outer_content,
                            inner_function.implementation_unit, inner_content)) {
                        context::add_diagnostic(
                            context, context::DiagnosticKind.duplicate_function, inner_function.implementation_unit,
                            inner_span, outer_function.implementation_unit, outer_span, outer);
                    }
                }
            }
        }
    }
    return build_function_signatures(context) && build_function_bindings(context);
}

fn function_export_name_token(context: *context::Context, function: context::Function) -> usize {
    let none: usize = context::no_id();
    if (function.implementation_unit == none || (function.flags & (context::SymbolFlag.external as usize)) != 0) {
        return none;
    }
    let argument: usize = attributes::declaration_attribute_argument(
        context, function.implementation_unit,
        context::node(context, function.implementation_unit, function.implementation_node),
        attributes::Attribute.export_name);
    if (argument == none) {
        return none;
    }
    let argument_node: syntax::SyntaxNode = context::node(context, function.implementation_unit, argument);
    if (argument_node.kind != syntax::SyntaxKind.string_expression || argument_node.child_count != 0 ||
        !attributes::attribute_string_is_identifier(
            context, function.implementation_unit, argument_node.token_index)) {
        return none;
    }
    return argument_node.token_index;
}

// Token of a function's validated @export_name string literal in the
// function's implementation unit, no-id when the function carries no (valid)
// export name. Invalid arguments were already diagnosed by the attribute
// pass; they fall back to the mangled symbol here.
