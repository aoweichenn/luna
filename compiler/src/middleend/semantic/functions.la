module luna.bootstrap.middleend.semantic.functions;

import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.context.lookup as names;
import luna.bootstrap.middleend.semantic.types as types;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime as runtime;

fn append_function(context: *context::Context, function: context::Function) -> usize {
    let result: usize = context->function_count;
    if (!names::append_record(
            context, &context->functions, (&function) as
                *const context::Function as *const u8, sizeof(context::Function))) {
        return context::no_id();
    }
    context->function_count += 1;
    return result;
}

fn append_parameter(context: *context::Context, parameter: context::Parameter) -> usize {
    let result: usize = context->parameter_count;
    if (!names::append_record(
            context, &context->parameters, (&parameter) as
                *const context::Parameter as *const u8, sizeof(context::Parameter))) {
        return context::no_id();
    }
    context->parameter_count += 1;
    return result;
}

fn function_parts(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, parameter_count: *usize,
    return_node: *usize, body_node: *usize) -> bool {
    let none: usize = context::no_id();
    if (parameter_count == null || return_node == null || body_node == null) {
        return false;
    }
    *parameter_count = 0;
    *return_node = none;
    *body_node = none;
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (node.kind == syntax::SyntaxKind.parameter && *return_node == none && *body_node == none) {
            *parameter_count += 1;
        } else if ((node.kind == syntax::SyntaxKind.type_builtin || node.kind == syntax::SyntaxKind.type_named ||
                node.kind == syntax::SyntaxKind.type_pointer || node.kind == syntax::SyntaxKind.type_array ||
                node.kind == syntax::SyntaxKind.type_function) && *return_node == none && *body_node == none) {
            *return_node = child;
        } else if (node.kind == syntax::SyntaxKind.block_statement && *body_node == none) {
            *body_node = child;
        } else if ((node.kind == syntax::SyntaxKind.string_expression || node.kind == syntax::SyntaxKind.invalid) &&
            *body_node == none && (declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) != 0) {
            // An asm fn body is one string_expression (adjacent literals
            // concatenate in the parser); a non-string body was carried as
            // an invalid node for the semantic diagnostic.
            *body_node = child;
        } else if (node.kind != syntax::SyntaxKind.attribute) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        child = node.next_sibling;
    }
    return true;
}

fn parameter_name_exists(
    context: *context::Context, function_id: usize, unit_index: usize, name_token: usize) -> usize {
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    var index: usize = 0;
    while (index < context->parameter_count) {
        if (parameters[index].function_id == function_id &&
            context::tokens_equal(
                context, unit_index, name_token, parameters[index].unit_index, parameters[index].name_token)) {
            return index;
        }
        index += 1;
    }
    return context::no_id();
}

fn collect_function_parameters(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: syntax::SyntaxNode,
    expected_parameter_count: usize) -> bool {
    var functions: *context::Function = context->functions.data as
            *context::Function;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < expected_parameter_count) {
        let parameter_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (parameter_node.kind != syntax::SyntaxKind.parameter || parameter_node.child_count != 1) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        let duplicate: usize = parameter_name_exists(context, function_id, unit_index, parameter_node.token_index);
        if (duplicate != context::no_id()) {
            let parameters: *const context::Parameter = context->parameters.data as
                    *const context::Parameter;
            context::add_diagnostic(
                context, context::DiagnosticKind.duplicate_parameter, unit_index,
                context::token(context, unit_index, parameter_node.token_index).span, parameters[duplicate].unit_index,
                context::token(context, parameters[duplicate].unit_index, parameters[duplicate].name_token).span,
                duplicate);
        }
        let type_id: usize = types::resolve_type_node(context, unit_index, parameter_node.first_child);
        if (type_id != context::no_id()) {
            let type_record: type_info::RecordResult = type_info::table_get(context->types, type_id);
            if (type_record.error != runtime::Error.none) {
                context->error = type_record.error;
                return false;
            }
            if (type_record.record.kind == type_info::Kind.type_void || (type_record.record.flags &
                    ((type_info::Flag.header as usize) | (type_info::Flag.flexible as usize))) != 0) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.incomplete_type, unit_index, parameter_node.span, context::no_id(),
                    context::empty_span(), type_id);
            }
            if (functions[function_id].parameter_count == 0) {
                functions[function_id].first_parameter = context->parameter_count;
            }
            append_parameter(
                context, {
                    function_id = function_id, type_id = type_id, unit_index = unit_index, declaration_node = child,
                    name_token = parameter_node.token_index,
                });
            functions = context->functions.data as
                *context::Function;
            functions[function_id].parameter_count += 1;
        }
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn external_name_is_reserved(context: *context::Context, unit_index: usize, token_index: usize) -> bool {
    let token: lexer::Token = context::token(context, unit_index, token_index);
    let unit: *const context::Unit = context::input_unit(context, unit_index);
    return context::token_equals_bytes(context, unit_index, token_index, "_start", 6) ||
        (unit != null && token.span.length >= 2 && unit->source.data[token.span.offset] == '_' &&
            unit->source.data[token.span.offset + 1] == 'L');
}

fn validate_external_signature(context: *context::Context, function_id: usize) -> bool {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let function: context::Function = functions[function_id];
    let symbol: context::Symbol = symbols[function.symbol_id];
    if (external_name_is_reserved(
            context, symbol.declaration_unit, symbol.name_token)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_external, symbol.declaration_unit,
            context::token(context, symbol.declaration_unit, symbol.name_token).span,
            context::no_id(), context::empty_span(), function_id);
    }
    if (function.return_type != context::no_id() &&
        context::type_record(
            context, function.return_type).kind == type_info::Kind.array) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_external, symbol.declaration_unit,
            context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
            context::no_id(), context::empty_span(), function.return_type);
    }
    var index: usize = 0;
    while (index < function.parameter_count) {
        let parameter: context::Parameter = parameters[function.first_parameter + index];
        let record: type_info::Record = context::type_record(context, parameter.type_id);
        if (record.kind == type_info::Kind.array) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_external, parameter.unit_index,
                context::node(context, parameter.unit_index, parameter.declaration_node).span, symbol.declaration_unit,
                context::node(context, symbol.declaration_unit, symbol.declaration_node).span, parameter.type_id);
        }
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn find_module_function(context: *context::Context, module_id: usize, unit_index: usize, name_token: usize) -> usize {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    var index: usize = 0;
    while (index < context->function_count) {
        let symbol: context::Symbol = symbols[functions[index].symbol_id];
        if (symbol.module_id == module_id &&
            context::tokens_equal(
                context, unit_index, name_token, symbol.declaration_unit, symbol.name_token)) {
            return index;
        }
        index += 1;
    }
    return context::no_id();
}

// An `asm fn` is an implementation-unit definition whose entire body is
// one or more adjacent string literals (m1.4 concatenation included) and
// nothing else, carried as one string_expression of plain-width literals.
// Interface-unit, extern or bodyless asm declarations and any other body
// content are invalid_asm_function.
fn validate_asm_function(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if ((declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) == 0) {
        return true;
    }
    var valid: bool = !interface_unit && (declaration.flags & ((syntax::SyntaxFlag.external as usize) |
                (syntax::SyntaxFlag.bodyless as usize))) == 0;
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (valid && !function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    if (valid && body_node != none) {
        let body: syntax::SyntaxNode = context::node(context, unit_index, body_node);
        if (body.kind != syntax::SyntaxKind.string_expression ||
            context::token(context, unit_index, body.token_index).kind != lexer::TokenKind.string) {
            valid = false;
        }
        var part: usize = body.first_child;
        while (valid && part != none) {
            let part_node: syntax::SyntaxNode = context::node(context, unit_index, part);
            if (part_node.kind != syntax::SyntaxKind.string_expression ||
                context::token(context, unit_index, part_node.token_index).kind != lexer::TokenKind.string) {
                valid = false;
                break;
            }
            part = part_node.next_sibling;
        }
    } else if (valid) {
        valid = false;
    }
    if (!valid) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_asm_function, unit_index, declaration.span, none,
            context::empty_span(), 0);
    }
    return context->error == runtime::Error.none;
}

fn add_function_declaration(
    context: *context::Context, module_id: usize, unit_index: usize, declaration_id: usize,
    declaration: syntax::SyntaxNode, interface_unit: bool) -> usize {
    let none: usize = context::no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return none;
    }
    let external: bool = (declaration.flags & (syntax::SyntaxFlag.external as usize)) != 0;
    let exported: bool = (declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0;
    let bodyless: bool = (declaration.flags & (syntax::SyntaxFlag.bodyless as usize)) != 0;
    // A `...` tail requires at least one named parameter; it is legal both
    // on extern declarations and on Luna-defined variadic functions (their
    // prologue builds the System V register save area for va_start/va_arg).
    let variadic: bool = (declaration.flags & (syntax::SyntaxFlag.variadic as usize)) != 0;
    if ((!interface_unit && exported) || (external && !bodyless) || (interface_unit && !bodyless)) {
        context::add_diagnostic(
            context, (!interface_unit && exported) ? context::DiagnosticKind.invalid_export :
                context::DiagnosticKind.invalid_external, unit_index, declaration.span, none, context::empty_span(), 0);
    }
    if (variadic && parameter_count == 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_variadic, unit_index, declaration.span, none,
            context::empty_span(), 0);
    }
    var flags: usize = context::SymbolFlag.none as usize;
    if (exported) {
        flags |= context::SymbolFlag.exported as usize;
    }
    if (external) {
        flags |= context::SymbolFlag.external as usize;
    }
    if (variadic && parameter_count != 0) {
        flags |= context::SymbolFlag.variadic as usize;
    }
    if ((declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) != 0) {
        flags |= context::SymbolFlag.asm_function as usize;
    }
    if (interface_unit) {
        flags |= context::SymbolFlag.interface_declaration as usize;
    }
    if (attributes::declaration_has_attribute(
            context, unit_index, declaration, attributes::Attribute.no_return)) {
        flags |= context::SymbolFlag.no_return as usize;
    }
    if (attributes::declaration_has_attribute(
            context, unit_index, declaration, attributes::Attribute.inline_hint)) {
        flags |= context::SymbolFlag.inline_hint as usize;
    }
    let symbol_id: usize = names::append_symbol(
        context, {
            kind = context::SymbolKind.function, module_id = module_id, declaration_unit = unit_index,
            declaration_node = declaration_id, name_token = declaration.token_index, type_id = none,
            function_id = context->function_count, integer_value = 0, flags = flags,
        });
    if (symbol_id == none) {
        return none;
    }
    let function_id: usize = append_function(
        context, {
            symbol_id = symbol_id, interface_unit = interface_unit ? unit_index : none,
            interface_node = interface_unit ? declaration_id : none, implementation_unit = interface_unit ?
                none : unit_index, implementation_node = interface_unit ? none : declaration_id,
            return_type = type_info::BuiltinType.type_void as usize, first_parameter = none, parameter_count = 0,
            ir_function = none, flags = flags,
        });
    if (function_id == none) {
        return none;
    }
    if (return_node != none) {
        let return_type: usize = types::resolve_type_node(context, unit_index, return_node);
        if (return_type != none && (context::type_record(context, return_type).flags &
                ((type_info::Flag.header as usize) | (type_info::Flag.flexible as usize))) != 0) {
            context::add_diagnostic(
                context, context::DiagnosticKind.incomplete_type, unit_index,
                context::node(context, unit_index, return_node).span, none, context::empty_span(), return_type);
        }
        let functions: *context::Function = context->functions.data as
                *context::Function;
        functions[function_id].return_type = return_type;
    }
    collect_function_parameters(context, function_id, unit_index, declaration, parameter_count);
    if (external) {
        validate_external_signature(context, function_id);
    }
    return function_id;
}

fn function_signature_matches(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[function_id];
    if (parameter_count != function.parameter_count) {
        return false;
    }
    let variadic: bool = (declaration.flags & (syntax::SyntaxFlag.variadic as usize)) != 0;
    if (variadic != ((function.flags & (context::SymbolFlag.variadic as usize)) != 0)) {
        return false;
    }
    let actual_return: usize = return_node == none ? type_info::BuiltinType.type_void as usize :
        types::resolve_type_node(context, unit_index, return_node);
    if (actual_return != function.return_type) {
        return false;
    }
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < parameter_count) {
        let parameter_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        let actual_type: usize = types::resolve_type_node(context, unit_index, parameter_node.first_child);
        if (actual_type != parameters[function.first_parameter + index].type_id) {
            return false;
        }
        child = parameter_node.next_sibling;
        index += 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// const fn collection and body validation
// // A `const fn` exists only for the constant evaluator: it registers a
// const_function symbol (never a runtime function, so a runtime call
// resolves to unknown_name) plus a context::ConstFunction record
// whose parameters reuse the shared parameter buffer with function_id set
// to no-id so regular duplicate detection never matches them. Bodies are
// restricted to the statement subset the interpreter walks; anything else
// is invalid_const_function.

fn append_const_function(context: *context::Context, record: context::ConstFunction) -> usize {
    let result: usize = context->const_function_count;
    if (!names::append_record(
            context, &context->const_functions, (&record) as
                *const context::ConstFunction as *const u8, sizeof(context::ConstFunction))) {
        return context::no_id();
    }
    context->const_function_count += 1;
    return result;
}

fn report_invalid_const_function(context: *context::Context, unit_index: usize, span: lexer::SourceSpan) -> bool {
    return context::add_diagnostic(
        context, context::DiagnosticKind.invalid_const_function, unit_index, span, context::no_id(),
        context::empty_span(), 0);
}

fn const_scalar_type(context: *context::Context, type_id: usize) -> bool {
    var record: type_info::Record = context::type_record(context, type_id);
    if (record.kind == type_info::Kind.alias && types::require_complete_type(context, type_id)) {
        record = context::type_record(context, record.element_type);
    }
    return type_info::is_integer(record.kind) || record.kind == type_info::Kind.boolean;
}

fn validate_const_call(context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    if (node.child_count == 0) {
        return false;
    }
    let callee: syntax::SyntaxNode = context::node(context, unit_index, node.first_child);
    if (callee.kind != syntax::SyntaxKind.name_expression) {
        return false;
    }
    let symbol_id: usize =
        names::lookup_qualified_symbol(context, unit_index, callee, context::SymbolKind.const_function, false);
    if (symbol_id == none) {
        return false;
    }
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    let records: *const context::ConstFunction = context->const_functions.data as
            *const context::ConstFunction;
    if (node.child_count - 1 != records[symbols[symbol_id].function_id].parameter_count) {
        return false;
    }
    var valid: bool = true;
    var argument: usize = callee.next_sibling;
    while (argument != none && valid) {
        valid = validate_const_expression(context, unit_index, argument);
        argument = context::node(context, unit_index, argument).next_sibling;
    }
    return valid;
}

fn validate_const_expression(context: *context::Context, unit_index: usize, node_index: usize) -> bool {
    let none: usize = context::no_id();
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
    var valid: bool = false;
    if (node.kind == syntax::SyntaxKind.integer_expression || node.kind == syntax::SyntaxKind.character_expression ||
        node.kind == syntax::SyntaxKind.boolean_expression || node.kind == syntax::SyntaxKind.name_expression) {
        valid = true;
    } else if (node.kind == syntax::SyntaxKind.parenthesized_expression) {
        valid = node.child_count == 1 && validate_const_expression(context, unit_index, node.first_child);
    } else if (node.kind == syntax::SyntaxKind.member_expression) {
        valid = node.child_count == 2 &&
            context::node(context, unit_index, node.first_child).kind == syntax::SyntaxKind.name_expression &&
            context::node(
                context, unit_index, context::node(context, unit_index, node.first_child).next_sibling
            ).kind == syntax::SyntaxKind.name_expression;
    } else if (node.kind == syntax::SyntaxKind.unary_expression) {
        let operation: lexer::TokenKind = context::token(context, unit_index, node.token_index).kind;
        valid = node.child_count == 1 && (operation == lexer::TokenKind.minus || operation == lexer::TokenKind.tilde ||
                operation == lexer::TokenKind.bang) && validate_const_expression(context, unit_index, node.first_child);
    } else if (node.kind == syntax::SyntaxKind.binary_expression ||
        node.kind == syntax::SyntaxKind.conditional_expression) {
        var operands: bool = true;
        var operand: usize = node.first_child;
        while (operand != none && operands) {
            operands = validate_const_expression(context, unit_index, operand);
            operand = context::node(context, unit_index, operand).next_sibling;
        }
        valid = operands && node.child_count == (node.kind == syntax::SyntaxKind.binary_expression ? 2 : 3);
    } else if (node.kind == syntax::SyntaxKind.sizeof_expression ||
        node.kind == syntax::SyntaxKind.alignof_expression) {
        valid = node.child_count == 1;
    } else if (node.kind == syntax::SyntaxKind.offsetof_expression) {
        valid = node.child_count >= 1;
    } else if (node.kind == syntax::SyntaxKind.cast_expression) {
        if (node.child_count == 2 &&
            validate_const_expression(
                context, unit_index, node.first_child)) {
            let target: usize =
                types::resolve_type_node(
                    context, unit_index, context::node(context, unit_index, node.first_child).next_sibling);
            valid = target != none && const_scalar_type(context, target);
        }
    } else if (node.kind == syntax::SyntaxKind.call_expression) {
        valid = validate_const_call(context, unit_index, node);
    }
    if (!valid) {
        report_invalid_const_function(context, unit_index, node.span);
    }
    return valid;
}

fn validate_const_statement(context: *context::Context, unit_index: usize, node_index: usize) -> bool {
    let none: usize = context::no_id();
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
    var valid: bool = false;
    if (node.kind == syntax::SyntaxKind.block_statement) {
        valid = true;
        var child: usize = node.first_child;
        while (child != none && valid) {
            valid = validate_const_statement(context, unit_index, child);
            child = context::node(context, unit_index, child).next_sibling;
        }
        return valid;
    }
    if (node.kind == syntax::SyntaxKind.variable_declaration || node.kind == syntax::SyntaxKind.const_declaration) {
        if (node.child_count == 2 && (node.flags & ((syntax::SyntaxFlag.inferred_type as usize) |
                    (syntax::SyntaxFlag.volatile_ as usize))) == 0) {
            let type_id: usize = types::resolve_type_node(context, unit_index, node.first_child);
            valid = type_id != none && const_scalar_type(context, type_id) &&
                validate_const_expression(
                    context, unit_index, context::node(context, unit_index, node.first_child).next_sibling);
        }
    } else if (node.kind == syntax::SyntaxKind.assignment_statement) {
        valid = node.child_count == 2 &&
            context::token(context, unit_index, node.token_index).kind == lexer::TokenKind.equal &&
            context::node(context, unit_index, node.first_child).kind == syntax::SyntaxKind.name_expression &&
            validate_const_expression(
                context, unit_index, context::node(context, unit_index, node.first_child).next_sibling);
    } else if (node.kind == syntax::SyntaxKind.expression_statement) {
        valid = node.child_count == 1 && validate_const_expression(context, unit_index, node.first_child);
    } else if (node.kind == syntax::SyntaxKind.if_statement) {
        if (node.child_count >= 2 && node.child_count <= 3 &&
            validate_const_expression(
                context, unit_index, node.first_child)) {
            let then_id: usize = context::node(context, unit_index, node.first_child).next_sibling;
            valid = validate_const_statement(context, unit_index, then_id);
            if (valid && node.child_count == 3) {
                valid = validate_const_statement(
                    context, unit_index, context::node(context, unit_index, then_id).next_sibling);
            }
        }
    } else if (node.kind == syntax::SyntaxKind.return_statement) {
        valid = node.child_count == 1 && validate_const_expression(context, unit_index, node.first_child);
    }
    if (!valid) {
        report_invalid_const_function(context, unit_index, node.span);
    }
    return valid;
}

fn validate_const_function(context: *context::Context, const_function_id: usize) -> bool {
    let none: usize = context::no_id();
    let records: *const context::ConstFunction = context->const_functions.data as
            *const context::ConstFunction;
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    let symbol: context::Symbol = symbols[records[const_function_id].symbol_id];
    var body_id: usize = none;
    var child: usize = context::node(context, symbol.declaration_unit, symbol.declaration_node).first_child;
    while (child != none) {
        let part: syntax::SyntaxNode = context::node(context, symbol.declaration_unit, child);
        if (part.kind == syntax::SyntaxKind.block_statement) {
            body_id = child;
        }
        child = part.next_sibling;
    }
    if (body_id == none) {
        report_invalid_const_function(
            context, symbol.declaration_unit,
            context::node(context, symbol.declaration_unit, symbol.declaration_node).span);
        return false;
    }
    var valid: bool = true;
    var statement: usize = context::node(context, symbol.declaration_unit, body_id).first_child;
    while (statement != none && valid && context->error == runtime::Error.none) {
        valid = validate_const_statement(context, symbol.declaration_unit, statement);
        statement = context::node(context, symbol.declaration_unit, statement).next_sibling;
    }
    return valid;
}

fn collect_const_function(
    context: *context::Context, module_id: usize, unit_index: usize, declaration_id: usize,
    declaration: syntax::SyntaxNode, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if (interface_unit) {
        // Interface units carry no bodies, and a const fn without a body
        // is useless to the evaluator.
        report_invalid_const_function(context, unit_index, declaration.span);
        return context->error == runtime::Error.none;
    }
    if ((declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_export, unit_index, declaration.span, none, context::empty_span(),
            0);
    }
    let duplicate: usize = names::find_any_local_symbol(context, module_id, unit_index, declaration.token_index);
    if (duplicate != none) {
        let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
        context::add_diagnostic(
            context, context::DiagnosticKind.duplicate_name, unit_index,
            context::token(context, unit_index, declaration.token_index).span, symbols[duplicate].declaration_unit,
            context::token(context, symbols[duplicate].declaration_unit, symbols[duplicate].name_token).span,
            duplicate);
        return context->error == runtime::Error.none;
    }
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    if ((declaration.flags & (syntax::SyntaxFlag.variadic as usize)) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_variadic, unit_index, declaration.span, context::no_id(),
            context::empty_span(), 0);
        return context->error == runtime::Error.none;
    }
    if (body_node == none || return_node == none) {
        report_invalid_const_function(context, unit_index, declaration.span);
        return context->error == runtime::Error.none;
    }
    let return_type: usize = types::resolve_type_node(context, unit_index, return_node);
    if (return_type == none) {
        return context->error == runtime::Error.none;
    }
    if (!const_scalar_type(context, return_type)) {
        report_invalid_const_function(context, unit_index, context::node(context, unit_index, return_node).span);
    }
    let symbol_id: usize = names::append_symbol(
        context, {
            kind = context::SymbolKind.const_function, module_id = module_id, declaration_unit = unit_index,
            declaration_node = declaration_id, name_token = declaration.token_index, type_id = return_type,
            function_id = context->const_function_count, integer_value = 0, flags = context::SymbolFlag.none as usize,
        });
    if (symbol_id == none) {
        return false;
    }
    let const_id: usize =
        append_const_function(
            context, {
                symbol_id = symbol_id, return_type = return_type, first_parameter = none, parameter_count = 0,
            });
    if (const_id == none) {
        return false;
    }
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < parameter_count) {
        let parameter_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        let type_id: usize = types::resolve_type_node(context, unit_index, parameter_node.first_child);
        if (type_id == none) {
            return context->error == runtime::Error.none;
        }
        if (!const_scalar_type(
                context, type_id)) {
            report_invalid_const_function(context, unit_index, parameter_node.span);
        }
        let records: *const context::ConstFunction = context->const_functions.data as
                *const context::ConstFunction;
        let parameters: *const context::Parameter = context->parameters.data as
                *const context::Parameter;
        let base: usize = records[const_id].first_parameter;
        let collected: usize = records[const_id].parameter_count;
        var previous: usize = 0;
        while (previous < collected) {
            if (context::tokens_equal(
                    context, unit_index, parameter_node.token_index, parameters[base + previous].unit_index,
                    parameters[base + previous].name_token)) {
                report_invalid_const_function(context, unit_index, parameter_node.span);
            }
            previous += 1;
        }
        if (append_parameter(
                context, {
                    function_id = none, type_id = type_id, unit_index = unit_index, declaration_node = child,
                    name_token = parameter_node.token_index,
                }) == none) {
            return false;
        }
        let writable: *context::ConstFunction = context->const_functions.data as
                *context::ConstFunction;
        if (writable[const_id].parameter_count == 0) {
            writable[const_id].first_parameter = context->parameter_count - 1;
        }
        writable[const_id].parameter_count += 1;
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn collect_const_functions_in_unit(
    context: *context::Context, module_id: usize, unit_index: usize, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize = names::first_declaration(context, unit_index);
    while (declaration_id != none && context->error == runtime::Error.none) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        if (declaration.kind == syntax::SyntaxKind.function_declaration && (declaration.flags &
                (syntax::SyntaxFlag.const_function as usize)) != 0 &&
            !collect_const_function(
                context, module_id, unit_index, declaration_id, declaration, interface_unit)) {
            return false;
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == runtime::Error.none;
}

fn collect_const_functions(context: *context::Context) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count && context->error == runtime::Error.none) {
        let modules: *const context::Module = context->modules.data as *const context::Module;
        if (!collect_const_functions_in_unit(context, module_id, modules[module_id].interface_unit, true) ||
            !collect_const_functions_in_unit(
                context, module_id, modules[module_id].implementation_unit, false)) {
            return false;
        }
        module_id += 1;
    }
    var index: usize = 0;
    while (index < context->const_function_count && context->error == runtime::Error.none) {
        validate_const_function(context, index);
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn collect_functions_in_unit(
    context: *context::Context, module_id: usize, unit_index: usize, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize = names::first_declaration(context, unit_index);
    while (declaration_id != none && context->error == runtime::Error.none) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        if (declaration.kind == syntax::SyntaxKind.function_declaration && (declaration.flags &
                (syntax::SyntaxFlag.const_function as usize)) == 0) {
            validate_asm_function(context, unit_index, declaration, interface_unit);
            let duplicate_name: usize =
                names::find_any_local_symbol(context, module_id, unit_index, declaration.token_index);
            let existing_function: usize =
                find_module_function(context, module_id, unit_index, declaration.token_index);
            if (!interface_unit && existing_function != none) {
                if ((declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.invalid_export, unit_index, declaration.span, none,
                        context::empty_span(), existing_function);
                }
                var functions: *context::Function = context->functions.data as
                        *context::Function;
                let existing: context::Function = functions[existing_function];
                if (existing.implementation_unit != none || (existing.flags & (context::SymbolFlag
                            .external as usize)) != 0) {
                    let symbols: *const context::Symbol = context->symbols.data as
                            *const context::Symbol;
                    context::add_diagnostic(
                        context, context::DiagnosticKind.duplicate_function, unit_index, declaration.span,
                        symbols[existing.symbol_id].declaration_unit,
                        context::node(
                            context, symbols[existing.symbol_id].declaration_unit, symbols[existing.symbol_id]
                                .declaration_node).span, existing_function);
                } else if (!function_signature_matches(
                        context, existing_function, unit_index, declaration)) {
                    context::add_diagnostic(
                        context, context::DiagnosticKind.signature_mismatch, unit_index, declaration.span,
                        existing.interface_unit,
                        context::node(context, existing.interface_unit, existing.interface_node).span,
                        existing_function);
                } else {
                    functions = context->functions.data as
                            *context::Function;
                    functions[existing_function].implementation_unit = unit_index;
                    functions[existing_function].implementation_node = declaration_id;
                    // The interface declaration was collected without the
                    // asm flag; the implementation carries it.
                    if ((declaration.flags & (syntax::SyntaxFlag.asm_function as usize)) != 0) {
                        functions[existing_function].flags |= context::SymbolFlag.asm_function as usize;
                    }
                }
            } else if (duplicate_name != none) {
                let symbols: *const context::Symbol = context->symbols.data as
                        *const context::Symbol;
                context::add_diagnostic(
                    context, context::DiagnosticKind.duplicate_name, unit_index, declaration.span,
                    symbols[duplicate_name].declaration_unit,
                    context::node(
                        context, symbols[duplicate_name].declaration_unit, symbols[duplicate_name].declaration_node
                    ).span, duplicate_name);
            } else {
                add_function_declaration(context, module_id, unit_index, declaration_id, declaration, interface_unit);
            }
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == runtime::Error.none;
}

fn collect_functions(context: *context::Context) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count && context->error == runtime::Error.none) {
        let modules: *const context::Module = context->modules.data as
                *const context::Module;
        if (!collect_functions_in_unit(context, module_id, modules[module_id].interface_unit, true) ||
            !collect_functions_in_unit(
                context, module_id, modules[module_id].implementation_unit, false)) {
            return false;
        }
        module_id += 1;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let modules: *const context::Module = context->modules.data as
            *const context::Module;
    var function_id: usize = 0;
    while (function_id < context->function_count) {
        let function: context::Function = functions[function_id];
        let symbol: context::Symbol = symbols[function.symbol_id];
        if (function.interface_unit != context::no_id() && function.implementation_unit == context::no_id() &&
            modules[symbol.module_id].implementation_unit != context::no_id() &&
            (function.flags & (context::SymbolFlag.external as usize)) == 0) {
            context::add_diagnostic(
                context, context::DiagnosticKind.missing_definition, symbol.declaration_unit,
                context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                context::no_id(), context::empty_span(), function_id);
        }
        if (function.implementation_unit != context::no_id() && (function.flags &
                (context::SymbolFlag.external as usize)) == 0) {
            let implementation: syntax::SyntaxNode =
                context::node(context, function.implementation_unit, function.implementation_node);
            if ((implementation.flags & (syntax::SyntaxFlag.bodyless as usize)) != 0) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.missing_definition, function.implementation_unit,
                    implementation.span, context::no_id(), context::empty_span(), function_id);
            }
        }
        function_id += 1;
    }
    // Export names live outside the module/function mangling scheme, so the
    // usual per-module name uniqueness cannot catch collisions: two functions
    // emitting the same verbatim symbol are a duplicate_function.
    var outer: usize = 0;
    while (outer < context->function_count && context->error == runtime::Error.none) {
        let outer_function: context::Function = functions[outer];
        let outer_token: usize = function_export_name_token(context, outer_function);
        if (outer_token != context::no_id()) {
            let outer_span: lexer::SourceSpan = context::token(
                context, outer_function.implementation_unit, outer_token).span;
            let outer_content: lexer::SourceSpan = {
                offset = outer_span.offset + 1, length = outer_span.length - 2, line = outer_span.line,
                column = outer_span.column,
            };
            var inner: usize = outer + 1;
            while (inner < context->function_count && context->error == runtime::Error.none) {
                let inner_function: context::Function = functions[inner];
                let inner_token: usize = function_export_name_token(context, inner_function);
                if (inner_token != context::no_id()) {
                    let inner_span: lexer::SourceSpan =
                        context::token(context, inner_function.implementation_unit, inner_token).span;
                    let inner_content: lexer::SourceSpan = {
                        offset = inner_span.offset + 1, length = inner_span.length - 2, line = inner_span.line,
                        column = inner_span.column,
                    };
                    if (context::text_equal(
                            context, outer_function.implementation_unit, outer_content,
                            inner_function.implementation_unit, inner_content)) {
                        context::add_diagnostic(
                            context, context::DiagnosticKind.duplicate_function, inner_function.implementation_unit,
                            inner_span, outer_function.implementation_unit, outer_span, outer);
                    }
                }
                inner += 1;
            }
        }
        outer += 1;
    }
    return context->error == runtime::Error.none;
}

fn function_export_name_token(context: *context::Context, function: context::Function) -> usize {
    let none: usize = context::no_id();
    if (function.implementation_unit == none || (function.flags & (context::SymbolFlag.external as usize)) != 0) {
        return none;
    }
    let argument: usize = attributes::declaration_attribute_argument(
        context, function.implementation_unit,
        context::node(context, function.implementation_unit, function.implementation_node),
        attributes::Attribute.export_name);
    if (argument == none) {
        return none;
    }
    let argument_node: syntax::SyntaxNode = context::node(context, function.implementation_unit, argument);
    if (argument_node.kind != syntax::SyntaxKind.string_expression || argument_node.child_count != 0 ||
        !attributes::attribute_string_is_identifier(
            context, function.implementation_unit, argument_node.token_index)) {
        return none;
    }
    return argument_node.token_index;
}

// Token of a function's validated @export_name string literal in the
// function's implementation unit, no-id when the function carries no (valid)
// export name. Invalid arguments were already diagnosed by the attribute
// pass; they fall back to the mangled symbol here.
