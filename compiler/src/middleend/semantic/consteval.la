module luna.bootstrap.middleend.semantic.consteval;

import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.consteval.engine as engine;
import luna.bootstrap.middleend.semantic.context.builder as builder;
import luna.bootstrap.middleend.semantic.context.lookup as names;
import luna.bootstrap.middleend.semantic.types as types;
import luna.compiler.syntax as syntax;
import luna.runtime as runtime;

enum BitfieldLimit: usize {
    maximum_width = 64,
}

fn alignment_value_is_valid(value: u64) -> bool {
    let bounded: bool = value != 0 && value <= context::Limit.maximum_attribute_alignment as usize as u64;
    let power_of_two: bool = (value & (value - 1)) == 0;
    return bounded && power_of_two;
}

fn declaration_alignment(context: *context::Context, unit_index: usize, declaration_node: usize) -> model::Alignment {
    let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_node);
    let argument: usize =
        attributes::declaration_attribute_argument(context, unit_index, declaration, attributes::Attribute.align);
    if (argument == context::no_id()) {
        return {
            alignment = 0, valid = true,
        };
    }
    let argument_node: syntax::SyntaxNode = context::node(context, unit_index, argument);
    let value: model::Value = engine::expression(context, unit_index, argument);
    let constant_integer: bool = value.is_constant && !value.is_boolean;
    let value_is_valid: bool = !value.error && constant_integer;
    if (!value_is_valid || !alignment_value_is_valid(value.value)) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_alignment, unit_index, argument_node.span, context::no_id(),
            context::empty_span(), declaration_node);
        return {
            alignment = 0, valid = false,
        };
    }
    return {
        alignment = value.value as usize, valid = true,
    };
}

fn resolve_alignment_attributes(context: *context::Context) -> bool {
    let none: usize = context::no_id();
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    for (var symbol_id: usize = 0;
        symbol_id < context->symbol_count && context->error == runtime::Error.none; symbol_id += 1) {
        let symbol: context::Symbol = symbols[symbol_id];
        if (symbol.kind == context::SymbolKind.named_type) {
            let record: type_info::Record = context::type_record(context, symbol.type_id);
            if (record.kind == type_info::Kind.structure || record.kind == type_info::Kind.record_union) {
                let type_alignment: model::Alignment =
                    declaration_alignment(context, symbol.declaration_unit, symbol.declaration_node);
                if (type_alignment.valid && type_alignment.alignment != 0) {
                    builder::append_alignment_override(
                        context, symbol.declaration_unit, symbol.declaration_node, type_alignment.alignment);
                }
                let declaration: syntax::SyntaxNode =
                    context::node(context, symbol.declaration_unit, symbol.declaration_node);
                var child: usize = declaration.first_child;
                while (child != none && context->error == runtime::Error.none) {
                    let node: syntax::SyntaxNode = context::node(context, symbol.declaration_unit, child);
                    if (node.kind == syntax::SyntaxKind.field_declaration) {
                        let field_alignment: model::Alignment = declaration_alignment(context, symbol.declaration_unit,
                            child);
                        if (field_alignment.valid && field_alignment.alignment != 0) {
                            builder::append_alignment_override(
                                context, symbol.declaration_unit, child, field_alignment.alignment);
                        }
                    }
                    child = node.next_sibling;
                }
            }
        }
    }
    return context->error == runtime::Error.none;
}

fn resolve_bitfield_attribute(context: *context::Context, unit_index: usize, attribute_node: syntax::SyntaxNode) {
    let none: usize = context::no_id();
    if (attribute_node.parent == none) {
        return;
    }
    let parent: syntax::SyntaxNode = context::node(context, unit_index, attribute_node.parent);
    if (parent.kind != syntax::SyntaxKind.field_declaration) {
        // validate_attributes 已经报告挂载位置错误。
        return;
    }
    var bit_offset: usize = 0;
    var child: usize = attribute_node.first_child;
    while (child != none && context->error == runtime::Error.none) {
        let argument: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (argument.kind != syntax::SyntaxKind.named_argument || argument.child_count != 1) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_bitfield, unit_index, argument.span, none,
                context::empty_span(), child);
            break;
        }
        let segments: *const context::BitfieldSegment = context->bitfield_segments.data as
                *const context::BitfieldSegment;
        var duplicate: bool = false;
        for (var segment_id: usize = 0; segment_id < context->bitfield_segment_count; segment_id += 1) {
            let same_owner: bool = segments[segment_id].declaration_unit == unit_index &&
                segments[segment_id].declaration_node == attribute_node.parent;
            if (!same_owner) {
                continue;
            }
            if (context::tokens_equal(
                    context, unit_index, argument.token_index, unit_index, segments[segment_id].name_token)) {
                duplicate = true;
            }
        }
        let width: model::Value = engine::expression(context, unit_index, argument.first_child);
        let constant_integer: bool = width.is_constant && !width.is_boolean;
        let value_is_valid: bool = !width.error && constant_integer;
        let width_is_valid: bool = width.value != 0 && width.value <= BitfieldLimit.maximum_width as usize as u64;
        let invalid_value: bool = !value_is_valid || !width_is_valid;
        if (duplicate || invalid_value) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_bitfield, unit_index, argument.span, none,
                context::empty_span(), child);
            break;
        }
        if (!builder::append_bitfield_segment(
                context, {
                    declaration_unit = unit_index, declaration_node = attribute_node.parent,
                    name_token = argument.token_index, bit_offset = bit_offset, bit_width = width.value as usize,
                })) {
            return;
        }
        bit_offset += width.value as usize;
        child = argument.next_sibling;
    }
}

fn resolve_bitfield_attributes(context: *context::Context) -> bool {
    for (var unit_index: usize = 0;
        unit_index < context->input.size() && context->error == runtime::Error.none;
        unit_index += 1) {
        let unit: *const context::Unit = context::input_unit(context, unit_index);
        for (var node_index: usize = 0;
            node_index < unit->tree.size() && context->error == runtime::Error.none;
            node_index += 1) {
            let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
            let bitfield_attribute: bool = node.kind == syntax::SyntaxKind.attribute &&
                attributes::find_attribute(
                    context, unit_index, node.token_index) == (attributes::Attribute.bits as usize);
            if (bitfield_attribute) {
                resolve_bitfield_attribute(context, unit_index, node);
            }
        }
    }
    return context->error == runtime::Error.none;
}

// 布局解析后才能得到存储类型，因此整数种类和位宽总和在第二个 pass 中校验。
fn bitfield_segment_has_owner(segment: context::BitfieldSegment, owner: context::BitfieldSegment) -> bool {
    return segment.declaration_unit == owner.declaration_unit && segment.declaration_node == owner.declaration_node;
}

fn validate_bitfields(context: *context::Context) -> bool {
    let none: usize = context::no_id();
    let segments: *const context::BitfieldSegment = context->bitfield_segments.data as
            *const context::BitfieldSegment;
    let fields: *const type_info::Field = context->types.field_data() as *const type_info::Field;
    var index: usize = 0;
    while (index < context->bitfield_segment_count && context->error == runtime::Error.none) {
        let first: context::BitfieldSegment = segments[index];
        var total: usize = 0;
        var group_end: usize = index;
        while (group_end < context->bitfield_segment_count && bitfield_segment_has_owner(segments[group_end], first)) {
            total += segments[group_end].bit_width;
            group_end += 1;
        }
        let field_id: usize = builder::bitfield_storage_field(context, first);
        if (field_id != none) {
            let field_record: type_info::Record = context::type_record(context, fields[field_id].type_id);
            if (!type_info::is_integer(field_record.kind) || total != type_info::bit_width(field_record.kind)) {
                context::add_diagnostic(
                    context, context::DiagnosticKind.invalid_bitfield, first.declaration_unit,
                    context::node(context, first.declaration_unit, first.declaration_node).span,
                    none, context::empty_span(), field_id);
            }
        }
        index = group_end;
    }
    return context->error == runtime::Error.none;
}

fn check_assert(context: *context::Context, unit_index: usize, node_index: usize) -> bool {
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
    if (node.child_count != 1) {
        return true;
    }
    let result: model::Value = engine::expression(context, unit_index, node.first_child);
    if (result.error || !result.is_constant) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_assert, unit_index, node.span, context::no_id(),
            context::empty_span(), 0);
        return false;
    }
    if (result.value == 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.assertion_failed, unit_index, node.span, context::no_id(),
            context::empty_span(), 0);
        return false;
    }
    return true;
}

fn check_module_asserts(context: *context::Context) -> bool {
    for (var unit_index: usize = 0;
        unit_index < context->input.size() && context->error == runtime::Error.none;
        unit_index += 1) {
        var declaration_id: usize = names::first_declaration(context, unit_index);
        while (declaration_id != context::no_id() && context->error == runtime::Error.none) {
            let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
            if (declaration.kind == syntax::SyntaxKind.assert_statement) {
                check_assert(context, unit_index, declaration_id);
            }
            declaration_id = declaration.next_sibling;
        }
    }
    return context->error == runtime::Error.none;
}

fn collect_constant_declaration(
    context: *context::Context, module_id: usize, unit_index: usize, declaration_id: usize,
    declaration: syntax::SyntaxNode, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    let exported: bool = (declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0;
    if (!interface_unit && exported) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_export, unit_index, declaration.span, none, context::empty_span(),
            0);
    }
    let duplicate: usize = names::find_any_local_symbol(context, module_id, unit_index, declaration.token_index);
    if (duplicate != none) {
        let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
        context::add_diagnostic(
            context, context::DiagnosticKind.duplicate_name, unit_index,
            context::token(context, unit_index, declaration.token_index).span, symbols[duplicate].declaration_unit,
            context::token(context, symbols[duplicate].declaration_unit, symbols[duplicate].name_token).span,
            duplicate);
        return context->error == runtime::Error.none;
    }
    if (declaration.child_count < 2) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let type_id: usize = types::resolve_type_node(context, unit_index, declaration.first_child);
    if (type_id == none) {
        return context->error == runtime::Error.none;
    }
    let record: type_info::Record = context::type_record(context, type_id);
    if (!type_info::is_integer(record.kind) && record.kind != type_info::Kind.boolean) {
        context::add_diagnostic(
            context, context::DiagnosticKind.type_mismatch, unit_index,
            context::node(context, unit_index, declaration.first_child).span, none, context::empty_span(), type_id);
        return context->error == runtime::Error.none;
    }
    var flags: usize = context::SymbolFlag.none as usize;
    if (exported) {
        flags |= context::SymbolFlag.exported as usize;
    }
    if (interface_unit) {
        flags |= context::SymbolFlag.interface_declaration as usize;
    }
    return names::append_symbol(
        context, {
            kind = context::SymbolKind.constant, module_id = module_id, declaration_unit = unit_index,
            declaration_node = declaration_id, name_token = declaration.token_index, type_id = type_id,
            function_id = none, integer_value = 0, flags = flags,
        }) != none;
}

fn collect_constants_in_unit(
    context: *context::Context, module_id: usize, unit_index: usize, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize = names::first_declaration(context, unit_index);
    while (declaration_id != none && context->error == runtime::Error.none) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        if (declaration.kind == syntax::SyntaxKind.const_declaration &&
            !collect_constant_declaration(
                context, module_id, unit_index, declaration_id, declaration, interface_unit)) {
            return false;
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == runtime::Error.none;
}

// 按需求解已收集常量：计算初始化式、校验类型并标记完成。
// resolving 标志切断初始化环；未被不动点求解的常量最终统一报告。
fn collect_constant_declarations(context: *context::Context) -> bool {
    for (var module_id: usize = 0;
        module_id < context->module_count && context->error == runtime::Error.none; module_id += 1) {
        let modules: *const context::Module = context->modules.data as *const context::Module;
        if (!collect_constants_in_unit(context, module_id, modules[module_id].interface_unit, true)) {
            return false;
        }
        for (var implementation_index: usize = 0;
            implementation_index < modules[module_id].implementation_count; implementation_index += 1) {
            let implementation_unit: usize =
                names::module_implementation_unit(context, module_id, implementation_index);
            if (implementation_unit == context::no_id() ||
                !collect_constants_in_unit(
                    context, module_id, implementation_unit, false)) {
                return false;
            }
        }
    }
    return context->error == runtime::Error.none;
}

// consteval 已依赖 types，类型解析不能反向导入它，因此数组长度在这里提前折叠并缓存。
// 扫描覆盖每个单元的全部节点，包括函数体。
fn prescan_array_lengths(context: *context::Context) -> bool {
    for (var unit_index: usize = 0;
        unit_index < context->input.size() && context->error == runtime::Error.none;
        unit_index += 1) {
        let unit: *const context::Unit = context::input_unit(context, unit_index);
        for (var node_index: usize = 0;
            node_index < unit->tree.size() && context->error == runtime::Error.none;
            node_index += 1) {
            let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
            let array_node: bool = node.kind == syntax::SyntaxKind.type_array;
            let sized_array: bool = (node.flags & (syntax::SyntaxFlag.flexible as usize)) == 0 && node.child_count == 2;
            if (array_node && sized_array) {
                let value: model::Value = engine::expression(context, unit_index, node.first_child);
                var entry: context::ArrayLength = {
                    unit_index = unit_index, node_index = node_index, value = 0, valid = false,
                };
                let integer_constant: bool = value.is_constant && !value.is_boolean;
                if (integer_constant && !value.error) {
                    entry.value = value.value;
                    entry.valid = true;
                }
                if (!names::append_record(
                        context, &context->array_lengths, (&entry) as
                            *const context::ArrayLength as
                                *const u8, sizeof(context::ArrayLength))) {
                    return false;
                }
                context->array_length_count += 1;
            }
        }
    }
    return context->error == runtime::Error.none;
}

// 按声明顺序折叠布局阶段留下的枚举值，使隐式成员能承接前一个显式值。
// 类型符号上的 resolving 标志切断枚举值环；即使枚举未被其他类型引用，也会在这里完成或报告错误。
fn finalize_enum_constants(context: *context::Context) -> bool {
    for (var symbol_id: usize = 0;
        symbol_id < context->symbol_count && context->error == runtime::Error.none; symbol_id += 1) {
        let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
        let symbol: context::Symbol = symbols[symbol_id];
        if (symbol.kind != context::SymbolKind.named_type) {
            continue;
        }
        let enumeration: bool = context::type_record(context, symbol.type_id).kind == type_info::Kind.enumeration;
        if (!enumeration) {
            continue;
        }
        let complete: bool = types::require_complete_type(context, symbol.type_id);
        if (complete && !engine::resolve_enum_constant_values(context, symbol.type_id)) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_enum_value, symbol.declaration_unit,
                context::node(context, symbol.declaration_unit, symbol.declaration_node).span,
                context::no_id(), context::empty_span(), symbol.type_id);
        }
    }
    return context->error == runtime::Error.none;
}
