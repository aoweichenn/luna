module luna.bootstrap.middleend.semantic.functions;

fn declaration_has_syntax_flag(declaration: syntax::SyntaxNode, flag: syntax::SyntaxFlag) -> bool {
    return (declaration.flags & (flag as usize)) != 0;
}

fn function_has_symbol_flag(function: context::Function, flag: context::SymbolFlag) -> bool {
    return (function.flags & (flag as usize)) != 0;
}

fn function_parameter_types_match(
    context: *context::Context, function: context::Function, unit_index: usize,
    declaration: syntax::SyntaxNode, parameter_count: usize) -> bool {
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    var child: usize = declaration.first_child;
    for (var index: usize = 0; index < parameter_count; index += 1) {
        let parameter_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        let actual_type: usize = types::resolve_type_node(context, unit_index, parameter_node.first_child);
        if (actual_type != parameters[function.first_parameter + index].type_id) {
            return false;
        }
        child = parameter_node.next_sibling;
    }
    return true;
}

fn function_overload_key_matches(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[function_id];
    if (parameter_count != function.parameter_count) {
        return false;
    }
    let variadic_matches: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.variadic) ==
        function_has_symbol_flag(function, context::SymbolFlag.variadic);
    let convention_matches: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.external) ==
        function_has_symbol_flag(function, context::SymbolFlag.external);
    if (!variadic_matches || !convention_matches) {
        return false;
    }
    return function_parameter_types_match(context, function, unit_index, declaration, parameter_count);
}

fn function_contract_matches(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions[function_id];
    let actual_return: usize = return_node == none ? type_info::BuiltinType.type_void as usize :
        types::resolve_type_node(context, unit_index, return_node);
    let return_matches: bool = actual_return == function.return_type;
    let declaration_no_return: bool = attributes::declaration_has_attribute(
        context, unit_index, declaration, attributes::Attribute.no_return);
    let no_return_matches: bool = declaration_no_return ==
        function_has_symbol_flag(function, context::SymbolFlag.no_return);
    return return_matches && no_return_matches;
}

struct FunctionDeclarationLookup {
    named_function: usize;
    overload: usize;
}

fn lookup_function_declaration(
    context: *context::Context, module_id: usize, unit_index: usize,
    declaration: syntax::SyntaxNode) -> FunctionDeclarationLookup {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    var result: FunctionDeclarationLookup = {
        named_function = context::no_id(), overload = context::no_id(),
    };
    for (var function_id: usize = 0; function_id < context->function_count; function_id += 1) {
        let symbol: context::Symbol = symbols[functions[function_id].symbol_id];
        let owner_matches: bool = symbol.module_id == module_id;
        let name_matches: bool = context::tokens_equal(
            context, unit_index, declaration.token_index, symbol.declaration_unit, symbol.name_token);
        let identity_matches: bool = owner_matches && name_matches;
        if (identity_matches) {
            if (result.named_function == context::no_id()) {
                result.named_function = function_id;
            }
            if (function_overload_key_matches(context, function_id, unit_index, declaration)) {
                result.overload = function_id;
                return result;
            }
        }
    }
    return result;
}

enum FunctionDeclarationAction: usize {
    add_candidate, attach_definition, duplicate_overload, contract_mismatch, non_callable_conflict,
}

struct FunctionDeclarationMatch {
    action: FunctionDeclarationAction;
    related_id: usize;
}

fn symbol_is_non_callable(context: *context::Context, symbol_id: usize) -> bool {
    if (symbol_id == context::no_id()) {
        return false;
    }
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    return symbols[symbol_id].kind != context::SymbolKind.function;
}

fn named_function_is_external(context: *context::Context, function_id: usize) -> bool {
    if (function_id == context::no_id()) {
        return false;
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    return function_has_symbol_flag(functions[function_id], context::SymbolFlag.external);
}

fn classify_function_declaration(
    context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode,
    interface_unit: bool, duplicate_symbol: usize, named_function: usize, overload: usize) -> FunctionDeclarationMatch {
    if (symbol_is_non_callable(context, duplicate_symbol)) {
        return {action = FunctionDeclarationAction.non_callable_conflict, related_id = duplicate_symbol};
    }
    let declaration_is_external: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.external);
    let external_name_conflicts: bool = named_function_is_external(context, named_function);
    let has_external_conflict: bool = declaration_is_external || external_name_conflicts;
    if (named_function != context::no_id() && has_external_conflict) {
        return {action = FunctionDeclarationAction.duplicate_overload, related_id = named_function};
    }
    if (overload == context::no_id()) {
        return {action = FunctionDeclarationAction.add_candidate, related_id = context::no_id()};
    }
    if (interface_unit) {
        return {action = FunctionDeclarationAction.duplicate_overload, related_id = overload};
    }
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let existing: context::Function = functions[overload];
    let definition_exists: bool = existing.implementation_unit != context::no_id();
    let cannot_define: bool = function_has_symbol_flag(existing, context::SymbolFlag.external);
    if (definition_exists || cannot_define) {
        return {action = FunctionDeclarationAction.duplicate_overload, related_id = overload};
    }
    if (!function_contract_matches(context, overload, unit_index, declaration)) {
        return {action = FunctionDeclarationAction.contract_mismatch, related_id = overload};
    }
    return {action = FunctionDeclarationAction.attach_definition, related_id = overload};
}

fn report_function_declaration_conflict(
    context: *context::Context, kind: context::DiagnosticKind, unit_index: usize,
    declaration: syntax::SyntaxNode, related_id: usize) {
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let related_symbol_id: usize = kind == context::DiagnosticKind.duplicate_name ? related_id :
        functions[related_id].symbol_id;
    let related: context::Symbol = symbols[related_symbol_id];
    context::add_diagnostic(
        context, kind, unit_index, declaration.span, related.declaration_unit,
        context::node(context, related.declaration_unit, related.declaration_node).span, related_id);
}

fn attach_function_definition(
    context: *context::Context, function_id: usize, unit_index: usize,
    declaration_id: usize, declaration: syntax::SyntaxNode) {
    let functions: *context::Function = context->functions.data as
            *context::Function;
    functions[function_id].implementation_unit = unit_index;
    functions[function_id].implementation_node = declaration_id;
    if (declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.asm_function)) {
        functions[function_id].flags |= context::SymbolFlag.asm_function as usize;
    }
    if (attributes::declaration_has_attribute(
            context, unit_index, declaration, attributes::Attribute.inline_hint)) {
        functions[function_id].flags |= context::SymbolFlag.inline_hint as usize;
    }
}
