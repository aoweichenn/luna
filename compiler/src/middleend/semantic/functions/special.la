module luna.bootstrap.middleend.semantic.functions;

fn special_parameter_rank(
    context: *context::Context, owner_type: usize,
    parameter_type: usize, source_type: usize, source_category: category::Category) -> usize {
    if (source_type != owner_type) {
        return type_info::no_id();
    }
    let parameter: type_info::Record = context::type_record(context, parameter_type);
    if (parameter.kind != type_info::Kind.reference || parameter.element_type != owner_type) {
        return type_info::no_id();
    }
    let read_only: bool = (parameter.flags & (type_info::Flag.read_only as usize)) != 0;
    let rvalue: bool = (parameter.flags & (type_info::Flag.rvalue_reference as usize)) != 0;
    let copy_constructor: bool = read_only && !rvalue;
    let move_constructor: bool = !read_only && rvalue;
    if (!copy_constructor && !move_constructor) {
        return type_info::no_id();
    }
    return category::reference_binding_rank(parameter, source_category);
}

fn type_is_trivially_copyable(context: *context::Context, type_id: usize) -> bool {
    return context::type_is_trivially_copyable(context, type_id);
}

fn type_is_trivially_relocatable(context: *context::Context, type_id: usize) -> bool {
    return context::type_is_trivially_relocatable(context, type_id);
}

fn type_requires_explicit_initialization_at(context: *context::Context, type_id: usize, depth: usize) -> bool {
    if (type_id >= context->types.type_count || depth >= context::Limit.maximum_type_depth as usize) {
        return true;
    }
    let record: type_info::Record = context::type_record(context, type_id);
    if (record.kind == type_info::Kind.class_type) {
        return true;
    }
    if (record.kind == type_info::Kind.array) {
        return type_requires_explicit_initialization_at(context, record.element_type, depth + 1);
    }
    if (!type_info::is_record(record.kind)) {
        return false;
    }
    let fields: *const type_info::Field = context->types.fields.data as *const type_info::Field;
    for (var index: usize = 0; index < record.field_count; index += 1) {
        if (type_requires_explicit_initialization_at(
                context, fields[record.first_field + index].type_id, depth + 1)) {
            return true;
        }
    }
    return false;
}

fn type_requires_explicit_initialization(context: *context::Context, type_id: usize) -> bool {
    return type_requires_explicit_initialization_at(context, type_id, 0);
}

fn resolve_special_constructor(
    context: *context::Context, owner_type: usize,
    source_type: usize, source_category: category::Category) -> SpecialMemberResolution {
    let none: usize = context::no_id();
    let binding_id: usize = lookup_constructor_binding(context, owner_type);
    var selected: usize = none;
    var selected_rank: usize = type_info::no_id();
    var selected_count: usize = 0;
    if (binding_id != none) {
        let bindings: *const context::Binding = context->bindings.data as *const context::Binding;
        let functions: *const context::Function = context->functions.data as *const context::Function;
        let parameters: *const context::Parameter = context->parameters.data as *const context::Parameter;
        for (var index: usize = 0; index < bindings[binding_id].candidate_count; index += 1) {
            let function_id: usize = binding_candidate(context, binding_id, index);
            let function: context::Function = functions[function_id];
            if (!classes::method_is_accessible(context, function_id)) {
                continue;
            }
            if (function.identity.kind != callable::Kind.constructor || function.parameter_count != 1) {
                continue;
            }
            let parameter_type: usize = parameters[function.first_parameter].type_id;
            let rank: usize = special_parameter_rank(context, owner_type, parameter_type, source_type, source_category);
            if (rank == type_info::no_id()) {
                continue;
            }
            if (rank < selected_rank) {
                selected = function_id;
                selected_rank = rank;
                selected_count = 1;
            } else if (rank == selected_rank) {
                selected_count += 1;
            }
        }
    }
    if (selected_count > 1) {
        return {status = SpecialMemberStatus.ambiguous, function_id = none};
    }
    if (selected_count == 1) {
        return {status = SpecialMemberStatus.selected, function_id = selected};
    }
    return type_is_trivially_copyable(context, owner_type) ?
        {status = SpecialMemberStatus.trivial, function_id = none} :
        {status = SpecialMemberStatus.unavailable, function_id = none};
}
