module luna.bootstrap.middleend.semantic.functions.ir;

import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.callable as callable;
import luna.bootstrap.middleend.semantic.functions as functions;
import luna.compiler.syntax as syntax;
import luna.runtime as runtime;
import luna.std.checked as checked;

fn ir_function_record(context: *context::Context, function_id: usize) -> ir::Function {
    let none: usize = context::no_id();
    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let symbols: *const context::Symbol = context->symbols.data as
            *const context::Symbol;
    let function: context::Function = functions[function_id];
    let symbol: context::Symbol = symbols[function.symbol_id];
    let external: bool = (function.flags & (context::SymbolFlag.external as usize)) != 0;
    let exported_flags: usize = (context::SymbolFlag.exported as usize) |
        (context::SymbolFlag.member_exported as usize);
    let exported: bool = (function.flags & exported_flags) != 0;
    var has_body: bool = false;
    var asm_body_node: usize = none;
    if (function.implementation_unit != none && !external) {
        let implementation: syntax::SyntaxNode =
            context::node(context, function.implementation_unit, function.implementation_node);
        has_body = (implementation.flags & (syntax::SyntaxFlag.bodyless as usize)) == 0;
        // An asm fn's body stays a syntax reference (unit + string node);
        // the backend decodes and splices the string literals verbatim.
        if (has_body && (function.flags & (context::SymbolFlag.asm_function as usize)) != 0) {
            var ignored_count: usize = 0;
            var ignored_return: usize = none;
            functions::function_parts(
                context, function.implementation_unit, implementation, &ignored_count, &ignored_return, &asm_body_node);
        }
    }
    let export_name_token: usize = functions::function_export_name_token(context, function);
    return {
        declaration_unit = symbol.declaration_unit, declaration_node = symbol.declaration_node,
        name_token = symbol.name_token, linkage = external ? ir::Linkage.external_c : (exported ?
                ir::Linkage.module_export : ir::Linkage.internal), return_type = function.return_type,
        first_parameter = none, parameter_count = 0, first_slot = none, slot_count = 0, first_block = none,
        block_count = 0, first_value = none, value_count = 0, signature_offset = none, signature_length = 0,
        has_body = has_body, variadic = (function.flags & (context::SymbolFlag.variadic as usize)) != 0,
        export_name_unit = export_name_token == none ? none : function.implementation_unit,
        export_name_token = export_name_token,
        asm_body_unit = asm_body_node == none ? none : function.implementation_unit, asm_body_node = asm_body_node,
    };
}

fn semantic_signature_is_valid(context: *context::Context, function: context::Function) -> bool {
    let length_is_valid: bool = function.signature_length != 0;
    let range_is_valid: bool = checked::range_is_valid(
        function.signature_offset, function.signature_length, context->callable_signatures.length);
    return length_is_valid && range_is_valid;
}

fn create_ir_function(context: *context::Context, function_id: usize) -> bool {
    let none: usize = context::no_id();
    let semantic_functions: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = semantic_functions[function_id];
    if (!semantic_signature_is_valid(context, function)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let ir_function: usize = ir::add_function(
        &context->ir, ir_function_record(context, function_id),
        (&context->callable_signatures.data[function.signature_offset]) as *const u8, function.signature_length);
    if (ir_function == none) {
        context->error = context->ir.error;
        return false;
    }
    let writable_functions: *context::Function = context->functions.data as
            *context::Function;
    writable_functions[function_id].ir_function = ir_function;
    return true;
}

fn create_ir_parameter(context: *context::Context, function: context::Function, parameter: context::Parameter) {
    if (ir::add_parameter(
            &context->ir, function.ir_function, parameter.type_id, parameter.name_token) == context::no_id()) {
        context->error = context->ir.error;
    }
}

fn create_ir_receiver(context: *context::Context, function: context::Function) {
    if (!callable::has_receiver(function.identity)) {
        return;
    }
    let receiver_type: usize = functions::function_receiver_type(context, function);
    if (receiver_type == context::no_id()) {
        return;
    }
    if (ir::add_parameter(
            &context->ir, function.ir_function, receiver_type, context::no_id()) == context::no_id()) {
        context->error = context->ir.error;
    }
}

fn create_ir_function_instance(context: *context::Context, function_id: usize) -> bool {
    if (function_id >= context->function_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let existing_functions: *const context::Function = context->functions.data as
            *const context::Function;
    if (existing_functions[function_id].ir_function != context::no_id()) {
        return true;
    }
    if (!create_ir_function(context, function_id)) {
        return false;
    }
    let functions_data: *const context::Function = context->functions.data as
            *const context::Function;
    let function: context::Function = functions_data[function_id];
    create_ir_receiver(context, function);
    let parameters: *const context::Parameter = context->parameters.data as *const context::Parameter;
    for (var index: usize = 0; index < function.parameter_count && context->error == runtime::Error.none; index += 1) {
        create_ir_parameter(context, function, parameters[function.first_parameter + index]);
    }
    return context->error == runtime::Error.none;
}

fn create_ir_functions(context: *context::Context) -> bool {
    for (var order_index: usize = 0;
        order_index < context->callable_candidate_count && context->error == runtime::Error.none;
        order_index += 1) {
        create_ir_function(context, functions::ordered_function_id(context, order_index));
    }

    let functions: *const context::Function = context->functions.data as
            *const context::Function;
    let parameters: *const context::Parameter = context->parameters.data as
            *const context::Parameter;
    for (var order_index: usize = 0;
        order_index < context->callable_candidate_count && context->error == runtime::Error.none;
        order_index += 1) {
        let function_id: usize = functions::ordered_function_id(context, order_index);
        let function: context::Function = functions[function_id];
        create_ir_receiver(context, function);
        for (var index: usize = 0;
            index < function.parameter_count && context->error == runtime::Error.none;
            index += 1) {
            let parameter: context::Parameter = parameters[function.first_parameter + index];
            create_ir_parameter(context, function, parameter);
        }
    }
    return context->error == runtime::Error.none;
}
