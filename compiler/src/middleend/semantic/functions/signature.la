module luna.bootstrap.middleend.semantic.functions;

enum SignatureFormat: usize {
    version = 1, generic_version = 2, u32_byte_count = 4, u64_byte_count = 8,
    bits_per_byte = 8, byte_mask = 0xff, maximum_u32 = 0xffffffff,
}

enum SignatureCallableKind: usize {
    free_function = 0, static_method = 1, instance_method = 2, constructor = 3, operator_method = 4, destructor = 5,
}

enum SignatureCallingConvention: usize {
    system_v = 0,
}

enum SignatureOwnerKind: usize {
    none = 0, named_type = 1,
}

enum SignatureReceiverKind: usize {
    none = 0, writable = 1, read_only = 2, writable_volatile = 3, read_only_volatile = 4,
}

enum SignatureFunctionFlag: usize {
    variadic = 1, no_return = 2, external = 4,
}

enum SignatureTypeQualifier: usize {
    read_only = 1, volatile_pointee = 2, rvalue_reference = 4,
}

enum SignatureTypeTag: usize {
    invalid = 0, type_void = 1, boolean = 2, signed_8 = 3, signed_16 = 4, signed_32 = 5, signed_64 = 6,
    signed_size = 7, unsigned_8 = 8, unsigned_16 = 9, unsigned_32 = 10, unsigned_64 = 11, unsigned_size = 12,
    float_32 = 13, float_64 = 14, pointer = 15, array = 16, structure = 17, record_union = 18, enumeration = 19,
    function_pointer = 20, va_list_type = 21, class_type = 22, bound_method = 23,
    generic_structure = 24, generic_union = 25, generic_class = 26, reference = 27,
}

enum SignatureTypeTagMap: usize {
    kind_count = 26,
}

class SignatureWriter {
    priv output: buffer::byte_buffer;
    priv error_code: runtime::Error;

    pub init();
    pub init(other: SignatureWriter&&);
    pub fn active() const -> bool;
    pub fn error() const -> runtime::Error;
    pub fn fail(error: runtime::Error);
    pub fn reset();
    pub fn data() const -> *const u8;
    pub fn size() const -> usize;
    pub fn write_byte(value: u8);
    pub fn write_u32(value: u32);
    pub fn write_u64(value: u64);
    pub fn write_bytes(data: *const u8, length: usize);
    pub deinit();
}

impl SignatureWriter {
    init(): output = buffer::byte_buffer() {
        this->error_code = runtime::Error.none;
    }

    init(other: SignatureWriter&&): output = other.output as buffer::byte_buffer&& {
        this->error_code = other.error_code;
        other.error_code = runtime::Error.none;
    }

    fn active() const -> bool {
        return this->error_code == runtime::Error.none && this->output.is_valid();
    }

    fn error() const -> runtime::Error {
        return this->error_code;
    }

    fn fail(error: runtime::Error) {
        if (this->error_code == runtime::Error.none) {
            this->error_code = error;
        }
    }

    fn reset() {
        this->output.clear();
        this->error_code = runtime::Error.none;
    }

    fn data() const -> *const u8 {
        return this->output.data();
    }

    fn size() const -> usize {
        return this->output.size();
    }

    fn write_byte(value: u8) {
        if (!this->active()) {
            return;
        }
        let error: runtime::Error = this->output.push_back(value);
        if (error != runtime::Error.none) {
            this->fail(error);
        }
    }

    priv fn write_unsigned(value: u64, byte_count: usize) {
        for (var index: usize = 0; index < byte_count && this->active(); index += 1) {
            let shift: u64 = (index * SignatureFormat.bits_per_byte as usize) as u64;
            this->write_byte(((value >> shift) & SignatureFormat.byte_mask as usize as u64) as u8);
        }
    }

    fn write_u32(value: u32) {
        this->write_unsigned(value as u64, SignatureFormat.u32_byte_count as usize);
    }

    fn write_u64(value: u64) {
        this->write_unsigned(value, SignatureFormat.u64_byte_count as usize);
    }

    fn write_bytes(data: *const u8, length: usize) {
        if (!this->active()) {
            return;
        }
        if (data == null || length == 0) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        let error: runtime::Error = this->output.append(data, length);
        if (error != runtime::Error.none) {
            this->fail(error);
        }
    }

    deinit() {
    }
}

fn signature_callable_kind(writer: *SignatureWriter, kind: domain::CallableKind) {
    switch (kind) {
    case domain::CallableKind.free_function {
        writer->write_byte(SignatureCallableKind.free_function as usize as u8);
    }
    case domain::CallableKind.static_method {
        writer->write_byte(SignatureCallableKind.static_method as usize as u8);
    }
    case domain::CallableKind.instance_method {
        writer->write_byte(SignatureCallableKind.instance_method as usize as u8);
    }
    case domain::CallableKind.constructor {
        writer->write_byte(SignatureCallableKind.constructor as usize as u8);
    }
    case domain::CallableKind.destructor {
        writer->write_byte(SignatureCallableKind.destructor as usize as u8);
    }
    case domain::CallableKind.operator_method {
        writer->write_byte(SignatureCallableKind.operator_method as usize as u8);
    }
    default {
        writer->fail(runtime::Error.invalid_argument);
    }
    }
}

fn signature_receiver_kind(writer: *SignatureWriter, receiver: domain::ReceiverKind) {
    switch (receiver) {
    case domain::ReceiverKind.none {
        writer->write_byte(SignatureReceiverKind.none as usize as u8);
    }
    case domain::ReceiverKind.writable {
        writer->write_byte(SignatureReceiverKind.writable as usize as u8);
    }
    case domain::ReceiverKind.read_only {
        writer->write_byte(SignatureReceiverKind.read_only as usize as u8);
    }
    case domain::ReceiverKind.writable_volatile {
        writer->write_byte(SignatureReceiverKind.writable_volatile as usize as u8);
    }
    case domain::ReceiverKind.read_only_volatile {
        writer->write_byte(SignatureReceiverKind.read_only_volatile as usize as u8);
    }
    default {
        writer->fail(runtime::Error.invalid_argument);
    }
    }
}

fn signature_callable_identity(writer: *SignatureWriter, identity: domain::CallableIdentity) {
    signature_callable_kind(writer, identity.kind);
    let owner_kind: u8 = domain::has_owner(identity) ? SignatureOwnerKind.named_type as usize as u8 :
        SignatureOwnerKind.none as usize as u8;
    writer->write_byte(owner_kind);
    signature_receiver_kind(writer, identity.receiver);
}

fn signature_token_is_valid(unit: *const context::Unit, token: lexer::Token) -> bool {
    if (unit == null) {
        return false;
    }
    let length_is_valid: bool = token.span.length != 0 && token.span.length <= SignatureFormat.maximum_u32 as usize;
    let range_is_valid: bool = checked::range_is_valid(token.span.offset, token.span.length, unit->source.length);
    return length_is_valid && range_is_valid;
}

fn signature_source_bytes(context: *context::Context, writer: *SignatureWriter, unit_index: usize, token_index: usize) {
    let unit: *const context::Unit = context::input_unit(context, unit_index);
    let token: lexer::Token = context::token(context, unit_index, token_index);
    if (!signature_token_is_valid(unit, token)) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    writer->write_u32(token.span.length as u32);
    writer->write_bytes(&unit->source.data[token.span.offset], token.span.length);
}

fn signature_module_is_valid(context: *context::Context, module_id: usize) -> bool {
    return module_id != context::no_id() && module_id < context->symbols.module_count();
}

fn signature_declaration_name(
    context: *context::Context, writer: *SignatureWriter, module_id: usize, unit_index: usize, name_token: usize) {
    if (!signature_module_is_valid(context, module_id)) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    let modules: *const context::Module = context->symbols.module_data() as
            *const context::Module;
    let module_record: context::Module = modules[module_id];
    let module_name: syntax::SyntaxNode = context::node(context, module_record.name_unit, module_record.name_node);
    let component_count_is_valid: bool = module_name.child_count != 0 &&
        module_name.child_count <= SignatureFormat.maximum_u32 as usize;
    if (!component_count_is_valid) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    writer->write_u32(module_name.child_count as u32);
    var child: usize = module_name.first_child;
    for (var index: usize = 0; index < module_name.child_count && writer->active(); index += 1) {
        let segment: syntax::SyntaxNode = context::node(context, module_record.name_unit, child);
        signature_source_bytes(context, writer, module_record.name_unit, segment.token_index);
        child = segment.next_sibling;
    }
    signature_source_bytes(context, writer, unit_index, name_token);
}

fn signature_named_type(context: *context::Context, writer: *SignatureWriter, record: type_info::Record) {
    signature_declaration_name(
        context, writer, context->symbols.unit_module(context, record.declaration_unit),
        record.declaration_unit, record.name_token);
}

fn signature_type_reference_is_valid(context: *context::Context, type_id: usize, depth: usize) -> bool {
    return type_id < context->types.size() && depth < context::Limit.maximum_type_depth as usize;
}

fn signature_encoded_flag(source_flags: usize, source_flag: usize, encoded_flag: u8) -> u8 {
    return (source_flags & source_flag) != 0 ? encoded_flag : 0;
}

fn signature_pointer_qualifiers(record: type_info::Record) -> u8 {
    let read_only: u8 = signature_encoded_flag(
        record.flags, type_info::Flag.read_only as usize, SignatureTypeQualifier.read_only as usize as u8);
    let volatile_pointee: u8 = signature_encoded_flag(
        record.flags, type_info::Flag.volatile_pointee as usize,
        SignatureTypeQualifier.volatile_pointee as usize as u8);
    return read_only | volatile_pointee;
}

fn signature_generic_type_tag(kind: type_info::Kind) -> u8 {
    switch (kind) {
    case type_info::Kind.structure {
        return SignatureTypeTag.generic_structure as usize as u8;
    }
    case type_info::Kind.record_union {
        return SignatureTypeTag.generic_union as usize as u8;
    }
    case type_info::Kind.class_type {
        return SignatureTypeTag.generic_class as usize as u8;
    }
    default {
        return SignatureTypeTag.invalid as usize as u8;
    }
    }
}

fn signature_type_tag(context: *context::Context, type_id: usize, kind: type_info::Kind) -> u8 {
    if (context->generics.instance_for_type(type_id) != context::no_id()) {
        return signature_generic_type_tag(kind);
    }
    let invalid: u8 = SignatureTypeTag.invalid as usize as u8;
    let tags: [SignatureTypeTagMap.kind_count]u8 = {
        invalid, SignatureTypeTag.type_void as usize as u8, SignatureTypeTag.boolean as usize as u8,
        SignatureTypeTag.signed_8 as usize as u8, SignatureTypeTag.signed_16 as usize as u8,
        SignatureTypeTag.signed_32 as usize as u8, SignatureTypeTag.signed_64 as usize as u8,
        SignatureTypeTag.signed_size as usize as u8, SignatureTypeTag.unsigned_8 as usize as u8,
        SignatureTypeTag.unsigned_16 as usize as u8, SignatureTypeTag.unsigned_32 as usize as u8,
        SignatureTypeTag.unsigned_64 as usize as u8, SignatureTypeTag.unsigned_size as usize as u8,
        SignatureTypeTag.float_32 as usize as u8, SignatureTypeTag.float_64 as usize as u8,
        SignatureTypeTag.pointer as usize as u8, SignatureTypeTag.array as usize as u8,
        SignatureTypeTag.structure as usize as u8, SignatureTypeTag.record_union as usize as u8,
        SignatureTypeTag.enumeration as usize as u8, invalid, SignatureTypeTag.function_pointer as usize as u8,
        SignatureTypeTag.va_list_type as usize as u8, SignatureTypeTag.class_type as usize as u8,
        SignatureTypeTag.bound_method as usize as u8, SignatureTypeTag.reference as usize as u8,
    };
    let kind_index: usize = kind as usize;
    if (kind_index >= SignatureTypeTagMap.kind_count as usize) {
        return SignatureTypeTag.invalid as usize as u8;
    }
    return tags[kind_index];
}

fn signature_function_pointer(
    context: *context::Context, writer: *SignatureWriter, record: type_info::Record, depth: usize) {
    if (record.field_count > SignatureFormat.maximum_u32 as usize) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    writer->write_byte(SignatureCallingConvention.system_v as usize as u8);
    writer->write_u32(record.field_count as u32);
    let fields: *const type_info::Field = context->types.field_data() as
            *const type_info::Field;
    for (var index: usize = 0; index < record.field_count && writer->active(); index += 1) {
        signature_type(context, writer, fields[record.first_field + index].type_id, depth + 1);
    }
    signature_type(context, writer, record.element_type, depth + 1);
}

fn signature_generic_named_type(
    context: *context::Context, writer: *SignatureWriter, type_id: usize, record: type_info::Record, depth: usize) {
    signature_named_type(context, writer, record);
    let instance_id: usize = context->generics.instance_for_type(type_id);
    if (instance_id == context::no_id() || instance_id >= context->generics.instance_count()) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    let instances: *const domain::GenericInstance = context->generics.instance_data() as
            *const domain::GenericInstance;
    let arguments: *const usize = context->generics.argument_data() as *const usize;
    let instance: domain::GenericInstance = instances[instance_id];
    if (instance.argument_count > SignatureFormat.maximum_u32 as usize) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    writer->write_u32(instance.argument_count as u32);
    for (var index: usize = 0;
        index < instance.argument_count && writer->active();
        index += 1) {
        signature_type(context, writer, arguments[instance.first_argument + index], depth + 1);
    }
}

fn signature_type_payload(
    context: *context::Context, writer: *SignatureWriter, type_id: usize, record: type_info::Record, depth: usize) {
    switch (record.kind) {
    case type_info::Kind.pointer {
        writer->write_byte(signature_pointer_qualifiers(record));
        signature_type(context, writer, record.element_type, depth + 1);
    }
    case type_info::Kind.reference {
        let read_only: usize = (record.flags & (type_info::Flag.read_only as usize)) != 0 ?
            SignatureTypeQualifier.read_only as usize : 0;
        let rvalue: usize = (record.flags & (type_info::Flag.rvalue_reference as usize)) != 0 ?
            SignatureTypeQualifier.rvalue_reference as usize : 0;
        writer->write_byte((read_only | rvalue) as u8);
        signature_type(context, writer, record.element_type, depth + 1);
    }
    case type_info::Kind.array {
        writer->write_u64(record.element_count as u64);
        signature_type(context, writer, record.element_type, depth + 1);
    }
    case type_info::Kind.structure, type_info::Kind.record_union, type_info::Kind.enumeration,
        type_info::Kind.class_type {
        let instance_id: usize = context->generics.instance_for_type(type_id);
        if (instance_id == context::no_id()) {
            signature_named_type(context, writer, record);
        } else {
            signature_generic_named_type(context, writer, type_id, record, depth);
        }
    }
    case type_info::Kind.function_pointer, type_info::Kind.bound_method {
        signature_function_pointer(context, writer, record, depth);
    }
    default {
    }
    }
}

fn signature_type(context: *context::Context, writer: *SignatureWriter, type_id: usize, depth: usize) {
    if (!signature_type_reference_is_valid(context, type_id, depth)) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    let records: *const type_info::Record = context->types.record_data() as
            *const type_info::Record;
    let record: type_info::Record = records[type_id];
    if (record.kind == type_info::Kind.invalid) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    if (record.kind == type_info::Kind.alias) {
        signature_type(context, writer, record.element_type, depth + 1);
        return;
    }
    let tag: u8 = signature_type_tag(context, type_id, record.kind);
    if (tag == SignatureTypeTag.invalid as usize as u8) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    writer->write_byte(tag);
    signature_type_payload(context, writer, type_id, record, depth);
}

fn function_signature_state_is_empty(function: domain::Function) -> bool {
    return function.signature_offset == context::no_id() && function.signature_length == 0;
}

fn function_signature_flags(function: domain::Function) -> u8 {
    let variadic: u8 = signature_encoded_flag(
        function.flags, context::SymbolFlag.variadic as usize, SignatureFunctionFlag.variadic as usize as u8);
    let no_return: u8 = signature_encoded_flag(
        function.flags, context::SymbolFlag.no_return as usize, SignatureFunctionFlag.no_return as usize as u8);
    let external: u8 = signature_encoded_flag(
        function.flags, context::SymbolFlag.external as usize, SignatureFunctionFlag.external as usize as u8);
    return variadic | no_return | external;
}

fn signature_generic_function_origin(context: *context::Context, writer: *SignatureWriter, instance_id: usize) {
    if (instance_id >= context->generics.instance_count()) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    let instances: *const domain::GenericInstance = context->generics.instance_data() as
            *const domain::GenericInstance;
    let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
            *const domain::GenericDeclaration;
    let arguments: *const usize = context->generics.argument_data() as *const usize;
    let instance: domain::GenericInstance = instances[instance_id];
    if (instance.declaration_id >= context->generics.declaration_count()) {
        writer->fail(runtime::Error.invalid_argument);
        return;
    }
    let declaration: domain::GenericDeclaration = declarations[instance.declaration_id];
    signature_declaration_name(context, writer, declaration.module_id, declaration.unit_index, declaration.name_token);
    writer->write_u32(instance.argument_count as u32);
    for (var index: usize = 0;
        index < instance.argument_count && writer->active();
        index += 1) {
        signature_type(context, writer, arguments[instance.first_argument + index], 0);
    }
}

fn function_signature_input_is_valid(context: *context::Context, function_id: usize) -> bool {
    if (function_id >= context->callables.function_count()) {
        return false;
    }
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let function: domain::Function = functions[function_id];
    if (!domain::callable_is_valid(function.identity, context->types.size())) {
        return false;
    }
    let parameter_count_is_valid: bool = function_argument_parameter_count(function) <=
        SignatureFormat.maximum_u32 as usize;
    return function_signature_state_is_empty(function) && parameter_count_is_valid;
}

fn signature_owner_payload(context: *context::Context, writer: *SignatureWriter, identity: domain::CallableIdentity) {
    if (domain::has_owner(identity)) {
        signature_type(context, writer, identity.owner_type, 0);
    }
}

fn append_function_signature(context: *context::Context, function_id: usize, writer: *SignatureWriter) -> bool {
    if (!function_signature_input_is_valid(context, function_id)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    if (writer == null || writer->error() != runtime::Error.none) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    writer->reset();
    let functions: *const domain::Function = context->callables.function_data();
    let function: domain::Function = functions[function_id];
    let generic_instance: usize = context->generics.instance_for_function(function_id);
    let version: usize = generic_instance == context::no_id() ?
        SignatureFormat.version as usize : SignatureFormat.generic_version as usize;
    writer->write_byte(version as u8);
    writer->write_byte(SignatureCallingConvention.system_v as usize as u8);
    signature_callable_identity(writer, function.identity);
    writer->write_byte(function_signature_flags(function));
    if (generic_instance != context::no_id()) {
        signature_generic_function_origin(context, writer, generic_instance);
    }
    signature_owner_payload(context, writer, function.identity);
    let parameter_count: usize = function_argument_parameter_count(function);
    let first_parameter: usize = function_first_argument_parameter(function);
    writer->write_u32(parameter_count as u32);

    let parameters: *const domain::Parameter = context->callables.parameter_data() as
            *const domain::Parameter;
    for (var index: usize = 0; index < parameter_count && writer->active(); index += 1) {
        signature_type(context, writer, parameters[first_parameter + index].type_id, 0);
    }
    signature_type(context, writer, function.return_type, 0);
    let writer_error: runtime::Error = writer->error();
    if (writer_error != runtime::Error.none) {
        context->error = writer_error;
        return false;
    }
    if (context->error != runtime::Error.none) {
        return false;
    }
    context->error = context->callables.append_signature(function_id, writer->data() as *const u8, writer->size());
    return context->error == runtime::Error.none;
}

fn build_instance_signature(context: *context::Context, function_id: usize) -> bool {
    var writer: SignatureWriter = SignatureWriter();
    return append_function_signature(context, function_id, &writer);
}

fn build_function_signatures(context: *context::Context) -> bool {
    if (context->callables.signature_size() != 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var writer: SignatureWriter = SignatureWriter();
    for (var function_id: usize = 0;
        function_id < context->callables.function_count() && context->error == runtime::Error.none;
        function_id += 1) {
        append_function_signature(context, function_id, &writer);
    }
    return context->error == runtime::Error.none;
}

fn signature_range_is_valid(context: *context::Context, function: domain::Function) -> bool {
    let length_is_valid: bool = function.signature_length != 0;
    let range_is_valid: bool = checked::range_is_valid(
        function.signature_offset, function.signature_length, context->callables.signature_size());
    return length_is_valid && range_is_valid;
}

fn signature_is_before(context: *context::Context, left_function: usize, right_function: usize) -> bool {
    let ids_are_valid: bool = left_function < context->callables.function_count() &&
        right_function < context->callables.function_count();
    if (!ids_are_valid) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let left: domain::Function = functions[left_function];
    let right: domain::Function = functions[right_function];
    let ranges_are_valid: bool = signature_range_is_valid(context, left) && signature_range_is_valid(context, right);
    if (!ranges_are_valid) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let shared: usize = left.signature_length < right.signature_length ? left.signature_length : right.signature_length;
    for (var index: usize = 0; index < shared; index += 1) {
        let left_byte: u8 = context->callables.signature_data()[left.signature_offset + index];
        let right_byte: u8 = context->callables.signature_data()[right.signature_offset + index];
        if (left_byte != right_byte) {
            return left_byte < right_byte;
        }
    }
    return left.signature_length < right.signature_length;
}
