module luna.bootstrap.middleend.semantic.functions;

fn append_binding(context: *context::Context, binding: domain::Binding) -> usize {
    if (context->error != runtime::Error.none) {
        return context::no_id();
    }
    let result = context->callables.append_binding(binding);
    context->error = result.error;
    return result.index;
}

fn source_span_is_valid(unit: *const context::Unit, span: lexer::SourceSpan) -> bool {
    if (unit == null) {
        return false;
    }
    return checked::range_is_valid(span.offset, span.length, unit->source.length);
}

fn text_is_before(
    context: *context::Context, left_unit: usize, left_span: lexer::SourceSpan,
    right_unit: usize, right_span: lexer::SourceSpan) -> bool {
    let left: *const context::Unit = context::input_unit(context, left_unit);
    let right: *const context::Unit = context::input_unit(context, right_unit);
    let left_is_valid: bool = source_span_is_valid(left, left_span);
    let right_is_valid: bool = source_span_is_valid(right, right_span);
    if (!left_is_valid || !right_is_valid) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let shared_length: usize = left_span.length < right_span.length ? left_span.length : right_span.length;
    for (var index: usize = 0; index < shared_length; index += 1) {
        let left_byte: u8 = left->source.data[left_span.offset + index];
        let right_byte: u8 = right->source.data[right_span.offset + index];
        if (left_byte != right_byte) {
            return left_byte < right_byte;
        }
    }
    return left_span.length < right_span.length;
}

fn token_is_before(
    context: *context::Context, left_unit: usize, left_token: usize, right_unit: usize, right_token: usize) -> bool {
    return text_is_before(
        context, left_unit, context::token(context, left_unit, left_token).span,
        right_unit, context::token(context, right_unit, right_token).span);
}

fn module_name_is_before(context: *context::Context, left_module: usize, right_module: usize) -> bool {
    let modules: *const context::Module = context->symbols.module_data() as
            *const context::Module;
    let left: context::Module = modules[left_module];
    let right: context::Module = modules[right_module];
    let left_name: syntax::SyntaxNode = context::node(context, left.name_unit, left.name_node);
    let right_name: syntax::SyntaxNode = context::node(context, right.name_unit, right.name_node);
    var left_child: usize = left_name.first_child;
    var right_child: usize = right_name.first_child;
    let shared_count: usize = left_name.child_count < right_name.child_count ?
            left_name.child_count : right_name.child_count;
    for (var index: usize = 0; index < shared_count; index += 1) {
        let left_component: syntax::SyntaxNode = context::node(context, left.name_unit, left_child);
        let right_component: syntax::SyntaxNode = context::node(context, right.name_unit, right_child);
        if (!context::tokens_equal(
                context, left.name_unit, left_component.token_index, right.name_unit, right_component.token_index)) {
            return token_is_before(
                context, left.name_unit, left_component.token_index, right.name_unit, right_component.token_index);
        }
        left_child = left_component.next_sibling;
        right_child = right_component.next_sibling;
    }
    return left_name.child_count < right_name.child_count;
}

fn functions_share_binding(context: *context::Context, left_function: usize, right_function: usize) -> bool {
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    let left_record: domain::Function = functions[left_function];
    let right_record: domain::Function = functions[right_function];
    let left: context::Symbol = symbols[left_record.symbol_id];
    let right: context::Symbol = symbols[right_record.symbol_id];
    let modules_match: bool = left.module_id == right.module_id;
    let owners_match: bool = domain::same_owner(left_record.identity, right_record.identity);
    let scopes_match: bool = modules_match && owners_match;
    let names_match: bool = context::tokens_equal(
        context, left.declaration_unit, left.name_token, right.declaration_unit, right.name_token);
    return scopes_match && names_match;
}

fn function_owner_is_before(context: *context::Context, left_function: usize, right_function: usize) -> bool {
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let left_owner: usize = functions[left_function].identity.owner_type;
    let right_owner: usize = functions[right_function].identity.owner_type;
    if (left_owner == domain::no_owner()) {
        return true;
    }
    if (right_owner == domain::no_owner()) {
        return false;
    }
    let records: *const type_info::Record = context->types.record_data() as
            *const type_info::Record;
    let left: type_info::Record = records[left_owner];
    let right: type_info::Record = records[right_owner];
    let left_module: usize = context->symbols.unit_module(context, left.declaration_unit);
    let right_module: usize = context->symbols.unit_module(context, right.declaration_unit);
    if (left_module != right_module) {
        return module_name_is_before(context, left_module, right_module);
    }
    return token_is_before(context, left.declaration_unit, left.name_token, right.declaration_unit, right.name_token);
}

fn function_is_before(context: *context::Context, left_function: usize, right_function: usize) -> bool {
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    let left: context::Symbol = symbols[functions[left_function].symbol_id];
    let right: context::Symbol = symbols[functions[right_function].symbol_id];
    if (left.module_id != right.module_id) {
        return module_name_is_before(context, left.module_id, right.module_id);
    }
    if (!domain::same_owner(functions[left_function].identity, functions[right_function].identity)) {
        return function_owner_is_before(context, left_function, right_function);
    }
    if (!context::tokens_equal(
            context, left.declaration_unit, left.name_token, right.declaration_unit, right.name_token)) {
        return token_is_before(
            context, left.declaration_unit, left.name_token, right.declaration_unit, right.name_token);
    }
    return signature_is_before(context, left_function, right_function);
}

fn function_order_sift_down(context: *context::Context, ordered: *usize, start: usize, count: usize) -> bool {
    if (ordered == null || start >= count) {
        return false;
    }
    var root: usize = start;
    for (; root < count / 2 && context->error == runtime::Error.none;) {
        let left_child: usize = root * 2 + 1;
        var selected: usize = root;
        if (function_is_before(context, ordered[selected], ordered[left_child])) {
            selected = left_child;
        }
        let right_child: usize = left_child + 1;
        if (right_child < count && function_is_before(context, ordered[selected], ordered[right_child])) {
            selected = right_child;
        }
        if (selected == root) {
            return true;
        }
        let saved: usize = ordered[root];
        ordered[root] = ordered[selected];
        ordered[selected] = saved;
        root = selected;
    }
    return context->error == runtime::Error.none;
}

fn function_order(context: *context::Context) -> bytes::Buffer {
    var order: bytes::Buffer = bytes::empty();
    for (var function_id: usize = 0;
        function_id < context->callables.function_count() && context->error == runtime::Error.none;
        function_id += 1) {
        let appended: bytes::BufferResult =
            bytes::append(order, (&function_id) as *const usize as *const u8, sizeof(usize));
        order = appended.buffer;
        context->error = appended.error;
    }
    let ordered: *usize = order.data as *usize;
    for (var heap_index: usize = context->callables.function_count() / 2;
        heap_index != 0 && context->error == runtime::Error.none;
        heap_index -= 1) {
        function_order_sift_down(context, ordered, heap_index - 1, context->callables.function_count());
    }
    for (var remaining: usize = context->callables.function_count();
        remaining > 1 && context->error == runtime::Error.none;
        remaining -= 1) {
        let last: usize = remaining - 1;
        let saved: usize = ordered[0];
        ordered[0] = ordered[last];
        ordered[last] = saved;
        function_order_sift_down(context, ordered, 0, last);
    }
    return order;
}

fn begin_binding(context: *context::Context, function_id: usize, candidate_index: usize) -> usize {
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    let symbol: context::Symbol = symbols[functions[function_id].symbol_id];
    return append_binding(
        context, {
            kind = domain::BindingKind.callable_set, module_id = symbol.module_id,
            owner_type = functions[function_id].identity.owner_type,
            declaration_unit = symbol.declaration_unit, declaration_node = symbol.declaration_node,
            name_token = symbol.name_token, first_candidate = candidate_index, candidate_count = 1,
            first_generic_candidate = context::no_id(), generic_candidate_count = 0,
        });
}

fn extend_binding(context: *context::Context, binding_id: usize) -> bool {
    if (context->error != runtime::Error.none) {
        return false;
    }
    context->error = context->callables.extend_binding(binding_id);
    return context->error == runtime::Error.none;
}

fn generic_declarations_share_binding(context: *context::Context, left_id: usize, right_id: usize) -> bool {
    let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
            *const domain::GenericDeclaration;
    let left: domain::GenericDeclaration = declarations[left_id];
    let right: domain::GenericDeclaration = declarations[right_id];
    let modules_match: bool = left.module_id == right.module_id;
    let names_match: bool = context::tokens_equal(
        context, left.unit_index, left.name_token, right.unit_index, right.name_token);
    return modules_match && names_match;
}

fn generic_declaration_is_before(context: *context::Context, left_id: usize, right_id: usize) -> bool {
    let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
            *const domain::GenericDeclaration;
    let left: domain::GenericDeclaration = declarations[left_id];
    let right: domain::GenericDeclaration = declarations[right_id];
    if (left.module_id != right.module_id) {
        return module_name_is_before(context, left.module_id, right.module_id);
    }
    if (!context::tokens_equal(
            context, left.unit_index, left.name_token, right.unit_index, right.name_token)) {
        return token_is_before(context, left.unit_index, left.name_token, right.unit_index, right.name_token);
    }
    let left_span: lexer::SourceSpan = context::node(context, left.unit_index, left.node_index).span;
    let right_span: lexer::SourceSpan = context::node(context, right.unit_index, right.node_index).span;
    return text_is_before(context, left.unit_index, left_span, right.unit_index, right_span);
}

fn generic_order_sift_down(context: *context::Context, ordered: *usize, start: usize, count: usize) -> bool {
    if (ordered == null || start >= count) {
        return false;
    }
    var root: usize = start;
    for (; root < count / 2 && context->error == runtime::Error.none;) {
        let left_child: usize = root * 2 + 1;
        var selected: usize = root;
        if (generic_declaration_is_before(context, ordered[selected], ordered[left_child])) {
            selected = left_child;
        }
        let right_child: usize = left_child + 1;
        if (right_child < count && generic_declaration_is_before(context, ordered[selected], ordered[right_child])) {
            selected = right_child;
        }
        if (selected == root) {
            return true;
        }
        let saved: usize = ordered[root];
        ordered[root] = ordered[selected];
        ordered[selected] = saved;
        root = selected;
    }
    return context->error == runtime::Error.none;
}

fn generic_function_order(context: *context::Context) -> bytes::Buffer {
    var order: bytes::Buffer = bytes::empty();
    for (var declaration_id: usize = 0;
        declaration_id < context->generics.declaration_count() && context->error == runtime::Error.none;
        declaration_id += 1) {
        let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
                *const domain::GenericDeclaration;
        if (declarations[declaration_id].kind != domain::GenericDeclarationKind.function_declaration) {
            continue;
        }
        let appended: bytes::BufferResult = bytes::append(
            order, (&declaration_id) as *const usize as *const u8, sizeof(usize));
        order = appended.buffer;
        context->error = appended.error;
    }
    let count: usize = order.length / sizeof(usize);
    let ordered: *usize = order.data as *usize;
    for (var heap_index: usize = count / 2;
        heap_index != 0 && context->error == runtime::Error.none;
        heap_index -= 1) {
        generic_order_sift_down(context, ordered, heap_index - 1, count);
    }
    for (var remaining: usize = count;
        remaining > 1 && context->error == runtime::Error.none;
        remaining -= 1) {
        let last: usize = remaining - 1;
        let saved: usize = ordered[0];
        ordered[0] = ordered[last];
        ordered[last] = saved;
        generic_order_sift_down(context, ordered, 0, last);
    }
    return order;
}

fn binding_matches_generic(
    context: *context::Context, binding: domain::Binding, declaration: domain::GenericDeclaration) -> bool {
    let scope_matches: bool = binding.module_id == declaration.module_id && binding.owner_type == domain::no_owner();
    let name_matches: bool = context::tokens_equal(
        context, binding.declaration_unit, binding.name_token, declaration.unit_index, declaration.name_token);
    return scope_matches && name_matches;
}

fn binding_is_before_generic(
    context: *context::Context, binding: domain::Binding, declaration: domain::GenericDeclaration) -> bool {
    if (binding.module_id != declaration.module_id) {
        return module_name_is_before(context, binding.module_id, declaration.module_id);
    }
    if (binding.owner_type != domain::no_owner()) {
        return false;
    }
    if (context::tokens_equal(
            context, binding.declaration_unit, binding.name_token, declaration.unit_index, declaration.name_token)) {
        return false;
    }
    return token_is_before(
        context, binding.declaration_unit, binding.name_token, declaration.unit_index, declaration.name_token);
}

fn find_generic_binding(
    context: *context::Context, declaration: domain::GenericDeclaration,
    binding_limit: usize, cursor: *usize) -> usize {
    if (cursor == null || *cursor > binding_limit) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as *const domain::Binding;
    for (; *cursor < binding_limit; *cursor += 1) {
        let binding: domain::Binding = bindings[*cursor];
        if (binding_matches_generic(context, binding, declaration)) {
            return *cursor;
        }
        if (!binding_is_before_generic(context, binding, declaration)) {
            return context::no_id();
        }
    }
    return context::no_id();
}

fn begin_generic_binding(context: *context::Context, declaration: domain::GenericDeclaration) -> usize {
    return append_binding(
        context, {
            kind = domain::BindingKind.callable_set, module_id = declaration.module_id,
            owner_type = domain::no_owner(), declaration_unit = declaration.unit_index,
            declaration_node = declaration.node_index, name_token = declaration.name_token,
            first_candidate = context::no_id(), candidate_count = 0,
            first_generic_candidate = context::no_id(), generic_candidate_count = 0,
        });
}

fn append_generic_candidate(context: *context::Context, binding_id: usize, declaration_id: usize) -> bool {
    if (context->error != runtime::Error.none) {
        return false;
    }
    if (declaration_id >= context->generics.declaration_count()) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    context->error = context->callables.append_generic_candidate(binding_id, declaration_id);
    if (context->error != runtime::Error.none) {
        return false;
    }
    context->error = context->generics.set_declaration_binding(declaration_id, binding_id);
    return context->error == runtime::Error.none;
}

fn build_generic_bindings(context: *context::Context) -> bool {
    let order: bytes::Buffer = generic_function_order(context);
    let ordered: *const usize = order.data as *const usize;
    let count: usize = order.length / sizeof(usize);
    let ordinary_binding_count: usize = context->callables.binding_count();
    var binding_cursor: usize = 0;
    var active_binding: usize = context::no_id();
    for (var index: usize = 0; index < count && context->error == runtime::Error.none; index += 1) {
        let declaration_id: usize = ordered[index];
        let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
                *const domain::GenericDeclaration;
        let declaration: domain::GenericDeclaration = declarations[declaration_id];
        let starts_binding: bool = index == 0 ||
            !generic_declarations_share_binding(context, ordered[index - 1], declaration_id);
        if (starts_binding) {
            active_binding = find_generic_binding(context, declaration, ordinary_binding_count, &binding_cursor);
            if (active_binding == context::no_id()) {
                active_binding = begin_generic_binding(context, declaration);
            }
        }
        if (active_binding == context::no_id() || !append_generic_candidate(context, active_binding, declaration_id)) {
            break;
        }
    }
    let release_error: runtime::Error = bytes::release(order);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none;
}

fn build_function_bindings(context: *context::Context) -> bool {
    let state_is_empty: bool = context->callables.binding_count() == 0 && context->callables.candidate_count() == 0;
    if (!state_is_empty) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let order: bytes::Buffer = function_order(context);
    let ordered_source: *const usize = order.data as *const usize;
    if (context->error == runtime::Error.none) {
        context->error = context->callables.publish_function_order(ordered_source, order.length / sizeof(usize));
    }
    let ordered: *const usize = context->callables.candidate_data();
    var active_binding: usize = context::no_id();
    for (var candidate_index: usize = 0;
        candidate_index < context->callables.candidate_count() && context->error == runtime::Error.none;
        candidate_index += 1) {
        let function_id: usize = ordered[candidate_index];
        let starts_binding: bool = candidate_index == 0 ||
            !functions_share_binding(context, ordered[candidate_index - 1], function_id);
        if (starts_binding) {
            active_binding = begin_binding(context, function_id, candidate_index);
        } else {
            extend_binding(context, active_binding);
        }
        if (context->error != runtime::Error.none || active_binding == context::no_id()) {
            if (context->error == runtime::Error.none) {
                context->error = runtime::Error.invalid_argument;
            }
            break;
        }
        context->error = context->callables.set_function_binding(function_id, active_binding);
    }
    let release_error: runtime::Error = bytes::release(order);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (context->error != runtime::Error.none) {
        return false;
    }
    if (!build_generic_bindings(context)) {
        return false;
    }
    if (!function_bindings_are_valid(context)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    if (!context->callables.is_valid(context->generics.declaration_count())) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    return true;
}

fn bind_function_instances(context: *context::Context, first_function: usize, owner_type: usize) -> bool {
    if (first_function > context->callables.function_count()) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var order: bytes::Buffer = bytes::empty();
    for (var function_id: usize = first_function;
        function_id < context->callables.function_count() && context->error == runtime::Error.none;
        function_id += 1) {
        let functions_data: *const domain::Function = context->callables.function_data() as *const domain::Function;
        if (functions_data[function_id].identity.owner_type != owner_type) {
            continue;
        }
        let appended: bytes::BufferResult = bytes::append(
            order, (&function_id) as *const usize as *const u8, sizeof(usize));
        order = appended.buffer;
        context->error = appended.error;
    }
    let count: usize = order.length / sizeof(usize);
    let ordered: *usize = order.data as *usize;
    for (var heap_index: usize = count / 2;
        heap_index != 0 && context->error == runtime::Error.none;
        heap_index -= 1) {
        function_order_sift_down(context, ordered, heap_index - 1, count);
    }
    for (var remaining: usize = count;
        remaining > 1 && context->error == runtime::Error.none;
        remaining -= 1) {
        let last: usize = remaining - 1;
        let saved: usize = ordered[0];
        ordered[0] = ordered[last];
        ordered[last] = saved;
        function_order_sift_down(context, ordered, 0, last);
    }
    var active_binding: usize = context::no_id();
    for (var index: usize = 0; index < count && context->error == runtime::Error.none; index += 1) {
        let function_id: usize = ordered[index];
        let appended = context->callables.append_ordered_function(function_id);
        context->error = appended.error;
        if (appended.error != runtime::Error.none) {
            break;
        }
        let candidate_index: usize = appended.index;
        let starts_binding: bool = index == 0 || !functions_share_binding(context, ordered[index - 1], function_id);
        if (starts_binding) {
            active_binding = begin_binding(context, function_id, candidate_index);
        } else {
            extend_binding(context, active_binding);
        }
        if (context->error != runtime::Error.none || active_binding == context::no_id()) {
            if (context->error == runtime::Error.none) {
                context->error = runtime::Error.invalid_argument;
            }
            break;
        }
        context->error = context->callables.set_function_binding(function_id, active_binding);
    }
    let release_error: runtime::Error = bytes::release(order);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (context->error == runtime::Error.none && !context->callables.is_valid(context->generics.declaration_count())) {
        context->error = runtime::Error.invalid_argument;
    }
    return context->error == runtime::Error.none;
}

fn binding_range_is_valid(context: *context::Context, binding: domain::Binding) -> bool {
    let concrete_range_is_valid: bool = binding.candidate_count == 0 ?
        binding.first_candidate == context::no_id() : checked::range_is_valid(
        binding.first_candidate, binding.candidate_count, context->callables.candidate_count());
    let generic_range_is_valid: bool = binding.generic_candidate_count == 0 ?
        binding.first_generic_candidate == context::no_id() : checked::range_is_valid(
            binding.first_generic_candidate, binding.generic_candidate_count,
            context->callables.generic_candidate_count());
    let has_candidate: bool = binding.candidate_count != 0 || binding.generic_candidate_count != 0;
    let ranges_are_valid: bool = concrete_range_is_valid && generic_range_is_valid;
    return has_candidate && ranges_are_valid;
}

fn binding_candidate_is_valid(
    context: *context::Context, binding_id: usize, binding: domain::Binding, candidate_index: usize) -> bool {
    let candidates: *const usize = context->callables.candidate_data() as
            *const usize;
    let function_id: usize = candidates[binding.first_candidate + candidate_index];
    if (function_id >= context->callables.function_count()) {
        return false;
    }
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let binding_matches: bool = functions[function_id].binding_id == binding_id;
    let owner_matches: bool = functions[function_id].identity.owner_type == binding.owner_type;
    let candidate_matches: bool = binding_matches && owner_matches;
    let first_function: usize = candidates[binding.first_candidate];
    let identity_matches: bool = functions_share_binding(context, first_function, function_id);
    return candidate_matches && identity_matches;
}

fn generic_candidate_slices_are_valid(context: *context::Context) -> bool {
    if (context->callables.generic_candidate_count() == 0) {
        return true;
    }
    let created: bytes::BufferResult = bytes::with_capacity(context->callables.generic_candidate_count());
    var seen: bytes::Buffer = created.buffer;
    context->error = created.error;
    if (created.error != runtime::Error.none) {
        return false;
    }
    seen.length = context->callables.generic_candidate_count();
    for (var index: usize = 0; index < seen.length; index += 1) {
        seen.data[index] = 0;
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as *const domain::Binding;
    let candidates: *const usize = context->callables.generic_candidate_data() as *const usize;
    let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
            *const domain::GenericDeclaration;
    var valid: bool = true;
    for (var binding_id: usize = 0; binding_id < context->callables.binding_count() && valid; binding_id += 1) {
        let binding: domain::Binding = bindings[binding_id];
        for (var index: usize = 0; index < binding.generic_candidate_count; index += 1) {
            let position: usize = binding.first_generic_candidate + index;
            let declaration_id: usize = candidates[position];
            if (seen.data[position] != 0 || declaration_id >= context->generics.declaration_count()) {
                valid = false;
                break;
            }
            let declaration: domain::GenericDeclaration = declarations[declaration_id];
            let identity_matches: bool = declaration.binding_id == binding_id &&
                binding_matches_generic(context, binding, declaration);
            if (!identity_matches) {
                valid = false;
                break;
            }
            seen.data[position] = 1;
        }
    }
    for (var index: usize = 0; index < seen.length && valid; index += 1) {
        valid = seen.data[index] == 1;
    }
    let release_error: runtime::Error = bytes::release(seen);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return valid && release_error == runtime::Error.none;
}

fn function_bindings_are_valid(context: *context::Context) -> bool {
    if (context->callables.candidate_count() != context->callables.function_count()) {
        return false;
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    var expected_candidate: usize = 0;
    for (var binding_id: usize = 0; binding_id < context->callables.binding_count(); binding_id += 1) {
        let binding: domain::Binding = bindings[binding_id];
        let kind_is_valid: bool = binding.kind == domain::BindingKind.callable_set;
        let position_is_valid: bool = binding.candidate_count == 0 ?
            binding.first_candidate == context::no_id() : binding.first_candidate == expected_candidate;
        let shape_is_valid: bool = kind_is_valid && position_is_valid;
        let owner_is_valid: bool = binding.owner_type == domain::no_owner() ||
            binding.owner_type < context->types.size();
        if (!shape_is_valid || !owner_is_valid) {
            return false;
        }
        if (!binding_range_is_valid(context, binding)) {
            return false;
        }
        for (var candidate_index: usize = 0; candidate_index < binding.candidate_count; candidate_index += 1) {
            if (!binding_candidate_is_valid(context, binding_id, binding, candidate_index)) {
                return false;
            }
        }
        expected_candidate += binding.candidate_count;
    }
    if (expected_candidate != context->callables.candidate_count()) {
        return false;
    }
    if (!generic_candidate_slices_are_valid(context)) {
        return false;
    }
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    for (var function_id: usize = 0; function_id < context->callables.function_count(); function_id += 1) {
        if (functions[function_id].binding_id >= context->callables.binding_count()) {
            return false;
        }
    }
    return true;
}

fn candidate_is_visible_in_module(
    context: *context::Context, function_id: usize, unit_index: usize, binding_module: usize) -> bool {
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    let symbols: *const context::Symbol = context->symbols.symbol_data() as
            *const context::Symbol;
    let function: domain::Function = functions[function_id];
    let symbol: context::Symbol = symbols[function.symbol_id];
    if (domain::has_owner(function.identity) && !classes::method_is_accessible(context, function_id)) {
        return false;
    }
    let owner_module: usize = context->symbols.unit_module(context, unit_index);
    if (owner_module != binding_module) {
        if (domain::has_owner(function.identity)) {
            return (function.flags & (context::SymbolFlag.member_exported as usize)) != 0;
        }
        return (symbol.flags & (context::SymbolFlag.exported as usize)) != 0;
    }
    if (!context->symbols.unit_is_interface(context, unit_index)) {
        return true;
    }
    return (symbol.flags & (context::SymbolFlag.interface_declaration as usize)) != 0;
}

fn function_is_visible(context: *context::Context, function_id: usize, unit_index: usize) -> bool {
    if (function_id >= context->callables.function_count()) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    if (context->generics.instance_for_function(function_id) != context::no_id()) {
        return true;
    }
    let binding_id: usize = functions[function_id].binding_id;
    if (binding_id >= context->callables.binding_count()) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    return candidate_is_visible_in_module(context, function_id, unit_index, bindings[binding_id].module_id);
}

fn binding_has_visible_candidate(context: *context::Context, binding: domain::Binding, unit_index: usize) -> bool {
    if (!binding_range_is_valid(context, binding)) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let candidates: *const usize = context->callables.candidate_data() as
            *const usize;
    for (var index: usize = 0; index < binding.candidate_count; index += 1) {
        let function_id: usize = candidates[binding.first_candidate + index];
        if (candidate_is_visible_in_module(context, function_id, unit_index, binding.module_id)) {
            return true;
        }
    }
    let generic_candidates: *const usize = context->callables.generic_candidate_data() as *const usize;
    let declarations: *const domain::GenericDeclaration = context->generics.declaration_data() as
            *const domain::GenericDeclaration;
    let owner_module: usize = context->symbols.unit_module(context, unit_index);
    for (var index: usize = 0; index < binding.generic_candidate_count; index += 1) {
        let generic_id: usize = generic_candidates[binding.first_generic_candidate + index];
        if (generic_id >= context->generics.declaration_count()) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        let declaration: domain::GenericDeclaration = declarations[generic_id];
        let same_module: bool = owner_module == binding.module_id;
        let exported: bool = (declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0;
        if (same_module || exported) {
            return true;
        }
    }
    return false;
}

fn find_module_binding(context: *context::Context, unit_index: usize, module_id: usize, name_token: usize) -> usize {
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    for (var binding_id: usize = 0; binding_id < context->callables.binding_count(); binding_id += 1) {
        let binding: domain::Binding = bindings[binding_id];
        let scope_matches: bool = binding.module_id == module_id && binding.owner_type == domain::no_owner();
        let identity_matches: bool = binding.kind == domain::BindingKind.callable_set && scope_matches;
        let name_matches: bool = context::tokens_equal(
            context, unit_index, name_token, binding.declaration_unit, binding.name_token);
        let binding_matches: bool = identity_matches && name_matches;
        if (binding_matches && binding_has_visible_candidate(context, binding, unit_index)) {
            return binding_id;
        }
    }
    return context::no_id();
}

fn lookup_owned_callable_binding(
    context: *context::Context, unit_index: usize, owner_type: usize, name_token: usize) -> usize {
    if (owner_type >= context->types.size()) {
        return context::no_id();
    }
    let owner: type_info::Record = context::type_record(context, owner_type);
    let module_id: usize = context->symbols.unit_module(context, owner.declaration_unit);
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    for (var binding_id: usize = 0; binding_id < context->callables.binding_count(); binding_id += 1) {
        let binding: domain::Binding = bindings[binding_id];
        let owner_matches: bool = binding.module_id == module_id && binding.owner_type == owner_type;
        let name_matches: bool = context::tokens_equal(
            context, unit_index, name_token, binding.declaration_unit, binding.name_token);
        if (owner_matches && name_matches) {
            return binding_id;
        }
    }
    return context::no_id();
}

fn lookup_constructor_binding(context: *context::Context, owner_type: usize) -> usize {
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    let functions: *const domain::Function = context->callables.function_data() as
            *const domain::Function;
    for (var binding_id: usize = 0; binding_id < context->callables.binding_count(); binding_id += 1) {
        let binding: domain::Binding = bindings[binding_id];
        if (binding.owner_type != owner_type || binding.candidate_count == 0) {
            continue;
        }
        for (var index: usize = 0; index < binding.candidate_count; index += 1) {
            let function_id: usize = binding_candidate(context, binding_id, index);
            if (functions[function_id].identity.kind == domain::CallableKind.constructor) {
                return binding_id;
            }
        }
    }
    return context::no_id();
}

fn find_imported_binding(context: *context::Context, unit_index: usize, name_token: usize) -> usize {
    let none: usize = context::no_id();
    let module_id: usize = context->symbols.unit_module(context, unit_index);
    let interface_scope: bool = context->symbols.unit_is_interface(context, unit_index);
    let modules: *const context::Module = context->symbols.module_data() as
            *const context::Module;
    let imports: *const context::Import = context->symbols.import_data() as
            *const context::Import;
    var found: usize = none;
    for (var import_index: usize = 0; import_index < modules[module_id].import_count; import_index += 1) {
        let import_record: context::Import = imports[modules[module_id].first_import + import_index];
        let import_is_visible: bool = !interface_scope || import_record.interface_import;
        let name_is_bound: bool = context->symbols.import_binds_name(context, import_record, unit_index, name_token);
        if (import_is_visible && name_is_bound) {
            let binding_id: usize = find_module_binding(context, unit_index, import_record.target_module, name_token);
            let binding_conflicts: bool = found != none && found != binding_id;
            if (binding_id != none && binding_conflicts) {
                let bindings: *const domain::Binding = context->callables.binding_data() as
                        *const domain::Binding;
                context::add_diagnostic(
                    context, context::DiagnosticKind.ambiguous_import, unit_index,
                    context::token(context, unit_index, name_token).span, bindings[found].declaration_unit,
                    context::token(context, bindings[found].declaration_unit, bindings[found].name_token).span,
                    binding_id);
                return none;
            }
            if (binding_id != none) {
                found = binding_id;
            }
        }
    }
    return found;
}

fn lookup_callable_binding(context: *context::Context, unit_index: usize, name_token: usize) -> usize {
    let module_id: usize = context->symbols.unit_module(context, unit_index);
    let local: usize = find_module_binding(context, unit_index, module_id, name_token);
    if (local != context::no_id()) {
        return local;
    }
    return find_imported_binding(context, unit_index, name_token);
}

fn lookup_qualified_callable_binding(
    context: *context::Context, unit_index: usize, path: syntax::SyntaxNode, diagnose: bool) -> usize {
    let none: usize = context::no_id();
    if (path.child_count == 0) {
        return lookup_callable_binding(context, unit_index, path.token_index);
    }
    if (path.child_count > 1) {
        if (diagnose) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_qualified_path, unit_index, path.span,
                none, context::empty_span(), path.token_index);
        }
        return none;
    }
    let qualifier: syntax::SyntaxNode = context::node(context, unit_index, path.first_child);
    let target_result: context::LookupResult = diagnose ? context->symbols.resolve_module_qualifier(
            context, unit_index, qualifier.token_index, qualifier.span) :
        context->symbols.find_qualifier_target(context, unit_index, qualifier.token_index);
    let target: usize = target_result.value;
    if (target == none) {
        return none;
    }
    let binding_id: usize = find_module_binding(context, unit_index, target, path.token_index);
    if (binding_id == none && diagnose) {
        let modules: *const context::Module = context->symbols.module_data() as
                *const context::Module;
        context::add_diagnostic(
            context, context::DiagnosticKind.unknown_qualified_name, unit_index, path.span, modules[target].name_unit,
            context::node(context, modules[target].name_unit, modules[target].name_node).span, path.token_index);
    }
    return binding_id;
}

fn binding_single_function(context: *context::Context, binding_id: usize, unit_index: usize) -> usize {
    if (binding_id >= context->callables.binding_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    let binding: domain::Binding = bindings[binding_id];
    if (!binding_range_is_valid(context, binding)) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let candidates: *const usize = context->callables.candidate_data() as
            *const usize;
    var found: usize = context::no_id();
    for (var index: usize = 0; index < binding.candidate_count; index += 1) {
        let function_id: usize = candidates[binding.first_candidate + index];
        if (candidate_is_visible_in_module(context, function_id, unit_index, binding.module_id)) {
            if (found != context::no_id()) {
                return context::no_id();
            }
            found = function_id;
        }
    }
    return found;
}

fn binding_candidate(context: *context::Context, binding_id: usize, candidate_index: usize) -> usize {
    if (binding_id >= context->callables.binding_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    let binding: domain::Binding = bindings[binding_id];
    if (!binding_range_is_valid(context, binding) || candidate_index >= binding.candidate_count) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let candidates: *const usize = context->callables.candidate_data() as
            *const usize;
    let function_id: usize = candidates[binding.first_candidate + candidate_index];
    if (function_id >= context->callables.function_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    return function_id;
}

fn generic_binding_candidate(context: *context::Context, binding_id: usize, candidate_index: usize) -> usize {
    if (binding_id >= context->callables.binding_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as *const domain::Binding;
    let binding: domain::Binding = bindings[binding_id];
    if (!binding_range_is_valid(context, binding) || candidate_index >= binding.generic_candidate_count) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let candidates: *const usize = context->callables.generic_candidate_data() as *const usize;
    let generic_id: usize = candidates[binding.first_generic_candidate + candidate_index];
    if (generic_id >= context->generics.declaration_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    return generic_id;
}

fn binding_visible_count(context: *context::Context, binding_id: usize, unit_index: usize) -> usize {
    if (binding_id >= context->callables.binding_count()) {
        context->error = runtime::Error.invalid_argument;
        return 0;
    }
    let bindings: *const domain::Binding = context->callables.binding_data() as
            *const domain::Binding;
    let binding: domain::Binding = bindings[binding_id];
    if (!binding_range_is_valid(context, binding)) {
        context->error = runtime::Error.invalid_argument;
        return 0;
    }
    var count: usize = 0;
    for (var candidate_index: usize = 0; candidate_index < binding.candidate_count; candidate_index += 1) {
        let function_id: usize = binding_candidate(context, binding_id, candidate_index);
        if (function_is_visible(context, function_id, unit_index)) {
            count += 1;
        }
    }
    return count;
}

fn ordered_function_id(context: *context::Context, index: usize) -> usize {
    if (index >= context->callables.candidate_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    let candidates: *const usize = context->callables.candidate_data() as
            *const usize;
    let function_id: usize = candidates[index];
    if (function_id >= context->callables.function_count()) {
        context->error = runtime::Error.invalid_argument;
        return context::no_id();
    }
    return function_id;
}
