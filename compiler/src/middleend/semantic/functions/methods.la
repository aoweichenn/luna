module luna.bootstrap.middleend.semantic.functions;

struct IdentityResult {
    identity: callable::Identity;
    valid: bool;
}

fn method_diagnostic(
    context: *context::Context, kind: context::DiagnosticKind, unit_index: usize,
    declaration: syntax::SyntaxNode, owner_type: usize) {
    var related_unit: usize = context::no_id();
    var related_span: lexer::SourceSpan = context::empty_span();
    if (owner_type < context->types.type_count) {
        let owner: type_info::Record = context::type_record(context, owner_type);
        related_unit = owner.declaration_unit;
        related_span = context::node(context, owner.declaration_unit, owner.declaration_node).span;
    }
    context::add_diagnostic(context, kind, unit_index, declaration.span, related_unit, related_span, owner_type);
}

fn receiver_kind(declaration: syntax::SyntaxNode) -> callable::ReceiverKind {
    let read_only: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.read_only);
    let volatile_access: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.volatile_);
    if (volatile_access) {
        return read_only ? callable::ReceiverKind.read_only_volatile : callable::ReceiverKind.writable_volatile;
    }
    return read_only ? callable::ReceiverKind.read_only : callable::ReceiverKind.writable;
}

fn receiver_is_qualified(declaration: syntax::SyntaxNode) -> bool {
    let read_only: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.read_only);
    let volatile_access: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.volatile_);
    return read_only || volatile_access;
}

fn method_identity(
    context: *context::Context, owner_type: usize, unit_index: usize,
    declaration: syntax::SyntaxNode) -> IdentityResult {
    let static_method: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.static_method);
    let constructor: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.constructor);
    let destructor: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.destructor);
    let operator_method: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.operator_method);
    if (static_method) {
        let invalid_lifecycle: bool = constructor || destructor;
        if (invalid_lifecycle || receiver_is_qualified(declaration)) {
            method_diagnostic(context, context::DiagnosticKind.invalid_receiver, unit_index, declaration, owner_type);
            return {identity = callable::free_function(), valid = false};
        }
        return {
            identity = {
                kind = callable::Kind.static_method, owner_type = owner_type, receiver = callable::ReceiverKind.none,
            }, valid = true,
        };
    }
    let lifecycle_method: bool = constructor || destructor;
    if (lifecycle_method && receiver_is_qualified(declaration)) {
        method_diagnostic(context, context::DiagnosticKind.invalid_receiver, unit_index, declaration, owner_type);
        return {identity = callable::free_function(), valid = false};
    }
    return {
        identity = {
            kind = constructor ? callable::Kind.constructor : destructor ? callable::Kind.destructor :
                (operator_method ? callable::Kind.operator_method : callable::Kind.instance_method),
            owner_type = owner_type, receiver = lifecycle_method ?
                callable::ReceiverKind.writable : receiver_kind(declaration),
        }, valid = true,
    };
}

fn constructor_return_is_valid(
    context: *context::Context, owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    if (!declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.constructor)) {
        return true;
    }
    var parameter_count: usize = 0;
    var return_node: usize = context::no_id();
    var body_node: usize = context::no_id();
    if (!function_parts(context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    if (return_node == context::no_id()) {
        return true;
    }
    method_diagnostic(context, context::DiagnosticKind.invalid_method, unit_index, declaration, owner_type);
    return false;
}

fn node_contains_return(context: *context::Context, unit_index: usize, node_id: usize, depth: usize) -> bool {
    if (depth >= context::Limit.maximum_type_depth as usize) {
        return true;
    }
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_id);
    if (node.kind == syntax::SyntaxKind.return_statement) {
        return true;
    }
    for (var child: usize = node.first_child; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        if (node_contains_return(context, unit_index, child, depth + 1)) {
            return true;
        }
    }
    return false;
}

fn destructor_contract_is_valid(
    context: *context::Context, owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    if (!declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.destructor)) {
        return true;
    }
    var parameter_count: usize = 0;
    var return_node: usize = context::no_id();
    var body_node: usize = context::no_id();
    let parts_are_valid: bool = function_parts(
        context, unit_index, declaration, &parameter_count, &return_node, &body_node);
    let generic: bool = generics::is_generic(context, unit_index, declaration);
    let defaults: bool = method_has_defaults(context, unit_index, declaration);
    let virtual_flags: usize = (syntax::SyntaxFlag.virtual_method as usize) |
        (syntax::SyntaxFlag.abstract_method as usize) | (syntax::SyntaxFlag.override_method as usize) |
        (syntax::SyntaxFlag.final_method as usize);
    let direct: bool = (declaration.flags & virtual_flags) == 0;
    let signature_is_valid: bool = parameter_count == 0 && return_node == context::no_id();
    let body_is_valid: bool = body_node == context::no_id() || !node_contains_return(context, unit_index, body_node, 0);
    let contract_is_valid: bool = parts_are_valid && signature_is_valid;
    let surface_is_valid: bool = !generic && !defaults;
    let declaration_is_valid: bool = contract_is_valid && surface_is_valid;
    let implementation_is_valid: bool = body_is_valid && direct;
    if (!declaration_is_valid || !implementation_is_valid) {
        method_diagnostic(context, context::DiagnosticKind.invalid_destructor, unit_index, declaration, owner_type);
        return false;
    }
    return true;
}

fn node_is_super_init_call(context: *context::Context, unit_index: usize, node_id: usize) -> bool {
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_id);
    if (node.kind != syntax::SyntaxKind.call_expression || node.child_count == 0) {
        return false;
    }
    let callee: syntax::SyntaxNode = context::node(context, unit_index, node.first_child);
    if (callee.kind != syntax::SyntaxKind.member_expression || callee.child_count != 2) {
        return false;
    }
    let base: syntax::SyntaxNode = context::node(context, unit_index, callee.first_child);
    let member: syntax::SyntaxNode = context::node(context, unit_index, base.next_sibling);
    let super_base: bool = base.kind == syntax::SyntaxKind.super_expression;
    let init_member: bool = context::token_equals_bytes(context, unit_index, member.token_index, "init", 4);
    return super_base && init_member;
}

fn count_super_init_calls(context: *context::Context, unit_index: usize, node_id: usize, depth: usize) -> usize {
    if (depth >= context::Limit.maximum_type_depth as usize) {
        return 0;
    }
    var count: usize = node_is_super_init_call(context, unit_index, node_id) ? 1 : 0;
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_id);
    for (var child: usize = node.first_child; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        count += count_super_init_calls(context, unit_index, child, depth + 1);
    }
    return count;
}

fn first_statement_calls_super_init(context: *context::Context, unit_index: usize, body_id: usize) -> bool {
    let body: syntax::SyntaxNode = context::node(context, unit_index, body_id);
    if (body.child_count == 0) {
        return false;
    }
    let statement: syntax::SyntaxNode = context::node(context, unit_index, body.first_child);
    if (statement.kind != syntax::SyntaxKind.expression_statement || statement.child_count != 1) {
        return false;
    }
    return node_is_super_init_call(context, unit_index, statement.first_child);
}

fn base_constructor_call_is_valid(
    context: *context::Context, owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    if (!declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.constructor)) {
        return true;
    }
    if (classes::base_type(context, owner_type) == context::no_id()) {
        return true;
    }
    var parameter_count: usize = 0;
    var return_node: usize = context::no_id();
    var body_node: usize = context::no_id();
    if (!function_parts(context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    let first_call_is_valid: bool = body_node != context::no_id() &&
        first_statement_calls_super_init(context, unit_index, body_node);
    let call_count: usize = body_node == context::no_id() ?
        0 : count_super_init_calls(context, unit_index, body_node, 0);
    if (!first_call_is_valid || call_count != 1) {
        method_diagnostic(context, context::DiagnosticKind.invalid_super, unit_index, declaration, owner_type);
        return false;
    }
    return true;
}

fn class_method_access_is_valid(declaration: syntax::SyntaxNode) -> bool {
    let access: class_model::Access = classes::access_from_flags(declaration.flags);
    return access == class_model::Access.public_access || access == class_model::Access.protected_access;
}

fn method_has_defaults(context: *context::Context, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    for (var child: usize = declaration.first_child; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        let parameter: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (parameter.kind != syntax::SyntaxKind.parameter) {
            return false;
        }
        if (parameter.child_count == 2) {
            return true;
        }
    }
    return false;
}

fn operator_is_comparison(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.equal_equal, lexer::TokenKind.bang_equal, lexer::TokenKind.less, lexer::TokenKind.less_equal,
        lexer::TokenKind.greater, lexer::TokenKind.greater_equal {
        return true;
    }
    default {
        return false;
    }
    }
}

fn unary_operator_is_valid(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.minus, lexer::TokenKind.bang, lexer::TokenKind.tilde {
        return true;
    }
    default {
        return false;
    }
    }
}

fn binary_operator_is_valid(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.plus, lexer::TokenKind.minus,
        lexer::TokenKind.star, lexer::TokenKind.slash, lexer::TokenKind.percent,
        lexer::TokenKind.ampersand, lexer::TokenKind.pipe, lexer::TokenKind.caret,
        lexer::TokenKind.shift_left, lexer::TokenKind.shift_right, lexer::TokenKind.equal {
        return true;
    }
    default {
        return operator_is_comparison(kind);
    }
    }
}

fn operator_method_is_valid(
    context: *context::Context, owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    if (!declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.operator_method)) {
        return true;
    }
    let forbidden_flags: usize = (syntax::SyntaxFlag.static_method as usize) |
        (syntax::SyntaxFlag.constructor as usize) | (syntax::SyntaxFlag.virtual_method as usize) |
        (syntax::SyntaxFlag.abstract_method as usize) | (syntax::SyntaxFlag.override_method as usize) |
        (syntax::SyntaxFlag.final_method as usize) | (syntax::SyntaxFlag.private_access as usize);
    var parameter_count: usize = 0;
    var return_node: usize = context::no_id();
    var body_node: usize = context::no_id();
    let parts_are_valid: bool = function_parts(
        context, unit_index, declaration, &parameter_count, &return_node, &body_node);
    let operator_kind: lexer::TokenKind = context::token(context, unit_index, declaration.token_index).kind;
    let assignment: bool = operator_kind == lexer::TokenKind.equal;
    let arity_is_valid: bool = parameter_count == 0 ? unary_operator_is_valid(operator_kind) :
        parameter_count == 1 && binary_operator_is_valid(operator_kind);
    let form_is_valid: bool = parts_are_valid && (declaration.flags & forbidden_flags) == 0;
    let defaults_are_absent: bool = !method_has_defaults(context, unit_index, declaration);
    let declaration_is_valid: bool = form_is_valid && arity_is_valid;
    let return_is_valid: bool = assignment ? return_node == context::no_id() : return_node != context::no_id();
    let signature_is_valid: bool = defaults_are_absent && return_is_valid;
    if (!declaration_is_valid || !signature_is_valid) {
        method_diagnostic(
            context, context::DiagnosticKind.invalid_operator_method, unit_index, declaration, owner_type);
        return false;
    }
    if (assignment) {
        return true;
    }
    let result_type: usize = types::resolve_type_node(context, unit_index, return_node);
    let requires_boolean: bool = operator_kind == lexer::TokenKind.bang || operator_is_comparison(operator_kind);
    if (requires_boolean && result_type != type_info::BuiltinType.boolean as usize) {
        method_diagnostic(
            context, context::DiagnosticKind.invalid_operator_method, unit_index, declaration, owner_type);
        return false;
    }
    return true;
}

fn next_constructor_initializer(context: *context::Context, unit_index: usize, child: usize) -> usize {
    var current: usize = child;
    for (; current != context::no_id();
        current = context::node(context, unit_index, current).next_sibling) {
        if (context::node(context, unit_index, current).kind == syntax::SyntaxKind.constructor_initializer) {
            return current;
        }
    }
    return context::no_id();
}

fn initializer_expression_is_valid(
    context: *context::Context, unit_index: usize, node_id: usize, depth: usize) -> bool {
    if (depth >= context::Limit.maximum_type_depth as usize) {
        return false;
    }
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_id);
    if (node.kind == syntax::SyntaxKind.this_expression || node.kind == syntax::SyntaxKind.super_expression) {
        return false;
    }
    for (var child: usize = node.first_child; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        if (!initializer_expression_is_valid(context, unit_index, child, depth + 1)) {
            return false;
        }
    }
    return true;
}

fn class_array_initializer_is_complete(
    context: *context::Context, unit_index: usize, type_id: usize, value_id: usize, depth: usize) -> bool {
    if (depth >= context::Limit.maximum_type_depth as usize) {
        return false;
    }
    let record: type_info::Record = context::type_record(context, type_id);
    if (record.kind != type_info::Kind.array) {
        return record.kind == type_info::Kind.class_type;
    }
    if (!classes::type_contains_class_value(context, type_id)) {
        return true;
    }
    let value: syntax::SyntaxNode = context::node(context, unit_index, value_id);
    if (value.kind == syntax::SyntaxKind.zero_initializer) {
        return false;
    }
    if (value.kind != syntax::SyntaxKind.aggregate_initializer) {
        return true;
    }
    if (value.child_count != record.element_count) {
        return false;
    }
    for (var child: usize = value.first_child; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        let element: syntax::SyntaxNode = context::node(context, unit_index, child);
        let indexed: bool = (element.flags & (syntax::SyntaxFlag.indexed as usize)) != 0;
        if (element.kind != syntax::SyntaxKind.initializer_element || indexed) {
            return false;
        }
        if (element.child_count != 1 || !class_array_initializer_is_complete(
                context, unit_index, record.element_type, element.first_child, depth + 1)) {
            return false;
        }
    }
    return true;
}

fn report_member_initializer(
    context: *context::Context, unit_index: usize, span: lexer::SourceSpan, field: type_info::Field, detail: usize) {
    context::add_diagnostic(
        context, context::DiagnosticKind.invalid_member_initializer, unit_index, span,
        field.declaration_unit, context::node(context, field.declaration_unit, field.declaration_node).span, detail);
}

fn constructor_initializers_are_valid(
    context: *context::Context, owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    let first_initializer: usize = next_constructor_initializer(context, unit_index, declaration.first_child);
    let constructor: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.constructor);
    let bodyless: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.bodyless);
    if (!constructor || bodyless) {
        if (first_initializer != context::no_id()) {
            method_diagnostic(
                context, context::DiagnosticKind.invalid_member_initializer, unit_index, declaration, owner_type);
            return false;
        }
        return true;
    }
    let owner: type_info::Record = context::type_record(context, owner_type);
    let fields: *const type_info::Field = context->types.fields.data as *const type_info::Field;
    var initializer_id: usize = first_initializer;
    var valid: bool = true;
    for (var index: usize = 0; index < owner.field_count; index += 1) {
        let field: type_info::Field = fields[owner.first_field + index];
        var initializer_matches: bool = false;
        var initializer: syntax::SyntaxNode = {};
        if (initializer_id != context::no_id()) {
            initializer = context::node(context, unit_index, initializer_id);
            initializer_matches = context::tokens_equal(
                context, unit_index, initializer.token_index, field.declaration_unit, field.name_token);
        }
        if (initializer_matches) {
            let expression_is_valid: bool = initializer.child_count == 1 &&
                initializer_expression_is_valid(context, unit_index, initializer.first_child, 0);
            let storage_is_complete: bool = !classes::type_contains_class_value(context, field.type_id) ||
                class_array_initializer_is_complete(context, unit_index, field.type_id, initializer.first_child, 0);
            if (!expression_is_valid || !storage_is_complete) {
                report_member_initializer(context, unit_index, initializer.span, field, owner.first_field + index);
                valid = false;
            }
            initializer_id = next_constructor_initializer(context, unit_index, initializer.next_sibling);
        } else if (classes::type_contains_class_value(context, field.type_id)) {
            report_member_initializer(context, unit_index, declaration.span, field, owner.first_field + index);
            valid = false;
        }
    }
    if (initializer_id != context::no_id()) {
        let initializer: syntax::SyntaxNode = context::node(context, unit_index, initializer_id);
        method_diagnostic(
            context, context::DiagnosticKind.invalid_member_initializer, unit_index, initializer, owner_type);
        valid = false;
    }
    return valid;
}

fn method_form_is_valid(
    context: *context::Context, owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    let variadic: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.variadic);
    let virtual_flags: usize = (syntax::SyntaxFlag.virtual_method as usize) |
        (syntax::SyntaxFlag.abstract_method as usize) | (syntax::SyntaxFlag.override_method as usize);
    let virtual_contract: bool = (declaration.flags & virtual_flags) != 0;
    let invalid_defaults: bool = virtual_contract && method_has_defaults(context, unit_index, declaration);
    if (variadic || invalid_defaults) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method, unit_index, declaration, owner_type);
        return false;
    }
    let operator_is_valid: bool = operator_method_is_valid(context, owner_type, unit_index, declaration);
    let initializers_are_valid: bool = constructor_initializers_are_valid(context, owner_type, unit_index, declaration);
    return operator_is_valid && initializers_are_valid;
}

fn mark_member_exported(context: *context::Context, function_id: usize) {
    if (function_id == context::no_id()) {
        return;
    }
    var functions: *context::Function = context->functions.data as
            *context::Function;
    let symbol_id: usize = functions[function_id].symbol_id;
    functions[function_id].flags |= context::SymbolFlag.member_exported as usize;
    let symbols: *context::Symbol = context->symbols.data as
            *context::Symbol;
    symbols[symbol_id].flags |= context::SymbolFlag.member_exported as usize;
}

fn collect_declared_method(
    context: *context::Context, module_id: usize, owner_type: usize, unit_index: usize,
    declaration_id: usize, declaration: syntax::SyntaxNode) {
    if (!class_method_access_is_valid(declaration) ||
        !declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.bodyless)) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method, unit_index, declaration, owner_type);
        return;
    }
    if (!method_form_is_valid(context, owner_type, unit_index, declaration)) {
        return;
    }
    let identity: IdentityResult = method_identity(context, owner_type, unit_index, declaration);
    let lifecycle_is_valid: bool = constructor_return_is_valid(context, owner_type, unit_index, declaration) &&
        destructor_contract_is_valid(context, owner_type, unit_index, declaration);
    if (!identity.valid || !lifecycle_is_valid) {
        return;
    }
    collect_function_declaration(
        context, identity.identity, module_id, unit_index, declaration_id, declaration, true, context::no_id());
    let owner: type_info::Record = context::type_record(context, owner_type);
    let exported_owner: bool = (owner.flags & (type_info::Flag.exported as usize)) != 0;
    if (exported_owner && !type_info::is_opaque_class(owner)) {
        let lookup: FunctionDeclarationLookup =
            lookup_function_declaration(context, identity.identity, module_id, unit_index, declaration);
        mark_member_exported(context, lookup.overload);
    }
}

fn collect_class_declaration_methods(
    context: *context::Context, module_id: usize, owner_type: usize, record: type_info::Record) {
    let declaration: syntax::SyntaxNode = context::node(context, record.declaration_unit, record.declaration_node);
    for (var child: usize = declaration.first_child; child != context::no_id();
        child = context::node(context, record.declaration_unit, child).next_sibling) {
        let member: syntax::SyntaxNode = context::node(context, record.declaration_unit, child);
        if (member.kind == syntax::SyntaxKind.function_declaration) {
            if (generics::is_generic(context, record.declaration_unit, member)) {
                method_diagnostic(
                    context, context::DiagnosticKind.invalid_generic_use, record.declaration_unit, member, owner_type);
                continue;
            }
            collect_declared_method(context, module_id, owner_type, record.declaration_unit, child, member);
        }
    }
}

fn impl_owner_type(
    context: *context::Context, module_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> usize {
    if (declaration.child_count == 0) {
        return context::no_id();
    }
    let owner_type: usize = types::resolve_type_node(context, unit_index, declaration.first_child);
    if (owner_type == context::no_id()) {
        return owner_type;
    }
    let owner: type_info::Record = context::type_record(context, owner_type);
    let owner_module: usize = names::unit_module(context, owner.declaration_unit);
    if (owner.kind != type_info::Kind.class_type || owner_module != module_id) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method_definition, unit_index, declaration,
            owner_type);
        return context::no_id();
    }
    return owner_type;
}

fn collect_defined_method(
    context: *context::Context, module_id: usize, owner_type: usize, unit_index: usize,
    declaration_id: usize, declaration: syntax::SyntaxNode) {
    if (declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.bodyless)) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method_definition, unit_index, declaration,
            owner_type);
        return;
    }
    if (!method_form_is_valid(context, owner_type, unit_index, declaration)) {
        return;
    }
    let identity: IdentityResult = method_identity(context, owner_type, unit_index, declaration);
    let constructor_is_valid: bool = constructor_return_is_valid(context, owner_type, unit_index, declaration) &&
        base_constructor_call_is_valid(context, owner_type, unit_index, declaration);
    let lifecycle_is_valid: bool = constructor_is_valid &&
        destructor_contract_is_valid(context, owner_type, unit_index, declaration);
    if (!identity.valid || !lifecycle_is_valid) {
        return;
    }
    let lookup: FunctionDeclarationLookup =
        lookup_function_declaration(context, identity.identity, module_id, unit_index, declaration);
    let private_method: bool = declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.private_access);
    if (private_method && declaration_has_syntax_flag(declaration, syntax::SyntaxFlag.constructor)) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method_definition, unit_index, declaration,
            owner_type);
        return;
    }
    let declaration_is_invalid: bool = private_method ? lookup.overload != context::no_id() :
        lookup.overload == context::no_id();
    if (declaration_is_invalid) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method_definition, unit_index, declaration,
            owner_type);
        return;
    }
    if (lookup.overload != context::no_id()) {
        let functions: *const context::Function = context->functions.data as
                *const context::Function;
        let abstract_method: bool = (functions[lookup.overload].flags &
                (context::SymbolFlag.abstract_method as usize)) != 0;
        if (abstract_method) {
            method_diagnostic(
                context, context::DiagnosticKind.invalid_method_definition, unit_index, declaration, owner_type);
            return;
        }
    }
    collect_function_declaration(
        context, identity.identity, module_id, unit_index, declaration_id, declaration, false, context::no_id());
}

fn collect_impl_methods(
    context: *context::Context, module_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) {
    let invalid_flags: usize = (syntax::SyntaxFlag.exported as usize) | (syntax::SyntaxFlag.external as usize);
    let declaration_is_invalid: bool = (declaration.flags & invalid_flags) != 0;
    if (declaration.child_count != 0) {
        let generic_node: syntax::SyntaxNode = context::node(context, unit_index, declaration.first_child);
        let generic_owner: usize = names::lookup_qualified_symbol(
            context, unit_index, generic_node, context::SymbolKind.generic_type, false);
        if (generic_owner != context::no_id()) {
            for (var child: usize = generic_node.next_sibling; child != context::no_id();
                child = context::node(context, unit_index, child).next_sibling) {
                let method_node: syntax::SyntaxNode = context::node(context, unit_index, child);
                let generic_method: bool = method_node.kind == syntax::SyntaxKind.function_declaration &&
                    generics::is_generic(context, unit_index, method_node);
                if (generic_method) {
                    method_diagnostic(
                        context, context::DiagnosticKind.invalid_generic_use, unit_index, method_node, generic_owner);
                }
            }
            return;
        }
    }
    if (names::unit_is_interface(context, unit_index) || declaration_is_invalid) {
        method_diagnostic(context, context::DiagnosticKind.invalid_method_definition, unit_index, declaration,
            context::no_id());
        return;
    }
    let owner_type: usize = impl_owner_type(context, module_id, unit_index, declaration);
    if (owner_type == context::no_id()) {
        return;
    }
    let owner_node: syntax::SyntaxNode = context::node(context, unit_index, declaration.first_child);
    for (var child: usize = owner_node.next_sibling; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        let method_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (method_node.kind == syntax::SyntaxKind.function_declaration) {
            collect_defined_method(context, module_id, owner_type, unit_index, child, method_node);
        }
    }
}

fn generic_impl_matches(
    context: *context::Context, generic_id: usize, unit_index: usize, declaration: syntax::SyntaxNode) -> bool {
    if (declaration.kind != syntax::SyntaxKind.impl_declaration || declaration.child_count == 0) {
        return false;
    }
    let owner: syntax::SyntaxNode = context::node(context, unit_index, declaration.first_child);
    let symbol_id: usize = names::lookup_qualified_symbol(
        context, unit_index, owner, context::SymbolKind.generic_type, false);
    if (symbol_id == context::no_id()) {
        return false;
    }
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    return symbols[symbol_id].type_id == generic_id;
}

fn collect_generic_impl(
    context: *context::Context, generic_id: usize, module_id: usize,
    owner_type: usize, unit_index: usize, declaration: syntax::SyntaxNode) {
    if (!generic_impl_matches(context, generic_id, unit_index, declaration)) {
        return;
    }
    let owner: syntax::SyntaxNode = context::node(context, unit_index, declaration.first_child);
    for (var child: usize = owner.next_sibling; child != context::no_id();
        child = context::node(context, unit_index, child).next_sibling) {
        let method_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        if (method_node.kind != syntax::SyntaxKind.function_declaration) {
            continue;
        }
        if (generics::is_generic(context, unit_index, method_node)) {
            method_diagnostic(
                context, context::DiagnosticKind.invalid_generic_use, unit_index, method_node, owner_type);
            continue;
        }
        collect_defined_method(context, module_id, owner_type, unit_index, child, method_node);
    }
}

fn collect_generic_impls_in_unit(
    context: *context::Context, generic_id: usize, module_id: usize, owner_type: usize, unit_index: usize) {
    if (unit_index == context::no_id()) {
        return;
    }
    for (var declaration_id: usize = names::first_declaration(context, unit_index);
        declaration_id != context::no_id() && context->error == runtime::Error.none;
        declaration_id = context::node(context, unit_index, declaration_id).next_sibling) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        collect_generic_impl(context, generic_id, module_id, owner_type, unit_index, declaration);
    }
}

fn instantiate_generic_class(context: *context::Context, type_id: usize) -> bool {
    let instance_id: usize = generic_model::instance_for_type(context->generics, type_id);
    if (instance_id == context::no_id()) {
        return true;
    }
    let existing_functions: *const context::Function = context->functions.data as *const context::Function;
    for (var function_id: usize = 0; function_id < context->function_count; function_id += 1) {
        if (existing_functions[function_id].identity.owner_type == type_id) {
            return true;
        }
    }
    if (!classes::prepare_generic_class(context, type_id)) {
        return false;
    }
    let mark: usize = generics::activate_instance(context, instance_id);
    if (mark == context::no_id()) {
        return false;
    }
    let instances: *const generic_model::Instance = context->generics.instances.data as
            *const generic_model::Instance;
    let declarations: *const generic_model::Declaration = context->generics.declarations.data as
            *const generic_model::Declaration;
    let declaration: generic_model::Declaration = declarations[instances[instance_id].declaration_id];
    let generic_id: usize = instances[instance_id].declaration_id;
    let module_id: usize = declaration.module_id;
    let type_record: type_info::Record = context::type_record(context, type_id);
    let first_function: usize = context->function_count;
    collect_class_declaration_methods(context, module_id, type_id, type_record);
    let modules: *const context::Module = context->modules.data as *const context::Module;
    collect_generic_impls_in_unit(context, generic_id, module_id, type_id, modules[module_id].interface_unit);
    for (var index: usize = 0; index < modules[module_id].implementation_count; index += 1) {
        collect_generic_impls_in_unit(
            context, generic_id, module_id, type_id, names::module_implementation_unit(context, module_id, index));
    }
    for (var function_id: usize = first_function;
        function_id < context->function_count && context->error == runtime::Error.none;
        function_id += 1) {
        let functions_data: *const context::Function = context->functions.data as *const context::Function;
        if (functions_data[function_id].identity.owner_type != type_id) {
            continue;
        }
        context->error = generic_model::map_function_instance(&context->generics, function_id, instance_id);
        if (context->error == runtime::Error.none) {
            build_instance_signature(context, function_id);
        }
    }
    if (context->error == runtime::Error.none) {
        bind_function_instances(context, first_function, type_id);
    }
    if (context->error == runtime::Error.none) {
        classes::collect_generic_methods(context, type_id);
    }
    let restored: bool = generics::restore_active_bindings(context, mark);
    return restored && context->error == runtime::Error.none;
}

fn destructor(context: *context::Context, owner_type: usize) -> usize {
    let functions_data: *const context::Function = context->functions.data as *const context::Function;
    for (var function_id: usize = 0; function_id < context->function_count; function_id += 1) {
        let identity: callable::Identity = functions_data[function_id].identity;
        if (identity.kind == callable::Kind.destructor && identity.owner_type == owner_type) {
            return function_id;
        }
    }
    return context::no_id();
}

fn collect_impl_blocks_in_unit(context: *context::Context, module_id: usize, unit_index: usize) {
    if (unit_index == context::no_id()) {
        return;
    }
    for (var declaration_id: usize = names::first_declaration(context, unit_index);
        declaration_id != context::no_id() && context->error == runtime::Error.none;
        declaration_id = context::node(context, unit_index, declaration_id).next_sibling) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        if (declaration.kind == syntax::SyntaxKind.impl_declaration) {
            collect_impl_methods(context, module_id, unit_index, declaration);
        }
    }
}

fn collect_class_methods(context: *context::Context) -> bool {
    let records: *const class_model::Record = context->classes.records.data as
            *const class_model::Record;
    for (var record_id: usize = 0;
        record_id < context->classes.record_count && context->error == runtime::Error.none;
        record_id += 1) {
        let owner_type: usize = records[record_id].type_id;
        let generic_instance: usize = generic_model::instance_for_type(context->generics, owner_type);
        if (generic_instance != context::no_id()) {
            continue;
        }
        let type_record: type_info::Record = context::type_record(context, owner_type);
        collect_class_declaration_methods(
            context, names::unit_module(context, type_record.declaration_unit), owner_type, type_record);
    }
    let modules: *const context::Module = context->modules.data as
            *const context::Module;
    for (var module_id: usize = 0;
        module_id < context->module_count && context->error == runtime::Error.none;
        module_id += 1) {
        collect_impl_blocks_in_unit(context, module_id, modules[module_id].interface_unit);
        for (var index: usize = 0; index < modules[module_id].implementation_count; index += 1) {
            collect_impl_blocks_in_unit(
                context, module_id, names::module_implementation_unit(context, module_id, index));
        }
    }
    return context->error == runtime::Error.none;
}
