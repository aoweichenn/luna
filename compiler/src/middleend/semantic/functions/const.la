module luna.bootstrap.middleend.semantic.functions;

fn append_const_function(context: *context::Context, record: context::ConstFunction) -> usize {
    let result: usize = context->const_function_count;
    if (!names::append_record(
            context, &context->const_functions, (&record) as
                *const context::ConstFunction as *const u8, sizeof(context::ConstFunction))) {
        return context::no_id();
    }
    context->const_function_count += 1;
    return result;
}

fn report_invalid_const_function(context: *context::Context, unit_index: usize, span: lexer::SourceSpan) -> bool {
    return context::add_diagnostic(
        context, context::DiagnosticKind.invalid_const_function, unit_index, span, context::no_id(),
        context::empty_span(), 0);
}

fn const_scalar_type(context: *context::Context, type_id: usize) -> bool {
    var record: type_info::Record = context::type_record(context, type_id);
    if (record.kind == type_info::Kind.alias && types::require_complete_type(context, type_id)) {
        record = context::type_record(context, record.element_type);
    }
    return type_info::is_integer(record.kind) || record.kind == type_info::Kind.boolean;
}

fn validate_const_call(context: *context::Context, unit_index: usize, node: syntax::SyntaxNode) -> bool {
    let none: usize = context::no_id();
    if (node.child_count == 0) {
        return false;
    }
    let callee: syntax::SyntaxNode = context::node(context, unit_index, node.first_child);
    if (callee.kind != syntax::SyntaxKind.name_expression) {
        return false;
    }
    let symbol_id: usize =
        names::lookup_qualified_symbol(context, unit_index, callee, context::SymbolKind.const_function, false);
    if (symbol_id == none) {
        return false;
    }
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    let records: *const context::ConstFunction = context->const_functions.data as
            *const context::ConstFunction;
    if (node.child_count - 1 != records[symbols[symbol_id].function_id].parameter_count) {
        return false;
    }
    var valid: bool = true;
    for (var argument: usize = callee.next_sibling; argument != none && valid;
        argument = context::node(context, unit_index, argument).next_sibling) {
        valid = validate_const_expression(context, unit_index, argument);
    }
    return valid;
}

fn validate_const_expression(context: *context::Context, unit_index: usize, node_index: usize) -> bool {
    let none: usize = context::no_id();
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
    var valid: bool = false;
    switch (node.kind) {
    case syntax::SyntaxKind.integer_expression, syntax::SyntaxKind.character_expression,
        syntax::SyntaxKind.boolean_expression, syntax::SyntaxKind.name_expression {
        valid = true;
    }
    case syntax::SyntaxKind.parenthesized_expression {
        valid = node.child_count == 1 && validate_const_expression(context, unit_index, node.first_child);
    }
    case syntax::SyntaxKind.member_expression {
        if (node.child_count == 2) {
            let owner: syntax::SyntaxNode = context::node(context, unit_index, node.first_child);
            let member: syntax::SyntaxNode = context::node(context, unit_index, owner.next_sibling);
            valid = owner.kind == syntax::SyntaxKind.name_expression &&
                member.kind == syntax::SyntaxKind.name_expression;
        }
    }
    case syntax::SyntaxKind.unary_expression {
        let operation: lexer::TokenKind = context::token(context, unit_index, node.token_index).kind;
        let arithmetic: bool = operation == lexer::TokenKind.minus || operation == lexer::TokenKind.tilde;
        let operation_is_valid: bool = arithmetic || operation == lexer::TokenKind.bang;
        let shape_is_valid: bool = node.child_count == 1 && operation_is_valid;
        valid = shape_is_valid && validate_const_expression(context, unit_index, node.first_child);
    }
    case syntax::SyntaxKind.binary_expression, syntax::SyntaxKind.conditional_expression {
        var operands: bool = true;
        for (var operand: usize = node.first_child; operand != none && operands;
            operand = context::node(context, unit_index, operand).next_sibling) {
            operands = validate_const_expression(context, unit_index, operand);
        }
        valid = operands && node.child_count == (node.kind == syntax::SyntaxKind.binary_expression ? 2 : 3);
    }
    case syntax::SyntaxKind.sizeof_expression, syntax::SyntaxKind.alignof_expression {
        valid = node.child_count == 1;
    }
    case syntax::SyntaxKind.offsetof_expression {
        valid = node.child_count >= 1;
    }
    case syntax::SyntaxKind.cast_expression {
        if (node.child_count == 2 &&
            validate_const_expression(
                context, unit_index, node.first_child)) {
            let target: usize =
                types::resolve_type_node(
                    context, unit_index, context::node(context, unit_index, node.first_child).next_sibling);
            valid = target != none && const_scalar_type(context, target);
        }
    }
    case syntax::SyntaxKind.call_expression {
        valid = validate_const_call(context, unit_index, node);
    }
    default {}
    }
    if (!valid) {
        report_invalid_const_function(context, unit_index, node.span);
    }
    return valid;
}

fn validate_const_statement(context: *context::Context, unit_index: usize, node_index: usize) -> bool {
    let none: usize = context::no_id();
    let node: syntax::SyntaxNode = context::node(context, unit_index, node_index);
    var valid: bool = false;
    switch (node.kind) {
    case syntax::SyntaxKind.block_statement {
        valid = true;
        for (var child: usize = node.first_child; child != none && valid;
            child = context::node(context, unit_index, child).next_sibling) {
            valid = validate_const_statement(context, unit_index, child);
        }
        return valid;
    }
    case syntax::SyntaxKind.variable_declaration, syntax::SyntaxKind.const_declaration {
        if (node.child_count == 2 && (node.flags & ((syntax::SyntaxFlag.inferred_type as usize) |
                    (syntax::SyntaxFlag.volatile_ as usize))) == 0) {
            let type_id: usize = types::resolve_type_node(context, unit_index, node.first_child);
            valid = type_id != none && const_scalar_type(context, type_id) &&
                validate_const_expression(
                    context, unit_index, context::node(context, unit_index, node.first_child).next_sibling);
        }
    }
    case syntax::SyntaxKind.assignment_statement {
        let assignment: lexer::TokenKind = context::token(context, unit_index, node.token_index).kind;
        let target: syntax::SyntaxNode = context::node(context, unit_index, node.first_child);
        let shape_is_valid: bool = node.child_count == 2 && assignment == lexer::TokenKind.equal;
        let target_is_valid: bool = target.kind == syntax::SyntaxKind.name_expression;
        if (shape_is_valid && target_is_valid) {
            valid = validate_const_expression(context, unit_index, target.next_sibling);
        }
    }
    case syntax::SyntaxKind.expression_statement {
        valid = node.child_count == 1 && validate_const_expression(context, unit_index, node.first_child);
    }
    case syntax::SyntaxKind.if_statement {
        let arity_is_valid: bool = node.child_count >= 2 && node.child_count <= 3;
        if (arity_is_valid && validate_const_expression(context, unit_index, node.first_child)) {
            let then_id: usize = context::node(context, unit_index, node.first_child).next_sibling;
            valid = validate_const_statement(context, unit_index, then_id);
            if (valid && node.child_count == 3) {
                valid = validate_const_statement(
                    context, unit_index, context::node(context, unit_index, then_id).next_sibling);
            }
        }
    }
    case syntax::SyntaxKind.return_statement {
        valid = node.child_count == 1 && validate_const_expression(context, unit_index, node.first_child);
    }
    default {}
    }
    if (!valid) {
        report_invalid_const_function(context, unit_index, node.span);
    }
    return valid;
}

fn validate_const_function(context: *context::Context, const_function_id: usize) -> bool {
    let none: usize = context::no_id();
    let records: *const context::ConstFunction = context->const_functions.data as
            *const context::ConstFunction;
    let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
    let symbol: context::Symbol = symbols[records[const_function_id].symbol_id];
    var body_id: usize = none;
    let declaration: syntax::SyntaxNode = context::node(context, symbol.declaration_unit, symbol.declaration_node);
    for (var child: usize = declaration.first_child; child != none;
        child = context::node(context, symbol.declaration_unit, child).next_sibling) {
        let part: syntax::SyntaxNode = context::node(context, symbol.declaration_unit, child);
        if (part.kind == syntax::SyntaxKind.block_statement) {
            body_id = child;
        }
    }
    if (body_id == none) {
        report_invalid_const_function(
            context, symbol.declaration_unit,
            context::node(context, symbol.declaration_unit, symbol.declaration_node).span);
        return false;
    }
    var valid: bool = true;
    let body: syntax::SyntaxNode = context::node(context, symbol.declaration_unit, body_id);
    for (var statement: usize = body.first_child; statement != none;
        statement = context::node(context, symbol.declaration_unit, statement).next_sibling) {
        let validation_can_continue: bool = valid && context->error == runtime::Error.none;
        if (!validation_can_continue) {
            break;
        }
        valid = validate_const_statement(context, symbol.declaration_unit, statement);
    }
    return valid;
}

fn collect_const_function(
    context: *context::Context, module_id: usize, unit_index: usize, declaration_id: usize,
    declaration: syntax::SyntaxNode, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if (interface_unit) {
        // Interface units carry no bodies, and a const fn without a body
        // is useless to the evaluator.
        report_invalid_const_function(context, unit_index, declaration.span);
        return context->error == runtime::Error.none;
    }
    if ((declaration.flags & (syntax::SyntaxFlag.exported as usize)) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_export, unit_index, declaration.span, none, context::empty_span(),
            0);
    }
    let duplicate: usize = names::find_any_local_symbol(context, module_id, unit_index, declaration.token_index);
    if (duplicate != none) {
        let symbols: *const context::Symbol = context->symbols.data as *const context::Symbol;
        context::add_diagnostic(
            context, context::DiagnosticKind.duplicate_name, unit_index,
            context::token(context, unit_index, declaration.token_index).span, symbols[duplicate].declaration_unit,
            context::token(context, symbols[duplicate].declaration_unit, symbols[duplicate].name_token).span,
            duplicate);
        return context->error == runtime::Error.none;
    }
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    let defaults: DefaultProfile = function_default_profile(context, unit_index, declaration, parameter_count);
    if (defaults.default_count != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_default_function, unit_index, declaration.span,
            none, context::empty_span(), defaults.default_count);
    }
    if ((declaration.flags & (syntax::SyntaxFlag.variadic as usize)) != 0) {
        context::add_diagnostic(
            context, context::DiagnosticKind.invalid_variadic, unit_index, declaration.span, context::no_id(),
            context::empty_span(), 0);
        return context->error == runtime::Error.none;
    }
    if (body_node == none || return_node == none) {
        report_invalid_const_function(context, unit_index, declaration.span);
        return context->error == runtime::Error.none;
    }
    let return_type: usize = types::resolve_type_node(context, unit_index, return_node);
    if (return_type == none) {
        return context->error == runtime::Error.none;
    }
    if (!const_scalar_type(context, return_type)) {
        report_invalid_const_function(context, unit_index, context::node(context, unit_index, return_node).span);
    }
    let symbol_id: usize = names::append_symbol(
        context, {
            kind = context::SymbolKind.const_function, module_id = module_id, declaration_unit = unit_index,
            declaration_node = declaration_id, name_token = declaration.token_index, type_id = return_type,
            function_id = context->const_function_count, integer_value = 0, flags = context::SymbolFlag.none as usize,
        });
    if (symbol_id == none) {
        return false;
    }
    let const_id: usize =
        append_const_function(
            context, {
                symbol_id = symbol_id, return_type = return_type, first_parameter = none, parameter_count = 0,
            });
    if (const_id == none) {
        return false;
    }
    var child: usize = declaration.first_child;
    for (var index: usize = 0; index < parameter_count; index += 1) {
        let parameter_node: syntax::SyntaxNode = context::node(context, unit_index, child);
        let type_id: usize = types::resolve_type_node(context, unit_index, parameter_node.first_child);
        if (type_id == none) {
            return context->error == runtime::Error.none;
        }
        if (!const_scalar_type(
                context, type_id)) {
            report_invalid_const_function(context, unit_index, parameter_node.span);
        }
        let records: *const context::ConstFunction = context->const_functions.data as
                *const context::ConstFunction;
        let parameters: *const context::Parameter = context->parameters.data as
                *const context::Parameter;
        let base: usize = records[const_id].first_parameter;
        let collected: usize = records[const_id].parameter_count;
        for (var previous: usize = 0; previous < collected; previous += 1) {
            if (context::tokens_equal(
                    context, unit_index, parameter_node.token_index, parameters[base + previous].unit_index,
                    parameters[base + previous].name_token)) {
                report_invalid_const_function(context, unit_index, parameter_node.span);
            }
        }
        if (append_parameter(
                context, {
                    function_id = none, type_id = type_id, unit_index = unit_index, declaration_node = child,
                    name_token = parameter_node.token_index, default_node = none, default_value = 0,
                    default_kind = context::ParameterDefaultKind.none,
                }) == none) {
            return false;
        }
        let writable: *context::ConstFunction = context->const_functions.data as
                *context::ConstFunction;
        if (writable[const_id].parameter_count == 0) {
            writable[const_id].first_parameter = context->parameter_count - 1;
        }
        writable[const_id].parameter_count += 1;
        child = parameter_node.next_sibling;
    }
    return context->error == runtime::Error.none;
}
fn collect_const_functions_in_unit(
    context: *context::Context, module_id: usize, unit_index: usize, interface_unit: bool) -> bool {
    let none: usize = context::no_id();
    if (unit_index == none) {
        return true;
    }
    for (var declaration_id: usize = names::first_declaration(context, unit_index);
        declaration_id != none && context->error == runtime::Error.none;
        declaration_id = context::node(context, unit_index, declaration_id).next_sibling) {
        let declaration: syntax::SyntaxNode = context::node(context, unit_index, declaration_id);
        let const_function: bool = declaration.kind == syntax::SyntaxKind.function_declaration &&
            (declaration.flags & (syntax::SyntaxFlag.const_function as usize)) != 0;
        if (const_function && !collect_const_function(
                context, module_id, unit_index, declaration_id, declaration, interface_unit)) {
            return false;
        }
    }
    return context->error == runtime::Error.none;
}

fn collect_const_functions(context: *context::Context) -> bool {
    for (var module_id: usize = 0;
        module_id < context->module_count && context->error == runtime::Error.none;
        module_id += 1) {
        let modules: *const context::Module = context->modules.data as *const context::Module;
        if (!collect_const_functions_in_unit(context, module_id, modules[module_id].interface_unit, true)) {
            return false;
        }
        for (var implementation_index: usize = 0;
            implementation_index < modules[module_id].implementation_count;
            implementation_index += 1) {
            let implementation_unit: usize =
                names::module_implementation_unit(context, module_id, implementation_index);
            if (implementation_unit == context::no_id() ||
                !collect_const_functions_in_unit(
                    context, module_id, implementation_unit, false)) {
                return false;
            }
        }
    }
    for (var index: usize = 0;
        index < context->const_function_count && context->error == runtime::Error.none;
        index += 1) {
        validate_const_function(context, index);
    }
    return context->error == runtime::Error.none;
}
