module luna.compiler.x86.codegen;

impl CodeGenerator {

priv fn general_register_64(index: usize) -> *const u8 {
    switch (index) {
    case 0 {
        return "%rdi";
    }
    case 1 {
        return "%rsi";
    }
    case 2 {
        return "%rdx";
    }
    case 3 {
        return "%rcx";
    }
    case 4 {
        return "%r8";
    }
    case 5 {
        return "%r9";
    }
    default {
        return null;
    }
    }
}

priv fn general_register_32(index: usize) -> *const u8 {
    switch (index) {
    case 0 {
        return "%edi";
    }
    case 1 {
        return "%esi";
    }
    case 2 {
        return "%edx";
    }
    case 3 {
        return "%ecx";
    }
    case 4 {
        return "%r8d";
    }
    case 5 {
        return "%r9d";
    }
    default {
        return null;
    }
    }
}

priv fn vector_register(index: usize) -> *const u8 {
    switch (index) {
    case 0 {
        return "%xmm0";
    }
    case 1 {
        return "%xmm1";
    }
    case 2 {
        return "%xmm2";
    }
    case 3 {
        return "%xmm3";
    }
    case 4 {
        return "%xmm4";
    }
    case 5 {
        return "%xmm5";
    }
    case 6 {
        return "%xmm6";
    }
    case 7 {
        return "%xmm7";
    }
    default {
        return null;
    }
    }
}

priv fn return_general_register(index: usize) -> *const u8 {
    switch (index) {
    case 0 {
        return "%rax";
    }
    case 1 {
        return "%rdx";
    }
    default {
        return null;
    }
    }
}

priv fn emit_stack_adjust(prefix: *const u8, size_bytes: usize) -> bool {
    if (size_bytes == 0) {
        return true;
    }
    this->literal(prefix);
    this->append_usize(size_bytes);
    this->literal(", %rsp\n");
    return this->ready();
}

priv fn argument_at( instruction_id: usize, argument_index: usize) -> usize {
    let arguments: *const ir::Argument = this->ir.arguments as
            *const ir::Argument;
    var found: usize = 0;
    for (var index: usize = 0; index < this->ir.argument_count; index += 1) {
        if (arguments[index].instruction_id == instruction_id) {
            if (found == argument_index) {
                return arguments[index].value_id;
            }
            found += 1;
        }
    }
    this->fail( runtime::Error.invalid_argument);
    return this->no_id();
}

priv fn call_argument_total( instruction_id: usize) -> usize {
    let arguments: *const ir::Argument = this->ir.arguments as
            *const ir::Argument;
    var found: usize = 0;
    for (var index: usize = 0; index < this->ir.argument_count; index += 1) {
        if (arguments[index].instruction_id == instruction_id) {
            found += 1;
        }
    }
    return found;
}

// 从具名参数结束位置继续沿当前寄存器/栈游标分类一个标量可变参数，并生成现有 call
// argument emitter 可直接消费的 ABI parameter 记录。
priv fn variadic_extra_parameter( argument: usize, general_used: *usize, vector_used: *usize,
    stack_cursor: *usize) -> Parameter {
    let none: usize = this->no_id();
    var parameter: Parameter = {
        function_id = none, parameter_index = none, abi_class = Class.invalid,
        location = LocationKind.invalid, register_index = none, stack_offset_bytes = none,
        stack_size_bytes = 0, type_id = none, size_bytes = 0, alignment_bytes = 0, first_piece = none, piece_count = 0,
        aggregate = false,
    };
    if (general_used == null || vector_used == null) {
        return parameter;
    }
    if (stack_cursor == null || !this->ready()) {
        return parameter;
    }
    let values: *const ir::Value = this->ir.values as *const ir::Value;
    let record: *const type_info::Record = this->type( values[argument].type_id);
    if (record == null || type_info::is_memory(record->kind)) {
        return parameter;
    }
    parameter.type_id = values[argument].type_id;
    parameter.size_bytes = record->size_bytes;
    parameter.alignment_bytes = record->alignment_bytes;
    parameter.abi_class = type_info::is_float(record->kind) ? Class.sse : Class.integer;
    if (parameter.abi_class == Class.integer && *general_used < (CodegenLimit.general_argument_registers as usize)) {
        parameter.location = LocationKind.general_register;
        parameter.register_index = *general_used;
        *general_used += 1;
        return parameter;
    }
    if (parameter.abi_class == Class.sse && *vector_used < (CodegenLimit.vector_argument_registers as usize)) {
        parameter.location = LocationKind.vector_register;
        parameter.register_index = *vector_used;
        *vector_used += 1;
        return parameter;
    }
    parameter.location = LocationKind.stack;
    parameter.stack_offset_bytes = *stack_cursor;
    parameter.stack_size_bytes = CodegenLimit.variadic_stack_slot as usize;
    *stack_cursor += CodegenLimit.variadic_stack_slot as usize;
    return parameter;
}

priv fn emit_load_piece( piece: Piece, destination: *const u8) -> bool {
    var mnemonic: *const u8 = null;
    var suffix: *const u8 = null;
    switch (piece.size_bytes) {
    case 8 {
        mnemonic = "    movq ";
        suffix = "(%r11), ";
    }
    case 4 {
        mnemonic = "    movl ";
        suffix = "(%r11), %eax\n    movq %rax, ";
    }
    case 2 {
        mnemonic = "    movzwl ";
        suffix = "(%r11), %eax\n    movq %rax, ";
    }
    case 1 {
        mnemonic = "    movzbl ";
        suffix = "(%r11), %eax\n    movq %rax, ";
    }
    default {}
    }
    if (mnemonic != null) {
        this->literal(mnemonic);
        this->append_usize(piece.value_offset_bytes);
        this->literal(suffix);
        this->literal(destination);
        this->literal("\n");
        return this->ready();
    }
    if (piece.size_bytes == 0 || piece.size_bytes > 8) {
        return this->fail( runtime::Error.invalid_argument);
    }
    this->literal("    xorq %rax, %rax\n");
    for (var index: usize = 0; index < piece.size_bytes; index += 1) {
        this->literal("    movzbl ");
        this->append_usize(piece.value_offset_bytes + index);
        this->literal("(%r11), %r10d\n");
        if (index != 0) {
            this->literal("    shlq $");
            this->append_usize(index * 8);
            this->literal(", %r10\n");
        }
        this->literal("    orq %r10, %rax\n");
        if (!this->ready()) {
            return false;
        }
    }
    this->literal("    movq %rax, ");
    this->literal(destination);
    this->literal("\n");
    return this->ready();
}

priv fn emit_store_piece( piece: Piece, source: *const u8) -> bool {
    if (piece.size_bytes == 0 || piece.size_bytes > 8) {
        return this->fail( runtime::Error.invalid_argument);
    }
    this->literal("    movq ");
    this->literal(source);
    this->literal(", %r10\n");
    for (var index: usize = 0; index < piece.size_bytes; index += 1) {
        this->literal("    movb %r10b, ");
        this->append_usize(piece.value_offset_bytes + index);
        this->literal("(%r11)\n");
        if (index + 1 != piece.size_bytes) {
            this->literal("    shrq $8, %r10\n");
        }
        if (!this->ready()) {
            return false;
        }
    }
    return true;
}

priv fn emit_call_stack_argument( parameter: Parameter, argument: usize, external_c: bool) -> bool {
    let record: *const type_info::Record = this->type( parameter.type_id);
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        let values: *const ir::Value = this->ir.values as *const ir::Value;
        let pointer_record: *const type_info::Record = this->type( values[argument].type_id);
        if (pointer_record == null || !this->load_integer(argument, pointer_record, "%esi", "%rsi", false)) {
            return false;
        }
        this->literal("    leaq ");
        this->append_usize(parameter.stack_offset_bytes);
        this->literal("(%rsp), %rdi\n    movq $");
        this->append_usize(parameter.size_bytes);
        this->literal(", %rcx\n    cld\n    rep movsb\n");
        return this->ready();
    }
    if (type_info::is_float(record->kind)) {
        if (!this->load_xmm(argument, record, "%xmm0")) {
            return false;
        }
        this->literal("    ");
        this->literal(this->float_move(record));
        this->literal(" %xmm0, ");
        this->append_usize(parameter.stack_offset_bytes);
        this->literal("(%rsp)\n");
        return this->ready();
    }
    let width: usize = this->bit_width(record);
    let c_signed_argument: bool = external_c && this->is_signed(record);
    let extend_signed: bool = c_signed_argument && width < 32;
    let loaded: bool = extend_signed ? this->load_integer(argument, record, "%eax", "%rax", true) :
        this->load_rax(argument, record);
    if (!loaded) {
        return false;
    }
    this->literal(width <= 32 ? "    movl %eax, " : "    movq %rax, ");
    this->append_usize(parameter.stack_offset_bytes);
    this->literal("(%rsp)\n");
    return this->ready();
}

priv fn emit_call_register_argument( parameter: Parameter, argument: usize, external_c: bool) -> bool {
    let record: *const type_info::Record = this->type( parameter.type_id);
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        let values: *const ir::Value = this->ir.values as *const ir::Value;
        let pointer_record: *const type_info::Record = this->type( values[argument].type_id);
        if (pointer_record == null || !this->load_integer( argument, pointer_record, "%r11d", "%r11", false)) {
            return false;
        }
        let pieces: *const Piece = this->abi.piece_data();
        for (var index: usize = 0; index < parameter.piece_count; index += 1) {
            let piece: Piece = pieces[parameter.first_piece + index];
            if (piece.abi_class == Class.integer) {
                let destination: *const u8 = this->general_register_64(piece.register_index);
                if (destination == null || !this->emit_load_piece( piece, destination)) {
                    return false;
                }
            } else {
                let destination: *const u8 = this->vector_register(piece.register_index);
                let width_is_valid: bool = piece.size_bytes == 4 || piece.size_bytes == 8;
                if (destination == null || !width_is_valid) {
                    return false;
                }
                this->literal(piece.size_bytes == 4 ? "    movss " : "    movq ");
                this->append_usize(piece.value_offset_bytes);
                this->literal("(%r11), ");
                this->literal(destination);
                this->literal("\n");
                if (!this->ready()) {
                    return false;
                }
            }
        }
        return true;
    }
    if (parameter.location == LocationKind.vector_register) {
        let destination: *const u8 = this->vector_register(parameter.register_index);
        return destination != null && this->load_xmm( argument, record, destination);
    }
    let width: usize = this->bit_width(record);
    let destination: *const u8 = width <= 32 ? this->general_register_32(parameter.register_index) :
            this->general_register_64(parameter.register_index);
    if (destination == null) {
        return this->fail( runtime::Error.invalid_argument);
    }
    let c_signed_argument: bool = external_c && this->is_signed(record);
    return this->load_integer(argument, record, destination, destination, c_signed_argument && width < 32);
}

priv fn emit_stack_address( storage: Storage, suffix: *const u8) -> bool {
    if (this->error != runtime::Error.none) {
        return false;
    }
    this->literal("    leaq ");
    this->append_stack(storage);
    this->literal(suffix);
    return this->ready();
}

priv fn emit_call_result( instruction: ir::Instruction, function_abi: Function) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null || record->kind == type_info::Kind.type_void) {
        return record != null;
    }
    if (!function_abi.return_aggregate) {
        if (type_info::is_float(record->kind)) {
            return this->store_xmm( instruction.result, record, "%xmm0");
        }
        if (record->kind == type_info::Kind.boolean &&
            !this->literal( "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n")) {
            return false;
        }
        return this->store_rax( instruction.result, record);
    }
    let direct_destination: bool = instruction.right != this->no_id();
    if (direct_destination) {
        let values: *const ir::Value = this->ir.values as *const ir::Value;
        let pointer: *const type_info::Record = this->type( values[instruction.right].type_id);
        if (pointer == null || !this->load_integer( instruction.right, pointer, "%r11d", "%r11", false)) {
            return false;
        }
    } else {
        let destination: Storage = this->storage( StorageKind.aggregate_call_result, instruction.result);
        if (!this->emit_stack_address( destination, ", %r11\n")) {
            return false;
        }
    }
    if (!function_abi.hidden_return_pointer) {
        let pieces: *const Piece = this->abi.piece_data();
        for (var index: usize = 0; index < function_abi.return_piece_count; index += 1) {
            let piece: Piece = pieces[function_abi.first_return_piece + index];
            if (piece.abi_class == Class.integer) {
                let source: *const u8 = this->return_general_register(piece.register_index);
                if (source == null || !this->emit_store_piece( piece, source)) {
                    return false;
                }
            } else {
                let source: *const u8 = this->vector_register(piece.register_index);
                let width_is_valid: bool = piece.size_bytes == 4 || piece.size_bytes == 8;
                if (source == null || !width_is_valid) {
                    return false;
                }
                this->literal(piece.size_bytes == 4 ? "    movss " : "    movq ");
                this->literal(source);
                this->literal(", ");
                this->append_usize(piece.value_offset_bytes);
                this->literal("(%r11)\n");
                if (!this->ready()) {
                    return false;
                }
            }
        }
    }
    if (direct_destination) {
        let values: *const ir::Value = this->ir.values as *const ir::Value;
        let pointer: *const type_info::Record = this->type( values[instruction.right].type_id);
        if (pointer == null || !this->load_rax(instruction.right, pointer)) {
            return false;
        }
        this->literal("    movq %rax, ");
        this->append_value(instruction.result);
        this->literal("\n");
        return this->ready();
    }
    let destination: Storage = this->storage( StorageKind.aggregate_call_result, instruction.result);
    if (!this->emit_stack_address(destination, ", %rax\n    movq %rax, ")) {
        return false;
    }
    this->append_value(instruction.result);
    this->literal("\n");
    return this->ready();
}

priv fn emit_hidden_return_argument( instruction: ir::Instruction) -> bool {
    if (instruction.right != this->no_id()) {
        let values: *const ir::Value = this->ir.values as *const ir::Value;
        let pointer: *const type_info::Record = this->type( values[instruction.right].type_id);
        if (pointer == null || !this->load_rax(instruction.right, pointer)) {
            return false;
        }
        this->literal("    movq %rax, %rdi\n");
        return this->ready();
    }
    let destination: Storage = this->storage( StorageKind.aggregate_call_result, instruction.result);
    return this->emit_stack_address( destination, ", %rdi\n");
}

priv fn function_pointer_abi_index( type_id: usize) -> usize {
    let records: *const type_info::Record = this->types->record_data() as
            *const type_info::Record;
    var ordinal: usize = 0;
    for (var index: usize = 0; index < type_id; index += 1) {
        if (records[index].kind == type_info::Kind.function_pointer) {
            ordinal += 1;
        }
    }
    return this->ir.function_count + ordinal;
}

priv fn emit_call_indirect( instruction: ir::Instruction, instruction_id: usize) -> bool {
    let values: *const ir::Value = this->ir.values as *const ir::Value;
    let callee_type: usize = values[instruction.left].type_id;
    let abi_index: usize = this->function_pointer_abi_index( callee_type);
    let abi_functions: *const Function = this->abi.function_data();
    let function_abi: Function = abi_functions[abi_index];
    let parameters: *const Parameter = this->abi.parameter_data();
    if (!this->emit_stack_adjust("    subq $", function_abi.call_frame_size_bytes)) {
        return false;
    }
    this->call_frame_depth += function_abi.call_frame_size_bytes;
    for (var index: usize = 0; index < function_abi.parameter_count; index += 1) {
        let parameter: Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location == LocationKind.stack) {
            let argument: usize = this->argument_at( instruction_id, index);
            if (argument == this->no_id() || !this->emit_call_stack_argument( parameter, argument, false)) {
                return false;
            }
        }
    }
    if (function_abi.hidden_return_pointer) {
        if (!this->emit_hidden_return_argument( instruction)) {
            return false;
        }
    }
    for (var index: usize = 0; index < function_abi.parameter_count; index += 1) {
        let parameter: Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location != LocationKind.stack) {
            let argument: usize = this->argument_at( instruction_id, index);
            if (argument == this->no_id() || !this->emit_call_register_argument( parameter, argument, false)) {
                return false;
            }
        }
    }
    if (!this->load_rax( instruction.left, this->type( callee_type)) ||
        !this->literal( "    movq %rax, %r11\n    call *%r11\n")) {
        return false;
    }
    this->call_frame_depth -= function_abi.call_frame_size_bytes;
    if (!this->emit_stack_adjust("    addq $", function_abi.call_frame_size_bytes)) {
        return false;
    }
    return this->emit_call_result( instruction, function_abi);
}

priv fn emit_call( instruction: ir::Instruction, instruction_id: usize) -> bool {
    if (instruction.auxiliary >= this->ir.function_count) {
        return this->fail( runtime::Error.invalid_argument);
    }
    let abi_functions: *const Function = this->abi.function_data();
    let function_abi: Function = abi_functions[instruction.auxiliary];
    let functions: *const ir::Function = this->ir.functions as
            *const ir::Function;
    let external_c: bool = functions[instruction.auxiliary].linkage == ir::Linkage.external_c;
    let parameters: *const Parameter = this->abi.parameter_data();
    // 可变参数 callee 在具名参数之后接收额外参数；分类游标从具名列表的结束位置继续，
    // call 必须把实际使用的 vector register 总数写入 %al。
    let variadic: bool = functions[instruction.auxiliary].variadic;
    var extra_count: usize = 0;
    var vector_count: usize = function_abi.vector_register_count;
    var frame_size: usize = function_abi.call_frame_size_bytes;
    if (variadic) {
        extra_count = this->call_argument_total( instruction_id) - function_abi.parameter_count;
        var general_used: usize = function_abi.general_register_count;
        var stack_cursor: usize = function_abi.stack_argument_size_bytes;
        for (var extra: usize = 0; extra < extra_count; extra += 1) {
            let argument: usize = this->argument_at( instruction_id, function_abi.parameter_count + extra);
            if (argument == this->no_id() ||
                this->variadic_extra_parameter( argument, &general_used, &vector_count, &stack_cursor).location ==
                    LocationKind.invalid) {
                return this->fail( runtime::Error.invalid_argument);
            }
        }
        frame_size = (stack_cursor + (CodegenLimit.call_stack_alignment as usize) - 1) &
            ~((CodegenLimit.call_stack_alignment as usize) - 1);
    }
    if (!this->emit_stack_adjust("    subq $", frame_size)) {
        return false;
    }
    this->call_frame_depth += frame_size;
    for (var index: usize = 0; index < function_abi.parameter_count; index += 1) {
        let parameter: Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location == LocationKind.stack) {
            let argument: usize = this->argument_at( instruction_id, index);
            if (argument == this->no_id() || !this->emit_call_stack_argument( parameter, argument, external_c)) {
                return false;
            }
        }
    }
    if (variadic) {
        var general_used: usize = function_abi.general_register_count;
        var vector_used: usize = function_abi.vector_register_count;
        var stack_cursor: usize = function_abi.stack_argument_size_bytes;
        for (var extra: usize = 0; extra < extra_count; extra += 1) {
            let argument: usize = this->argument_at( instruction_id, function_abi.parameter_count + extra);
            let parameter: Parameter = this->variadic_extra_parameter( argument, &general_used, &vector_used,
                &stack_cursor);
            if (parameter.location == LocationKind.invalid) {
                return this->fail( runtime::Error.invalid_argument);
            }
            if (parameter.location == LocationKind.stack &&
                !this->emit_call_stack_argument( parameter, argument, external_c)) {
                return false;
            }
        }
    }
    if (function_abi.hidden_return_pointer) {
        if (!this->emit_hidden_return_argument( instruction)) {
            return false;
        }
    }
    for (var index: usize = 0; index < function_abi.parameter_count; index += 1) {
        let parameter: Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location != LocationKind.stack) {
            let argument: usize = this->argument_at( instruction_id, index);
            if (argument == this->no_id() || !this->emit_call_register_argument( parameter, argument, external_c)) {
                return false;
            }
        }
    }
    if (variadic) {
        var general_used: usize = function_abi.general_register_count;
        var vector_used: usize = function_abi.vector_register_count;
        var stack_cursor: usize = function_abi.stack_argument_size_bytes;
        for (var extra: usize = 0; extra < extra_count; extra += 1) {
            let argument: usize = this->argument_at( instruction_id, function_abi.parameter_count + extra);
            let parameter: Parameter = this->variadic_extra_parameter( argument, &general_used, &vector_used,
                &stack_cursor);
            if (parameter.location == LocationKind.invalid) {
                return this->fail( runtime::Error.invalid_argument);
            }
            if (parameter.location != LocationKind.stack &&
                !this->emit_call_register_argument( parameter, argument, external_c)) {
                return false;
            }
        }
        this->literal("    movb $");
        this->append_usize(vector_count);
        this->literal(", %al\n");
        if (!this->ready()) {
            return false;
        }
    }
    this->literal("    call ");
    this->append_function_symbol(instruction.auxiliary);
    this->literal("\n");
    if (!this->ready()) {
        return false;
    }
    this->call_frame_depth -= frame_size;
    if (!this->emit_stack_adjust("    addq $", frame_size)) {
        return false;
    }
    return this->emit_call_result( instruction, function_abi);
}

}
