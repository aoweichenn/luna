module luna.compiler.x86.codegen;



enum AbiLimit: usize {
    maximum_size = 18446744073709551615, general_register_count = 6, vector_register_count = 8, eightbyte_size = 8,
    stack_alignment = 16, maximum_register_eightbytes = 2, maximum_type_depth = 128, maximum_stack_size = 2147483647,
}

impl AbiLayout {
    init(): functions = vector::vector<Function>(), parameters = vector::vector<Parameter>(),
            pieces = vector::vector<Piece>() {
        this->error_code = runtime::Error.none;
    }

    priv fn ready() const -> bool {
        return this->error_code == runtime::Error.none;
    }

    priv fn fail(error: runtime::Error) -> bool {
        if (this->ready()) {
            this->error_code = error;
        }
        return false;
    }

    priv fn no_id() const -> usize {
    return AbiLimit.maximum_size as usize;
}

    fn error() const -> runtime::Error {
        return this->error_code;
}

    fn function_count() const -> usize {
        return this->functions.size();
}

    fn parameter_count() const -> usize {
        return this->parameters.size();
    }

    fn piece_count() const -> usize {
        return this->pieces.size();
    }

    fn function_data() const -> *const Function {
        return this->functions.as_span().data();
    }

    fn parameter_data() const -> *const Parameter {
        return this->parameters.as_span().data();
    }

    fn piece_data() const -> *const Piece {
        return this->pieces.as_span().data();
    }

    priv fn storage_is_valid() const -> bool {
        let declarations_are_valid: bool = this->functions.is_valid() && this->parameters.is_valid();
        return declarations_are_valid && this->pieces.is_valid();
}

priv fn abi_align_up(value: usize, alignment: usize) -> usize {
    var result: usize = 0;
    return checked::align_up(value, alignment, &result) ? result : this->no_id();
}

priv fn class_merge(left: Class, right: Class) -> Class {
    if (left == right) {
        return left;
    }
    if (left == Class.no_class) {
        return right;
    }
    if (right == Class.no_class) {
        return left;
    }
    if (left == Class.memory || right == Class.memory) {
        return Class.memory;
    }
    if (left == Class.integer || right == Class.integer) {
        return Class.integer;
    }
    return Class.sse;
}

priv fn set_memory(classification: *Classification) -> bool {
    if (classification == null) {
        return false;
    }
    classification->eightbyte_count = 1;
    classification->first = Class.memory;
    classification->second = Class.no_class;
    return false;
}

priv fn scalar_class(kind: type_info::Kind) -> Class {
    return type_info::is_float(kind) ? Class.sse : Class.integer;
}

priv fn merge_leaf(
    classification: *Classification, offset_bytes: usize, size_bytes: usize, alignment_bytes: usize,
    abi_class: Class) -> bool {
    let output_is_valid: bool = classification != null && size_bytes != 0;
    let scalar_shape_is_valid: bool = size_bytes <= 8 && alignment_bytes != 0;
    let alignment_is_valid: bool = scalar_shape_is_valid && offset_bytes % alignment_bytes == 0;
    let offset_is_bounded: bool = offset_bytes <= 15;
    let range_is_valid: bool = offset_is_bounded && size_bytes <= 16 - offset_bytes;
    let layout_is_valid: bool = alignment_is_valid && range_is_valid;
    if (!output_is_valid || !layout_is_valid) {
        return this->set_memory(classification);
    }
    let first: usize = offset_bytes / 8;
    let last: usize = (offset_bytes + size_bytes - 1) / 8;
    for (var index: usize = first; index <= last; index += 1) {
        if (index == 0) {
            classification->first = this->class_merge(classification->first, abi_class);
        } else if (index == 1) {
            classification->second = this->class_merge(classification->second, abi_class);
        } else {
            return this->set_memory(classification);
        }
    }
    return true;
}

priv fn merge_type(
    types: type_info::TypeTable const&, type_id: usize, base_offset: usize, depth: usize,
    classification: *Classification) -> bool {
    let input_is_valid: bool = type_id < types.size() && depth <= AbiLimit.maximum_type_depth as usize;
    let output_is_valid: bool = classification != null && classification->first != Class.memory;
    if (!input_is_valid || !output_is_valid) {
        return this->set_memory(classification);
    }
    let records: *const type_info::Record = types.record_data() as *const type_info::Record;
    let fields: *const type_info::Field = types.field_data() as *const type_info::Field;
    let record: type_info::Record = records[type_id];
    if (type_info::is_scalar(record.kind)) {
        return this->merge_leaf(
            classification, base_offset, record.size_bytes, record.alignment_bytes, this->scalar_class(record.kind));
    }
    if (record.kind == type_info::Kind.bound_method) {
        let word_bytes: usize = sizeof(usize);
        return this->merge_leaf(classification, base_offset, word_bytes, word_bytes, Class.integer) &&
            this->merge_leaf(classification, base_offset + word_bytes, word_bytes, word_bytes, Class.integer);
    }
    if (record.kind == type_info::Kind.array) {
        let element: type_info::Record = records[record.element_type];
        for (var index: usize = 0; index < record.element_count; index += 1) {
            if (index > (AbiLimit.maximum_size as usize) / element.size_bytes ||
                !this->merge_type(
                    types, record.element_type, base_offset + index * element.size_bytes, depth + 1, classification)) {
                return false;
            }
        }
        return true;
    }
    if (type_info::is_record(record.kind)) {
        if (record.kind == type_info::Kind.class_type && record.base_type != type_info::no_id()) {
            if (!this->merge_type(types, record.base_type, base_offset, depth + 1, classification)) {
                return false;
            }
        }
        for (var index: usize = 0; index < record.field_count; index += 1) {
            let field: type_info::Field = fields[record.first_field + index];
            if (field.offset_bytes > (AbiLimit.maximum_size as usize) - base_offset ||
                !this->merge_type(
                    types, field.type_id, base_offset + field.offset_bytes, depth + 1, classification)) {
                return false;
            }
        }
        return true;
    }
    return this->set_memory(classification);
}

priv fn classify(types: type_info::TypeTable const&, type_id: usize) -> Classification {
    var result: Classification = {
        eightbyte_count = 0, first = Class.invalid, second = Class.invalid,
    };
    if (!types.is_valid(true) || type_id >= types.size()) {
        return result;
    }
    let records: *const type_info::Record = types.record_data() as *const type_info::Record;
    let record: type_info::Record = records[type_id];
    if (!type_info::is_memory(record.kind) || record.size_bytes == 0) {
        return result;
    }
    result.first = Class.no_class;
    result.second = Class.no_class;
    if (record.size_bytes > 16 || record.alignment_bytes > 16) {
        this->set_memory(&result);
        return result;
    }
    result.eightbyte_count = (record.size_bytes + 7) / 8;
    if (!this->merge_type(
            types, type_id, 0, 0, &result)) {
        return result;
    }
    if (result.first == Class.no_class) {
        result.first = Class.integer;
    }
    if (result.eightbyte_count == 2 && result.second == Class.no_class) {
        result.second = Class.integer;
    }
    return result;
}

priv fn add_piece(piece: Piece) -> usize {
    let none: usize = this->no_id();
    if (!this->ready()) {
        return none;
    }
    let result: usize = this->pieces.size();
    let error: runtime::Error = this->pieces.push_back(piece);
    if (error != runtime::Error.none) {
        this->fail(error);
        return none;
    }
    return result;
}

priv fn add_parameter(parameter: Parameter) -> usize {
    let none: usize = this->no_id();
    if (!this->ready()) {
        return none;
    }
    let result: usize = this->parameters.size();
    let error: runtime::Error = this->parameters.push_back(parameter);
    if (error != runtime::Error.none) {
        this->fail(error);
        return none;
    }
    return result;
}

priv fn add_function(function: Function) -> usize {
    let none: usize = this->no_id();
    if (!this->ready()) {
        return none;
    }
    let result: usize = this->functions.size();
    let error: runtime::Error = this->functions.push_back(function);
    if (error != runtime::Error.none) {
        this->fail(error);
        return none;
    }
    return result;
}

priv fn piece_class(classification: Classification, index: usize) -> Class {
    return index == 0 ? classification.first : classification.second;
}

priv fn piece_size(size_bytes: usize, index: usize) -> usize {
    let offset: usize = index * 8;
    let remaining: usize = size_bytes - offset;
    return remaining < 8 ? remaining : 8;
}

priv fn add_stack_area(
    current_size: usize, size_bytes: usize, alignment_bytes: usize, offset: *usize, area_size: *usize) -> usize {
    if (offset == null || area_size == null) {
        return this->no_id();
    }
    if (size_bytes == 0 || alignment_bytes == 0) {
        return this->no_id();
    }
    let stack_alignment: usize = alignment_bytes > 8 ? alignment_bytes : 8;
    let aligned_offset: usize = this->abi_align_up(current_size, stack_alignment);
    let aligned_size: usize = this->abi_align_up(size_bytes, 8);
    if (aligned_offset == this->no_id() || aligned_size == this->no_id()) {
        return this->no_id();
    }
    if (aligned_offset > (AbiLimit.maximum_size as usize) - aligned_size) {
        return this->no_id();
    }
    *offset = aligned_offset;
    *area_size = aligned_size;
    return aligned_offset + aligned_size;
}

priv fn build_return(function: *Function, types: type_info::TypeTable const&) -> bool {
    let records: *const type_info::Record = types.record_data() as *const type_info::Record;
    let record: type_info::Record = records[function->return_type];
    function->return_size_bytes = record.size_bytes;
    function->return_alignment_bytes = record.alignment_bytes;
    function->return_aggregate = type_info::is_memory(record.kind);
    function->first_return_piece = this->no_id();
    if (!function->return_aggregate) {
        return true;
    }
    let classification: Classification = this->classify(types, function->return_type);
    if (classification.first == Class.memory) {
        function->hidden_return_pointer = true;
        function->general_register_count = 1;
        return true;
    }
    function->first_return_piece = this->piece_count();
    var general_index: usize = 0;
    var vector_index: usize = 0;
    for (var index: usize = 0; index < classification.eightbyte_count; index += 1) {
        let abi_class: Class = this->piece_class(classification, index);
        let register_index: usize = abi_class == Class.integer ? general_index : vector_index;
        if (abi_class == Class.integer) {
            general_index += 1;
        } else {
            vector_index += 1;
        }
        if (this->add_piece( {
                    abi_class = abi_class, location = abi_class == Class.integer ?
                            LocationKind.general_register : LocationKind
                                .vector_register, register_index = register_index, value_offset_bytes = index * 8,
                    size_bytes = this->piece_size(record.size_bytes, index),
                }) == this->no_id()) {
            return false;
        }
        function->return_piece_count += 1;
    }
    return true;
}

priv fn build_scalar_parameter(function: *Function, parameter: *Parameter, record: type_info::Record) -> bool {
    let abi_class: Class = this->scalar_class(record.kind);
    parameter->abi_class = abi_class;
    if (abi_class == Class.integer && function->general_register_count < AbiLimit.general_register_count as usize) {
        parameter->location = LocationKind.general_register;
        parameter->register_index = function->general_register_count;
        function->general_register_count += 1;
        return true;
    }
    if (abi_class == Class.sse && function->vector_register_count < AbiLimit.vector_register_count as usize) {
        parameter->location = LocationKind.vector_register;
        parameter->register_index = function->vector_register_count;
        function->vector_register_count += 1;
        return true;
    }
    var offset: usize = 0;
    var area_size: usize = 0;
    let total: usize = this->add_stack_area(function->stack_argument_size_bytes, 8, 8, &offset, &area_size);
    if (total == this->no_id()) {
        return false;
    }
    function->stack_argument_size_bytes = total;
    parameter->location = LocationKind.stack;
    parameter->stack_offset_bytes = offset;
    parameter->stack_size_bytes = area_size;
    return true;
}

priv fn build_aggregate_parameter(function: *Function, parameter: *Parameter, types: type_info::TypeTable const&,
    record: type_info::Record) -> bool {
    let classification: Classification = this->classify(types, parameter->type_id);
    var required_general: usize = 0;
    var required_vector: usize = 0;
    for (var index: usize = 0;
        index < classification.eightbyte_count && classification.first != Class.memory;
        index += 1) {
        if (this->piece_class(
                classification, index) == Class.integer) {
            required_general += 1;
        } else {
            required_vector += 1;
        }
    }
    let register_classification: bool = classification.first != Class.memory;
    let general_registers_fit: bool = required_general <=
        (AbiLimit.general_register_count as usize) - function->general_register_count;
    let vector_registers_fit: bool = required_vector <=
        (AbiLimit.vector_register_count as usize) - function->vector_register_count;
    let register_counts_fit: bool = general_registers_fit && vector_registers_fit;
    let registers_fit: bool = register_classification && register_counts_fit;
    if (!registers_fit) {
        var offset: usize = 0;
        var area_size: usize = 0;
        let total: usize =
            this->add_stack_area(
                function->stack_argument_size_bytes, record.size_bytes, record.alignment_bytes, &offset, &area_size);
        if (total == this->no_id()) {
            return false;
        }
        function->stack_argument_size_bytes = total;
        parameter->abi_class = Class.memory;
        parameter->location = LocationKind.stack;
        parameter->stack_offset_bytes = offset;
        parameter->stack_size_bytes = area_size;
        return true;
    }

    parameter->first_piece = this->piece_count();
    parameter->piece_count = classification.eightbyte_count;
    parameter->abi_class = classification.eightbyte_count == 1 ? classification.first : Class.no_class;
    parameter->location = LocationKind.invalid;
    for (var index: usize = 0; index < classification.eightbyte_count; index += 1) {
        let abi_class: Class = this->piece_class(classification, index);
        let is_integer: bool = abi_class == Class.integer;
        let register_index: usize = is_integer ? function->general_register_count : function->vector_register_count;
        if (is_integer) {
            function->general_register_count += 1;
        } else {
            function->vector_register_count += 1;
        }
        let location: LocationKind = is_integer ? LocationKind.general_register : LocationKind.vector_register;
        if (this->add_piece( {
                    abi_class = abi_class, location = location, register_index = register_index,
                    value_offset_bytes = index * 8, size_bytes = this->piece_size(record.size_bytes, index),
                }) == this->no_id()) {
            return false;
        }
    }
    return true;
}

priv fn build_parameter(function: *Function, ir_parameter: ir::Parameter,
    parameter_index: usize, types: type_info::TypeTable const&) -> bool {
    let records: *const type_info::Record = types.record_data() as *const type_info::Record;
    let record: type_info::Record = records[ir_parameter.type_id];
    let none: usize = this->no_id();
    var parameter: Parameter = {
        function_id = function->function_id, parameter_index = parameter_index,
        abi_class = Class.invalid, location = LocationKind.invalid,
        register_index = none, stack_offset_bytes = none, stack_size_bytes = 0, type_id = ir_parameter.type_id,
        size_bytes = record.size_bytes, alignment_bytes = record.alignment_bytes, first_piece = none, piece_count = 0,
        aggregate = type_info::is_memory(record.kind),
    };
    let built: bool = parameter.aggregate ? this->build_aggregate_parameter( function, &parameter, types, record) :
        this->build_scalar_parameter(function, &parameter, record);
    return built && this->add_parameter(parameter) != none;
}

priv fn finish_function(function: *Function) -> bool {
    function->call_frame_size_bytes = this->abi_align_up(function->stack_argument_size_bytes,
        AbiLimit.stack_alignment as usize);
    let frame_exists: bool = function->call_frame_size_bytes != this->no_id();
    let frame_is_bounded: bool = function->call_frame_size_bytes <= AbiLimit.maximum_stack_size as usize;
    let frame_is_valid: bool = frame_exists && frame_is_bounded;
    return frame_is_valid && this->add_function(*function) != this->no_id();
}

fn build(ir: ir::Store, types: type_info::TypeTable const&) -> bool {
    if (!ir_check::is_valid(ir, types)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let storage_is_empty: bool = this->functions.empty() && this->parameters.empty();
    if (!storage_is_empty || !this->pieces.empty()) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let functions: *const ir::Function = ir.functions.data as *const ir::Function;
    let parameters: *const ir::Parameter = ir.parameters.data as *const ir::Parameter;
    let none: usize = this->no_id();
    for (var function_id: usize = 0;
        function_id < ir.function_count && this->ready();
        function_id += 1) {
        let source: ir::Function = functions[function_id];
        var function: Function = {
            function_id = function_id, first_parameter = source.parameter_count == 0 ? none : this->parameter_count(),
            parameter_count = 0, first_return_piece = none, return_piece_count = 0, return_type = source.return_type,
            return_size_bytes = 0, return_alignment_bytes = 0, return_aggregate = false, hidden_return_pointer = false,
            general_register_count = 0, vector_register_count = 0, stack_argument_size_bytes = 0,
            call_frame_size_bytes = 0,
        };
        if (!this->build_return(&function, types)) {
            return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
        }
        for (var index: usize = 0;
            index < source.parameter_count && this->ready();
            index += 1) {
            if (!this->build_parameter(&function, parameters[source.first_parameter + index], index, types)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
            function.parameter_count += 1;
        }
        if (!this->finish_function(&function)) {
            return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
        }
    }
    let type_records: *const type_info::Record = types.record_data() as *const type_info::Record;
    let type_fields: *const type_info::Field = types.field_data() as *const type_info::Field;
    for (var signature_type: usize = 0;
        signature_type < types.size() && this->ready();
        signature_type += 1) {
        let record: type_info::Record = type_records[signature_type];
        if (record.kind != type_info::Kind.function_pointer) {
            continue;
        }
        var synthesized: Function = {
            function_id = none, first_parameter = record.field_count == 0 ? none : this->parameter_count(),
            parameter_count = 0, first_return_piece = none, return_piece_count = 0, return_type = record.element_type,
            return_size_bytes = 0, return_alignment_bytes = 0, return_aggregate = false, hidden_return_pointer = false,
            general_register_count = 0, vector_register_count = 0, stack_argument_size_bytes = 0,
            call_frame_size_bytes = 0,
        };
        if (!this->build_return(&synthesized, types)) {
            return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
        }
        for (var parameter_index: usize = 0;
            parameter_index < record.field_count && this->ready();
            parameter_index += 1) {
            var ir_parameter: ir::Parameter = {
                function_id = none, type_id = type_fields[ record.first_field + parameter_index].type_id,
                slot_id = none, name_token = none,
            };
            if (!this->build_parameter(&synthesized, ir_parameter, parameter_index, types)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
            synthesized.parameter_count += 1;
        }
        if (!this->finish_function(&synthesized)) {
            return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
        }
    }
    return this->ready();
}

fn is_valid(ir: ir::Store, types: type_info::TypeTable const&) const -> bool {
    if (!this->ready() || !this->storage_is_valid()) {
        return false;
    }
    if (!ir_check::is_valid(ir, types)) {
        return false;
    }
    return this->function_count() >= ir.function_count;
}

priv fn invalid_function() const
    -> Function {
    let none: usize = this->no_id();
    return {
        function_id = none, first_parameter = none, parameter_count = 0, first_return_piece = none,
        return_piece_count = 0, return_type = none, return_size_bytes = 0, return_alignment_bytes = 0,
        return_aggregate = false, hidden_return_pointer = false, general_register_count = 0, vector_register_count = 0,
        stack_argument_size_bytes = 0, call_frame_size_bytes = 0,
    };
}

priv fn invalid_parameter() const
    -> Parameter {
    let none: usize = this->no_id();
    return {
        function_id = none, parameter_index = none, abi_class = Class.invalid,
        location = LocationKind.invalid, register_index = none, stack_offset_bytes = none,
        stack_size_bytes = 0, type_id = none, size_bytes = 0, alignment_bytes = 0, first_piece = none, piece_count = 0,
        aggregate = false,
    };
}

priv fn invalid_piece() const
    -> Piece {
    return {
        abi_class = Class.invalid, location = LocationKind.invalid,
        register_index = this->no_id(), value_offset_bytes = 0, size_bytes = 0,
    };
}

fn function_at(function_id: usize) const -> FunctionResult {
    if (!this->storage_is_valid() || function_id >= this->function_count()) {
        return {
            function = this->invalid_function(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        function = this->functions.get(function_id), error = runtime::Error.none,
    };
}

fn parameter_at(parameter_id: usize) const -> ParameterResult {
    if (!this->storage_is_valid() || parameter_id >= this->parameter_count()) {
        return {
            parameter = this->invalid_parameter(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        parameter = this->parameters.get(parameter_id), error = runtime::Error.none,
    };
}

fn piece_at(piece_id: usize) const -> PieceResult {
    if (!this->storage_is_valid() || piece_id >= this->piece_count()) {
        return {
            piece = this->invalid_piece(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        piece = this->pieces.get(piece_id), error = runtime::Error.none,
    };
}

deinit() {
}

}
