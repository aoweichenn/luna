module luna.compiler.x86.codegen;

impl CodeGenerator {

priv fn emit_constant( instruction: ir::Instruction) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null) {
        return false;
    }
    switch (instruction.opcode) {
    case ir::Opcode.constant_null {
        this->literal("    xorq %rax, %rax\n");
        return this->ready() && this->store_rax(instruction.result, record);
    }
    case ir::Opcode.constant_boolean, ir::Opcode.constant_integer {
        let width: usize = this->bit_width(record);
        if (width <= 32) {
            this->literal("    movl $0x");
            this->hex(instruction.immediate & 4294967295, 8);
            this->literal(", %eax\n");
        } else {
            this->literal("    movabsq $0x");
            this->hex(instruction.immediate, 16);
            this->literal(", %rax\n");
        }
        if (!this->ready()) {
            return false;
        }
        return this->store_rax(instruction.result, record);
    }
    case ir::Opcode.constant_float {
        if (record->kind == type_info::Kind.float_32) {
            let value: f32 = instruction.floating as f32;
            let bits: u32 = *((&value) as *const f32 as *const u32);
            this->literal("    movl $0x");
            this->hex(bits as u64, 8);
            this->literal(", %eax\n    movl %eax, ");
            this->append_value(instruction.result);
            this->literal("\n");
            return this->ready();
        }
        let bits: u64 = *((&instruction.floating) as *const f64 as *const u64);
        this->literal("    movabsq $0x");
        this->hex(bits, 16);
        this->literal(", %rax\n    movq %rax, ");
        this->append_value(instruction.result);
        this->literal("\n");
        return this->ready();
    }
    default {
        return this->fail( runtime::Error.invalid_argument);
    }
    }
}

priv fn emit_address( instruction: ir::Instruction) -> bool {
    switch (instruction.opcode) {
    case ir::Opcode.address_of_slot {
        this->literal("    leaq ");
        this->append_slot(instruction.auxiliary);
        this->literal(", %rax\n");
        return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
    }
    case ir::Opcode.global_address {
        this->literal("    leaq ");
        this->append_global_label(instruction.auxiliary);
        this->literal("(%rip), %rax\n");
        return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
    }
    case ir::Opcode.function_address {
        this->literal("    leaq ");
        this->append_function_symbol(instruction.auxiliary);
        this->literal("(%rip), %rax\n");
        return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
    }
    case ir::Opcode.member_address {
        if (!this->load_rax(instruction.left, this->type(instruction.type_id))) {
            return false;
        }
        this->literal("    addq $");
        this->append_usize(instruction.auxiliary);
        this->literal(", %rax\n");
        return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
    }
    case ir::Opcode.pointer_offset {
        let values: *const ir::Value = this->ir.values.data as *const ir::Value;
        let left_record: *const type_info::Record = this->type( values[instruction.left].type_id);
        let index_record: *const type_info::Record = this->type( values[instruction.right].type_id);
        if (left_record == null || index_record == null) {
            return false;
        }
        let base_is_valid: bool = left_record->kind == type_info::Kind.pointer ||
            left_record->kind == type_info::Kind.array;
        if (!base_is_valid || instruction.auxiliary == 0) {
            return false;
        }
        if (!this->load_rax(instruction.left, left_record) || !this->load_rcx(instruction.right, index_record)) {
            return false;
        }
        this->literal("    movabsq $0x");
        this->hex(instruction.auxiliary as u64, 16);
        this->literal(", %rdx\n    imulq %rdx, %rcx\n    addq %rcx, %rax\n");
        return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
    }
    default {
        return this->fail( runtime::Error.invalid_argument);
    }
    }
}

priv fn emit_zero( instruction: ir::Instruction) -> bool {
    let slot: Storage = this->storage( StorageKind.slot, instruction.auxiliary);
    if (this->error != runtime::Error.none) {
        return false;
    }
    this->literal("    leaq ");
    this->append_stack(slot);
    this->literal(", %rdi\n    xorl %eax, %eax\n    movq $");
    this->append_usize(slot.size_bytes);
    this->literal(", %rcx\n    rep stosb\n");
    return this->ready();
}

priv fn emit_memory_copy( instruction: ir::Instruction, instruction_id: usize) -> bool {
    let values: *const ir::Value = this->ir.values.data as *const ir::Value;
    let pointer_record: *const type_info::Record = this->type( values[instruction.left].type_id);
    if (pointer_record == null) {
        return false;
    }
    if (!this->load_integer(instruction.left, pointer_record, "%edi", "%rdi", false) ||
        !this->load_integer(instruction.right, pointer_record, "%esi", "%rsi", false)) {
        return false;
    }
    this->literal("    movabsq $0x");
    this->hex(instruction.auxiliary as u64, 16);
    this->literal(", %rcx\n    cmpq %rsi, %rdi\n    jbe ");
    this->instruction_label(instruction_id, "copy_forward");
    this->literal("\n    leaq (%rsi,%rcx), %rax\n    cmpq %rax, %rdi\n    jae ");
    this->instruction_label(instruction_id, "copy_forward");
    this->literal("\n    testq %rcx, %rcx\n    je ");
    this->instruction_label(instruction_id, "copy_done");
    this->literal("\n    leaq -1(%rsi,%rcx), %rsi\n    leaq -1(%rdi,%rcx), %rdi\n");
    this->literal("    std\n    rep movsb\n    cld\n    jmp ");
    this->instruction_label(instruction_id, "copy_done");
    this->literal("\n");
    this->instruction_label(instruction_id, "copy_forward");
    this->literal(":\n    cld\n    rep movsb\n");
    this->instruction_label(instruction_id, "copy_done");
    this->literal(":\n");
    return this->ready();
}

priv fn indirect_load_mnemonic(record: *const type_info::Record) -> *const u8 {
    if (record == null) {
        return null;
    }
    switch (record->kind) {
    case type_info::Kind.float_32 {
        return "movss";
    }
    case type_info::Kind.float_64 {
        return "movsd";
    }
    default {}
    }
    let width: usize = this->bit_width(record);
    switch (width) {
    case 8 {
        return "movzbl";
    }
    case 16 {
        return "movzwl";
    }
    case 32 {
        return "movl";
    }
    case 64 {
        return "movq";
    }
    default {
        return null;
    }
    }
}

priv fn emit_load_indirect( instruction: ir::Instruction) -> bool {
    let values: *const ir::Value = this->ir.values.data as *const ir::Value;
    let pointer_record: *const type_info::Record = this->type( values[instruction.left].type_id);
    let record: *const type_info::Record = this->type( instruction.type_id);
    let mnemonic: *const u8 = this->indirect_load_mnemonic(record);
    if (pointer_record == null || record == null) {
        return false;
    }
    if (mnemonic == null || !this->load_rax(instruction.left, pointer_record)) {
        return false;
    }
    if (type_info::is_float(record->kind)) {
        this->literal("    ");
        this->literal(mnemonic);
        this->literal(" (%rax), %xmm0\n");
        return this->ready() && this->store_xmm(instruction.result, record, "%xmm0");
    }
    this->literal("    ");
    this->literal(mnemonic);
    this->literal(" (%rax), ");
    this->literal(this->bit_width(record) <= 32 ? "%eax\n" : "%rax\n");
    if (!this->ready()) {
        return false;
    }
    if (record->kind == type_info::Kind.boolean) {
        this->literal("    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n");
    }
    return this->ready() && this->store_rax(instruction.result, record);
}

priv fn emit_store_indirect( instruction: ir::Instruction) -> bool {
    let values: *const ir::Value = this->ir.values.data as *const ir::Value;
    let pointer_record: *const type_info::Record = this->type( values[instruction.left].type_id);
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (pointer_record == null || record == null) {
        return false;
    }
    if (!this->load_rax(instruction.left, pointer_record)) {
        return false;
    }
    if (type_info::is_float(record->kind)) {
        if (!this->load_xmm(instruction.right, record, "%xmm0")) {
            return false;
        }
        this->literal("    ");
        this->literal(this->float_move(record));
        this->literal(" %xmm0, (%rax)\n");
        return this->ready();
    }
    if (!this->load_rcx( instruction.right, record)) {
        return false;
    }
    let width: usize = this->bit_width(record);
    return this->literal( width == 8 ? "    movb %cl, (%rax)\n" : width == 16 ? "    movw %cx, (%rax)\n" :
            width == 32 ? "    movl %ecx, (%rax)\n" : "    movq %rcx, (%rax)\n");
}

priv fn emit_slot_access( instruction: ir::Instruction) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null) {
        return false;
    }
    if (instruction.opcode == ir::Opcode.load) {
        if (type_info::is_float(record->kind)) {
            this->literal("    ");
            this->literal(this->float_move(record));
            this->literal(" ");
            this->append_slot(instruction.auxiliary);
            this->literal(", %xmm0\n");
            return this->ready() && this->store_xmm(instruction.result, record, "%xmm0");
        }
        let width: usize = this->bit_width(record);
        this->literal(width <= 32 ? "    movl " : "    movq ");
        this->append_slot(instruction.auxiliary);
        this->literal(width <= 32 ? ", %eax\n" : ", %rax\n");
        if (!this->ready()) {
            return false;
        }
        if (record->kind == type_info::Kind.boolean) {
            this->literal("    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n");
        }
        return this->ready() && this->store_rax(instruction.result, record);
    }
    if (instruction.opcode == ir::Opcode.store) {
        if (type_info::is_float(record->kind)) {
            if (!this->load_xmm(instruction.left, record, "%xmm0")) {
                return false;
            }
            this->literal("    ");
            this->literal(this->float_move(record));
            this->literal(" %xmm0, ");
            this->append_slot(instruction.auxiliary);
            this->literal("\n");
            return this->ready();
        }
        let width: usize = this->bit_width(record);
        if (!this->load_rax(instruction.left, record)) {
            return false;
        }
        this->literal(width <= 32 ? "    movl %eax, " : "    movq %rax, ");
        this->append_slot(instruction.auxiliary);
        this->literal("\n");
        return this->ready();
    }
    return this->fail( runtime::Error.invalid_argument);
}

priv fn emit_check( instruction: ir::Instruction, instruction_id: usize) -> bool {
    let values: *const ir::Value = this->ir.values.data as *const ir::Value;
    let left_record: *const type_info::Record = this->type( values[instruction.left].type_id);
    if (left_record == null || !this->load_rax( instruction.left, left_record)) {
        return false;
    }
    if (instruction.opcode == ir::Opcode.null_check) {
        this->literal("    testq %rax, %rax\n    jne ");
        this->instruction_label(instruction_id, "check_ok");
        this->literal("\n    ud2\n");
        this->instruction_label(instruction_id, "check_ok");
        this->literal(":\n");
        return this->ready();
    }
    let right_record: *const type_info::Record = this->type( values[instruction.right].type_id);
    if (right_record == null || !this->load_rcx(instruction.right, right_record)) {
        return false;
    }
    this->literal("    cmpq %rcx, %rax\n    jb ");
    this->instruction_label(instruction_id, "check_ok");
    this->literal("\n    ud2\n");
    this->instruction_label(instruction_id, "check_ok");
    this->literal(":\n");
    return this->ready();
}

priv fn emit_unary( instruction: ir::Instruction) -> bool {
    let values: *const ir::Value = this->ir.values.data as *const ir::Value;
    let record: *const type_info::Record = this->type( values[instruction.left].type_id);
    if (record == null) {
        return false;
    }
    if (instruction.opcode == ir::Opcode.boolean_not) {
        if (!this->load_rax(instruction.left, record)) {
            return false;
        }
        this->literal("    testl %eax, %eax\n    sete %al\n    movzbl %al, %eax\n");
        return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
    }
    if (instruction.opcode == ir::Opcode.unary_float) {
        let width: usize = this->bit_width(record);
        if (!this->load_rax(instruction.left, record)) {
            return false;
        }
        this->literal(width == 32 ? "    xorl $0x80000000, %eax\n" :
            "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, %rax\n");
        return this->ready() && this->store_rax(instruction.result, record);
    }
    let width: usize = this->bit_width(record);
    let mnemonic: *const u8 = instruction.operation == lexer::TokenKind.minus ? (width <= 32 ? "    negl %eax\n" :
                "    negq %rax\n") : (width <= 32 ? "    notl %eax\n" : "    notq %rax\n");
    if (!this->load_rax(instruction.left, record)) {
        return false;
    }
    this->literal(mnemonic);
    return this->ready() && this->store_rax(instruction.result, record);
}

priv fn binary_mnemonic(operation: lexer::TokenKind, width: usize) -> *const u8 {
    switch (operation) {
    case lexer::TokenKind.plus {
        return width <= 32 ? "addl" : "addq";
    }
    case lexer::TokenKind.minus {
        return width <= 32 ? "subl" : "subq";
    }
    case lexer::TokenKind.star {
        return width <= 32 ? "imull" : "imulq";
    }
    case lexer::TokenKind.ampersand {
        return width <= 32 ? "andl" : "andq";
    }
    case lexer::TokenKind.pipe {
        return width <= 32 ? "orl" : "orq";
    }
    case lexer::TokenKind.caret {
        return width <= 32 ? "xorl" : "xorq";
    }
    default {
        return null;
    }
    }
}

priv fn emit_division( instruction: ir::Instruction, record: *const type_info::Record, instruction_id: usize) -> bool {
    let width: usize = this->bit_width(record);
    let signed_value: bool = this->is_signed( record);
    if (width < 32 && signed_value) {
        if (!this->load_integer(instruction.left, record, "%eax", "%rax", true) ||
            !this->load_integer(instruction.right, record, "%ecx", "%rcx", true)) {
            return false;
        }
        this->literal(width == 8 ? "    cmpl $-128, %eax\n" : "    cmpl $-32768, %eax\n");
        this->literal("    jne ");
        this->instruction_label(instruction_id, "division_safe");
        this->literal("\n    cmpl $-1, %ecx\n    jne ");
        this->instruction_label(instruction_id, "division_safe");
        this->literal("\n    xorl %edx, %edx\n    xorl %ecx, %ecx\n    divl %ecx\n");
        this->instruction_label(instruction_id, "division_safe");
        this->literal(":\n    cltd\n    idivl %ecx\n");
        if (!this->ready()) {
            return false;
        }
    } else {
        if (!this->load_rax( instruction.left, record) || !this->load_rcx( instruction.right, record)) {
            return false;
        }
        if (width <= 32) {
            if (!this->literal( signed_value ? "    cltd\n    idivl %ecx\n" : "    xorl %edx, %edx\n    divl %ecx\n")) {
                return false;
            }
        } else if (!this->literal( signed_value ? "    cqto\n    idivq %rcx\n" :
            "    xorq %rdx, %rdx\n    divq %rcx\n")) {
            return false;
        }
    }
    if (instruction.operation == lexer::TokenKind.percent) {
        this->literal(width <= 32 ? "    movl %edx, %eax\n" : "    movq %rdx, %rax\n");
    }
    return this->ready() && this->store_rax(instruction.result, record);
}

priv fn emit_binary_integer( instruction: ir::Instruction, instruction_id: usize) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null) {
        return false;
    }
    let width: usize = this->bit_width(record);
    if (instruction.operation == lexer::TokenKind.slash || instruction.operation == lexer::TokenKind.percent) {
        return this->emit_division( instruction, record, instruction_id);
    }
    if (instruction.operation == lexer::TokenKind.shift_left || instruction.operation == lexer::TokenKind.shift_right) {
        let signed_narrow_right: bool = instruction.operation == lexer::TokenKind.shift_right &&
            this->is_signed( record) && width < 32;
        if (!(signed_narrow_right ? this->load_integer( instruction.left, record, "%eax", "%rax", true) :
                this->load_rax( instruction.left, record)) || !this->load_rcx( instruction.right, record)) {
            return false;
        }
        if (width < 32) {
            this->literal("    andl $");
            this->append_usize(width - 1);
            this->literal(", %ecx\n");
            if (!this->ready()) {
                return false;
            }
        }
        let mnemonic: *const u8 = instruction.operation == lexer::TokenKind.shift_left ?
                (width <= 32 ? "    shll %cl, %eax\n" : "    shlq %cl, %rax\n") : (this->is_signed( record) ?
                    (width <= 32 ? "    sarl %cl, %eax\n" : "    sarq %cl, %rax\n") : (width <= 32 ?
                        "    shrl %cl, %eax\n" : "    shrq %cl, %rax\n"));
        return this->literal( mnemonic) && this->store_rax( instruction.result, record);
    }
    let mnemonic: *const u8 = this->binary_mnemonic(instruction.operation, width);
    if (mnemonic == null) {
        return false;
    }
    if (!this->load_rax(instruction.left, record) || !this->load_rcx(instruction.right, record)) {
        return false;
    }
    this->literal("    ");
    this->literal(mnemonic);
    this->literal(" ");
    this->literal(width <= 32 ? "%ecx, %eax\n" : "%rcx, %rax\n");
    return this->ready() && this->store_rax(instruction.result, record);
}

priv fn float_binary_mnemonic(instruction: ir::Instruction, record: *const type_info::Record) -> *const u8 {
    let single_precision: bool = record->kind == type_info::Kind.float_32;
    switch (instruction.opcode) {
    case ir::Opcode.float_min {
        return single_precision ? "minss" : "minsd";
    }
    case ir::Opcode.float_max {
        return single_precision ? "maxss" : "maxsd";
    }
    default {
        switch (instruction.operation) {
        case lexer::TokenKind.plus {
            return single_precision ? "addss" : "addsd";
        }
        case lexer::TokenKind.minus {
            return single_precision ? "subss" : "subsd";
        }
        case lexer::TokenKind.star {
            return single_precision ? "mulss" : "mulsd";
        }
        case lexer::TokenKind.slash {
            return single_precision ? "divss" : "divsd";
        }
        default {
            return null;
        }
        }
    }
    }
}

priv fn emit_binary_float( instruction: ir::Instruction) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null || !this->load_xmm( instruction.left, record, "%xmm0")) {
        return false;
    }
    let mnemonic: *const u8 = this->float_binary_mnemonic(instruction, record);
    if (mnemonic == null) {
        return false;
    }
    this->literal("    ");
    this->literal(mnemonic);
    this->literal(" ");
    this->append_value(instruction.right);
    this->literal(", %xmm0\n");
    return this->ready() && this->store_xmm(instruction.result, record, "%xmm0");
}

priv fn emit_float_sqrt( instruction: ir::Instruction) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null || !this->load_xmm(instruction.left, record, "%xmm0")) {
        return false;
    }
    this->literal(record->kind == type_info::Kind.float_32 ? "    sqrtss %xmm0, %xmm0\n" : "    sqrtsd %xmm0, %xmm0\n");
    return this->ready() && this->store_xmm(instruction.result, record, "%xmm0");
}

// 读取紧邻的 64 位 add/sub/imul 留下的标志；auxiliary 非零选择有符号溢出标志，
// 否则选择进位标志。算术指令与该 setcc 之间只发射不改变标志的 mov。
priv fn emit_overflow_flag( instruction: ir::Instruction) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null) {
        return false;
    }
    this->literal(instruction.auxiliary != 0 ? "    seto %al\n" : "    setc %al\n");
    this->literal("    movzbl %al, %eax\n");
    return this->ready() && this->store_rax(instruction.result, record);
}

priv fn condition(operation: lexer::TokenKind, signed_value: bool) -> *const u8 {
    switch (operation) {
    case lexer::TokenKind.equal_equal {
        return "sete";
    }
    case lexer::TokenKind.bang_equal {
        return "setne";
    }
    case lexer::TokenKind.less {
        return signed_value ? "setl" : "setb";
    }
    case lexer::TokenKind.less_equal {
        return signed_value ? "setle" : "setbe";
    }
    case lexer::TokenKind.greater {
        return signed_value ? "setg" : "seta";
    }
    case lexer::TokenKind.greater_equal {
        return signed_value ? "setge" : "setae";
    }
    default {
        return null;
    }
    }
}

priv fn emit_compare_float( instruction: ir::Instruction, record: *const type_info::Record) -> bool {
    if (!this->load_xmm(instruction.left, record, "%xmm0")) {
        return false;
    }
    this->literal(record->kind == type_info::Kind.float_32 ? "    ucomiss " : "    ucomisd ");
    this->append_value(instruction.right);
    this->literal(", %xmm0\n");
    if (!this->ready()) {
        return false;
    }
    var sequence: *const u8 = null;
    switch (instruction.operation) {
    case lexer::TokenKind.equal_equal {
        sequence = "    sete %al\n    setnp %cl\n    andb %cl, %al\n";
    }
    case lexer::TokenKind.bang_equal {
        sequence = "    setne %al\n    setp %cl\n    orb %cl, %al\n";
    }
    case lexer::TokenKind.less {
        sequence = "    setb %al\n    setnp %cl\n    andb %cl, %al\n";
    }
    case lexer::TokenKind.less_equal {
        sequence = "    setbe %al\n    setnp %cl\n    andb %cl, %al\n";
    }
    case lexer::TokenKind.greater {
        sequence = "    seta %al\n";
    }
    case lexer::TokenKind.greater_equal {
        sequence = "    setae %al\n";
    }
    default {
        return false;
    }
    }
    this->literal(sequence);
    this->literal("    movzbl %al, %eax\n");
    return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
}

priv fn emit_compare( instruction: ir::Instruction) -> bool {
    let values: *const ir::Value = this->ir.values.data as *const ir::Value;
    let record: *const type_info::Record = this->type( values[instruction.left].type_id);
    if (record == null) {
        return false;
    }
    if (type_info::is_float(record->kind)) {
        return this->emit_compare_float( instruction, record);
    }
    let condition: *const u8 = this->condition(instruction.operation, this->is_signed( record));
    let width: usize = this->bit_width(record);
    if (condition == null) {
        return this->fail( runtime::Error.invalid_argument);
    }
    if (this->is_signed( record) && width < 32) {
        if (!this->load_integer( instruction.left, record, "%eax", "%rax", true) ||
            !this->load_integer(instruction.right, record, "%ecx", "%rcx", true)) {
            return false;
        }
        this->literal("    cmpl %ecx, %eax\n");
    } else {
        if (!this->load_rax(instruction.left, record) || !this->load_rcx(instruction.right, record)) {
            return false;
        }
        this->literal(width <= 32 ? "    cmpl %ecx, %eax\n" : "    cmpq %rcx, %rax\n");
    }
    this->literal("    ");
    this->literal(condition);
    this->literal(" %al\n    movzbl %al, %eax\n");
    return this->ready() && this->store_rax(instruction.result, this->type(instruction.type_id));
}


}
