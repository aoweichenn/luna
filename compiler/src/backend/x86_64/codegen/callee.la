module luna.compiler.x86.codegen;


impl CodeGenerator {
    priv fn emit_parameter_register( parameter: Parameter, ir_parameter: ir::Parameter) -> bool {
    let record: *const type_info::Record = this->type( parameter.type_id);
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        this->literal("    leaq ");
        this->append_slot(ir_parameter.slot_id);
        this->literal(", %r11\n");
        if (!this->ready()) {
            return false;
        }
        let pieces: *const Piece = this->abi.piece_data();
        for (var index: usize = 0; index < parameter.piece_count; index += 1) {
            let piece: Piece = pieces[parameter.first_piece + index];
            if (piece.abi_class == Class.integer) {
                let source: *const u8 = this->general_register_64(piece.register_index);
                if (source == null || !this->emit_store_piece( piece, source)) {
                    return false;
                }
            } else {
                let source: *const u8 = this->vector_register(piece.register_index);
                let width_is_valid: bool = piece.size_bytes == 4 || piece.size_bytes == 8;
                if (source == null || !width_is_valid) {
                    return false;
                }
                this->literal(piece.size_bytes == 4 ? "    movss " : "    movq ");
                this->literal(source);
                this->literal(", ");
                this->append_usize(piece.value_offset_bytes);
                this->literal("(%r11)\n");
                if (!this->ready()) {
                    return false;
                }
            }
        }
        return true;
    }
    if (parameter.location == LocationKind.vector_register) {
        let source: *const u8 = this->vector_register(parameter.register_index);
        if (source == null) {
            return false;
        }
        this->literal("    ");
        this->literal(this->float_move(record));
        this->literal(" ");
        this->literal(source);
        this->literal(", ");
        this->append_slot(ir_parameter.slot_id);
        this->literal("\n");
        return this->ready();
    }
    let width: usize = this->bit_width(record);
    let source: *const u8 = width <= 32 ? this->general_register_32(parameter.register_index) :
            this->general_register_64(parameter.register_index);
    if (source == null) {
        return false;
    }
    this->literal(width <= 32 ? "    movl " : "    movq ");
    this->literal(source);
    this->literal(", ");
    this->append_slot(ir_parameter.slot_id);
    this->literal("\n");
    return this->ready();
}

// 把入参寄存器保存到 frame 的 176 字节 System V register save area：通用寄存器固定放在
// +0..+40；仅当 caller 设置 %al 时，xmm0-7 才写入 +48..+175 的 16 字节槽。每个 SSE 槽
// 只会读取低 8 字节（f64/f32），因此 movq 已足够。
priv fn emit_register_save( function_id: usize) -> bool {
    let storage: Storage = this->storage( StorageKind.register_save_area, function_id);
    if (this->error != runtime::Error.none) {
        return false;
    }
    this->literal("    leaq ");
    this->append_stack(storage);
    this->literal(", %r11\n");
    if (!this->ready()) {
        return false;
    }
    for (var index: usize = 0; index < (CodegenLimit.general_argument_registers as usize); index += 1) {
        let source: *const u8 = this->general_register_64(index);
        if (source == null) {
            return false;
        }
        this->literal("    movq ");
        this->literal(source);
        this->literal(", ");
        this->append_usize(index * 8);
        this->literal("(%r11)\n");
        if (!this->ready()) {
            return false;
        }
    }
    this->literal("    testb %al, %al\n    je .Lbf");
    this->append_usize(function_id);
    this->literal("_va_save\n");
    if (!this->ready()) {
        return false;
    }
    for (var index: usize = 0; index < (CodegenLimit.vector_argument_registers as usize); index += 1) {
        let source: *const u8 = this->vector_register(index);
        if (source == null) {
            return false;
        }
        this->literal("    movq ");
        this->literal(source);
        this->literal(", ");
        this->append_usize(48 + index * 16);
        this->literal("(%r11)\n");
        if (!this->ready()) {
            return false;
        }
    }
    this->literal(".Lbf");
    this->append_usize(function_id);
    this->literal("_va_save:\n");
    return this->ready();
}

priv fn emit_va_start( instruction: ir::Instruction) -> bool {
    let values: *const ir::Value = this->ir.values as *const ir::Value;
    let abi_functions: *const Function = this->abi.function_data();
    let function_abi: Function = abi_functions[this->current_function];
    let storage: Storage = this->storage( StorageKind.register_save_area, this->current_function);
    if (this->error != runtime::Error.none ||
        !this->load_rax( instruction.left, this->type( values[instruction.left].type_id))) {
        return false;
    }
    // %rax 保存 va_list 地址。gp_offset/fp_offset 精确跳过具名寄存器参数；
    // general_register_count 已包含隐藏返回指针。overflow area 从具名栈参数之后开始，
    // save area 指向当前 frame 的序言保存槽。
    this->literal("    movl $");
    this->append_usize(function_abi.general_register_count * 8);
    this->literal(", 0(%rax)\n    movl $");
    this->append_usize(48 + function_abi.vector_register_count * 16);
    this->literal(", 4(%rax)\n    leaq ");
    this->append_usize(16 + function_abi.stack_argument_size_bytes);
    this->literal("(%rbp), %r10\n    movq %r10, 8(%rax)\n    leaq ");
    this->append_stack(storage);
    this->literal(", %r10\n    movq %r10, 16(%rax)\n");
    return this->ready();
}

priv fn emit_va_arg( instruction: ir::Instruction, instruction_id: usize) -> bool {
    let record: *const type_info::Record = this->type( instruction.type_id);
    if (record == null) {
        return false;
    }
    this->literal("    movq ");
    this->append_value(instruction.left);
    this->literal(", %r11\n");
    if (!this->ready()) {
        return false;
    }
    if (type_info::is_float(record->kind)) {
        // SSE class 在 fp_offset 小于 176 时使用 16 字节 save slot；f32 读取低 4 字节，
        // f64 读取低 8 字节。超过该范围后使用 8 字节 overflow slot。
        this->literal("    movl 4(%r11), %eax\n    cmpl $176, %eax\n    jae ");
        this->instruction_label(instruction_id, "va_overflow");
        this->literal("\n    movq 16(%r11), %r10\n    ");
        this->literal(this->float_move(record));
        this->literal(" (%r10,%rax), %xmm0\n    addl $16, 4(%r11)\n    jmp ");
        this->instruction_label(instruction_id, "va_done");
        this->literal("\n");
        this->instruction_label(instruction_id, "va_overflow");
        this->literal(":\n    movq 8(%r11), %r10\n    ");
        this->literal(this->float_move(record));
        this->literal(" (%r10), %xmm0\n    addq $8, %r10\n    movq %r10, 8(%r11)\n");
        this->instruction_label(instruction_id, "va_done");
        this->literal(":\n");
        if (!this->ready()) {
            return false;
        }
        return this->store_xmm( instruction.result, record, "%xmm0");
    }
    // INTEGER class 在 gp_offset 小于 48 时使用 8 字节通用寄存器 save slot，之后转到
    // overflow area。Luna 按声明宽度传递可变参数，不执行 C 默认参数提升；va_arg 也按请求
    // 宽度读取，这是有意保留的语言差异。
    this->literal("    movl 0(%r11), %eax\n    cmpl $48, %eax\n    jae ");
    this->instruction_label(instruction_id, "va_overflow");
    this->literal("\n    movq 16(%r11), %r10\n    movq (%r10,%rax), %rax\n    addl $8, 0(%r11)\n    jmp ");
    this->instruction_label(instruction_id, "va_done");
    this->literal("\n");
    this->instruction_label(instruction_id, "va_overflow");
    this->literal(":\n    movq 8(%r11), %r10\n    movq (%r10), %rax\n    addq $8, %r10\n    movq %r10, 8(%r11)\n");
    this->instruction_label(instruction_id, "va_done");
    this->literal(":\n");
    if (!this->ready()) {
        return false;
    }
    return this->store_rax( instruction.result, record);
}

priv fn emit_parameter_stack( parameter: Parameter, ir_parameter: ir::Parameter) -> bool {
    let record: *const type_info::Record = this->type( parameter.type_id);
    let source_offset: usize = parameter.stack_offset_bytes + 16;
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        this->literal("    leaq ");
        this->append_usize(source_offset);
        this->literal("(%rbp), %rsi\n    leaq ");
        this->append_slot(ir_parameter.slot_id);
        this->literal(", %rdi\n    movq $");
        this->append_usize(parameter.size_bytes);
        this->literal(", %rcx\n    cld\n    rep movsb\n");
        return this->ready();
    }
    if (type_info::is_float(record->kind)) {
        this->literal("    ");
        this->literal(this->float_move(record));
        this->literal(" ");
        this->append_usize(source_offset);
        this->literal("(%rbp), %xmm15\n    ");
        this->literal(this->float_move(record));
        this->literal(" %xmm15, ");
        this->append_slot(ir_parameter.slot_id);
        this->literal("\n");
        return this->ready();
    }
    let width: usize = this->bit_width(record);
    this->literal(width <= 32 ? "    movl " : "    movq ");
    this->append_usize(source_offset);
    this->literal(width <= 32 ? "(%rbp), %eax\n    movl %eax, " : "(%rbp), %rax\n    movq %rax, ");
    this->append_slot(ir_parameter.slot_id);
    this->literal("\n");
    return this->ready();
}

priv fn emit_parameters( function: ir::Function, function_abi: Function) -> bool {
    let parameters: *const Parameter = this->abi.parameter_data();
    let ir_parameters: *const ir::Parameter = this->ir.parameters as
            *const ir::Parameter;
    if (function_abi.hidden_return_pointer) {
        let storage: Storage = this->storage( StorageKind.hidden_return_pointer, this->current_function);
        if (this->error != runtime::Error.none) {
            return false;
        }
        this->literal("    movq %rdi, ");
        this->append_stack(storage);
        this->literal("\n");
        if (!this->ready()) {
            return false;
        }
    }
    for (var phase: usize = 0; phase < 2; phase += 1) {
        for (var index: usize = 0; index < function.parameter_count; index += 1) {
            let parameter: Parameter = parameters[function_abi.first_parameter + index];
            let is_stack: bool = parameter.location == LocationKind.stack;
            let emit_in_phase: bool = phase == 0 ? !is_stack : is_stack;
            if (emit_in_phase) {
                let ir_parameter: ir::Parameter = ir_parameters[ function.first_parameter + index];
                let emitted: bool = is_stack ? this->emit_parameter_stack( parameter, ir_parameter) :
                    this->emit_parameter_register( parameter, ir_parameter);
                if (!emitted) {
                    return false;
                }
            }
        }
    }
    return true;
}

priv fn emit_return( instruction: ir::Instruction) -> bool {
    let functions: *const ir::Function = this->ir.functions as
            *const ir::Function;
    let abi_functions: *const Function = this->abi.function_data();
    let function: ir::Function = functions[this->current_function];
    let function_abi: Function = abi_functions[this->current_function];
    let record: *const type_info::Record = this->type( function.return_type);
    if (record == null) {
        return false;
    }
    if (instruction.opcode == ir::Opcode.return_value && function_abi.return_aggregate) {
        if (!this->load_rax( instruction.left, record) || !this->literal( "    movq %rax, %r11\n")) {
            return false;
        }
        if (function_abi.hidden_return_pointer) {
            let hidden: Storage = this->storage( StorageKind.hidden_return_pointer, this->current_function);
            if (this->error != runtime::Error.none) {
                return false;
            }
            this->literal("    movq ");
            this->append_stack(hidden);
            this->literal(", %rdi\n    movq %rdi, %rax\n    movq %r11, %rsi\n    movq $");
            this->append_usize(function_abi.return_size_bytes);
            this->literal(", %rcx\n    cld\n    rep movsb\n");
            if (!this->ready()) {
                return false;
            }
        } else {
            let pieces: *const Piece = this->abi.piece_data();
            for (var reverse: usize = function_abi.return_piece_count; reverse != 0; reverse -= 1) {
                let piece: Piece = pieces[ function_abi.first_return_piece + reverse - 1];
                if (piece.abi_class == Class.integer) {
                    let destination: *const u8 = this->return_general_register(piece.register_index);
                    if (destination == null || !this->emit_load_piece( piece, destination)) {
                        return false;
                    }
                } else {
                    let destination: *const u8 = this->vector_register(piece.register_index);
                    let width_is_valid: bool = piece.size_bytes == 4 || piece.size_bytes == 8;
                    if (destination == null || !width_is_valid) {
                        return false;
                    }
                    this->literal(piece.size_bytes == 4 ? "    movss " : "    movq ");
                    this->append_usize(piece.value_offset_bytes);
                    this->literal("(%r11), ");
                    this->literal(destination);
                    this->literal("\n");
                    if (!this->ready()) {
                        return false;
                    }
                }
            }
        }
    } else if (instruction.opcode == ir::Opcode.return_value) {
        if (type_info::is_float(record->kind)) {
            if (!this->load_xmm( instruction.left, record, "%xmm0")) {
                return false;
            }
        } else if (!this->load_rax( instruction.left, record)) {
            return false;
        }
    }
    this->literal("    jmp ");
    this->return_label();
    this->literal("\n");
    return this->ready();
}

}
