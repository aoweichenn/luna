module luna.compiler.x86.codegen;


impl CodeGenerator {
    init(semantic_input: context::InputView, source: ir::Module const&, types: type_info::TypeTable const&):
            semantic_input = semantic_input, abi = AbiLayout(), frames = FramePlan(), assembly = strings::string() {
        this->ir = source.view();
        this->types = &types;
        this->current_function = this->no_id();
        this->call_frame_depth = 0;
        this->error = runtime::Error.none;
    }

    fn run() {
        if (!this->semantic_input.is_valid()) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        if (!this->abi.build(this->ir, *this->types)) {
            this->fail(this->abi.error());
            return;
        }
        if (!this->frames.build(this->ir, *this->types, this->abi)) {
            this->fail(this->frames.error());
            return;
        }
        this->emit_module();
    }

    fn take_result() -> BackendResult {
        if (this->error != runtime::Error.none) {
            return {assembly = bytes::empty(), error = this->error};
        }
        let assembly_size: usize = this->assembly.size();
        let assembly_capacity: usize = this->assembly.capacity() + 1;
        let assembly_data: *u8 = this->assembly.detach();
        let result: BackendResult = {
            assembly = {data = assembly_data, length = assembly_size, capacity = assembly_capacity},
            error = runtime::Error.none,
        };
        return result;
    }

    deinit() {
    }
}

fn backend_empty() -> BackendResult {
    return {assembly = bytes::empty(), error = runtime::Error.none};
}

fn backend_is_success(
    result: BackendResult, semantic_input: context::InputView,
    source: ir::Module const&, types: type_info::TypeTable const&) -> bool {
    let assembly_is_valid: bool = result.error == runtime::Error.none && result.assembly.length != 0;
    let input_is_valid: bool = semantic_input.is_valid() && source.is_valid(types);
    if (!assembly_is_valid || !input_is_valid) {
        return false;
    }
    return bytes::is_valid(result.assembly);
}

fn emit_assembly(
    semantic_input: context::InputView,
    source: ir::Module const&, types: type_info::TypeTable const&) -> BackendResult {
    if (!source.is_valid(types)) {
        return {assembly = bytes::empty(), error = runtime::Error.invalid_argument};
    }
    var generator: CodeGenerator = CodeGenerator(semantic_input, source, types);
    generator.run();
    return generator.take_result();
}

fn backend_release(result: BackendResult) -> runtime::Error {
    if (!bytes::is_valid(result.assembly)) {
        return runtime::Error.invalid_argument;
    }
    return bytes::release(result.assembly);
}
