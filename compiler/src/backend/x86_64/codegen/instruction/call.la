module luna.bootstrap.backend.x86_64.codegen.instruction.call;

import luna.bootstrap.backend.x86_64.frame as frame;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime as runtime;

fn general_register_64(index: usize) -> *const u8 {
    if (index == 0) {
        return "%rdi";
    }
    if (index == 1) {
        return "%rsi";
    }
    if (index == 2) {
        return "%rdx";
    }
    if (index == 3) {
        return "%rcx";
    }
    if (index == 4) {
        return "%r8";
    }
    return index == 5 ? "%r9" : null;
}

fn general_register_32(index: usize) -> *const u8 {
    if (index == 0) {
        return "%edi";
    }
    if (index == 1) {
        return "%esi";
    }
    if (index == 2) {
        return "%edx";
    }
    if (index == 3) {
        return "%ecx";
    }
    if (index == 4) {
        return "%r8d";
    }
    return index == 5 ? "%r9d" : null;
}

fn vector_register(index: usize) -> *const u8 {
    if (index == 0) {
        return "%xmm0";
    }
    if (index == 1) {
        return "%xmm1";
    }
    if (index == 2) {
        return "%xmm2";
    }
    if (index == 3) {
        return "%xmm3";
    }
    if (index == 4) {
        return "%xmm4";
    }
    if (index == 5) {
        return "%xmm5";
    }
    if (index == 6) {
        return "%xmm6";
    }
    return index == 7 ? "%xmm7" : null;
}

fn return_general_register(index: usize) -> *const u8 {
    if (index == 0) {
        return "%rax";
    }
    return index == 1 ? "%rdx" : null;
}

fn argument_at(context: *support::Context, instruction_id: usize, argument_index: usize) -> usize {
    let arguments: *const ir::Argument = context->ir.arguments.data as
            *const ir::Argument;
    var found: usize = 0;
    var index: usize = 0;
    while (index < context->ir.argument_count) {
        if (arguments[index].instruction_id == instruction_id) {
            if (found == argument_index) {
                return arguments[index].value_id;
            }
            found += 1;
        }
        index += 1;
    }
    support::fail(context, runtime::Error.invalid_argument);
    return support::no_id();
}

fn call_argument_total(context: *support::Context, instruction_id: usize) -> usize {
    let arguments: *const ir::Argument = context->ir.arguments.data as
            *const ir::Argument;
    var found: usize = 0;
    var index: usize = 0;
    while (index < context->ir.argument_count) {
        if (arguments[index].instruction_id == instruction_id) {
            found += 1;
        }
        index += 1;
    }
    return found;
}

// Classifies one scalar variadic extra against the running register/stack
// cursors, continuing where the named parameters left off, and synthesizes
// the ABI parameter record the call argument emitters already consume.
fn variadic_extra_parameter(
    context: *support::Context, argument: usize, general_used: *usize, vector_used: *usize,
    stack_cursor: *usize) -> abi::Parameter {
    let none: usize = support::no_id();
    var parameter: abi::Parameter = {
        function_id = none, parameter_index = none, abi_class = abi::Class.invalid,
        location = abi::LocationKind.invalid, register_index = none, stack_offset_bytes = none,
        stack_size_bytes = 0, type_id = none, size_bytes = 0, alignment_bytes = 0, first_piece = none, piece_count = 0,
        aggregate = false,
    };
    if (general_used == null || vector_used == null || stack_cursor == null || context->error != runtime::Error.none) {
        return parameter;
    }
    let values: *const ir::Value = context->ir.values.data as *const ir::Value;
    let record: *const type_info::Record = support::type(context, values[argument].type_id);
    if (record == null || type_info::is_memory(record->kind)) {
        return parameter;
    }
    parameter.type_id = values[argument].type_id;
    parameter.size_bytes = record->size_bytes;
    parameter.alignment_bytes = record->alignment_bytes;
    parameter.abi_class = type_info::is_float(record->kind) ? abi::Class.sse : abi::Class.integer;
    if (parameter.abi_class == abi::Class.integer &&
        *general_used < (support::Limit.general_argument_registers as usize)) {
        parameter.location = abi::LocationKind.general_register;
        parameter.register_index = *general_used;
        *general_used += 1;
        return parameter;
    }
    if (parameter.abi_class == abi::Class.sse && *vector_used < (support::Limit.vector_argument_registers as usize)) {
        parameter.location = abi::LocationKind.vector_register;
        parameter.register_index = *vector_used;
        *vector_used += 1;
        return parameter;
    }
    parameter.location = abi::LocationKind.stack;
    parameter.stack_offset_bytes = *stack_cursor;
    parameter.stack_size_bytes = support::Limit.variadic_stack_slot as usize;
    *stack_cursor += support::Limit.variadic_stack_slot as usize;
    return parameter;
}

fn emit_load_piece(context: *support::Context, piece: abi::Piece, destination: *const u8) -> bool {
    if (piece.size_bytes == 8) {
        return support::literal(context, "    movq ") && support::append_usize(context, piece.value_offset_bytes) &&
            support::literal(context, "(%r11), ") && support::literal(context, destination) && support::literal(context,
                "\n");
    }
    if (piece.size_bytes == 4) {
        return support::literal(context, "    movl ") && support::append_usize(context, piece.value_offset_bytes) &&
            support::literal(context, "(%r11), %eax\n    movq %rax, ") &&
            support::literal(context, destination) && support::literal(context, "\n");
    }
    if (piece.size_bytes == 2) {
        return support::literal(context, "    movzwl ") && support::append_usize(context, piece.value_offset_bytes) &&
            support::literal(context, "(%r11), %eax\n    movq %rax, ") &&
            support::literal(context, destination) && support::literal(context, "\n");
    }
    if (piece.size_bytes == 1) {
        return support::literal(context, "    movzbl ") && support::append_usize(context, piece.value_offset_bytes) &&
            support::literal(context, "(%r11), %eax\n    movq %rax, ") &&
            support::literal(context, destination) && support::literal(context, "\n");
    }
    if (piece.size_bytes == 0 || piece.size_bytes > 8 ||
        !support::literal(
            context, "    xorq %rax, %rax\n")) {
        return support::fail(context, runtime::Error.invalid_argument);
    }
    var index: usize = 0;
    while (index < piece.size_bytes) {
        if (!support::literal(context, "    movzbl ") || !support::append_usize(context,
            piece.value_offset_bytes + index) ||
            !support::literal(context, "(%r11), %r10d\n") || (index != 0 && (!support::literal(context, "    shlq $") ||
                !support::append_usize(context, index * 8) ||
                !support::literal(
                    context, ", %r10\n"))) ||
            !support::literal(
                context, "    orq %r10, %rax\n")) {
            return false;
        }
        index += 1;
    }
    return support::literal(context, "    movq %rax, ") && support::literal(context, destination) &&
        support::literal(context, "\n");
}

fn emit_store_piece(context: *support::Context, piece: abi::Piece, source: *const u8) -> bool {
    if (piece.size_bytes == 0 || piece.size_bytes > 8 || !support::literal(context, "    movq ") ||
        !support::literal(context, source) ||
        !support::literal(
            context, ", %r10\n")) {
        return support::fail(context, runtime::Error.invalid_argument);
    }
    var index: usize = 0;
    while (index < piece.size_bytes) {
        if (!support::literal(context, "    movb %r10b, ") || !support::append_usize(context,
            piece.value_offset_bytes + index) ||
            !support::literal(context, "(%r11)\n") || (index + 1 != piece.size_bytes &&
                !support::literal(
                    context, "    shrq $8, %r10\n"))) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn emit_call_stack_argument(context: *support::Context, parameter: abi::Parameter, argument: usize,
    external_c: bool) -> bool {
    let record: *const type_info::Record = support::type(context, parameter.type_id);
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        let values: *const ir::Value = context->ir.values.data as *const ir::Value;
        let pointer_record: *const type_info::Record = support::type(context, values[argument].type_id);
        return pointer_record != null && support::load_integer(context, argument, pointer_record, "%esi", "%rsi",
            false) &&
            support::literal(context, "    leaq ") && support::append_usize(context, parameter.stack_offset_bytes) &&
            support::literal(context, "(%rsp), %rdi\n    movq $") && support::append_usize(context,
                parameter.size_bytes) && support::literal(context, ", %rcx\n    cld\n    rep movsb\n");
    }
    if (type_info::is_float(record->kind)) {
        return support::load_xmm(context, argument, record, "%xmm0") && support::literal(context, "    ") &&
            support::literal(context, support::float_move(record)) && support::literal(context, " %xmm0, ") &&
            support::append_usize(context, parameter.stack_offset_bytes) && support::literal(context, "(%rsp)\n");
    }
    let width: usize = support::bit_width(record);
    let extend_signed: bool = external_c && support::is_signed(context, record) && width < 32;
    return (extend_signed ? support::load_integer(context, argument, record, "%eax", "%rax", true) :
            support::load_rax(context, argument, record)) && support::literal(context,
                    width <= 32 ? "    movl %eax, " : "    movq %rax, ") &&
        support::append_usize(context, parameter.stack_offset_bytes) && support::literal(context, "(%rsp)\n");
}

fn emit_call_register_argument(
    context: *support::Context, parameter: abi::Parameter, argument: usize, external_c: bool) -> bool {
    let record: *const type_info::Record = support::type(context, parameter.type_id);
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        let values: *const ir::Value = context->ir.values.data as *const ir::Value;
        let pointer_record: *const type_info::Record = support::type(context, values[argument].type_id);
        if (pointer_record == null ||
            !support::load_integer(
                context, argument, pointer_record, "%r11d", "%r11", false)) {
            return false;
        }
        let pieces: *const abi::Piece = context->abi.pieces.data as
                *const abi::Piece;
        var index: usize = 0;
        while (index < parameter.piece_count) {
            let piece: abi::Piece = pieces[parameter.first_piece + index];
            if (piece.abi_class == abi::Class.integer) {
                let destination: *const u8 = general_register_64(piece.register_index);
                if (destination == null ||
                    !emit_load_piece(
                        context, piece, destination)) {
                    return false;
                }
            } else {
                let destination: *const u8 = vector_register(piece.register_index);
                if (destination == null || (piece.size_bytes != 4 && piece.size_bytes != 8) ||
                    !support::literal(context, piece.size_bytes == 4 ? "    movss " : "    movq ") ||
                    !support::append_usize(context, piece.value_offset_bytes) || !support::literal(context,
                        "(%r11), ") || !support::literal(context, destination) ||
                    !support::literal(
                        context, "\n")) {
                    return false;
                }
            }
            index += 1;
        }
        return true;
    }
    if (parameter.location == abi::LocationKind.vector_register) {
        let destination: *const u8 = vector_register(parameter.register_index);
        return destination != null && support::load_xmm(context, argument, record, destination);
    }
    let width: usize = support::bit_width(record);
    let destination: *const u8 = width <= 32 ? general_register_32(parameter.register_index) :
            general_register_64(parameter.register_index);
    if (destination == null) {
        return support::fail(context, runtime::Error.invalid_argument);
    }
    return support::load_integer(
        context, argument, record, destination, destination, external_c && support::is_signed(context, record) &&
            width < 32);
}

fn emit_call_result(context: *support::Context, instruction: ir::Instruction, function_abi: abi::Function) -> bool {
    let record: *const type_info::Record = support::type(context, instruction.type_id);
    if (record == null || record->kind == type_info::Kind.type_void) {
        return record != null;
    }
    if (!function_abi.return_aggregate) {
        if (type_info::is_float(record->kind)) {
            return support::store_xmm(context, instruction.result, record, "%xmm0");
        }
        if (record->kind == type_info::Kind.boolean &&
            !support::literal(
                context, "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n")) {
            return false;
        }
        return support::store_rax(context, instruction.result, record);
    }
    let destination: frame::Storage = support::storage(context, frame::StorageKind.aggregate_call_result,
        instruction.result);
    if (context->error != runtime::Error.none || !support::literal(context, "    leaq ") ||
        !support::append_stack(context, destination) ||
        !support::literal(
            context, ", %r11\n")) {
        return false;
    }
    if (!function_abi.hidden_return_pointer) {
        let pieces: *const abi::Piece = context->abi.pieces.data as
                *const abi::Piece;
        var index: usize = 0;
        while (index < function_abi.return_piece_count) {
            let piece: abi::Piece = pieces[function_abi.first_return_piece + index];
            if (piece.abi_class == abi::Class.integer) {
                let source: *const u8 = return_general_register(piece.register_index);
                if (source == null ||
                    !emit_store_piece(
                        context, piece, source)) {
                    return false;
                }
            } else {
                let source: *const u8 = vector_register(piece.register_index);
                if (source == null || (piece.size_bytes != 4 && piece.size_bytes != 8) ||
                    !support::literal(context, piece.size_bytes == 4 ? "    movss " : "    movq ") ||
                    !support::literal(context, source) || !support::literal(context, ", ") ||
                    !support::append_usize(context, piece.value_offset_bytes) ||
                    !support::literal(
                        context, "(%r11)\n")) {
                    return false;
                }
            }
            index += 1;
        }
    }
    return support::literal(context, "    leaq ") && support::append_stack(context, destination) &&
        support::literal(context, ", %rax\n    movq %rax, ") && support::append_value(context, instruction.result) &&
        support::literal(context, "\n");
}

fn function_pointer_abi_index(context: *support::Context, type_id: usize) -> usize {
    let records: *const type_info::Record = context->types.types.data as
            *const type_info::Record;
    var ordinal: usize = 0;
    var index: usize = 0;
    while (index < type_id) {
        if (records[index].kind == type_info::Kind.function_pointer) {
            ordinal += 1;
        }
        index += 1;
    }
    return context->ir.function_count + ordinal;
}

fn emit_call_indirect(context: *support::Context, instruction: ir::Instruction, instruction_id: usize) -> bool {
    let values: *const ir::Value = context->ir.values.data as *const ir::Value;
    let callee_type: usize = values[instruction.left].type_id;
    let abi_index: usize = function_pointer_abi_index(context, callee_type);
    let abi_functions: *const abi::Function = context->abi.functions.data as
            *const abi::Function;
    let function_abi: abi::Function = abi_functions[abi_index];
    let parameters: *const abi::Parameter = context->abi.parameters.data as
            *const abi::Parameter;
    if (function_abi.call_frame_size_bytes != 0 && (!support::literal(context, "    subq $") ||
        !support::append_usize(context, function_abi.call_frame_size_bytes) ||
        !support::literal(
            context, ", %rsp\n"))) {
        return false;
    }
    context->call_frame_depth += function_abi.call_frame_size_bytes;
    var index: usize = 0;
    while (index < function_abi.parameter_count) {
        let parameter: abi::Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location == abi::LocationKind.stack) {
            let argument: usize = argument_at(context, instruction_id, index);
            if (argument == support::no_id() ||
                !emit_call_stack_argument(
                    context, parameter, argument, false)) {
                return false;
            }
        }
        index += 1;
    }
    if (function_abi.hidden_return_pointer) {
        let destination: frame::Storage =
            support::storage(context, frame::StorageKind.aggregate_call_result, instruction.result);
        if (context->error != runtime::Error.none || !support::literal(context, "    leaq ") ||
            !support::append_stack(context, destination) ||
            !support::literal(
                context, ", %rdi\n")) {
            return false;
        }
    }
    index = 0;
    while (index < function_abi.parameter_count) {
        let parameter: abi::Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location != abi::LocationKind.stack) {
            let argument: usize = argument_at(context, instruction_id, index);
            if (argument == support::no_id() ||
                !emit_call_register_argument(
                    context, parameter, argument, false)) {
                return false;
            }
        }
        index += 1;
    }
    if (!support::load_rax(context, instruction.left, support::type(context, callee_type)) ||
        !support::literal(
            context, "    movq %rax, %r11\n    call *%r11\n")) {
        return false;
    }
    context->call_frame_depth -= function_abi.call_frame_size_bytes;
    if (function_abi.call_frame_size_bytes != 0 && (!support::literal(context, "    addq $") ||
        !support::append_usize(context, function_abi.call_frame_size_bytes) ||
        !support::literal(
            context, ", %rsp\n"))) {
        return false;
    }
    return emit_call_result(context, instruction, function_abi);
}

fn emit_call(context: *support::Context, instruction: ir::Instruction, instruction_id: usize) -> bool {
    if (instruction.auxiliary >= context->ir.function_count) {
        return support::fail(context, runtime::Error.invalid_argument);
    }
    let abi_functions: *const abi::Function = context->abi.functions.data as
            *const abi::Function;
    let function_abi: abi::Function = abi_functions[instruction.auxiliary];
    let functions: *const ir::Function = context->ir.functions.data as
            *const ir::Function;
    let external_c: bool = functions[instruction.auxiliary].linkage == ir::Linkage.external_c;
    let parameters: *const abi::Parameter = context->abi.parameters.data as
            *const abi::Parameter;
    // A variadic callee takes extra arguments past its named parameters; they
    // classify against cursors continuing where the named list stopped, and
    // the call must set %al to the total number of vector registers used.
    let variadic: bool = functions[instruction.auxiliary].variadic;
    var extra_count: usize = 0;
    var vector_count: usize = function_abi.vector_register_count;
    var frame_size: usize = function_abi.call_frame_size_bytes;
    if (variadic) {
        extra_count = call_argument_total(context, instruction_id) - function_abi.parameter_count;
        var general_used: usize = function_abi.general_register_count;
        var stack_cursor: usize = function_abi.stack_argument_size_bytes;
        var extra: usize = 0;
        while (extra < extra_count) {
            let argument: usize = argument_at(context, instruction_id, function_abi.parameter_count + extra);
            if (argument == support::no_id() ||
                variadic_extra_parameter(context, argument, &general_used, &vector_count, &stack_cursor).location ==
                    abi::LocationKind.invalid) {
                return support::fail(context, runtime::Error.invalid_argument);
            }
            extra += 1;
        }
        frame_size = (stack_cursor + (support::Limit.call_stack_alignment as usize) - 1) &
            ~((support::Limit.call_stack_alignment as usize) - 1);
    }
    if (frame_size != 0 && (!support::literal(context, "    subq $") || !support::append_usize(context, frame_size) ||
        !support::literal(
            context, ", %rsp\n"))) {
        return false;
    }
    context->call_frame_depth += frame_size;
    var index: usize = 0;
    while (index < function_abi.parameter_count) {
        let parameter: abi::Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location == abi::LocationKind.stack) {
            let argument: usize = argument_at(context, instruction_id, index);
            if (argument == support::no_id() ||
                !emit_call_stack_argument(
                    context, parameter, argument, external_c)) {
                return false;
            }
        }
        index += 1;
    }
    if (variadic) {
        var general_used: usize = function_abi.general_register_count;
        var vector_used: usize = function_abi.vector_register_count;
        var stack_cursor: usize = function_abi.stack_argument_size_bytes;
        var extra: usize = 0;
        while (extra < extra_count) {
            let argument: usize = argument_at(context, instruction_id, function_abi.parameter_count + extra);
            let parameter: abi::Parameter = variadic_extra_parameter(
                context, argument, &general_used, &vector_used, &stack_cursor);
            if (parameter.location == abi::LocationKind.invalid) {
                return support::fail(context, runtime::Error.invalid_argument);
            }
            if (parameter.location == abi::LocationKind.stack &&
                !emit_call_stack_argument(
                    context, parameter, argument, external_c)) {
                return false;
            }
            extra += 1;
        }
    }
    if (function_abi.hidden_return_pointer) {
        let destination: frame::Storage =
            support::storage(context, frame::StorageKind.aggregate_call_result, instruction.result);
        if (context->error != runtime::Error.none || !support::literal(context, "    leaq ") ||
            !support::append_stack(context, destination) ||
            !support::literal(
                context, ", %rdi\n")) {
            return false;
        }
    }
    index = 0;
    while (index < function_abi.parameter_count) {
        let parameter: abi::Parameter = parameters[function_abi.first_parameter + index];
        if (parameter.location != abi::LocationKind.stack) {
            let argument: usize = argument_at(context, instruction_id, index);
            if (argument == support::no_id() ||
                !emit_call_register_argument(
                    context, parameter, argument, external_c)) {
                return false;
            }
        }
        index += 1;
    }
    if (variadic) {
        var general_used: usize = function_abi.general_register_count;
        var vector_used: usize = function_abi.vector_register_count;
        var stack_cursor: usize = function_abi.stack_argument_size_bytes;
        var extra: usize = 0;
        while (extra < extra_count) {
            let argument: usize = argument_at(context, instruction_id, function_abi.parameter_count + extra);
            let parameter: abi::Parameter = variadic_extra_parameter(
                context, argument, &general_used, &vector_used, &stack_cursor);
            if (parameter.location == abi::LocationKind.invalid) {
                return support::fail(context, runtime::Error.invalid_argument);
            }
            if (parameter.location != abi::LocationKind.stack &&
                !emit_call_register_argument(
                    context, parameter, argument, external_c)) {
                return false;
            }
            extra += 1;
        }
        if (!support::literal(context, "    movb $") || !support::append_usize(context, vector_count) ||
            !support::literal(context, ", %al\n")) {
            return false;
        }
    }
    if (!support::literal(context, "    call ") || !support::append_function_symbol(context, instruction.auxiliary) ||
        !support::literal(context, "\n")) {
        return false;
    }
    context->call_frame_depth -= frame_size;
    if (frame_size != 0 && (!support::literal(context, "    addq $") || !support::append_usize(context, frame_size) ||
        !support::literal(
            context, ", %rsp\n"))) {
        return false;
    }
    return emit_call_result(context, instruction, function_abi);
}

fn emit_parameter_register(context: *support::Context, parameter: abi::Parameter, ir_parameter: ir::Parameter) -> bool {
    let record: *const type_info::Record = support::type(context, parameter.type_id);
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        if (!support::literal(context, "    leaq ") || !support::append_slot(context, ir_parameter.slot_id) ||
            !support::literal(
                context, ", %r11\n")) {
            return false;
        }
        let pieces: *const abi::Piece = context->abi.pieces.data as
                *const abi::Piece;
        var index: usize = 0;
        while (index < parameter.piece_count) {
            let piece: abi::Piece = pieces[parameter.first_piece + index];
            if (piece.abi_class == abi::Class.integer) {
                let source: *const u8 = general_register_64(piece.register_index);
                if (source == null ||
                    !emit_store_piece(
                        context, piece, source)) {
                    return false;
                }
            } else {
                let source: *const u8 = vector_register(piece.register_index);
                if (source == null || (piece.size_bytes != 4 && piece.size_bytes != 8) ||
                    !support::literal(context, piece.size_bytes == 4 ? "    movss " : "    movq ") ||
                    !support::literal(context, source) || !support::literal(context, ", ") ||
                    !support::append_usize(context, piece.value_offset_bytes) ||
                    !support::literal(
                        context, "(%r11)\n")) {
                    return false;
                }
            }
            index += 1;
        }
        return true;
    }
    if (parameter.location == abi::LocationKind.vector_register) {
        let source: *const u8 = vector_register(parameter.register_index);
        return source != null && support::literal(context, "    ") && support::literal(context,
            support::float_move(record)) &&
            support::literal(context, " ") && support::literal(context, source) && support::literal(context, ", ") &&
            support::append_slot(context, ir_parameter.slot_id) && support::literal(context, "\n");
    }
    let width: usize = support::bit_width(record);
    let source: *const u8 = width <= 32 ? general_register_32(parameter.register_index) :
            general_register_64(parameter.register_index);
    return source != null && support::literal(context, width <= 32 ? "    movl " : "    movq ") &&
        support::literal(context, source) && support::literal(context, ", ") && support::append_slot(context,
            ir_parameter.slot_id) && support::literal(context, "\n");
}

// Spills the incoming argument registers into the frame's 176-byte System V
// register save area: gp registers always at +0..+40, then — only when the
// caller set %al — xmm0-7 in 16-byte slots at +48..+175. Only the low 8
// bytes of each SSE slot are ever read (f64/f32), so a plain movq suffices.
fn emit_register_save(context: *support::Context, function_id: usize) -> bool {
    let storage: frame::Storage = support::storage(context, frame::StorageKind.register_save_area, function_id);
    if (context->error != runtime::Error.none || !support::literal(context, "    leaq ") ||
        !support::append_stack(context, storage) || !support::literal(context, ", %r11\n")) {
        return false;
    }
    var index: usize = 0;
    while (index < (support::Limit.general_argument_registers as usize)) {
        let source: *const u8 = general_register_64(index);
        if (source == null || !support::literal(context, "    movq ") || !support::literal(context, source) ||
            !support::literal(context, ", ") ||
            !support::append_usize(context, index * 8) || !support::literal(context, "(%r11)\n")) {
            return false;
        }
        index += 1;
    }
    if (!support::literal(context, "    testb %al, %al\n    je ") || !support::literal(context, ".Lbf") ||
        !support::append_usize(context, function_id) || !support::literal(context, "_va_save\n")) {
        return false;
    }
    index = 0;
    while (index < (support::Limit.vector_argument_registers as usize)) {
        let source: *const u8 = vector_register(index);
        if (source == null || !support::literal(context, "    movq ") || !support::literal(context, source) ||
            !support::literal(context, ", ") ||
            !support::append_usize(context, 48 + index * 16) || !support::literal(context, "(%r11)\n")) {
            return false;
        }
        index += 1;
    }
    return support::literal(context, ".Lbf") && support::append_usize(context, function_id) && support::literal(context,
        "_va_save:\n");
}

fn emit_va_start(context: *support::Context, instruction: ir::Instruction) -> bool {
    let values: *const ir::Value = context->ir.values.data as *const ir::Value;
    let abi_functions: *const abi::Function = context->abi.functions.data as
            *const abi::Function;
    let function_abi: abi::Function = abi_functions[context->current_function];
    let storage: frame::Storage = support::storage(context, frame::StorageKind.register_save_area,
        context->current_function);
    if (context->error != runtime::Error.none ||
        !support::load_rax(
            context, instruction.left, support::type(context, values[instruction.left].type_id))) {
        return false;
    }
    // %rax holds the va_list address. gp_offset/fp_offset skip exactly the
    // named register parameters (general_register_count already counts the
    // hidden return pointer), the overflow area begins past the named stack
    // arguments, and the save area is this frame's prologue spill slot.
    return support::literal(context, "    movl $") && support::append_usize(context,
        function_abi.general_register_count * 8) && support::literal(context, ", 0(%rax)\n    movl $") &&
        support::append_usize(context, 48 + function_abi.vector_register_count * 16) &&
        support::literal(context, ", 4(%rax)\n    leaq ") &&
        support::append_usize(context, 16 + function_abi.stack_argument_size_bytes) &&
        support::literal(context, "(%rbp), %r10\n    movq %r10, 8(%rax)\n    leaq ") && support::append_stack(context,
            storage) && support::literal(context, ", %r10\n    movq %r10, 16(%rax)\n");
}

fn emit_va_arg(context: *support::Context, instruction: ir::Instruction, instruction_id: usize) -> bool {
    let record: *const type_info::Record = support::type(context, instruction.type_id);
    if (record == null || !support::literal(context, "    movq ") || !support::append_value(context,
        instruction.left) || !support::literal(context, ", %r11\n")) {
        return false;
    }
    if (type_info::is_float(record->kind)) {
        // SSE class: 16-byte save slots at fp_offset while it stays below
        // 176 (f32 reads the slot's low 4 bytes, f64 the low 8), then 8-byte
        // overflow slots.
        if (!support::literal(context, "    movl 4(%r11), %eax\n    cmpl $176, %eax\n    jae ") ||
            !support::instruction_label(context, instruction_id, "va_overflow") ||
            !support::literal(context, "\n    movq 16(%r11), %r10\n    ") || !support::literal(context,
                support::float_move(record)) ||
            !support::literal(context, " (%r10,%rax), %xmm0\n    addl $16, 4(%r11)\n    jmp ") ||
            !support::instruction_label(context, instruction_id, "va_done") || !support::literal(context, "\n") ||
            !support::instruction_label(context, instruction_id, "va_overflow") ||
            !support::literal(context, ":\n    movq 8(%r11), %r10\n    ") || !support::literal(context,
                support::float_move(record)) ||
            !support::literal(context, " (%r10), %xmm0\n    addq $8, %r10\n    movq %r10, 8(%r11)\n") ||
            !support::instruction_label(context, instruction_id, "va_done") || !support::literal(context, ":\n")) {
            return false;
        }
        return support::store_xmm(context, instruction.result, record, "%xmm0");
    }
    // INTEGER class: 8-byte gp save slots at gp_offset while it stays below
    // 48, then the overflow area. Luna passes variadic extras at their
    // declared width (no C default argument promotions) and va_arg reads the
    // requested width back out of the slot — the divergence from C is
    // deliberate.
    if (!support::literal(context, "    movl 0(%r11), %eax\n    cmpl $48, %eax\n    jae ") ||
        !support::instruction_label(context, instruction_id, "va_overflow") || !support::literal(context,
            "\n    movq 16(%r11), %r10\n    movq (%r10,%rax), %rax\n    addl $8, 0(%r11)\n    jmp ") ||
        !support::instruction_label(context, instruction_id, "va_done") || !support::literal(context, "\n") ||
        !support::instruction_label(context, instruction_id, "va_overflow") ||
        !support::literal(
            context, ":\n    movq 8(%r11), %r10\n    movq (%r10), %rax\n    addq $8, %r10\n    movq %r10, 8(%r11)\n") ||
        !support::instruction_label(context, instruction_id, "va_done") || !support::literal(context, ":\n")) {
        return false;
    }
    return support::store_rax(context, instruction.result, record);
}

fn emit_parameter_stack(context: *support::Context, parameter: abi::Parameter, ir_parameter: ir::Parameter) -> bool {
    let record: *const type_info::Record = support::type(context, parameter.type_id);
    let source_offset: usize = parameter.stack_offset_bytes + 16;
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        return support::literal(context, "    leaq ") && support::append_usize(context, source_offset) &&
            support::literal(context, "(%rbp), %rsi\n    leaq ") && support::append_slot(context,
                ir_parameter.slot_id) &&
            support::literal(context, ", %rdi\n    movq $") && support::append_usize(context, parameter.size_bytes) &&
            support::literal(context, ", %rcx\n    cld\n    rep movsb\n");
    }
    if (type_info::is_float(record->kind)) {
        return support::literal(context, "    ") && support::literal(context, support::float_move(record)) &&
            support::literal(context, " ") && support::append_usize(context, source_offset) && support::literal(context,
                "(%rbp), %xmm15\n    ") &&
            support::literal(context, support::float_move(record)) && support::literal(context, " %xmm15, ") &&
            support::append_slot(context, ir_parameter.slot_id) && support::literal(context, "\n");
    }
    let width: usize = support::bit_width(record);
    return support::literal(context, width <= 32 ? "    movl " : "    movq ") && support::append_usize(context,
        source_offset) &&
        support::literal(context, width <= 32 ? "(%rbp), %eax\n    movl %eax, " : "(%rbp), %rax\n    movq %rax, ") &&
        support::append_slot(context, ir_parameter.slot_id) && support::literal(context, "\n");
}

fn emit_parameters(context: *support::Context, function: ir::Function, function_abi: abi::Function) -> bool {
    let parameters: *const abi::Parameter = context->abi.parameters.data as
            *const abi::Parameter;
    let ir_parameters: *const ir::Parameter = context->ir.parameters.data as
            *const ir::Parameter;
    if (function_abi.hidden_return_pointer) {
        let storage: frame::Storage =
            support::storage(context, frame::StorageKind.hidden_return_pointer, context->current_function);
        if (context->error != runtime::Error.none || !support::literal(context, "    movq %rdi, ") ||
            !support::append_stack(context, storage) || !support::literal(context, "\n")) {
            return false;
        }
    }
    var phase: usize = 0;
    while (phase < 2) {
        var index: usize = 0;
        while (index < function.parameter_count) {
            let parameter: abi::Parameter = parameters[function_abi.first_parameter + index];
            let is_stack: bool = parameter.location == abi::LocationKind.stack;
            if ((phase == 0 && !is_stack) || (phase == 1 && is_stack)) {
                let ir_parameter: ir::Parameter = ir_parameters[ function.first_parameter + index];
                let emitted: bool = is_stack ? emit_parameter_stack(context, parameter, ir_parameter) :
                    emit_parameter_register(context, parameter, ir_parameter);
                if (!emitted) {
                    return false;
                }
            }
            index += 1;
        }
        phase += 1;
    }
    return true;
}

fn emit_return(context: *support::Context, instruction: ir::Instruction) -> bool {
    let functions: *const ir::Function = context->ir.functions.data as
            *const ir::Function;
    let abi_functions: *const abi::Function = context->abi.functions.data as
            *const abi::Function;
    let function: ir::Function = functions[context->current_function];
    let function_abi: abi::Function = abi_functions[context->current_function];
    let record: *const type_info::Record = support::type(context, function.return_type);
    if (record == null) {
        return false;
    }
    if (instruction.opcode == ir::Opcode.return_value && function_abi.return_aggregate) {
        if (!support::load_rax(context, instruction.left, record) ||
            !support::literal(
                context, "    movq %rax, %r11\n")) {
            return false;
        }
        if (function_abi.hidden_return_pointer) {
            let hidden: frame::Storage =
                support::storage(context, frame::StorageKind.hidden_return_pointer, context->current_function);
            if (context->error != runtime::Error.none || !support::literal(context, "    movq ") ||
                !support::append_stack(context, hidden) ||
                !support::literal(context, ", %rdi\n    movq %rdi, %rax\n    movq %r11, %rsi\n    movq $") ||
                !support::append_usize(context, function_abi.return_size_bytes) ||
                !support::literal(
                    context, ", %rcx\n    cld\n    rep movsb\n")) {
                return false;
            }
        } else {
            let pieces: *const abi::Piece = context->abi.pieces.data as
                    *const abi::Piece;
            var reverse: usize = function_abi.return_piece_count;
            while (reverse != 0) {
                reverse -= 1;
                let piece: abi::Piece = pieces[ function_abi.first_return_piece + reverse];
                if (piece.abi_class == abi::Class.integer) {
                    let destination: *const u8 = return_general_register(piece.register_index);
                    if (destination == null ||
                        !emit_load_piece(
                            context, piece, destination)) {
                        return false;
                    }
                } else {
                    let destination: *const u8 = vector_register(piece.register_index);
                    if (destination == null || (piece.size_bytes != 4 && piece.size_bytes != 8) ||
                        !support::literal(context, piece.size_bytes == 4 ? "    movss " : "    movq ") ||
                        !support::append_usize(context, piece.value_offset_bytes) || !support::literal(context,
                            "(%r11), ") || !support::literal(context, destination) ||
                        !support::literal(
                            context, "\n")) {
                        return false;
                    }
                }
            }
        }
    } else if (instruction.opcode == ir::Opcode.return_value) {
        if (type_info::is_float(record->kind)) {
            if (!support::load_xmm(
                    context, instruction.left, record, "%xmm0")) {
                return false;
            }
        } else if (!support::load_rax(
                context, instruction.left, record)) {
            return false;
        }
    }
    return support::literal(context, "    jmp ") && support::return_label(context) && support::literal(context, "\n");
}

