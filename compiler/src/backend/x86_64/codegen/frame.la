module luna.compiler.x86.codegen;



enum FrameLimit: usize {
    maximum_size = 18446744073709551615, scalar_home_size = 8, scalar_home_alignment = 8, stack_alignment = 16,
    maximum_frame_size = 2147483647, register_save_area_size = 176, register_save_area_alignment = 16,
}

impl FramePlan {
    init(): frames = vector::vector<Frame>(), storage = vector::vector<Storage>() {
        this->error_code = runtime::Error.none;
    }

    priv fn ready() const -> bool {
        return this->error_code == runtime::Error.none;
    }

    priv fn fail(error: runtime::Error) -> bool {
        if (this->ready()) {
            this->error_code = error;
        }
        return false;
    }

    priv fn no_id() const -> usize {
    return FrameLimit.maximum_size as usize;
}

    fn error() const -> runtime::Error {
        return this->error_code;
}

    fn frame_count() const -> usize {
        return this->frames.size();
    }

    fn storage_count() const -> usize {
        return this->storage.size();
    }

    fn frame_data() const -> *const Frame {
        return this->frames.as_span().data();
    }

    fn storage_data() const -> *const Storage {
        return this->storage.as_span().data();
    }

    priv fn storage_is_valid() const -> bool {
        return this->frames.is_valid() && this->storage.is_valid();
}

priv fn frame_align_up(value: usize, alignment: usize) -> usize {
    var result: usize = 0;
    return checked::align_up(value, alignment, &result) ? result : this->no_id();
}

priv fn append_storage(storage: Storage) -> bool {
    if (!this->ready()) {
        return false;
    }
    let error: runtime::Error = this->storage.push_back(storage);
    if (error != runtime::Error.none) {
        return this->fail(error);
    }
    return true;
}

priv fn append_frame(frame: Frame) -> bool {
    if (!this->ready()) {
        return false;
    }
    let error: runtime::Error = this->frames.push_back(frame);
    if (error != runtime::Error.none) {
        return this->fail(error);
    }
    return true;
}

priv fn add_storage(frame: *Frame, function_id: usize, kind: StorageKind,
    source_id: usize, type_id: usize, size_bytes: usize, alignment_bytes: usize, current_offset: *usize) -> bool {
    if (frame == null || current_offset == null) {
        return false;
    }
    if (size_bytes == 0 || alignment_bytes == 0) {
        return false;
    }
    var end: usize = 0;
    if (!checked::add(*current_offset, size_bytes, &end)) {
        return false;
    }
    let offset: usize = this->frame_align_up(end, alignment_bytes);
    if (offset == this->no_id()) {
        return false;
    }
    let storage: Storage = {
        function_id = function_id, kind = kind, source_id = source_id, type_id = type_id, offset_bytes = offset,
        size_bytes = size_bytes, alignment_bytes = alignment_bytes,
    };
    if (!this->append_storage( storage)) {
        return false;
    }
    *current_offset = offset;
    frame->storage_count += 1;
    return true;
}

priv fn add_slots(frame: *Frame, ir: ir::View, types: type_info::TypeTable const&,
    function_id: usize, current_offset: *usize) -> bool {
    let slots: *const ir::Slot = ir.slots as *const ir::Slot;
    let records: *const type_info::Record = types.record_data() as *const type_info::Record;
    for (var slot_id: usize = 0; slot_id < ir.slot_count; slot_id += 1) {
        let slot: ir::Slot = slots[slot_id];
        if (slot.function_id == function_id) {
            let record: type_info::Record = records[slot.type_id];
            let memory: bool = type_info::is_memory(record.kind);
            let natural_alignment: usize = memory ? record.alignment_bytes : FrameLimit.scalar_home_alignment as usize;
            let alignment: usize = slot.alignment_bytes > natural_alignment ? slot.alignment_bytes : natural_alignment;
            if (!this->add_storage( frame, function_id, StorageKind.slot, slot_id, slot.type_id, memory ?
                        record.size_bytes : FrameLimit.scalar_home_size
                            as usize, alignment, current_offset)) {
                return false;
            }
        }
    }
    return true;
}

priv fn add_values(frame: *Frame, ir: ir::View, function: ir::Function,
    function_id: usize, current_offset: *usize) -> bool {
    for (var index: usize = 0; index < function.value_count; index += 1) {
        let value_id: usize = function.first_value + index;
        let values: *const ir::Value = ir.values as *const ir::Value;
        if (!this->add_storage( frame, function_id, StorageKind.value, value_id, values[value_id].type_id,
                    FrameLimit.scalar_home_size
                    as usize, FrameLimit.scalar_home_alignment
                    as usize, current_offset)) {
            return false;
        }
    }
    return true;
}

priv fn add_call_results(frame: *Frame, ir: ir::View, types: type_info::TypeTable const&,
    function_id: usize, current_offset: *usize) -> bool {
    let instructions: *const ir::Instruction = ir.instructions as *const ir::Instruction;
    let blocks: *const ir::Block = ir.blocks as *const ir::Block;
    let records: *const type_info::Record = types.record_data() as *const type_info::Record;
    for (var instruction_id: usize = 0; instruction_id < ir.instruction_count; instruction_id += 1) {
        let instruction: ir::Instruction = instructions[instruction_id];
        let owned_call: bool = blocks[instruction.block_id].function_id == function_id &&
            instruction.opcode == ir::Opcode.call;
        let requires_storage: bool = instruction.result != ir::no_id() && instruction.right == ir::no_id();
        let stores_result: bool = owned_call && requires_storage;
        if (stores_result && type_info::is_memory(records[instruction.type_id].kind)) {
            let record: type_info::Record = records[instruction.type_id];
            if (!this->add_storage( frame, function_id, StorageKind.aggregate_call_result, instruction.result,
                    instruction.type_id, record.size_bytes, record.alignment_bytes, current_offset)) {
                return false;
            }
        }
    }
    return true;
}

fn build(ir: ir::View, types: type_info::TypeTable const&, abi: AbiLayout const&) -> bool {
    if (!types.is_valid(true) || !abi.is_valid(ir, types)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (!this->frames.empty() || !this->storage.empty()) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let functions: *const ir::Function = ir.functions as *const ir::Function;
    let abi_functions: *const Function = abi.function_data();
    for (var function_id: usize = 0; function_id < ir.function_count && this->ready(); function_id += 1) {
        let function: ir::Function = functions[function_id];
        var frame: Frame = {
            function_id = function_id, first_storage = function.has_body ? this->storage_count() :
                this->no_id(), storage_count = 0, frame_size_bytes = 0, dynamic_alignment = 0,
        };
        var offset: usize = 0;
        if (function.has_body) {
            if (!this->add_slots(&frame, ir, types, function_id, &offset)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
            if (!this->add_values(&frame, ir, function, function_id, &offset)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
            if (!this->add_call_results(&frame, ir, types, function_id, &offset)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
        }
        let needs_return_pointer: bool = function.has_body && abi_functions[function_id].hidden_return_pointer;
        if (needs_return_pointer) {
            if (!this->add_storage(&frame, function_id, StorageKind.hidden_return_pointer, function_id,
                    function.return_type, 8, 8, &offset)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
        }
        // 可变参数函数序言把入参寄存器保存到 System V register save area：
        // +0..+40 为六个通用寄存器槽，+48..+175 为八个 16 字节 SSE 槽。
        if (function.has_body && function.variadic) {
            if (!this->add_storage(&frame, function_id, StorageKind.register_save_area, function_id,
                    function.return_type, FrameLimit.register_save_area_size as usize,
                    FrameLimit.register_save_area_alignment as usize, &offset)) {
                return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
            }
        }
        if (function.has_body) {
            let storage: *const Storage = this->storage_data();
            for (var storage_index: usize = 0; storage_index < frame.storage_count; storage_index += 1) {
                let alignment: usize = storage[frame.first_storage + storage_index].alignment_bytes;
                if (alignment > frame.dynamic_alignment) {
                    frame.dynamic_alignment = alignment;
                }
            }
            if (frame.dynamic_alignment <= (FrameLimit.stack_alignment as usize)) {
                frame.dynamic_alignment = 0;
            }
        }
        frame.frame_size_bytes = this->frame_align_up(offset, FrameLimit.stack_alignment as usize);
        if (frame.frame_size_bytes == this->no_id() ||
            frame.frame_size_bytes > FrameLimit.maximum_frame_size as usize) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (!this->append_frame(frame)) {
            return this->ready() ? this->fail(runtime::Error.invalid_argument) : false;
        }
    }
    return this->ready();
}

fn is_valid(ir: ir::View, types: type_info::TypeTable const&, abi: AbiLayout const&) const -> bool {
    if (!this->ready() || !this->storage_is_valid()) {
        return false;
    }
    let inputs_are_valid: bool = types.is_valid(true) && abi.is_valid(ir, types);
    return inputs_are_valid && this->frame_count() == ir.function_count;
}

priv fn invalid() const
    -> Frame {
    let none: usize = this->no_id();
    return {
        function_id = none, first_storage = none, storage_count = 0, frame_size_bytes = 0, dynamic_alignment = 0,
    };
}

priv fn storage_invalid() const
    -> Storage {
    let none: usize = this->no_id();
    return {
        function_id = none, kind = StorageKind.invalid, source_id = none, type_id = none,
        offset_bytes = 0, size_bytes = 0, alignment_bytes = 0,
    };
}

fn frame_at(function_id: usize) const -> FrameResult {
    if (!this->storage_is_valid() || function_id >= this->frame_count()) {
        return {
            frame = this->invalid(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        frame = this->frames.get(function_id), error = runtime::Error.none,
    };
}

fn find_storage(function_id: usize, kind: StorageKind, source_id: usize) const -> StorageResult {
    if (!this->storage_is_valid() || function_id >= this->frame_count()) {
        return {
            storage = this->storage_invalid(), error = runtime::Error.invalid_argument,
        };
    }
    if (kind == StorageKind.invalid) {
        return {
            storage = this->storage_invalid(), error = runtime::Error.invalid_argument,
        };
    }
    let frame: Frame = this->frames.get(function_id);
    let storage: *const Storage = this->storage_data();
    for (var index: usize = 0; index < frame.storage_count; index += 1) {
        let candidate: Storage = storage[frame.first_storage + index];
        if (candidate.kind == kind && candidate.source_id == source_id) {
            return {
                storage = candidate, error = runtime::Error.none,
            };
        }
    }
    return {
        storage = this->storage_invalid(), error = runtime::Error.not_found,
    };
}

deinit() {
}

}
