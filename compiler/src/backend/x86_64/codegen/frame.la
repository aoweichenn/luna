module luna.compiler.x86.codegen;



enum FrameLimit: usize {
    maximum_size = 18446744073709551615, scalar_home_size = 8, scalar_home_alignment = 8, stack_alignment = 16,
    maximum_frame_size = 2147483647, register_save_area_size = 176, register_save_area_alignment = 16,
}

fn frame_no_id() -> usize {
    return FrameLimit.maximum_size as usize;
}

fn plan_empty()
    -> Plan {
    return {
        frames = bytes::empty(), frame_count = 0, storage = bytes::empty(), storage_count = 0,
        error = runtime::Error.none,
    };
}

fn plan_storage_is_valid(plan: Plan) -> bool {
    return bytes::is_valid(plan.frames) && bytes::is_valid(plan.storage) && plan.frames.length % sizeof(Frame) == 0 &&
        plan.storage.length % sizeof(Storage) == 0 && plan.frame_count ==
            plan.frames.length / sizeof(Frame) && plan.storage_count == plan.storage.length / sizeof(Storage);
}

fn frame_align_up(value: usize, alignment: usize) -> usize {
    var result: usize = 0;
    return checked::align_up(value, alignment, &result) ? result : frame_no_id();
}

fn append_storage(plan: *Plan, storage: Storage) -> bool {
    if (plan == null || plan->error != runtime::Error.none) {
        return false;
    }
    let appended: bytes::BufferResult =
        bytes::append(plan->storage, (&storage) as *const Storage as *const u8, sizeof(Storage));
    plan->storage = appended.buffer;
    plan->error = appended.error;
    if (appended.error == runtime::Error.none) {
        plan->storage_count += 1;
        return true;
    }
    return false;
}

fn append_frame(plan: *Plan, frame: Frame) -> bool {
    if (plan == null || plan->error != runtime::Error.none) {
        return false;
    }
    let appended: bytes::BufferResult =
        bytes::append(plan->frames, (&frame) as *const Frame as *const u8, sizeof(Frame));
    plan->frames = appended.buffer;
    plan->error = appended.error;
    if (appended.error == runtime::Error.none) {
        plan->frame_count += 1;
        return true;
    }
    return false;
}

fn add_storage(
    plan: *Plan, frame: *Frame, function_id: usize, kind: StorageKind,
    source_id: usize, type_id: usize, size_bytes: usize, alignment_bytes: usize, current_offset: *usize) -> bool {
    if (plan == null || frame == null || current_offset == null || size_bytes == 0 || alignment_bytes == 0) {
        return false;
    }
    var end: usize = 0;
    if (!checked::add(*current_offset, size_bytes, &end)) {
        return false;
    }
    let offset: usize = frame_align_up(end, alignment_bytes);
    if (offset == frame_no_id()) {
        return false;
    }
    let storage: Storage = {
        function_id = function_id, kind = kind, source_id = source_id, type_id = type_id, offset_bytes = offset,
        size_bytes = size_bytes, alignment_bytes = alignment_bytes,
    };
    if (!append_storage(
            plan, storage)) {
        return false;
    }
    *current_offset = offset;
    frame->storage_count += 1;
    return true;
}

fn add_slots(
    plan: *Plan, frame: *Frame, ir: ir::Store, types: type_info::Table,
    function_id: usize, current_offset: *usize) -> bool {
    let slots: *const ir::Slot = ir.slots.data as *const ir::Slot;
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    var slot_id: usize = 0;
    while (slot_id < ir.slot_count) {
        let slot: ir::Slot = slots[slot_id];
        if (slot.function_id == function_id) {
            let record: type_info::Record = records[slot.type_id];
            let memory: bool = type_info::is_memory(record.kind);
            let natural_alignment: usize = memory ? record.alignment_bytes : FrameLimit.scalar_home_alignment as usize;
            let alignment: usize = slot.alignment_bytes > natural_alignment ? slot.alignment_bytes : natural_alignment;
            if (!add_storage(
                    plan, frame, function_id, StorageKind.slot, slot_id, slot.type_id, memory ?
                        record.size_bytes : FrameLimit.scalar_home_size
                            as usize, alignment, current_offset)) {
                return false;
            }
        }
        slot_id += 1;
    }
    return true;
}

fn add_values(
    plan: *Plan, frame: *Frame, ir: ir::Store, function: ir::Function,
    function_id: usize, current_offset: *usize) -> bool {
    var index: usize = 0;
    while (index < function.value_count) {
        let value_id: usize = function.first_value + index;
        let values: *const ir::Value = ir.values.data as *const ir::Value;
        if (!add_storage(
                plan, frame, function_id, StorageKind.value, value_id, values[value_id].type_id,
                    FrameLimit.scalar_home_size
                    as usize, FrameLimit.scalar_home_alignment
                    as usize, current_offset)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn add_call_results(
    plan: *Plan, frame: *Frame, ir: ir::Store, types: type_info::Table,
    function_id: usize, current_offset: *usize) -> bool {
    let instructions: *const ir::Instruction = ir.instructions.data as *const ir::Instruction;
    let blocks: *const ir::Block = ir.blocks.data as *const ir::Block;
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    for (var instruction_id: usize = 0; instruction_id < ir.instruction_count; instruction_id += 1) {
        let instruction: ir::Instruction = instructions[instruction_id];
        let owned_call: bool = blocks[instruction.block_id].function_id == function_id &&
            instruction.opcode == ir::Opcode.call;
        let requires_storage: bool = instruction.result != ir::no_id() && instruction.right == ir::no_id();
        let stores_result: bool = owned_call && requires_storage;
        if (stores_result && type_info::is_memory(records[instruction.type_id].kind)) {
            let record: type_info::Record = records[instruction.type_id];
            if (!add_storage(
                    plan, frame, function_id, StorageKind.aggregate_call_result, instruction.result,
                    instruction.type_id, record.size_bytes, record.alignment_bytes, current_offset)) {
                return false;
            }
        }
    }
    return true;
}

fn plan_build(ir: ir::Store, types: type_info::Table, abi: Abi) -> PlanResult {
    var plan: Plan = plan_empty();
    if (!ir_check::is_valid(ir, types) || !is_valid(abi, ir, types)) {
        return {
            plan = plan, error = runtime::Error.invalid_argument,
        };
    }
    let functions: *const ir::Function = ir.functions.data as *const ir::Function;
    let abi_functions: *const Function = abi.functions.data as *const Function;
    var function_id: usize = 0;
    while (function_id < ir.function_count && plan.error == runtime::Error.none) {
        let function: ir::Function = functions[function_id];
        var frame: Frame = {
            function_id = function_id, first_storage = function.has_body ? plan.storage_count :
                frame_no_id(), storage_count = 0, frame_size_bytes = 0, dynamic_alignment = 0,
        };
        var offset: usize = 0;
        if (function.has_body && (!add_slots(&plan, &frame, ir, types, function_id, &offset) ||
                !add_values(&plan, &frame, ir, function, function_id, &offset) ||
                !add_call_results(
                    &plan, &frame, ir, types, function_id, &offset))) {
            if (plan.error == runtime::Error.none) {
                plan.error = runtime::Error.invalid_argument;
            }
            break;
        }
        if (function.has_body && abi_functions[function_id].hidden_return_pointer &&
            !add_storage(
                &plan, &frame, function_id, StorageKind.hidden_return_pointer, function_id,
                function.return_type, 8, 8, &offset)) {
            if (plan.error == runtime::Error.none) {
                plan.error = runtime::Error.invalid_argument;
            }
            break;
        }
        // 可变参数函数序言把入参寄存器保存到 System V register save area：
        // +0..+40 为六个通用寄存器槽，+48..+175 为八个 16 字节 SSE 槽。
        if (function.has_body && function.variadic &&
            !add_storage(
                &plan, &frame, function_id, StorageKind.register_save_area, function_id,
                function.return_type, FrameLimit.register_save_area_size as usize,
                FrameLimit.register_save_area_alignment as usize, &offset)) {
            if (plan.error == runtime::Error.none) {
                plan.error = runtime::Error.invalid_argument;
            }
            break;
        }
        if (function.has_body) {
            let storage: *const Storage = plan.storage.data as *const Storage;
            var storage_index: usize = 0;
            while (storage_index < frame.storage_count) {
                let alignment: usize = storage[frame.first_storage + storage_index].alignment_bytes;
                if (alignment > frame.dynamic_alignment) {
                    frame.dynamic_alignment = alignment;
                }
                storage_index += 1;
            }
            if (frame.dynamic_alignment <= (FrameLimit.stack_alignment as usize)) {
                frame.dynamic_alignment = 0;
            }
        }
        frame.frame_size_bytes = frame_align_up(offset, FrameLimit.stack_alignment as usize);
        if (frame.frame_size_bytes == frame_no_id() ||
            frame.frame_size_bytes > FrameLimit.maximum_frame_size as usize ||
            !append_frame(
                &plan, frame)) {
            if (plan.error == runtime::Error.none) {
                plan.error = runtime::Error.invalid_argument;
            }
            break;
        }
        function_id += 1;
    }
    if (plan.error != runtime::Error.none) {
        let error: runtime::Error = plan.error;
        plan_release(plan);
        return {
            plan = plan_empty(), error = error,
        };
    }
    return {
        plan = plan, error = runtime::Error.none,
    };
}

fn plan_equal(left: Plan, right: Plan) -> bool {
    return left.error == right.error && left.frame_count == right.frame_count &&
        left.storage_count == right.storage_count &&
        bytes::equal(left.frames, right.frames.data as *const u8, right.frames.length) &&
        bytes::equal(left.storage, right.storage.data as *const u8, right.storage.length);
}

fn plan_is_valid(plan: Plan, ir: ir::Store, types: type_info::Table, abi: Abi) -> bool {
    if (plan.error != runtime::Error.none || !plan_storage_is_valid(plan)) {
        return false;
    }
    let expected: PlanResult = plan_build(ir, types, abi);
    let valid: bool = expected.error == runtime::Error.none && plan_equal(plan, expected.plan);
    plan_release(expected.plan);
    return valid;
}

fn invalid()
    -> Frame {
    let none: usize = frame_no_id();
    return {
        function_id = none, first_storage = none, storage_count = 0, frame_size_bytes = 0, dynamic_alignment = 0,
    };
}

fn storage_invalid()
    -> Storage {
    let none: usize = frame_no_id();
    return {
        function_id = none, kind = StorageKind.invalid, source_id = none, type_id = none,
        offset_bytes = 0, size_bytes = 0, alignment_bytes = 0,
    };
}

fn get(plan: Plan, function_id: usize) -> FrameResult {
    if (!plan_storage_is_valid(plan) || function_id >= plan.frame_count) {
        return {
            frame = invalid(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        frame = (plan.frames.data as *const Frame)[function_id], error = runtime::Error.none,
    };
}

fn storage_find(plan: Plan, function_id: usize, kind: StorageKind, source_id: usize) -> StorageResult {
    if (!plan_storage_is_valid(plan) || function_id >= plan.frame_count || kind == StorageKind.invalid) {
        return {
            storage = storage_invalid(), error = runtime::Error.invalid_argument,
        };
    }
    let frame: Frame = (plan.frames.data as *const Frame)[function_id];
    let storage: *const Storage = plan.storage.data as *const Storage;
    var index: usize = 0;
    while (index < frame.storage_count) {
        let candidate: Storage = storage[frame.first_storage + index];
        if (candidate.kind == kind && candidate.source_id == source_id) {
            return {
                storage = candidate, error = runtime::Error.none,
            };
        }
        index += 1;
    }
    return {
        storage = storage_invalid(), error = runtime::Error.not_found,
    };
}

fn plan_release(plan: Plan) -> runtime::Error {
    if (!plan_storage_is_valid(plan)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(plan.frames);
    let storage_error: runtime::Error = bytes::release(plan.storage);
    if (error == runtime::Error.none) {
        error = storage_error;
    }
    return error;
}
