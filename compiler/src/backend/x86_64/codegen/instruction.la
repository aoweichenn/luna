module luna.compiler.x86.codegen;

impl CodeGenerator {

priv fn emit_control( instruction: ir::Instruction) -> bool {
    switch (instruction.opcode) {
    case ir::Opcode.jump {
        this->literal("    jmp ");
        this->block_label(instruction.auxiliary);
        this->literal("\n");
        return this->ready();
    }
    case ir::Opcode.branch {
        let values: *const ir::Value = this->ir.values.data as *const ir::Value;
        let record: *const type_info::Record = this->type( values[instruction.left].type_id);
        if (record == null || !this->load_rax(instruction.left, record)) {
            return false;
        }
        this->literal("    testl %eax, %eax\n    jne ");
        this->block_label(instruction.auxiliary);
        this->literal("\n    jmp ");
        this->block_label(instruction.third);
        this->literal("\n");
        return this->ready();
    }
    case ir::Opcode.return_value, ir::Opcode.return_void {
        return this->emit_return(instruction);
    }
    default {
        return this->fail(runtime::Error.invalid_argument);
    }
    }
}

priv fn emit_instruction( instruction: ir::Instruction, instruction_id: usize) -> bool {
    switch (instruction.opcode) {
    case ir::Opcode.constant_integer, ir::Opcode.constant_float, ir::Opcode.constant_boolean, ir::Opcode.constant_null {
        return this->emit_constant( instruction);
    }
    case ir::Opcode.address_of_slot, ir::Opcode.member_address, ir::Opcode.global_address,
        ir::Opcode.function_address, ir::Opcode.pointer_offset {
        return this->emit_address( instruction);
    }
    case ir::Opcode.zero_slot {
        return this->emit_zero( instruction);
    }
    case ir::Opcode.memory_copy {
        return this->emit_memory_copy( instruction, instruction_id);
    }
    case ir::Opcode.load, ir::Opcode.store {
        return this->emit_slot_access( instruction);
    }
    case ir::Opcode.load_indirect {
        return this->emit_load_indirect( instruction);
    }
    case ir::Opcode.store_indirect {
        return this->emit_store_indirect( instruction);
    }
    case ir::Opcode.null_check, ir::Opcode.bounds_check {
        return this->emit_check( instruction, instruction_id);
    }
    case ir::Opcode.unary_integer, ir::Opcode.unary_float, ir::Opcode.boolean_not {
        return this->emit_unary( instruction);
    }
    case ir::Opcode.convert {
        return this->emit_convert( instruction, instruction_id);
    }
    case ir::Opcode.binary_integer {
        return this->emit_binary_integer( instruction, instruction_id);
    }
    case ir::Opcode.binary_float, ir::Opcode.float_min, ir::Opcode.float_max {
        return this->emit_binary_float( instruction);
    }
    case ir::Opcode.float_sqrt {
        return this->emit_float_sqrt( instruction);
    }
    case ir::Opcode.overflow_flag {
        return this->emit_overflow_flag( instruction);
    }
    case ir::Opcode.compare {
        return this->emit_compare( instruction);
    }
    case ir::Opcode.call {
        return this->emit_call( instruction, instruction_id);
    }
    case ir::Opcode.call_indirect {
        return this->emit_call_indirect( instruction, instruction_id);
    }
    case ir::Opcode.va_list_start {
        return this->emit_va_start( instruction);
    }
    case ir::Opcode.va_list_arg {
        return this->emit_va_arg( instruction, instruction_id);
    }
    case ir::Opcode.jump, ir::Opcode.branch, ir::Opcode.return_value, ir::Opcode.return_void {
        return this->emit_control( instruction);
    }
    case ir::Opcode.unreachable {
        return this->literal( "    ud2\n");
    }
    default {
        return this->fail( runtime::Error.invalid_argument);
    }
    }
}

}
