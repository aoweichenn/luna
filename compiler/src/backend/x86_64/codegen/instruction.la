module luna.bootstrap.backend.x86_64.codegen.instruction;

import luna.bootstrap.backend.x86_64.codegen.instruction.call as call;
import luna.bootstrap.backend.x86_64.codegen.instruction.value as value;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime as runtime;

fn emit_control(context: *support::Context, instruction: ir::Instruction) -> bool {
    if (instruction.opcode == ir::Opcode.jump) {
        return support::literal(context, "    jmp ") && support::block_label(context, instruction.auxiliary) &&
            support::literal(context, "\n");
    }
    if (instruction.opcode == ir::Opcode.branch) {
        let values: *const ir::Value = context->ir.values.data as *const ir::Value;
        let record: *const type_info::Record = support::type(context, values[instruction.left].type_id);
        return record != null && support::load_rax(context, instruction.left, record) &&
            support::literal(context, "    testl %eax, %eax\n    jne ") && support::block_label(context,
                instruction.auxiliary) &&
            support::literal(context, "\n    jmp ") && support::block_label(context, instruction.third) &&
                support::literal(context, "\n");
    }
    return call::emit_return(context, instruction);
}

fn emit_instruction(context: *support::Context, instruction: ir::Instruction, instruction_id: usize) -> bool {
    if (instruction.opcode == ir::Opcode.constant_integer || instruction.opcode ==
            ir::Opcode.constant_float || instruction.opcode == ir::Opcode.constant_boolean ||
        instruction.opcode == ir::Opcode.constant_null) {
        return value::emit_constant(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.address_of_slot || instruction.opcode ==
            ir::Opcode.member_address || instruction.opcode == ir::Opcode.global_address ||
        instruction.opcode == ir::Opcode.function_address || instruction.opcode == ir::Opcode.pointer_offset) {
        return value::emit_address(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.zero_slot) {
        return value::emit_zero(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.memory_copy) {
        return value::emit_memory_copy(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.load || instruction.opcode == ir::Opcode.store) {
        return value::emit_slot_access(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.load_indirect) {
        return value::emit_load_indirect(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.store_indirect) {
        return value::emit_store_indirect(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.null_check || instruction.opcode == ir::Opcode.bounds_check) {
        return value::emit_check(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.unary_integer || instruction.opcode == ir::Opcode.unary_float ||
        instruction.opcode == ir::Opcode.boolean_not) {
        return value::emit_unary(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.convert) {
        return value::emit_convert(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.binary_integer) {
        return value::emit_binary_integer(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.binary_float || instruction.opcode == ir::Opcode.float_min ||
        instruction.opcode == ir::Opcode.float_max) {
        return value::emit_binary_float(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.float_sqrt) {
        return value::emit_float_sqrt(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.overflow_flag) {
        return value::emit_overflow_flag(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.compare) {
        return value::emit_compare(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.call) {
        return call::emit_call(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.call_indirect) {
        return call::emit_call_indirect(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.va_list_start) {
        return call::emit_va_start(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.va_list_arg) {
        return call::emit_va_arg(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.jump || instruction.opcode == ir::Opcode.branch ||
        instruction.opcode == ir::Opcode.return_value || instruction.opcode == ir::Opcode.return_void) {
        return emit_control(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.unreachable) {
        return support::literal(context, "    ud2\n");
    }
    return support::fail(context, runtime::Error.invalid_argument);
}

