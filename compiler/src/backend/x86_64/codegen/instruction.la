module luna.compiler.x86.codegen;


fn emit_control(context: *CodegenContext, instruction: ir::Instruction) -> bool {
    if (instruction.opcode == ir::Opcode.jump) {
        return literal(context, "    jmp ") && block_label(context, instruction.auxiliary) && literal(context, "\n");
    }
    if (instruction.opcode == ir::Opcode.branch) {
        let values: *const ir::Value = context->ir.values.data as *const ir::Value;
        let record: *const type_info::Record = type(context, values[instruction.left].type_id);
        return record != null && load_rax(context, instruction.left, record) &&
            literal(context, "    testl %eax, %eax\n    jne ") && block_label(context, instruction.auxiliary) &&
            literal(context, "\n    jmp ") && block_label(context, instruction.third) && literal(context, "\n");
    }
    return emit_return(context, instruction);
}

fn emit_instruction(context: *CodegenContext, instruction: ir::Instruction, instruction_id: usize) -> bool {
    if (instruction.opcode == ir::Opcode.constant_integer || instruction.opcode ==
            ir::Opcode.constant_float || instruction.opcode == ir::Opcode.constant_boolean ||
        instruction.opcode == ir::Opcode.constant_null) {
        return emit_constant(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.address_of_slot || instruction.opcode ==
            ir::Opcode.member_address || instruction.opcode == ir::Opcode.global_address ||
        instruction.opcode == ir::Opcode.function_address || instruction.opcode == ir::Opcode.pointer_offset) {
        return emit_address(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.zero_slot) {
        return emit_zero(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.memory_copy) {
        return emit_memory_copy(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.load || instruction.opcode == ir::Opcode.store) {
        return emit_slot_access(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.load_indirect) {
        return emit_load_indirect(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.store_indirect) {
        return emit_store_indirect(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.null_check || instruction.opcode == ir::Opcode.bounds_check) {
        return emit_check(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.unary_integer || instruction.opcode == ir::Opcode.unary_float ||
        instruction.opcode == ir::Opcode.boolean_not) {
        return emit_unary(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.convert) {
        return emit_convert(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.binary_integer) {
        return emit_binary_integer(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.binary_float || instruction.opcode == ir::Opcode.float_min ||
        instruction.opcode == ir::Opcode.float_max) {
        return emit_binary_float(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.float_sqrt) {
        return emit_float_sqrt(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.overflow_flag) {
        return emit_overflow_flag(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.compare) {
        return emit_compare(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.call) {
        return emit_call(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.call_indirect) {
        return emit_call_indirect(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.va_list_start) {
        return emit_va_start(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.va_list_arg) {
        return emit_va_arg(context, instruction, instruction_id);
    }
    if (instruction.opcode == ir::Opcode.jump || instruction.opcode == ir::Opcode.branch ||
        instruction.opcode == ir::Opcode.return_value || instruction.opcode == ir::Opcode.return_void) {
        return emit_control(context, instruction);
    }
    if (instruction.opcode == ir::Opcode.unreachable) {
        return literal(context, "    ud2\n");
    }
    return fail(context, runtime::Error.invalid_argument);
}
