module luna.bootstrap.backend.x86_64.abi;

import luna.bootstrap.middleend.ir.verify as ir_check;

import luna.std.checked as checked;

enum Limit: usize {
    maximum_size = 18446744073709551615, general_register_count = 6, vector_register_count = 8, eightbyte_size = 8,
    stack_alignment = 16, maximum_register_eightbytes = 2, maximum_type_depth = 128, maximum_stack_size = 2147483647,
}

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty() -> Abi {
    return {
        functions = bytes::empty(), function_count = 0, parameters = bytes::empty(),
        parameter_count = 0, pieces = bytes::empty(), piece_count = 0, error = runtime::Error.none,
    };
}

fn buffer_matches(buffer: bytes::Buffer, count: usize, record_size: usize) -> bool {
    return bytes::is_valid(buffer) && record_size != 0 && buffer.length % record_size == 0 &&
        count == buffer.length / record_size;
}

fn storage_is_valid(abi: Abi) -> bool {
    return buffer_matches(abi.functions, abi.function_count, sizeof(Function)) &&
        buffer_matches(abi.parameters, abi.parameter_count, sizeof(Parameter)) &&
        buffer_matches(abi.pieces, abi.piece_count, sizeof(Piece));
}

fn align_up(value: usize, alignment: usize) -> usize {
    var result: usize = 0;
    return checked::align_up(value, alignment, &result) ? result : no_id();
}

fn class_merge(left: Class, right: Class) -> Class {
    if (left == right) {
        return left;
    }
    if (left == Class.no_class) {
        return right;
    }
    if (right == Class.no_class) {
        return left;
    }
    if (left == Class.memory || right == Class.memory) {
        return Class.memory;
    }
    if (left == Class.integer || right == Class.integer) {
        return Class.integer;
    }
    return Class.sse;
}

fn set_memory(classification: *Classification) -> bool {
    if (classification == null) {
        return false;
    }
    classification->eightbyte_count = 1;
    classification->first = Class.memory;
    classification->second = Class.no_class;
    return false;
}

fn scalar_class(kind: type_info::Kind) -> Class {
    return type_info::is_float(kind) ? Class.sse : Class.integer;
}

fn merge_leaf(
    classification: *Classification, offset_bytes: usize, size_bytes: usize, alignment_bytes: usize,
    abi_class: Class) -> bool {
    let output_is_valid: bool = classification != null && size_bytes != 0;
    let scalar_shape_is_valid: bool = size_bytes <= 8 && alignment_bytes != 0;
    let alignment_is_valid: bool = scalar_shape_is_valid && offset_bytes % alignment_bytes == 0;
    let offset_is_bounded: bool = offset_bytes <= 15;
    let range_is_valid: bool = offset_is_bounded && size_bytes <= 16 - offset_bytes;
    let layout_is_valid: bool = alignment_is_valid && range_is_valid;
    if (!output_is_valid || !layout_is_valid) {
        return set_memory(classification);
    }
    let first: usize = offset_bytes / 8;
    let last: usize = (offset_bytes + size_bytes - 1) / 8;
    for (var index: usize = first; index <= last; index += 1) {
        if (index == 0) {
            classification->first = class_merge(classification->first, abi_class);
        } else if (index == 1) {
            classification->second = class_merge(classification->second, abi_class);
        } else {
            return set_memory(classification);
        }
    }
    return true;
}

fn merge_type(
    types: type_info::Table, type_id: usize, base_offset: usize, depth: usize,
    classification: *Classification) -> bool {
    let input_is_valid: bool = type_id < types.type_count && depth <= Limit.maximum_type_depth as usize;
    let output_is_valid: bool = classification != null && classification->first != Class.memory;
    if (!input_is_valid || !output_is_valid) {
        return set_memory(classification);
    }
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let fields: *const type_info::Field = types.fields.data as *const type_info::Field;
    let record: type_info::Record = records[type_id];
    if (type_info::is_scalar(record.kind)) {
        return merge_leaf(
            classification, base_offset, record.size_bytes, record.alignment_bytes, scalar_class(record.kind));
    }
    if (record.kind == type_info::Kind.array) {
        let element: type_info::Record = records[record.element_type];
        for (var index: usize = 0; index < record.element_count; index += 1) {
            if (index > (Limit.maximum_size as usize) / element.size_bytes ||
                !merge_type(
                    types, record.element_type, base_offset + index * element.size_bytes, depth + 1, classification)) {
                return false;
            }
        }
        return true;
    }
    if (type_info::is_record(record.kind)) {
        if (record.kind == type_info::Kind.class_type && record.base_type != type_info::no_id()) {
            if (!merge_type(types, record.base_type, base_offset, depth + 1, classification)) {
                return false;
            }
        }
        for (var index: usize = 0; index < record.field_count; index += 1) {
            let field: type_info::Field = fields[record.first_field + index];
            if (field.offset_bytes > (Limit.maximum_size as usize) - base_offset ||
                !merge_type(
                    types, field.type_id, base_offset + field.offset_bytes, depth + 1, classification)) {
                return false;
            }
        }
        return true;
    }
    return set_memory(classification);
}

fn classify(types: type_info::Table, type_id: usize) -> Classification {
    var result: Classification = {
        eightbyte_count = 0, first = Class.invalid, second = Class.invalid,
    };
    if (!type_info::table_is_valid(types, true) || type_id >= types.type_count) {
        return result;
    }
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let record: type_info::Record = records[type_id];
    if (!type_info::is_memory(record.kind) || record.size_bytes == 0) {
        return result;
    }
    result.first = Class.no_class;
    result.second = Class.no_class;
    if (record.size_bytes > 16 || record.alignment_bytes > 16) {
        set_memory(&result);
        return result;
    }
    result.eightbyte_count = (record.size_bytes + 7) / 8;
    if (!merge_type(
            types, type_id, 0, 0, &result)) {
        return result;
    }
    if (result.first == Class.no_class) {
        result.first = Class.integer;
    }
    if (result.eightbyte_count == 2 && result.second == Class.no_class) {
        result.second = Class.integer;
    }
    return result;
}

fn append(buffer: bytes::Buffer, record: *const u8, record_size: usize) -> bytes::BufferResult {
    if (record == null || record_size == 0) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }
    return bytes::append(buffer, record, record_size);
}

fn add_piece(abi: *Abi, piece: Piece) -> usize {
    let none: usize = no_id();
    if (abi == null || abi->error != runtime::Error.none) {
        return none;
    }
    let appended: bytes::BufferResult = append(abi->pieces, (&piece) as *const Piece as *const u8, sizeof(Piece));
    abi->pieces = appended.buffer;
    abi->error = appended.error;
    if (appended.error != runtime::Error.none) {
        return none;
    }
    let result: usize = abi->piece_count;
    abi->piece_count += 1;
    return result;
}

fn add_parameter(abi: *Abi, parameter: Parameter) -> usize {
    let none: usize = no_id();
    if (abi == null || abi->error != runtime::Error.none) {
        return none;
    }
    let appended: bytes::BufferResult =
        append(abi->parameters, (&parameter) as *const Parameter as *const u8, sizeof(Parameter));
    abi->parameters = appended.buffer;
    abi->error = appended.error;
    if (appended.error != runtime::Error.none) {
        return none;
    }
    let result: usize = abi->parameter_count;
    abi->parameter_count += 1;
    return result;
}

fn add_function(abi: *Abi, function: Function) -> usize {
    let none: usize = no_id();
    if (abi == null || abi->error != runtime::Error.none) {
        return none;
    }
    let appended: bytes::BufferResult =
        append(abi->functions, (&function) as *const Function as *const u8, sizeof(Function));
    abi->functions = appended.buffer;
    abi->error = appended.error;
    if (appended.error != runtime::Error.none) {
        return none;
    }
    let result: usize = abi->function_count;
    abi->function_count += 1;
    return result;
}

fn piece_class(classification: Classification, index: usize) -> Class {
    return index == 0 ? classification.first : classification.second;
}

fn piece_size(size_bytes: usize, index: usize) -> usize {
    let offset: usize = index * 8;
    let remaining: usize = size_bytes - offset;
    return remaining < 8 ? remaining : 8;
}

fn add_stack_area(
    current_size: usize, size_bytes: usize, alignment_bytes: usize, offset: *usize, area_size: *usize) -> usize {
    if (offset == null || area_size == null || size_bytes == 0 || alignment_bytes == 0) {
        return no_id();
    }
    let stack_alignment: usize = alignment_bytes > 8 ? alignment_bytes : 8;
    let aligned_offset: usize = align_up(current_size, stack_alignment);
    let aligned_size: usize = align_up(size_bytes, 8);
    if (aligned_offset == no_id() || aligned_size == no_id() ||
        aligned_offset > (Limit.maximum_size as usize) - aligned_size) {
        return no_id();
    }
    *offset = aligned_offset;
    *area_size = aligned_size;
    return aligned_offset + aligned_size;
}

fn build_return(abi: *Abi, function: *Function, types: type_info::Table) -> bool {
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let record: type_info::Record = records[function->return_type];
    function->return_size_bytes = record.size_bytes;
    function->return_alignment_bytes = record.alignment_bytes;
    function->return_aggregate = type_info::is_memory(record.kind);
    function->first_return_piece = no_id();
    if (!function->return_aggregate) {
        return true;
    }
    let classification: Classification = classify(types, function->return_type);
    if (classification.first == Class.memory) {
        function->hidden_return_pointer = true;
        function->general_register_count = 1;
        return true;
    }
    function->first_return_piece = abi->piece_count;
    var general_index: usize = 0;
    var vector_index: usize = 0;
    for (var index: usize = 0; index < classification.eightbyte_count; index += 1) {
        let abi_class: Class = piece_class(classification, index);
        let register_index: usize = abi_class == Class.integer ? general_index : vector_index;
        if (abi_class == Class.integer) {
            general_index += 1;
        } else {
            vector_index += 1;
        }
        if (add_piece(
                abi, {
                    abi_class = abi_class, location = abi_class == Class.integer ?
                            LocationKind.general_register : LocationKind
                                .vector_register, register_index = register_index, value_offset_bytes = index * 8,
                    size_bytes = piece_size(record.size_bytes, index),
                }) == no_id()) {
            return false;
        }
        function->return_piece_count += 1;
    }
    return true;
}

fn build_scalar_parameter(function: *Function, parameter: *Parameter, record: type_info::Record) -> bool {
    let abi_class: Class = scalar_class(record.kind);
    parameter->abi_class = abi_class;
    if (abi_class == Class.integer && function->general_register_count < Limit.general_register_count as usize) {
        parameter->location = LocationKind.general_register;
        parameter->register_index = function->general_register_count;
        function->general_register_count += 1;
        return true;
    }
    if (abi_class == Class.sse && function->vector_register_count < Limit.vector_register_count as usize) {
        parameter->location = LocationKind.vector_register;
        parameter->register_index = function->vector_register_count;
        function->vector_register_count += 1;
        return true;
    }
    var offset: usize = 0;
    var area_size: usize = 0;
    let total: usize = add_stack_area(function->stack_argument_size_bytes, 8, 8, &offset, &area_size);
    if (total == no_id()) {
        return false;
    }
    function->stack_argument_size_bytes = total;
    parameter->location = LocationKind.stack;
    parameter->stack_offset_bytes = offset;
    parameter->stack_size_bytes = area_size;
    return true;
}

fn build_aggregate_parameter(
    abi: *Abi, function: *Function, parameter: *Parameter, types: type_info::Table, record: type_info::Record) -> bool {
    let classification: Classification = classify(types, parameter->type_id);
    var required_general: usize = 0;
    var required_vector: usize = 0;
    for (var index: usize = 0;
        index < classification.eightbyte_count && classification.first != Class.memory;
        index += 1) {
        if (piece_class(
                classification, index) == Class.integer) {
            required_general += 1;
        } else {
            required_vector += 1;
        }
    }
    let register_classification: bool = classification.first != Class.memory;
    let general_registers_fit: bool = required_general <=
        (Limit.general_register_count as usize) - function->general_register_count;
    let vector_registers_fit: bool = required_vector <=
        (Limit.vector_register_count as usize) - function->vector_register_count;
    let register_counts_fit: bool = general_registers_fit && vector_registers_fit;
    let registers_fit: bool = register_classification && register_counts_fit;
    if (!registers_fit) {
        var offset: usize = 0;
        var area_size: usize = 0;
        let total: usize =
            add_stack_area(
                function->stack_argument_size_bytes, record.size_bytes, record.alignment_bytes, &offset, &area_size);
        if (total == no_id()) {
            return false;
        }
        function->stack_argument_size_bytes = total;
        parameter->abi_class = Class.memory;
        parameter->location = LocationKind.stack;
        parameter->stack_offset_bytes = offset;
        parameter->stack_size_bytes = area_size;
        return true;
    }

    parameter->first_piece = abi->piece_count;
    parameter->piece_count = classification.eightbyte_count;
    parameter->abi_class = classification.eightbyte_count == 1 ? classification.first : Class.no_class;
    parameter->location = LocationKind.invalid;
    for (var index: usize = 0; index < classification.eightbyte_count; index += 1) {
        let abi_class: Class = piece_class(classification, index);
        let is_integer: bool = abi_class == Class.integer;
        let register_index: usize = is_integer ? function->general_register_count : function->vector_register_count;
        if (is_integer) {
            function->general_register_count += 1;
        } else {
            function->vector_register_count += 1;
        }
        let location: LocationKind = is_integer ? LocationKind.general_register : LocationKind.vector_register;
        if (add_piece(
                abi, {
                    abi_class = abi_class, location = location, register_index = register_index,
                    value_offset_bytes = index * 8, size_bytes = piece_size(record.size_bytes, index),
                }) == no_id()) {
            return false;
        }
    }
    return true;
}

fn build_parameter(
    abi: *Abi, function: *Function, ir_parameter: ir::Parameter,
    parameter_index: usize, types: type_info::Table) -> bool {
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let record: type_info::Record = records[ir_parameter.type_id];
    let none: usize = no_id();
    var parameter: Parameter = {
        function_id = function->function_id, parameter_index = parameter_index,
        abi_class = Class.invalid, location = LocationKind.invalid,
        register_index = none, stack_offset_bytes = none, stack_size_bytes = 0, type_id = ir_parameter.type_id,
        size_bytes = record.size_bytes, alignment_bytes = record.alignment_bytes, first_piece = none, piece_count = 0,
        aggregate = type_info::is_memory(record.kind),
    };
    let built: bool = parameter.aggregate ? build_aggregate_parameter(abi, function, &parameter, types, record) :
        build_scalar_parameter(function, &parameter, record);
    return built && add_parameter(abi, parameter) != none;
}

fn finish_function(abi: *Abi, function: *Function) -> bool {
    function->call_frame_size_bytes = align_up(function->stack_argument_size_bytes, Limit.stack_alignment as usize);
    let frame_exists: bool = function->call_frame_size_bytes != no_id();
    let frame_is_bounded: bool = function->call_frame_size_bytes <= Limit.maximum_stack_size as usize;
    let frame_is_valid: bool = frame_exists && frame_is_bounded;
    return frame_is_valid && add_function(abi, *function) != no_id();
}

fn analyze(ir: ir::Store, types: type_info::Table) -> Result {
    var abi: Abi = empty();
    if (!ir_check::is_valid(ir, types)) {
        return {
            abi = abi, error = runtime::Error.invalid_argument,
        };
    }
    let functions: *const ir::Function = ir.functions.data as *const ir::Function;
    let parameters: *const ir::Parameter = ir.parameters.data as *const ir::Parameter;
    let none: usize = no_id();
    for (var function_id: usize = 0;
        function_id < ir.function_count && abi.error == runtime::Error.none;
        function_id += 1) {
        let source: ir::Function = functions[function_id];
        var function: Function = {
            function_id = function_id, first_parameter = source.parameter_count == 0 ? none : abi.parameter_count,
            parameter_count = 0, first_return_piece = none, return_piece_count = 0, return_type = source.return_type,
            return_size_bytes = 0, return_alignment_bytes = 0, return_aggregate = false, hidden_return_pointer = false,
            general_register_count = 0, vector_register_count = 0, stack_argument_size_bytes = 0,
            call_frame_size_bytes = 0,
        };
        if (!build_return(
                &abi, &function, types)) {
            abi.error = runtime::Error.invalid_argument;
            break;
        }
        for (var index: usize = 0;
            index < source.parameter_count && abi.error == runtime::Error.none;
            index += 1) {
            if (!build_parameter(
                    &abi, &function, parameters[source.first_parameter + index], index, types)) {
                if (abi.error == runtime::Error.none) {
                    abi.error = runtime::Error.invalid_argument;
                }
                break;
            }
            function.parameter_count += 1;
        }
        let parameters_are_valid: bool = abi.error == runtime::Error.none;
        if (!parameters_are_valid || !finish_function(&abi, &function)) {
            if (abi.error == runtime::Error.none) {
                abi.error = runtime::Error.invalid_argument;
            }
            break;
        }
    }
    let type_records: *const type_info::Record = types.types.data as *const type_info::Record;
    let type_fields: *const type_info::Field = types.fields.data as *const type_info::Field;
    for (var signature_type: usize = 0;
        signature_type < types.type_count && abi.error == runtime::Error.none;
        signature_type += 1) {
        let record: type_info::Record = type_records[signature_type];
        if (record.kind != type_info::Kind.function_pointer) {
            continue;
        }
        var synthesized: Function = {
            function_id = none, first_parameter = record.field_count == 0 ? none : abi.parameter_count,
            parameter_count = 0, first_return_piece = none, return_piece_count = 0, return_type = record.element_type,
            return_size_bytes = 0, return_alignment_bytes = 0, return_aggregate = false, hidden_return_pointer = false,
            general_register_count = 0, vector_register_count = 0, stack_argument_size_bytes = 0,
            call_frame_size_bytes = 0,
        };
        if (!build_return(
                &abi, &synthesized, types)) {
            abi.error = runtime::Error.invalid_argument;
            break;
        }
        for (var parameter_index: usize = 0;
            parameter_index < record.field_count && abi.error == runtime::Error.none;
            parameter_index += 1) {
            var ir_parameter: ir::Parameter = {
                function_id = none, type_id = type_fields[ record.first_field + parameter_index].type_id,
                slot_id = none, name_token = none,
            };
            if (!build_parameter(
                    &abi, &synthesized, ir_parameter, parameter_index, types)) {
                if (abi.error == runtime::Error.none) {
                    abi.error = runtime::Error.invalid_argument;
                }
                break;
            }
            synthesized.parameter_count += 1;
        }
        let function_is_finished: bool = abi.error == runtime::Error.none && finish_function(&abi, &synthesized);
        if (!function_is_finished) {
            if (abi.error == runtime::Error.none) {
                abi.error = runtime::Error.invalid_argument;
            }
        }
    }
    if (abi.error != runtime::Error.none) {
        let error: runtime::Error = abi.error;
        release(abi);
        return {
            abi = empty(), error = error,
        };
    }
    return {
        abi = abi, error = runtime::Error.none,
    };
}

fn equal(left: Abi, right: Abi) -> bool {
    return left.error == right.error && left.function_count == right.function_count &&
        left.parameter_count == right.parameter_count && left.piece_count == right.piece_count &&
        bytes::equal(left.functions, right.functions.data as *const u8, right.functions.length) &&
        bytes::equal(left.parameters, right.parameters.data as *const u8, right.parameters.length) &&
        bytes::equal(left.pieces, right.pieces.data as *const u8, right.pieces.length);
}

fn is_valid(abi: Abi, ir: ir::Store, types: type_info::Table) -> bool {
    if (abi.error != runtime::Error.none || !storage_is_valid(abi)) {
        return false;
    }
    let expected: Result = analyze(ir, types);
    let valid: bool = expected.error == runtime::Error.none && equal(abi, expected.abi);
    release(expected.abi);
    return valid;
}

fn invalid_function()
    -> Function {
    let none: usize = no_id();
    return {
        function_id = none, first_parameter = none, parameter_count = 0, first_return_piece = none,
        return_piece_count = 0, return_type = none, return_size_bytes = 0, return_alignment_bytes = 0,
        return_aggregate = false, hidden_return_pointer = false, general_register_count = 0, vector_register_count = 0,
        stack_argument_size_bytes = 0, call_frame_size_bytes = 0,
    };
}

fn invalid_parameter()
    -> Parameter {
    let none: usize = no_id();
    return {
        function_id = none, parameter_index = none, abi_class = Class.invalid,
        location = LocationKind.invalid, register_index = none, stack_offset_bytes = none,
        stack_size_bytes = 0, type_id = none, size_bytes = 0, alignment_bytes = 0, first_piece = none, piece_count = 0,
        aggregate = false,
    };
}

fn invalid_piece()
    -> Piece {
    return {
        abi_class = Class.invalid, location = LocationKind.invalid,
        register_index = no_id(), value_offset_bytes = 0, size_bytes = 0,
    };
}

fn get_function(abi: Abi, function_id: usize) -> FunctionResult {
    if (!storage_is_valid(abi) || function_id >= abi.function_count) {
        return {
            function = invalid_function(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        function = (abi.functions.data as *const Function)[function_id], error = runtime::Error.none,
    };
}

fn get_parameter(abi: Abi, parameter_id: usize) -> ParameterResult {
    if (!storage_is_valid(abi) || parameter_id >= abi.parameter_count) {
        return {
            parameter = invalid_parameter(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        parameter = (abi.parameters.data as *const Parameter)[parameter_id], error = runtime::Error.none,
    };
}

fn get_piece(abi: Abi, piece_id: usize) -> PieceResult {
    if (!storage_is_valid(abi) || piece_id >= abi.piece_count) {
        return {
            piece = invalid_piece(), error = runtime::Error.invalid_argument,
        };
    }
    return {
        piece = (abi.pieces.data as *const Piece)[piece_id], error = runtime::Error.none,
    };
}

fn release(abi: Abi) -> runtime::Error {
    if (!storage_is_valid(abi)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(abi.functions);
    let parameter_error: runtime::Error = bytes::release(abi.parameters);
    if (error == runtime::Error.none) {
        error = parameter_error;
    }
    let piece_error: runtime::Error = bytes::release(abi.pieces);
    if (error == runtime::Error.none) {
        error = piece_error;
    }
    return error;
}
