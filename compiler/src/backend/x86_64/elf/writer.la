module luna.compiler.x86.elf;


// 把内存对象模型写成标准 ELF64 ET_REL，使 host toolchain 能把 Luna 代码链接进 C 程序。
// 输出严格落在 reader 支持的子集中，因此 luna-as --emit elf 可经 luna-link round-trip：
// section 0 为 SHT_NULL；非空 region 变成已分配的 PROGBITS（.text/.rodata/.data）或
// NOBITS .bss；单个 SHT_SYMTAB 先放 local 再放 global，sh_info 指向首个 global；每个含
// relocation 的 region 对应一个链接到 symtab 的显式 addend SHT_RELA section。空的
// .note.GNU-stack 阻止 host linker 假定 executable stack。padding 全部填零以保证字节确定性。

impl ElfWriter {
    init(source: *const object::Object): sections = vector::vector<OutputSection>(),
            symbol_map = vector::vector<SymbolMapping>() {
        this->source = source;
        this->shstrtab = bytes::empty();
        this->strtab = bytes::empty();
        this->symtab = bytes::empty();
        this->rela_text = bytes::empty();
        this->rela_rodata = bytes::empty();
        this->rela_data = bytes::empty();
        this->output = bytes::empty();
        this->plan = {};
        this->error_code = runtime::Error.none;
    }

    priv fn fail(error: runtime::Error) -> bool {
        if (this->error_code == runtime::Error.none) {
            this->error_code = error;
        }
        return false;
    }

    priv fn release_buffer(buffer: *bytes::Buffer) -> runtime::Error {
        if (buffer == null) {
            return runtime::Error.invalid_argument;
        }
        let release_error: runtime::Error = bytes::release(*buffer);
        *buffer = bytes::empty();
        return release_error;
    }

    priv fn release_scratch() -> runtime::Error {
        var buffers: [6]*bytes::Buffer = {};
        buffers[0] = &this->rela_data;
        buffers[1] = &this->rela_rodata;
        buffers[2] = &this->rela_text;
        buffers[3] = &this->symtab;
        buffers[4] = &this->strtab;
        buffers[5] = &this->shstrtab;
        var first_error: runtime::Error = runtime::Error.none;
        for (var index: usize = 0; index < 6; index += 1) {
            let error: runtime::Error = this->release_buffer(buffers[index]);
            if (first_error == runtime::Error.none) {
                first_error = error;
            }
        }
        return first_error;
    }

    priv fn ready() const -> bool {
        return this->error_code == runtime::Error.none;
    }

    priv fn emit_u8(output: *bytes::Buffer, value: u8) {
        if (this->ready() && !binary::append_u8(output, value)) {
            this->fail(runtime::Error.out_of_memory);
        }
    }

    priv fn emit_u16(output: *bytes::Buffer, value: u16) {
        if (this->ready() && !binary::append_u16(output, value)) {
            this->fail(runtime::Error.out_of_memory);
        }
    }

    priv fn emit_u32(output: *bytes::Buffer, value: u32) {
        if (this->ready() && !binary::append_u32(output, value)) {
            this->fail(runtime::Error.out_of_memory);
        }
    }

    priv fn emit_u64(output: *bytes::Buffer, value: u64) {
        if (this->ready() && !binary::append_u64(output, value)) {
            this->fail(runtime::Error.out_of_memory);
        }
    }

    priv fn emit_bytes(output: *bytes::Buffer, data: *const u8, length: usize) {
        if (!this->ready()) {
            return;
        }
        if (output == null) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        let appended: bytes::BufferResult = bytes::append(*output, data, length);
        *output = appended.buffer;
        if (appended.error != runtime::Error.none) {
            this->fail(appended.error);
        }
    }

    priv fn emit_padding(output: *bytes::Buffer, offset: usize) {
        if (this->ready() && !pad_to(output, offset)) {
            this->fail(runtime::Error.out_of_memory);
        }
    }

    priv fn save_section_count() const -> usize {
        return this->sections.size();
    }

    priv fn save_section_at(index: usize) -> *OutputSection {
        if (index >= this->save_section_count()) {
            return null;
        }
        return &this->sections.get(index);
    }

    priv fn save_add_section(
    name: usize, kind: SectionType, flags: usize, size: usize, link: usize, info: usize,
    alignment: usize, entry_size: usize, source: SectionSource) -> bool {
    let section: OutputSection = {
        name = name, kind = kind, flags = flags, offset = 0, size = size, link = link, info = info,
        alignment = alignment, entry_size = entry_size, source = source,
    };
    let append_error: runtime::Error = this->sections.push_back(section);
    if (append_error != runtime::Error.none) {
        return this->fail(append_error);
    }
    return true;
}

    priv fn save_section_name(name: *const u8, length: usize, offset: *usize) -> bool {
    if (offset == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    *offset = this->shstrtab.length;
    this->emit_bytes(&this->shstrtab, name, length);
    this->emit_u8(&this->shstrtab, 0);
    return this->ready();
}

    priv fn save_plan(object: object::ObjectView, plan: *SavePlan) -> bool {
    if (plan == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    var has_text: bool = object.text.length != 0;
    var has_rodata: bool = object.rodata.length != 0;
    var has_data: bool = object.data.length != 0;
    var has_bss: bool = object.bss_size != 0;
    var local_count: usize = 0;
    var text_relocations: usize = 0;
    var rodata_relocations: usize = 0;
    var data_relocations: usize = 0;
    // 含已定义符号的 region 即使为空也需要 section，否则该符号没有有效 st_shndx。
    let symbol_total: usize = object.symbols.count;
    for (var index: usize = 0; index < symbol_total; index += 1) {
        let result: object::SymbolResult = object::symbol_at(object, index);
        if (result.error != runtime::Error.none) {
            return this->fail(result.error);
        }
        let symbol: object::Symbol = result.symbol;
        if (symbol.defined) {
            switch (symbol.section) {
            case object::Section.text {
                has_text = true;
            }
            case object::Section.rodata {
                has_rodata = true;
            }
            case object::Section.data {
                has_data = true;
            }
            case object::Section.bss {
                has_bss = true;
            }
            default {}
            }
            if (!symbol.global) {
                local_count += 1;
            }
        }
    }
    let relocation_total: usize = object.relocations.count;
    for (var index: usize = 0; index < relocation_total; index += 1) {
        let result: object::RelocationResult = object::relocation_at(object, index);
        if (result.error != runtime::Error.none) {
            return this->fail(result.error);
        }
        switch (result.relocation.section) {
        case object::Section.text {
            text_relocations += 1;
        }
        case object::Section.rodata {
            rodata_relocations += 1;
        }
        case object::Section.data {
            data_relocations += 1;
        }
        default {
            // 有效对象不会在 bss 或 undefined section 中放 relocation，这里防御性拒绝。
            return this->fail(runtime::Error.invalid_argument);
        }
        }
    }
    var next: usize = 1;
    plan->text_section = 0;
    plan->rodata_section = 0;
    plan->data_section = 0;
    plan->bss_section = 0;
    plan->rela_text_section = 0;
    plan->rela_rodata_section = 0;
    plan->rela_data_section = 0;
    if (has_text) {
        plan->text_section = next;
        next += 1;
    }
    if (has_rodata) {
        plan->rodata_section = next;
        next += 1;
    }
    if (has_data) {
        plan->data_section = next;
        next += 1;
    }
    if (has_bss) {
        plan->bss_section = next;
        next += 1;
    }
    plan->symtab_section = next;
    next += 1;
    plan->strtab_section = next;
    next += 1;
    plan->shstrtab_section = next;
    next += 1;
    if (text_relocations != 0) {
        plan->rela_text_section = next;
        next += 1;
    }
    if (rodata_relocations != 0) {
        plan->rela_rodata_section = next;
        next += 1;
    }
    if (data_relocations != 0) {
        plan->rela_data_section = next;
        next += 1;
    }
    plan->note_section = next;
    next += 1;
    plan->section_count = next;
    plan->first_global = local_count + 1;
    plan->section_offset = 0;
    return true;
}

    priv fn save_symbol_shndx(plan: *SavePlan, symbol: object::Symbol) -> usize {
    if (!symbol.defined) {
        return 0;
    }
    switch (symbol.section) {
    case object::Section.text {
        return plan->text_section;
    }
    case object::Section.rodata {
        return plan->rodata_section;
    }
    case object::Section.data {
        return plan->data_section;
    }
    case object::Section.bss {
        return plan->bss_section;
    }
    default {
        return 0;
    }
    }
}

    priv fn save_symbol_entry(
    object: object::ObjectView, plan: *SavePlan, symbol: object::Symbol,
    model_index: usize, symtab_index: usize) -> bool {
    let shndx: usize = this->save_symbol_shndx(plan, symbol);
    if (symbol.defined && shndx == 0) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let name_offset: usize = this->strtab.length;
    this->emit_bytes(&this->strtab, &object.names.data[symbol.name_offset], symbol.name_length);
    this->emit_u8(&this->strtab, 0);
    // 未定义模型符号必为 global 或 external，两者都发射成 STB_GLOBAL SHN_UNDEF；
    // 这是 reader 接受的唯一未定义形态。
    var bind: usize = SymbolBind.global as usize;
    if (symbol.defined && !symbol.global) {
        bind = SymbolBind.local as usize;
    }
    var symbol_type: usize = SymbolType.notype as usize;
    switch (symbol.kind) {
    case object::SymbolKind.function {
        symbol_type = SymbolType.function as usize;
    }
    case object::SymbolKind.object {
        symbol_type = SymbolType.object as usize;
    }
    default {}
    }
    let info: usize = (bind << 4) | symbol_type;
    this->emit_u32(&this->symtab, name_offset as u32);
    this->emit_u8(&this->symtab, info as u8);
    this->emit_u8(&this->symtab, 0);
    this->emit_u16(&this->symtab, shndx as u16);
    this->emit_u64(&this->symtab, symbol.value as u64);
    this->emit_u64(&this->symtab, symbol.size as u64);
    if (!this->ready()) {
        return false;
    }
    this->symbol_map.get(model_index).index = symtab_index;
    return true;
}

    priv fn save_symbols(object: object::ObjectView, plan: *SavePlan) -> bool {
    // Symbol 0 是强制的全零 entry；string table 以 NUL 开头，使 st_name 0 表示无名字。
    this->emit_padding(&this->symtab, Limit.symbol_size as usize);
    this->emit_u8(&this->strtab, 0);
    if (!this->ready()) {
        return false;
    }
    let symbol_total: usize = object.symbols.count;
    for (var index: usize = 0; index < symbol_total; index += 1) {
        let append_error: runtime::Error = this->symbol_map.push_back({index = 0});
        if (append_error != runtime::Error.none) {
            return this->fail(append_error);
        }
    }
    // 先 local 后 global，并在各自类别中保持模型顺序；GNU ld 要求 local block 位于
    // sh_info 之前。
    var symtab_index: usize = 1;
    for (var pass: usize = 0; pass < 2; pass += 1) {
        let global_pass: bool = pass != 0;
        for (var index: usize = 0; index < symbol_total; index += 1) {
            let result: object::SymbolResult = object::symbol_at(object, index);
            if (result.error != runtime::Error.none) {
                return this->fail(result.error);
            }
            let local: bool = result.symbol.defined && !result.symbol.global;
            if (local != global_pass) {
                if (!this->save_symbol_entry(object, plan, result.symbol, index, symtab_index)) {
                    return false;
                }
                symtab_index += 1;
            }
        }
    }
    return true;
}

    priv fn save_relocations(object: object::ObjectView) -> bool {
    let relocation_total: usize = object.relocations.count;
    for (var index: usize = 0; index < relocation_total; index += 1) {
        let result: object::RelocationResult = object::relocation_at(object, index);
        if (result.error != runtime::Error.none) {
            return this->fail(result.error);
        }
        let relocation: object::Relocation = result.relocation;
        var relocation_type: usize = 0;
        switch (relocation.kind) {
        case object::RelocationKind.absolute64 {
            relocation_type = RelocationType.absolute64 as usize;
        }
        case object::RelocationKind.pc32 {
            relocation_type = RelocationType.pc32 as usize;
        }
        case object::RelocationKind.plt32 {
            relocation_type = RelocationType.plt32 as usize;
        }
        case object::RelocationKind.absolute32 {
            relocation_type = RelocationType.absolute32 as usize;
        }
        case object::RelocationKind.signed32 {
            relocation_type = RelocationType.signed32 as usize;
        }
        default {
            return this->fail(runtime::Error.invalid_argument);
        }
        }
        var target: *bytes::Buffer = null;
        switch (relocation.section) {
        case object::Section.text {
            target = &this->rela_text;
        }
        case object::Section.rodata {
            target = &this->rela_rodata;
        }
        case object::Section.data {
            target = &this->rela_data;
        }
        default {
            return this->fail(runtime::Error.invalid_argument);
        }
        }
        let mapped_symbol: usize = this->symbol_map.get(relocation.symbol_index).index;
        let info: u64 = ((mapped_symbol as u64) << 32) | (relocation_type as u64);
        this->emit_u64(target, relocation.offset as u64);
        this->emit_u64(target, info);
        this->emit_u64(target, relocation.addend as u64);
        if (!this->ready()) {
            return false;
        }
    }
    return true;
}

    priv fn save_sections(object: object::ObjectView, plan: *SavePlan) -> bool {
    this->emit_u8(&this->shstrtab, 0);
    if (!this->ready()) {
        return false;
    }
    if (!this->save_add_section(0, SectionType.none, 0, 0, 0, 0, 0, 0, SectionSource.none)) {
        return false;
    }
    var name: usize = 0;
    if (plan->text_section != 0) {
        if (!this->save_section_name(".text", 5, &name) || !this->save_add_section(name, SectionType.progbits,
                (SectionFlag.alloc as usize) | (SectionFlag.execute as usize), object.text.length, 0, 0,
                object.text_alignment, 0, SectionSource.text)) {
            return false;
        }
    }
    if (plan->rodata_section != 0) {
        if (!this->save_section_name(".rodata", 7, &name) ||
            !this->save_add_section(name, SectionType.progbits, SectionFlag.alloc as usize,
                object.rodata.length, 0, 0, object.rodata_alignment, 0, SectionSource.rodata)) {
            return false;
        }
    }
    if (plan->data_section != 0) {
        if (!this->save_section_name(".data", 5, &name) || !this->save_add_section(name, SectionType.progbits,
                (SectionFlag.alloc as usize) | (SectionFlag.write as usize), object.data.length, 0, 0,
                object.data_alignment, 0, SectionSource.data)) {
            return false;
        }
    }
    if (plan->bss_section != 0) {
        if (!this->save_section_name(".bss", 4, &name) || !this->save_add_section(name, SectionType.nobits,
                (SectionFlag.alloc as usize) | (SectionFlag.write as usize), object.bss_size, 0, 0,
                object.bss_alignment, 0, SectionSource.none)) {
            return false;
        }
    }
    if (!this->save_section_name(".symtab", 7, &name) ||
        !this->save_add_section(name, SectionType.symtab, 0, this->symtab.length, plan->strtab_section,
            plan->first_global, 8, Limit.symbol_size as usize, SectionSource.symtab)) {
        return false;
    }
    if (!this->save_section_name(".strtab", 7, &name) ||
        !this->save_add_section(name, SectionType.strtab, 0, this->strtab.length, 0, 0, 1, 0, SectionSource.strtab)) {
        return false;
    }
    if (!this->save_section_name(".shstrtab", 9, &name) ||
        !this->save_add_section(name, SectionType.strtab, 0, 0, 0, 0, 1, 0, SectionSource.shstrtab)) {
        return false;
    }
    if (plan->rela_text_section != 0) {
        if (!this->save_section_name(".rela.text", 10, &name) ||
            !this->save_add_section(name, SectionType.rela, 0, this->rela_text.length,
                plan->symtab_section, plan->text_section, 8, Limit.relocation_size as usize, SectionSource.rela_text)) {
            return false;
        }
    }
    if (plan->rela_rodata_section != 0) {
        if (!this->save_section_name(".rela.rodata", 12, &name) ||
            !this->save_add_section(name, SectionType.rela, 0, this->rela_rodata.length,
                plan->symtab_section, plan->rodata_section, 8, Limit.relocation_size as usize,
                SectionSource.rela_rodata)) {
            return false;
        }
    }
    if (plan->rela_data_section != 0) {
        if (!this->save_section_name(".rela.data", 10, &name) ||
            !this->save_add_section(name, SectionType.rela, 0, this->rela_data.length,
                plan->symtab_section, plan->data_section, 8, Limit.relocation_size as usize, SectionSource.rela_data)) {
            return false;
        }
    }
    // 空且未分配的 .note.GNU-stack 会被 reader 丢弃，host linker 将其解释为不需要
    // executable stack。
    if (!this->save_section_name(".note.GNU-stack", 15, &name) ||
        !this->save_add_section(name, SectionType.progbits, 0, 0, 0, 0, 1, 0, SectionSource.none)) {
        return false;
    }
    let shstrtab_record: *OutputSection = this->save_section_at(plan->shstrtab_section);
    if (shstrtab_record == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    shstrtab_record->size = this->shstrtab.length;
    return true;
}

    priv fn save_layout(plan: *SavePlan) -> bool {
    var cursor: usize = Limit.header_size as usize;
    let count: usize = this->save_section_count();
    for (var index: usize = 1; index < count; index += 1) {
        let section: *OutputSection = this->save_section_at(index);
        if (section == null) {
            return this->fail(runtime::Error.invalid_argument);
        }
        var alignment: usize = section->alignment;
        if (alignment == 0) {
            alignment = 1;
        }
        var placed: usize = 0;
        if (!align(cursor, alignment, &placed)) {
            return this->fail(runtime::Error.out_of_memory);
        }
        section->offset = placed;
        section->alignment = alignment;
        if (section->kind != SectionType.nobits) {
            if (section->size > (18446744073709551615 as usize) - placed) {
                return this->fail(runtime::Error.out_of_memory);
            }
            cursor = placed + section->size;
        }
    }
    var section_offset: usize = 0;
    if (!align(cursor, 8, &section_offset)) {
        return this->fail(runtime::Error.out_of_memory);
    }
    plan->section_offset = section_offset;
    return true;
}

    priv fn save_source(object: object::ObjectView, source: SectionSource, content: *span::const_span<u8>) -> bool {
    if (content == null) {
        return false;
    }
    switch (source) {
    case SectionSource.text {
        *content = span::const_span<u8>(object.text.data, object.text.length);
    }
    case SectionSource.rodata {
        *content = span::const_span<u8>(object.rodata.data, object.rodata.length);
    }
    case SectionSource.data {
        *content = span::const_span<u8>(object.data.data, object.data.length);
    }
    case SectionSource.symtab {
        *content = span::const_span<u8>(this->symtab.data as *const u8, this->symtab.length);
    }
    case SectionSource.strtab {
        *content = span::const_span<u8>(this->strtab.data as *const u8, this->strtab.length);
    }
    case SectionSource.shstrtab {
        *content = span::const_span<u8>(this->shstrtab.data as *const u8, this->shstrtab.length);
    }
    case SectionSource.rela_text {
        *content = span::const_span<u8>(this->rela_text.data as *const u8, this->rela_text.length);
    }
    case SectionSource.rela_rodata {
        *content = span::const_span<u8>(this->rela_rodata.data as *const u8, this->rela_rodata.length);
    }
    case SectionSource.rela_data {
        *content = span::const_span<u8>(this->rela_data.data as *const u8, this->rela_data.length);
    }
    default {
        return false;
    }
    }
    return true;
}

    priv fn emit_header(plan: *SavePlan, output: *bytes::Buffer) -> bool {
        let identity: [8]u8 = { 127, 69, 76, 70, 2, 1, 1, 0 };
        for (var index: usize = 0; index < 8; index += 1) {
            this->emit_u8(output, identity[index]);
        }
        this->emit_padding(output, 16);
        this->emit_u16(output, 1);
        this->emit_u16(output, 62);
        this->emit_u32(output, 1);
        this->emit_u64(output, 0);
        this->emit_u64(output, 0);
        this->emit_u64(output, plan->section_offset as u64);
        this->emit_u32(output, 0);
        this->emit_u16(output, (Limit.header_size as usize) as u16);
        this->emit_u16(output, 0);
        this->emit_u16(output, 0);
        this->emit_u16(output, (Limit.section_size as usize) as u16);
        this->emit_u16(output, plan->section_count as u16);
        this->emit_u16(output, plan->shstrtab_section as u16);
        return this->ready();
    }

    priv fn emit_section_content(object: object::ObjectView, section: *OutputSection, output: *bytes::Buffer) -> bool {
        if (section->kind == SectionType.nobits) {
            return true;
        }
        this->emit_padding(output, section->offset);
        if (!this->ready() || section->size == 0) {
            return this->ready();
        }
        var content: span::const_span<u8> = span::const_span<u8>(null, 0);
        if (!this->save_source(object, section->source, &content)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (content.size() != section->size) {
            return this->fail(runtime::Error.invalid_argument);
        }
        this->emit_bytes(output, content.data(), content.size());
        return this->ready();
    }

    priv fn emit_section_header(section: *OutputSection, output: *bytes::Buffer) -> bool {
        this->emit_u32(output, section->name as u32);
        this->emit_u32(output, section->kind as usize as u32);
        this->emit_u64(output, section->flags as u64);
        this->emit_u64(output, 0);
        this->emit_u64(output, section->offset as u64);
        this->emit_u64(output, section->size as u64);
        this->emit_u32(output, section->link as u32);
        this->emit_u32(output, section->info as u32);
        this->emit_u64(output, section->alignment as u64);
        this->emit_u64(output, section->entry_size as u64);
        return this->ready();
    }

    priv fn save_emit(object: object::ObjectView, plan: *SavePlan, output: *bytes::Buffer) -> bool {
        if (!this->emit_header(plan, output)) {
            return false;
        }
        let count: usize = this->save_section_count();
        for (var index: usize = 1; index < count; index += 1) {
            let section: *OutputSection = this->save_section_at(index);
            if (section == null) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (!this->emit_section_content(object, section, output)) {
                return false;
            }
        }
        this->emit_padding(output, plan->section_offset);
        for (var index: usize = 0; index < count; index += 1) {
            let section: *OutputSection = this->save_section_at(index);
            if (section == null) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (!this->emit_section_header(section, output)) {
                return false;
            }
        }
        return this->ready();
    }

    fn run() {
        if (this->source == null || !this->source->is_valid()) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        let object: object::ObjectView = this->source->view();
        if (!this->save_plan(object, &this->plan)) {
            return;
        }
        if (!this->save_symbols(object, &this->plan)) {
            return;
        }
        if (!this->save_relocations(object)) {
            return;
        }
        if (!this->save_sections(object, &this->plan)) {
            return;
        }
        if (!this->save_layout(&this->plan)) {
            return;
        }
        var table_size: usize = 0;
        if (@mul_overflow(this->plan.section_count, Limit.section_size as usize, &table_size)) {
            this->fail(runtime::Error.out_of_memory);
            return;
        }
        var total_size: usize = 0;
        if (@add_overflow(this->plan.section_offset, table_size, &total_size)) {
            this->fail(runtime::Error.out_of_memory);
            return;
        }
        let reserved: bytes::BufferResult = bytes::with_capacity(total_size);
        if (reserved.error != runtime::Error.none) {
            this->fail(reserved.error);
            return;
        }
        this->output = reserved.buffer;
        this->save_emit(object, &this->plan, &this->output);
    }

    fn take_result() -> bytes::BufferResult {
        let scratch_error: runtime::Error = this->release_scratch();
        if (this->error_code == runtime::Error.none) {
            this->error_code = scratch_error;
        }
        if (this->error_code != runtime::Error.none) {
            this->release_buffer(&this->output);
            return { buffer = bytes::empty(), error = this->error_code };
        }
        let saved: bytes::Buffer = this->output;
        this->output = bytes::empty();
        return { buffer = saved, error = runtime::Error.none };
    }

    deinit() {
        this->release_scratch();
        this->release_buffer(&this->output);
    }

}
