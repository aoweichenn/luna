module luna.compiler.x86.elf;


fn load(bytes: *const u8, length: usize) -> object::Result {
    var reader: ElfReader = ElfReader(bytes, length);
    reader.run();
    return reader.take_result();
}

fn save(object: object::Object const&) -> bytes::BufferResult {
    var writer: ElfWriter = ElfWriter(&object as *const object::Object);
    writer.run();
    return writer.take_result();
}
