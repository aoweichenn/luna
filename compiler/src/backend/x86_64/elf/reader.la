module luna.compiler.x86.elf;


// 读取外部编译器产生的 ELF64 ET_REL，并转换成 Luna assembler 使用的同一内存对象模型，
// 让 linker 只消费一种表示。支持范围刻意限定为 little-endian x86-64 ET_REL、已分配的
// PROGBITS/NOBITS section、一个 SHT_SYMTAB 和显式 addend 的 SHT_RELA relocation。
// TLS、COMDAT、可写且可执行的 section、隐式 addend 的 REL 和未知 relocation 均被拒绝；
// 未分配的 note/comment/debug metadata 会被丢弃。使用任何字段前都验证 header、范围、
// 字符串、符号引用和 relocation 引用。

impl ElfReader {
    init(input: *const u8, input_size: usize): sections = vector::vector<InputSection>(),
            symbol_map = vector::vector<SymbolMapping>() {
        this->input = input;
        this->input_size = input_size;
        this->symtab_index = 0;
        this->has_symtab = false;
        this->storage = object::empty();
        this->error_code = runtime::Error.none;
    }

    priv fn fail(error: runtime::Error) -> bool {
        if (this->error_code == runtime::Error.none) {
            this->error_code = error;
        }
        return false;
    }

    priv fn power_of_two(value: usize) -> bool {
    return checked::is_power_of_two(value);
}

    priv fn range_valid(offset: usize, size: usize, length: usize) -> bool {
    return checked::range_is_valid(offset, size, length);
}

    priv fn section_count() const -> usize {
        return this->sections.size();
    }

    priv fn section_at(index: usize) -> *InputSection {
        if (index >= this->section_count()) {
            return null;
        }
        return &this->sections.get(index);
    }

    priv fn section_copy(index: usize) const -> InputSection {
        if (index >= this->section_count()) {
            return {
                region = object::Section.undefined, region_offset = 0, symbol = Limit.no_symbol as usize,
                kind = SectionType.none, flags = 0, offset = 0, size = 0, link = 0, info = 0,
                alignment = 0, entry_size = 0,
            };
        }
        return this->sections.get(index);
    }

    priv fn region_buffer(object: *object::Object, section: object::Section) -> *bytes::Buffer {
    if (object == null) {
        return null;
    }
    switch (section) {
    case object::Section.text {
        return &object->text;
    }
    case object::Section.rodata {
        return &object->rodata;
    }
    case object::Section.data {
        return &object->data;
    }
    default {
        return null;
    }
    }
}

    priv fn append_bytes(buffer: *bytes::Buffer, bytes: *const u8, offset: usize, size: usize) -> bool {
    if (buffer == null) {
        return false;
    }
    if (size != 0 && bytes == null) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(*buffer, size == 0 ? null as *const u8 : &bytes[offset], size);
    *buffer = appended.buffer;
    return appended.error == runtime::Error.none;
}

    priv fn classify_progbits(section: *InputSection, allocated: bool) -> bool {
        if (!allocated) {
            return true;
        }
        let payload_is_valid: bool = section->size <= Limit.maximum_payload as usize &&
            this->range_valid(section->offset, section->size, this->input_size);
        if (!payload_is_valid) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let placement: usize = section->flags & ((SectionFlag.execute as usize) | (SectionFlag.write as usize));
        let section_placement: SectionPlacement = this->decode_section_placement(placement);
        switch (section_placement) {
        case SectionPlacement.executable {
            section->region = object::Section.text;
        }
        case SectionPlacement.writable {
            section->region = object::Section.data;
        }
        default {
            section->region = object::Section.rodata;
        }
        }
        return true;
    }

    priv fn classify_nobits(section: *InputSection, allocated: bool) -> bool {
        if (!allocated) {
            return true;
        }
        let writable: bool = (section->flags & (SectionFlag.write as usize)) != 0;
        if (!writable || section->size > Limit.maximum_payload as usize) {
            return this->fail(runtime::Error.invalid_argument);
        }
        section->region = object::Section.bss;
        return true;
    }

    priv fn classify_symtab(index: usize, section: *InputSection, section_count: usize, allocated: bool) -> bool {
        if (allocated || this->has_symtab) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record_shape_is_valid: bool = section->entry_size == Limit.symbol_size as usize &&
            section->size % (Limit.symbol_size as usize) == 0;
        let record_count: usize = section->size / (Limit.symbol_size as usize);
        if (!record_shape_is_valid || record_count > Limit.maximum_records as usize) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let payload_is_valid: bool = this->range_valid(section->offset, section->size, this->input_size);
        if (!payload_is_valid || section->link >= section_count) {
            return this->fail(runtime::Error.invalid_argument);
        }
        this->symtab_index = index;
        this->has_symtab = true;
        return true;
    }

    priv fn classify_strtab(section: *InputSection, allocated: bool) -> bool {
        let payload_is_valid: bool = this->range_valid(section->offset, section->size, this->input_size);
        if (allocated || !payload_is_valid) {
            return this->fail(runtime::Error.invalid_argument);
        }
        return true;
    }

    priv fn classify_rela(section: *InputSection, section_count: usize, allocated: bool) -> bool {
        if (allocated || section->entry_size != Limit.relocation_size as usize) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let record_shape_is_valid: bool = section->size % (Limit.relocation_size as usize) == 0;
        let record_count: usize = section->size / (Limit.relocation_size as usize);
        if (!record_shape_is_valid || record_count > Limit.maximum_records as usize) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let payload_is_valid: bool = this->range_valid(section->offset, section->size, this->input_size);
        if (!payload_is_valid || section->link >= section_count) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (section->info >= section_count) {
            return this->fail(runtime::Error.invalid_argument);
        }
        return true;
    }

    priv fn classify_section(index: usize, section: *InputSection, section_count: usize) -> bool {
        if (section->alignment == 0) {
            section->alignment = 1;
        }
        let alignment_is_valid: bool = this->power_of_two(section->alignment) &&
            section->alignment <= Limit.maximum_alignment as usize;
        if (!alignment_is_valid) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let unsupported_flags: usize = (SectionFlag.group as usize) | (SectionFlag.tls as usize);
        if ((section->flags & unsupported_flags) != 0) {
            return this->fail(runtime::Error.not_supported);
        }
        let writable: bool = (section->flags & (SectionFlag.write as usize)) != 0;
        let executable: bool = (section->flags & (SectionFlag.execute as usize)) != 0;
        if (writable && executable) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let allocated: bool = (section->flags & (SectionFlag.alloc as usize)) != 0;
        switch (section->kind) {
        case SectionType.none, SectionType.note {
            // loader metadata（包括已分配的 .note.gnu.property）不会被静态链接消费。
            return true;
        }
        case SectionType.progbits {
            return this->classify_progbits(section, allocated);
        }
        case SectionType.nobits {
            return this->classify_nobits(section, allocated);
        }
        case SectionType.symtab {
            return this->classify_symtab(index, section, section_count, allocated);
        }
        case SectionType.strtab {
            return this->classify_strtab(section, allocated);
        }
        case SectionType.rela {
            return this->classify_rela(section, section_count, allocated);
        }
        case SectionType.rel {
            return this->fail(runtime::Error.not_supported);
        }
        default {
            return allocated ? this->fail(runtime::Error.not_supported) : true;
        }
        }
    }

    priv fn classify_sections() -> bool {
        let count: usize = this->section_count();
        for (var index: usize = 0; index < count; index += 1) {
            let section: *InputSection = this->section_at(index);
            if (section == null) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (index == 0 && section->kind != SectionType.none) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (!this->classify_section(index, section, count)) {
                return false;
            }
        }
        return true;
    }

    priv fn layout_sections() -> bool {
        let count: usize = this->section_count();
        for (var index: usize = 0; index < count; index += 1) {
            let section: *InputSection = this->section_at(index);
            if (section == null) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (section->region == object::Section.undefined) {
                continue;
            }
            if (!object::set_alignment(&this->storage, section->region, section->alignment)) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (!this->place_section(section)) {
                return false;
            }
        }
        return true;
    }

    priv fn place_section(section: *InputSection) -> bool {
        if (section->region == object::Section.bss) {
            var placed: usize = 0;
            if (!align(this->storage.bss_size, section->alignment, &placed)) {
                return this->fail(runtime::Error.out_of_memory);
            }
            if (section->size > (Limit.maximum_payload as usize) - placed) {
                return this->fail(runtime::Error.out_of_memory);
            }
            section->region_offset = placed;
            this->storage.bss_size = placed + section->size;
            return true;
        }
        let buffer: *bytes::Buffer = this->region_buffer(&this->storage, section->region);
        if (buffer == null) {
            return this->fail(runtime::Error.invalid_argument);
        }
        var placed: usize = 0;
        if (!align(buffer->length, section->alignment, &placed)) {
            return this->fail(runtime::Error.out_of_memory);
        }
        if (section->size > (Limit.maximum_payload as usize) - placed) {
            return this->fail(runtime::Error.out_of_memory);
        }
        if (!pad_to(buffer, placed)) {
            return this->fail(runtime::Error.out_of_memory);
        }
        if (!this->append_bytes(buffer, this->input, section->offset, section->size)) {
            return this->fail(runtime::Error.out_of_memory);
        }
        section->region_offset = placed;
        return true;
    }

    priv fn symbol_name(strtab: InputSection, name_offset: usize, name: *string_views::string_view) -> bool {
    if (name == null || name_offset == 0) {
        return false;
    }
    if (name_offset >= strtab.size) {
        return false;
    }
    var length: usize = 0;
    for (; name_offset + length < strtab.size; length += 1) {
        if (this->input[strtab.offset + name_offset + length] == 0) {
            break;
        }
    }
    if (name_offset + length >= strtab.size || length > Limit.maximum_name as usize) {
        return false;
    }
    let view: string_views::string_view_result = string_views::from_bytes(&this->input[strtab.offset + name_offset],
        length);
    if (view.error != runtime::Error.none) {
        return false;
    }
    *name = view.view;
    return true;
}

    priv fn synthetic_name(tag: *const u8, tag_length: usize, index: usize, output: *u8) -> usize {
    // 合成名字嵌入零字节，而 strtab 名字按定义不含零字节，因此不会与输入符号重名。
    var length: usize = 0;
    output[length] = 0;
    length += 1;
    for (var position: usize = 0; position < tag_length; position += 1) {
        output[length] = tag[position];
        length += 1;
    }
    output[length] = 0;
    length += 1;
    var digits: [5]u8 = {};
    var digit_count: usize = 0;
    var value: usize = index;
    if (value == 0) {
        digits[0] = 48;
        digit_count = 1;
    }
    for (; value != 0; value /= 10) {
        digits[digit_count] = 48 + (value % 10) as u8;
        digit_count += 1;
    }
    for (; digit_count != 0; digit_count -= 1) {
        output[length] = digits[digit_count - 1];
        length += 1;
    }
    return length;
}

    priv fn synthetic_view(
        tag: *const u8, tag_length: usize, index: usize, storage: *u8, name: *string_views::string_view) -> bool {
    if (name == null || storage == null) {
        return false;
    }
    let length: usize = this->synthetic_name(tag, tag_length, index, storage);
    let view: string_views::string_view_result = string_views::from_bytes(storage as *const u8, length);
    if (view.error != runtime::Error.none) {
        return false;
    }
    *name = view.view;
    return true;
}

    priv fn load_section_symbol(st_shndx: usize, st_value: u64, st_size: u64, mapped: *usize) -> bool {
    if (st_shndx == 0 || st_shndx >= this->section_count()) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (st_value != 0 || st_size != 0) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let target: *InputSection = this->section_at(st_shndx);
    if (target == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (target->region == object::Section.undefined) {
        return true;
    }
    if (target->symbol == (Limit.no_symbol as usize)) {
        var name_storage: [24]u8 = {};
        var name: string_views::string_view = {
            data = null, length = 0,
        };
        if (!this->synthetic_view("section", 7, st_shndx, &name_storage[0], &name)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let added: object::IndexResult = object::add_symbol(&this->storage, name);
        if (added.error != runtime::Error.none) {
            return this->fail(added.error);
        }
        if (added.found) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let symbol: *object::Symbol = object::symbol_mut(&this->storage, added.index);
        if (symbol == null) {
            return this->fail(runtime::Error.invalid_argument);
        }
        symbol->defined = true;
        symbol->section = target->region;
        symbol->value = target->region_offset;
        target->symbol = added.index;
    }
    *mapped = target->symbol;
    return true;
}

    priv fn load_undefined_symbol(
    strtab: InputSection, st_name: usize, local: bool, st_value: u64, st_size: u64, mapped: *usize) -> bool {
    if (st_value != 0 || st_size != 0) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (local) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (st_name == 0) {
        return true;
    }
    var name: string_views::string_view = {
        data = null, length = 0,
    };
    if (!this->symbol_name(strtab, st_name, &name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let added: object::IndexResult = object::add_symbol(&this->storage, name);
    if (added.error != runtime::Error.none) {
        return this->fail(added.error);
    }
    let symbol: *object::Symbol = object::symbol_mut(&this->storage, added.index);
    if (symbol == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (!symbol->defined) {
        symbol->global = true;
        symbol->external = true;
    }
    *mapped = added.index;
    return true;
}

    priv fn load_common_symbol(
    strtab: InputSection, st_name: usize, local: bool, st_value: u64, st_size: u64, mapped: *usize) -> bool {
    // COMMON storage 在 bss 中分配：st_value 携带对齐，st_size 携带字节数，因此未使用
    // -fno-common 编译的对象仍可链接。
    if (local || st_name == 0) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let alignment_fits: bool = st_value <= (Limit.maximum_alignment as usize) as u64;
    let payload_fits: bool = st_size <= (Limit.maximum_payload as usize) as u64;
    if (!alignment_fits || !payload_fits) {
        return this->fail(runtime::Error.invalid_argument);
    }
    var alignment: usize = st_value as usize;
    if (alignment == 0) {
        alignment = 1;
    }
    if (!this->power_of_two(alignment)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    var placed: usize = 0;
    if (!align(this->storage.bss_size, alignment, &placed) || (st_size as usize) >
            (Limit.maximum_payload as usize) - placed) {
        return this->fail(runtime::Error.out_of_memory);
    }
    var name: string_views::string_view = {
        data = null, length = 0,
    };
    if (!this->symbol_name(strtab, st_name, &name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let added: object::IndexResult = object::add_symbol(&this->storage, name);
    if (added.error != runtime::Error.none) {
        return this->fail(added.error);
    }
    let symbol: *object::Symbol = object::symbol_mut(&this->storage, added.index);
    if (symbol == null || symbol->defined) {
        return this->fail(runtime::Error.invalid_argument);
    }
    symbol->defined = true;
    symbol->global = true;
    symbol->external = false;
    symbol->section = object::Section.bss;
    symbol->value = placed;
    symbol->size = st_size as usize;
    symbol->kind = object::SymbolKind.object;
    this->storage.bss_size = placed + (st_size as usize);
    if (!object::set_alignment(&this->storage, object::Section.bss, alignment)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    *mapped = added.index;
    return true;
}

    priv fn load_defined_symbol(
        strtab: InputSection, index: usize, st_name: usize, local: bool,
        st_shndx: usize, st_value: u64, st_size: u64, symbol_type: SymbolType, mapped: *usize) -> bool {
    let target: InputSection = this->section_copy(st_shndx);
    if (target.region == object::Section.undefined || st_value > (target.size as u64)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (st_size > (target.size as u64) - st_value) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (!local && st_name == 0) {
        return this->fail(runtime::Error.invalid_argument);
    }
    var name: string_views::string_view = {
        data = null, length = 0,
    };
    var name_storage: [24]u8 = {};
    if (st_name == 0) {
        if (!this->synthetic_view("symbol", 6, index, &name_storage[0], &name)) {
            return this->fail(runtime::Error.invalid_argument);
        }
    } else if (!this->symbol_name(strtab, st_name, &name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    var added: object::IndexResult = object::add_symbol(&this->storage, name);
    if (added.error != runtime::Error.none) {
        return this->fail(added.error);
    }
    if (local && added.found) {
        // 与其他 entry 同名的 local symbol（例如与未定义 global reference 同名）仍是独立
        // 符号，必须改用唯一合成名字。
        if (!this->synthetic_view("local", 5, index, &name_storage[0], &name)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        added = object::add_symbol(&this->storage, name);
        if (added.error != runtime::Error.none) {
            return this->fail(added.error);
        }
        if (added.found) {
            return this->fail(runtime::Error.invalid_argument);
        }
    }
    let symbol: *object::Symbol = object::symbol_mut(&this->storage, added.index);
    if (symbol == null || symbol->defined) {
        return this->fail(runtime::Error.invalid_argument);
    }
    symbol->defined = true;
    symbol->external = false;
    if (!local) {
        symbol->global = true;
    }
    symbol->section = target.region;
    symbol->value = target.region_offset + (st_value as usize);
    symbol->size = st_size as usize;
    switch (symbol_type) {
    case SymbolType.function {
        symbol->kind = object::SymbolKind.function;
    }
    case SymbolType.object, SymbolType.common {
        symbol->kind = object::SymbolKind.object;
    }
    default {
        symbol->kind = object::SymbolKind.none;
    }
    }
    *mapped = added.index;
    return true;
}

    priv fn load_symbol(
    strtab: InputSection, index: usize, st_name: usize, st_info: usize,
    st_other: usize, st_shndx: usize, st_value: u64, st_size: u64, mapped: *usize) -> bool {
    if (mapped == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (st_other != 0 || st_info >> 4 > (SymbolBind.weak as usize)) {
        return this->fail(runtime::Error.not_supported);
    }
    let local: bool = st_info >> 4 == (SymbolBind.local as usize);
    let symbol_type: SymbolType = this->decode_symbol_type(st_info & 15);
    if (index == 0) {
        let identity_is_zero: bool = st_name == 0 && st_info == 0;
        let location_is_zero: bool = st_shndx == 0 && st_value == 0;
        if (!identity_is_zero || !location_is_zero) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (st_size != 0) {
            return this->fail(runtime::Error.invalid_argument);
        }
        return true;
    }
    switch (symbol_type) {
    case SymbolType.file {
        return true;
    }
    case SymbolType.section {
        return this->load_section_symbol(st_shndx, st_value, st_size, mapped);
    }
    case SymbolType.notype, SymbolType.object, SymbolType.function, SymbolType.common {}
    default {
        return this->fail(runtime::Error.not_supported);
    }
    }
    switch (this->decode_symbol_section(st_shndx)) {
    case SymbolSectionKind.undefined {
        return this->load_undefined_symbol(strtab, st_name, local, st_value, st_size, mapped);
    }
    case SymbolSectionKind.common {
        return this->load_common_symbol(strtab, st_name, local, st_value, st_size, mapped);
    }
    case SymbolSectionKind.reserved {
        return this->fail(runtime::Error.not_supported);
    }
    default {}
    }
    return this->load_defined_symbol(strtab, index, st_name, local, st_shndx, st_value, st_size, symbol_type, mapped);
}

    priv fn map_symbol(mapped: usize) -> bool {
    let append_error: runtime::Error = this->symbol_map.push_back({index = mapped});
    if (append_error != runtime::Error.none) {
        return this->fail(append_error);
    }
    return true;
}

    priv fn load_symbols() -> bool {
    if (!this->has_symtab) {
        return true;
    }
    let symtab: InputSection = this->section_copy(this->symtab_index);
    let strtab: InputSection = this->section_copy(symtab.link);
    if (strtab.kind != SectionType.strtab) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let count: usize = symtab.size / (Limit.symbol_size as usize);
    for (var index: usize = 0; index < count; index += 1) {
        let base: usize = symtab.offset + index * (Limit.symbol_size as usize);
        var st_name: u32 = 0;
        var st_shndx: u16 = 0;
        var st_value: u64 = 0;
        var st_size: u64 = 0;
        if (!this->read_u32(base, &st_name) || !this->read_u16(base + 6, &st_shndx)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (!this->read_u64(base + 8, &st_value) || !this->read_u64(base + 16, &st_size)) {
            return this->fail(runtime::Error.invalid_argument);
        }
        var mapped: usize = Limit.no_symbol as usize;
        if (!this->load_symbol(strtab, index, st_name as usize, this->input[base + 4] as usize,
                this->input[base + 5] as usize, st_shndx as usize, st_value, st_size, &mapped)) {
            return false;
        }
        if (!this->map_symbol(mapped)) {
            return false;
        }
    }
    return true;
}

    priv fn load_relocations() -> bool {
    let section_count: usize = this->section_count();
    let symbol_count: usize = this->symbol_map.size();
    for (var index: usize = 0; index < section_count; index += 1) {
        let section: InputSection = this->section_copy(index);
        if (section.kind != SectionType.rela) {
            continue;
        }
        if (!this->has_symtab || section.link != this->symtab_index) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (section.info >= section_count) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let target: InputSection = this->section_copy(section.info);
        if (target.region == object::Section.undefined) {
            continue;
        }
        if (target.region == object::Section.bss) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let count: usize = section.size / (Limit.relocation_size as usize);
        for (var relocation_index: usize = 0; relocation_index < count; relocation_index += 1) {
            let base: usize = section.offset + relocation_index * (Limit.relocation_size as usize);
            var offset: u64 = 0;
            var info: u64 = 0;
            var addend: u64 = 0;
            if (!this->read_u64(base, &offset) || !this->read_u64(base + 8, &info)) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (!this->read_u64(base + 16, &addend)) {
                return this->fail(runtime::Error.invalid_argument);
            }
            let symbol_index: usize = (info >> 32) as usize;
            let relocation_type: RelocationType = this->decode_relocation_type((info & (4294967295 as u64)) as usize);
            var kind: object::RelocationKind = object::RelocationKind.pc32;
            var width: usize = 4;
            switch (relocation_type) {
            case RelocationType.absolute64 {
                kind = object::RelocationKind.absolute64;
                width = 8;
            }
            case RelocationType.pc32 {
                kind = object::RelocationKind.pc32;
            }
            case RelocationType.plt32 {
                kind = object::RelocationKind.plt32;
            }
            case RelocationType.absolute32 {
                kind = object::RelocationKind.absolute32;
            }
            case RelocationType.signed32 {
                kind = object::RelocationKind.signed32;
            }
            default {
                return this->fail(runtime::Error.not_supported);
            }
            }
            if (symbol_index >= symbol_count || offset > (target.size as u64)) {
                return this->fail(runtime::Error.invalid_argument);
            }
            let mapped_symbol: usize = this->symbol_map.get(symbol_index).index;
            let relocation_fits: bool = (width as u64) <= (target.size as u64) - offset;
            if (mapped_symbol == (Limit.no_symbol as usize) || !relocation_fits) {
                return this->fail(runtime::Error.invalid_argument);
            }
            let relocation: object::Relocation = {
                section = target.region, offset = target.region_offset + (offset as usize),
                symbol_index = mapped_symbol, kind = kind, addend = addend as isize,
            };
            if (!object::add_relocation(&this->storage, relocation)) {
                return this->fail(this->storage.error == runtime::Error.none ? runtime::Error.invalid_argument :
                        this->storage.error);
            }
        }
    }
    return true;
}

    fn run() {
        if (this->input == null || this->input_size < Limit.header_size as usize) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        if (!this->parse_header()) {
            return;
        }
        if (!this->classify_sections()) {
            return;
        }
        if (!this->layout_sections()) {
            return;
        }
        if (!this->load_symbols()) {
            return;
        }
        if (!this->load_relocations()) {
            return;
        }
        if (!object::is_valid(this->storage)) {
            this->fail(runtime::Error.invalid_argument);
        }
    }

    fn take_result() -> object::Result {
        if (this->error_code != runtime::Error.none) {
            object::release(this->storage);
            this->storage = object::empty();
            return { object = object::empty(), error = this->error_code };
        }
        let loaded: object::Object = this->storage;
        this->storage = object::empty();
        return { object = loaded, error = runtime::Error.none };
    }

    deinit() {
        object::release(this->storage);
        this->storage = object::empty();
    }

}
