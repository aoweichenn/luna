module luna.compiler.x86.object;

fn section_is_valid(section: Section) -> bool {
    switch (section) {
    case Section.text, Section.rodata, Section.data, Section.bss {
        return true;
    }
    default {
        return false;
    }
    }
}

fn relocation_section_is_valid(section: Section) -> bool {
    switch (section) {
    case Section.text, Section.rodata, Section.data {
        return true;
    }
    default {
        return false;
    }
    }
}

fn alignment_is_valid(alignment: usize) -> bool {
    return checked::is_power_of_two(alignment) && alignment <= Format.maximum_alignment as usize;
}

fn invalid_symbol() -> Symbol {
    return {
        name_offset = 0, name_length = 0, section = Section.undefined, value = 0, size = 0,
        kind = SymbolKind.none, defined = false, global = false, external = false,
    };
}

fn invalid_relocation() -> Relocation {
    return {
        section = Section.undefined, offset = 0, symbol_index = 0, kind = RelocationKind.pc32, addend = 0,
    };
}

fn symbol_kind_is_valid(kind: SymbolKind) -> bool {
    switch (kind) {
    case SymbolKind.none, SymbolKind.function, SymbolKind.object {
        return true;
    }
    default {
        return false;
    }
    }
}

fn relocation_width(kind: RelocationKind) -> usize {
    switch (kind) {
    case RelocationKind.absolute64 {
        return 8;
    }
    case RelocationKind.pc32, RelocationKind.plt32, RelocationKind.absolute32, RelocationKind.signed32 {
        return 4;
    }
    default {
        return 0;
    }
    }
}

fn section(view: ObjectView, section_kind: Section) -> ByteView {
    switch (section_kind) {
    case Section.text {
        return view.text;
    }
    case Section.rodata {
        return view.rodata;
    }
    case Section.data {
        return view.data;
    }
    default {
        return {data = null, length = 0};
    }
    }
}

fn section_size(view: ObjectView, section_kind: Section) -> usize {
    return section_kind == Section.bss ? view.bss_size : section(view, section_kind).length;
}

fn alignment(view: ObjectView, section_kind: Section) -> usize {
    switch (section_kind) {
    case Section.text {
        return view.text_alignment;
    }
    case Section.rodata {
        return view.rodata_alignment;
    }
    case Section.data {
        return view.data_alignment;
    }
    case Section.bss {
        return view.bss_alignment;
    }
    default {
        return 0;
    }
    }
}

fn symbol_at(view: ObjectView, index: usize) -> SymbolResult {
    if (index >= view.symbols.count) {
        return {symbol = invalid_symbol(), error = runtime::Error.invalid_argument};
    }
    return {symbol = view.symbols.data[index], error = runtime::Error.none};
}

fn relocation_at(view: ObjectView, index: usize) -> RelocationResult {
    if (index >= view.relocations.count) {
        return {relocation = invalid_relocation(), error = runtime::Error.invalid_argument};
    }
    return {relocation = view.relocations.data[index], error = runtime::Error.none};
}

fn symbol_name(view: ObjectView, symbol: Symbol) -> string_views::string_view_result {
    let offset_is_valid: bool = symbol.name_offset <= view.names.length;
    let length_is_valid: bool = offset_is_valid && symbol.name_length <= view.names.length - symbol.name_offset;
    if (!length_is_valid) {
        return {view = {data = null, length = 0}, error = runtime::Error.invalid_argument};
    }
    let data: *const u8 = symbol.name_length == 0 ? null : &view.names.data[symbol.name_offset];
    return string_views::from_bytes(data, symbol.name_length);
}

fn symbol_is_valid(view: ObjectView, symbol: Symbol) -> bool {
    let name_length_is_valid: bool = symbol.name_length != 0 && symbol.name_length <= Format.maximum_name as usize;
    if (!name_length_is_valid || !symbol_kind_is_valid(symbol.kind)) {
        return false;
    }
    if (symbol_name(view, symbol).error != runtime::Error.none) {
        return false;
    }
    if (symbol.defined) {
        if (!section_is_valid(symbol.section) || symbol.external) {
            return false;
        }
        let size: usize = section_size(view, symbol.section);
        let value_is_valid: bool = symbol.value <= size;
        return value_is_valid && symbol.size <= size - symbol.value;
    }
    let location_is_empty: bool = symbol.section == Section.undefined && symbol.value == 0;
    let shape_is_empty: bool = location_is_empty && symbol.size == 0;
    let linkage_is_valid: bool = symbol.global || symbol.external;
    return shape_is_empty && linkage_is_valid;
}

fn relocation_is_valid(view: ObjectView, relocation: Relocation) -> bool {
    if (!relocation_section_is_valid(relocation.section)) {
        return false;
    }
    if (relocation.symbol_index >= view.symbols.count) {
        return false;
    }
    let width: usize = relocation_width(relocation.kind);
    if (width == 0) {
        return false;
    }
    let size: usize = section_size(view, relocation.section);
    let offset_is_valid: bool = relocation.offset <= size;
    return offset_is_valid && width <= size - relocation.offset;
}

fn view_is_valid(view: ObjectView) -> bool {
    let text_is_valid: bool = view.text.length == 0 || view.text.data != null;
    let rodata_is_valid: bool = view.rodata.length == 0 || view.rodata.data != null;
    let data_is_valid: bool = view.data.length == 0 || view.data.data != null;
    let names_are_valid: bool = view.names.length == 0 || view.names.data != null;
    let symbols_are_valid: bool = view.symbols.count == 0 || view.symbols.data != null;
    let relocations_are_valid: bool = view.relocations.count == 0 || view.relocations.data != null;
    let readonly_views_are_valid: bool = text_is_valid && rodata_is_valid;
    let writable_views_are_valid: bool = data_is_valid && names_are_valid;
    let record_views_are_valid: bool = symbols_are_valid && relocations_are_valid;
    if (!readonly_views_are_valid || !writable_views_are_valid) {
        return false;
    }
    if (!record_views_are_valid) {
        return false;
    }
    let readonly_payloads_fit: bool = view.text.length <= Format.maximum_payload as usize &&
        view.rodata.length <= Format.maximum_payload as usize;
    let writable_payloads_fit: bool = view.data.length <= Format.maximum_payload as usize &&
        view.bss_size <= Format.maximum_payload as usize;
    let metadata_fits: bool = view.names.length <= Format.maximum_payload as usize &&
        view.symbols.count <= Format.maximum_records as usize;
    let records_fit: bool = metadata_fits && view.relocations.count <= Format.maximum_records as usize;
    if (!readonly_payloads_fit || !writable_payloads_fit) {
        return false;
    }
    if (!records_fit) {
        return false;
    }
    let readonly_alignment_is_valid: bool = alignment_is_valid(view.text_alignment) &&
        alignment_is_valid(view.rodata_alignment);
    let writable_alignment_is_valid: bool = alignment_is_valid(view.data_alignment) &&
        alignment_is_valid(view.bss_alignment);
    if (!readonly_alignment_is_valid || !writable_alignment_is_valid) {
        return false;
    }
    for (var index: usize = 0; index < view.symbols.count; index += 1) {
        if (!symbol_is_valid(view, view.symbols.data[index])) {
            return false;
        }
    }
    for (var index: usize = 0; index < view.relocations.count; index += 1) {
        if (!relocation_is_valid(view, view.relocations.data[index])) {
            return false;
        }
    }
    return true;
}

impl Object {
    init(): text = buffer::byte_buffer(), rodata = buffer::byte_buffer(), data = buffer::byte_buffer(),
            names = buffer::byte_buffer(), symbols = vector::vector<Symbol>(),
            relocations = vector::vector<Relocation>() {
        this->reset_metadata();
    }

    init(other: Object&&): text = other.text as buffer::byte_buffer&&, rodata = other.rodata as buffer::byte_buffer&&,
            data = other.data as buffer::byte_buffer&&, names = other.names as buffer::byte_buffer&&,
            symbols = other.symbols as vector::vector<Symbol>&&,
            relocations = other.relocations as vector::vector<Relocation>&& {
        this->take_metadata(other);
    }

    fn view() const -> ObjectView {
        return {
            text = {data = this->text.data(), length = this->text.size()},
            rodata = {data = this->rodata.data(), length = this->rodata.size()},
            data = {data = this->data.data(), length = this->data.size()},
            names = {data = this->names.data(), length = this->names.size()},
            symbols = {data = this->symbols.as_span().data(), count = this->symbols.size()},
            relocations = {data = this->relocations.as_span().data(), count = this->relocations.size()},
            bss_size = this->bss_size_bytes, text_alignment = this->text_alignment_bytes,
            rodata_alignment = this->rodata_alignment_bytes, data_alignment = this->data_alignment_bytes,
            bss_alignment = this->bss_alignment_bytes,
        };
    }

    fn is_valid() const -> bool {
        let readonly_storage_is_valid: bool = this->text.is_valid() && this->rodata.is_valid();
        let writable_storage_is_valid: bool = this->data.is_valid() && this->names.is_valid();
        let record_storage_is_valid: bool = this->symbols.is_valid() && this->relocations.is_valid();
        let byte_storage_is_valid: bool = readonly_storage_is_valid && writable_storage_is_valid;
        let all_storage_is_valid: bool = byte_storage_is_valid && record_storage_is_valid;
        return all_storage_is_valid && view_is_valid(this->view());
    }

    deinit() {
    }

    priv fn reset_metadata() {
        this->bss_size_bytes = 0;
        this->text_alignment_bytes = 1;
        this->rodata_alignment_bytes = 1;
        this->data_alignment_bytes = 1;
        this->bss_alignment_bytes = 1;
    }

    priv fn take_metadata(other: Object&&) {
        this->bss_size_bytes = other.bss_size_bytes;
        this->text_alignment_bytes = other.text_alignment_bytes;
        this->rodata_alignment_bytes = other.rodata_alignment_bytes;
        this->data_alignment_bytes = other.data_alignment_bytes;
        this->bss_alignment_bytes = other.bss_alignment_bytes;
        other.bss_size_bytes = 0;
        other.text_alignment_bytes = 1;
        other.rodata_alignment_bytes = 1;
        other.data_alignment_bytes = 1;
        other.bss_alignment_bytes = 1;
    }
}
