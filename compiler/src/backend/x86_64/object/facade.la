module luna.compiler.x86.object;

fn serialize(object: Object const&) -> bytes::BufferResult {
    var writer: ObjectWriter = ObjectWriter(object);
    writer.run();
    return writer.take_result();
}

fn deserialize(bytes: *const u8, length: usize) -> Result {
    var builder: ObjectBuilder = ObjectBuilder();
    var reader: ObjectReader = ObjectReader(bytes, length, builder);
    reader.run();
    if (reader.error() != runtime::Error.none) {
        return {object = Object(), error = reader.error()};
    }
    return {object = builder.take_object(), error = runtime::Error.none};
}
