module luna.bootstrap.backend.x86_64.elf;

import luna.bootstrap.backend.x86_64.elf.reader as reader;
import luna.bootstrap.backend.x86_64.elf.writer as writer;

fn load(bytes: *const u8, length: usize) -> object::Result {
    return reader::load(bytes, length);
}

fn save(object: object::Object) -> bytes::BufferResult {
    return writer::save(object);
}
