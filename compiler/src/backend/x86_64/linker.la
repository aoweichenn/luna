module luna.bootstrap.backend.x86_64.linker;

import luna.std.binary as binary;
import luna.std.checked as checked;
import luna.std.text as text;

enum Limit: usize {
    maximum_inputs = 128, maximum_output = 268435456, page_size = 4096, image_base = 4194304, text_offset = 4096,
}

enum Elf: usize {
    header_size = 64, program_header_size = 56, machine_x86_64 = 62, executable_type = 2, load_segment = 1,
    flag_execute = 1, flag_write = 2, flag_read = 4,
}

struct Placement {
    text: usize;
    rodata: usize;
    data: usize;
    bss: usize;
}

struct Global {
    name: text::View;
    object_index: usize;
    symbol_index: usize;
}

struct Image {
    text: bytes::Buffer;
    rodata: bytes::Buffer;
    data: bytes::Buffer;
    globals: bytes::Buffer;
    bss_size: usize;
    text_alignment: usize;
    rodata_alignment: usize;
    data_alignment: usize;
    bss_alignment: usize;
    text_address: usize;
    rodata_address: usize;
    data_address: usize;
    bss_address: usize;
    entry_address: usize;
    error: runtime::Error;
    input_index: usize;
}

struct BinaryWriter {
    output: *bytes::Buffer;
    active: bool;
}

fn image_empty() -> Image {
    return {
        text = bytes::empty(), rodata = bytes::empty(), data = bytes::empty(),
        globals = bytes::empty(), bss_size = 0, text_alignment = 1, rodata_alignment = 1, data_alignment = 1,
        bss_alignment = 1, text_address = 0, rodata_address = 0, data_address = 0, bss_address = 0, entry_address = 0,
        error = runtime::Error.none, input_index = 0,
    };
}

fn fail(image: *Image, error: runtime::Error, input_index: usize) -> bool {
    if (image != null && image->error == runtime::Error.none) {
        image->error = error;
        image->input_index = input_index;
    }
    return false;
}

fn power_of_two(value: usize) -> bool {
    return checked::is_power_of_two(value);
}

fn align(value: usize, alignment: usize, result: *usize) -> bool {
    return checked::align_up(value, alignment, result);
}

fn append_u8(output: *bytes::Buffer, value: u8) -> bool {
    return binary::append_u8(output, value);
}

fn append_u16(output: *bytes::Buffer, value: u16) -> bool {
    return binary::append_u16(output, value);
}

fn append_u32(output: *bytes::Buffer, value: u32) -> bool {
    return binary::append_u32(output, value);
}

fn append_u64(output: *bytes::Buffer, value: u64) -> bool {
    return binary::append_u64(output, value);
}

fn append_bytes(output: *bytes::Buffer, data: *const u8, length: usize) -> bool {
    if (output == null) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(*output, data, length);
    *output = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn binary_writer(output: *bytes::Buffer) -> BinaryWriter {
    return {output = output, active = output != null};
}

fn binary_writer_bytes(writer: *BinaryWriter, data: *const u8, length: usize) {
    if (writer == null || !writer->active) {
        return;
    }
    writer->active = append_bytes(writer->output, data, length);
}

fn binary_writer_u16(writer: *BinaryWriter, value: u16) {
    if (writer == null || !writer->active) {
        return;
    }
    writer->active = append_u16(writer->output, value);
}

fn binary_writer_u32(writer: *BinaryWriter, value: u32) {
    if (writer == null || !writer->active) {
        return;
    }
    writer->active = append_u32(writer->output, value);
}

fn binary_writer_u64(writer: *BinaryWriter, value: u64) {
    if (writer == null || !writer->active) {
        return;
    }
    writer->active = append_u64(writer->output, value);
}

fn append_padding(output: *bytes::Buffer, count: usize, fill: u8) -> bool {
    for (var index: usize = 0; index < count; index += 1) {
        if (!append_u8(output, fill)) {
            return false;
        }
    }
    return true;
}

fn pad_to(output: *bytes::Buffer, offset: usize) -> bool {
    if (output == null || output->length > offset) {
        return false;
    }
    return append_padding(output, offset - output->length, 0);
}

fn region_append(
    image: *Image, destination: *bytes::Buffer, source: bytes::Buffer, alignment: usize, fill: u8,
    input_index: usize, placement: *usize) -> bool {
    if (destination == null || placement == null) {
        return fail(image, runtime::Error.out_of_memory, input_index);
    }
    var aligned: usize = 0;
    if (!align(destination->length, alignment, &aligned)) {
        return fail(image, runtime::Error.out_of_memory, input_index);
    }
    let range_is_valid: bool = aligned <= Limit.maximum_output as usize &&
        source.length <= (Limit.maximum_output as usize) - aligned;
    if (!range_is_valid) {
        return fail(image, runtime::Error.out_of_memory, input_index);
    }
    let padded: bool = append_padding(destination, aligned - destination->length, fill);
    let appended: bool = padded && append_bytes(destination, source.data as *const u8, source.length);
    if (!appended) {
        return fail(image, runtime::Error.out_of_memory, input_index);
    }
    *placement = aligned;
    return true;
}

fn name_equal(left: text::View, right: text::View) -> bool {
    return text::equal(left, right);
}

fn find_global(image: *const Image, name: text::View, result: *Global) -> bool {
    let globals: *const Global = image->globals.data as *const Global;
    let count: usize = image->globals.length / sizeof(Global);
    for (var index: usize = 0; index < count; index += 1) {
        if (name_equal(globals[index].name, name)) {
            if (result != null) {
                *result = globals[index];
            }
            return true;
        }
    }
    return false;
}

fn collect_globals(image: *Image, objects: *const object::Object, object_count: usize) -> bool {
    for (var object_index: usize = 0; object_index < object_count; object_index += 1) {
        image->input_index = object_index;
        let object: object::Object = objects[object_index];
        for (var symbol_index: usize = 0; symbol_index < object::symbol_count(object); symbol_index += 1) {
            let result: object::SymbolResult = object::get_symbol(object, symbol_index);
            if (result.error != runtime::Error.none) {
                return fail(image, result.error, object_index);
            }
            let symbol: object::Symbol = result.symbol;
            if (symbol.defined && symbol.global) {
                let name: text::ViewResult = object::symbol_name(object, symbol);
                var previous: Global = {};
                if (name.error != runtime::Error.none ||
                    find_global(
                        image as *const Image, name.view, &previous)) {
                    return fail(image, runtime::Error.exists, object_index);
                }
                let global: Global = {
                    name = name.view, object_index = object_index, symbol_index = symbol_index,
                };
                let appended: bytes::BufferResult =
                    bytes::append(image->globals, (&global) as *const Global as *const u8, sizeof(Global));
                image->globals = appended.buffer;
                if (appended.error != runtime::Error.none) {
                    return fail(image, appended.error, object_index);
                }
            }
        }
    }
    return true;
}

fn layout_regions(image: *Image, objects: *const object::Object, object_count: usize, placements: *Placement) -> bool {
    for (var object_index: usize = 0; object_index < object_count; object_index += 1) {
        let object: object::Object = objects[object_index];
        if (!object::is_valid(object)) {
            return fail(image, runtime::Error.invalid_argument, object_index);
        }
        let text_appended: bool = region_append(
            image, &image->text, object.text, object.text_alignment, 144, object_index, &placements[object_index].text);
        let rodata_appended: bool = text_appended && region_append(
            image, &image->rodata, object.rodata, object.rodata_alignment, 0, object_index,
            &placements[object_index].rodata);
        let data_appended: bool = rodata_appended && region_append(
            image, &image->data, object.data, object.data_alignment, 0, object_index, &placements[object_index].data);
        if (!data_appended) {
            return false;
        }
        var bss_offset: usize = 0;
        if (!align(image->bss_size, object.bss_alignment, &bss_offset) ||
            object.bss_size > (Limit.maximum_output as usize) - bss_offset) {
            return fail(image, runtime::Error.out_of_memory, object_index);
        }
        placements[object_index].bss = bss_offset;
        image->bss_size = bss_offset + object.bss_size;
        if (image->text_alignment < object.text_alignment) {
            image->text_alignment = object.text_alignment;
        }
        if (image->rodata_alignment < object.rodata_alignment) {
            image->rodata_alignment = object.rodata_alignment;
        }
        if (image->data_alignment < object.data_alignment) {
            image->data_alignment = object.data_alignment;
        }
        if (image->bss_alignment < object.bss_alignment) {
            image->bss_alignment = object.bss_alignment;
        }
    }
    return image->text.length != 0;
}

fn layout_image(image: *Image) -> bool {
    let page: usize = Limit.page_size as usize;
    let base: usize = Limit.image_base as usize;
    let text_offset: usize = Limit.text_offset as usize;
    var rodata_offset: usize = 0;
    var data_offset: usize = 0;
    if (!align(text_offset + image->text.length, page, &rodata_offset)) {
        return fail(image, runtime::Error.out_of_memory, image->input_index);
    }
    if (!align(rodata_offset + image->rodata.length, page, &data_offset)) {
        return fail(image, runtime::Error.out_of_memory, image->input_index);
    }
    if (data_offset > 18446744073709551615 as usize - base) {
        return fail(image, runtime::Error.out_of_memory, image->input_index);
    }
    image->text_address = base + text_offset;
    image->rodata_address = base + rodata_offset;
    image->data_address = base + data_offset;
    if (!align(
            image->data_address + image->data.length, image->bss_alignment, &image->bss_address)) {
        return fail(image, runtime::Error.out_of_memory, image->input_index);
    }
    return true;
}

fn section_address(image: *const Image, placement: Placement, section: object::Section, result: *usize) -> bool {
    if (result == null) {
        return false;
    }
    if (section == object::Section.text) {
        *result = image->text_address + placement.text;
        return true;
    }
    if (section == object::Section.rodata) {
        *result = image->rodata_address + placement.rodata;
        return true;
    }
    if (section == object::Section.data) {
        *result = image->data_address + placement.data;
        return true;
    }
    if (section == object::Section.bss) {
        *result = image->bss_address + placement.bss;
        return true;
    }
    return false;
}

fn symbol_address(
    image: *const Image, objects: *const object::Object, placements: *const Placement,
    object_index: usize, symbol_index: usize, result: *usize) -> bool {
    let symbol_result: object::SymbolResult = object::get_symbol(objects[object_index], symbol_index);
    if (symbol_result.error != runtime::Error.none || !symbol_result.symbol.defined) {
        return false;
    }
    var base_address: usize = 0;
    if (!section_address(image, placements[object_index], symbol_result.symbol.section, &base_address) ||
        symbol_result.symbol.value > 18446744073709551615 as usize - base_address) {
        return false;
    }
    *result = base_address + symbol_result.symbol.value;
    return true;
}

fn resolve_symbol(
    image: *const Image, objects: *const object::Object, placements: *const Placement,
    object_index: usize, symbol_index: usize, result: *usize) -> bool {
    let object: object::Object = objects[object_index];
    let symbol_result: object::SymbolResult = object::get_symbol(object, symbol_index);
    if (symbol_result.error != runtime::Error.none) {
        return false;
    }
    if (symbol_result.symbol.defined) {
        return symbol_address(image, objects, placements, object_index, symbol_index, result);
    }
    let name: text::ViewResult = object::symbol_name(object, symbol_result.symbol);
    if (name.error != runtime::Error.none) {
        return false;
    }
    var global: Global = {};
    if (!find_global(image, name.view, &global)) {
        return false;
    }
    return symbol_address(image, objects, placements, global.object_index, global.symbol_index, result);
}

fn region(
    image: *Image, placement: Placement, section: object::Section,
    output_offset: *usize, address: *usize) -> *bytes::Buffer {
    if (section == object::Section.text) {
        *output_offset = placement.text;
        *address = image->text_address;
        return &image->text;
    }
    if (section == object::Section.rodata) {
        *output_offset = placement.rodata;
        *address = image->rodata_address;
        return &image->rodata;
    }
    if (section == object::Section.data) {
        *output_offset = placement.data;
        *address = image->data_address;
        return &image->data;
    }
    return null;
}

fn store_u32(destination: *u8, value: u32) -> bool {
    return binary::store_u32(destination, value);
}

fn store_u64(destination: *u8, value: u64) -> bool {
    return binary::store_u64(destination, value);
}

fn relocation_range_is_valid(
    region: *bytes::Buffer, placement_offset: usize, relocation_offset: usize, width: usize) -> bool {
    if (region == null || placement_offset > region->length) {
        return false;
    }
    let remaining: usize = region->length - placement_offset;
    if (relocation_offset > remaining) {
        return false;
    }
    return width <= remaining - relocation_offset;
}

fn signed_addition_is_valid(value: isize, addend: isize) -> bool {
    if (addend > 0) {
        return value <= 9223372036854775807 as isize - addend;
    }
    if (addend < 0) {
        return value >= -9223372036854775807 as isize - 1 - addend;
    }
    return true;
}

fn relocation_value_fits(kind: object::RelocationKind, value: isize) -> bool {
    if (kind == object::RelocationKind.absolute32) {
        return value >= 0 && value <= 4294967295;
    }
    return value >= -2147483648 && value <= 2147483647;
}

fn apply_relocations(
    image: *Image, objects: *const object::Object, object_count: usize, placements: *const Placement) -> bool {
    for (var object_index: usize = 0; object_index < object_count; object_index += 1) {
        image->input_index = object_index;
        let object: object::Object = objects[object_index];
        for (var relocation_index: usize = 0;
            relocation_index < object::relocation_count(object);
            relocation_index += 1) {
            let result: object::RelocationResult = object::get_relocation(object, relocation_index);
            if (result.error != runtime::Error.none) {
                return fail(image, result.error, object_index);
            }
            let relocation: object::Relocation = result.relocation;
            var symbol_address: usize = 0;
            if (!resolve_symbol(
                    image as *const Image, objects, placements, object_index, relocation.symbol_index,
                    &symbol_address)) {
                return fail(image, runtime::Error.not_found, object_index);
            }
            var placement_offset: usize = 0;
            var region_address: usize = 0;
            let region: *bytes::Buffer = region(
                image, placements[object_index], relocation.section, &placement_offset, &region_address);
            let width: usize = relocation.kind == object::RelocationKind.absolute64 ? 8 : 4;
            if (!relocation_range_is_valid(region, placement_offset, relocation.offset, width)) {
                return fail(image, runtime::Error.invalid_argument, object_index);
            }
            let output_offset: usize = placement_offset + relocation.offset;
            if (relocation.kind == object::RelocationKind.pc32 || relocation.kind == object::RelocationKind.plt32) {
                if (symbol_address > 9223372036854775807 as usize || region_address >
                        9223372036854775807 as usize - output_offset) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
                let place: isize = (region_address + output_offset) as isize;
                let difference: isize = symbol_address as isize - place;
                if (!signed_addition_is_valid(difference, relocation.addend)) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
                let value: isize = difference + relocation.addend;
                let value_fits: bool = value >= -2147483648 && value <= 2147483647;
                if (!value_fits || !store_u32(&region->data[output_offset], value as u32)) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
            } else if (relocation.kind == object::RelocationKind.absolute64) {
                let signed_symbol: isize = symbol_address as isize;
                let addition_is_valid: bool = signed_addition_is_valid(signed_symbol, relocation.addend);
                if (symbol_address > 9223372036854775807 as usize || !addition_is_valid) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
                if (!store_u64(&region->data[output_offset], (signed_symbol + relocation.addend) as u64)) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
            } else if (relocation.kind == object::RelocationKind.absolute32 || relocation.kind ==
                    object::RelocationKind.signed32) {
                let signed_symbol: isize = symbol_address as isize;
                let addition_is_valid: bool = signed_addition_is_valid(signed_symbol, relocation.addend);
                if (symbol_address > 9223372036854775807 as usize || !addition_is_valid) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
                let value: isize = signed_symbol + relocation.addend;
                if (!relocation_value_fits(relocation.kind, value) ||
                    !store_u32(&region->data[output_offset], value as u32)) {
                    return fail(image, runtime::Error.invalid_argument, object_index);
                }
            } else {
                return fail(image, runtime::Error.not_supported, object_index);
            }
        }
    }
    return true;
}

fn resolve_entry(image: *Image, objects: *const object::Object, placements: *const Placement) -> bool {
    let entry: text::ViewResult = text::view("_start", 6);
    if (entry.error != runtime::Error.none) {
        return fail(image, runtime::Error.not_found, image->input_index);
    }
    var global: Global = {};
    if (!find_global(image as *const Image, entry.view, &global)) {
        return fail(image, runtime::Error.not_found, image->input_index);
    }
    if (!symbol_address(
            image as *const Image, objects, placements, global.object_index, global.symbol_index,
            &image->entry_address)) {
        return fail(image, runtime::Error.not_found, image->input_index);
    }
    let symbol: object::SymbolResult = object::get_symbol(objects[global.object_index], global.symbol_index);
    let symbol_is_entry: bool = symbol.symbol.section == object::Section.text &&
        symbol.symbol.kind == object::SymbolKind.function;
    if (symbol.error != runtime::Error.none || !symbol_is_entry) {
        return fail(image, runtime::Error.invalid_argument, global.object_index);
    }
    return true;
}

fn write_header(output: *bytes::Buffer, image: *const Image, program_count: usize) -> bool {
    var writer: BinaryWriter = binary_writer(output);
    binary_writer_bytes(&writer, "\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00", 16);
    binary_writer_u16(&writer, (Elf.executable_type as usize) as u16);
    binary_writer_u16(&writer, (Elf.machine_x86_64 as usize) as u16);
    binary_writer_u32(&writer, 1);
    binary_writer_u64(&writer, image->entry_address as u64);
    binary_writer_u64(&writer, (Elf.header_size as usize) as u64);
    binary_writer_u64(&writer, 0);
    binary_writer_u32(&writer, 0);
    binary_writer_u16(&writer, (Elf.header_size as usize) as u16);
    binary_writer_u16(&writer, (Elf.program_header_size as usize) as u16);
    binary_writer_u16(&writer, program_count as u16);
    binary_writer_u16(&writer, 0);
    binary_writer_u16(&writer, 0);
    binary_writer_u16(&writer, 0);
    return writer.active;
}

fn write_program(
    output: *bytes::Buffer, flags: u32, offset: usize, address: usize, file_size: usize, memory_size: usize) -> bool {
    var writer: BinaryWriter = binary_writer(output);
    binary_writer_u32(&writer, (Elf.load_segment as usize) as u32);
    binary_writer_u32(&writer, flags);
    binary_writer_u64(&writer, offset as u64);
    binary_writer_u64(&writer, address as u64);
    binary_writer_u64(&writer, address as u64);
    binary_writer_u64(&writer, file_size as u64);
    binary_writer_u64(&writer, memory_size as u64);
    binary_writer_u64(&writer, (Limit.page_size as usize) as u64);
    return writer.active;
}

fn append_region(output: *bytes::Buffer, offset: usize, source: bytes::Buffer, enabled: bool) -> bool {
    if (!enabled) {
        return true;
    }
    return pad_to(output, offset) && append_bytes(output, source.data as *const u8, source.length);
}

fn serialize(image: *const Image) -> bytes::BufferResult {
    var output: bytes::Buffer = bytes::empty();
    let has_rodata: bool = image->rodata.length != 0;
    let has_data: bool = image->data.length != 0 || image->bss_size != 0;
    let program_count: usize = 1 + (has_rodata ? 1 : 0) + (has_data ? 1 : 0);
    if (!write_header(&output, image, program_count) ||
        !write_program(
            &output, ((Elf.flag_read as usize) | (Elf.flag_execute as usize)) as u32,
            Limit.text_offset as usize, image->text_address, image->text.length, image->text.length)) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = runtime::Error.out_of_memory,
        };
    }
    let base: usize = Limit.image_base as usize;
    let rodata_offset: usize = image->rodata_address - base;
    let data_offset: usize = image->data_address - base;
    if (has_rodata &&
        !write_program(
            &output, (Elf.flag_read as usize) as u32, rodata_offset, image->rodata_address,
            image->rodata.length, image->rodata.length)) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = runtime::Error.out_of_memory,
        };
    }
    if (has_data) {
        let memory_size: usize = image->bss_size == 0 ? image->data.length : image->bss_address + image->bss_size -
                    image->data_address;
        if (!write_program(
                &output, ((Elf.flag_read as usize) | (Elf.flag_write as usize)) as u32, data_offset,
                image->data_address, image->data.length, memory_size)) {
            bytes::release(output);
            return {
                buffer = bytes::empty(), error = runtime::Error.out_of_memory,
            };
        }
    }
    let text_appended: bool = append_region(&output, Limit.text_offset as usize, image->text, true);
    let rodata_appended: bool = text_appended && append_region(&output, rodata_offset, image->rodata, has_rodata);
    let data_appended: bool = rodata_appended && append_region(&output, data_offset, image->data, has_data);
    if (!data_appended) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = runtime::Error.out_of_memory,
        };
    }
    return {
        buffer = output, error = runtime::Error.none,
    };
}

fn image_release(image: Image) -> runtime::Error {
    var error: runtime::Error = bytes::release(image.globals);
    let data_error: runtime::Error = bytes::release(image.data);
    let rodata_error: runtime::Error = bytes::release(image.rodata);
    let text_error: runtime::Error = bytes::release(image.text);
    if (error == runtime::Error.none) {
        error = data_error;
    }
    if (error == runtime::Error.none) {
        error = rodata_error;
    }
    if (error == runtime::Error.none) {
        error = text_error;
    }
    return error;
}

fn link(objects: *const object::Object, object_count: usize) -> Result {
    var image: Image = image_empty();
    if (objects == null || object_count == 0) {
        return {
            executable = bytes::empty(), error = runtime::Error.invalid_argument, input_index = 0,
        };
    }
    if (object_count > Limit.maximum_inputs as usize) {
        return {
            executable = bytes::empty(), error = runtime::Error.invalid_argument, input_index = 0,
        };
    }
    var placements: [Limit.maximum_inputs + 1]Placement = {};
    var executable: bytes::BufferResult = {
        buffer = bytes::empty(), error = runtime::Error.invalid_argument,
    };
    let globals_collected: bool = collect_globals(&image, objects, object_count);
    let regions_laid_out: bool = globals_collected && layout_regions(&image, objects, object_count, &placements[0]);
    let image_laid_out: bool = regions_laid_out && layout_image(&image);
    let relocations_applied: bool = image_laid_out &&
        apply_relocations(&image, objects, object_count, &placements[0] as *const Placement);
    let entry_resolved: bool = relocations_applied &&
        resolve_entry(&image, objects, &placements[0] as *const Placement);
    if (entry_resolved) {
        executable = serialize(&image as *const Image);
        if (executable.error != runtime::Error.none) {
            image.error = executable.error;
        }
    }
    let image_error: runtime::Error = image_release(image);
    let image_build_succeeded: bool = image.error == runtime::Error.none && executable.error == runtime::Error.none;
    if (image_build_succeeded && image_error != runtime::Error.none) {
        bytes::release(executable.buffer);
        return {
            executable = bytes::empty(), error = image_error, input_index = image.input_index,
        };
    }
    if (image.error != runtime::Error.none) {
        if (executable.error == runtime::Error.none) {
            bytes::release(executable.buffer);
        }
        return {
            executable = bytes::empty(), error = image.error, input_index = image.input_index,
        };
    }
    return {
        executable = executable.buffer, error = executable.error, input_index = image.input_index,
    };
}
