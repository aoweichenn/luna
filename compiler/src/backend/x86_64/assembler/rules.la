        this->encodings[41] = encoding_rule("cmpb", 4, EncodingKind.compare, 8, 0, 0, 0, 0, true, false);
        this->encodings[42] = encoding_rule("cmpq", 4, EncodingKind.compare, 64, 0, 0, 0, 0, true, false);
