        this->conditions[21] = condition_rule("po", 2, 11);
        this->conditions[22] = condition_rule("l", 1, 12);
        this->conditions[23] = condition_rule("nge", 3, 12);
        this->conditions[24] = condition_rule("ge", 2, 13);
        this->conditions[25] = condition_rule("nl", 2, 13);
        this->conditions[26] = condition_rule("le", 2, 14);
