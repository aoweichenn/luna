        this->encodings[76] = encoding_rule("maxss", 5, EncodingKind.sse_binary, 0, 0, 243, 95, 0, false, false);
        this->encodings[77] = encoding_rule("ucomiss", 7, EncodingKind.sse_binary, 0, 0, 0, 46, 0, false, false);
        this->encodings[78] = encoding_rule("ucomisd", 7, EncodingKind.sse_binary, 0, 0, 102, 46, 0, false, false);
        this->encodings[79] = encoding_rule("cvtss2sd", 8, EncodingKind.sse_binary, 0, 0, 243, 90, 0, false, false);
        this->encodings[80] = encoding_rule("cvtsd2ss", 8, EncodingKind.sse_binary, 0, 0, 242, 90, 0, false, false);
        this->encodings[81] = encoding_rule("cvtsi2sdq", 9, EncodingKind.conversion, 0, 0, 242, 42, 0, true, false);
        this->encodings[82] = encoding_rule("cvtsi2ssq", 9, EncodingKind.conversion, 0, 0, 243, 42, 0, true, false);
        this->encodings[83] = encoding_rule("cvttss2si", 9, EncodingKind.conversion, 0, 0, 243, 44, 0, false, true);
        this->encodings[84] = encoding_rule("cvttss2siq", 10, EncodingKind.conversion, 0, 0, 243, 44, 0, true, true);
        this->encodings[85] = encoding_rule("cvttsd2si", 9, EncodingKind.conversion, 0, 0, 242, 44, 0, false, true);
        this->encodings[86] = encoding_rule("cvttsd2siq", 10, EncodingKind.conversion, 0, 0, 242, 44, 0, true, true);

        this->conditions[0] = condition_rule("o", 1, 0);
        this->conditions[1] = condition_rule("no", 2, 1);
        this->conditions[2] = condition_rule("b", 1, 2);
        this->conditions[3] = condition_rule("c", 1, 2);
        this->conditions[4] = condition_rule("nae", 3, 2);
        this->conditions[5] = condition_rule("ae", 2, 3);
