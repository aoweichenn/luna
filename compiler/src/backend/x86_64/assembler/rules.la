    priv fn find_encoding(mnemonic: string_views::string_view) const -> *const EncodingRule {
        for (var index: usize = 0; index < EncodingLimit.rule_count as usize; index += 1) {
            let rule: *const EncodingRule = &this->encodings[index];
            if (equal(mnemonic, rule->name, rule->name_length as usize)) {
                return rule;
            }
        }
        return null;
    }

    priv fn condition(name: string_views::string_view, result: *u8) const -> bool {
        if (result == null) {
            return false;
        }
        for (var index: usize = 0; index < EncodingLimit.condition_count as usize; index += 1) {
            let rule: ConditionRule = this->conditions[index];
            if (equal(name, rule.name, rule.name_length as usize)) {
                *result = rule.code;
                return true;
            }
        }
        return false;
    }
}
