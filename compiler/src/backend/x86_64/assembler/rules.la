        this->encodings[15] = encoding_rule("movl", 4, EncodingKind.move, 32, 0, 0, 0, 0, false, false);
        this->encodings[16] = encoding_rule("movd", 4, EncodingKind.movd, 32, 0, 0, 0, 0, false, false);
        this->encodings[17] = encoding_rule("movq", 4, EncodingKind.movd, 64, 0, 0, 0, 0, true, false);
