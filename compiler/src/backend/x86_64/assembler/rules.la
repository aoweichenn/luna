        this->encodings[63] = encoding_rule("addsd", 5, EncodingKind.sse_binary, 0, 0, 242, 88, 0, false, false);
        this->encodings[64] = encoding_rule("mulsd", 5, EncodingKind.sse_binary, 0, 0, 242, 89, 0, false, false);
        this->encodings[65] = encoding_rule("addss", 5, EncodingKind.sse_binary, 0, 0, 243, 88, 0, false, false);
        this->encodings[66] = encoding_rule("mulss", 5, EncodingKind.sse_binary, 0, 0, 243, 89, 0, false, false);
        this->encodings[67] = encoding_rule("subss", 5, EncodingKind.sse_binary, 0, 0, 243, 92, 0, false, false);
