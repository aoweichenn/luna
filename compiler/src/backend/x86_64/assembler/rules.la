module luna.compiler.x86.assembler;

fn encoding_rule(
    name: *const u8, name_length: u8, kind: EncodingKind, width: u8, target_width: u8,
    first: u8, second: u8, count: u8, primary: bool, secondary: bool) -> EncodingRule {
    return {
        name = name, name_length = name_length, kind = kind, width = width, target_width = target_width,
        first = first, second = second, count = count, primary = primary, secondary = secondary,
    };
}

fn condition_rule(name: *const u8, name_length: u8, code: u8) -> ConditionRule {
    return { name = name, name_length = name_length, code = code };
}

impl Assembler {
    priv fn initialize_rules() {
