        this->encodings[12] = encoding_rule("movabsq", 7, EncodingKind.movabs, 64, 0, 0, 0, 0, false, false);
        this->encodings[13] = encoding_rule("movb", 4, EncodingKind.move, 8, 0, 0, 0, 0, false, false);
