        this->encodings[70] = encoding_rule("divsd", 5, EncodingKind.sse_binary, 0, 0, 242, 94, 0, false, false);
        this->encodings[71] = encoding_rule("sqrtsd", 6, EncodingKind.sse_binary, 0, 0, 242, 81, 0, false, false);
        this->encodings[72] = encoding_rule("sqrtss", 6, EncodingKind.sse_binary, 0, 0, 243, 81, 0, false, false);
        this->encodings[73] = encoding_rule("minsd", 5, EncodingKind.sse_binary, 0, 0, 242, 93, 0, false, false);
        this->encodings[74] = encoding_rule("minss", 5, EncodingKind.sse_binary, 0, 0, 243, 93, 0, false, false);
