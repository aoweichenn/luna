module luna.compiler.x86.assembler;

enum DirectiveKind: usize {
    invalid, text, data, section, global, external, symbol_type, symbol_size, byte, quad, power_align, byte_align,
}

enum DirectiveLimit: usize {
    count = 11, section_count = 4, symbol_kind_count = 2,
}

fn directive_kind(name: string_views::string_view) -> DirectiveKind {
    var names: [11]*const u8 = {};
    names[0] = ".text";
    names[1] = ".data";
    names[2] = ".section";
    names[3] = ".globl";
    names[4] = ".extern";
    names[5] = ".type";
    names[6] = ".size";
    names[7] = ".byte";
    names[8] = ".quad";
    names[9] = ".p2align";
    names[10] = ".balign";
    var lengths: [11]usize = { 5, 5, 8, 6, 7, 5, 5, 5, 5, 8, 7 };
    var kinds: [11]DirectiveKind = {};
    kinds[0] = DirectiveKind.text;
    kinds[1] = DirectiveKind.data;
    kinds[2] = DirectiveKind.section;
    kinds[3] = DirectiveKind.global;
    kinds[4] = DirectiveKind.external;
    kinds[5] = DirectiveKind.symbol_type;
    kinds[6] = DirectiveKind.symbol_size;
    kinds[7] = DirectiveKind.byte;
    kinds[8] = DirectiveKind.quad;
    kinds[9] = DirectiveKind.power_align;
    kinds[10] = DirectiveKind.byte_align;
    for (var index: usize = 0; index < DirectiveLimit.count as usize; index += 1) {
        if (equal(name, names[index], lengths[index])) {
            return kinds[index];
        }
    }
    return DirectiveKind.invalid;
}

fn parse_section_name(name: string_views::string_view, section: *object::Section) -> bool {
    if (section == null) {
        return false;
    }
    var names: [4]*const u8 = {};
    names[0] = ".text";
    names[1] = ".rodata";
    names[2] = ".data";
    names[3] = ".note.GNU-stack";
    var lengths: [4]usize = { 5, 7, 5, 15 };
    var sections: [4]object::Section = {};
    sections[0] = object::Section.text;
    sections[1] = object::Section.rodata;
    sections[2] = object::Section.data;
    sections[3] = object::Section.undefined;
    for (var index: usize = 0; index < DirectiveLimit.section_count as usize; index += 1) {
        if (equal(name, names[index], lengths[index])) {
            *section = sections[index];
            return true;
        }
    }
    return false;
}

fn parse_symbol_kind(name: string_views::string_view) -> object::SymbolKind {
    var names: [2]*const u8 = {};
    names[0] = "@function";
    names[1] = "@object";
    var lengths: [2]usize = { 9, 7 };
    var kinds: [2]object::SymbolKind = {};
    kinds[0] = object::SymbolKind.function;
    kinds[1] = object::SymbolKind.object;
    for (var index: usize = 0; index < DirectiveLimit.symbol_kind_count as usize; index += 1) {
        if (equal(name, names[index], lengths[index])) {
            return kinds[index];
        }
    }
    return object::SymbolKind.none;
}

impl Assembler {


    priv fn symbol_byte_is_valid(value: u8) -> bool {
    if (is_letter(value) || is_decimal_digit(value)) {
        return true;
    }
    let punctuation: [3]u8 = { '_', '.', '$' };
    for (var index: usize = 0; index < 3; index += 1) {
        if (value == punctuation[index]) {
            return true;
        }
    }
    return false;
}

    priv fn symbol_name_is_valid(name: string_views::string_view) -> bool {
    if (name.length == 0 || name.data == null) {
        return false;
    }
    for (var index: usize = 0; index < name.length; index += 1) {
        let value: u8 = name.data[index];
        let starts_with_digit: bool = index == 0 && is_decimal_digit(value);
        if (!this->symbol_byte_is_valid(value) || starts_with_digit) {
            return false;
        }
    }
    return true;
}

    priv fn get_symbol(name: string_views::string_view) -> object::IndexResult {
    let referenced: SymbolBindingResult = this->symbols.reference(name);
    if (referenced.error != runtime::Error.none || referenced.binding == null) {
        let error: runtime::Error = referenced.error == runtime::Error.none ? runtime::Error.invalid_argument :
            referenced.error;
        this->fail(error);
        return { index = 0, found = false, error = error };
    }
    let result: object::IndexResult = this->symbols.materialize(&this->storage, referenced.binding);
    if (result.error != runtime::Error.none) {
        this->fail(result.error);
    }
    return result;
}

    priv fn define_label(name: string_views::string_view) -> bool {
    if (!this->section_is_active() || name.length == 0) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let section_size: usize = this->storage.section_size(this->current_section);
    var numeric: bool = true;
    var number: usize = 0;
    for (var index: usize = 0; index < name.length; index += 1) {
        if (!is_decimal_digit(name.data[index])) {
            numeric = false;
        } else if (numeric) {
            let digit: usize = (name.data[index] - 48) as usize;
            if (number > (18446744073709551615 as usize - digit) / 10) {
                return this->fail(runtime::Error.invalid_argument);
            }
            number = number * 10 + digit;
        }
    }
    if (numeric) {
        if (this->numeric_labels.size() >= Limit.maximum_numeric_labels as usize) {
            return this->fail(runtime::Error.out_of_memory);
        }
        let label: NumericLabel = {
            section = this->current_section, offset = section_size, number = number,
        };
        let error: runtime::Error = this->numeric_labels.push_back(label);
        if (error != runtime::Error.none) {
            return this->fail(error);
        }
        return true;
    }
    if (!this->symbol_name_is_valid(name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let found: object::IndexResult = this->get_symbol(name);
    if (found.error != runtime::Error.none) {
        return false;
    }
    let symbol: *object::Symbol = this->storage.symbol_mut(found.index);
    if (symbol == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (symbol->defined || symbol->external) {
        return this->fail(runtime::Error.invalid_argument);
    }
    symbol->defined = true;
    symbol->section = this->current_section;
    symbol->value = section_size;
    return true;
}

    priv fn mark_symbol(input: string_views::string_view, external: bool) -> bool {
    let name: string_views::string_view = trim(input);
    if (!this->symbol_name_is_valid(name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let found: object::IndexResult = this->get_symbol(name);
    if (found.error != runtime::Error.none) {
        return false;
    }
    let symbol: *object::Symbol = this->storage.symbol_mut(found.index);
    if (symbol == null) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (external && symbol->defined) {
        return this->fail(runtime::Error.invalid_argument);
    }
    symbol->global = true;
    symbol->external = external;
    return true;
}

    priv fn symbol_type(input: string_views::string_view) -> bool {
    let comma: usize = find(input, ',');
    if (comma == input.length) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let name: string_views::string_view = trim(slice(input, 0, comma));
    let kind: string_views::string_view = trim(slice(input, comma + 1, input.length - comma - 1));
    if (!this->symbol_name_is_valid(name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let found: object::IndexResult = this->get_symbol(name);
    let symbol: *object::Symbol = this->storage.symbol_mut(found.index);
    if (found.error != runtime::Error.none || symbol == null) {
        return false;
    }
    let parsed_kind: object::SymbolKind = parse_symbol_kind(kind);
    if (parsed_kind == object::SymbolKind.none) {
        return this->fail(runtime::Error.invalid_argument);
    }
    symbol->kind = parsed_kind;
    return true;
}

    priv fn symbol_size(input: string_views::string_view) -> bool {
    let comma: usize = find(input, ',');
    if (comma == input.length) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let name: string_views::string_view = trim(slice(input, 0, comma));
    let expression: string_views::string_view = trim(slice(input, comma + 1, input.length - comma - 1));
    let found: object::IndexResult = this->symbols.find(name);
    let symbol: *object::Symbol = this->storage.symbol_mut(found.index);
    let lookup_is_valid: bool = found.found && found.error == runtime::Error.none;
    let symbol_is_defined: bool = symbol != null && symbol->defined;
    if (!lookup_is_valid || !symbol_is_defined) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let section_is_valid: bool = symbol->section == this->current_section && this->section_is_active();
    let expression_length_is_valid: bool = expression.length == name.length + 2;
    if (!section_is_valid || !expression_length_is_valid) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let expression_prefix_is_valid: bool = expression.data[0] == '.' && expression.data[1] == '-';
    if (!expression_prefix_is_valid) {
        return this->fail(runtime::Error.invalid_argument);
    }
    for (var index: usize = 0; index < name.length; index += 1) {
        if (expression.data[index + 2] != name.data[index]) {
            return this->fail(runtime::Error.invalid_argument);
        }
    }
    let section_size: usize = this->storage.section_size(this->current_section);
    if (symbol->value > section_size) {
        return this->fail(runtime::Error.invalid_argument);
    }
    symbol->size = section_size - symbol->value;
    return true;
}

    priv fn alignment(input: string_views::string_view, exponent: bool) -> bool {
    var parsed: usize = 0;
    if (!parse_usize(input, &parsed)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (exponent && parsed > 12) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let alignment: usize = exponent ? 1 << parsed : parsed;
    let alignment_is_valid: bool = alignment != 0 && (alignment & (alignment - 1)) == 0;
    if (!alignment_is_valid) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (!this->storage.set_alignment(this->current_section, alignment)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (!this->section_is_active()) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let section_size: usize = this->storage.section_size(this->current_section);
    let remainder: usize = section_size & (alignment - 1);
    let padding: usize = remainder == 0 ? 0 : alignment - remainder;
    let fill: u8 = this->current_section == object::Section.text ? 144 : 0;
    for (var index: usize = 0; index < padding; index += 1) {
        if (!this->append_u8(fill)) {
            return false;
        }
    }
    return true;
}

    priv fn symbol_address(input: string_views::string_view) -> bool {
    let name: string_views::string_view = trim(input);
    if (!this->symbol_name_is_valid(name)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    return this->append_symbol_address(name);
}

    priv fn directive(line: string_views::string_view) -> bool {
    var split: usize = 0;
    for (; split < line.length && !is_space(line.data[split]); split += 1) {}
    let directive: string_views::string_view = slice(line, 0, split);
    let arguments: string_views::string_view = trim(slice(line, split, line.length - split));
    switch (directive_kind(directive)) {
    case DirectiveKind.text {
        this->current_section = object::Section.text;
        return true;
    }
    case DirectiveKind.data {
        this->current_section = object::Section.data;
        return true;
    }
    case DirectiveKind.section {
        let comma: usize = find(arguments, ',');
        let name: string_views::string_view = trim(slice(arguments, 0,
            comma == arguments.length ? arguments.length : comma));
        var section: object::Section = object::Section.undefined;
        if (!parse_section_name(name, &section)) {
            return this->fail(runtime::Error.not_supported);
        }
        this->current_section = section;
        return true;
    }
    case DirectiveKind.global {
        return this->mark_symbol(arguments, false);
    }
    case DirectiveKind.external {
        return this->mark_symbol(arguments, true);
    }
    case DirectiveKind.symbol_type {
        return this->symbol_type(arguments);
    }
    case DirectiveKind.symbol_size {
        return this->symbol_size(arguments);
    }
    case DirectiveKind.byte {
        var bits: u64 = 0;
        let value: string_views::string_view = trim(arguments);
        if (!parse_bits(value, &bits) || !this->fits_u8(bits)) {
            return false;
        }
        return this->append_u8(bits as u8);
    }
    case DirectiveKind.quad {
        return this->symbol_address(arguments);
    }
    case DirectiveKind.power_align {
        return this->alignment(arguments, true);
    }
    case DirectiveKind.byte_align {
        return this->alignment(arguments, false);
    }
    default {
        return this->fail(runtime::Error.not_supported);
    }
    }
}

    priv fn instruction(line: string_views::string_view) -> bool {
    if (this->current_section != object::Section.text) {
        return this->fail(runtime::Error.invalid_argument);
    }
    var split: usize = 0;
    for (; split < line.length && !is_space(line.data[split]); split += 1) {}
    let mnemonic: string_views::string_view = slice(line, 0, split);
    let raw_operands: string_views::string_view = trim(slice(line, split, line.length - split));
    var operands: Operands = empty_operands();
    if (!parse_operands(raw_operands, &operands) ||
        !this->encode(mnemonic, raw_operands, &operands as *const Operands)) {
        return this->fail(runtime::Error.not_supported);
    }
    return true;
}

    priv fn assemble_line(input: string_views::string_view) -> bool {
    let line: string_views::string_view = trim(input);
    if (line.length == 0) {
        return true;
    }
    if (line.data[line.length - 1] == ':') {
        return this->define_label(slice(line, 0, line.length - 1));
    }
    if (line.data[0] == '.') {
        return this->directive(line);
    }
    return this->instruction(line);
}

    priv fn patch(fixup: Fixup, target: usize) -> bool {
    let output: *u8 = this->storage.section_data(fixup.section);
    let output_size: usize = this->storage.section_size(fixup.section);
    var next: usize = 0;
    if (output == null || !checked::range_is_valid(fixup.offset, 4, output_size)) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let next_is_valid: bool = checked::add(fixup.offset, 4, &next) && next <= 9223372036854775807 as usize;
    if (!next_is_valid || target > 9223372036854775807 as usize) {
        return this->fail(runtime::Error.invalid_argument);
    }
    let displacement: isize = target as isize - next as isize;
    if (displacement < -2147483648 || displacement > 2147483647) {
        return this->fail(runtime::Error.invalid_argument);
    }
    return binary::store_u32(&output[fixup.offset], displacement as u32);
}

    priv fn numeric_target(fixup: Fixup, result: *usize) -> bool {
    if (result == null) {
        return false;
    }
    let count: usize = this->numeric_labels.size();
    var found: bool = false;
    var selected: usize = fixup.numeric_forward ? 18446744073709551615 as usize : 0;
    for (var index: usize = 0; index < count; index += 1) {
        let label: NumericLabel = this->numeric_labels.get(index);
        let identity_matches: bool = label.section == fixup.section && label.number == fixup.numeric_label;
        if (!identity_matches) {
            continue;
        }
        if (fixup.numeric_forward) {
            let is_candidate: bool = label.offset > fixup.offset && label.offset < selected;
            if (is_candidate) {
                selected = label.offset;
                found = true;
            }
        } else {
            let precedes_fixup: bool = label.offset <= fixup.offset;
            let is_nearer: bool = !found || label.offset > selected;
            if (precedes_fixup && is_nearer) {
                selected = label.offset;
                found = true;
            }
        }
    }
    if (found) {
        *result = selected;
    }
    return found;
}

    priv fn resolve_fixups() -> bool {
    let count: usize = this->fixups.size();
    for (var index: usize = 0; index < count; index += 1) {
        let fixup: Fixup = this->fixups.get(index);
        this->current_line = fixup.line;
        if (fixup.is_numeric) {
            var target: usize = 0;
            let numeric_kind_is_valid: bool = fixup.kind != FixupKind.rip_relative;
            let target_is_valid: bool = this->numeric_target(fixup, &target);
            if (!numeric_kind_is_valid || !target_is_valid) {
                return this->fail(runtime::Error.invalid_argument);
            }
            if (!this->patch(fixup, target)) {
                return false;
            }
            continue;
        }
        let binding: *SymbolBinding = fixup.symbol;
        if (binding == null) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (!binding->materialized) {
            if (fixup.kind != FixupKind.call) {
                return this->fail(runtime::Error.invalid_argument);
            }
            let materialized: object::IndexResult = this->symbols.materialize(&this->storage, binding);
            if (materialized.error != runtime::Error.none) {
                return this->fail(materialized.error);
            }
        }
        let symbol: *object::Symbol = this->storage.symbol_mut(binding->index);
        if (symbol == null) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (!symbol->defined && fixup.kind == FixupKind.call) {
            symbol->global = true;
            symbol->external = true;
        }
        let unresolved_local: bool = !symbol->defined && !symbol->global;
        if (unresolved_local && !symbol->external) {
            return this->fail(runtime::Error.invalid_argument);
        }
        let same_section: bool = symbol->defined && symbol->section == fixup.section;
        if (fixup.kind != FixupKind.absolute64 && same_section) {
            if (!this->patch(fixup, symbol->value)) {
                return false;
            }
            continue;
        }
        if (fixup.kind == FixupKind.branch) {
            return this->fail(runtime::Error.invalid_argument);
        }
        if (!symbol->defined) {
            symbol->global = true;
        }
        var relocation_kind: object::RelocationKind = object::RelocationKind.pc32;
        var addend: isize = -4;
        switch (fixup.kind) {
        case FixupKind.call {
            relocation_kind = object::RelocationKind.plt32;
        }
        case FixupKind.rip_relative {
            relocation_kind = object::RelocationKind.pc32;
        }
        case FixupKind.absolute64 {
            relocation_kind = object::RelocationKind.absolute64;
            addend = 0;
        }
        default {
            return this->fail(runtime::Error.invalid_argument);
        }
        }
        let relocation: object::Relocation = {
            section = fixup.section, offset = fixup.offset, symbol_index = binding->index,
            kind = relocation_kind, addend = addend,
        };
        if (!this->storage.add_relocation(relocation)) {
            return this->fail(this->storage.error());
        }
    }
    return true;
}

    priv fn validate_symbols() -> bool {
    let count: usize = this->storage.symbol_count();
    if (!this->symbols.is_valid() || this->symbols.size() != count) {
        return this->fail(runtime::Error.invalid_argument);
    }
    for (var index: usize = 0; index < count; index += 1) {
        let result: object::SymbolResult = this->storage.symbol_at(index);
        let symbol_is_known: bool = result.symbol.defined || result.symbol.global;
        let symbol_has_linkage: bool = symbol_is_known || result.symbol.external;
        if (result.error != runtime::Error.none || !symbol_has_linkage) {
            return this->fail(runtime::Error.invalid_argument);
        }
    }
    return true;
}

}
