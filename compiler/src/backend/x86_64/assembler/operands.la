module luna.compiler.x86.assembler;

fn empty_register()
    -> Register {
    return {
        register_class = RegisterClass.general, code = 0, width = 0,
    };
}

fn empty_memory() -> Memory {
    return {
        symbol = { data = null, length = 0, }, displacement = 0, base = empty_register(),
        index = empty_register(), scale = 1, rip_relative = false, has_index = false,
    };
}

fn empty_operand()
    -> Operand {
    return {
        kind = OperandKind.none, immediate = 0, register = empty_register(),
        memory = empty_memory(), label = { data = null, length = 0, },
    };
}

fn empty_operands()
    -> Operands {
    var result: Operands = {};
    result.count = 0;
    return result;
}

fn is_space(value: u8) -> bool {
    let spaces: [3]u8 = { ' ', '\t', '\r' };
    for (var index: usize = 0; index < 3; index += 1) {
        if (value == spaces[index]) {
            return true;
        }
    }
    return false;
}

fn is_letter(value: u8) -> bool {
    let upper: bool = value >= 'A' && value <= 'Z';
    let lower: bool = value >= 'a' && value <= 'z';
    return upper || lower;
}

fn is_decimal_digit(value: u8) -> bool {
    return value >= '0' && value <= '9';
}

fn digit(value: u8, base: u64, result: *u64) -> bool {
    if (result == null || base < 2) {
        return false;
    }
    if (base > 16) {
        return false;
    }
    var decoded: u64 = 0;
    if (is_decimal_digit(value)) {
        decoded = (value - '0') as u64;
    } else if (value >= 'a' && value <= 'f') {
        decoded = (value - 'a' + 10) as u64;
    } else if (value >= 'A' && value <= 'F') {
        decoded = (value - 'A' + 10) as u64;
    } else {
        return false;
    }
    if (decoded >= base) {
        return false;
    }
    *result = decoded;
    return true;
}

fn trim(view: string_views::string_view) -> string_views::string_view {
    var offset: usize = 0;
    for (; offset < view.length && is_space(view.data[offset]); offset += 1) {}
    var end: usize = view.length;
    for (; end > offset && is_space(view.data[end - 1]); end -= 1) {}
    return {
        data = end == offset ? null as *const u8 : &view.data[offset], length = end - offset,
    };
}

fn equal(view: string_views::string_view, text: *const u8, length: usize) -> bool {
    if (view.length != length) {
        return false;
    }
    let pointer_is_missing: bool = view.data == null || text == null;
    if (length != 0 && pointer_is_missing) {
        return false;
    }
    for (var index: usize = 0; index < length; index += 1) {
        if (view.data[index] != text[index]) {
            return false;
        }
    }
    return true;
}

fn starts_with(view: string_views::string_view, text: *const u8, length: usize) -> bool {
    if (view.length < length) {
        return false;
    }
    let pointer_is_missing: bool = view.data == null || text == null;
    if (length != 0 && pointer_is_missing) {
        return false;
    }
    for (var index: usize = 0; index < length; index += 1) {
        if (view.data[index] != text[index]) {
            return false;
        }
    }
    return true;
}

fn slice(view: string_views::string_view, offset: usize, length: usize) -> string_views::string_view {
    if (offset > view.length || length == 0) {
        return { data = null, length = 0, };
    }
    if (length > view.length - offset) {
        return { data = null, length = 0, };
    }
    return {
        data = &view.data[offset], length = length,
    };
}

fn find(view: string_views::string_view, value: u8) -> usize {
    for (var index: usize = 0; index < view.length; index += 1) {
        if (view.data[index] == value) {
            return index;
        }
    }
    return view.length;
}

fn parse_bits(input: string_views::string_view, result: *u64) -> bool {
    let view: string_views::string_view = trim(input);
    if (view.length == 0 || result == null) {
        return false;
    }
    var offset: usize = 0;
    var negative: bool = false;
    if (view.data[0] == '-') {
        negative = true;
        offset = 1;
        if (offset == view.length) {
            return false;
        }
    }
    var base: u64 = 10;
    let has_prefix: bool = view.length - offset >= 2 && view.data[offset] == '0';
    let hexadecimal_suffix: bool = has_prefix && (view.data[offset + 1] == 'x' || view.data[offset + 1] == 'X');
    if (hexadecimal_suffix) {
        base = 16;
        offset += 2;
        if (offset == view.length) {
            return false;
        }
    }
    var value: u64 = 0;
    for (; offset < view.length; offset += 1) {
        var digit_value: u64 = 0;
        if (!digit(view.data[offset], base, &digit_value) ||
            value > (18446744073709551615 as u64 - digit_value) / base) {
            return false;
        }
        value = value * base + digit_value;
    }
    if (!negative) {
        *result = value;
        return true;
    }
    if (value > 9223372036854775808 as u64) {
        return false;
    }
    if (value == 9223372036854775808 as u64) {
        *result = value;
    } else {
        *result = (-(value as isize)) as u64;
    }
    return true;
}

fn parse_i32(input: string_views::string_view, result: *isize) -> bool {
    let view: string_views::string_view = trim(input);
    var bits: u64 = 0;
    if (!parse_bits(view, &bits) || result == null) {
        return false;
    }
    if (view.data[0] != '-' && bits > 2147483647 as u64) {
        return false;
    }
    let value: isize = bits as isize;
    if (value < -2147483648 || value > 2147483647) {
        return false;
    }
    *result = value;
    return true;
}

fn parse_usize(input: string_views::string_view, result: *usize) -> bool {
    let view: string_views::string_view = trim(input);
    if (result == null || view.length == 0) {
        return false;
    }
    if (view.data[0] == '-') {
        return false;
    }
    var bits: u64 = 0;
    if (!parse_bits(view, &bits)) {
        return false;
    }
    *result = bits as usize;
    return true;
}

fn parse_legacy_register(name: string_views::string_view, result: *Register) -> bool {
    if (result == null) {
        return false;
    }
    var names: [32]*const u8 = {};
    names[0] = "al";
    names[1] = "cl";
    names[2] = "dl";
    names[3] = "bl";
    names[4] = "spl";
    names[5] = "bpl";
    names[6] = "sil";
    names[7] = "dil";
    names[8] = "ax";
    names[9] = "cx";
    names[10] = "dx";
    names[11] = "bx";
    names[12] = "sp";
    names[13] = "bp";
    names[14] = "si";
    names[15] = "di";
    names[16] = "eax";
    names[17] = "ecx";
    names[18] = "edx";
    names[19] = "ebx";
    names[20] = "esp";
    names[21] = "ebp";
    names[22] = "esi";
    names[23] = "edi";
    names[24] = "rax";
    names[25] = "rcx";
    names[26] = "rdx";
    names[27] = "rbx";
    names[28] = "rsp";
    names[29] = "rbp";
    names[30] = "rsi";
    names[31] = "rdi";
    var lengths: [32]usize = {
        2, 2, 2, 2, 3, 3, 3, 3, 2, 2, 2, 2, 2, 2, 2, 2, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3,
    };
    var widths: [4]usize = { 8, 16, 32, 64 };
    for (var index: usize = 0; index < 32; index += 1) {
        if (!equal(name, names[index], lengths[index])) {
            continue;
        }
        result->register_class = RegisterClass.general;
        result->code = (index % 8) as u8;
        result->width = widths[index / 8];
        return true;
    }
    return false;
}

fn parse_register(input: string_views::string_view, result: *Register) -> bool {
    let view: string_views::string_view = trim(input);
    if (result == null) {
        return false;
    }
    if (view.length < 2 || view.data[0] != '%') {
        return false;
    }
    let name: string_views::string_view = slice(view, 1, view.length - 1);
    if (parse_legacy_register(name, result)) {
        return true;
    }
    var vector: bool = false;
    var digit_offset: usize = 0;
    if (starts_with(name, "xmm", 3)) {
        vector = true;
        digit_offset = 3;
    } else if (name.length >= 2 && name.data[0] == 'r') {
        digit_offset = 1;
    } else {
        return false;
    }
    var code: usize = 0;
    let digit_start: usize = digit_offset;
    for (; digit_offset < name.length && is_decimal_digit(name.data[digit_offset]); digit_offset += 1) {
        code = code * 10 + (name.data[digit_offset] - '0') as usize;
        if (code > 15) {
            return false;
        }
    }
    if (digit_offset == digit_start) {
        return false;
    }
    if (vector) {
        if (digit_offset != name.length) {
            return false;
        }
        result->register_class = RegisterClass.vector;
        result->code = code as u8;
        result->width = 128;
        return true;
    }
    if (code < 8) {
        return false;
    }
    var width: usize = 64;
    if (digit_offset < name.length) {
        if (digit_offset + 1 != name.length) {
            return false;
        }
        let suffixes: [3]u8 = { 'b', 'w', 'd' };
        let widths: [3]usize = { 8, 16, 32 };
        var suffix_found: bool = false;
        for (var index: usize = 0; index < 3; index += 1) {
            if (name.data[digit_offset] == suffixes[index]) {
                width = widths[index];
                suffix_found = true;
                break;
            }
        }
        if (!suffix_found) {
            return false;
        }
    }
    result->register_class = RegisterClass.general;
    result->code = code as u8;
    result->width = width;
    return true;
}

fn parse_memory(input: string_views::string_view, result: *Memory) -> bool {
    let view: string_views::string_view = trim(input);
    let open: usize = find(view, '(');
    if (result == null || open == view.length) {
        return false;
    }
    let shape_is_invalid: bool = view.length < open + 3 || view.data[view.length - 1] != ')';
    if (shape_is_invalid) {
        return false;
    }
    *result = empty_memory();
    let displacement: string_views::string_view = trim(slice(view, 0, open));
    let inside: string_views::string_view = slice(view, open + 1, view.length - open - 2);
    var pieces: [3]string_views::string_view = {};
    var piece_count: usize = 0;
    var start: usize = 0;
    for (var index: usize = 0; index <= inside.length; index += 1) {
        if (index == inside.length || inside.data[index] == ',') {
            if (piece_count >= 3) {
                return false;
            }
            pieces[piece_count] = trim(slice(inside, start, index - start));
            piece_count += 1;
            start = index + 1;
        }
    }
    if (piece_count == 0 || pieces[0].length == 0) {
        return false;
    }
    if (equal(pieces[0], "%rip", 4)) {
        if (piece_count != 1 || displacement.length == 0) {
            return false;
        }
        result->rip_relative = true;
        result->symbol = displacement;
        return true;
    }
    let base_is_parsed: bool = parse_register(pieces[0], &result->base);
    let base_has_shape: bool = result->base.register_class == RegisterClass.general && result->base.width == 64;
    if (!base_is_parsed || !base_has_shape) {
        return false;
    }
    if (displacement.length != 0 &&
        !parse_i32(
            displacement, &result->displacement)) {
        return false;
    }
    if (piece_count >= 2 && pieces[1].length != 0) {
        let index_is_parsed: bool = parse_register(pieces[1], &result->index);
        let index_has_shape: bool = result->index.register_class == RegisterClass.general && result->index.width == 64;
        let index_is_encodable: bool = index_has_shape && result->index.code != 4;
        if (!index_is_parsed || !index_is_encodable) {
            return false;
        }
        result->has_index = true;
    }
    if (piece_count == 3) {
        var scale: u64 = 0;
        let scale_is_parsed: bool = result->has_index && parse_bits(pieces[2], &scale);
        let small_scale: bool = scale == 1 || scale == 2;
        let large_scale: bool = scale == 4 || scale == 8;
        let scale_is_valid: bool = small_scale || large_scale;
        if (!scale_is_parsed || !scale_is_valid) {
            return false;
        }
        result->scale = scale as u8;
    }
    return true;
}

fn parse_operand(input: string_views::string_view, result: *Operand) -> bool {
    let trimmed: string_views::string_view = trim(input);
    if (result == null || trimmed.length == 0) {
        return false;
    }
    var view: string_views::string_view = trimmed;
    if (view.data[0] == '*') {
        view = trim(slice(view, 1, view.length - 1));
        if (view.length == 0) {
            return false;
        }
    }
    *result = empty_operand();
    if (view.data[0] == '$') {
        result->kind = OperandKind.immediate;
        return parse_bits(slice(view, 1, view.length - 1), &result->immediate);
    }
    if (view.data[0] == '%') {
        result->kind = OperandKind.register;
        return parse_register(view, &result->register);
    }
    if (find(view, '(') != view.length) {
        result->kind = OperandKind.memory;
        return parse_memory(view, &result->memory);
    }
    result->kind = OperandKind.label;
    result->label = view;
    return true;
}

fn parse_operands(input: string_views::string_view, result: *Operands) -> bool {
    if (result == null) {
        return false;
    }
    *result = empty_operands();
    let text: string_views::string_view = trim(input);
    if (text.length == 0) {
        return true;
    }
    var depth: usize = 0;
    var start: usize = 0;
    for (var index: usize = 0; index <= text.length; index += 1) {
        if (index < text.length && text.data[index] == '(') {
            depth += 1;
        } else if (index < text.length && text.data[index] == ')') {
            if (depth == 0) {
                return false;
            }
            depth -= 1;
        }
        let has_input: bool = index < text.length;
        let has_comma: bool = has_input && text.data[index] == ',';
        let comma_at_top_level: bool = has_comma && depth == 0;
        if (index == text.length || comma_at_top_level) {
            if (result->count >= 3 ||
                !parse_operand(
                    slice(text, start, index - start), &result->values[result->count])) {
                return false;
            }
            result->count += 1;
            start = index + 1;
        }
    }
    return depth == 0;
}

fn is_gpr(operand: *const Operand, width: usize) -> bool {
    if (operand == null) {
        return false;
    }
    let is_general_register: bool = operand->kind == OperandKind.register &&
        operand->register.register_class == RegisterClass.general;
    return is_general_register && operand->register.width == width;
}

fn is_xmm(operand: *const Operand) -> bool {
    if (operand == null) {
        return false;
    }
    return operand->kind == OperandKind.register && operand->register.register_class == RegisterClass.vector;
}

fn is_rm(operand: *const Operand, width: usize) -> bool {
    if (operand == null) {
        return false;
    }
    return operand->kind == OperandKind.memory || is_gpr(operand, width);
}
