module luna.compiler.x86.assembler;

impl SymbolName {
    init(name: text::View) {
        this->name = name;
    }

    operator <(right: SymbolName) const -> bool {
        let shared_length: usize = this->name.length < right.name.length ? this->name.length : right.name.length;
        for (var index: usize = 0; index < shared_length; index += 1) {
            if (this->name.data[index] != right.name.data[index]) {
                return this->name.data[index] < right.name.data[index];
            }
        }
        return this->name.length < right.name.length;
    }
}

impl SymbolTable {
    init(): symbols_by_name = map::map<SymbolName, SymbolBinding>() {
    }

    fn is_valid() const -> bool {
        return this->symbols_by_name.is_valid();
    }

    fn size() const -> usize {
        return this->symbols_by_name.size();
    }

    fn find(name: text::View) const -> object::IndexResult {
        if (!text::is_valid_utf8(name) || name.length == 0) {
            return { index = 0, found = false, error = runtime::Error.invalid_argument };
        }
        let binding: *const SymbolBinding = this->symbols_by_name.find(SymbolName(name));
        if (binding == null || !binding->materialized) {
            return { index = 0, found = false, error = runtime::Error.none };
        }
        return { index = binding->index, found = true, error = runtime::Error.none };
    }

    fn reference(name: text::View) -> SymbolBindingResult {
        if (!text::is_valid_utf8(name) || name.length == 0) {
            return { binding = null, error = runtime::Error.invalid_argument };
        }
        let existing: *SymbolBinding = this->symbols_by_name.find(SymbolName(name));
        if (existing != null) {
            return { binding = existing, error = runtime::Error.none };
        }
        let binding: SymbolBinding = { name = name, index = 0, materialized = false };
        let inserted: map::map_insert_result<SymbolBinding> = this->symbols_by_name.insert(SymbolName(name), binding);
        if (inserted.error != runtime::Error.none) {
            return { binding = null, error = inserted.error };
        }
        return { binding = inserted.value, error = runtime::Error.none };
    }

    fn materialize(storage: *object::Object, binding: *SymbolBinding) -> object::IndexResult {
        if (binding == null) {
            return { index = 0, found = false, error = runtime::Error.invalid_argument };
        }
        if (binding->materialized) {
            return { index = binding->index, found = true, error = runtime::Error.none };
        }
        let appended: object::IndexResult = object::append_symbol(storage, binding->name);
        if (appended.error != runtime::Error.none) {
            return appended;
        }
        binding->index = appended.index;
        binding->materialized = true;
        return appended;
    }

    deinit() {
    }
}
