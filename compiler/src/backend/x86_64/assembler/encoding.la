module luna.bootstrap.backend.x86_64.assembler.encoding;

fn fail(assembler: *State, error: runtime::Error) -> bool {
    if (assembler != null && assembler->error == runtime::Error.none) {
        assembler->error = error;
    }
    return false;
}

fn section_buffer(assembler: *State) -> *bytes::Buffer {
    if (assembler == null) {
        return null;
    }
    if (assembler->section == object::Section.text) {
        return &assembler->object.text;
    }
    if (assembler->section == object::Section.rodata) {
        return &assembler->object.rodata;
    }
    if (assembler->section == object::Section.data) {
        return &assembler->object.data;
    }
    return null;
}

fn append_u8(assembler: *State, value: u8) -> bool {
    if (assembler == null ||
        !object::append_u8(
            &assembler->object, assembler->section, value)) {
        return fail(assembler, assembler == null ? runtime::Error.invalid_argument : assembler->object.error);
    }
    return true;
}

fn append_u16(assembler: *State, value: u16) -> bool {
    return append_u8(assembler, (value & 255) as u8) && append_u8(assembler, ((value >> 8) & 255) as u8);
}

fn append_u32(assembler: *State, value: u32) -> bool {
    var index: usize = 0;
    while (index < 4) {
        if (!append_u8(
                assembler, ((value >> ((index * 8) as u32)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn append_u64(assembler: *State, value: u64) -> bool {
    var index: usize = 0;
    while (index < 8) {
        if (!append_u8(
                assembler, ((value >> ((index * 8) as u64)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn append_opcode(assembler: *State, first: u8, second: u8, count: usize) -> bool {
    return count >= 1 && append_u8(assembler, first) && (count == 1 || append_u8(assembler, second));
}

fn numeric_reference(target: text::View, number: *usize, forward: *bool) -> bool {
    if (target.length < 2 || number == null || forward == null) {
        return false;
    }
    let suffix: u8 = target.data[target.length - 1];
    if (suffix != 'f' && suffix != 'b') {
        return false;
    }
    var value: usize = 0;
    var index: usize = 0;
    while (index + 1 < target.length) {
        let digit: u8 = target.data[index];
        if (!operands::is_decimal_digit(digit) ||
            value > (18446744073709551615 as usize - (digit - '0') as usize) / 10) {
            return false;
        }
        value = value * 10 + (digit - '0') as usize;
        index += 1;
    }
    *number = value;
    *forward = suffix == 'f';
    return true;
}

fn add_fixup(assembler: *State, target: text::View, offset: usize, kind: FixupKind) -> bool {
    if (assembler == null || assembler->fixups.length / sizeof(Fixup) >= Limit.maximum_fixups as usize) {
        return fail(assembler, runtime::Error.out_of_memory);
    }
    var fixup: Fixup = {
        target = target, section = assembler->section, offset = offset, line = assembler->line, kind = kind,
        numeric_label = 0, numeric_forward = false, is_numeric = false,
    };
    fixup.is_numeric = numeric_reference(target, &fixup.numeric_label, &fixup.numeric_forward);
    let appended: bytes::BufferResult = bytes::append(
        assembler->fixups, (&fixup) as *const Fixup as *const u8, sizeof(Fixup));
    assembler->fixups = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return fail(assembler, appended.error);
    }
    return true;
}

fn append_symbol_address(assembler: *State, target: text::View) -> bool {
    let output: *bytes::Buffer = section_buffer(assembler);
    if (assembler == null || assembler->section != object::Section.rodata) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    if (output == null || !add_fixup(assembler, target, output->length, FixupKind.absolute64)) {
        return false;
    }
    return append_u64(assembler, 0);
}

fn rex_for_rm(operand: *const operands::Operand) -> u8 {
    if (operand->kind == operands::OperandKind.register) {
        return operand->register.code >= 8 ? 1 : 0;
    }
    if (operand->kind != operands::OperandKind.memory || operand->memory.rip_relative) {
        return 0;
    }
    var rex: u8 = operand->memory.base.code >= 8 ? 1 : 0;
    if (operand->memory.has_index && operand->memory.index.code >= 8) {
        rex |= 2;
    }
    return rex;
}

fn emit_prefix_opcode(
    assembler: *State, legacy_prefix: u8, rex_w: bool, force_rex: bool, reg_field: u8,
    rm: *const operands::Operand, opcode_first: u8, opcode_second: u8, opcode_count: usize) -> bool {
    if (legacy_prefix != 0 &&
        !append_u8(
            assembler, legacy_prefix)) {
        return false;
    }
    var rex: u8 = 64;
    if (rex_w) {
        rex |= 8;
    }
    if (reg_field >= 8) {
        rex |= 4;
    }
    rex |= rex_for_rm(rm);
    if ((rex != 64 || force_rex) && !append_u8(assembler, rex)) {
        return false;
    }
    return append_opcode(assembler, opcode_first, opcode_second, opcode_count);
}

fn emit_modrm(assembler: *State, reg_field: u8, rm: *const operands::Operand) -> bool {
    if (rm->kind == operands::OperandKind.register) {
        return append_u8(assembler, ((192 as u8) | ((reg_field & 7) << 3) | (rm->register.code & 7)) as u8);
    }
    if (rm->kind != operands::OperandKind.memory) {
        return false;
    }
    if (rm->memory.rip_relative) {
        let modrm: u8 = (((reg_field & 7) << 3) | 5) as u8;
        if (!append_u8(assembler, modrm)) {
            return false;
        }
        let output: *bytes::Buffer = section_buffer(assembler);
        return output != null && add_fixup(assembler, rm->memory.symbol, output->length, FixupKind.rip_relative) &&
            append_u32(assembler, 0);
    }
    let base: u8 = rm->memory.base.code & 7;
    var mode: u8 = 0;
    if (rm->memory.displacement == 0 && base != 5) {
        mode = 0;
    } else if (rm->memory.displacement >= -128 && rm->memory.displacement <= 127) {
        mode = 1;
    } else {
        mode = 2;
    }
    let sib_required: bool = base == 4 || rm->memory.has_index;
    let rm_field: u8 = sib_required ? 4 : base;
    if (!append_u8(
            assembler, ((mode << 6) | ((reg_field & 7) << 3) | rm_field) as u8)) {
        return false;
    }
    if (sib_required) {
        var scale_bits: u8 = 0;
        if (rm->memory.scale == 2) {
            scale_bits = 1;
        } else if (rm->memory.scale == 4) {
            scale_bits = 2;
        } else if (rm->memory.scale == 8) {
            scale_bits = 3;
        }
        let index: u8 = rm->memory.has_index ? rm->memory.index.code & 7 : 4;
        if (!append_u8(
                assembler, ((scale_bits << 6) | (index << 3) | base) as u8)) {
            return false;
        }
    }
    if (mode == 1) {
        return append_u8(assembler, rm->memory.displacement as u8);
    }
    if (mode == 2) {
        return append_u32(assembler, rm->memory.displacement as u32);
    }
    return true;
}

fn emit_rm(
    assembler: *State, legacy_prefix: u8, rex_w: bool, force_rex: bool, opcode_first: u8,
    opcode_second: u8, opcode_count: usize, reg_field: u8, rm: *const operands::Operand) -> bool {
    return emit_prefix_opcode(
            assembler, legacy_prefix, rex_w, force_rex, reg_field, rm, opcode_first, opcode_second, opcode_count) &&
        emit_modrm(assembler, reg_field, rm);
}

fn emit_relative(
    assembler: *State, opcode_first: u8, opcode_second: u8, opcode_count: usize,
    operands: *const operands::Operands, kind: FixupKind) -> bool {
    if (operands->count != 1 || operands->values[0].kind != operands::OperandKind.label ||
        !append_opcode(
            assembler, opcode_first, opcode_second, opcode_count)) {
        return false;
    }
    let output: *bytes::Buffer = section_buffer(assembler);
    return output != null && add_fixup(assembler, operands->values[0].label, output->length, kind) &&
        append_u32(assembler, 0);
}

fn emit_indirect_transfer(assembler: *State, operand: *const operands::Operand, reg_field: u8) -> bool {
    let code: u8 = operand->register.code;
    return (code < 8 || append_u8(assembler, 65)) && append_u8(assembler, 255) &&
        append_u8(assembler, ((192 as u8) | ((reg_field & 7) << 3) | (code & 7)) as u8);
}

fn fits_i32(bits: u64) -> bool {
    let value: isize = bits as isize;
    return value >= -2147483648 && value <= 2147483647;
}

fn fits_u32(bits: u64) -> bool {
    return bits <= 4294967295 as u64 || fits_i32(bits);
}

fn fits_u16(bits: u64) -> bool {
    let value: isize = bits as isize;
    return bits <= 65535 as u64 || (value >= -32768 && value <= 32767);
}

fn fits_u8(bits: u64) -> bool {
    let value: isize = bits as isize;
    return bits <= 255 as u64 || (value >= -128 && value <= 127);
}

fn emit_binary_alu(
    assembler: *State, operands: *const operands::Operands, width: usize, register_opcode: u8,
        immediate_group: u8) -> bool {
    if (operands->count != 2 || !operands::is_rm(&operands->values[1], width)) {
        return false;
    }
    let source: *const operands::Operand = &operands->values[0];
    let destination: *const operands::Operand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == operands::OperandKind.immediate) {
        if ((width == 64 && !fits_i32(source->immediate)) || (width == 32 &&
                !fits_u32(source->immediate)) || (width == 16 && !fits_u16(source->immediate)) || (width == 8 &&
                !fits_u8(source->immediate))) {
            return false;
        }
        if (!emit_rm(
                assembler, legacy, rex_w, byte && destination->kind == operands::OperandKind.register &&
                    destination->register.code >= 4, byte ? 128 : 129, 0, 1, immediate_group, destination)) {
            return false;
        }
        if (byte) {
            return append_u8(assembler, source->immediate as u8);
        }
        if (word) {
            return append_u16(assembler, source->immediate as u16);
        }
        return append_u32(assembler, source->immediate as u32);
    }
    if (!operands::is_gpr(source, width)) {
        return false;
    }
    return emit_rm(
        assembler, legacy, rex_w, byte && (source->register.code >= 4 || (destination->kind ==
                operands::OperandKind.register && destination->register.code >= 4)), register_opcode, 0, 1,
        source->register.code, destination);
}

fn emit_move(assembler: *State, operands: *const operands::Operands, width: usize) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const operands::Operand = &operands->values[0];
    let destination: *const operands::Operand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == operands::OperandKind.immediate) {
        if (!operands::is_rm(destination, width) || (width == 64 && !fits_i32(source->immediate)) || (width == 32 &&
                !fits_u32(source->immediate)) || (width == 16 && !fits_u16(source->immediate)) || (width == 8 &&
                !fits_u8(source->immediate))) {
            return false;
        }
        if (!emit_rm(
                assembler, legacy, rex_w, byte && destination->kind == operands::OperandKind.register &&
                    destination->register.code >= 4, byte ? 198 : 199, 0, 1, 0, destination)) {
            return false;
        }
        if (byte) {
            return append_u8(assembler, source->immediate as u8);
        }
        if (word) {
            return append_u16(assembler, source->immediate as u16);
        }
        return append_u32(assembler, source->immediate as u32);
    }
    if (operands::is_gpr(source, width) && operands::is_rm(destination, width)) {
        return emit_rm(
            assembler, legacy, rex_w, byte && (source->register.code >= 4 || (destination->kind ==
                    operands::OperandKind.register && destination->register.code >= 4)), byte ? 136 : 137, 0, 1,
            source->register.code, destination);
    }
    if (source->kind == operands::OperandKind.memory && operands::is_gpr(destination, width)) {
        return emit_rm(
            assembler, legacy, rex_w, byte && destination->register.code >= 4, byte ? 138 : 139, 0, 1,
            destination->register.code, source);
    }
    return false;
}

fn emit_xmm_move(assembler: *State, operands: *const operands::Operands, double_precision: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const operands::Operand = &operands->values[0];
    let destination: *const operands::Operand = &operands->values[1];
    let prefix: u8 = double_precision ? 242 : 243;
    if (operands::is_xmm(destination) && (operands::is_xmm(source) || source->kind == operands::OperandKind.memory)) {
        return emit_rm(assembler, prefix, false, false, 15, 16, 2, destination->register.code, source);
    }
    if (operands::is_xmm(source) && destination->kind == operands::OperandKind.memory) {
        return emit_rm(assembler, prefix, false, false, 15, 17, 2, source->register.code, destination);
    }
    return false;
}

fn emit_movd_or_movq(assembler: *State, operands: *const operands::Operands, quad: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const operands::Operand = &operands->values[0];
    let destination: *const operands::Operand = &operands->values[1];
    let width: usize = quad ? 64 : 32;
    if (operands::is_gpr(source, width) && operands::is_xmm(destination)) {
        return emit_rm(assembler, 102, quad, false, 15, 110, 2, destination->register.code, source);
    }
    if (operands::is_xmm(source) && operands::is_gpr(destination, width)) {
        return emit_rm(assembler, 102, quad, false, 15, 126, 2, source->register.code, destination);
    }
    if (quad && operands::is_xmm(source) && destination->kind == operands::OperandKind.memory) {
        return emit_rm(assembler, 102, false, false, 15, 214, 2, source->register.code, destination);
    }
    if (quad && operands::is_xmm(destination) && (source->kind == operands::OperandKind.memory ||
        operands::is_xmm(source))) {
        return emit_rm(assembler, 243, false, false, 15, 126, 2, destination->register.code, source);
    }
    return false;
}

fn emit_extend(
    assembler: *State, operands: *const operands::Operands, source_width: usize,
    destination_width: usize, sign_extend: bool) -> bool {
    if (operands->count != 2 || !(operands->values[0].kind == operands::OperandKind.memory ||
          operands::is_gpr(
            &operands->values[0], source_width)) ||
        !operands::is_gpr(
            &operands->values[1], destination_width)) {
        return false;
    }
    let second: u8 = source_width == 8 ? (sign_extend ? 190 : 182) : source_width == 16 ? (sign_extend ? 191 : 183) : 0;
    if (second == 0) {
        return false;
    }
    return emit_rm(
        assembler, 0, destination_width == 64, operands->values[0].kind == operands::OperandKind.register &&
            source_width == 8 && operands->values[0].register.code >= 4, 15, second, 2,
        operands->values[1].register.code, &operands->values[0]);
}

fn emit_unary(assembler: *State, operands: *const operands::Operands, width: usize, group: u8) -> bool {
    return operands->count == 1 && (operands->values[0].kind == operands::OperandKind.memory ||
         operands::is_gpr(&operands->values[0], width)) &&
        emit_rm(assembler, width == 16 ? 102 : 0, width == 64, false, 247, 0, 1, group, &operands->values[0]);
}

fn emit_shift(assembler: *State, operands: *const operands::Operands, width: usize, group: u8) -> bool {
    if (operands->count != 2 || !operands::is_gpr(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == operands::OperandKind.immediate && operands->values[0].immediate <= 255) {
        return emit_rm(assembler, 0, width == 64, false, 193, 0, 1, group, &operands->values[1]) &&
            append_u8(assembler, operands->values[0].immediate as u8);
    }
    return operands::is_gpr(&operands->values[0], 8) && operands->values[0].register.code == 1 &&
        emit_rm(assembler, 0, width == 64, false, 211, 0, 1, group, &operands->values[1]);
}

fn condition(name: text::View, result: *u8) -> bool {
    if (result == null) {
        return false;
    }
    if (operands::equal(name, "o", 1)) {
        *result = 0;
    } else if (operands::equal(name, "no", 2)) {
        *result = 1;
    } else if (operands::equal(name, "b", 1) || operands::equal(name, "c", 1) || operands::equal(name, "nae", 3)) {
        *result = 2;
    } else if (operands::equal(name, "ae", 2) || operands::equal(name, "nb", 2) || operands::equal(name, "nc", 2)) {
        *result = 3;
    } else if (operands::equal(name, "e", 1) || operands::equal(name, "z", 1)) {
        *result = 4;
    } else if (operands::equal(name, "ne", 2) || operands::equal(name, "nz", 2)) {
        *result = 5;
    } else if (operands::equal(name, "be", 2) || operands::equal(name, "na", 2)) {
        *result = 6;
    } else if (operands::equal(name, "a", 1) || operands::equal(name, "nbe", 3)) {
        *result = 7;
    } else if (operands::equal(name, "s", 1)) {
        *result = 8;
    } else if (operands::equal(name, "ns", 2)) {
        *result = 9;
    } else if (operands::equal(name, "p", 1) || operands::equal(name, "pe", 2)) {
        *result = 10;
    } else if (operands::equal(name, "np", 2) || operands::equal(name, "po", 2)) {
        *result = 11;
    } else if (operands::equal(name, "l", 1) || operands::equal(name, "nge", 3)) {
        *result = 12;
    } else if (operands::equal(name, "ge", 2) || operands::equal(name, "nl", 2)) {
        *result = 13;
    } else if (operands::equal(name, "le", 2) || operands::equal(name, "ng", 2)) {
        *result = 14;
    } else if (operands::equal(name, "g", 1) || operands::equal(name, "nle", 3)) {
        *result = 15;
    } else {
        return false;
    }
    return true;
}

fn emit_set(assembler: *State, operands: *const operands::Operands, condition: u8) -> bool {
    return operands->count == 1 && operands::is_gpr(&operands->values[0], 8) &&
        emit_rm(
            assembler, 0, false, operands->values[0].register.code >= 4, 15, ((144 as u8) | condition) as u8, 2, 0,
            &operands->values[0]);
}

fn emit_sse_binary(assembler: *State, operands: *const operands::Operands, prefix: u8, operation: u8) -> bool {
    return operands->count == 2 && (operands::is_xmm(&operands->values[0]) || operands->values[0].kind ==
            operands::OperandKind.memory) && operands::is_xmm(&operands->values[1]) &&
        emit_rm(
            assembler, prefix, false, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

fn emit_conversion(
    assembler: *State, operands: *const operands::Operands, prefix: u8, operation: u8, rex_w: bool,
    source_xmm: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    if (source_xmm) {
        if (!(operands::is_xmm(&operands->values[0]) || operands->values[0].kind == operands::OperandKind.memory) ||
            !operands::is_gpr(
                &operands->values[1], rex_w ? 64 : 32)) {
            return false;
        }
    } else if (!(operands::is_gpr(&operands->values[0], rex_w ? 64 : 32) ||
        operands->values[0].kind == operands::OperandKind.memory) || !operands::is_xmm(&operands->values[1])) {
        return false;
    }
    return emit_rm(
        assembler, prefix, rex_w, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

fn emit_compare(assembler: *State, operands: *const operands::Operands, width: usize, compare: bool) -> bool {
    if (operands->count != 2 || !operands::is_rm(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == operands::OperandKind.immediate) {
        if (!compare || (width == 64 && !fits_i32(operands->values[0].immediate)) || (width == 32 &&
                !fits_u32(operands->values[0].immediate)) || (width == 8 &&
                !fits_u8(
                    operands->values[0].immediate))) {
            return false;
        }
        let byte: bool = width == 8;
        if (!emit_rm(
                assembler, 0, width == 64, byte && operands->values[1].kind == operands::OperandKind.register &&
                    operands->values[1].register.code >= 4, byte ? 128 : 129, 0, 1, 7, &operands->values[1])) {
            return false;
        }
        return byte ? append_u8(assembler, operands->values[0].immediate as u8) :
            append_u32(assembler, operands->values[0].immediate as u32);
    }
    if (!operands::is_gpr(&operands->values[0], width)) {
        return false;
    }
    let opcode: u8 = compare ? (width == 8 ? 56 : 57) : (width == 8 ? 132 : 133);
    return emit_rm(
        assembler, 0, width == 64, width == 8 && (operands->values[0].register.code >= 4 || (operands->values[1].kind ==
                operands::OperandKind.register && operands->values[1].register.code >= 4)), opcode, 0, 1,
        operands->values[0].register.code, &operands->values[1]);
}

fn emit_imul(assembler: *State, operands: *const operands::Operands, width: usize) -> bool {
    if (operands->count == 2 && (operands::is_gpr(&operands->values[0], width) || operands->values[0].kind ==
            operands::OperandKind.memory) && operands::is_gpr(&operands->values[1], width)) {
        return emit_rm(
            assembler, 0, width == 64, false, 15, 175, 2, operands->values[1].register.code, &operands->values[0]);
    }
    if (operands->count == 3 && operands->values[0].kind == operands::OperandKind.immediate &&
        fits_i32(operands->values[0].immediate) && (operands::is_gpr(&operands->values[1], width) ||
            operands->values[1].kind ==
            operands::OperandKind.memory) && operands::is_gpr(&operands->values[2], width)) {
        return emit_rm(
                assembler, 0, width == 64, false, 105, 0, 1, operands->values[2].register.code, &operands->values[1]) &&
            append_u32(assembler, operands->values[0].immediate as u32);
    }
    return false;
}

fn encode(assembler: *State, mnemonic: text::View, raw_operands: text::View,
    operands: *const operands::Operands) -> bool {
    if (operands::equal(mnemonic, "cld", 3)) {
        return operands->count == 0 && append_u8(assembler, 252);
    }
    if (operands::equal(mnemonic, "std", 3)) {
