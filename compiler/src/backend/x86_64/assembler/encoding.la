module luna.compiler.x86.assembler;

impl Assembler {

    priv fn fail(error: runtime::Error) -> bool {
        if (this->error_code == runtime::Error.none) {
            this->error_code = error;
        }
        return false;
    }

    priv fn section_is_active() const -> bool {
        switch (this->current_section) {
        case object::Section.text, object::Section.rodata, object::Section.data {
            return true;
        }
        default {
            return false;
        }
        }
    }

    priv fn append_u8(value: u8) -> bool {
        if (!this->storage.append_u8(this->current_section, value)) {
            return this->fail(this->storage.error());
        }
        return true;
    }

    priv fn append_u16(value: u16) -> bool {
    return this->append_u8((value & 255) as u8) && this->append_u8(((value >> 8) & 255) as u8);
}

    priv fn append_u32(value: u32) -> bool {
    for (var index: usize = 0; index < 4; index += 1) {
        if (!this->append_u8(((value >> ((index * 8) as u32)) & 255) as u8)) {
            return false;
        }
    }
    return true;
}

    priv fn append_u64(value: u64) -> bool {
    for (var index: usize = 0; index < 8; index += 1) {
        if (!this->append_u8(((value >> ((index * 8) as u64)) & 255) as u8)) {
            return false;
        }
    }
    return true;
}

    priv fn append_opcode(first: u8, second: u8, count: usize) -> bool {
    if (count == 0 || count > 2) {
        return false;
    }
    if (!this->append_u8(first)) {
        return false;
    }
    return count == 1 || this->append_u8(second);
}

    priv fn numeric_reference(target: string_views::string_view, number: *usize, forward: *bool) -> bool {
    let output_is_valid: bool = number != null && forward != null;
    if (target.length < 2 || !output_is_valid) {
        return false;
    }
    let suffix: u8 = target.data[target.length - 1];
    if (suffix != 'f' && suffix != 'b') {
        return false;
    }
    var value: usize = 0;
    for (var index: usize = 0; index + 1 < target.length; index += 1) {
        let digit: u8 = target.data[index];
        if (!is_decimal_digit(digit) || value > (18446744073709551615 as usize - (digit - '0') as usize) / 10) {
            return false;
        }
        value = value * 10 + (digit - '0') as usize;
    }
    *number = value;
    *forward = suffix == 'f';
    return true;
}

    priv fn bind_symbol_fixup(fixup: *Fixup, target: string_views::string_view) -> bool {
    let symbol: SymbolBindingResult = this->symbols.reference(target);
    if (symbol.error != runtime::Error.none || symbol.binding == null) {
        let error: runtime::Error = symbol.error == runtime::Error.none ? runtime::Error.invalid_argument :
            symbol.error;
        return this->fail(error);
    }
    fixup->symbol = symbol.binding;
    return true;
}

    priv fn add_fixup(target: string_views::string_view, offset: usize, kind: FixupKind) -> bool {
    if (this->fixups.size() >= Limit.maximum_fixups as usize) {
        return this->fail(runtime::Error.out_of_memory);
    }
    var fixup: Fixup = {
        section = this->current_section, offset = offset, line = this->current_line, kind = kind, symbol = null,
        numeric_label = 0, numeric_forward = false, is_numeric = false,
    };
    fixup.is_numeric = this->numeric_reference(target, &fixup.numeric_label, &fixup.numeric_forward);
    if (!fixup.is_numeric && !this->bind_symbol_fixup(&fixup, target)) {
        return false;
    }
    let error: runtime::Error = this->fixups.push_back(fixup);
    if (error != runtime::Error.none) {
        return this->fail(error);
    }
    return true;
}

    priv fn append_symbol_address(target: string_views::string_view) -> bool {
    if (this->current_section != object::Section.rodata) {
        return this->fail(runtime::Error.invalid_argument);
    }
    if (!this->add_fixup(target, this->storage.section_size(this->current_section), FixupKind.absolute64)) {
        return false;
    }
    return this->append_u64(0);
}

    priv fn rex_for_rm(operand: *const Operand) -> u8 {
    if (operand->kind == OperandKind.register) {
        return operand->register.code >= 8 ? 1 : 0;
    }
    if (operand->kind != OperandKind.memory || operand->memory.rip_relative) {
        return 0;
    }
    var rex: u8 = operand->memory.base.code >= 8 ? 1 : 0;
    if (operand->memory.has_index && operand->memory.index.code >= 8) {
        rex |= 2;
    }
    return rex;
}

    priv fn emit_prefix_opcode(
    legacy_prefix: u8, rex_w: bool, force_rex: bool, reg_field: u8,
    rm: *const Operand, opcode_first: u8, opcode_second: u8, opcode_count: usize) -> bool {
    if (legacy_prefix != 0 && !this->append_u8(legacy_prefix)) {
        return false;
    }
    var rex: u8 = 64;
    if (rex_w) {
        rex |= 8;
    }
    if (reg_field >= 8) {
        rex |= 4;
    }
    rex |= this->rex_for_rm(rm);
    let needs_rex: bool = rex != 64 || force_rex;
    if (needs_rex && !this->append_u8(rex)) {
        return false;
    }
    return this->append_opcode(opcode_first, opcode_second, opcode_count);
}

    priv fn emit_modrm(reg_field: u8, rm: *const Operand) -> bool {
    if (rm->kind == OperandKind.register) {
        return this->append_u8(((192 as u8) | ((reg_field & 7) << 3) | (rm->register.code & 7)) as u8);
    }
    if (rm->kind != OperandKind.memory) {
        return false;
    }
    if (rm->memory.rip_relative) {
        let modrm: u8 = (((reg_field & 7) << 3) | 5) as u8;
        if (!this->append_u8(modrm)) {
            return false;
        }
        if (!this->section_is_active()) {
            return false;
        }
        let offset: usize = this->storage.section_size(this->current_section);
        if (!this->add_fixup(rm->memory.symbol, offset, FixupKind.rip_relative)) {
            return false;
        }
        return this->append_u32(0);
    }
    let base: u8 = rm->memory.base.code & 7;
    var mode: u8 = 0;
    if (rm->memory.displacement == 0 && base != 5) {
        mode = 0;
    } else if (rm->memory.displacement >= -128 && rm->memory.displacement <= 127) {
        mode = 1;
    } else {
        mode = 2;
    }
    let sib_required: bool = base == 4 || rm->memory.has_index;
    let rm_field: u8 = sib_required ? 4 : base;
    if (!this->append_u8(((mode << 6) | ((reg_field & 7) << 3) | rm_field) as u8)) {
        return false;
    }
    if (sib_required) {
        var scale_bits: u8 = 0;
        if (rm->memory.scale == 2) {
            scale_bits = 1;
        } else if (rm->memory.scale == 4) {
            scale_bits = 2;
        } else if (rm->memory.scale == 8) {
            scale_bits = 3;
        }
        let index: u8 = rm->memory.has_index ? rm->memory.index.code & 7 : 4;
        if (!this->append_u8(((scale_bits << 6) | (index << 3) | base) as u8)) {
            return false;
        }
    }
    if (mode == 1) {
        return this->append_u8(rm->memory.displacement as u8);
    }
    if (mode == 2) {
        return this->append_u32(rm->memory.displacement as u32);
    }
    return true;
}

    priv fn emit_rm(
    legacy_prefix: u8, rex_w: bool, force_rex: bool, opcode_first: u8,
    opcode_second: u8, opcode_count: usize, reg_field: u8, rm: *const Operand) -> bool {
    return this->emit_prefix_opcode(legacy_prefix, rex_w, force_rex, reg_field, rm, opcode_first, opcode_second,
        opcode_count) && this->emit_modrm(reg_field, rm);
}

    priv fn emit_relative(
    opcode_first: u8, opcode_second: u8, opcode_count: usize, operands: *const Operands, kind: FixupKind) -> bool {
    if (operands->count != 1 || operands->values[0].kind != OperandKind.label) {
        return false;
    }
    if (!this->append_opcode(opcode_first, opcode_second, opcode_count)) {
        return false;
    }
    if (!this->section_is_active()) {
        return false;
    }
    let offset: usize = this->storage.section_size(this->current_section);
    if (!this->add_fixup(operands->values[0].label, offset, kind)) {
        return false;
    }
    return this->append_u32(0);
}

    priv fn emit_indirect_transfer(operand: *const Operand, reg_field: u8) -> bool {
    let code: u8 = operand->register.code;
    if (code >= 8 && !this->append_u8(65)) {
        return false;
    }
    if (!this->append_u8(255)) {
        return false;
    }
    return this->append_u8(((192 as u8) | ((reg_field & 7) << 3) | (code & 7)) as u8);
}

    priv fn fits_i32(bits: u64) -> bool {
    let value: isize = bits as isize;
    return value >= -2147483648 && value <= 2147483647;
}

    priv fn fits_u32(bits: u64) -> bool {
    return bits <= 4294967295 as u64 || this->fits_i32(bits);
}

    priv fn fits_u16(bits: u64) -> bool {
    let value: isize = bits as isize;
    let signed_fits: bool = value >= -32768 && value <= 32767;
    return bits <= 65535 as u64 || signed_fits;
}

    priv fn fits_u8(bits: u64) -> bool {
    let value: isize = bits as isize;
    let signed_fits: bool = value >= -128 && value <= 127;
    return bits <= 255 as u64 || signed_fits;
}

    priv fn immediate_fits(width: usize, bits: u64) -> bool {
        switch (width) {
        case 8 {
            return this->fits_u8(bits);
        }
        case 16 {
            return this->fits_u16(bits);
        }
        case 32 {
            return this->fits_u32(bits);
        }
        case 64 {
            return this->fits_i32(bits);
        }
        default {
            return false;
        }
        }
    }

    priv fn force_byte_rex(operand: *const Operand) -> bool {
        return operand->kind == OperandKind.register && operand->register.code >= 4;
    }

    priv fn is_memory_or_gpr(operand: *const Operand, width: usize) -> bool {
        return operand->kind == OperandKind.memory || is_gpr(operand, width);
    }

    priv fn is_memory_or_xmm(operand: *const Operand) -> bool {
        return operand->kind == OperandKind.memory || is_xmm(operand);
    }

    priv fn emit_binary_alu(operands: *const Operands, width: usize, register_opcode: u8, immediate_group: u8) -> bool {
    if (operands->count != 2 || !is_rm(&operands->values[1], width)) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == OperandKind.immediate) {
        if (!this->immediate_fits(width, source->immediate)) {
            return false;
        }
        let force_rex: bool = byte && this->force_byte_rex(destination);
        if (!this->emit_rm(
                legacy, rex_w, force_rex, byte ? 128 : 129, 0, 1, immediate_group, destination)) {
            return false;
        }
        if (byte) {
            return this->append_u8(source->immediate as u8);
        }
        if (word) {
            return this->append_u16(source->immediate as u16);
        }
        return this->append_u32(source->immediate as u32);
    }
    if (!is_gpr(source, width)) {
        return false;
    }
    let high_source: bool = source->register.code >= 4;
    let high_destination: bool = this->force_byte_rex(destination);
    let high_register: bool = high_source || high_destination;
    let force_rex: bool = byte && high_register;
    return this->emit_rm(legacy, rex_w, force_rex, register_opcode, 0, 1, source->register.code, destination);
}

    priv fn emit_move(operands: *const Operands, width: usize) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == OperandKind.immediate) {
        if (!is_rm(destination, width) || !this->immediate_fits(width, source->immediate)) {
            return false;
        }
        let force_rex: bool = byte && this->force_byte_rex(destination);
        if (!this->emit_rm(legacy, rex_w, force_rex, byte ? 198 : 199, 0, 1, 0, destination)) {
            return false;
        }
        if (byte) {
            return this->append_u8(source->immediate as u8);
        }
        if (word) {
            return this->append_u16(source->immediate as u16);
        }
        return this->append_u32(source->immediate as u32);
    }
    if (is_gpr(source, width) && is_rm(destination, width)) {
        let high_source: bool = source->register.code >= 4;
        let high_destination: bool = this->force_byte_rex(destination);
        let high_register: bool = high_source || high_destination;
        let force_rex: bool = byte && high_register;
        return this->emit_rm(legacy, rex_w, force_rex, byte ? 136 : 137, 0, 1, source->register.code, destination);
    }
    if (source->kind == OperandKind.memory && is_gpr(destination, width)) {
        let force_rex: bool = byte && destination->register.code >= 4;
        return this->emit_rm(legacy, rex_w, force_rex, byte ? 138 : 139, 0, 1, destination->register.code, source);
    }
    return false;
}

    priv fn emit_xmm_move(operands: *const Operands, double_precision: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let prefix: u8 = double_precision ? 242 : 243;
    if (is_xmm(destination) && this->is_memory_or_xmm(source)) {
        return this->emit_rm(prefix, false, false, 15, 16, 2, destination->register.code, source);
    }
    if (is_xmm(source) && destination->kind == OperandKind.memory) {
        return this->emit_rm(prefix, false, false, 15, 17, 2, source->register.code, destination);
    }
    return false;
}

    priv fn emit_movd_or_movq(operands: *const Operands, quad: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let width: usize = quad ? 64 : 32;
    if (is_gpr(source, width) && is_xmm(destination)) {
        return this->emit_rm(102, quad, false, 15, 110, 2, destination->register.code, source);
    }
    if (is_xmm(source) && is_gpr(destination, width)) {
        return this->emit_rm(102, quad, false, 15, 126, 2, source->register.code, destination);
    }
    let xmm_to_memory: bool = is_xmm(source) && destination->kind == OperandKind.memory;
    if (quad && xmm_to_memory) {
        return this->emit_rm(102, false, false, 15, 214, 2, source->register.code, destination);
    }
    let memory_or_xmm: bool = this->is_memory_or_xmm(source);
    let xmm_destination: bool = is_xmm(destination) && memory_or_xmm;
    if (quad && xmm_destination) {
        return this->emit_rm(243, false, false, 15, 126, 2, destination->register.code, source);
    }
    return false;
}

    priv fn emit_extend(
    operands: *const Operands, source_width: usize, destination_width: usize, sign_extend: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source_is_valid: bool = this->is_memory_or_gpr(&operands->values[0], source_width);
    if (!source_is_valid || !is_gpr(&operands->values[1], destination_width)) {
        return false;
    }
    let second: u8 = source_width == 8 ? (sign_extend ? 190 : 182) : source_width == 16 ? (sign_extend ? 191 : 183) : 0;
    if (second == 0) {
        return false;
    }
    let byte_register: bool = operands->values[0].kind == OperandKind.register && source_width == 8;
    let force_rex: bool = byte_register && operands->values[0].register.code >= 4;
    return this->emit_rm(0, destination_width == 64, force_rex, 15, second, 2,
        operands->values[1].register.code, &operands->values[0]);
}

    priv fn emit_unary(operands: *const Operands, width: usize, group: u8) -> bool {
    if (operands->count != 1) {
        return false;
    }
    if (!this->is_memory_or_gpr(&operands->values[0], width)) {
        return false;
    }
    return this->emit_rm(width == 16 ? 102 : 0, width == 64, false, 247, 0, 1, group, &operands->values[0]);
}

    priv fn emit_shift(operands: *const Operands, width: usize, group: u8) -> bool {
    if (operands->count != 2 || !is_gpr(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == OperandKind.immediate && operands->values[0].immediate <= 255) {
        return this->emit_rm(0, width == 64, false, 193, 0, 1, group, &operands->values[1]) &&
            this->append_u8(operands->values[0].immediate as u8);
    }
    if (!is_gpr(&operands->values[0], 8) || operands->values[0].register.code != 1) {
        return false;
    }
    return this->emit_rm(0, width == 64, false, 211, 0, 1, group, &operands->values[1]);
}

    priv fn emit_set(operands: *const Operands, condition: u8) -> bool {
    if (operands->count != 1 || !is_gpr(&operands->values[0], 8)) {
        return false;
    }
    return this->emit_rm(
        0, false, operands->values[0].register.code >= 4, 15,
        ((144 as u8) | condition) as u8, 2, 0, &operands->values[0]);
}

    priv fn emit_sse_binary(operands: *const Operands, prefix: u8, operation: u8) -> bool {
    if (operands->count != 2 || !this->is_memory_or_xmm(&operands->values[0])) {
        return false;
    }
    if (!is_xmm(&operands->values[1])) {
        return false;
    }
    return this->emit_rm(
        prefix, false, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

    priv fn emit_conversion(
    operands: *const Operands, prefix: u8, operation: u8, rex_w: bool, source_xmm: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    if (source_xmm) {
        let source_is_valid: bool = this->is_memory_or_xmm(&operands->values[0]);
        if (!source_is_valid || !is_gpr(&operands->values[1], rex_w ? 64 : 32)) {
            return false;
        }
    } else {
        let source_is_valid: bool = this->is_memory_or_gpr(&operands->values[0], rex_w ? 64 : 32);
        if (!source_is_valid || !is_xmm(&operands->values[1])) {
            return false;
        }
    }
    return this->emit_rm(prefix, rex_w, false, 15, operation, 2, operands->values[1].register.code,
        &operands->values[0]);
}

    priv fn emit_compare(operands: *const Operands, width: usize, compare: bool) -> bool {
    if (operands->count != 2 || !is_rm(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == OperandKind.immediate) {
        if (!compare || !this->immediate_fits(width, operands->values[0].immediate)) {
            return false;
        }
        let byte: bool = width == 8;
        let force_rex: bool = byte && this->force_byte_rex(&operands->values[1]);
        if (!this->emit_rm(0, width == 64, force_rex, byte ? 128 : 129, 0, 1, 7, &operands->values[1])) {
            return false;
        }
        return byte ? this->append_u8(operands->values[0].immediate as u8) :
            this->append_u32(operands->values[0].immediate as u32);
    }
    if (!is_gpr(&operands->values[0], width)) {
        return false;
    }
    let opcode: u8 = compare ? (width == 8 ? 56 : 57) : (width == 8 ? 132 : 133);
    let high_source: bool = operands->values[0].register.code >= 4;
    let high_destination: bool = this->force_byte_rex(&operands->values[1]);
    let high_register: bool = high_source || high_destination;
    let force_rex: bool = width == 8 && high_register;
    return this->emit_rm(0, width == 64, force_rex, opcode, 0, 1,
        operands->values[0].register.code, &operands->values[1]);
}

    priv fn emit_imul(operands: *const Operands, width: usize) -> bool {
    let two_operand_source: bool = this->is_memory_or_gpr(&operands->values[0], width);
    if (operands->count == 2 && two_operand_source) {
        if (!is_gpr(&operands->values[1], width)) {
            return false;
        }
        return this->emit_rm(
            0, width == 64, false, 15, 175, 2, operands->values[1].register.code, &operands->values[0]);
    }
    if (operands->count != 3 || operands->values[0].kind != OperandKind.immediate) {
        return false;
    }
    let immediate_is_valid: bool = this->fits_i32(operands->values[0].immediate);
    let source_is_valid: bool = this->is_memory_or_gpr(&operands->values[1], width);
    if (immediate_is_valid && source_is_valid) {
        if (!is_gpr(&operands->values[2], width)) {
            return false;
        }
        return this->emit_rm(0, width == 64, false, 105, 0, 1, operands->values[2].register.code,
            &operands->values[1]) && this->append_u32(operands->values[0].immediate as u32);
    }
    return false;
}

    priv fn encode_fixed(rule: *const EncodingRule, operands: *const Operands) -> bool {
        if (operands->count != 0) {
            return false;
        }
        return this->append_opcode(rule->first, rule->second, rule->count as usize);
    }

    priv fn encode_repeat(raw_operands: string_views::string_view, operands: *const Operands) -> bool {
        if (operands->count != 1 || operands->values[0].kind != OperandKind.label) {
            return false;
        }
        var opcode: u8 = 0;
        if (equal(raw_operands, "movsb", 5)) {
            opcode = 164;
        } else if (equal(raw_operands, "stosb", 5)) {
            opcode = 170;
        } else {
            return false;
        }
        return this->append_u8(243) && this->append_u8(opcode);
    }

    priv fn encode_push(operands: *const Operands) -> bool {
        if (operands->count != 1 || !is_gpr(&operands->values[0], 64)) {
            return false;
        }
        let code: u8 = operands->values[0].register.code;
        if (code >= 8 && !this->append_u8(65)) {
            return false;
        }
        return this->append_u8(((80 as u8) | (code & 7)) as u8);
    }

    priv fn encode_transfer(rule: *const EncodingRule, operands: *const Operands) -> bool {
        let is_call: bool = rule->primary;
        if (operands->count == 1 && is_gpr(&operands->values[0], 64)) {
            return this->emit_indirect_transfer(&operands->values[0], is_call ? 2 : 4);
        }
        return this->emit_relative(is_call ? 232 : 233, 0, 1, operands, is_call ? FixupKind.call : FixupKind.branch);
    }

    priv fn encode_movabs(operands: *const Operands) -> bool {
        if (operands->count != 2 || operands->values[0].kind != OperandKind.immediate) {
            return false;
        }
        if (!is_gpr(&operands->values[1], 64)) {
            return false;
        }
        let code: u8 = operands->values[1].register.code;
        if (!this->append_u8(code >= 8 ? 73 : 72)) {
            return false;
        }
        return this->append_u8(((184 as u8) | (code & 7)) as u8) && this->append_u64(operands->values[0].immediate);
    }

    priv fn encode_movd(rule: *const EncodingRule, operands: *const Operands) -> bool {
        if (!rule->primary) {
            return this->emit_movd_or_movq(operands, false);
        }
        let has_pair: bool = operands->count == 2;
        if (has_pair) {
            let xmm_operand: bool = is_xmm(&operands->values[0]) || is_xmm(&operands->values[1]);
            if (xmm_operand && this->emit_movd_or_movq(operands, true)) {
                return true;
            }
        }
        return this->emit_move(operands, 64);
    }

    priv fn encode_movslq(operands: *const Operands) -> bool {
        if (operands->count != 2) {
            return false;
        }
        let source_is_valid: bool = is_gpr(&operands->values[0], 32) || operands->values[0].kind == OperandKind.memory;
        if (!source_is_valid || !is_gpr(&operands->values[1], 64)) {
            return false;
        }
        return this->emit_rm(0, true, false, 99, 0, 1, operands->values[1].register.code, &operands->values[0]);
    }

    priv fn encode_lea(operands: *const Operands) -> bool {
        if (operands->count != 2 || operands->values[0].kind != OperandKind.memory) {
            return false;
        }
        if (!is_gpr(&operands->values[1], 64)) {
            return false;
        }
        return this->emit_rm(0, true, false, 141, 0, 1, operands->values[1].register.code, &operands->values[0]);
    }

    priv fn encode_ldmxcsr(operands: *const Operands) -> bool {
        if (operands->count != 1 || operands->values[0].kind != OperandKind.memory) {
            return false;
        }
        return this->emit_rm(0, false, false, 15, 174, 2, 2, &operands->values[0]);
    }

    priv fn encode_rule(
        rule: *const EncodingRule, raw_operands: string_views::string_view, operands: *const Operands) -> bool {
        switch (rule->kind) {
        case EncodingKind.fixed {
            return this->encode_fixed(rule, operands);
        }
        case EncodingKind.repeat {
            return this->encode_repeat(raw_operands, operands);
        }
        case EncodingKind.push {
            return this->encode_push(operands);
        }
        case EncodingKind.transfer {
            return this->encode_transfer(rule, operands);
        }
        case EncodingKind.move {
            return this->emit_move(operands, rule->width as usize);
        }
        case EncodingKind.movd {
            return this->encode_movd(rule, operands);
        }
        case EncodingKind.xmm_move {
            return this->emit_xmm_move(operands, rule->primary);
        }
        case EncodingKind.extend {
            return this->emit_extend(operands, rule->width as usize, rule->target_width as usize, rule->primary);
        }
        case EncodingKind.movslq {
            return this->encode_movslq(operands);
        }
        case EncodingKind.lea {
            return this->encode_lea(operands);
        }
        case EncodingKind.binary_alu {
            return this->emit_binary_alu(operands, rule->width as usize, rule->first, rule->second);
        }
        case EncodingKind.compare {
            return this->emit_compare(operands, rule->width as usize, rule->primary);
        }
        case EncodingKind.unary {
            return this->emit_unary(operands, rule->width as usize, rule->first);
        }
        case EncodingKind.multiply {
            return this->emit_imul(operands, rule->width as usize);
        }
        case EncodingKind.shift {
            return this->emit_shift(operands, rule->width as usize, rule->first);
        }
        case EncodingKind.ldmxcsr {
            return this->encode_ldmxcsr(operands);
        }
        case EncodingKind.sse_binary {
            return this->emit_sse_binary(operands, rule->first, rule->second);
        }
        case EncodingKind.conversion {
            return this->emit_conversion(operands, rule->first, rule->second, rule->primary, rule->secondary);
        }
        case EncodingKind.movabs {
            return this->encode_movabs(operands);
        }
        default {
            return false;
        }
        }
    }

    priv fn encode(
        mnemonic: string_views::string_view, raw_operands: string_views::string_view,
        operands: *const Operands) -> bool {
        if (mnemonic.length > 1 && mnemonic.data[0] == 'j') {
            var condition_code: u8 = 0;
            let suffix: string_views::string_view = slice(mnemonic, 1, mnemonic.length - 1);
            if (this->condition(suffix, &condition_code)) {
                return this->emit_relative(15, ((128 as u8) | condition_code) as u8, 2, operands, FixupKind.branch);
            }
        }
        if (mnemonic.length > 3 && starts_with(mnemonic, "set", 3)) {
            var condition_code: u8 = 0;
            let suffix: string_views::string_view = slice(mnemonic, 3, mnemonic.length - 3);
            if (this->condition(suffix, &condition_code)) {
                return this->emit_set(operands, condition_code);
            }
        }
        let rule: *const EncodingRule = this->find_encoding(mnemonic);
        return rule != null && this->encode_rule(rule, raw_operands, operands);
    }

}
