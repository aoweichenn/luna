module luna.compiler.x86.assembler;

impl Assembler {
    init(): symbols = SymbolTable(), fixups = vector::vector<Fixup>(), numeric_labels = vector::vector<NumericLabel>() {
        this->storage = object::empty();
        this->current_section = object::Section.undefined;
        this->current_line = 1;
        this->error_code = runtime::Error.none;
        this->initialize_rules();
    }

    fn run(assembly: string_views::string_view) {
        if (!string_views::is_valid_utf8(assembly) || assembly.length > Limit.maximum_source as usize) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        var offset: usize = 0;
        while (this->error_code == runtime::Error.none && offset < assembly.length) {
            var end: usize = offset;
            while (end < assembly.length && assembly.data[end] != '\n') {
                end += 1;
            }
            let line_length: usize = end - offset;
            if (line_length > Limit.maximum_line as usize) {
                this->fail(runtime::Error.invalid_argument);
                break;
            }
            if (!this->assemble_line(slice(assembly, offset, line_length))) {
                this->fail(runtime::Error.invalid_argument);
                break;
            }
            if (end == assembly.length) {
                offset = end;
            } else {
                offset = end + 1;
                this->current_line += 1;
            }
        }
        if (this->error_code != runtime::Error.none) {
            return;
        }
        if (!this->resolve_fixups() || !this->validate_symbols()) {
            this->fail(runtime::Error.invalid_argument);
            return;
        }
        if (!object::is_valid(this->storage)) {
            this->fail(runtime::Error.invalid_argument);
        }
    }

    fn take_result() -> Result {
        let final_line: usize = this->current_line;
        if (this->error_code != runtime::Error.none) {
            object::release(this->storage);
            this->storage = object::empty();
            return { object = object::empty(), error = this->error_code, line = final_line };
        }
        let assembled: object::Object = this->storage;
        this->storage = object::empty();
        return { object = assembled, error = runtime::Error.none, line = final_line };
    }

    deinit() {
        object::release(this->storage);
        this->storage = object::empty();
    }
}

fn assemble(assembly: string_views::string_view) -> Result {
    var assembler: Assembler = Assembler();
    assembler.run(assembly);
    return assembler.take_result();
}
