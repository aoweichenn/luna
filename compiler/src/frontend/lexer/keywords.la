module luna.compiler.lexer;

fn is_ascii_letter(byte: u8) -> bool {
    let uppercase: bool = byte >= 'A' && byte <= 'Z';
    let lowercase: bool = byte >= 'a' && byte <= 'z';
    return uppercase || lowercase;
}

fn is_decimal_digit(byte: u8) -> bool {
    return byte >= '0' && byte <= '9';
}

fn is_hex_digit(byte: u8) -> bool {
    let uppercase: bool = byte >= 'A' && byte <= 'F';
    let lowercase: bool = byte >= 'a' && byte <= 'f';
    if (is_decimal_digit(byte) || uppercase) {
        return true;
    }
    return lowercase;
}

fn digit_matches_base(byte: u8, base: usize) -> bool {
    switch (base) {
    case 2 {
        return byte == '0' || byte == '1';
    }
    case 8 {
        return byte >= '0' && byte <= '7';
    }
    case 10 {
        return is_decimal_digit(byte);
    }
    case 16 {
        return is_hex_digit(byte);
    }
    default {
        return false;
    }
    }
}

fn is_identifier_byte(byte: u8) -> bool {
    if (is_ascii_letter(byte) || is_decimal_digit(byte)) {
        return true;
    }
    return byte == '_';
}

fn source_text_equals(
    source: string_views::string_view, start: usize, length: usize,
    expected: *const u8, expected_length: usize) -> bool {
    if (length != expected_length || expected == null) {
        return false;
    }
    for (var index: usize = 0; index < length; index += 1) {
        if (source.data[start + index] != expected[index]) {
            return false;
        }
    }
    return true;
}

impl KeywordTable {
    init() {
        this->entries = {
            {text = "as", length = 2, kind = TokenKind.keyword_as},
            {text = "do", length = 2, kind = TokenKind.keyword_do},
            {text = "fn", length = 2, kind = TokenKind.keyword_fn},
            {text = "i8", length = 2, kind = TokenKind.keyword_i8},
            {text = "u8", length = 2, kind = TokenKind.keyword_u8},
            {text = "f32", length = 3, kind = TokenKind.keyword_f32},
            {text = "f64", length = 3, kind = TokenKind.keyword_f64},
            {text = "for", length = 3, kind = TokenKind.keyword_for},
            {text = "i16", length = 3, kind = TokenKind.keyword_i16},
            {text = "i32", length = 3, kind = TokenKind.keyword_i32},
            {text = "i64", length = 3, kind = TokenKind.keyword_i64},
            {text = "let", length = 3, kind = TokenKind.keyword_let},
            {text = "loop", length = 4, kind = TokenKind.keyword_loop},
            {text = "u16", length = 3, kind = TokenKind.keyword_u16},
            {text = "u32", length = 3, kind = TokenKind.keyword_u32},
            {text = "u64", length = 3, kind = TokenKind.keyword_u64},
            {text = "var", length = 3, kind = TokenKind.keyword_var},
            {text = "bool", length = 4, kind = TokenKind.keyword_bool},
            {text = "case", length = 4, kind = TokenKind.keyword_case},
            {text = "else", length = 4, kind = TokenKind.keyword_else},
            {text = "enum", length = 4, kind = TokenKind.keyword_enum},
            {text = "false", length = 5, kind = TokenKind.keyword_false},
            {text = "isize", length = 5, kind = TokenKind.keyword_isize},
            {text = "null", length = 4, kind = TokenKind.keyword_null},
            {text = "true", length = 4, kind = TokenKind.keyword_true},
            {text = "union", length = 5, kind = TokenKind.keyword_union},
            {text = "usize", length = 5, kind = TokenKind.keyword_usize},
            {text = "void", length = 4, kind = TokenKind.keyword_void},
            {text = "alignof", length = 7, kind = TokenKind.keyword_alignof},
            {text = "break", length = 5, kind = TokenKind.keyword_break},
            {text = "const", length = 5, kind = TokenKind.keyword_const},
            {text = "continue", length = 8, kind = TokenKind.keyword_continue},
            {text = "default", length = 7, kind = TokenKind.keyword_default},
            {text = "export", length = 6, kind = TokenKind.keyword_export},
            {text = "extern", length = 6, kind = TokenKind.keyword_extern},
            {text = "if", length = 2, kind = TokenKind.keyword_if},
            {text = "import", length = 6, kind = TokenKind.keyword_import},
            {text = "module", length = 6, kind = TokenKind.keyword_module},
            {text = "offsetof", length = 8, kind = TokenKind.keyword_offsetof},
            {text = "return", length = 6, kind = TokenKind.keyword_return},
            {text = "sizeof", length = 6, kind = TokenKind.keyword_sizeof},
            {text = "struct", length = 6, kind = TokenKind.keyword_struct},
            {text = "switch", length = 6, kind = TokenKind.keyword_switch},
            {text = "while", length = 5, kind = TokenKind.keyword_while},
            {text = "assert", length = 6, kind = TokenKind.keyword_assert},
            {text = "volatile", length = 8, kind = TokenKind.keyword_volatile},
            {text = "goto", length = 4, kind = TokenKind.keyword_goto},
            {text = "va_arg", length = 6, kind = TokenKind.keyword_va_arg},
            {text = "va_list", length = 7, kind = TokenKind.keyword_va_list},
            {text = "va_start", length = 8, kind = TokenKind.keyword_va_start},
            {text = "asm", length = 3, kind = TokenKind.keyword_asm},
            {text = "class", length = 5, kind = TokenKind.keyword_class},
            {text = "pub", length = 3, kind = TokenKind.keyword_pub},
            {text = "prot", length = 4, kind = TokenKind.keyword_prot},
            {text = "priv", length = 4, kind = TokenKind.keyword_priv},
            {text = "static", length = 6, kind = TokenKind.keyword_static},
            {text = "impl", length = 4, kind = TokenKind.keyword_impl},
            {text = "this", length = 4, kind = TokenKind.keyword_this},
            {text = "final", length = 5, kind = TokenKind.keyword_final},
            {text = "virtual", length = 7, kind = TokenKind.keyword_virtual},
            {text = "abstract", length = 8, kind = TokenKind.keyword_abstract},
            {text = "override", length = 8, kind = TokenKind.keyword_override},
            {text = "super", length = 5, kind = TokenKind.keyword_super},
            {text = "operator", length = 8, kind = TokenKind.keyword_operator},
            {text = "method", length = 6, kind = TokenKind.keyword_method},
            {text = "friend", length = 6, kind = TokenKind.keyword_friend},
            {text = "opaque", length = 6, kind = TokenKind.keyword_opaque},
        };
    }

    fn lookup(source: string_views::string_view, start: usize, length: usize) const -> TokenKind {
        if (start > source.length) {
            return TokenKind.identifier;
        }
        if (length > source.length - start) {
            return TokenKind.identifier;
        }
        for (var index: usize = 0; index < LexerLimit.keyword_count as usize; index += 1) {
            let entry: KeywordEntry = this->entries[index];
            if (source_text_equals(source, start, length, entry.text, entry.length)) {
                return entry.kind;
            }
        }
        return TokenKind.identifier;
    }
}
