module luna.bootstrap.frontend.parser;

import luna.bootstrap.frontend.parser.declarations as declarations;
import luna.bootstrap.frontend.parser.state as state;

fn parse(source: string_views::string_view, tokens: lexer::TokenBuffer) -> ParseResult {
    if (!state::parser_input_is_valid(source, tokens)) {
        return {
            tree = syntax::syntax_tree_empty(), diagnostics = lexer::diagnostic_buffer_empty(),
            error = runtime::Error.invalid_argument,
        };
    }
    var state: state::State = {
        source = source, tokens = tokens, cursor = 0, current = state::parser_invalid_token(),
        current_index = syntax::syntax_no_index(), previous = state::parser_invalid_token(),
        tree = syntax::syntax_tree_empty(), diagnostics = lexer::diagnostic_buffer_empty(),
        error = runtime::Error.none, nesting_depth = 0,
    };
    state.tree.token_count = tokens.count;
    state::parser_advance(&state);
    if (state.error == runtime::Error.none) {
        declarations::parse_program(&state);
    }
    if (state.error == runtime::Error.none && !syntax::syntax_tree_is_valid(state.tree)) {
        state.error = runtime::Error.io;
    }
    return {
        tree = state.tree, diagnostics = state.diagnostics, error = state.error,
    };
}

fn parse_result_release(result: ParseResult) -> runtime::Error {
    let tree_error: runtime::Error = syntax::syntax_tree_release(result.tree);
    let diagnostic_error: runtime::Error = lexer::diagnostic_buffer_release(result.diagnostics);
    if (tree_error != runtime::Error.none) {
        return tree_error;
    }
    return diagnostic_error;
}

fn frontend_parse(source: string_views::string_view) -> FrontendResult {
    let lex: lexer::LexResult = lexer::lex(source);
    if (lex.error != runtime::Error.none) {
        return {
            lex = lex, parse = {
                tree = syntax::syntax_tree_empty(), diagnostics = lexer::diagnostic_buffer_empty(), error = lex.error,
            }, error = lex.error,
        };
    }
    let parse_result: ParseResult = parse(source, lex.tokens);
    return {
        lex = lex, parse = parse_result, error = parse_result.error,
    };
}

fn frontend_result_release(result: FrontendResult) -> runtime::Error {
    let parse_error: runtime::Error = parse_result_release(result.parse);
    let lex_error: runtime::Error = lexer::lex_result_release(result.lex);
    if (parse_error != runtime::Error.none) {
        return parse_error;
    }
    return lex_error;
}
