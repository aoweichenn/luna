module luna.compiler.parser;

fn is_builtin_type(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.keyword_bool, lexer::TokenKind.keyword_i8, lexer::TokenKind.keyword_i16,
        lexer::TokenKind.keyword_i32, lexer::TokenKind.keyword_i64, lexer::TokenKind.keyword_isize,
        lexer::TokenKind.keyword_u8, lexer::TokenKind.keyword_u16, lexer::TokenKind.keyword_u32,
        lexer::TokenKind.keyword_u64, lexer::TokenKind.keyword_usize, lexer::TokenKind.keyword_f32,
        lexer::TokenKind.keyword_f64, lexer::TokenKind.keyword_void, lexer::TokenKind.keyword_va_list {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_assignment_operator(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.equal, lexer::TokenKind.plus_equal, lexer::TokenKind.minus_equal,
        lexer::TokenKind.star_equal, lexer::TokenKind.slash_equal, lexer::TokenKind.percent_equal,
        lexer::TokenKind.ampersand_equal, lexer::TokenKind.pipe_equal, lexer::TokenKind.caret_equal,
        lexer::TokenKind.shift_left_equal, lexer::TokenKind.shift_right_equal {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_string_token(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.string, lexer::TokenKind.string_u16, lexer::TokenKind.string_u32 {
        return true;
    }
    default {
        return false;
    }
    }
}

fn is_unary_operator(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.plus, lexer::TokenKind.minus, lexer::TokenKind.bang,
        lexer::TokenKind.tilde, lexer::TokenKind.star, lexer::TokenKind.ampersand {
        return true;
    }
    default {
        return false;
    }
    }
}

fn binary_precedence(kind: lexer::TokenKind) -> usize {
    switch (kind) {
    case lexer::TokenKind.logical_or {
        return 1;
    }
    case lexer::TokenKind.logical_and {
        return 2;
    }
    case lexer::TokenKind.pipe {
        return 3;
    }
    case lexer::TokenKind.caret {
        return 4;
    }
    case lexer::TokenKind.ampersand {
        return 5;
    }
    case lexer::TokenKind.equal_equal, lexer::TokenKind.bang_equal {
        return 6;
    }
    case lexer::TokenKind.less, lexer::TokenKind.less_equal, lexer::TokenKind.greater, lexer::TokenKind.greater_equal {
        return 7;
    }
    case lexer::TokenKind.shift_left, lexer::TokenKind.shift_right {
        return 8;
    }
    case lexer::TokenKind.plus, lexer::TokenKind.minus {
        return 9;
    }
    case lexer::TokenKind.star, lexer::TokenKind.slash, lexer::TokenKind.percent {
        return 10;
    }
    default {
        return 0;
    }
    }
}

fn access_flag(kind: lexer::TokenKind) -> usize {
    switch (kind) {
    case lexer::TokenKind.keyword_pub {
        return syntax::SyntaxFlag.public_access as usize;
    }
    case lexer::TokenKind.keyword_prot {
        return syntax::SyntaxFlag.protected_access as usize;
    }
    case lexer::TokenKind.keyword_priv {
        return syntax::SyntaxFlag.private_access as usize;
    }
    default {
        return syntax::SyntaxFlag.none as usize;
    }
    }
}

fn operator_token_is_supported(kind: lexer::TokenKind) -> bool {
    switch (kind) {
    case lexer::TokenKind.minus, lexer::TokenKind.bang, lexer::TokenKind.tilde,
        lexer::TokenKind.plus, lexer::TokenKind.star, lexer::TokenKind.slash,
        lexer::TokenKind.percent, lexer::TokenKind.ampersand, lexer::TokenKind.pipe,
        lexer::TokenKind.caret, lexer::TokenKind.shift_left, lexer::TokenKind.shift_right,
        lexer::TokenKind.equal_equal, lexer::TokenKind.bang_equal, lexer::TokenKind.less,
        lexer::TokenKind.less_equal, lexer::TokenKind.greater, lexer::TokenKind.greater_equal, lexer::TokenKind.equal {
        return true;
    }
    default {
        return false;
    }
    }
}
