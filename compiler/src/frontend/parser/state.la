module luna.bootstrap.frontend.parser.state;

import luna.std.bytes as bytes;

enum ParserLimit: usize {
    maximum_size = 18446744073709551615, maximum_nesting = 256, maximum_nodes = 262144,
}

fn parser_empty_span() -> lexer::SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn parser_invalid_token() -> lexer::Token {
    return {
        kind = lexer::TokenKind.invalid, span = parser_empty_span(),
    };
}

fn parser_token_at(state: *State, index: usize) -> lexer::Token {
    let result: lexer::TokenResult = state->tokens.get(index);
    if (result.error != runtime::Error.none) {
        if (state->error == runtime::Error.none) {
            state->error = result.error;
        }
        return {
            kind = lexer::TokenKind.invalid, span = {
                offset = 0, length = 0, line = 0, column = 0,
            },
        };
    }
    return result.token;
}

fn parser_identifier_text_is(state: *State, token: lexer::Token, expected: *const u8, length: usize) -> bool {
    if (token.kind != lexer::TokenKind.identifier || token.span.length != length) {
        return false;
    }
    let source: string_views::string_view = state->source;
    for (var index: usize = 0; index < length; index += 1) {
        if (source.data[token.span.offset + index] != expected[index]) {
            return false;
        }
    }
    return true;
}

fn parser_span_is_valid(source: string_views::string_view, span: lexer::SourceSpan) -> bool {
    let offset_is_valid: bool = span.offset <= source.length;
    let length_is_valid: bool = offset_is_valid && span.length <= source.length - span.offset;
    let position_is_valid: bool = span.line != 0 && span.column != 0;
    return length_is_valid && position_is_valid;
}

fn parser_source_is_valid(source: string_views::string_view) -> bool {
    if (!string_views::is_valid_utf8(source)) {
        return false;
    }
    for (var index: usize = 0; index < source.length; index += 1) {
        if (source.data[index] == 0) {
            return false;
        }
    }
    return true;
}

fn parser_input_is_valid(source: string_views::string_view, tokens: lexer::TokenView) -> bool {
    let buffers_are_valid: bool = parser_source_is_valid(source) && tokens.is_valid();
    if (!buffers_are_valid || tokens.empty()) {
        return false;
    }

    let token_count: usize = tokens.size();
    var previous_end: usize = 0;
    var scan_offset: usize = 0;
    var scan_line: usize = 1;
    var scan_column: usize = 1;
    for (var index: usize = 0; index < token_count; index += 1) {
        let token_result: lexer::TokenResult = tokens.get(index);
        if (token_result.error != runtime::Error.none) {
            return false;
        }
        let token: lexer::Token = token_result.token;
        let kind_is_valid: bool = (token.kind as usize) <= (lexer::TokenKind.keyword_opaque as usize);
        let source_is_valid: bool = parser_span_is_valid(source, token.span) && token.span.offset >= previous_end;
        if (!kind_is_valid || !source_is_valid) {
            return false;
        }
        for (; scan_offset < token.span.offset; scan_offset += 1) {
            if (source.data[scan_offset] == '\n') {
                scan_line += 1;
                scan_column = 1;
            } else {
                scan_column += 1;
            }
        }
        if (token.span.line != scan_line || token.span.column != scan_column) {
            return false;
        }
        previous_end = token.span.offset + token.span.length;
        if (index + 1 == token_count) {
            let end_token_is_valid: bool = token.kind == lexer::TokenKind.end && token.span.length == 0;
            return end_token_is_valid && token.span.offset == source.length;
        }
        if (token.kind == lexer::TokenKind.end) {
            return false;
        }
    }
    return false;
}

fn parser_join_spans(first: lexer::SourceSpan, last: lexer::SourceSpan) -> lexer::SourceSpan {
    if (last.offset < first.offset || last.length > (ParserLimit.maximum_size as usize) - last.offset) {
        return first;
    }
    let last_end: usize = last.offset + last.length;
    if (last_end < first.offset) {
        return first;
    }
    return {
        offset = first.offset, length = last_end - first.offset, line = first.line, column = first.column,
    };
}

fn parser_add_diagnostic(
    state: *State, kind: lexer::DiagnosticKind, span: lexer::SourceSpan,
    expected: lexer::TokenKind, found: lexer::TokenKind, detail: usize) -> bool {
    if (state->error != runtime::Error.none) {
        return false;
    }
    let error: runtime::Error = state->diagnostics.add({
        kind = kind, span = span, expected = expected, found = found, detail = detail,
    });
    state->error = error;
    return error == runtime::Error.none;
}

fn parser_new_node(state: *State, kind: syntax::SyntaxKind, span: lexer::SourceSpan, token_index: usize) -> usize {
    let none: usize = syntax::syntax_no_index();
    if (state->error != runtime::Error.none) {
        return none;
    }
    if (!syntax::syntax_tree_storage_is_valid(state->tree)) {
        state->error = runtime::Error.invalid_argument;
        return none;
    }
    if (state->tree.count >= ParserLimit.maximum_nodes as usize) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.resource_limit, span, lexer::TokenKind.invalid, state->current.kind,
            ParserLimit.maximum_nodes as usize);
        state->error = runtime::Error.out_of_memory;
        return none;
    }
    let node: syntax::SyntaxNode = {
        kind = kind, span = span, token_index = token_index, parent = none, first_child = none, last_child = none,
        next_sibling = none, child_count = 0, flags = syntax::SyntaxFlag.none as usize,
    };
    let appended: bytes::BufferResult = bytes::append(
        state->tree.storage, (&node) as *const syntax::SyntaxNode as *const u8, sizeof(syntax::SyntaxNode));
    state->tree.storage = appended.buffer;
    state->error = appended.error;
    if (appended.error != runtime::Error.none) {
        return none;
    }
    let index: usize = state->tree.count;
    state->tree.count += 1;
    return index;
}

fn parser_node_pointer(state: *State, index: usize) -> *syntax::SyntaxNode {
    if (state->error != runtime::Error.none) {
        return null;
    }
    if (index >= state->tree.count) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return null;
    }
    let nodes: *syntax::SyntaxNode = state->tree.storage.data as *syntax::SyntaxNode;
    return &nodes[index];
}

fn parser_set_node_span(state: *State, index: usize, span: lexer::SourceSpan) -> bool {
    let node: *syntax::SyntaxNode = parser_node_pointer(state, index);
    if (node == null) {
        return false;
    }
    node->span = span;
    return true;
}

fn parser_add_node_flags(state: *State, index: usize, flags: usize) -> bool {
    let node: *syntax::SyntaxNode = parser_node_pointer(state, index);
    if (node == null) {
        return false;
    }
    node->flags |= flags;
    return true;
}

fn parser_add_child(state: *State, parent_index: usize, child_index: usize) -> bool {
    let none: usize = syntax::syntax_no_index();
    if (state->error != runtime::Error.none) {
        return false;
    }
    let indices_are_valid: bool = parent_index < state->tree.count && child_index < state->tree.count;
    if (!indices_are_valid || parent_index == child_index) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return false;
    }
    let nodes: *syntax::SyntaxNode = state->tree.storage.data as *syntax::SyntaxNode;
    let child_is_detached: bool = nodes[child_index].parent == none && nodes[child_index].next_sibling == none;
    let parent_has_capacity: bool = nodes[parent_index].child_count != ParserLimit.maximum_size as usize;
    if (!child_is_detached || !parent_has_capacity) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return false;
    }
    if (nodes[parent_index].child_count == 0) {
        nodes[parent_index].first_child = child_index;
    } else {
        nodes[nodes[parent_index].last_child].next_sibling = child_index;
    }
    nodes[child_index].parent = parent_index;
    nodes[parent_index].last_child = child_index;
    nodes[parent_index].child_count += 1;
    return true;
}

fn parser_advance(state: *State) -> void {
    if (state->error != runtime::Error.none) {
        return;
    }
    state->previous = state->current;
    for (; state->cursor < state->tokens.size();) {
        let token_result: lexer::TokenResult = state->tokens.get(state->cursor);
        if (token_result.error != runtime::Error.none) {
            state->error = token_result.error;
            return;
        }
        state->current = token_result.token;
        state->current_index = state->cursor;
        state->cursor += 1;
        if (state->current.kind != lexer::TokenKind.invalid) {
            return;
        }
    }
    state->error = runtime::Error.invalid_argument;
}

fn parser_check(state: *State, kind: lexer::TokenKind) -> bool {
    return state->current.kind == kind;
}

fn parser_peek_kind(state: *State) -> lexer::TokenKind {
    var cursor: usize = state->cursor;
    for (; cursor < state->tokens.size(); cursor += 1) {
        let token_result: lexer::TokenResult = state->tokens.get(cursor);
        if (token_result.error != runtime::Error.none) {
            state->error = token_result.error;
            return lexer::TokenKind.invalid;
        }
        if (token_result.token.kind != lexer::TokenKind.invalid) {
            return token_result.token.kind;
        }
    }
    return lexer::TokenKind.invalid;
}

fn parser_match(state: *State, kind: lexer::TokenKind) -> bool {
    if (!parser_check(state, kind)) {
        return false;
    }
    if (kind != lexer::TokenKind.end) {
        parser_advance(state);
    }
    return true;
}

fn parser_expect(state: *State, kind: lexer::TokenKind) -> bool {
    if (parser_match(state, kind)) {
        return true;
    }
    return parser_add_diagnostic(
        state, lexer::DiagnosticKind.expected_token, state->current.span, kind, state->current.kind, 0) && false;
}

fn parser_enter_nesting(state: *State, span: lexer::SourceSpan) -> bool {
    if (state->nesting_depth >= ParserLimit.maximum_nesting as usize) {
        parser_add_diagnostic(
            state, lexer::DiagnosticKind.nesting_limit, span, lexer::TokenKind.invalid, state->current.kind,
            state->nesting_depth);
        return false;
    }
    state->nesting_depth += 1;
    return true;
}

fn parser_leave_nesting(state: *State) -> void {
    if (state->nesting_depth == 0) {
        if (state->error == runtime::Error.none) {
            state->error = runtime::Error.invalid_argument;
        }
        return;
    }
    state->nesting_depth -= 1;
}

fn parser_mark(state: *State) -> Mark {
    return {
        cursor = state->cursor, current = state->current, current_index = state->current_index,
        previous = state->previous, tree_length = state->tree.storage.length, tree_count = state->tree.count,
        diagnostic_count = state->diagnostics.size(), nesting_depth = state->nesting_depth,
    };
}

fn parser_restore(state: *State, mark: Mark) -> bool {
    if (state == null || state->error != runtime::Error.none) {
        return false;
    }
    let tree_can_restore: bool = mark.tree_length <= state->tree.storage.length && mark.tree_count <= state->tree.count;
    let diagnostics_can_restore: bool = mark.diagnostic_count <= state->diagnostics.size();
    if (!tree_can_restore || !diagnostics_can_restore) {
        state->error = runtime::Error.invalid_argument;
        return false;
    }
    state->cursor = mark.cursor;
    state->current = mark.current;
    state->current_index = mark.current_index;
    state->previous = mark.previous;
    state->tree.storage.length = mark.tree_length;
    state->tree.count = mark.tree_count;
    let diagnostic_error: runtime::Error = state->diagnostics.truncate(mark.diagnostic_count);
    if (diagnostic_error != runtime::Error.none) {
        state->error = diagnostic_error;
        return false;
    }
    state->nesting_depth = mark.nesting_depth;
    return true;
}
