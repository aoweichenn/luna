module luna.compiler.parser;

impl Parser {

priv fn parse_expression_statement(terminator: lexer::TokenKind) -> usize {
    let none: usize = syntax::no_index();
    let expression: usize = this->parse_expression();
    if (expression == none) {
        return none;
    }
    if (is_assignment_operator(
            this->current_token.kind)) {
        let operation_token: lexer::Token = this->current_token;
        let operation_index: usize = this->current_token_index;
        this->advance();
        let value: usize = this->parse_expression();
        this->expect(terminator);
        let expression_node: syntax::SyntaxNode = this->node(expression);
        let start_span: lexer::SourceSpan = expression_node.kind == syntax::SyntaxKind.invalid ? operation_token.span :
            expression_node.span;
        let assignment: usize = this->new_node(syntax::SyntaxKind.assignment_statement,
            join_spans(start_span, this->previous_token.span), operation_index);
        this->add_child(assignment, expression);
        if (value != none) {
            this->add_child(assignment, value);
        }
        return assignment;
    }

    this->expect(terminator);
    let expression_node: syntax::SyntaxNode = this->node(expression);
    let span: lexer::SourceSpan = expression_node.kind == syntax::SyntaxKind.invalid ? this->previous_token.span :
            join_spans(expression_node.span, this->previous_token.span);
    let statement: usize = this->new_node(syntax::SyntaxKind.expression_statement, span,
            expression_node.kind == syntax::SyntaxKind.invalid ? syntax::no_index() : expression_node.token_index);
    this->add_child(statement, expression);
    return statement;
}

priv fn parse_attributes(first_attribute: *usize, attribute_count: *usize) -> bool {
    let none: usize = syntax::no_index();
    if (first_attribute == null || attribute_count == null) {
        return false;
    }
    *first_attribute = none;
    *attribute_count = 0;
    while (this->error_code == runtime::Error.none && this->current_token.kind == lexer::TokenKind.at_sign) {
        let at_token: lexer::Token = this->current_token;
        this->advance();
        let name: lexer::Token = this->current_token;
        let name_index: usize = this->current_token_index;
        if (!this->expect(lexer::TokenKind.identifier)) {
            return false;
        }
        let attribute: usize = this->new_node(syntax::SyntaxKind.attribute, join_spans(at_token.span, name.span),
            name_index);
        if (attribute == none) {
            return false;
        }
        if (*attribute_count == 0) {
            *first_attribute = attribute;
        }
        *attribute_count += 1;
        if (this->match(lexer::TokenKind.left_parenthesis)) {
            if (this->current_token.kind != lexer::TokenKind.right_parenthesis) {
                while (this->error_code == runtime::Error.none) {
                    var argument: usize = none;
                    if (this->current_token.kind == lexer::TokenKind.identifier &&
                        this->token_at(this->current_token_index + 1).kind == lexer::TokenKind.colon) {
                        let argument_name: lexer::Token = this->current_token;
                        let argument_name_index: usize = this->current_token_index;
                        this->advance();
                        this->advance();
                        let argument_value: usize = this->parse_expression();
                        if (argument_value == none) {
                            return false;
                        }
                        argument = this->new_node(syntax::SyntaxKind.named_argument,
                            join_spans(argument_name.span, this->previous_token.span), argument_name_index);
                        if (argument == none) {
                            return false;
                        }
                        this->add_child(argument, argument_value);
                    } else {
                        argument = this->parse_expression();
                    }
                    if (argument == none) {
                        return false;
                    }
                    this->add_child(attribute, argument);
                    if (!this->match(lexer::TokenKind.comma)) {
                        break;
                    }
                }
            }
            if (!this->expect(lexer::TokenKind.right_parenthesis)) {
                return false;
            }
            this->add_node_flags(attribute, syntax::SyntaxFlag.has_arguments as usize);
            this->set_node_span(attribute, join_spans(at_token.span, this->previous_token.span));
        }
    }
    return this->error_code == runtime::Error.none;
}

priv fn attach_attributes(declaration: usize, first_attribute: usize, attribute_count: usize) -> bool {
    for (var index: usize = 0; index < attribute_count; index += 1) {
        if (!this->add_child(declaration, first_attribute + index)) {
            return false;
        }
    }
    return true;
}

priv fn parse_variable_declaration(keyword: lexer::Token, keyword_index: usize, is_mutable: bool,
    is_volatile: bool, first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = syntax::no_index();
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    this->expect(lexer::TokenKind.identifier);
    let declaration: usize = this->new_node(syntax::SyntaxKind.variable_declaration, keyword.span, name_index);
    if (is_mutable) {
        this->add_node_flags(declaration, syntax::SyntaxFlag.mutable_binding as usize);
    }
    if (is_volatile) {
        this->add_node_flags(declaration, syntax::SyntaxFlag.volatile_ as usize);
    }
    if (this->match(lexer::TokenKind.colon)) {
        let type_node: usize = this->parse_type();
        if (type_node != none) {
            this->add_child(declaration, type_node);
        }
    } else {
        this->add_node_flags(declaration, syntax::SyntaxFlag.inferred_type as usize);
    }
    this->expect(lexer::TokenKind.equal);
    let initializer: usize = this->parse_expression();
    if (initializer != none) {
        this->add_child(declaration, initializer);
    }
    this->expect(lexer::TokenKind.semicolon);
    this->attach_attributes(declaration, first_attribute, attribute_count);
    this->set_node_span(declaration, join_spans(keyword.span, this->previous_token.span));
    return declaration;
}

priv fn parse_const_declaration(keyword: lexer::Token, keyword_index: usize, flags: usize,
    first_attribute: usize, attribute_count: usize) -> usize {
    let none: usize = syntax::no_index();
    if ((flags & (syntax::SyntaxFlag.external as usize)) != 0) {
        this->add_diagnostic(lexer::DiagnosticKind.invalid_external_declaration, keyword.span,
            lexer::TokenKind.keyword_fn, lexer::TokenKind.identifier, 0);
    }
    this->advance();
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    this->expect(lexer::TokenKind.identifier);
    let declaration: usize = this->new_node(syntax::SyntaxKind.const_declaration, keyword.span, name_index);
    this->add_node_flags(declaration, flags);
    this->expect(lexer::TokenKind.colon);
    let type_node: usize = this->parse_type();
    if (type_node != none) {
        this->add_child(declaration, type_node);
    }
    this->expect(lexer::TokenKind.equal);
    let initializer: usize = this->parse_expression();
    if (initializer != none) {
        this->add_child(declaration, initializer);
    }
    this->expect(lexer::TokenKind.semicolon);
    this->attach_attributes(declaration, first_attribute, attribute_count);
    this->set_node_span(declaration, join_spans(keyword.span, this->previous_token.span));
    return declaration;
}

// asm fn 的主体只接受大括号内一个或多个相邻字符串；非字符串节点留给语义阶段给出精确诊断。
priv fn parse_asm_body() -> usize {
    let none: usize = syntax::no_index();
    let left_brace: lexer::Token = this->current_token;
    if (!this->expect(lexer::TokenKind.left_brace)) {
        return none;
    }
    if (!this->enter_nesting(left_brace.span)) {
        return none;
    }
    var body: usize = none;
    if (is_string_token(this->current_token.kind)) {
        let token: lexer::Token = this->current_token;
        let token_index: usize = this->current_token_index;
        this->advance();
        body = this->new_node(syntax::SyntaxKind.string_expression, token.span, token_index);
        for (; this->error_code == runtime::Error.none && is_string_token(this->current_token.kind);) {
            let part: lexer::Token = this->current_token;
            let part_index: usize = this->current_token_index;
            this->advance();
            this->add_child(body, this->new_node(syntax::SyntaxKind.string_expression, part.span, part_index));
            this->set_node_span(body, join_spans(token.span, this->previous_token.span));
        }
    } else if (this->current_token.kind != lexer::TokenKind.right_brace) {
        body = this->new_node(syntax::SyntaxKind.invalid, this->current_token.span, this->current_token_index);
        for (; this->error_code == runtime::Error.none && !this->at_right_brace_or_end();) {
            this->advance();
        }
    }
    this->expect(lexer::TokenKind.right_brace);
    this->leave_nesting();
    return body;
}

priv fn parse_block() -> usize {
    let none: usize = syntax::no_index();
    let left_brace: lexer::Token = this->current_token;
    let left_brace_index: usize = this->current_token_index;
    if (!this->expect(lexer::TokenKind.left_brace)) {
        return none;
    }
    let block: usize = this->new_node(syntax::SyntaxKind.block_statement, left_brace.span, left_brace_index);
    if (!this->enter_nesting(left_brace.span)) {
        return block;
    }
    for (; this->error_code == runtime::Error.none && !this->at_right_brace_or_end();) {
        let index_before: usize = this->current_token_index;
        let statement: usize = this->parse_statement();
        if (statement != none) {
            this->add_child(block, statement);
        }
        if (this->current_token_index == index_before && this->current_token.kind != lexer::TokenKind.end) {
            this->advance();
        }
    }
    this->expect(lexer::TokenKind.right_brace);
    this->set_node_span(block, join_spans(left_brace.span, this->previous_token.span));
    this->leave_nesting();
    return block;
}

priv fn parse_if_statement(keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.if_statement, keyword.span, keyword_index);
    if (!this->enter_nesting(keyword.span)) {
        return statement;
    }
    this->expect(lexer::TokenKind.left_parenthesis);
    let condition: usize = this->parse_expression();
    if (condition != none) {
        this->add_child(statement, condition);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    let then_block: usize = this->parse_block();
    if (then_block != none) {
        this->add_child(statement, then_block);
    }
    var end_span: lexer::SourceSpan = this->previous_token.span;
    if (this->match(lexer::TokenKind.keyword_else)) {
        var else_branch: usize = none;
        if (this->current_token.kind == lexer::TokenKind.keyword_if) {
            let else_keyword: lexer::Token = this->current_token;
            let else_index: usize = this->current_token_index;
            this->advance();
            else_branch = this->parse_if_statement(else_keyword, else_index);
        } else {
            else_branch = this->parse_block();
        }
        if (else_branch != none) {
            this->add_child(statement, else_branch);
            let else_node: syntax::SyntaxNode = this->node(else_branch);
            if (else_node.kind != syntax::SyntaxKind.invalid) {
                end_span = else_node.span;
            }
        }
    }
    this->set_node_span(statement, join_spans(keyword.span, end_span));
    this->leave_nesting();
    return statement;
}

priv fn parse_while_statement(keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.while_statement, keyword.span, keyword_index);
    this->expect(lexer::TokenKind.left_parenthesis);
    let condition: usize = this->parse_expression();
    if (condition != none) {
        this->add_child(statement, condition);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    let body: usize = this->parse_block();
    if (body != none) {
        this->add_child(statement, body);
        let body_node: syntax::SyntaxNode = this->node(body);
        if (body_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(statement, join_spans(keyword.span, body_node.span));
        }
    }
    return statement;
}

priv fn parse_do_statement(keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.do_statement, keyword.span, keyword_index);
    if (!this->enter_nesting(keyword.span)) {
        return statement;
    }
    let body: usize = this->parse_block();
    if (body != none) {
        this->add_child(statement, body);
    }
    this->expect(lexer::TokenKind.keyword_while);
    this->expect(lexer::TokenKind.left_parenthesis);
    let condition: usize = this->parse_expression();
    if (condition != none) {
        this->add_child(statement, condition);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(statement, join_spans(keyword.span, this->previous_token.span));
    this->leave_nesting();
    return statement;
}

priv fn parse_loop_statement(keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.loop_statement, keyword.span, keyword_index);
    let body: usize = this->parse_block();
    if (body != none) {
        this->add_child(statement, body);
        let body_node: syntax::SyntaxNode = this->node(body);
        if (body_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(statement, join_spans(keyword.span, body_node.span));
        }
    }
    return statement;
}

priv fn parse_for_clause(kind: syntax::SyntaxKind, terminator: lexer::TokenKind, allow_declaration: bool) -> usize {
    let wrapper: usize = this->new_node(kind, this->current_token.span, this->current_token_index);
    if (this->match(terminator)) {
        this->set_node_span(wrapper, this->previous_token.span);
        return wrapper;
    }

    var child: usize = syntax::no_index();
    var is_volatile: bool = false;
    if (allow_declaration && this->current_token.kind == lexer::TokenKind.keyword_volatile) {
        is_volatile = true;
        this->advance();
    }
    let at_declaration: bool = this->current_token.kind == lexer::TokenKind.keyword_let ||
        this->current_token.kind == lexer::TokenKind.keyword_var;
    if (allow_declaration && at_declaration) {
        let keyword: lexer::Token = this->current_token;
        let keyword_index: usize = this->current_token_index;
        let is_mutable: bool = this->current_token.kind == lexer::TokenKind.keyword_var;
        this->advance();
        child = this->parse_variable_declaration(keyword, keyword_index, is_mutable, is_volatile, syntax::no_index(),
            0);
    } else {
        child = this->parse_expression_statement(terminator);
    }
    if (child != syntax::no_index()) {
        this->add_child(wrapper, child);
        let child_node: syntax::SyntaxNode = this->node(child);
        if (child_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(wrapper, child_node.span);
        }
    }
    return wrapper;
}

priv fn parse_for_statement(keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.for_statement, keyword.span, keyword_index);
    if (!this->enter_nesting(keyword.span)) {
        return statement;
    }
    this->expect(lexer::TokenKind.left_parenthesis);
    let initializer: usize = this->parse_for_clause(syntax::SyntaxKind.for_initializer, lexer::TokenKind.semicolon,
        true);
    this->add_child(statement, initializer);

    let condition_wrapper: usize = this->new_node(syntax::SyntaxKind.for_condition, this->current_token.span,
        this->current_token_index);
    if (!this->match(lexer::TokenKind.semicolon)) {
        let condition: usize = this->parse_expression();
        if (condition != none) {
            this->add_child(condition_wrapper, condition);
            let condition_node: syntax::SyntaxNode = this->node(condition);
            if (condition_node.kind != syntax::SyntaxKind.invalid) {
                this->set_node_span(condition_wrapper, condition_node.span);
            }
        }
        this->expect(lexer::TokenKind.semicolon);
    }
    this->add_child(statement, condition_wrapper);

    let update: usize = this->parse_for_clause(syntax::SyntaxKind.for_update, lexer::TokenKind.right_parenthesis,
        false);
    this->add_child(statement, update);
    let body: usize = this->parse_block();
    if (body != none) {
        this->add_child(statement, body);
        let body_node: syntax::SyntaxNode = this->node(body);
        if (body_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(statement, join_spans(keyword.span, body_node.span));
        }
    }
    this->leave_nesting();
    return statement;
}

priv fn parse_switch_statement(keyword: lexer::Token, keyword_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.switch_statement, keyword.span, keyword_index);
    if (!this->enter_nesting(keyword.span)) {
        return statement;
    }
    this->expect(lexer::TokenKind.left_parenthesis);
    let expression: usize = this->parse_expression();
    if (expression != none) {
        this->add_child(statement, expression);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->expect(lexer::TokenKind.left_brace);
    for (; this->error_code == runtime::Error.none && !this->at_right_brace_or_end();) {
        let arm_token: lexer::Token = this->current_token;
        let arm_index: usize = this->current_token_index;
        let is_case: bool = this->current_token.kind == lexer::TokenKind.keyword_case;
        let is_default: bool = this->current_token.kind == lexer::TokenKind.keyword_default;
        if (!is_case && !is_default) {
            this->add_diagnostic(lexer::DiagnosticKind.invalid_switch_arm, this->current_token.span,
                lexer::TokenKind.keyword_case, this->current_token.kind, 0);
            this->advance();
            continue;
        }
        this->advance();
        let arm: usize = this->new_node(syntax::SyntaxKind.switch_arm, arm_token.span, arm_index);
        if (is_default) {
            this->add_node_flags(arm, syntax::SyntaxFlag.default_arm as usize);
        } else {
            while (this->error_code == runtime::Error.none) {
                let label: usize = this->parse_switch_label();
                if (label != none) {
                    this->add_child(arm, label);
                }
                if (!this->match(lexer::TokenKind.comma)) {
                    break;
                }
            }
        }
        let body: usize = this->parse_block();
        if (body != none) {
            this->add_child(arm, body);
            let body_node: syntax::SyntaxNode = this->node(body);
            if (body_node.kind != syntax::SyntaxKind.invalid) {
                this->set_node_span(arm, join_spans(arm_token.span, body_node.span));
            }
        }
        this->add_child(statement, arm);
    }
    this->expect(lexer::TokenKind.right_brace);
    this->set_node_span(statement, join_spans(keyword.span, this->previous_token.span));
    this->leave_nesting();
    return statement;
}

priv fn parse_assert_statement() -> usize {
    let keyword: lexer::Token = this->current_token;
    let keyword_index: usize = this->current_token_index;
    this->advance();
    let statement: usize = this->new_node(syntax::SyntaxKind.assert_statement, keyword.span, keyword_index);
    this->expect(lexer::TokenKind.left_parenthesis);
    let expression: usize = this->parse_expression();
    if (expression != syntax::no_index()) {
        this->add_child(statement, expression);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(statement, join_spans(keyword.span, this->previous_token.span));
    return statement;
}

priv fn parse_va_start_statement() -> usize {
    let keyword: lexer::Token = this->current_token;
    let keyword_index: usize = this->current_token_index;
    this->advance();
    let statement: usize = this->new_node(syntax::SyntaxKind.va_start_statement, keyword.span, keyword_index);
    this->expect(lexer::TokenKind.left_parenthesis);
    let expression: usize = this->parse_expression();
    if (expression != syntax::no_index()) {
        this->add_child(statement, expression);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(statement, join_spans(keyword.span, this->previous_token.span));
    return statement;
}

priv fn parse_goto_statement() -> usize {
    let keyword: lexer::Token = this->current_token;
    let keyword_index: usize = this->current_token_index;
    this->advance();
    let statement: usize = this->new_node(syntax::SyntaxKind.goto_statement, keyword.span, keyword_index);
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    if (this->expect(lexer::TokenKind.identifier)) {
        this->add_child(statement, this->new_node(syntax::SyntaxKind.name_expression, name.span, name_index));
    }
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(statement, join_spans(keyword.span, this->previous_token.span));
    return statement;
}

priv fn parse_labeled_statement(name: lexer::Token, name_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let statement: usize = this->new_node(syntax::SyntaxKind.labeled_statement, name.span, name_index);
    this->expect(lexer::TokenKind.colon);
    let inner: usize = this->parse_statement();
    if (inner != none) {
        this->add_child(statement, inner);
        let inner_node: syntax::SyntaxNode = this->node(inner);
        if (inner_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(statement, join_spans(name.span, inner_node.span));
        }
    }
    return statement;
}

priv fn parse_volatile_variable() -> usize {
    this->advance();
    let keyword: lexer::Token = this->current_token;
    let keyword_index: usize = this->current_token_index;
    if (keyword.kind != lexer::TokenKind.keyword_let && keyword.kind != lexer::TokenKind.keyword_var) {
        this->add_diagnostic(lexer::DiagnosticKind.expected_token, keyword.span,
            lexer::TokenKind.keyword_let, keyword.kind, 0);
        return syntax::no_index();
    }
    this->advance();
    return this->parse_variable_declaration(keyword, keyword_index,
        keyword.kind == lexer::TokenKind.keyword_var, true, syntax::no_index(), 0);
}

priv fn parse_attributed_variable() -> usize {
    var first_attribute: usize = syntax::no_index();
    var attribute_count: usize = 0;
    this->parse_attributes(&first_attribute, &attribute_count);
    let keyword: lexer::Token = this->current_token;
    let keyword_index: usize = this->current_token_index;
    if (keyword.kind != lexer::TokenKind.keyword_let && keyword.kind != lexer::TokenKind.keyword_var) {
        this->add_diagnostic(lexer::DiagnosticKind.expected_token, keyword.span,
            lexer::TokenKind.keyword_let, keyword.kind, 0);
        this->attach_attributes(this->syntax_builder.root(), first_attribute, attribute_count);
        return syntax::no_index();
    }
    this->advance();
    return this->parse_variable_declaration(keyword, keyword_index,
        keyword.kind == lexer::TokenKind.keyword_var, false, first_attribute, attribute_count);
}

priv fn parse_control_transfer(token: lexer::Token, token_index: usize) -> usize {
    this->advance();
    let kind: syntax::SyntaxKind = token.kind == lexer::TokenKind.keyword_break ?
        syntax::SyntaxKind.break_statement : syntax::SyntaxKind.continue_statement;
    let statement: usize = this->new_node(kind, token.span, token_index);
    if (this->current_token.kind == lexer::TokenKind.identifier) {
        let name: lexer::Token = this->current_token;
        let name_index: usize = this->current_token_index;
        this->advance();
        this->add_child(statement, this->new_node(syntax::SyntaxKind.name_expression, name.span, name_index));
    }
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(statement, join_spans(token.span, this->previous_token.span));
    return statement;
}

priv fn parse_return_statement(token: lexer::Token, token_index: usize) -> usize {
    this->advance();
    let statement: usize = this->new_node(syntax::SyntaxKind.return_statement, token.span, token_index);
    if (this->current_token.kind != lexer::TokenKind.semicolon) {
        let value: usize = this->parse_expression();
        if (value != syntax::no_index()) {
            this->add_child(statement, value);
        }
    }
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(statement, join_spans(token.span, this->previous_token.span));
    return statement;
}

priv fn parse_statement() -> usize {
    let token: lexer::Token = this->current_token;
    let token_index: usize = this->current_token_index;

    switch (token.kind) {
    case lexer::TokenKind.left_brace {
        return this->parse_block();
    }
    case lexer::TokenKind.identifier {
        if (this->peek_kind() == lexer::TokenKind.colon) {
            this->advance();
            return this->parse_labeled_statement(token, token_index);
        }
        return this->parse_expression_statement(lexer::TokenKind.semicolon);
    }
    case lexer::TokenKind.keyword_let, lexer::TokenKind.keyword_var {
        this->advance();
        return this->parse_variable_declaration(token, token_index, token.kind == lexer::TokenKind.keyword_var, false,
            syntax::no_index(), 0);
    }
    case lexer::TokenKind.keyword_const {
        return this->parse_const_declaration(token, token_index, syntax::SyntaxFlag.none as usize, syntax::no_index(),
            0);
    }
    case lexer::TokenKind.keyword_volatile {
        return this->parse_volatile_variable();
    }
    case lexer::TokenKind.at_sign {
        return this->parse_attributed_variable();
    }
    case lexer::TokenKind.keyword_if {
        this->advance();
        return this->parse_if_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_while {
        this->advance();
        return this->parse_while_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_do {
        this->advance();
        return this->parse_do_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_for {
        this->advance();
        return this->parse_for_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_loop {
        this->advance();
        return this->parse_loop_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_switch {
        this->advance();
        return this->parse_switch_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_break, lexer::TokenKind.keyword_continue {
        return this->parse_control_transfer(token, token_index);
    }
    case lexer::TokenKind.keyword_goto {
        return this->parse_goto_statement();
    }
    case lexer::TokenKind.keyword_return {
        return this->parse_return_statement(token, token_index);
    }
    case lexer::TokenKind.keyword_assert {
        return this->parse_assert_statement();
    }
    case lexer::TokenKind.keyword_va_start {
        return this->parse_va_start_statement();
    }
    default {
        return this->parse_expression_statement(lexer::TokenKind.semicolon);
    }
    }
}
}
