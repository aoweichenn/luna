module luna.bootstrap.frontend.parser;

import luna.bootstrap.frontend.parser.declarations as declarations;
import luna.bootstrap.frontend.parser.state as state;

impl ParseResult {
    init(): diagnostic_storage = lexer::DiagnosticBuffer() {
        this->tree_storage = syntax::syntax_tree_empty();
        this->error_code = runtime::Error.invalid_argument;
    }

    init(tree: syntax::SyntaxTree, diagnostics: lexer::DiagnosticBuffer&&, error: runtime::Error):
            diagnostic_storage = diagnostics as lexer::DiagnosticBuffer&& {
        this->tree_storage = tree;
        this->error_code = error;
    }

    init(other: ParseResult&&): diagnostic_storage = other.diagnostic_storage as lexer::DiagnosticBuffer&& {
        this->tree_storage = other.tree_storage;
        this->error_code = other.error_code;
        other.tree_storage = syntax::syntax_tree_empty();
    }

    fn is_valid() const -> bool {
        if (!this->diagnostic_storage.is_valid()) {
            return false;
        }
        if (this->error_code != runtime::Error.none) {
            return syntax::syntax_tree_storage_is_valid(this->tree_storage);
        }
        return syntax::syntax_tree_is_valid(this->tree_storage);
    }

    fn tree() const -> syntax::SyntaxTree {
        return this->tree_storage;
    }

    fn diagnostics() const -> lexer::DiagnosticView {
        return this->diagnostic_storage.view();
    }

    fn view() const -> ParseView {
        return {tree = this->tree_storage, diagnostics = this->diagnostics(), error = this->error_code};
    }

    fn error() const -> runtime::Error {
        return this->error_code;
    }

    deinit() {
        syntax::syntax_tree_release(this->tree_storage);
        this->tree_storage = syntax::syntax_tree_empty();
    }
}

impl FrontendResult {
    init(): lexical_result = lexer::LexResult(), parse_result = ParseResult() {
        this->error_code = runtime::Error.invalid_argument;
    }

    init(lexical: lexer::LexResult&&, parsed: ParseResult&&, error: runtime::Error):
            lexical_result = lexical as lexer::LexResult&&, parse_result = parsed as ParseResult&& {
        this->error_code = error;
    }

    init(other: FrontendResult&&): lexical_result = other.lexical_result as lexer::LexResult&&,
            parse_result = other.parse_result as ParseResult&& {
        this->error_code = other.error_code;
    }

    fn lexical() const -> lexer::LexResult const& {
        return this->lexical_result;
    }

    fn parsed() const -> ParseResult const& {
        return this->parse_result;
    }

    fn view() const -> FrontendView {
        return {
            lex = this->lexical_result.view(), parse = this->parse_result.view(), error = this->error_code,
        };
    }

    fn error() const -> runtime::Error {
        return this->error_code;
    }

    deinit() {
    }
}

fn parse(source: string_views::string_view, tokens: lexer::TokenView) -> ParseResult {
    if (!state::parser_input_is_valid(source, tokens)) {
        return ParseResult();
    }
    var parser_state: state::State = {
        source = source, tokens = tokens, cursor = 0, current = state::parser_invalid_token(),
        current_index = syntax::syntax_no_index(), previous = state::parser_invalid_token(),
        tree = syntax::syntax_tree_empty(), diagnostics = lexer::DiagnosticBuffer(),
        error = runtime::Error.none, nesting_depth = 0,
    };
    parser_state.tree.token_count = tokens.size();
    state::parser_advance(&parser_state);
    if (parser_state.error == runtime::Error.none) {
        declarations::parse_program(&parser_state);
    }
    if (parser_state.error == runtime::Error.none && !syntax::syntax_tree_is_valid(parser_state.tree)) {
        parser_state.error = runtime::Error.io;
    }
    return ParseResult(parser_state.tree, parser_state.diagnostics as lexer::DiagnosticBuffer&&, parser_state.error);
}

fn frontend_parse(source: string_views::string_view) -> FrontendResult {
    var lexical: lexer::LexResult = lexer::lex(source);
    let lexical_error: runtime::Error = lexical.error();
    if (lexical_error != runtime::Error.none) {
        return FrontendResult(lexical as lexer::LexResult&&, ParseResult(), lexical_error);
    }
    var parsed: ParseResult = parse(source, lexical.tokens());
    let parse_error: runtime::Error = parsed.error();
    return FrontendResult(lexical as lexer::LexResult&&, parsed as ParseResult&&, parse_error);
}
