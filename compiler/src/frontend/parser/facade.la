module luna.compiler.parser;

impl ParseResult {
    init(): tree_storage = syntax::SyntaxTree(), diagnostic_storage = lexer::DiagnosticBuffer() {
        this->error_code = runtime::Error.invalid_argument;
    }

    init(tree: syntax::SyntaxTree&&, diagnostics: lexer::DiagnosticBuffer&&, error: runtime::Error):
            tree_storage = tree as syntax::SyntaxTree&&, diagnostic_storage = diagnostics as lexer::DiagnosticBuffer&& {
        this->error_code = error;
    }

    init(other: ParseResult&&): tree_storage = other.tree_storage as syntax::SyntaxTree&&,
            diagnostic_storage = other.diagnostic_storage as lexer::DiagnosticBuffer&& {
        this->error_code = other.error_code;
    }

    fn is_valid() const -> bool {
        if (!this->diagnostic_storage.is_valid()) {
            return false;
        }
        if (this->error_code != runtime::Error.none) {
            return this->tree_storage.storage_is_valid();
        }
        return this->tree_storage.is_valid();
    }

    fn tree() const -> syntax::SyntaxView {
        return this->tree_storage.view();
    }

    fn diagnostics() const -> lexer::DiagnosticView {
        return this->diagnostic_storage.view();
    }

    fn view() const -> ParseView {
        return {tree = this->tree(), diagnostics = this->diagnostics(), error = this->error_code};
    }

    fn error() const -> runtime::Error {
        return this->error_code;
    }

    deinit() {
    }
}

impl FrontendResult {
    init(): lexical_result = lexer::LexResult(), parse_result = ParseResult() {
        this->error_code = runtime::Error.invalid_argument;
    }

    init(lexical: lexer::LexResult&&, parsed: ParseResult&&, error: runtime::Error):
            lexical_result = lexical as lexer::LexResult&&, parse_result = parsed as ParseResult&& {
        this->error_code = error;
    }

    init(other: FrontendResult&&): lexical_result = other.lexical_result as lexer::LexResult&&,
            parse_result = other.parse_result as ParseResult&& {
        this->error_code = other.error_code;
    }

    fn lexical() const -> lexer::LexResult const& {
        return this->lexical_result;
    }

    fn parsed() const -> ParseResult const& {
        return this->parse_result;
    }

    fn view() const -> FrontendView {
        return {
            lex = this->lexical_result.view(), parse = this->parse_result.view(), error = this->error_code,
        };
    }

    fn error() const -> runtime::Error {
        return this->error_code;
    }

    deinit() {
    }
}

impl Parser {
    init(source: string_views::string_view, tokens: lexer::TokenView):
            tokens = tokens, syntax_builder = syntax::SyntaxBuilder(tokens.size()),
            diagnostics = lexer::DiagnosticBuffer() {
        this->source = source;
        this->tokens = tokens;
        this->next_token_index = 0;
        this->current_token = invalid_token();
        this->current_token_index = syntax::no_index();
        this->previous_token = invalid_token();
        this->error_code = runtime::Error.none;
        this->nesting_depth = 0;
    }

    fn run() {
        this->advance();
        if (this->error_code == runtime::Error.none) {
            this->parse_program();
        }
        if (this->error_code == runtime::Error.none && !this->syntax_builder.view().is_valid()) {
            this->error_code = runtime::Error.io;
        }
    }

    fn take_result() -> ParseResult {
        var tree: syntax::SyntaxTree = this->syntax_builder.take_tree();
        return ParseResult(
            tree as syntax::SyntaxTree&&, this->diagnostics as lexer::DiagnosticBuffer&&, this->error_code);
    }

    deinit() {
    }
}

fn parse(source: string_views::string_view, tokens: lexer::TokenView) -> ParseResult {
    if (!input_is_valid(source, tokens)) {
        return ParseResult();
    }
    var session: Parser = Parser(source, tokens);
    session.run();
    return session.take_result();
}

fn frontend_parse(source: string_views::string_view) -> FrontendResult {
    var lexical: lexer::LexResult = lexer::lex(source);
    let lexical_error: runtime::Error = lexical.error();
    if (lexical_error != runtime::Error.none) {
        return FrontendResult(lexical as lexer::LexResult&&, ParseResult(), lexical_error);
    }
    var parsed: ParseResult = parse(source, lexical.tokens());
    let parse_error: runtime::Error = parsed.error();
    return FrontendResult(lexical as lexer::LexResult&&, parsed as ParseResult&&, parse_error);
}
