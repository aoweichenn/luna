module luna.compiler.parser;

impl Parser {

priv fn parse_generic_parameters() -> usize {
    let none: usize = syntax::no_index();
    if (this->current_token.kind != lexer::TokenKind.less) {
        return none;
    }
    let start: lexer::Token = this->current_token;
    let start_index: usize = this->current_token_index;
    this->advance();
    let parameters: usize = this->new_node(syntax::SyntaxKind.generic_parameters, start.span, start_index);
    for (; this->error_code == runtime::Error.none;) {
        let name: lexer::Token = this->current_token;
        let name_index: usize = this->current_token_index;
        if (!this->expect(lexer::TokenKind.identifier)) {
            break;
        }
        let parameter: usize = this->new_node(syntax::SyntaxKind.generic_parameter, name.span, name_index);
        this->add_child(parameters, parameter);
        if (!this->match(lexer::TokenKind.comma)) {
            break;
        }
    }
    this->expect(lexer::TokenKind.greater);
    this->set_node_span(parameters, join_spans(start.span, this->previous_token.span));
    return parameters;
}

priv fn parse_module_name(declaration: usize) -> bool {
    var saw_name: bool = false;
    while (this->error_code == runtime::Error.none) {
        let name: lexer::Token = this->current_token;
        let name_index: usize = this->current_token_index;
        if (!this->expect(lexer::TokenKind.identifier)) {
            return false;
        }
        let name_node: usize = this->new_node(syntax::SyntaxKind.name_expression, name.span, name_index);
        this->add_child(declaration, name_node);
        saw_name = true;
        if (!this->match(lexer::TokenKind.dot)) {
            break;
        }
    }
    return saw_name;
}

priv fn parse_enum_declaration(start: lexer::Token, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = syntax::no_index();
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    this->expect(lexer::TokenKind.identifier);
    let declaration: usize = this->new_node(syntax::SyntaxKind.enum_declaration, start.span, name_index);
    this->add_node_flags(declaration, flags);
    this->expect(lexer::TokenKind.colon);
    let underlying_type: usize = this->parse_type();
    if (underlying_type != none) {
        this->add_child(declaration, underlying_type);
    }
    this->expect(lexer::TokenKind.left_brace);
    for (; this->error_code == runtime::Error.none && !this->at_right_brace_or_end();) {
        let index_before: usize = this->current_token_index;
        let member_name: lexer::Token = this->current_token;
        let member_index: usize = this->current_token_index;
        if (!this->expect(lexer::TokenKind.identifier)) {
            if (this->current_token.kind != lexer::TokenKind.end) {
                this->advance();
            }
        } else {
            let member: usize = this->new_node(syntax::SyntaxKind.enum_member, member_name.span, member_index);
            if (this->match(lexer::TokenKind.equal)) {
                let initializer: usize = this->parse_expression();
                if (initializer != none) {
                    this->add_child(member, initializer);
                    let initializer_node: syntax::SyntaxNode = this->node(initializer);
                    if (initializer_node.kind != syntax::SyntaxKind.invalid) {
                        this->set_node_span(member, join_spans(member_name.span, initializer_node.span));
                    }
                }
            }
            this->add_child(declaration, member);
        }
        if (!this->match(lexer::TokenKind.comma)) {
            break;
        }
        if (this->current_token.kind == lexer::TokenKind.right_brace) {
            break;
        }
        if (this->current_token_index == index_before && this->current_token.kind != lexer::TokenKind.end) {
            this->advance();
        }
    }
    this->expect(lexer::TokenKind.right_brace);
    this->attach_attributes(declaration, first_attribute, attribute_count);
    this->set_node_span(declaration, join_spans(start.span, this->previous_token.span));
    return declaration;
}

priv fn parse_parameter() -> usize {
    let none: usize = syntax::no_index();
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    if (!this->expect(lexer::TokenKind.identifier)) {
        return none;
    }
    let parameter: usize = this->new_node(syntax::SyntaxKind.parameter, name.span, name_index);
    this->expect(lexer::TokenKind.colon);
    let type_node: usize = this->parse_type();
    if (type_node != none) {
        this->add_child(parameter, type_node);
        let type_value: syntax::SyntaxNode = this->node(type_node);
        if (type_value.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(parameter, join_spans(name.span, type_value.span));
        }
    }
    if (this->match(lexer::TokenKind.equal)) {
        let default_node: usize = this->parse_expression();
        if (default_node != none) {
            this->add_child(parameter, default_node);
            let default_value: syntax::SyntaxNode = this->node(default_node);
            if (default_value.kind != syntax::SyntaxKind.invalid) {
                this->set_node_span(parameter, join_spans(name.span, default_value.span));
            }
        }
    }
    return parameter;
}

priv fn parse_function_declaration(start: lexer::Token, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    this->expect(lexer::TokenKind.identifier);
    return this->parse_function_with_name(start, flags, first_attribute, attribute_count, name, name_index);
}

priv fn parse_constructor_initializer() -> usize {
    let none: usize = syntax::no_index();
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    if (!this->expect(lexer::TokenKind.identifier)) {
        return none;
    }
    let initializer: usize = this->new_node(syntax::SyntaxKind.constructor_initializer, name.span, name_index);
    this->expect(lexer::TokenKind.equal);
    let value: usize = this->parse_expression();
    if (value != none) {
        this->add_child(initializer, value);
        let value_node: syntax::SyntaxNode = this->node(value);
        if (value_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(initializer, join_spans(name.span, value_node.span));
        }
    }
    return initializer;
}

priv fn parse_constructor_initializers(function: usize) {
    if (!this->match(lexer::TokenKind.colon)) {
        return;
    }
    for (; this->error_code == runtime::Error.none;) {
        let initializer: usize = this->parse_constructor_initializer();
        if (initializer != syntax::no_index()) {
            this->add_child(function, initializer);
        }
        if (!this->match(lexer::TokenKind.comma)) {
            return;
        }
        if (this->current_token.kind == lexer::TokenKind.left_brace ||
            this->current_token.kind == lexer::TokenKind.semicolon) {
            return;
        }
    }
}

priv fn parse_function_with_name(start: lexer::Token, flags: usize,
    first_attribute: usize, attribute_count: usize, name: lexer::Token, name_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let function: usize = this->new_node(syntax::SyntaxKind.function_declaration, start.span, name_index);
    this->add_node_flags(function, flags);
    let generic_parameters: usize = this->parse_generic_parameters();
    if (generic_parameters != none) {
        this->add_child(function, generic_parameters);
    }
    this->expect(lexer::TokenKind.left_parenthesis);
    if (this->current_token.kind != lexer::TokenKind.right_parenthesis) {
        while (this->error_code == runtime::Error.none) {
            if (this->current_token.kind == lexer::TokenKind.dot_dot_dot) {
                this->advance();
                this->add_node_flags(function, syntax::SyntaxFlag.variadic as usize);
                break;
            }
            let parameter: usize = this->parse_parameter();
            if (parameter != none) {
                this->add_child(function, parameter);
            }
            if (!this->match(lexer::TokenKind.comma)) {
                break;
            }
        }
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    let member_function: bool = (flags & (syntax::SyntaxFlag.member_function as usize)) != 0;
    if (member_function && this->match(lexer::TokenKind.keyword_const)) {
        this->add_node_flags(function, syntax::SyntaxFlag.read_only as usize);
    }
    if (member_function && this->match(lexer::TokenKind.keyword_volatile)) {
        this->add_node_flags(function, syntax::SyntaxFlag.volatile_ as usize);
    }
    if (this->match(lexer::TokenKind.arrow)) {
        let return_type: usize = this->parse_type();
        if (return_type != none) {
            this->add_child(function, return_type);
        }
    }
    let constructor: bool = (flags & (syntax::SyntaxFlag.constructor as usize)) != 0;
    if (constructor) {
        this->parse_constructor_initializers(function);
    }

    if (this->match(lexer::TokenKind.semicolon)) {
        this->add_node_flags(function, syntax::SyntaxFlag.bodyless as usize);
    } else if ((flags & (syntax::SyntaxFlag.asm_function as usize)) != 0) {
        let body: usize = this->parse_asm_body();
        if (body != none) {
            this->add_child(function, body);
        }
        if ((flags & (syntax::SyntaxFlag.external as usize)) != 0) {
            this->add_diagnostic(lexer::DiagnosticKind.invalid_external_declaration, start.span,
                lexer::TokenKind.semicolon, lexer::TokenKind.left_brace, 0);
        }
    } else {
        let body: usize = this->parse_block();
        if (body != none) {
            this->add_child(function, body);
        }
        if ((flags & (syntax::SyntaxFlag.external as usize)) != 0) {
            this->add_diagnostic(lexer::DiagnosticKind.invalid_external_declaration, start.span,
                lexer::TokenKind.semicolon, lexer::TokenKind.left_brace, 0);
        }
    }
    this->attach_attributes(function, first_attribute, attribute_count);
    this->set_node_span(function, join_spans(start.span, this->previous_token.span));
    return function;
}

priv fn parse_type_alias_declaration(start: lexer::Token, flags: usize, first_attribute: usize,
    attribute_count: usize) -> usize {
    let none: usize = syntax::no_index();
    if ((flags & (syntax::SyntaxFlag.external as usize)) != 0) {
        this->add_diagnostic(lexer::DiagnosticKind.invalid_external_declaration, start.span,
            lexer::TokenKind.keyword_fn, lexer::TokenKind.identifier, 0);
    }
    this->advance();
    let name: lexer::Token = this->current_token;
    let name_index: usize = this->current_token_index;
    this->expect(lexer::TokenKind.identifier);
    let declaration: usize = this->new_node(syntax::SyntaxKind.type_alias_declaration, start.span, name_index);
    this->add_node_flags(declaration, flags);
    let generic_parameters: usize = this->parse_generic_parameters();
    if (generic_parameters != none) {
        this->add_child(declaration, generic_parameters);
    }
    this->expect(lexer::TokenKind.equal);
    if (!this->enter_nesting(start.span)) {
        this->attach_attributes(declaration, first_attribute, attribute_count);
        return declaration;
    }
    let target: usize = this->parse_type();
    if (target != none) {
        this->add_child(declaration, target);
        let target_node: syntax::SyntaxNode = this->node(target);
        if (target_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(declaration, join_spans(start.span, target_node.span));
        }
    }
    this->leave_nesting();
    this->expect(lexer::TokenKind.semicolon);
    this->attach_attributes(declaration, first_attribute, attribute_count);
    return declaration;
}

priv fn at_type_alias_declaration() -> bool {
    let keyword_matches: bool = this->current_token.kind == lexer::TokenKind.identifier &&
        this->identifier_text_is(this->current_token, "type", 4);
    let name_follows: bool = this->token_at(this->current_token_index + 1).kind == lexer::TokenKind.identifier;
    let suffix: lexer::TokenKind = this->token_at(this->current_token_index + 2).kind;
    let alias_suffix: bool = suffix == lexer::TokenKind.equal || suffix == lexer::TokenKind.less;
    let declaration_prefix: bool = keyword_matches && name_follows;
    return declaration_prefix && alias_suffix;
}

priv fn diagnose_invalid_external(flags: usize, start: lexer::Token, found: lexer::TokenKind) {
    if ((flags & (syntax::SyntaxFlag.external as usize)) == 0) {
        return;
    }
    this->add_diagnostic(lexer::DiagnosticKind.invalid_external_declaration, start.span,
        lexer::TokenKind.keyword_fn, found, 0);
}

priv fn parse_top_level_declaration() -> usize {
    let none: usize = syntax::no_index();
    let start: lexer::Token = this->current_token;
    var flags: usize = syntax::SyntaxFlag.none as usize;
    if (this->match(lexer::TokenKind.keyword_export)) {
        flags |= syntax::SyntaxFlag.exported as usize;
    }
    if (this->match(lexer::TokenKind.keyword_extern)) {
        flags |= syntax::SyntaxFlag.external as usize;
    }
    var first_attribute: usize = none;
    var attribute_count: usize = 0;
    this->parse_attributes(&first_attribute, &attribute_count);

    switch (this->current_token.kind) {
    case lexer::TokenKind.keyword_opaque {
        this->advance();
        this->expect(lexer::TokenKind.keyword_class);
        return this->parse_opaque_class_declaration(start, flags, first_attribute, attribute_count);
    }
    case lexer::TokenKind.keyword_final {
        this->advance();
        flags |= syntax::SyntaxFlag.final_class as usize;
        this->expect(lexer::TokenKind.keyword_class);
        this->diagnose_invalid_external(flags, start, lexer::TokenKind.keyword_class);
        return this->parse_aggregate_declaration(start, syntax::SyntaxKind.class_declaration, flags, first_attribute,
            attribute_count, this->parse_class_member);
    }
    case lexer::TokenKind.keyword_struct {
        this->advance();
        this->diagnose_invalid_external(flags, start, lexer::TokenKind.keyword_struct);
        return this->parse_aggregate_declaration(start, syntax::SyntaxKind.structure_declaration, flags,
            first_attribute, attribute_count, this->parse_field);
    }
    case lexer::TokenKind.keyword_union {
        this->advance();
        this->diagnose_invalid_external(flags, start, lexer::TokenKind.keyword_union);
        return this->parse_aggregate_declaration(start, syntax::SyntaxKind.union_declaration, flags, first_attribute,
            attribute_count, this->parse_field);
    }
    case lexer::TokenKind.keyword_class {
        this->advance();
        this->diagnose_invalid_external(flags, start, lexer::TokenKind.keyword_class);
        return this->parse_aggregate_declaration(start, syntax::SyntaxKind.class_declaration, flags, first_attribute,
            attribute_count, this->parse_class_member);
    }
    case lexer::TokenKind.keyword_impl {
        this->advance();
        return this->parse_impl_declaration(start, flags, first_attribute, attribute_count);
    }
    case lexer::TokenKind.keyword_enum {
        this->advance();
        this->diagnose_invalid_external(flags, start, lexer::TokenKind.keyword_enum);
        return this->parse_enum_declaration(start, flags, first_attribute, attribute_count);
    }
    case lexer::TokenKind.keyword_fn {
        this->advance();
        return this->parse_function_declaration(start, flags, first_attribute, attribute_count);
    }
    case lexer::TokenKind.keyword_asm {
        if (this->token_at(this->current_token_index + 1).kind == lexer::TokenKind.keyword_fn) {
            this->advance();
            this->advance();
            return this->parse_function_declaration(start, flags | (syntax::SyntaxFlag.asm_function as usize),
                first_attribute, attribute_count);
        }
    }
    case lexer::TokenKind.keyword_const {
        if (this->token_at(this->current_token_index + 1).kind == lexer::TokenKind.keyword_fn) {
            this->diagnose_invalid_external(flags, start, lexer::TokenKind.keyword_const);
            this->advance();
            this->advance();
            return this->parse_function_declaration(start, flags | (syntax::SyntaxFlag.const_function as usize),
                first_attribute, attribute_count);
        }
        return this->parse_const_declaration(start, this->current_token_index, flags, first_attribute, attribute_count);
    }
    case lexer::TokenKind.identifier {
        if (this->at_type_alias_declaration()) {
            return this->parse_type_alias_declaration(start, flags, first_attribute, attribute_count);
        }
    }
    case lexer::TokenKind.keyword_assert {
        this->attach_attributes(this->syntax_builder.root(), first_attribute, attribute_count);
        return this->parse_assert_statement();
    }
    default {}
    }

    this->add_diagnostic(lexer::DiagnosticKind.expected_declaration, this->current_token.span,
        lexer::TokenKind.keyword_fn, this->current_token.kind, 0);
    this->attach_attributes(this->syntax_builder.root(), first_attribute, attribute_count);
    if (this->current_token.kind != lexer::TokenKind.end) {
        this->advance();
    }
    return none;
}

priv fn parse_program() -> usize {
    let none: usize = syntax::no_index();
    let start: lexer::Token = this->current_token;
    let start_index: usize = this->current_token_index;
    var interface_unit: bool = false;
    if (this->match(lexer::TokenKind.keyword_export)) {
        interface_unit = true;
    }
    let module_keyword: lexer::Token = this->current_token;
    let module_index: usize = this->current_token_index;
    this->expect(lexer::TokenKind.keyword_module);
    let program: usize = this->new_node(syntax::SyntaxKind.program, start.span, start_index);
    if (!this->syntax_builder.set_root(program)) {
        this->error_code = this->syntax_builder.error();
        return none;
    }
    if (interface_unit) {
        this->add_node_flags(program, syntax::SyntaxFlag.interface_unit as usize);
    }

    let module_declaration: usize = this->new_node(syntax::SyntaxKind.module_declaration, module_keyword.span,
        module_index);
    this->parse_module_name(module_declaration);
    this->expect(lexer::TokenKind.semicolon);
    this->set_node_span(module_declaration, join_spans(module_keyword.span, this->previous_token.span));
    this->add_child(program, module_declaration);

    while (this->current_token.kind == lexer::TokenKind.keyword_import) {
        let import_keyword: lexer::Token = this->current_token;
        let import_index: usize = this->current_token_index;
        this->advance();
        let import_declaration: usize =
            this->new_node(syntax::SyntaxKind.import_declaration, import_keyword.span, import_index);
        this->parse_module_name(import_declaration);
        // 别名 import 只绑定限定符，别名作为模块名后的末尾 name_expression 子节点保存。
        if (this->match(lexer::TokenKind.keyword_as)) {
            let alias: lexer::Token = this->current_token;
            let alias_index: usize = this->current_token_index;
            if (this->expect(lexer::TokenKind.identifier)) {
                this->add_node_flags(import_declaration, syntax::SyntaxFlag.aliased_import as usize);
                this->add_child(import_declaration,
                    this->new_node(syntax::SyntaxKind.name_expression, alias.span, alias_index));
            }
        }
        // 选择性 import 平铺绑定列出的名称；末尾容器保存名称，语义阶段负责拒绝与别名组合。
        let colons: lexer::Token = this->current_token;
        let colons_index: usize = this->current_token_index;
        if (this->match(lexer::TokenKind.colon_colon)) {
            this->add_node_flags(import_declaration, syntax::SyntaxFlag.selective_import as usize);
            let selective_node: usize =
                this->new_node(syntax::SyntaxKind.selective_import_names, colons.span, colons_index);
            if (this->expect(lexer::TokenKind.left_brace)) {
                while (this->error_code == runtime::Error.none &&
                    this->current_token.kind == lexer::TokenKind.identifier) {
                    let selective_name: lexer::Token = this->current_token;
                    let selective_name_index: usize = this->current_token_index;
                    this->advance();
                    this->add_child(selective_node,
                        this->new_node(syntax::SyntaxKind.name_expression, selective_name.span, selective_name_index));
                    if (!this->match(lexer::TokenKind.comma)) {
                        break;
                    }
                }
                if (this->expect(lexer::TokenKind.right_brace)) {
                    this->set_node_span(selective_node, join_spans(colons.span, this->previous_token.span));
                }
            }
            this->add_child(import_declaration, selective_node);
        }
        this->expect(lexer::TokenKind.semicolon);
        this->set_node_span(import_declaration, join_spans(import_keyword.span, this->previous_token.span));
        this->add_child(program, import_declaration);
    }

    while (this->error_code == runtime::Error.none && this->current_token.kind != lexer::TokenKind.end) {
        let index_before: usize = this->current_token_index;
        let declaration: usize = this->parse_top_level_declaration();
        if (declaration != none) {
            this->add_child(program, declaration);
        }
        if (this->current_token_index == index_before && this->current_token.kind != lexer::TokenKind.end) {
            this->advance();
        }
    }
    let end_span: lexer::SourceSpan = this->current_token.kind == lexer::TokenKind.end ?
            this->current_token.span : this->previous_token.span;
    this->set_node_span(program, join_spans(start.span, end_span));
    return program;
}
}
