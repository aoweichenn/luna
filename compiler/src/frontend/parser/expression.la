module luna.compiler.parser;

impl Parser {

priv fn parse_expression() -> usize {
    return this->parse_conditional_expression();
}

priv fn at_aggregate_end() -> bool {
    return this->current_token.kind == lexer::TokenKind.right_brace || this->current_token.kind == lexer::TokenKind.end;
}

priv fn parse_aggregate_initializer(left_brace: lexer::Token, left_brace_index: usize) -> usize {
    let none: usize = syntax::no_index();
    if (this->match(lexer::TokenKind.right_brace)) {
        return this->new_node(syntax::SyntaxKind.zero_initializer,
            join_spans(left_brace.span, this->previous_token.span), left_brace_index);
    }

    let initializer: usize = this->new_node(syntax::SyntaxKind.aggregate_initializer, left_brace.span,
        left_brace_index);
    if (!this->enter_nesting(left_brace.span)) {
        return initializer;
    }
    for (; this->error_code == runtime::Error.none && !this->at_aggregate_end();) {
        let offset_before: usize = this->current_token.span.offset;
        if (this->current_token.kind == lexer::TokenKind.left_bracket) {
            let bracket: lexer::Token = this->current_token;
            let bracket_index: usize = this->current_token_index;
            this->advance();
            let element: usize = this->new_node(syntax::SyntaxKind.initializer_element, bracket.span, bracket_index);
            this->add_node_flags(element, syntax::SyntaxFlag.indexed as usize);
            let index: usize = this->parse_expression();
            if (index != none) {
                this->add_child(element, index);
            }
            this->expect(lexer::TokenKind.right_bracket);
            this->expect(lexer::TokenKind.equal);
            let indexed_value: usize = this->parse_expression();
            if (indexed_value != none) {
                this->add_child(element, indexed_value);
                let value_node: syntax::SyntaxNode = this->node(indexed_value);
                if (value_node.kind != syntax::SyntaxKind.invalid) {
                    this->set_node_span(element, join_spans(bracket.span, value_node.span));
                }
            }
            this->add_child(initializer, element);
        } else if (this->current_token.kind == lexer::TokenKind.identifier &&
            this->token_at(this->current_token_index + 1).kind == lexer::TokenKind.equal) {
            let name: lexer::Token = this->current_token;
            let name_index: usize = this->current_token_index;
            this->advance();
            let field: usize = this->new_node(syntax::SyntaxKind.initializer_field, name.span, name_index);
            this->expect(lexer::TokenKind.equal);
            let value: usize = this->parse_expression();
            if (value != none) {
                this->add_child(field, value);
                let value_node: syntax::SyntaxNode = this->node(value);
                if (value_node.kind != syntax::SyntaxKind.invalid) {
                    this->set_node_span(field, join_spans(name.span, value_node.span));
                }
            }
            this->add_child(initializer, field);
        } else {
            let value_index: usize = this->current_token_index;
            let value: usize = this->parse_expression();
            if (value != none) {
                let value_node: syntax::SyntaxNode = this->node(value);
                let element: usize = this->new_node(syntax::SyntaxKind.initializer_element,
                    value_node.kind == syntax::SyntaxKind.invalid ? this->previous_token.span : value_node.span,
                        value_index);
                this->add_child(element, value);
                this->add_child(initializer, element);
            } else if (this->current_token.kind != lexer::TokenKind.end) {
                this->advance();
            }
        }

        if (!this->match(lexer::TokenKind.comma)) {
            break;
        }
        if (this->current_token.kind == lexer::TokenKind.right_brace) {
            break;
        }
        if (this->current_token.span.offset == offset_before && this->current_token.kind != lexer::TokenKind.end) {
            this->advance();
        }
    }
    this->expect(lexer::TokenKind.right_brace);
    this->set_node_span(initializer, join_spans(left_brace.span, this->previous_token.span));
    this->leave_nesting();
    return initializer;
}

priv fn parse_call(callee: usize, left_parenthesis: lexer::Token, left_parenthesis_index: usize) -> usize {
    let none: usize = syntax::no_index();
    let callee_node: syntax::SyntaxNode = this->node(callee);
    let start_span: lexer::SourceSpan = callee_node.kind == syntax::SyntaxKind.invalid ? left_parenthesis.span :
        callee_node.span;
    let call: usize = this->new_node(syntax::SyntaxKind.call_expression, start_span, left_parenthesis_index);
    this->add_child(call, callee);
    if (!this->enter_nesting(left_parenthesis.span)) {
        return call;
    }
    if (this->current_token.kind != lexer::TokenKind.right_parenthesis) {
        while (this->error_code == runtime::Error.none) {
            let argument: usize = this->parse_expression();
            if (argument != none) {
                this->add_child(call, argument);
            }
            if (!this->match(lexer::TokenKind.comma)) {
                break;
            }
        }
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->set_node_span(call, join_spans(start_span, this->previous_token.span));
    this->leave_nesting();
    return call;
}

priv fn parse_intrinsic_expression(at_sign: lexer::Token) -> usize {
    let none: usize = syntax::no_index();
    let name_index: usize = this->current_token_index;
    let intrinsic: usize = this->new_node(syntax::SyntaxKind.intrinsic_expression, at_sign.span, name_index);
    if (this->expect(lexer::TokenKind.identifier) && this->expect(lexer::TokenKind.left_parenthesis)) {
        if (!this->enter_nesting(at_sign.span)) {
            return intrinsic;
        }
        if (this->current_token.kind != lexer::TokenKind.right_parenthesis) {
            while (this->error_code == runtime::Error.none) {
                let argument: usize = this->parse_expression();
                if (argument != none) {
                    this->add_child(intrinsic, argument);
                }
                if (!this->match(lexer::TokenKind.comma)) {
                    break;
                }
            }
        }
        this->expect(lexer::TokenKind.right_parenthesis);
        this->leave_nesting();
    }
    this->set_node_span(intrinsic, join_spans(at_sign.span, this->previous_token.span));
    return intrinsic;
}

priv fn parse_layout_query(keyword: lexer::Token, keyword_index: usize) -> usize {
    if (!this->enter_nesting(keyword.span)) {
        return syntax::no_index();
    }
    var kind: syntax::SyntaxKind = syntax::SyntaxKind.sizeof_expression;
    if (keyword.kind == lexer::TokenKind.keyword_alignof) {
        kind = syntax::SyntaxKind.alignof_expression;
    } else if (keyword.kind == lexer::TokenKind.keyword_offsetof) {
        kind = syntax::SyntaxKind.offsetof_expression;
    }
    let query: usize = this->new_node(kind, keyword.span, keyword_index);
    this->expect(lexer::TokenKind.left_parenthesis);
    var operand: usize = syntax::no_index();
    if (this->current_token.kind == lexer::TokenKind.at_sign) {
        // 布局查询也接受内建表达式操作数；语义阶段从降级后表达式的类型读取布局。
        let at_sign: lexer::Token = this->current_token;
        this->advance();
        operand = this->parse_intrinsic_expression(at_sign);
    } else {
        operand = this->parse_type();
    }
    if (operand != syntax::no_index()) {
        this->add_child(query, operand);
    }
    if (keyword.kind == lexer::TokenKind.keyword_offsetof) {
        this->expect(lexer::TokenKind.comma);
        let member: lexer::Token = this->current_token;
        let member_index: usize = this->current_token_index;
        if (this->expect(lexer::TokenKind.identifier)) {
            let member_node: usize = this->new_node(syntax::SyntaxKind.name_expression, member.span, member_index);
            this->add_child(query, member_node);
        }
        while (this->match(lexer::TokenKind.dot)) {
            let nested: lexer::Token = this->current_token;
            let nested_index: usize = this->current_token_index;
            if (!this->expect(lexer::TokenKind.identifier)) {
                break;
            }
            let nested_node: usize = this->new_node(syntax::SyntaxKind.name_expression, nested.span, nested_index);
            this->add_child(query, nested_node);
        }
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->set_node_span(query, join_spans(keyword.span, this->previous_token.span));
    this->leave_nesting();
    return query;
}

priv fn parse_va_arg_expression(keyword: lexer::Token, keyword_index: usize) -> usize {
    if (!this->enter_nesting(keyword.span)) {
        return syntax::no_index();
    }
    let query: usize = this->new_node(syntax::SyntaxKind.va_arg_expression, keyword.span, keyword_index);
    this->expect(lexer::TokenKind.left_parenthesis);
    let list_expression: usize = this->parse_expression();
    if (list_expression != syntax::no_index()) {
        this->add_child(query, list_expression);
    }
    this->expect(lexer::TokenKind.comma);
    let type_node: usize = this->parse_type();
    if (type_node != syntax::no_index()) {
        this->add_child(query, type_node);
    }
    this->expect(lexer::TokenKind.right_parenthesis);
    this->set_node_span(query, join_spans(keyword.span, this->previous_token.span));
    this->leave_nesting();
    return query;
}

priv fn parse_string_expression(token: lexer::Token, token_index: usize) -> usize {
    this->advance();
    let node: usize = this->new_node(syntax::SyntaxKind.string_expression, token.span, token_index);
    for (; is_string_token(this->current_token.kind);) {
        let part: lexer::Token = this->current_token;
        let part_index: usize = this->current_token_index;
        this->advance();
        this->add_child(node, this->new_node(syntax::SyntaxKind.string_expression, part.span, part_index));
        this->set_node_span(node, join_spans(token.span, this->previous_token.span));
    }
    return node;
}

priv fn parse_parenthesized_expression(token: lexer::Token, token_index: usize) -> usize {
    this->advance();
    if (!this->enter_nesting(token.span)) {
        return syntax::no_index();
    }
    let expression: usize = this->parse_expression();
    this->expect(lexer::TokenKind.right_parenthesis);
    let node: usize = this->new_node(syntax::SyntaxKind.parenthesized_expression,
        join_spans(token.span, this->previous_token.span), token_index);
    if (expression != syntax::no_index()) {
        this->add_child(node, expression);
    }
    this->leave_nesting();
    return node;
}

priv fn parse_primary_expression() -> usize {
    let token: lexer::Token = this->current_token;
    let token_index: usize = this->current_token_index;

    switch (token.kind) {
    case lexer::TokenKind.keyword_va_arg {
        this->advance();
        return this->parse_va_arg_expression(token, token_index);
    }
    case lexer::TokenKind.keyword_sizeof, lexer::TokenKind.keyword_alignof, lexer::TokenKind.keyword_offsetof {
        this->advance();
        return this->parse_layout_query(token, token_index);
    }
    case lexer::TokenKind.at_sign {
        this->advance();
        return this->parse_intrinsic_expression(token);
    }
    case lexer::TokenKind.integer {
        this->advance();
        this->parse_integer_token(token);
        return this->new_node(syntax::SyntaxKind.integer_expression, token.span, token_index);
    }
    case lexer::TokenKind.floating {
        this->advance();
        this->validate_float(token);
        return this->new_node(syntax::SyntaxKind.floating_expression, token.span, token_index);
    }
    case lexer::TokenKind.character {
        this->advance();
        return this->new_node(syntax::SyntaxKind.character_expression, token.span, token_index);
    }
    case lexer::TokenKind.keyword_true, lexer::TokenKind.keyword_false {
        this->advance();
        return this->new_node(syntax::SyntaxKind.boolean_expression, token.span, token_index);
    }
    case lexer::TokenKind.string, lexer::TokenKind.string_u16, lexer::TokenKind.string_u32 {
        return this->parse_string_expression(token, token_index);
    }
    case lexer::TokenKind.keyword_null {
        this->advance();
        return this->new_node(syntax::SyntaxKind.null_expression, token.span, token_index);
    }
    case lexer::TokenKind.keyword_this {
        this->advance();
        return this->new_node(syntax::SyntaxKind.this_expression, token.span, token_index);
    }
    case lexer::TokenKind.keyword_super {
        this->advance();
        return this->new_node(syntax::SyntaxKind.super_expression, token.span, token_index);
    }
    case lexer::TokenKind.left_brace {
        this->advance();
        return this->parse_aggregate_initializer(token, token_index);
    }
    case lexer::TokenKind.identifier {
        this->advance();
        return this->parse_qualified_name(token, token_index, syntax::SyntaxKind.name_expression);
    }
    case lexer::TokenKind.left_parenthesis {
        return this->parse_parenthesized_expression(token, token_index);
    }
    default {
        this->add_diagnostic(lexer::DiagnosticKind.expected_expression, token.span,
            lexer::TokenKind.identifier, token.kind, 0);
        if (token.kind != lexer::TokenKind.end) {
            this->advance();
        }
        return this->new_node(syntax::SyntaxKind.invalid, token.span, token_index);
    }
    }
}

priv fn parse_postfix_expression() -> usize {
    let none: usize = syntax::no_index();
    var expression: usize = this->parse_primary_expression();
    for (; expression != none && this->error_code == runtime::Error.none;) {
        if (this->current_token.kind == lexer::TokenKind.less) {
            var expression_node: syntax::SyntaxNode = this->node(expression);
            let generic_base: bool = expression_node.kind == syntax::SyntaxKind.name_expression ||
                expression_node.kind == syntax::SyntaxKind.member_expression;
            if (generic_base) {
                let mark: ParserMark = this->mark();
                let diagnostic_count: usize = this->diagnostics.size();
                let arguments: usize = this->parse_generic_arguments();
                let member_postfix: bool = this->current_token.kind == lexer::TokenKind.dot ||
                    this->current_token.kind == lexer::TokenKind.arrow;
                let postfix_follows: bool = this->current_token.kind == lexer::TokenKind.left_parenthesis ||
                    member_postfix;
                let parsed: bool = arguments != none && this->diagnostics.size() == diagnostic_count;
                if (parsed && postfix_follows) {
                    expression_node = this->node(expression);
                    let arguments_node: syntax::SyntaxNode = this->node(arguments);
                    if (expression_node.kind == syntax::SyntaxKind.invalid ||
                        arguments_node.kind == syntax::SyntaxKind.invalid) {
                        return none;
                    }
                    let expression_value: syntax::SyntaxNode = expression_node;
                    let arguments_value: syntax::SyntaxNode = arguments_node;
                    let generic: usize = this->new_node(syntax::SyntaxKind.generic_expression, expression_value.span,
                        expression_value.token_index);
                    this->add_child(generic, expression);
                    this->add_child(generic, arguments);
                    this->set_node_span(generic, join_spans(expression_value.span, arguments_value.span));
                    expression = generic;
                    continue;
                }
                this->restore(mark);
            }
        }
        if (this->current_token.kind == lexer::TokenKind.left_parenthesis) {
            let operation_token: lexer::Token = this->current_token;
            let operation_index: usize = this->current_token_index;
            this->advance();
            expression = this->parse_call(expression, operation_token, operation_index);
            continue;
        }
        if (this->current_token.kind == lexer::TokenKind.left_bracket) {
            let operation_token: lexer::Token = this->current_token;
            let operation_index: usize = this->current_token_index;
            this->advance();
            if (!this->enter_nesting(operation_token.span)) {
                return expression;
            }
            let index: usize = this->parse_expression();
            this->expect(lexer::TokenKind.right_bracket);
            let expression_node: syntax::SyntaxNode = this->node(expression);
            let start_span: lexer::SourceSpan = expression_node.kind == syntax::SyntaxKind.invalid ?
                operation_token.span : expression_node.span;
            let indexed: usize = this->new_node(syntax::SyntaxKind.index_expression,
                join_spans(start_span, this->previous_token.span), operation_index);
            this->add_child(indexed, expression);
            if (index != none) {
                this->add_child(indexed, index);
            }
            this->leave_nesting();
            expression = indexed;
            continue;
        }
        if (this->current_token.kind == lexer::TokenKind.dot || this->current_token.kind == lexer::TokenKind.arrow) {
            let operation_token: lexer::Token = this->current_token;
            let operation_index: usize = this->current_token_index;
            this->advance();
            let name: lexer::Token = this->current_token;
            let name_index: usize = this->current_token_index;
            let expression_node: syntax::SyntaxNode = this->node(expression);
            let start_span: lexer::SourceSpan = expression_node.kind == syntax::SyntaxKind.invalid ?
                operation_token.span : expression_node.span;
            let member: usize = this->new_node(syntax::SyntaxKind.member_expression, start_span, operation_index);
            this->add_child(member, expression);
            if (this->expect(lexer::TokenKind.identifier)) {
                let name_node: usize = this->new_node(syntax::SyntaxKind.name_expression, name.span, name_index);
                this->add_child(member, name_node);
                this->set_node_span(member, join_spans(start_span, name.span));
            }
            expression = member;
            continue;
        }
        break;
    }
    return expression;
}

priv fn parse_unary_expression() -> usize {
    if (!is_unary_operator(
            this->current_token.kind)) {
        return this->parse_postfix_expression();
    }
    let operation_token: lexer::Token = this->current_token;
    let operation_index: usize = this->current_token_index;
    if (!this->enter_nesting(operation_token.span)) {
        return syntax::no_index();
    }
    this->advance();
    let operand: usize = this->parse_unary_expression();
    this->leave_nesting();
    let node: usize = this->new_node(syntax::SyntaxKind.unary_expression, operation_token.span, operation_index);
    if (operand != syntax::no_index()) {
        this->add_child(node, operand);
        let operand_node: syntax::SyntaxNode = this->node(operand);
        if (operand_node.kind != syntax::SyntaxKind.invalid) {
            this->set_node_span(node, join_spans(operation_token.span, operand_node.span));
        }
    }
    return node;
}

priv fn parse_cast_expression() -> usize {
    let none: usize = syntax::no_index();
    var expression: usize = this->parse_unary_expression();
    while (expression != none && this->current_token.kind == lexer::TokenKind.keyword_as) {
        let operation_token: lexer::Token = this->current_token;
        let operation_index: usize = this->current_token_index;
        this->advance();
        let target: usize = this->parse_type();
        let expression_node: syntax::SyntaxNode = this->node(expression);
        var target_node: syntax::SyntaxNode = {};
        if (target != none) {
            target_node = this->node(target);
        }
        var span: lexer::SourceSpan = operation_token.span;
        if (expression_node.kind != syntax::SyntaxKind.invalid && target_node.kind != syntax::SyntaxKind.invalid) {
            span = join_spans(expression_node.span, target_node.span);
        }
        let cast: usize = this->new_node(syntax::SyntaxKind.cast_expression, span, operation_index);
        this->add_child(cast, expression);
        if (target != none) {
            this->add_child(cast, target);
        }
        expression = cast;
    }
    return expression;
}

priv fn parse_binary_expression(minimum_precedence: usize) -> usize {
    let none: usize = syntax::no_index();
    var left: usize = this->parse_cast_expression();
    if (left == none) {
        return none;
    }
    while (this->error_code == runtime::Error.none) {
        let precedence: usize = binary_precedence(this->current_token.kind);
        if (precedence < minimum_precedence) {
            break;
        }
        let operation_token: lexer::Token = this->current_token;
        let operation_index: usize = this->current_token_index;
        this->advance();
        let right: usize = this->parse_binary_expression(precedence + 1);
        if (right == none) {
            return left;
        }
        let left_node: syntax::SyntaxNode = this->node(left);
        let right_node: syntax::SyntaxNode = this->node(right);
        var span: lexer::SourceSpan = operation_token.span;
        if (left_node.kind != syntax::SyntaxKind.invalid && right_node.kind != syntax::SyntaxKind.invalid) {
            span = join_spans(left_node.span, right_node.span);
        }
        let binary: usize = this->new_node(syntax::SyntaxKind.binary_expression, span, operation_index);
        this->add_child(binary, left);
        this->add_child(binary, right);
        left = binary;
    }
    return left;
}

priv fn parse_conditional_expression() -> usize {
    let none: usize = syntax::no_index();
    let condition: usize = this->parse_binary_expression(1);
    if (condition == none || this->current_token.kind != lexer::TokenKind.question) {
        return condition;
    }
    let question: lexer::Token = this->current_token;
    let question_index: usize = this->current_token_index;
    this->advance();
    if (!this->enter_nesting(question.span)) {
        return condition;
    }
    let then_expression: usize = this->parse_expression();
    this->expect(lexer::TokenKind.colon);
    let else_expression: usize = this->parse_conditional_expression();
    this->leave_nesting();
    let condition_node: syntax::SyntaxNode = this->node(condition);
    var else_node: syntax::SyntaxNode = {};
    if (else_expression != none) {
        else_node = this->node(else_expression);
    }
    var span: lexer::SourceSpan = question.span;
    if (condition_node.kind != syntax::SyntaxKind.invalid && else_node.kind != syntax::SyntaxKind.invalid) {
        span = join_spans(condition_node.span, else_node.span);
    }
    let conditional: usize = this->new_node(syntax::SyntaxKind.conditional_expression, span, question_index);
    this->add_child(conditional, condition);
    if (then_expression != none) {
        this->add_child(conditional, then_expression);
    }
    if (else_expression != none) {
        this->add_child(conditional, else_expression);
    }
    return conditional;
}

priv fn parse_switch_label() -> usize {
    if (this->current_token.kind == lexer::TokenKind.identifier) {
        return this->parse_postfix_expression();
    }
    let none: usize = syntax::no_index();
    var sign: lexer::Token = invalid_token();
    var sign_index: usize = none;
    if (this->current_token.kind == lexer::TokenKind.plus || this->current_token.kind == lexer::TokenKind.minus) {
        sign = this->current_token;
        sign_index = this->current_token_index;
        this->advance();
    }
    let literal: lexer::Token = this->current_token;
    let literal_index: usize = this->current_token_index;
    if (!this->expect(lexer::TokenKind.integer)) {
        return none;
    }
    this->parse_integer_token(literal);
    let literal_node: usize = this->new_node(syntax::SyntaxKind.integer_expression, literal.span, literal_index);
    if (sign_index == none) {
        return literal_node;
    }
    let unary: usize = this->new_node(syntax::SyntaxKind.unary_expression, join_spans(sign.span, literal.span),
        sign_index);
    this->add_child(unary, literal_node);
    return unary;
}
}
