module luna.compiler.syntax;

fn empty_span() -> lexer::SourceSpan {
    return {offset = 0, length = 0, line = 0, column = 0};
}

fn invalid_node() -> SyntaxNode {
    let none: usize = no_index();
    return {
        kind = SyntaxKind.invalid, span = empty_span(), token_index = none,
        parent = none, first_child = none, last_child = none,
        next_sibling = none, child_count = 0, flags = SyntaxFlag.none as usize,
    };
}

fn no_index() -> usize {
    return SyntaxLimit.maximum_size as usize;
}

fn maximum_nodes() -> usize {
    return SyntaxLimit.maximum_nodes as usize;
}

impl SyntaxView {
    init(data: *const SyntaxNode, count: usize, token_count: usize, root: usize) {
        this->data_pointer = data;
        this->node_count = count;
        this->source_token_count = token_count;
        this->root_index = root;
    }

    fn storage_is_valid() const -> bool {
        let data_is_valid: bool = this->data_pointer != null || this->node_count == 0;
        return data_is_valid && this->node_count <= SyntaxLimit.maximum_nodes as usize;
    }

    fn empty() const -> bool {
        return this->node_count == 0;
    }

    fn size() const -> usize {
        return this->node_count;
    }

    fn token_count() const -> usize {
        return this->source_token_count;
    }

    fn root() const -> usize {
        return this->root_index;
    }

    fn get(index: usize) const -> SyntaxNodeResult {
        if (!this->storage_is_valid() || index >= this->node_count) {
            return {node = invalid_node(), error = runtime::Error.invalid_argument};
        }
        return {node = this->data_pointer[index], error = runtime::Error.none};
    }
}

impl SyntaxTree {
    init(): nodes = vector::vector<SyntaxNode>() {
        this->source_token_count = 0;
        this->root_index = no_index();
    }

    init(other: SyntaxTree&&): nodes = other.nodes as vector::vector<SyntaxNode>&& {
        this->source_token_count = other.source_token_count;
        this->root_index = other.root_index;
        other.source_token_count = 0;
        other.root_index = no_index();
    }

    fn storage_is_valid() const -> bool {
        return this->nodes.is_valid() && this->nodes.size() <= SyntaxLimit.maximum_nodes as usize;
    }

    fn is_valid() const -> bool {
        return this->view().is_valid();
    }

    fn empty() const -> bool {
        return this->nodes.empty();
    }

    fn size() const -> usize {
        return this->nodes.size();
    }

    fn token_count() const -> usize {
        return this->source_token_count;
    }

    fn root() const -> usize {
        return this->root_index;
    }

    fn view() const -> SyntaxView {
        let data: *const SyntaxNode = this->nodes.empty() ? null : &this->nodes.get(0) as *const SyntaxNode;
        return SyntaxView(data, this->nodes.size(), this->source_token_count, this->root_index);
    }

    fn get(index: usize) const -> SyntaxNodeResult {
        return this->view().get(index);
    }

    deinit() {
    }
}
