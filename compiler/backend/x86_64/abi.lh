export module luna.bootstrap.backend.x86_64.abi;

import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.bytes as bytes;

export enum Class: usize {
    invalid, no_class, integer, sse, memory,
}

export enum LocationKind: usize {
    invalid, general_register, vector_register, stack,
}

export struct Classification {
    eightbyte_count: usize;
    first: Class;
    second: Class;
}

export struct Piece {
    abi_class: Class;
    location: LocationKind;
    register_index: usize;
    value_offset_bytes: usize;
    size_bytes: usize;
}

export struct Parameter {
    function_id: usize;
    parameter_index: usize;
    abi_class: Class;
    location: LocationKind;
    register_index: usize;
    stack_offset_bytes: usize;
    stack_size_bytes: usize;
    type_id: usize;
    size_bytes: usize;
    alignment_bytes: usize;
    first_piece: usize;
    piece_count: usize;
    aggregate: bool;
}

export struct Function {
    function_id: usize;
    first_parameter: usize;
    parameter_count: usize;
    first_return_piece: usize;
    return_piece_count: usize;
    return_type: usize;
    return_size_bytes: usize;
    return_alignment_bytes: usize;
    return_aggregate: bool;
    hidden_return_pointer: bool;
    general_register_count: usize;
    vector_register_count: usize;
    stack_argument_size_bytes: usize;
    call_frame_size_bytes: usize;
}

export struct Abi {
    functions: bytes::Buffer;
    function_count: usize;
    parameters: bytes::Buffer;
    parameter_count: usize;
    pieces: bytes::Buffer;
    piece_count: usize;
    error: runtime::Error;
}

export struct Result {
    abi: Abi;
    error: runtime::Error;
}

export struct FunctionResult {
    function: Function;
    error: runtime::Error;
}

export struct ParameterResult {
    parameter: Parameter;
    error: runtime::Error;
}

export struct PieceResult {
    piece: Piece;
    error: runtime::Error;
}

export fn no_id() -> usize;
export fn empty() -> Abi;
export fn storage_is_valid(abi: Abi) -> bool;
export fn classify(types: type_info::Table, type_id: usize) -> Classification;
export fn analyze(ir: ir::Store, types: type_info::Table) -> Result;
export fn is_valid(
    abi: Abi, ir: ir::Store, types: type_info::Table) -> bool;
export fn get_function(
    abi: Abi, function_id: usize) -> FunctionResult;
export fn get_parameter(
    abi: Abi, parameter_id: usize) -> ParameterResult;
export fn get_piece(abi: Abi, piece_id: usize) -> PieceResult;
export fn release(abi: Abi) -> runtime::Error;

