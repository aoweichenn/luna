export module luna.bootstrap.backend.x86_64.abi;

import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.type;
import luna.runtime;
import luna.std.bytes;

export enum BootstrapX8664AbiClass: usize {
    invalid, no_class, integer, sse, memory,
}

export enum BootstrapX8664AbiLocationKind: usize {
    invalid, general_register, vector_register, stack,
}

export struct BootstrapX8664AbiClassification {
    eightbyte_count: usize;
    first: BootstrapX8664AbiClass;
    second: BootstrapX8664AbiClass;
}

export struct BootstrapX8664AbiPiece {
    abi_class: BootstrapX8664AbiClass;
    location: BootstrapX8664AbiLocationKind;
    register_index: usize;
    value_offset_bytes: usize;
    size_bytes: usize;
}

export struct BootstrapX8664AbiParameter {
    function_id: usize;
    parameter_index: usize;
    abi_class: BootstrapX8664AbiClass;
    location: BootstrapX8664AbiLocationKind;
    register_index: usize;
    stack_offset_bytes: usize;
    stack_size_bytes: usize;
    type_id: usize;
    size_bytes: usize;
    alignment_bytes: usize;
    first_piece: usize;
    piece_count: usize;
    aggregate: bool;
}

export struct BootstrapX8664AbiFunction {
    function_id: usize;
    first_parameter: usize;
    parameter_count: usize;
    first_return_piece: usize;
    return_piece_count: usize;
    return_type: usize;
    return_size_bytes: usize;
    return_alignment_bytes: usize;
    return_aggregate: bool;
    hidden_return_pointer: bool;
    general_register_count: usize;
    vector_register_count: usize;
    stack_argument_size_bytes: usize;
    call_frame_size_bytes: usize;
}

export struct BootstrapX8664Abi {
    functions: bytes::Buffer;
    function_count: usize;
    parameters: bytes::Buffer;
    parameter_count: usize;
    pieces: bytes::Buffer;
    piece_count: usize;
    error: runtime::Error;
}

export struct BootstrapX8664AbiResult {
    abi: BootstrapX8664Abi;
    error: runtime::Error;
}

export struct BootstrapX8664AbiFunctionResult {
    function: BootstrapX8664AbiFunction;
    error: runtime::Error;
}

export struct BootstrapX8664AbiParameterResult {
    parameter: BootstrapX8664AbiParameter;
    error: runtime::Error;
}

export struct BootstrapX8664AbiPieceResult {
    piece: BootstrapX8664AbiPiece;
    error: runtime::Error;
}

export fn bootstrap_x86_64_abi_no_id() -> usize;
export fn bootstrap_x86_64_abi_empty() -> BootstrapX8664Abi;
export fn bootstrap_x86_64_abi_storage_is_valid(abi: BootstrapX8664Abi) -> bool;
export fn bootstrap_x86_64_abi_classify(types: BootstrapTypeTable, type_id: usize) -> BootstrapX8664AbiClassification;
export fn bootstrap_x86_64_abi_analyze(ir: BootstrapTypedIr, types: BootstrapTypeTable) -> BootstrapX8664AbiResult;
export fn bootstrap_x86_64_abi_is_valid(
    abi: BootstrapX8664Abi, ir: BootstrapTypedIr, types: BootstrapTypeTable) -> bool;
export fn bootstrap_x86_64_abi_get_function(
    abi: BootstrapX8664Abi, function_id: usize) -> BootstrapX8664AbiFunctionResult;
export fn bootstrap_x86_64_abi_get_parameter(
    abi: BootstrapX8664Abi, parameter_id: usize) -> BootstrapX8664AbiParameterResult;
export fn bootstrap_x86_64_abi_get_piece(abi: BootstrapX8664Abi, piece_id: usize) -> BootstrapX8664AbiPieceResult;
export fn bootstrap_x86_64_abi_release(abi: BootstrapX8664Abi) -> runtime::Error;

