export module luna.bootstrap.backend.x86_64.text;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;

export struct BootstrapX8664Text {
    buffer: StdByteBuffer;
    error: RuntimeError;
}

export fn bootstrap_x86_64_text_empty() -> BootstrapX8664Text;
export fn bootstrap_x86_64_text_is_valid(text: BootstrapX8664Text) -> bool;
export fn bootstrap_x86_64_text_append(text: *BootstrapX8664Text, data: *const u8, length: usize) -> bool;
export fn bootstrap_x86_64_text_append_c_string(
    text: *BootstrapX8664Text, data: *const u8, maximum_length: usize) -> bool;
export fn bootstrap_x86_64_text_append_u64(text: *BootstrapX8664Text, value: u64) -> bool;
export fn bootstrap_x86_64_text_append_usize(text: *BootstrapX8664Text, value: usize) -> bool;
export fn bootstrap_x86_64_text_append_hex(text: *BootstrapX8664Text, value: u64, digit_count: usize) -> bool;
export fn bootstrap_x86_64_text_append_hex_bytes(text: *BootstrapX8664Text, data: *const u8, length: usize) -> bool;
export fn bootstrap_x86_64_text_take(text: *BootstrapX8664Text) -> StdByteBufferResult;
export fn bootstrap_x86_64_text_release(text: BootstrapX8664Text) -> RuntimeError;

