module luna.bootstrap.backend.x86_64.abi;

enum BootstrapX8664AbiLimit: usize {
    maximum_size = 18446744073709551615, general_register_count = 6, vector_register_count = 8, eightbyte_size = 8,
    stack_alignment = 16, maximum_register_eightbytes = 2, maximum_type_depth = 128, maximum_stack_size = 2147483647,
}

fn bootstrap_x86_64_abi_no_id() -> usize {
    return BootstrapX8664AbiLimit.maximum_size as usize;
}

fn bootstrap_x86_64_abi_empty() -> BootstrapX8664Abi {
    return {
        functions = std_byte_buffer_empty(), function_count = 0, parameters = std_byte_buffer_empty(),
        parameter_count = 0, pieces = std_byte_buffer_empty(), piece_count = 0, error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_abi_buffer_matches(buffer: StdByteBuffer, count: usize, record_size: usize) -> bool {
    return std_byte_buffer_is_valid(buffer) && record_size != 0 && buffer.length % record_size == 0 &&
        count == buffer.length / record_size;
}

fn bootstrap_x86_64_abi_storage_is_valid(abi: BootstrapX8664Abi) -> bool {
    return bootstrap_x86_64_abi_buffer_matches(abi.functions, abi.function_count, sizeof(BootstrapX8664AbiFunction)) &&
        bootstrap_x86_64_abi_buffer_matches(abi.parameters, abi.parameter_count, sizeof(BootstrapX8664AbiParameter)) &&
        bootstrap_x86_64_abi_buffer_matches(abi.pieces, abi.piece_count, sizeof(BootstrapX8664AbiPiece));
}

fn bootstrap_x86_64_abi_align_up(value: usize, alignment: usize) -> usize {
    if (alignment == 0 || (alignment & (alignment - 1)) != 0 || value > (BootstrapX8664AbiLimit.maximum_size as usize) -
                (alignment - 1)) {
        return bootstrap_x86_64_abi_no_id();
    }
    return (value + alignment - 1) & ~(alignment - 1);
}

fn bootstrap_x86_64_abi_class_merge(
    left: BootstrapX8664AbiClass, right: BootstrapX8664AbiClass) -> BootstrapX8664AbiClass {
    if (left == right) {
        return left;
    }
    if (left == BootstrapX8664AbiClass.no_class) {
        return right;
    }
    if (right == BootstrapX8664AbiClass.no_class) {
        return left;
    }
    if (left == BootstrapX8664AbiClass.memory || right == BootstrapX8664AbiClass.memory) {
        return BootstrapX8664AbiClass.memory;
    }
    if (left == BootstrapX8664AbiClass.integer || right == BootstrapX8664AbiClass.integer) {
        return BootstrapX8664AbiClass.integer;
    }
    return BootstrapX8664AbiClass.sse;
}

fn bootstrap_x86_64_abi_set_memory(classification: *BootstrapX8664AbiClassification) -> bool {
    if (classification == null) {
        return false;
    }
    classification->eightbyte_count = 1;
    classification->first = BootstrapX8664AbiClass.memory;
    classification->second = BootstrapX8664AbiClass.no_class;
    return false;
}

fn bootstrap_x86_64_abi_scalar_class(kind: BootstrapTypeKind) -> BootstrapX8664AbiClass {
    return bootstrap_type_is_float(kind) ? BootstrapX8664AbiClass.sse : BootstrapX8664AbiClass.integer;
}

fn bootstrap_x86_64_abi_merge_leaf(
    classification: *BootstrapX8664AbiClassification, offset_bytes: usize, size_bytes: usize, alignment_bytes: usize,
    abi_class: BootstrapX8664AbiClass) -> bool {
    if (classification == null || size_bytes == 0 || size_bytes > 8 || alignment_bytes == 0 ||
        offset_bytes % alignment_bytes != 0 || offset_bytes > 15 || size_bytes > 16 - offset_bytes) {
        return bootstrap_x86_64_abi_set_memory(classification);
    }
    let first: usize = offset_bytes / 8;
    let last: usize = (offset_bytes + size_bytes - 1) / 8;
    var index: usize = first;
    while (index <= last) {
        if (index == 0) {
            classification->first = bootstrap_x86_64_abi_class_merge(classification->first, abi_class);
        } else if (index == 1) {
            classification->second = bootstrap_x86_64_abi_class_merge(classification->second, abi_class);
        } else {
            return bootstrap_x86_64_abi_set_memory(classification);
        }
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_abi_merge_type(
    types: BootstrapTypeTable, type_id: usize, base_offset: usize, depth: usize,
    classification: *BootstrapX8664AbiClassification) -> bool {
    if (type_id >= types.type_count || depth > BootstrapX8664AbiLimit.maximum_type_depth as usize ||
        classification == null || classification->first == BootstrapX8664AbiClass.memory) {
        return bootstrap_x86_64_abi_set_memory(classification);
    }
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let fields: *const BootstrapTypeField = types.fields.data as *const BootstrapTypeField;
    let record: BootstrapTypeRecord = records[type_id];
    if (bootstrap_type_is_scalar(record.kind)) {
        return bootstrap_x86_64_abi_merge_leaf(
            classification, base_offset, record.size_bytes, record.alignment_bytes,
            bootstrap_x86_64_abi_scalar_class(record.kind));
    }
    if (record.kind == BootstrapTypeKind.array) {
        let element: BootstrapTypeRecord = records[record.element_type];
        var index: usize = 0;
        while (index < record.element_count) {
            if (index > (BootstrapX8664AbiLimit.maximum_size as usize) / element.size_bytes ||
                !bootstrap_x86_64_abi_merge_type(
                    types, record.element_type, base_offset + index * element.size_bytes, depth + 1, classification)) {
                return false;
            }
            index += 1;
        }
        return true;
    }
    if (record.kind == BootstrapTypeKind.structure || record.kind == BootstrapTypeKind.record_union) {
        var index: usize = 0;
        while (index < record.field_count) {
            let field: BootstrapTypeField = fields[record.first_field + index];
            if (field.offset_bytes > (BootstrapX8664AbiLimit.maximum_size as usize) - base_offset ||
                !bootstrap_x86_64_abi_merge_type(
                    types, field.type_id, base_offset + field.offset_bytes, depth + 1, classification)) {
                return false;
            }
            index += 1;
        }
        return true;
    }
    return bootstrap_x86_64_abi_set_memory(classification);
}

fn bootstrap_x86_64_abi_classify(types: BootstrapTypeTable, type_id: usize) -> BootstrapX8664AbiClassification {
    var result: BootstrapX8664AbiClassification = {
        eightbyte_count = 0, first = BootstrapX8664AbiClass.invalid, second = BootstrapX8664AbiClass.invalid,
    };
    if (!bootstrap_type_table_is_valid(types, true) || type_id >= types.type_count) {
        return result;
    }
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let record: BootstrapTypeRecord = records[type_id];
    if (!bootstrap_type_is_memory(record.kind) || record.size_bytes == 0) {
        return result;
    }
    result.first = BootstrapX8664AbiClass.no_class;
    result.second = BootstrapX8664AbiClass.no_class;
    if (record.size_bytes > 16) {
        bootstrap_x86_64_abi_set_memory(&result);
        return result;
    }
    result.eightbyte_count = (record.size_bytes + 7) / 8;
    if (!bootstrap_x86_64_abi_merge_type(
            types, type_id, 0, 0, &result)) {
        return result;
    }
    if (result.first == BootstrapX8664AbiClass.no_class) {
        result.first = BootstrapX8664AbiClass.integer;
    }
    if (result.eightbyte_count == 2 && result.second == BootstrapX8664AbiClass.no_class) {
        result.second = BootstrapX8664AbiClass.integer;
    }
    return result;
}

fn bootstrap_x86_64_abi_append(buffer: StdByteBuffer, record: *const u8, record_size: usize) -> StdByteBufferResult {
    if (record == null || record_size == 0) {
        return {
            buffer = buffer, error = RuntimeError.invalid_argument,
        };
    }
    return std_byte_buffer_append(buffer, record, record_size);
}

fn bootstrap_x86_64_abi_add_piece(abi: *BootstrapX8664Abi, piece: BootstrapX8664AbiPiece) -> usize {
    let none: usize = bootstrap_x86_64_abi_no_id();
    if (abi == null || abi->error != RuntimeError.none) {
        return none;
    }
    let appended: StdByteBufferResult =
        bootstrap_x86_64_abi_append(
            abi->pieces, (&piece) as *const BootstrapX8664AbiPiece
                as *const u8, sizeof(BootstrapX8664AbiPiece));
    abi->pieces = appended.buffer;
    abi->error = appended.error;
    if (appended.error != RuntimeError.none) {
        return none;
    }
    let result: usize = abi->piece_count;
    abi->piece_count += 1;
    return result;
}

fn bootstrap_x86_64_abi_add_parameter(abi: *BootstrapX8664Abi, parameter: BootstrapX8664AbiParameter) -> usize {
    let none: usize = bootstrap_x86_64_abi_no_id();
    if (abi == null || abi->error != RuntimeError.none) {
        return none;
    }
    let appended: StdByteBufferResult =
        bootstrap_x86_64_abi_append(
            abi->parameters, (&parameter) as *const BootstrapX8664AbiParameter
                as *const u8, sizeof(BootstrapX8664AbiParameter));
    abi->parameters = appended.buffer;
    abi->error = appended.error;
    if (appended.error != RuntimeError.none) {
        return none;
    }
    let result: usize = abi->parameter_count;
    abi->parameter_count += 1;
    return result;
}

fn bootstrap_x86_64_abi_add_function(abi: *BootstrapX8664Abi, function: BootstrapX8664AbiFunction) -> usize {
    let none: usize = bootstrap_x86_64_abi_no_id();
    if (abi == null || abi->error != RuntimeError.none) {
        return none;
    }
    let appended: StdByteBufferResult =
        bootstrap_x86_64_abi_append(
            abi->functions, (&function) as *const BootstrapX8664AbiFunction
                as *const u8, sizeof(BootstrapX8664AbiFunction));
    abi->functions = appended.buffer;
    abi->error = appended.error;
    if (appended.error != RuntimeError.none) {
        return none;
    }
    let result: usize = abi->function_count;
    abi->function_count += 1;
    return result;
}

fn bootstrap_x86_64_abi_piece_class(
    classification: BootstrapX8664AbiClassification, index: usize) -> BootstrapX8664AbiClass {
    return index == 0 ? classification.first : classification.second;
}

fn bootstrap_x86_64_abi_piece_size(size_bytes: usize, index: usize) -> usize {
    let offset: usize = index * 8;
    let remaining: usize = size_bytes - offset;
    return remaining < 8 ? remaining : 8;
}

fn bootstrap_x86_64_abi_add_stack_area(
    current_size: usize, size_bytes: usize, alignment_bytes: usize, offset: *usize, area_size: *usize) -> usize {
    if (offset == null || area_size == null || size_bytes == 0 || alignment_bytes == 0) {
        return bootstrap_x86_64_abi_no_id();
    }
    let stack_alignment: usize = alignment_bytes > 8 ? alignment_bytes : 8;
    let aligned_offset: usize = bootstrap_x86_64_abi_align_up(current_size, stack_alignment);
    let aligned_size: usize = bootstrap_x86_64_abi_align_up(size_bytes, 8);
    if (aligned_offset == bootstrap_x86_64_abi_no_id() || aligned_size == bootstrap_x86_64_abi_no_id() ||
        aligned_offset > (BootstrapX8664AbiLimit.maximum_size as usize) - aligned_size) {
        return bootstrap_x86_64_abi_no_id();
    }
    *offset = aligned_offset;
    *area_size = aligned_size;
    return aligned_offset + aligned_size;
}

fn bootstrap_x86_64_abi_build_return(
    abi: *BootstrapX8664Abi, function: *BootstrapX8664AbiFunction, types: BootstrapTypeTable) -> bool {
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let record: BootstrapTypeRecord = records[function->return_type];
    function->return_size_bytes = record.size_bytes;
    function->return_alignment_bytes = record.alignment_bytes;
    function->return_aggregate = bootstrap_type_is_memory(record.kind);
    function->first_return_piece = bootstrap_x86_64_abi_no_id();
    if (!function->return_aggregate) {
        return true;
    }
    let classification: BootstrapX8664AbiClassification = bootstrap_x86_64_abi_classify(types, function->return_type);
    if (classification.first == BootstrapX8664AbiClass.memory) {
        function->hidden_return_pointer = true;
        function->general_register_count = 1;
        return true;
    }
    function->first_return_piece = abi->piece_count;
    var general_index: usize = 0;
    var vector_index: usize = 0;
    var index: usize = 0;
    while (index < classification.eightbyte_count) {
        let abi_class: BootstrapX8664AbiClass = bootstrap_x86_64_abi_piece_class(classification, index);
        let register_index: usize = abi_class == BootstrapX8664AbiClass.integer ? general_index : vector_index;
        if (abi_class == BootstrapX8664AbiClass.integer) {
            general_index += 1;
        } else {
            vector_index += 1;
        }
        if (bootstrap_x86_64_abi_add_piece(
                abi, {
                    abi_class = abi_class, location = abi_class == BootstrapX8664AbiClass.integer ?
                            BootstrapX8664AbiLocationKind.general_register : BootstrapX8664AbiLocationKind
                                .vector_register, register_index = register_index, value_offset_bytes = index * 8,
                    size_bytes = bootstrap_x86_64_abi_piece_size(record.size_bytes, index),
                }) == bootstrap_x86_64_abi_no_id()) {
            return false;
        }
        function->return_piece_count += 1;
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_abi_build_scalar_parameter(
    function: *BootstrapX8664AbiFunction, parameter: *BootstrapX8664AbiParameter, record: BootstrapTypeRecord) -> bool {
    let abi_class: BootstrapX8664AbiClass = bootstrap_x86_64_abi_scalar_class(record.kind);
    parameter->abi_class = abi_class;
    if (abi_class == BootstrapX8664AbiClass.integer && function->general_register_count <
            BootstrapX8664AbiLimit.general_register_count as usize) {
        parameter->location = BootstrapX8664AbiLocationKind.general_register;
        parameter->register_index = function->general_register_count;
        function->general_register_count += 1;
        return true;
    }
    if (abi_class == BootstrapX8664AbiClass.sse && function->vector_register_count <
            BootstrapX8664AbiLimit.vector_register_count as usize) {
        parameter->location = BootstrapX8664AbiLocationKind.vector_register;
        parameter->register_index = function->vector_register_count;
        function->vector_register_count += 1;
        return true;
    }
    var offset: usize = 0;
    var area_size: usize = 0;
    let total: usize = bootstrap_x86_64_abi_add_stack_area(
        function->stack_argument_size_bytes, 8, 8, &offset, &area_size);
    if (total == bootstrap_x86_64_abi_no_id()) {
        return false;
    }
    function->stack_argument_size_bytes = total;
    parameter->location = BootstrapX8664AbiLocationKind.stack;
    parameter->stack_offset_bytes = offset;
    parameter->stack_size_bytes = area_size;
    return true;
}

fn bootstrap_x86_64_abi_build_aggregate_parameter(
    abi: *BootstrapX8664Abi, function: *BootstrapX8664AbiFunction, parameter: *BootstrapX8664AbiParameter,
    types: BootstrapTypeTable, record: BootstrapTypeRecord) -> bool {
    let classification: BootstrapX8664AbiClassification = bootstrap_x86_64_abi_classify(types, parameter->type_id);
    var required_general: usize = 0;
    var required_vector: usize = 0;
    var index: usize = 0;
    while (index < classification.eightbyte_count && classification.first != BootstrapX8664AbiClass.memory) {
        if (bootstrap_x86_64_abi_piece_class(
                classification, index) == BootstrapX8664AbiClass.integer) {
            required_general += 1;
        } else {
            required_vector += 1;
        }
        index += 1;
    }
    let registers_fit: bool = classification.first != BootstrapX8664AbiClass.memory && required_general <=
            (BootstrapX8664AbiLimit.general_register_count as usize) - function->general_register_count &&
        required_vector <= (BootstrapX8664AbiLimit.vector_register_count as usize) - function->vector_register_count;
    if (!registers_fit) {
        var offset: usize = 0;
        var area_size: usize = 0;
        let total: usize =
            bootstrap_x86_64_abi_add_stack_area(
                function->stack_argument_size_bytes, record.size_bytes, record.alignment_bytes, &offset, &area_size);
        if (total == bootstrap_x86_64_abi_no_id()) {
            return false;
        }
        function->stack_argument_size_bytes = total;
        parameter->abi_class = BootstrapX8664AbiClass.memory;
        parameter->location = BootstrapX8664AbiLocationKind.stack;
        parameter->stack_offset_bytes = offset;
        parameter->stack_size_bytes = area_size;
        return true;
    }

    parameter->first_piece = abi->piece_count;
    parameter->piece_count = classification.eightbyte_count;
    parameter->abi_class = classification.eightbyte_count == 1 ? classification.first : BootstrapX8664AbiClass.no_class;
    parameter->location = BootstrapX8664AbiLocationKind.invalid;
    index = 0;
    while (index < classification.eightbyte_count) {
        let abi_class: BootstrapX8664AbiClass = bootstrap_x86_64_abi_piece_class(classification, index);
        let is_integer: bool = abi_class == BootstrapX8664AbiClass.integer;
        let register_index: usize = is_integer ? function->general_register_count : function->vector_register_count;
        if (is_integer) {
            function->general_register_count += 1;
        } else {
            function->vector_register_count += 1;
        }
        let location: BootstrapX8664AbiLocationKind = is_integer ? BootstrapX8664AbiLocationKind.general_register :
                BootstrapX8664AbiLocationKind.vector_register;
        if (bootstrap_x86_64_abi_add_piece(
                abi, {
                    abi_class = abi_class, location = location, register_index = register_index,
                    value_offset_bytes = index * 8, size_bytes =
                        bootstrap_x86_64_abi_piece_size(record.size_bytes, index),
                }) == bootstrap_x86_64_abi_no_id()) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_abi_build_parameter(
    abi: *BootstrapX8664Abi, function: *BootstrapX8664AbiFunction, ir_parameter: BootstrapIrParameter,
    parameter_index: usize, types: BootstrapTypeTable) -> bool {
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let record: BootstrapTypeRecord = records[ir_parameter.type_id];
    let none: usize = bootstrap_x86_64_abi_no_id();
    var parameter: BootstrapX8664AbiParameter = {
        function_id = function->function_id, parameter_index = parameter_index,
        abi_class = BootstrapX8664AbiClass.invalid, location = BootstrapX8664AbiLocationKind.invalid,
        register_index = none, stack_offset_bytes = none, stack_size_bytes = 0, type_id = ir_parameter.type_id,
        size_bytes = record.size_bytes, alignment_bytes = record.alignment_bytes, first_piece = none, piece_count = 0,
        aggregate = bootstrap_type_is_memory(record.kind),
    };
    let built: bool = parameter.aggregate ?
        bootstrap_x86_64_abi_build_aggregate_parameter(abi, function, &parameter, types, record) :
        bootstrap_x86_64_abi_build_scalar_parameter(function, &parameter, record);
    return built && bootstrap_x86_64_abi_add_parameter(abi, parameter) != none;
}

fn bootstrap_x86_64_abi_analyze(ir: BootstrapTypedIr, types: BootstrapTypeTable) -> BootstrapX8664AbiResult {
    var abi: BootstrapX8664Abi = bootstrap_x86_64_abi_empty();
    if (!bootstrap_ir_is_valid(ir, types)) {
        return {
            abi = abi, error = RuntimeError.invalid_argument,
        };
    }
    let functions: *const BootstrapIrFunction = ir.functions.data as *const BootstrapIrFunction;
    let parameters: *const BootstrapIrParameter = ir.parameters.data as *const BootstrapIrParameter;
    let none: usize = bootstrap_x86_64_abi_no_id();
    var function_id: usize = 0;
    while (function_id < ir.function_count && abi.error == RuntimeError.none) {
        let source: BootstrapIrFunction = functions[function_id];
        var function: BootstrapX8664AbiFunction = {
            function_id = function_id, first_parameter = source.parameter_count == 0 ? none : abi.parameter_count,
            parameter_count = 0, first_return_piece = none, return_piece_count = 0, return_type = source.return_type,
            return_size_bytes = 0, return_alignment_bytes = 0, return_aggregate = false, hidden_return_pointer = false,
            general_register_count = 0, vector_register_count = 0, stack_argument_size_bytes = 0,
            call_frame_size_bytes = 0,
        };
        if (!bootstrap_x86_64_abi_build_return(
                &abi, &function, types)) {
            abi.error = RuntimeError.invalid_argument;
            break;
        }
        var index: usize = 0;
        while (index < source.parameter_count && abi.error == RuntimeError.none) {
            if (!bootstrap_x86_64_abi_build_parameter(
                    &abi, &function, parameters[source.first_parameter + index], index, types)) {
                if (abi.error == RuntimeError.none) {
                    abi.error = RuntimeError.invalid_argument;
                }
                break;
            }
            function.parameter_count += 1;
            index += 1;
        }
        function.call_frame_size_bytes =
            bootstrap_x86_64_abi_align_up(
                function.stack_argument_size_bytes, BootstrapX8664AbiLimit.stack_alignment as usize);
        if (function.call_frame_size_bytes == bootstrap_x86_64_abi_no_id() || function.call_frame_size_bytes >
                BootstrapX8664AbiLimit.maximum_stack_size as usize ||
            bootstrap_x86_64_abi_add_function(
                &abi, function) == none) {
            if (abi.error == RuntimeError.none) {
                abi.error = RuntimeError.invalid_argument;
            }
            break;
        }
        function_id += 1;
    }
    let type_records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let type_fields: *const BootstrapTypeField = types.fields.data as *const BootstrapTypeField;
    var signature_type: usize = 0;
    while (signature_type < types.type_count && abi.error == RuntimeError.none) {
        let record: BootstrapTypeRecord = type_records[signature_type];
        if (record.kind != BootstrapTypeKind.function_pointer) {
            signature_type += 1;
            continue;
        }
        var synthesized: BootstrapX8664AbiFunction = {
            function_id = none, first_parameter = record.field_count == 0 ? none : abi.parameter_count,
            parameter_count = 0, first_return_piece = none, return_piece_count = 0, return_type = record.element_type,
            return_size_bytes = 0, return_alignment_bytes = 0, return_aggregate = false, hidden_return_pointer = false,
            general_register_count = 0, vector_register_count = 0, stack_argument_size_bytes = 0,
            call_frame_size_bytes = 0,
        };
        if (!bootstrap_x86_64_abi_build_return(
                &abi, &synthesized, types)) {
            abi.error = RuntimeError.invalid_argument;
            break;
        }
        var parameter_index: usize = 0;
        while (parameter_index < record.field_count && abi.error == RuntimeError.none) {
            var ir_parameter: BootstrapIrParameter = {
                function_id = none, type_id = type_fields[ record.first_field + parameter_index].type_id,
                slot_id = none, name_token = none,
            };
            if (!bootstrap_x86_64_abi_build_parameter(
                    &abi, &synthesized, ir_parameter, parameter_index, types)) {
                if (abi.error == RuntimeError.none) {
                    abi.error = RuntimeError.invalid_argument;
                }
                break;
            }
            synthesized.parameter_count += 1;
            parameter_index += 1;
        }
        synthesized.call_frame_size_bytes =
            bootstrap_x86_64_abi_align_up(
                synthesized.stack_argument_size_bytes, BootstrapX8664AbiLimit.stack_alignment as usize);
        if (abi.error == RuntimeError.none && (synthesized.call_frame_size_bytes == bootstrap_x86_64_abi_no_id() ||
                synthesized.call_frame_size_bytes > BootstrapX8664AbiLimit.maximum_stack_size
                        as usize ||
                bootstrap_x86_64_abi_add_function(
                    &abi, synthesized) == none)) {
            if (abi.error == RuntimeError.none) {
                abi.error = RuntimeError.invalid_argument;
            }
        }
        signature_type += 1;
    }
    if (abi.error != RuntimeError.none) {
        let error: RuntimeError = abi.error;
        bootstrap_x86_64_abi_release(abi);
        return {
            abi = bootstrap_x86_64_abi_empty(), error = error,
        };
    }
    return {
        abi = abi, error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_abi_equal(left: BootstrapX8664Abi, right: BootstrapX8664Abi) -> bool {
    return left.error == right.error && left.function_count == right.function_count &&
        left.parameter_count == right.parameter_count && left.piece_count == right.piece_count &&
        std_byte_buffer_equal(left.functions, right.functions.data as *const u8, right.functions.length) &&
        std_byte_buffer_equal(left.parameters, right.parameters.data as *const u8, right.parameters.length) &&
        std_byte_buffer_equal(left.pieces, right.pieces.data as *const u8, right.pieces.length);
}

fn bootstrap_x86_64_abi_is_valid(abi: BootstrapX8664Abi, ir: BootstrapTypedIr, types: BootstrapTypeTable) -> bool {
    if (abi.error != RuntimeError.none || !bootstrap_x86_64_abi_storage_is_valid(abi)) {
        return false;
    }
    let expected: BootstrapX8664AbiResult = bootstrap_x86_64_abi_analyze(ir, types);
    let valid: bool = expected.error == RuntimeError.none && bootstrap_x86_64_abi_equal(abi, expected.abi);
    bootstrap_x86_64_abi_release(expected.abi);
    return valid;
}

fn bootstrap_x86_64_abi_invalid_function()
    -> BootstrapX8664AbiFunction {
    let none: usize = bootstrap_x86_64_abi_no_id();
    return {
        function_id = none, first_parameter = none, parameter_count = 0, first_return_piece = none,
        return_piece_count = 0, return_type = none, return_size_bytes = 0, return_alignment_bytes = 0,
        return_aggregate = false, hidden_return_pointer = false, general_register_count = 0, vector_register_count = 0,
        stack_argument_size_bytes = 0, call_frame_size_bytes = 0,
    };
}

fn bootstrap_x86_64_abi_invalid_parameter()
    -> BootstrapX8664AbiParameter {
    let none: usize = bootstrap_x86_64_abi_no_id();
    return {
        function_id = none, parameter_index = none, abi_class = BootstrapX8664AbiClass.invalid,
        location = BootstrapX8664AbiLocationKind.invalid, register_index = none, stack_offset_bytes = none,
        stack_size_bytes = 0, type_id = none, size_bytes = 0, alignment_bytes = 0, first_piece = none, piece_count = 0,
        aggregate = false,
    };
}

fn bootstrap_x86_64_abi_invalid_piece()
    -> BootstrapX8664AbiPiece {
    return {
        abi_class = BootstrapX8664AbiClass.invalid, location = BootstrapX8664AbiLocationKind.invalid,
        register_index = bootstrap_x86_64_abi_no_id(), value_offset_bytes = 0, size_bytes = 0,
    };
}

fn bootstrap_x86_64_abi_get_function(abi: BootstrapX8664Abi, function_id: usize) -> BootstrapX8664AbiFunctionResult {
    if (!bootstrap_x86_64_abi_storage_is_valid(abi) || function_id >= abi.function_count) {
        return {
            function = bootstrap_x86_64_abi_invalid_function(), error = RuntimeError.invalid_argument,
        };
    }
    return {
        function = (abi.functions.data as *const BootstrapX8664AbiFunction)[function_id], error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_abi_get_parameter(abi: BootstrapX8664Abi, parameter_id: usize) -> BootstrapX8664AbiParameterResult {
    if (!bootstrap_x86_64_abi_storage_is_valid(abi) || parameter_id >= abi.parameter_count) {
        return {
            parameter = bootstrap_x86_64_abi_invalid_parameter(), error = RuntimeError.invalid_argument,
        };
    }
    return {
        parameter = (abi.parameters.data as *const BootstrapX8664AbiParameter)[parameter_id], error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_abi_get_piece(abi: BootstrapX8664Abi, piece_id: usize) -> BootstrapX8664AbiPieceResult {
    if (!bootstrap_x86_64_abi_storage_is_valid(abi) || piece_id >= abi.piece_count) {
        return {
            piece = bootstrap_x86_64_abi_invalid_piece(), error = RuntimeError.invalid_argument,
        };
    }
    return {
        piece = (abi.pieces.data as *const BootstrapX8664AbiPiece)[piece_id], error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_abi_release(abi: BootstrapX8664Abi) -> RuntimeError {
    if (!bootstrap_x86_64_abi_storage_is_valid(abi)) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError = std_byte_buffer_release(abi.functions);
    let parameter_error: RuntimeError = std_byte_buffer_release(abi.parameters);
    if (error == RuntimeError.none) {
        error = parameter_error;
    }
    let piece_error: RuntimeError = std_byte_buffer_release(abi.pieces);
    if (error == RuntimeError.none) {
        error = piece_error;
    }
    return error;
}

