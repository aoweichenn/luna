export module luna.bootstrap.backend.x86_64.object;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;

export enum BootstrapObjectSection: usize {
    undefined = 0, text = 1, rodata = 2, data = 3, bss = 4,
}

export enum BootstrapObjectSymbolKind: usize {
    none = 0, function = 1, object = 2,
}

export enum BootstrapObjectRelocationKind: usize {
    pc32 = 1, plt32 = 2, absolute64 = 3, absolute32 = 4, signed32 = 5,
}

export struct BootstrapObjectSymbol {
    name_offset: usize;
    name_length: usize;
    section: BootstrapObjectSection;
    value: usize;
    size: usize;
    kind: BootstrapObjectSymbolKind;
    defined: bool;
    global: bool;
    external: bool;
}

export struct BootstrapObjectRelocation {
    section: BootstrapObjectSection;
    offset: usize;
    symbol_index: usize;
    kind: BootstrapObjectRelocationKind;
    addend: isize;
}

export struct BootstrapObject {
    text: bytes::Buffer;
    rodata: bytes::Buffer;
    data: bytes::Buffer;
    names: bytes::Buffer;
    symbols: bytes::Buffer;
    relocations: bytes::Buffer;
    bss_size: usize;
    text_alignment: usize;
    rodata_alignment: usize;
    data_alignment: usize;
    bss_alignment: usize;
    error: runtime::Error;
}

export struct BootstrapObjectResult {
    object: BootstrapObject;
    error: runtime::Error;
}

export struct BootstrapObjectSymbolResult {
    symbol: BootstrapObjectSymbol;
    error: runtime::Error;
}

export struct BootstrapObjectRelocationResult {
    relocation: BootstrapObjectRelocation;
    error: runtime::Error;
}

export struct BootstrapObjectIndexResult {
    index: usize;
    found: bool;
    error: runtime::Error;
}

export fn bootstrap_object_empty() -> BootstrapObject;
export fn bootstrap_object_is_valid(object: BootstrapObject) -> bool;
export fn bootstrap_object_release(object: BootstrapObject) -> runtime::Error;
export fn bootstrap_object_section_length(object: BootstrapObject, section: BootstrapObjectSection) -> usize;
export fn bootstrap_object_set_alignment(
    object: *BootstrapObject, section: BootstrapObjectSection, alignment: usize) -> bool;
export fn bootstrap_object_append_u8(object: *BootstrapObject, section: BootstrapObjectSection, value: u8) -> bool;
export fn bootstrap_object_append_u16(object: *BootstrapObject, section: BootstrapObjectSection, value: u16) -> bool;
export fn bootstrap_object_append_u32(object: *BootstrapObject, section: BootstrapObjectSection, value: u32) -> bool;
export fn bootstrap_object_append_u64(object: *BootstrapObject, section: BootstrapObjectSection, value: u64) -> bool;
export fn bootstrap_object_add_symbol(object: *BootstrapObject, name: text::View) -> BootstrapObjectIndexResult;
export fn bootstrap_object_find_symbol(object: BootstrapObject, name: text::View) -> BootstrapObjectIndexResult;
export fn bootstrap_object_get_symbol(object: BootstrapObject, index: usize) -> BootstrapObjectSymbolResult;
export fn bootstrap_object_symbol_mut(object: *BootstrapObject, index: usize) -> *BootstrapObjectSymbol;
export fn bootstrap_object_symbol_name(object: BootstrapObject, symbol: BootstrapObjectSymbol) -> text::ViewResult;
export fn bootstrap_object_add_relocation(object: *BootstrapObject, relocation: BootstrapObjectRelocation) -> bool;
export fn bootstrap_object_get_relocation(object: BootstrapObject, index: usize) -> BootstrapObjectRelocationResult;
export fn bootstrap_object_symbol_count(object: BootstrapObject) -> usize;
export fn bootstrap_object_relocation_count(object: BootstrapObject) -> usize;
export fn bootstrap_object_serialize(object: BootstrapObject) -> bytes::BufferResult;
export fn bootstrap_object_deserialize(bytes: *const u8, length: usize) -> BootstrapObjectResult;

