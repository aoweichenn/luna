module luna.bootstrap.backend.x86_64.elf;

// Reads ELF64 relocatable objects (ET_REL, as produced by foreign compilers)
// and converts them into the same in-memory object model the Luna assembler
// emits, so the linker consumes both through one path. The accepted subset is
// deliberate: little-endian x86-64 ET_REL with allocated PROGBITS/NOBITS
// sections, one SHT_SYMTAB and explicit-addend SHT_RELA relocations. TLS,
// COMDAT groups, writable-executable sections, implicit-addend REL entries
// and unsupported relocation types are rejected; non-allocated metadata
// (notes, comments, debug sections) is dropped. Every header field, range,
// string, symbol reference and relocation reference is validated before its
// data is used.

enum SectionType: usize {
    none = 0, progbits = 1, symtab = 2, strtab = 3, rela = 4, note = 7, nobits = 8, rel = 9,
}

enum SectionFlag: usize {
    write = 1, alloc = 2, execute = 4, group = 512, tls = 1024,
}

enum SectionIndex: usize {
    undefined = 0, reserve_low = 65280, absolute = 65521, common = 65522,
}

enum SymbolBind: usize {
    local = 0, global = 1, weak = 2,
}

enum SymbolType: usize {
    notype = 0, object = 1, function = 2, section = 3, file = 4, common = 5, tls = 6,
}

enum RelocationType: usize {
    absolute64 = 1, pc32 = 2, plt32 = 4, absolute32 = 10, signed32 = 11,
}

enum Limit: usize {
    header_size = 64, section_size = 64, symbol_size = 24, relocation_size = 24, maximum_sections = 4096,
    maximum_records = 65536, maximum_payload = 67108864, maximum_alignment = 4096, maximum_name = 4096,
    no_symbol = 18446744073709551615,
}

struct Section {
    region: object::Section;
    region_offset: usize;
    symbol: usize;
    kind: usize;
    flags: usize;
    offset: usize;
    size: usize;
    link: usize;
    info: usize;
    alignment: usize;
    entry_size: usize;
}

struct Reader {
    bytes: *const u8;
    length: usize;
    sections: bytes::Buffer;
    symbol_map: bytes::Buffer;
    symtab: usize;
    has_symtab: bool;
    object: object::Object;
    error: runtime::Error;
}

fn fail(reader: *Reader, error: runtime::Error) -> bool {
    if (reader != null && reader->error == runtime::Error.none) {
        reader->error = error;
    }
    return false;
}

fn power_of_two(value: usize) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

fn align(value: usize, alignment: usize, result: *usize) -> bool {
    if (result == null || !power_of_two(alignment)) {
        return false;
    }
    let mask: usize = alignment - 1;
    if (value > 18446744073709551615 as usize - mask) {
        return false;
    }
    *result = (value + mask) & ~mask;
    return true;
}

fn range_valid(offset: usize, size: usize, length: usize) -> bool {
    return offset <= length && size <= length - offset;
}

fn read_u16(bytes: *const u8, length: usize, offset: usize, value: *u16) -> bool {
    if (bytes == null || value == null || !range_valid(offset, 2, length)) {
        return false;
    }
    *value = (bytes[offset] as u16) | ((bytes[offset + 1] as u16) << 8);
    return true;
}

fn read_u32(bytes: *const u8, length: usize, offset: usize, value: *u32) -> bool {
    if (bytes == null || value == null || !range_valid(offset, 4, length)) {
        return false;
    }
    var result: u32 = 0;
    var index: usize = 0;
    while (index < 4) {
        result |= (bytes[offset + index] as u32) << ((index * 8) as u32);
        index += 1;
    }
    *value = result;
    return true;
}

fn read_u64(bytes: *const u8, length: usize, offset: usize, value: *u64) -> bool {
    if (bytes == null || value == null || !range_valid(offset, 8, length)) {
        return false;
    }
    var result: u64 = 0;
    var index: usize = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << ((index * 8) as u64);
        index += 1;
    }
    *value = result;
    return true;
}

fn section_count(reader: *Reader) -> usize {
    if (reader == null || !bytes::is_valid(reader->sections)) {
        return 0;
    }
    return reader->sections.length / sizeof(Section);
}

fn section_at(reader: *Reader, index: usize) -> *Section {
    if (reader == null || index >= section_count(reader)) {
        return null;
    }
    let sections: *Section = reader->sections.data as *Section;
    return &sections[index];
}

fn section_copy(reader: *Reader, index: usize) -> Section {
    let section: *Section = section_at(reader, index);
    if (section == null) {
        return {
            region = object::Section.undefined, region_offset = 0, symbol = Limit.no_symbol as usize,
            kind = 0, flags = 0, offset = 0, size = 0, link = 0, info = 0, alignment = 0, entry_size = 0,
        };
    }
    return *section;
}

fn region_buffer(object: *object::Object, section: object::Section) -> *bytes::Buffer {
    if (object == null) {
        return null;
    }
    if (section == object::Section.text) {
        return &object->text;
    }
    if (section == object::Section.rodata) {
        return &object->rodata;
    }
    if (section == object::Section.data) {
        return &object->data;
    }
    return null;
}

fn pad_to(buffer: *bytes::Buffer, offset: usize) -> bool {
    if (buffer == null || buffer->length > offset) {
        return false;
    }
    while (buffer->length < offset) {
        let appended: bytes::BufferResult = bytes::push(*buffer, 0);
        *buffer = appended.buffer;
        if (appended.error != runtime::Error.none) {
            return false;
        }
    }
    return true;
}

fn append_bytes(buffer: *bytes::Buffer, bytes: *const u8, offset: usize, size: usize) -> bool {
    if (buffer == null || (size != 0 && bytes == null)) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(
        *buffer, size == 0 ? null as *const u8 : &bytes[offset], size);
    *buffer = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn parse_header(reader: *Reader) -> bool {
    let bytes: *const u8 = reader->bytes;
    let length: usize = reader->length;
    if (bytes[0] != 127 || bytes[1] != 69 || bytes[2] != 76 || bytes[3] != 70 || bytes[4] != 2 || bytes[5] != 1 ||
        bytes[6] != 1) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var elf_type: u16 = 0;
    var machine: u16 = 0;
    var version: u32 = 0;
    var section_offset: u64 = 0;
    var program_count: u16 = 0;
    var header_size: u16 = 0;
    var section_header_size: u16 = 0;
    var section_count_field: u16 = 0;
    if (!read_u16(bytes, length, 16, &elf_type) || !read_u16(bytes, length, 18, &machine) ||
        !read_u32(bytes, length, 20, &version) ||
        !read_u64(bytes, length, 40, &section_offset) ||
        !read_u16(bytes, length, 52, &header_size) ||
        !read_u16(bytes, length, 56, &program_count) ||
        !read_u16(bytes, length, 58, &section_header_size) ||
        !read_u16(bytes, length, 60, &section_count_field)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    if (elf_type != 1 || machine != 62 || version != 1 || program_count != 0 || header_size !=
            (Limit.header_size as usize) as u16 || section_header_size !=
            (Limit.section_size as usize) as u16 || section_offset == 0 || section_offset >
            ((length as u64) - (Limit.section_size as usize) as u64)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var section_count: usize = section_count_field as usize;
    if (section_count == 0) {
        // Extended section numbering: the real count lives in section 0's
        // sh_size when e_shnum is zero.
        var extended: u64 = 0;
        if (!read_u64(bytes, length, (section_offset as usize) + 32, &extended) || extended == 0 ||
            extended > (Limit.maximum_sections as usize) as u64) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        section_count = extended as usize;
    }
    let table_offset: usize = section_offset as usize;
    if (section_count > Limit.maximum_sections as usize || section_count >
        (length - table_offset) / (Limit.section_size as usize)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var index: usize = 0;
    while (index < section_count) {
        let base: usize = table_offset + index * (Limit.section_size as usize);
        var kind: u32 = 0;
        var flags: u64 = 0;
        var offset: u64 = 0;
        var size: u64 = 0;
        var link: u32 = 0;
        var info: u32 = 0;
        var alignment: u64 = 0;
        var entry_size: u64 = 0;
        if (!read_u32(bytes, length, base + 4, &kind) ||
            !read_u64(bytes, length, base + 8, &flags) ||
            !read_u64(bytes, length, base + 24, &offset) ||
            !read_u64(bytes, length, base + 32, &size) ||
            !read_u32(bytes, length, base + 40, &link) ||
            !read_u32(bytes, length, base + 44, &info) ||
            !read_u64(bytes, length, base + 48, &alignment) ||
            !read_u64(bytes, length, base + 56, &entry_size)) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        let section: Section = {
            region = object::Section.undefined, region_offset = 0,
            symbol = Limit.no_symbol as usize, kind = kind as usize, flags = flags as usize,
            offset = offset as usize, size = size as usize, link = link as usize, info = info as usize,
            alignment = alignment as usize, entry_size = entry_size as usize,
        };
        let appended: bytes::BufferResult = bytes::append(
            reader->sections, (&section) as *const Section as *const u8, sizeof(Section));
        reader->sections = appended.buffer;
        if (appended.error != runtime::Error.none) {
            return fail(reader, appended.error);
        }
        index += 1;
    }
    return true;
}

fn classify_sections(reader: *Reader) -> bool {
    let count: usize = section_count(reader);
    var index: usize = 0;
    while (index < count) {
        let section: *Section = section_at(reader, index);
        if (section == null || (index == 0 && section->kind != (SectionType.none as usize))) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        if (section->alignment == 0) {
            section->alignment = 1;
        }
        if (!power_of_two(section->alignment) || section->alignment >
                Limit.maximum_alignment as usize) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        if ((section->flags & ((SectionFlag.group as usize) | (SectionFlag.tls as usize))) !=
                0) {
            return fail(reader, runtime::Error.not_supported);
        }
        if ((section->flags & (SectionFlag.write as usize)) != 0 &&
            (section->flags & (SectionFlag.execute as usize)) != 0) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        let alloc: bool = (section->flags & (SectionFlag.alloc as usize)) != 0;
        if (section->kind == (SectionType.none as usize)) {
            index += 1;
            continue;
        }
        if (section->kind == (SectionType.progbits as usize)) {
            if (!alloc) {
                index += 1;
                continue;
            }
            if (section->size > Limit.maximum_payload as usize ||
                !range_valid(section->offset, section->size, reader->length)) {
                return fail(reader, runtime::Error.invalid_argument);
            }
            if ((section->flags & (SectionFlag.execute as usize)) != 0) {
                section->region = object::Section.text;
            } else if ((section->flags & (SectionFlag.write as usize)) != 0) {
                section->region = object::Section.data;
            } else {
                section->region = object::Section.rodata;
            }
        } else if (section->kind == (SectionType.nobits as usize)) {
            if (!alloc) {
                index += 1;
                continue;
            }
            if ((section->flags & (SectionFlag.write as usize)) == 0 || section->size >
                    Limit.maximum_payload as usize) {
                return fail(reader, runtime::Error.invalid_argument);
            }
            section->region = object::Section.bss;
        } else if (section->kind == (SectionType.symtab as usize)) {
            if (alloc || reader->has_symtab || section->entry_size != Limit.symbol_size as usize ||
                section->size % (Limit.symbol_size as usize) != 0 || section->size /
                    (Limit.symbol_size as usize) > Limit.maximum_records as usize ||
                !range_valid(section->offset, section->size, reader->length) || section->link >= count) {
                return fail(reader, runtime::Error.invalid_argument);
            }
            reader->symtab = index;
            reader->has_symtab = true;
        } else if (section->kind == (SectionType.strtab as usize)) {
            if (alloc || !range_valid(section->offset, section->size, reader->length)) {
                return fail(reader, runtime::Error.invalid_argument);
            }
        } else if (section->kind == (SectionType.rela as usize)) {
            if (alloc || section->entry_size != Limit.relocation_size as usize || section->size %
                    (Limit.relocation_size as usize) != 0 || section->size /
                    (Limit.relocation_size as usize) > Limit.maximum_records as usize ||
                !range_valid(section->offset, section->size, reader->length) || section->link >= count ||
                section->info >= count) {
                return fail(reader, runtime::Error.invalid_argument);
            }
        } else if (section->kind == (SectionType.note as usize)) {
            // Loader metadata (including allocated .note.gnu.property); never
            // consumed by a static link.
            index += 1;
            continue;
        } else if (section->kind == (SectionType.rel as usize)) {
            return fail(reader, runtime::Error.not_supported);
        } else if (alloc) {
            return fail(reader, runtime::Error.not_supported);
        }
        index += 1;
    }
    return true;
}

fn layout_sections(reader: *Reader) -> bool {
    let count: usize = section_count(reader);
    var index: usize = 0;
    while (index < count) {
        let section: *Section = section_at(reader, index);
        if (section == null) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        if (section->region == object::Section.undefined) {
            index += 1;
            continue;
        }
        if (!object::set_alignment(&reader->object, section->region, section->alignment)) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        if (section->region == object::Section.bss) {
            var placed: usize = 0;
            if (!align(reader->object.bss_size, section->alignment, &placed) || section->size >
                    (Limit.maximum_payload as usize) - placed) {
                return fail(reader, runtime::Error.out_of_memory);
            }
            section->region_offset = placed;
            reader->object.bss_size = placed + section->size;
            index += 1;
            continue;
        }
        let buffer: *bytes::Buffer = region_buffer(&reader->object, section->region);
        var placed: usize = 0;
        if (buffer == null || !align(buffer->length, section->alignment, &placed) || section->size >
                (Limit.maximum_payload as usize) - placed || !pad_to(buffer, placed) ||
            !append_bytes(buffer, reader->bytes, section->offset, section->size)) {
            return fail(reader, runtime::Error.out_of_memory);
        }
        section->region_offset = placed;
        index += 1;
    }
    return true;
}

fn symbol_name(
    reader: *Reader, strtab: Section, name_offset: usize, name: *text::View) -> bool {
    if (reader == null || name == null || name_offset == 0 || name_offset >= strtab.size) {
        return false;
    }
    var length: usize = 0;
    while (name_offset + length < strtab.size && reader->bytes[strtab.offset + name_offset + length] != 0) {
        length += 1;
    }
    if (name_offset + length >= strtab.size || length > Limit.maximum_name as usize) {
        return false;
    }
    let view: text::ViewResult = text::view(&reader->bytes[strtab.offset + name_offset], length);
    if (view.error != runtime::Error.none) {
        return false;
    }
    *name = view.view;
    return true;
}

fn synthetic_name(tag: *const u8, tag_length: usize, index: usize, output: *u8) -> usize {
    // Synthetic names embed zero bytes, which strtab names by construction
    // never contain, so they cannot collide with any input symbol name.
    var length: usize = 0;
    output[length] = 0;
    length += 1;
    var position: usize = 0;
    while (position < tag_length) {
        output[length] = tag[position];
        length += 1;
        position += 1;
    }
    output[length] = 0;
    length += 1;
    var digits: [5]u8 = {};
    var digit_count: usize = 0;
    var value: usize = index;
    if (value == 0) {
        digits[0] = 48;
        digit_count = 1;
    }
    while (value != 0) {
        digits[digit_count] = 48 + (value % 10) as u8;
        value = value / 10;
        digit_count += 1;
    }
    while (digit_count != 0) {
        digit_count -= 1;
        output[length] = digits[digit_count];
        length += 1;
    }
    return length;
}

fn synthetic_view(tag: *const u8, tag_length: usize, index: usize, name: *text::View) -> bool {
    if (name == null) {
        return false;
    }
    var storage: [24]u8 = {};
    let length: usize = synthetic_name(tag, tag_length, index, &storage[0]);
    let view: text::ViewResult = text::view(&storage[0] as *const u8, length);
    if (view.error != runtime::Error.none) {
        return false;
    }
    *name = view.view;
    return true;
}

fn load_section_symbol(
    reader: *Reader, st_shndx: usize, st_value: u64, st_size: u64, mapped: *usize) -> bool {
    if (st_shndx == 0 || st_shndx >= section_count(reader) || st_value != 0 || st_size != 0) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    let target: *Section = section_at(reader, st_shndx);
    if (target == null) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    if (target->region == object::Section.undefined) {
        return true;
    }
    if (target->symbol == (Limit.no_symbol as usize)) {
        var name: text::View = {
            data = null, length = 0,
        };
        if (!synthetic_view("section", 7, st_shndx, &name)) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        let added: object::IndexResult = object::add_symbol(&reader->object, name);
        let symbol: *object::Symbol = object::symbol_mut(&reader->object, added.index);
        if (added.error != runtime::Error.none || added.found || symbol == null) {
            return fail(
                reader, added.error == runtime::Error.none ? runtime::Error.invalid_argument : added.error);
        }
        symbol->defined = true;
        symbol->section = target->region;
        symbol->value = target->region_offset;
        target->symbol = added.index;
    }
    *mapped = target->symbol;
    return true;
}

fn load_undefined_symbol(
    reader: *Reader, strtab: Section, st_name: usize, local: bool, st_value: u64,
    st_size: u64, mapped: *usize) -> bool {
    if (st_value != 0 || st_size != 0 || local) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    if (st_name == 0) {
        return true;
    }
    var name: text::View = {
        data = null, length = 0,
    };
    if (!symbol_name(reader, strtab, st_name, &name)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    let added: object::IndexResult = object::add_symbol(&reader->object, name);
    if (added.error != runtime::Error.none) {
        return fail(reader, added.error);
    }
    let symbol: *object::Symbol = object::symbol_mut(&reader->object, added.index);
    if (symbol == null) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    if (!symbol->defined) {
        symbol->global = true;
        symbol->external = true;
    }
    *mapped = added.index;
    return true;
}

fn load_common_symbol(
    reader: *Reader, strtab: Section, st_name: usize, local: bool, st_value: u64,
    st_size: u64, mapped: *usize) -> bool {
    // COMMON storage is allocated in bss: st_value carries the required
    // alignment and st_size the byte count, so objects compiled without
    // -fno-common stay linkable.
    if (local || st_name == 0 || st_value > (Limit.maximum_alignment as usize) as u64 || st_size >
            (Limit.maximum_payload as usize) as u64) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var alignment: usize = st_value as usize;
    if (alignment == 0) {
        alignment = 1;
    }
    if (!power_of_two(alignment)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var placed: usize = 0;
    if (!align(reader->object.bss_size, alignment, &placed) || (st_size as usize) >
            (Limit.maximum_payload as usize) - placed) {
        return fail(reader, runtime::Error.out_of_memory);
    }
    var name: text::View = {
        data = null, length = 0,
    };
    if (!symbol_name(reader, strtab, st_name, &name)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    let added: object::IndexResult = object::add_symbol(&reader->object, name);
    if (added.error != runtime::Error.none) {
        return fail(reader, added.error);
    }
    let symbol: *object::Symbol = object::symbol_mut(&reader->object, added.index);
    if (symbol == null || symbol->defined) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    symbol->defined = true;
    symbol->global = true;
    symbol->external = false;
    symbol->section = object::Section.bss;
    symbol->value = placed;
    symbol->size = st_size as usize;
    symbol->kind = object::SymbolKind.object;
    reader->object.bss_size = placed + (st_size as usize);
    if (!object::set_alignment(&reader->object, object::Section.bss, alignment)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    *mapped = added.index;
    return true;
}

fn load_defined_symbol(
    reader: *Reader, strtab: Section, index: usize, st_name: usize, local: bool,
    st_shndx: usize, st_value: u64, st_size: u64, symbol_type: usize, mapped: *usize) -> bool {
    let target: Section = section_copy(reader, st_shndx);
    if (target.region == object::Section.undefined || st_value > (target.size as u64) || st_size >
            (target.size as u64) - st_value) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    if (!local && st_name == 0) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var name: text::View = {
        data = null, length = 0,
    };
    if (st_name == 0) {
        if (!synthetic_view("symbol", 6, index, &name)) {
            return fail(reader, runtime::Error.invalid_argument);
        }
    } else if (!symbol_name(reader, strtab, st_name, &name)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    var added: object::IndexResult = object::add_symbol(&reader->object, name);
    if (added.error != runtime::Error.none) {
        return fail(reader, added.error);
    }
    if (local && added.found) {
        // A local symbol sharing its name with another entry (for example an
        // undefined global reference) is a distinct symbol; relabel it under
        // a unique synthetic name.
        if (!synthetic_view("local", 5, index, &name)) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        added = object::add_symbol(&reader->object, name);
        if (added.error != runtime::Error.none || added.found) {
            return fail(
                reader, added.error == runtime::Error.none ? runtime::Error.invalid_argument : added.error);
        }
    }
    let symbol: *object::Symbol = object::symbol_mut(&reader->object, added.index);
    if (symbol == null || symbol->defined) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    symbol->defined = true;
    symbol->external = false;
    if (!local) {
        symbol->global = true;
    }
    symbol->section = target.region;
    symbol->value = target.region_offset + (st_value as usize);
    symbol->size = st_size as usize;
    symbol->kind = symbol_type == (SymbolType.function as usize) ? object::SymbolKind.function :
        (symbol_type == (SymbolType.object as usize) || symbol_type ==
            (SymbolType.common as usize)) ? object::SymbolKind.object :
        object::SymbolKind.none;
    *mapped = added.index;
    return true;
}

fn load_symbol(
    reader: *Reader, strtab: Section, index: usize, st_name: usize, st_info: usize,
    st_other: usize, st_shndx: usize, st_value: u64, st_size: u64, mapped: *usize) -> bool {
    if (mapped == null) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    if (st_other != 0 || st_info >> 4 > (SymbolBind.weak as usize)) {
        return fail(reader, runtime::Error.not_supported);
    }
    let local: bool = st_info >> 4 == (SymbolBind.local as usize);
    let symbol_type: usize = st_info & 15;
    if (index == 0) {
        if (st_name != 0 || st_info != 0 || st_shndx != 0 || st_value != 0 || st_size != 0) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        return true;
    }
    if (symbol_type == (SymbolType.file as usize)) {
        return true;
    }
    if (symbol_type >= (SymbolType.tls as usize)) {
        return fail(reader, runtime::Error.not_supported);
    }
    if (symbol_type == (SymbolType.section as usize)) {
        return load_section_symbol(reader, st_shndx, st_value, st_size, mapped);
    }
    if (st_shndx == (SectionIndex.undefined as usize)) {
        return load_undefined_symbol(reader, strtab, st_name, local, st_value, st_size, mapped);
    }
    if (st_shndx == (SectionIndex.common as usize)) {
        return load_common_symbol(reader, strtab, st_name, local, st_value, st_size, mapped);
    }
    if (st_shndx >= (SectionIndex.reserve_low as usize)) {
        return fail(reader, runtime::Error.not_supported);
    }
    return load_defined_symbol(
        reader, strtab, index, st_name, local, st_shndx, st_value, st_size, symbol_type, mapped);
}

fn map_symbol(reader: *Reader, mapped: usize) -> bool {
    let entry: usize = mapped;
    let appended: bytes::BufferResult = bytes::append(
        reader->symbol_map, (&entry) as *const usize as *const u8, sizeof(usize));
    reader->symbol_map = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return fail(reader, appended.error);
    }
    return true;
}

fn load_symbols(reader: *Reader) -> bool {
    if (!reader->has_symtab) {
        return true;
    }
    let symtab: Section = section_copy(reader, reader->symtab);
    let strtab: Section = section_copy(reader, symtab.link);
    if (strtab.kind != (SectionType.strtab as usize)) {
        return fail(reader, runtime::Error.invalid_argument);
    }
    let count: usize = symtab.size / (Limit.symbol_size as usize);
    var index: usize = 0;
    while (index < count) {
        let base: usize = symtab.offset + index * (Limit.symbol_size as usize);
        var st_name: u32 = 0;
        var st_shndx: u16 = 0;
        var st_value: u64 = 0;
        var st_size: u64 = 0;
        if (!read_u32(reader->bytes, reader->length, base, &st_name) ||
            !read_u16(reader->bytes, reader->length, base + 6, &st_shndx) ||
            !read_u64(reader->bytes, reader->length, base + 8, &st_value) ||
            !read_u64(reader->bytes, reader->length, base + 16, &st_size)) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        var mapped: usize = Limit.no_symbol as usize;
        if (!load_symbol(
                reader, strtab, index, st_name as usize, reader->bytes[base + 4] as usize,
                reader->bytes[base + 5] as usize, st_shndx as usize, st_value, st_size, &mapped) ||
            !map_symbol(reader, mapped)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn load_relocations(reader: *Reader) -> bool {
    let section_count: usize = section_count(reader);
    let symbol_map: *const usize = reader->symbol_map.data as *const usize;
    let symbol_count: usize = reader->symbol_map.length / sizeof(usize);
    var index: usize = 0;
    while (index < section_count) {
        let section: Section = section_copy(reader, index);
        if (section.kind != (SectionType.rela as usize)) {
            index += 1;
            continue;
        }
        if (!reader->has_symtab || section.link != reader->symtab || section.info >= section_count) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        let target: Section = section_copy(reader, section.info);
        if (target.region == object::Section.undefined) {
            index += 1;
            continue;
        }
        if (target.region == object::Section.bss) {
            return fail(reader, runtime::Error.invalid_argument);
        }
        let count: usize = section.size / (Limit.relocation_size as usize);
        var relocation_index: usize = 0;
        while (relocation_index < count) {
            let base: usize = section.offset + relocation_index * (Limit.relocation_size as usize);
            var offset: u64 = 0;
            var info: u64 = 0;
            var addend: u64 = 0;
            if (!read_u64(reader->bytes, reader->length, base, &offset) ||
                !read_u64(reader->bytes, reader->length, base + 8, &info) ||
                !read_u64(reader->bytes, reader->length, base + 16, &addend)) {
                return fail(reader, runtime::Error.invalid_argument);
            }
            let symbol_index: usize = (info >> 32) as usize;
            let relocation_type: usize = (info & (4294967295 as u64)) as usize;
            var kind: object::RelocationKind = object::RelocationKind.pc32;
            var width: usize = 4;
            if (relocation_type == (RelocationType.absolute64 as usize)) {
                kind = object::RelocationKind.absolute64;
                width = 8;
            } else if (relocation_type == (RelocationType.pc32 as usize)) {
                kind = object::RelocationKind.pc32;
            } else if (relocation_type == (RelocationType.plt32 as usize)) {
                kind = object::RelocationKind.plt32;
            } else if (relocation_type == (RelocationType.absolute32 as usize)) {
                kind = object::RelocationKind.absolute32;
            } else if (relocation_type == (RelocationType.signed32 as usize)) {
                kind = object::RelocationKind.signed32;
            } else {
                return fail(reader, runtime::Error.not_supported);
            }
            if (symbol_index >= symbol_count || symbol_map[symbol_index] == (Limit.no_symbol as usize) ||
                offset > (target.size as u64) || (width as u64) > (target.size as u64) - offset) {
                return fail(reader, runtime::Error.invalid_argument);
            }
            let relocation: object::Relocation = {
                section = target.region, offset = target.region_offset + (offset as usize),
                symbol_index = symbol_map[symbol_index], kind = kind, addend = addend as isize,
            };
            if (!object::add_relocation(&reader->object, relocation)) {
                return fail(
                    reader, reader->object.error == runtime::Error.none ? runtime::Error.invalid_argument :
                        reader->object.error);
            }
            relocation_index += 1;
        }
        index += 1;
    }
    return true;
}

fn load(bytes: *const u8, length: usize) -> object::Result {
    var reader: Reader = {
        bytes = bytes, length = length, sections = bytes::empty(), symbol_map = bytes::empty(),
        symtab = 0, has_symtab = false, object = object::empty(), error = runtime::Error.none,
    };
    if (bytes == null || length < Limit.header_size as usize) {
        return {
            object = reader.object, error = runtime::Error.invalid_argument,
        };
    }
    var loaded: bool = parse_header(&reader) && classify_sections(&reader) &&
        layout_sections(&reader) && load_symbols(&reader) &&
        load_relocations(&reader);
    if (loaded && !object::is_valid(reader.object)) {
        loaded = fail(&reader, runtime::Error.invalid_argument);
    }
    let map_error: runtime::Error = bytes::release(reader.symbol_map);
    let sections_error: runtime::Error = bytes::release(reader.sections);
    if (!loaded) {
        object::release(reader.object);
        return {
            object = object::empty(), error = reader.error == runtime::Error.none ?
                runtime::Error.invalid_argument : reader.error,
        };
    }
    if (map_error != runtime::Error.none || sections_error != runtime::Error.none) {
        object::release(reader.object);
        return {
            object = object::empty(), error = map_error == runtime::Error.none ? sections_error : map_error,
        };
    }
    return {
        object = reader.object, error = runtime::Error.none,
    };
}


// Writes the in-memory object model out as a standard ELF64 ET_REL so host
// toolchains (gcc/ld) can link Luna code into C programs. The emitted layout
// stays inside the subset the reader above accepts, so luna-as --emit elf
// output round-trips through luna-link: section 0 is SHT_NULL, each non-empty
// region becomes one allocated PROGBITS section (.text/.rodata/.data) or the
// NOBITS .bss, a single SHT_SYMTAB carries locals before globals with
// sh_info marking the first global, and each relocated region gets one
// explicit-addend SHT_RELA section linked to the symtab. An empty
// .note.GNU-stack keeps host linkers from assuming an executable stack. All
// padding is zero-filled, so the output is byte deterministic.

enum SectionSource: usize {
    none = 0, text = 1, rodata = 2, data = 3, symtab = 4, strtab = 5, shstrtab = 6,
    rela_text = 7, rela_rodata = 8, rela_data = 9,
}

struct OutputSection {
    name: usize;
    kind: usize;
    flags: usize;
    offset: usize;
    size: usize;
    link: usize;
    info: usize;
    alignment: usize;
    entry_size: usize;
    source: usize;
}

struct SavePlan {
    text_section: usize;
    rodata_section: usize;
    data_section: usize;
    bss_section: usize;
    symtab_section: usize;
    strtab_section: usize;
    shstrtab_section: usize;
    rela_text_section: usize;
    rela_rodata_section: usize;
    rela_data_section: usize;
    note_section: usize;
    section_count: usize;
    first_global: usize;
    section_offset: usize;
}

struct Writer {
    sections: bytes::Buffer;
    shstrtab: bytes::Buffer;
    strtab: bytes::Buffer;
    symtab: bytes::Buffer;
    symbol_map: bytes::Buffer;
    rela_text: bytes::Buffer;
    rela_rodata: bytes::Buffer;
    rela_data: bytes::Buffer;
    error: runtime::Error;
}

fn save_fail(writer: *Writer, error: runtime::Error) -> bool {
    if (writer != null && writer->error == runtime::Error.none) {
        writer->error = error;
    }
    return false;
}

fn save_release(writer: *Writer) -> runtime::Error {
    var error: runtime::Error = bytes::release(writer->rela_data);
    let rela_rodata_error: runtime::Error = bytes::release(writer->rela_rodata);
    let rela_text_error: runtime::Error = bytes::release(writer->rela_text);
    let map_error: runtime::Error = bytes::release(writer->symbol_map);
    let symtab_error: runtime::Error = bytes::release(writer->symtab);
    let strtab_error: runtime::Error = bytes::release(writer->strtab);
    let shstrtab_error: runtime::Error = bytes::release(writer->shstrtab);
    let sections_error: runtime::Error = bytes::release(writer->sections);
    if (error == runtime::Error.none) {
        error = rela_rodata_error;
    }
    if (error == runtime::Error.none) {
        error = rela_text_error;
    }
    if (error == runtime::Error.none) {
        error = map_error;
    }
    if (error == runtime::Error.none) {
        error = symtab_error;
    }
    if (error == runtime::Error.none) {
        error = strtab_error;
    }
    if (error == runtime::Error.none) {
        error = shstrtab_error;
    }
    if (error == runtime::Error.none) {
        error = sections_error;
    }
    return error;
}

fn emit_u8(output: *bytes::Buffer, value: u8) -> bool {
    if (output == null) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::push(*output, value);
    *output = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn emit_u16(output: *bytes::Buffer, value: u16) -> bool {
    var index: usize = 0;
    while (index < 2) {
        if (!emit_u8(output, ((value >> ((index * 8) as u16)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn emit_u32(output: *bytes::Buffer, value: u32) -> bool {
    var index: usize = 0;
    while (index < 4) {
        if (!emit_u8(output, ((value >> ((index * 8) as u32)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn emit_u64(output: *bytes::Buffer, value: u64) -> bool {
    var index: usize = 0;
    while (index < 8) {
        if (!emit_u8(output, ((value >> ((index * 8) as u64)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn emit_bytes(output: *bytes::Buffer, data: *const u8, length: usize) -> bool {
    if (output == null) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(*output, data, length);
    *output = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn save_section_count(writer: *Writer) -> usize {
    if (writer == null || !bytes::is_valid(writer->sections)) {
        return 0;
    }
    return writer->sections.length / sizeof(OutputSection);
}

fn save_section_at(writer: *Writer, index: usize) -> *OutputSection {
    if (writer == null || index >= save_section_count(writer)) {
        return null;
    }
    let sections: *OutputSection = writer->sections.data as *OutputSection;
    return &sections[index];
}

fn save_add_section(
    writer: *Writer, name: usize, kind: usize, flags: usize, size: usize, link: usize, info: usize,
    alignment: usize, entry_size: usize, source: usize) -> bool {
    let section: OutputSection = {
        name = name, kind = kind, flags = flags, offset = 0, size = size, link = link, info = info,
        alignment = alignment, entry_size = entry_size, source = source,
    };
    let appended: bytes::BufferResult = bytes::append(
        writer->sections, (&section) as *const OutputSection as *const u8, sizeof(OutputSection));
    writer->sections = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return save_fail(writer, appended.error);
    }
    return true;
}

fn save_section_name(writer: *Writer, name: *const u8, length: usize, offset: *usize) -> bool {
    if (offset == null) {
        return save_fail(writer, runtime::Error.invalid_argument);
    }
    *offset = writer->shstrtab.length;
    if (!emit_bytes(&writer->shstrtab, name, length) || !emit_u8(&writer->shstrtab, 0)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    return true;
}

fn save_plan(writer: *Writer, object: object::Object, plan: *SavePlan) -> bool {
    if (plan == null) {
        return save_fail(writer, runtime::Error.invalid_argument);
    }
    var has_text: bool = object.text.length != 0;
    var has_rodata: bool = object.rodata.length != 0;
    var has_data: bool = object.data.length != 0;
    var has_bss: bool = object.bss_size != 0;
    var local_count: usize = 0;
    var text_relocations: usize = 0;
    var rodata_relocations: usize = 0;
    var data_relocations: usize = 0;
    // A region with a defined symbol needs its section even when empty, or
    // the symbol would have no valid st_shndx.
    var index: usize = 0;
    let symbol_total: usize = object::symbol_count(object);
    while (index < symbol_total) {
        let result: object::SymbolResult = object::get_symbol(object, index);
        if (result.error != runtime::Error.none) {
            return save_fail(writer, result.error);
        }
        let symbol: object::Symbol = result.symbol;
        if (symbol.defined) {
            if (symbol.section == object::Section.text) {
                has_text = true;
            } else if (symbol.section == object::Section.rodata) {
                has_rodata = true;
            } else if (symbol.section == object::Section.data) {
                has_data = true;
            } else if (symbol.section == object::Section.bss) {
                has_bss = true;
            }
            if (!symbol.global) {
                local_count += 1;
            }
        }
        index += 1;
    }
    index = 0;
    let relocation_total: usize = object::relocation_count(object);
    while (index < relocation_total) {
        let result: object::RelocationResult = object::get_relocation(object, index);
        if (result.error != runtime::Error.none) {
            return save_fail(writer, result.error);
        }
        if (result.relocation.section == object::Section.text) {
            text_relocations += 1;
        } else if (result.relocation.section == object::Section.rodata) {
            rodata_relocations += 1;
        } else if (result.relocation.section == object::Section.data) {
            data_relocations += 1;
        } else {
            // Valid objects never relocate inside bss or the undefined
            // section; reject defensively.
            return save_fail(writer, runtime::Error.invalid_argument);
        }
        index += 1;
    }
    var next: usize = 1;
    plan->text_section = 0;
    plan->rodata_section = 0;
    plan->data_section = 0;
    plan->bss_section = 0;
    plan->rela_text_section = 0;
    plan->rela_rodata_section = 0;
    plan->rela_data_section = 0;
    if (has_text) {
        plan->text_section = next;
        next += 1;
    }
    if (has_rodata) {
        plan->rodata_section = next;
        next += 1;
    }
    if (has_data) {
        plan->data_section = next;
        next += 1;
    }
    if (has_bss) {
        plan->bss_section = next;
        next += 1;
    }
    plan->symtab_section = next;
    next += 1;
    plan->strtab_section = next;
    next += 1;
    plan->shstrtab_section = next;
    next += 1;
    if (text_relocations != 0) {
        plan->rela_text_section = next;
        next += 1;
    }
    if (rodata_relocations != 0) {
        plan->rela_rodata_section = next;
        next += 1;
    }
    if (data_relocations != 0) {
        plan->rela_data_section = next;
        next += 1;
    }
    plan->note_section = next;
    next += 1;
    plan->section_count = next;
    plan->first_global = local_count + 1;
    plan->section_offset = 0;
    return true;
}

fn save_symbol_shndx(plan: *SavePlan, symbol: object::Symbol) -> usize {
    if (!symbol.defined) {
        return 0;
    }
    if (symbol.section == object::Section.text) {
        return plan->text_section;
    }
    if (symbol.section == object::Section.rodata) {
        return plan->rodata_section;
    }
    if (symbol.section == object::Section.data) {
        return plan->data_section;
    }
    if (symbol.section == object::Section.bss) {
        return plan->bss_section;
    }
    return 0;
}

fn save_symbol_entry(
    writer: *Writer, object: object::Object, plan: *SavePlan, symbol: object::Symbol,
    model_index: usize, symtab_index: usize) -> bool {
    let shndx: usize = save_symbol_shndx(plan, symbol);
    if (symbol.defined && shndx == 0) {
        return save_fail(writer, runtime::Error.invalid_argument);
    }
    let name_offset: usize = writer->strtab.length;
    if (!emit_bytes(
            &writer->strtab, &object.names.data[symbol.name_offset] as *const u8, symbol.name_length) ||
        !emit_u8(&writer->strtab, 0)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    // Undefined model symbols are always global or external; both emit as
    // STB_GLOBAL SHN_UNDEF, the only undefined shape the reader accepts.
    var bind: usize = SymbolBind.global as usize;
    if (symbol.defined && !symbol.global) {
        bind = SymbolBind.local as usize;
    }
    var symbol_type: usize = SymbolType.notype as usize;
    if (symbol.kind == object::SymbolKind.function) {
        symbol_type = SymbolType.function as usize;
    } else if (symbol.kind == object::SymbolKind.object) {
        symbol_type = SymbolType.object as usize;
    }
    let info: usize = (bind << 4) | symbol_type;
    if (!emit_u32(&writer->symtab, (name_offset as u32)) ||
        !emit_u8(&writer->symtab, (info as u8)) || !emit_u8(&writer->symtab, 0) ||
        !emit_u16(&writer->symtab, (shndx as u16)) ||
        !emit_u64(&writer->symtab, (symbol.value as u64)) ||
        !emit_u64(&writer->symtab, (symbol.size as u64))) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    let map: *usize = writer->symbol_map.data as *usize;
    let slot: *usize = &map[model_index];
    *slot = symtab_index;
    return true;
}

fn save_symbols(writer: *Writer, object: object::Object, plan: *SavePlan) -> bool {
    // Symbol 0 is the mandatory all-zero entry; the string table leads with a
    // NUL byte so st_name 0 means "no name".
    if (!pad_to(&writer->symtab, Limit.symbol_size as usize) || !emit_u8(&writer->strtab, 0)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    let symbol_total: usize = object::symbol_count(object);
    var index: usize = 0;
    while (index < symbol_total) {
        var slot: usize = 0;
        let appended: bytes::BufferResult = bytes::append(
            writer->symbol_map, (&slot) as *const usize as *const u8, sizeof(usize));
        writer->symbol_map = appended.buffer;
        if (appended.error != runtime::Error.none) {
            return save_fail(writer, appended.error);
        }
        index += 1;
    }
    // Locals first, then globals, preserving model order within each class;
    // GNU ld requires the local block ahead of sh_info.
    var symtab_index: usize = 1;
    var pass: usize = 0;
    while (pass < 2) {
        let global_pass: bool = pass != 0;
        index = 0;
        while (index < symbol_total) {
            let result: object::SymbolResult = object::get_symbol(object, index);
            if (result.error != runtime::Error.none) {
                return save_fail(writer, result.error);
            }
            let local: bool = result.symbol.defined && !result.symbol.global;
            if (local != global_pass) {
                if (!save_symbol_entry(writer, object, plan, result.symbol, index, symtab_index)) {
                    return false;
                }
                symtab_index += 1;
            }
            index += 1;
        }
        pass += 1;
    }
    return true;
}

fn save_relocations(writer: *Writer, object: object::Object) -> bool {
    let map: *const usize = writer->symbol_map.data as *const usize;
    let relocation_total: usize = object::relocation_count(object);
    var index: usize = 0;
    while (index < relocation_total) {
        let result: object::RelocationResult = object::get_relocation(object, index);
        if (result.error != runtime::Error.none) {
            return save_fail(writer, result.error);
        }
        let relocation: object::Relocation = result.relocation;
        var relocation_type: usize = 0;
        if (relocation.kind == object::RelocationKind.absolute64) {
            relocation_type = RelocationType.absolute64 as usize;
        } else if (relocation.kind == object::RelocationKind.pc32) {
            relocation_type = RelocationType.pc32 as usize;
        } else if (relocation.kind == object::RelocationKind.plt32) {
            relocation_type = RelocationType.plt32 as usize;
        } else if (relocation.kind == object::RelocationKind.absolute32) {
            relocation_type = RelocationType.absolute32 as usize;
        } else if (relocation.kind == object::RelocationKind.signed32) {
            relocation_type = RelocationType.signed32 as usize;
        } else {
            return save_fail(writer, runtime::Error.invalid_argument);
        }
        var target: *bytes::Buffer = null;
        if (relocation.section == object::Section.text) {
            target = &writer->rela_text;
        } else if (relocation.section == object::Section.rodata) {
            target = &writer->rela_rodata;
        } else if (relocation.section == object::Section.data) {
            target = &writer->rela_data;
        } else {
            return save_fail(writer, runtime::Error.invalid_argument);
        }
        let info: u64 = ((map[relocation.symbol_index] as u64) << 32) | (relocation_type as u64);
        if (!emit_u64(target, relocation.offset as u64) || !emit_u64(target, info) ||
            !emit_u64(target, relocation.addend as u64)) {
            return save_fail(writer, runtime::Error.out_of_memory);
        }
        index += 1;
    }
    return true;
}

fn save_sections(writer: *Writer, object: object::Object, plan: *SavePlan) -> bool {
    if (!emit_u8(&writer->shstrtab, 0) ||
        !save_add_section(
            writer, 0, SectionType.none as usize, 0, 0, 0, 0, 0, 0, SectionSource.none as usize)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    var name: usize = 0;
    if (plan->text_section != 0) {
        if (!save_section_name(writer, ".text", 5, &name) ||
            !save_add_section(
                writer, name, SectionType.progbits as usize,
                (SectionFlag.alloc as usize) | (SectionFlag.execute as usize), object.text.length, 0, 0,
                object.text_alignment, 0, SectionSource.text as usize)) {
            return false;
        }
    }
    if (plan->rodata_section != 0) {
        if (!save_section_name(writer, ".rodata", 7, &name) ||
            !save_add_section(
                writer, name, SectionType.progbits as usize, SectionFlag.alloc as usize,
                object.rodata.length, 0, 0, object.rodata_alignment, 0, SectionSource.rodata as usize)) {
            return false;
        }
    }
    if (plan->data_section != 0) {
        if (!save_section_name(writer, ".data", 5, &name) ||
            !save_add_section(
                writer, name, SectionType.progbits as usize,
                (SectionFlag.alloc as usize) | (SectionFlag.write as usize), object.data.length, 0, 0,
                object.data_alignment, 0, SectionSource.data as usize)) {
            return false;
        }
    }
    if (plan->bss_section != 0) {
        if (!save_section_name(writer, ".bss", 4, &name) ||
            !save_add_section(
                writer, name, SectionType.nobits as usize,
                (SectionFlag.alloc as usize) | (SectionFlag.write as usize), object.bss_size, 0, 0,
                object.bss_alignment, 0, SectionSource.none as usize)) {
            return false;
        }
    }
    if (!save_section_name(writer, ".symtab", 7, &name) ||
        !save_add_section(
            writer, name, SectionType.symtab as usize, 0, writer->symtab.length, plan->strtab_section,
            plan->first_global, 8, Limit.symbol_size as usize, SectionSource.symtab as usize)) {
        return false;
    }
    if (!save_section_name(writer, ".strtab", 7, &name) ||
        !save_add_section(
            writer, name, SectionType.strtab as usize, 0, writer->strtab.length, 0, 0, 1, 0,
            SectionSource.strtab as usize)) {
        return false;
    }
    if (!save_section_name(writer, ".shstrtab", 9, &name) ||
        !save_add_section(
            writer, name, SectionType.strtab as usize, 0, 0, 0, 0, 1, 0,
            SectionSource.shstrtab as usize)) {
        return false;
    }
    if (plan->rela_text_section != 0) {
        if (!save_section_name(writer, ".rela.text", 10, &name) ||
            !save_add_section(
                writer, name, SectionType.rela as usize, 0, writer->rela_text.length,
                plan->symtab_section, plan->text_section, 8, Limit.relocation_size as usize,
                SectionSource.rela_text as usize)) {
            return false;
        }
    }
    if (plan->rela_rodata_section != 0) {
        if (!save_section_name(writer, ".rela.rodata", 12, &name) ||
            !save_add_section(
                writer, name, SectionType.rela as usize, 0, writer->rela_rodata.length,
                plan->symtab_section, plan->rodata_section, 8, Limit.relocation_size as usize,
                SectionSource.rela_rodata as usize)) {
            return false;
        }
    }
    if (plan->rela_data_section != 0) {
        if (!save_section_name(writer, ".rela.data", 10, &name) ||
            !save_add_section(
                writer, name, SectionType.rela as usize, 0, writer->rela_data.length,
                plan->symtab_section, plan->data_section, 8, Limit.relocation_size as usize,
                SectionSource.rela_data as usize)) {
            return false;
        }
    }
    // An empty non-allocated .note.GNU-stack: the reader drops it, and host
    // linkers read it as "no executable stack required".
    if (!save_section_name(writer, ".note.GNU-stack", 15, &name) ||
        !save_add_section(
            writer, name, SectionType.progbits as usize, 0, 0, 0, 0, 1, 0,
            SectionSource.none as usize)) {
        return false;
    }
    let shstrtab_record: *OutputSection = save_section_at(writer, plan->shstrtab_section);
    if (shstrtab_record == null) {
        return save_fail(writer, runtime::Error.invalid_argument);
    }
    shstrtab_record->size = writer->shstrtab.length;
    return true;
}

fn save_layout(writer: *Writer, plan: *SavePlan) -> bool {
    var cursor: usize = Limit.header_size as usize;
    var index: usize = 1;
    let count: usize = save_section_count(writer);
    while (index < count) {
        let section: *OutputSection = save_section_at(writer, index);
        if (section == null) {
            return save_fail(writer, runtime::Error.invalid_argument);
        }
        var alignment: usize = section->alignment;
        if (alignment == 0) {
            alignment = 1;
        }
        var placed: usize = 0;
        if (!align(cursor, alignment, &placed)) {
            return save_fail(writer, runtime::Error.out_of_memory);
        }
        section->offset = placed;
        section->alignment = alignment;
        if (section->kind != (SectionType.nobits as usize)) {
            if (section->size > (18446744073709551615 as usize) - placed) {
                return save_fail(writer, runtime::Error.out_of_memory);
            }
            cursor = placed + section->size;
        }
        index += 1;
    }
    var section_offset: usize = 0;
    if (!align(cursor, 8, &section_offset)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    plan->section_offset = section_offset;
    return true;
}

fn save_source(writer: *Writer, object: object::Object, source: usize, content: *bytes::Buffer) -> bool {
    if (content == null) {
        return false;
    }
    if (source == (SectionSource.text as usize)) {
        *content = object.text;
    } else if (source == (SectionSource.rodata as usize)) {
        *content = object.rodata;
    } else if (source == (SectionSource.data as usize)) {
        *content = object.data;
    } else if (source == (SectionSource.symtab as usize)) {
        *content = writer->symtab;
    } else if (source == (SectionSource.strtab as usize)) {
        *content = writer->strtab;
    } else if (source == (SectionSource.shstrtab as usize)) {
        *content = writer->shstrtab;
    } else if (source == (SectionSource.rela_text as usize)) {
        *content = writer->rela_text;
    } else if (source == (SectionSource.rela_rodata as usize)) {
        *content = writer->rela_rodata;
    } else if (source == (SectionSource.rela_data as usize)) {
        *content = writer->rela_data;
    } else {
        return false;
    }
    return true;
}

fn save_emit(
    writer: *Writer, object: object::Object, plan: *SavePlan, output: *bytes::Buffer) -> bool {
    if (!emit_u8(output, 127) || !emit_u8(output, 69) || !emit_u8(output, 76) || !emit_u8(output, 70) ||
        !emit_u8(output, 2) || !emit_u8(output, 1) || !emit_u8(output, 1) || !emit_u8(output, 0) ||
        !pad_to(output, 16) ||
        !emit_u16(output, 1) ||
        !emit_u16(output, 62) ||
        !emit_u32(output, 1) ||
        !emit_u64(output, 0) ||
        !emit_u64(output, 0) ||
        !emit_u64(output, plan->section_offset as u64) ||
        !emit_u32(output, 0) ||
        !emit_u16(output, (Limit.header_size as usize) as u16) ||
        !emit_u16(output, 0) ||
        !emit_u16(output, 0) ||
        !emit_u16(output, (Limit.section_size as usize) as u16) ||
        !emit_u16(output, plan->section_count as u16) ||
        !emit_u16(output, plan->shstrtab_section as u16)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    var index: usize = 1;
    let count: usize = save_section_count(writer);
    while (index < count) {
        let section: *OutputSection = save_section_at(writer, index);
        if (section == null) {
            return save_fail(writer, runtime::Error.invalid_argument);
        }
        if (section->kind != (SectionType.nobits as usize)) {
            if (!pad_to(output, section->offset)) {
                return save_fail(writer, runtime::Error.out_of_memory);
            }
            if (section->size != 0) {
                var content: bytes::Buffer = bytes::empty();
                if (!save_source(writer, object, section->source, &content)) {
                    return save_fail(writer, runtime::Error.invalid_argument);
                }
                if (!emit_bytes(output, content.data as *const u8, content.length)) {
                    return save_fail(writer, runtime::Error.out_of_memory);
                }
            }
        }
        index += 1;
    }
    if (!pad_to(output, plan->section_offset)) {
        return save_fail(writer, runtime::Error.out_of_memory);
    }
    index = 0;
    while (index < count) {
        let section: *OutputSection = save_section_at(writer, index);
        if (section == null) {
            return save_fail(writer, runtime::Error.invalid_argument);
        }
        if (!emit_u32(output, section->name as u32) || !emit_u32(output, section->kind as u32) ||
            !emit_u64(output, section->flags as u64) || !emit_u64(output, 0) ||
            !emit_u64(output, section->offset as u64) || !emit_u64(output, section->size as u64) ||
            !emit_u32(output, section->link as u32) || !emit_u32(output, section->info as u32) ||
            !emit_u64(output, section->alignment as u64) ||
            !emit_u64(output, section->entry_size as u64)) {
            return save_fail(writer, runtime::Error.out_of_memory);
        }
        index += 1;
    }
    return true;
}

fn save(object: object::Object) -> bytes::BufferResult {
    var writer: Writer = {
        sections = bytes::empty(), shstrtab = bytes::empty(), strtab = bytes::empty(),
        symtab = bytes::empty(), symbol_map = bytes::empty(), rela_text = bytes::empty(),
        rela_rodata = bytes::empty(), rela_data = bytes::empty(), error = runtime::Error.none,
    };
    var output: bytes::Buffer = bytes::empty();
    if (!object::is_valid(object)) {
        return {
            buffer = output, error = runtime::Error.invalid_argument,
        };
    }
    var plan: SavePlan = {
        text_section = 0, rodata_section = 0, data_section = 0, bss_section = 0, symtab_section = 0,
        strtab_section = 0, shstrtab_section = 0, rela_text_section = 0, rela_rodata_section = 0,
        rela_data_section = 0, note_section = 0, section_count = 0, first_global = 0, section_offset = 0,
    };
    var success: bool = save_plan(&writer, object, &plan) && save_symbols(&writer, object, &plan) &&
        save_relocations(&writer, object) && save_sections(&writer, object, &plan) &&
        save_layout(&writer, &plan);
    if (success) {
        let total: usize = plan.section_offset + plan.section_count * (Limit.section_size as usize);
        let reserved: bytes::BufferResult = bytes::with_capacity(total);
        if (reserved.error != runtime::Error.none) {
            success = save_fail(&writer, reserved.error);
        } else {
            output = reserved.buffer;
            success = save_emit(&writer, object, &plan, &output);
        }
    }
    let scratch_error: runtime::Error = save_release(&writer);
    if (!success) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = writer.error == runtime::Error.none ?
                runtime::Error.invalid_argument : writer.error,
        };
    }
    if (scratch_error != runtime::Error.none) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = scratch_error,
        };
    }
    return {
        buffer = output, error = runtime::Error.none,
    };
}
