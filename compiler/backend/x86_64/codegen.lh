export module luna.bootstrap.backend.x86_64.codegen;

import luna.bootstrap.backend.x86_64.abi;
import luna.bootstrap.backend.x86_64.frame;
import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.semantic.context;
import luna.bootstrap.middleend.type;
import luna.runtime;
import luna.std.bytes;

export struct BootstrapX8664BackendResult {
    assembly: StdByteBuffer;
    abi: BootstrapX8664Abi;
    frames: BootstrapX8664FramePlan;
    error: runtime::Error;
}

export fn bootstrap_x86_64_backend_empty()
    -> BootstrapX8664BackendResult;
export fn bootstrap_x86_64_backend_is_success(
    result: BootstrapX8664BackendResult, semantic_input: BootstrapSemanticInput, ir: BootstrapTypedIr,
    types: BootstrapTypeTable) -> bool;
export fn bootstrap_x86_64_emit_assembly(
    semantic_input: BootstrapSemanticInput, ir: BootstrapTypedIr, types: BootstrapTypeTable
) -> BootstrapX8664BackendResult;
export fn bootstrap_x86_64_backend_release(result: BootstrapX8664BackendResult) -> runtime::Error;

