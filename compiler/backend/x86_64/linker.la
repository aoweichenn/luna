module luna.bootstrap.backend.x86_64.linker;

import luna.std.text as text;

enum BootstrapLinkerLimit: usize {
    maximum_inputs = 64, maximum_output = 268435456, page_size = 4096, image_base = 4194304, text_offset = 4096,
}

enum BootstrapElf: usize {
    header_size = 64, program_header_size = 56, machine_x86_64 = 62, executable_type = 2, load_segment = 1,
    flag_execute = 1, flag_write = 2, flag_read = 4,
}

struct BootstrapLinkPlacement {
    text: usize;
    rodata: usize;
    data: usize;
    bss: usize;
}

struct BootstrapLinkGlobal {
    name: text::View;
    object_index: usize;
    symbol_index: usize;
}

struct BootstrapLinkImage {
    text: bytes::Buffer;
    rodata: bytes::Buffer;
    data: bytes::Buffer;
    globals: bytes::Buffer;
    bss_size: usize;
    text_alignment: usize;
    rodata_alignment: usize;
    data_alignment: usize;
    bss_alignment: usize;
    text_address: usize;
    rodata_address: usize;
    data_address: usize;
    bss_address: usize;
    entry_address: usize;
    error: runtime::Error;
    input_index: usize;
}

fn bootstrap_linker_image_empty() -> BootstrapLinkImage {
    return {
        text = bytes::empty(), rodata = bytes::empty(), data = bytes::empty(),
        globals = bytes::empty(), bss_size = 0, text_alignment = 1, rodata_alignment = 1, data_alignment = 1,
        bss_alignment = 1, text_address = 0, rodata_address = 0, data_address = 0, bss_address = 0, entry_address = 0,
        error = runtime::Error.none, input_index = 0,
    };
}

fn bootstrap_linker_fail(image: *BootstrapLinkImage, error: runtime::Error, input_index: usize) -> bool {
    if (image != null && image->error == runtime::Error.none) {
        image->error = error;
        image->input_index = input_index;
    }
    return false;
}

fn bootstrap_linker_power_of_two(value: usize) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

fn bootstrap_linker_align(value: usize, alignment: usize, result: *usize) -> bool {
    if (result == null || !bootstrap_linker_power_of_two(alignment)) {
        return false;
    }
    let mask: usize = alignment - 1;
    if (value > 18446744073709551615 as usize - mask) {
        return false;
    }
    *result = (value + mask) & ~mask;
    return true;
}

fn bootstrap_linker_append_u8(output: *bytes::Buffer, value: u8) -> bool {
    if (output == null) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::push(*output, value);
    *output = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn bootstrap_linker_append_u16(output: *bytes::Buffer, value: u16) -> bool {
    var index: usize = 0;
    while (index < 2) {
        if (!bootstrap_linker_append_u8(
                output, ((value >> ((index * 8) as u16)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_linker_append_u32(output: *bytes::Buffer, value: u32) -> bool {
    var index: usize = 0;
    while (index < 4) {
        if (!bootstrap_linker_append_u8(
                output, ((value >> ((index * 8) as u32)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_linker_append_u64(output: *bytes::Buffer, value: u64) -> bool {
    var index: usize = 0;
    while (index < 8) {
        if (!bootstrap_linker_append_u8(
                output, ((value >> ((index * 8) as u64)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_linker_append_bytes(output: *bytes::Buffer, data: *const u8, length: usize) -> bool {
    if (output == null) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(*output, data, length);
    *output = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn bootstrap_linker_append_padding(output: *bytes::Buffer, count: usize, fill: u8) -> bool {
    var index: usize = 0;
    while (index < count) {
        if (!bootstrap_linker_append_u8(output, fill)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_linker_pad_to(output: *bytes::Buffer, offset: usize) -> bool {
    return output != null && output->length <= offset &&
        bootstrap_linker_append_padding(output, offset - output->length, 0);
}

fn bootstrap_linker_region_append(
    image: *BootstrapLinkImage, destination: *bytes::Buffer, source: bytes::Buffer, alignment: usize, fill: u8,
    input_index: usize, placement: *usize) -> bool {
    var aligned: usize = 0;
    if (destination == null || placement == null || !bootstrap_linker_align(destination->length, alignment, &aligned) ||
        aligned > BootstrapLinkerLimit.maximum_output as usize || source.length >
            (BootstrapLinkerLimit.maximum_output as usize) - aligned ||
        !bootstrap_linker_append_padding(destination, aligned - destination->length, fill) ||
        !bootstrap_linker_append_bytes(
            destination, source.data as *const u8, source.length)) {
        return bootstrap_linker_fail(image, runtime::Error.out_of_memory, input_index);
    }
    *placement = aligned;
    return true;
}

fn bootstrap_linker_name_equal(left: text::View, right: text::View) -> bool {
    return text::equal(left, right);
}

fn bootstrap_linker_find_global(
    image: *const BootstrapLinkImage, name: text::View, result: *BootstrapLinkGlobal) -> bool {
    let globals: *const BootstrapLinkGlobal = image->globals.data as *const BootstrapLinkGlobal;
    let count: usize = image->globals.length / sizeof(BootstrapLinkGlobal);
    var index: usize = 0;
    while (index < count) {
        if (bootstrap_linker_name_equal(globals[index].name, name)) {
            if (result != null) {
                *result = globals[index];
            }
            return true;
        }
        index += 1;
    }
    return false;
}

fn bootstrap_linker_collect_globals(
    image: *BootstrapLinkImage, objects: *const BootstrapObject, object_count: usize) -> bool {
    var object_index: usize = 0;
    while (object_index < object_count) {
        image->input_index = object_index;
        let object: BootstrapObject = objects[object_index];
        var symbol_index: usize = 0;
        while (symbol_index < bootstrap_object_symbol_count(object)) {
            let result: BootstrapObjectSymbolResult = bootstrap_object_get_symbol(object, symbol_index);
            if (result.error != runtime::Error.none) {
                return bootstrap_linker_fail(image, result.error, object_index);
            }
            let symbol: BootstrapObjectSymbol = result.symbol;
            if (symbol.defined && symbol.global) {
                let name: text::ViewResult = bootstrap_object_symbol_name(object, symbol);
                var previous: BootstrapLinkGlobal = {};
                if (name.error != runtime::Error.none ||
                    bootstrap_linker_find_global(
                        image as *const BootstrapLinkImage, name.view, &previous)) {
                    return bootstrap_linker_fail(image, runtime::Error.exists, object_index);
                }
                let global: BootstrapLinkGlobal = {
                    name = name.view, object_index = object_index, symbol_index = symbol_index,
                };
                let appended: bytes::BufferResult =
                    bytes::append(
                        image->globals, (&global) as *const BootstrapLinkGlobal as *const u8,
                        sizeof(BootstrapLinkGlobal));
                image->globals = appended.buffer;
                if (appended.error != runtime::Error.none) {
                    return bootstrap_linker_fail(image, appended.error, object_index);
                }
            }
            symbol_index += 1;
        }
        object_index += 1;
    }
    return true;
}

fn bootstrap_linker_layout_regions(
    image: *BootstrapLinkImage, objects: *const BootstrapObject, object_count: usize,
    placements: *BootstrapLinkPlacement) -> bool {
    var object_index: usize = 0;
    while (object_index < object_count) {
        let object: BootstrapObject = objects[object_index];
        if (!bootstrap_object_is_valid(object)) {
            return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
        }
        if (!bootstrap_linker_region_append(
                image, &image->text, object.text, object.text_alignment, 144, object_index,
                &placements[object_index].text) ||
            !bootstrap_linker_region_append(
                image, &image->rodata, object.rodata, object.rodata_alignment, 0, object_index,
                &placements[object_index].rodata) ||
            !bootstrap_linker_region_append(
                image, &image->data, object.data, object.data_alignment, 0, object_index, &placements[object_index].data
            )) {
            return false;
        }
        var bss_offset: usize = 0;
        if (!bootstrap_linker_align(image->bss_size, object.bss_alignment, &bss_offset) ||
            object.bss_size > (BootstrapLinkerLimit.maximum_output as usize) - bss_offset) {
            return bootstrap_linker_fail(image, runtime::Error.out_of_memory, object_index);
        }
        placements[object_index].bss = bss_offset;
        image->bss_size = bss_offset + object.bss_size;
        if (image->text_alignment < object.text_alignment) {
            image->text_alignment = object.text_alignment;
        }
        if (image->rodata_alignment < object.rodata_alignment) {
            image->rodata_alignment = object.rodata_alignment;
        }
        if (image->data_alignment < object.data_alignment) {
            image->data_alignment = object.data_alignment;
        }
        if (image->bss_alignment < object.bss_alignment) {
            image->bss_alignment = object.bss_alignment;
        }
        object_index += 1;
    }
    return image->text.length != 0;
}

fn bootstrap_linker_layout_image(image: *BootstrapLinkImage) -> bool {
    let page: usize = BootstrapLinkerLimit.page_size as usize;
    let base: usize = BootstrapLinkerLimit.image_base as usize;
    let text_offset: usize = BootstrapLinkerLimit.text_offset as usize;
    var rodata_offset: usize = 0;
    var data_offset: usize = 0;
    if (!bootstrap_linker_align(text_offset + image->text.length, page, &rodata_offset) ||
        !bootstrap_linker_align(rodata_offset + image->rodata.length, page, &data_offset) ||
        data_offset > 18446744073709551615 as usize - base) {
        return bootstrap_linker_fail(image, runtime::Error.out_of_memory, image->input_index);
    }
    image->text_address = base + text_offset;
    image->rodata_address = base + rodata_offset;
    image->data_address = base + data_offset;
    if (!bootstrap_linker_align(
            image->data_address + image->data.length, image->bss_alignment, &image->bss_address)) {
        return bootstrap_linker_fail(image, runtime::Error.out_of_memory, image->input_index);
    }
    return true;
}

fn bootstrap_linker_section_address(
    image: *const BootstrapLinkImage, placement: BootstrapLinkPlacement, section: BootstrapObjectSection, result: *usize
) -> bool {
    if (result == null) {
        return false;
    }
    if (section == BootstrapObjectSection.text) {
        *result = image->text_address + placement.text;
        return true;
    }
    if (section == BootstrapObjectSection.rodata) {
        *result = image->rodata_address + placement.rodata;
        return true;
    }
    if (section == BootstrapObjectSection.data) {
        *result = image->data_address + placement.data;
        return true;
    }
    if (section == BootstrapObjectSection.bss) {
        *result = image->bss_address + placement.bss;
        return true;
    }
    return false;
}

fn bootstrap_linker_symbol_address(
    image: *const BootstrapLinkImage, objects: *const BootstrapObject, placements: *const BootstrapLinkPlacement,
    object_index: usize, symbol_index: usize, result: *usize) -> bool {
    let symbol_result: BootstrapObjectSymbolResult = bootstrap_object_get_symbol(objects[object_index], symbol_index);
    if (symbol_result.error != runtime::Error.none || !symbol_result.symbol.defined) {
        return false;
    }
    var section_address: usize = 0;
    if (!bootstrap_linker_section_address(
            image, placements[object_index], symbol_result.symbol.section, &section_address) ||
        symbol_result.symbol.value > 18446744073709551615 as usize - section_address) {
        return false;
    }
    *result = section_address + symbol_result.symbol.value;
    return true;
}

fn bootstrap_linker_resolve_symbol(
    image: *const BootstrapLinkImage, objects: *const BootstrapObject, placements: *const BootstrapLinkPlacement,
    object_index: usize, symbol_index: usize, result: *usize) -> bool {
    let object: BootstrapObject = objects[object_index];
    let symbol_result: BootstrapObjectSymbolResult = bootstrap_object_get_symbol(object, symbol_index);
    if (symbol_result.error != runtime::Error.none) {
        return false;
    }
    if (symbol_result.symbol.defined) {
        return bootstrap_linker_symbol_address(image, objects, placements, object_index, symbol_index, result);
    }
    let name: text::ViewResult = bootstrap_object_symbol_name(object, symbol_result.symbol);
    var global: BootstrapLinkGlobal = {};
    return name.error == runtime::Error.none && bootstrap_linker_find_global(image, name.view, &global) &&
        bootstrap_linker_symbol_address(image, objects, placements, global.object_index, global.symbol_index, result);
}

fn bootstrap_linker_region(
    image: *BootstrapLinkImage, placement: BootstrapLinkPlacement, section: BootstrapObjectSection,
    output_offset: *usize, address: *usize) -> *bytes::Buffer {
    if (section == BootstrapObjectSection.text) {
        *output_offset = placement.text;
        *address = image->text_address;
        return &image->text;
    }
    if (section == BootstrapObjectSection.rodata) {
        *output_offset = placement.rodata;
        *address = image->rodata_address;
        return &image->rodata;
    }
    if (section == BootstrapObjectSection.data) {
        *output_offset = placement.data;
        *address = image->data_address;
        return &image->data;
    }
    return null;
}

fn bootstrap_linker_store_u32(destination: *u8, value: u32) -> bool {
    if (destination == null) {
        return false;
    }
    var index: usize = 0;
    while (index < 4) {
        destination[index] = ((value >> ((index * 8) as u32)) & 255) as u8;
        index += 1;
    }
    return true;
}

fn bootstrap_linker_store_u64(destination: *u8, value: u64) -> bool {
    if (destination == null) {
        return false;
    }
    var index: usize = 0;
    while (index < 8) {
        destination[index] = ((value >> ((index * 8) as u64)) & 255) as u8;
        index += 1;
    }
    return true;
}

fn bootstrap_linker_apply_relocations(
    image: *BootstrapLinkImage, objects: *const BootstrapObject, object_count: usize,
    placements: *const BootstrapLinkPlacement) -> bool {
    var object_index: usize = 0;
    while (object_index < object_count) {
        image->input_index = object_index;
        let object: BootstrapObject = objects[object_index];
        var relocation_index: usize = 0;
        while (relocation_index < bootstrap_object_relocation_count(object)) {
            let result: BootstrapObjectRelocationResult = bootstrap_object_get_relocation(object, relocation_index);
            if (result.error != runtime::Error.none) {
                return bootstrap_linker_fail(image, result.error, object_index);
            }
            let relocation: BootstrapObjectRelocation = result.relocation;
            var symbol_address: usize = 0;
            if (!bootstrap_linker_resolve_symbol(
                    image as *const BootstrapLinkImage, objects, placements, object_index, relocation.symbol_index,
                    &symbol_address)) {
                return bootstrap_linker_fail(image, runtime::Error.not_found, object_index);
            }
            var placement_offset: usize = 0;
            var region_address: usize = 0;
            let region: *bytes::Buffer = bootstrap_linker_region(
                image, placements[object_index], relocation.section, &placement_offset, &region_address);
            let width: usize = relocation.kind == BootstrapObjectRelocationKind.absolute64 ? 8 : 4;
            if (region == null || relocation.offset > region->length || placement_offset > region->length ||
                relocation.offset > region->length - placement_offset || width > region->length -
                        placement_offset - relocation.offset) {
                return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
            }
            let output_offset: usize = placement_offset + relocation.offset;
            if (relocation.kind == BootstrapObjectRelocationKind.pc32 || relocation.kind ==
                    BootstrapObjectRelocationKind.plt32) {
                if (symbol_address > 9223372036854775807 as usize || region_address >
                        9223372036854775807 as usize - output_offset) {
                    return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
                }
                let place: isize = (region_address + output_offset) as isize;
                let difference: isize = symbol_address as isize - place;
                if ((relocation.addend > 0 && difference > 9223372036854775807 as isize - relocation.addend) ||
                    (relocation.addend < 0 && difference < -9223372036854775807 as isize - 1 - relocation.addend)) {
                    return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
                }
                let value: isize = difference + relocation.addend;
                if (value < -2147483648 || value > 2147483647 ||
                    !bootstrap_linker_store_u32(
                        &region->data[output_offset], value as u32)) {
                    return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
                }
            } else if (relocation.kind == BootstrapObjectRelocationKind.absolute64) {
                let signed_symbol: isize = symbol_address as isize;
                if (symbol_address > 9223372036854775807 as usize || (relocation.addend > 0 && signed_symbol >
                        9223372036854775807 as isize - relocation.addend) || (relocation.addend < 0 && signed_symbol <
                        -9223372036854775807 as isize - 1 - relocation.addend) ||
                    !bootstrap_linker_store_u64(
                        &region->data[output_offset], (signed_symbol + relocation.addend) as u64)) {
                    return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
                }
            } else if (relocation.kind == BootstrapObjectRelocationKind.absolute32 || relocation.kind ==
                    BootstrapObjectRelocationKind.signed32) {
                let signed_symbol: isize = symbol_address as isize;
                if (symbol_address > 9223372036854775807 as usize || (relocation.addend > 0 && signed_symbol >
                        9223372036854775807 as isize - relocation.addend) || (relocation.addend < 0 && signed_symbol <
                        -9223372036854775807 as isize - 1 - relocation.addend)) {
                    return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
                }
                let value: isize = signed_symbol + relocation.addend;
                if ((relocation.kind == BootstrapObjectRelocationKind.absolute32 && (value < 0 || value >
                        4294967295)) || (relocation.kind == BootstrapObjectRelocationKind.signed32 && (value <
                        -2147483648 || value > 2147483647)) ||
                    !bootstrap_linker_store_u32(
                        &region->data[output_offset], value as u32)) {
                    return bootstrap_linker_fail(image, runtime::Error.invalid_argument, object_index);
                }
            } else {
                return bootstrap_linker_fail(image, runtime::Error.not_supported, object_index);
            }
            relocation_index += 1;
        }
        object_index += 1;
    }
    return true;
}

fn bootstrap_linker_resolve_entry(
    image: *BootstrapLinkImage, objects: *const BootstrapObject, placements: *const BootstrapLinkPlacement) -> bool {
    let entry: text::ViewResult = text::view("_start", 6);
    var global: BootstrapLinkGlobal = {};
    if (entry.error != runtime::Error.none ||
        !bootstrap_linker_find_global(image as *const BootstrapLinkImage, entry.view, &global) ||
        !bootstrap_linker_symbol_address(
            image as *const BootstrapLinkImage, objects, placements, global.object_index, global.symbol_index,
            &image->entry_address)) {
        return bootstrap_linker_fail(image, runtime::Error.not_found, image->input_index);
    }
    let symbol: BootstrapObjectSymbolResult =
        bootstrap_object_get_symbol(objects[global.object_index], global.symbol_index);
    if (symbol.error != runtime::Error.none || symbol.symbol.section != BootstrapObjectSection.text ||
        symbol.symbol.kind != BootstrapObjectSymbolKind.function) {
        return bootstrap_linker_fail(image, runtime::Error.invalid_argument, global.object_index);
    }
    return true;
}

fn bootstrap_linker_write_header(
    output: *bytes::Buffer, image: *const BootstrapLinkImage, program_count: usize) -> bool {
    return bootstrap_linker_append_bytes(output, "\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00", 16) &&
        bootstrap_linker_append_u16(output, (BootstrapElf.executable_type as usize) as u16) &&
        bootstrap_linker_append_u16(output, (BootstrapElf.machine_x86_64 as usize) as u16) &&
        bootstrap_linker_append_u32(output, 1) && bootstrap_linker_append_u64(output, image->entry_address as u64) &&
        bootstrap_linker_append_u64(output, (BootstrapElf.header_size as usize) as u64) &&
        bootstrap_linker_append_u64(output, 0) && bootstrap_linker_append_u32(output, 0) &&
        bootstrap_linker_append_u16(output, (BootstrapElf.header_size as usize) as u16) &&
        bootstrap_linker_append_u16(output, (BootstrapElf.program_header_size as usize) as u16) &&
        bootstrap_linker_append_u16(output, program_count as u16) &&
        bootstrap_linker_append_u16(output, 0) && bootstrap_linker_append_u16(output, 0) &&
        bootstrap_linker_append_u16(output, 0);
}

fn bootstrap_linker_write_program(
    output: *bytes::Buffer, flags: u32, offset: usize, address: usize, file_size: usize, memory_size: usize) -> bool {
    return bootstrap_linker_append_u32(output, (BootstrapElf.load_segment as usize) as u32) &&
        bootstrap_linker_append_u32(output, flags) && bootstrap_linker_append_u64(output, offset as u64) &&
        bootstrap_linker_append_u64(output, address as u64) && bootstrap_linker_append_u64(output, address as u64) &&
        bootstrap_linker_append_u64(output, file_size as u64) &&
        bootstrap_linker_append_u64(output, memory_size as u64) &&
        bootstrap_linker_append_u64(output, (BootstrapLinkerLimit.page_size as usize) as u64);
}

fn bootstrap_linker_serialize(image: *const BootstrapLinkImage) -> bytes::BufferResult {
    var output: bytes::Buffer = bytes::empty();
    let has_rodata: bool = image->rodata.length != 0;
    let has_data: bool = image->data.length != 0 || image->bss_size != 0;
    let program_count: usize = 1 + (has_rodata ? 1 : 0) + (has_data ? 1 : 0);
    if (!bootstrap_linker_write_header(&output, image, program_count) ||
        !bootstrap_linker_write_program(
            &output, ((BootstrapElf.flag_read as usize) | (BootstrapElf.flag_execute as usize)) as u32,
            BootstrapLinkerLimit.text_offset as usize, image->text_address, image->text.length, image->text.length)) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = runtime::Error.out_of_memory,
        };
    }
    let base: usize = BootstrapLinkerLimit.image_base as usize;
    let rodata_offset: usize = image->rodata_address - base;
    let data_offset: usize = image->data_address - base;
    if (has_rodata &&
        !bootstrap_linker_write_program(
            &output, (BootstrapElf.flag_read as usize) as u32, rodata_offset, image->rodata_address,
            image->rodata.length, image->rodata.length)) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = runtime::Error.out_of_memory,
        };
    }
    if (has_data) {
        let memory_size: usize = image->bss_size == 0 ? image->data.length : image->bss_address + image->bss_size -
                    image->data_address;
        if (!bootstrap_linker_write_program(
                &output, ((BootstrapElf.flag_read as usize) | (BootstrapElf.flag_write as usize)) as u32, data_offset,
                image->data_address, image->data.length, memory_size)) {
            bytes::release(output);
            return {
                buffer = bytes::empty(), error = runtime::Error.out_of_memory,
            };
        }
    }
    if (!bootstrap_linker_pad_to(&output, BootstrapLinkerLimit.text_offset as usize) ||
        !bootstrap_linker_append_bytes(&output, image->text.data as *const u8, image->text.length) ||
        (has_rodata && (!bootstrap_linker_pad_to(&output, rodata_offset) ||
          !bootstrap_linker_append_bytes(
            &output, image->rodata.data as *const u8, image->rodata.length))) || (has_data &&
         (!bootstrap_linker_pad_to(&output, data_offset) ||
          !bootstrap_linker_append_bytes(
            &output, image->data.data as *const u8, image->data.length)))) {
        bytes::release(output);
        return {
            buffer = bytes::empty(), error = runtime::Error.out_of_memory,
        };
    }
    return {
        buffer = output, error = runtime::Error.none,
    };
}

fn bootstrap_linker_image_release(image: BootstrapLinkImage) -> runtime::Error {
    var error: runtime::Error = bytes::release(image.globals);
    let data_error: runtime::Error = bytes::release(image.data);
    let rodata_error: runtime::Error = bytes::release(image.rodata);
    let text_error: runtime::Error = bytes::release(image.text);
    if (error == runtime::Error.none) {
        error = data_error;
    }
    if (error == runtime::Error.none) {
        error = rodata_error;
    }
    if (error == runtime::Error.none) {
        error = text_error;
    }
    return error;
}

fn bootstrap_x86_64_link(objects: *const BootstrapObject, object_count: usize) -> BootstrapLinkerResult {
    var image: BootstrapLinkImage = bootstrap_linker_image_empty();
    if (objects == null || object_count == 0 || object_count > BootstrapLinkerLimit.maximum_inputs as usize) {
        return {
            executable = bytes::empty(), error = runtime::Error.invalid_argument, input_index = 0,
        };
    }
    var placements: [65]BootstrapLinkPlacement = {};
    var executable: bytes::BufferResult = {
        buffer = bytes::empty(), error = runtime::Error.invalid_argument,
    };
    if (bootstrap_linker_collect_globals(&image, objects, object_count) &&
        bootstrap_linker_layout_regions(&image, objects, object_count, &placements[0]) &&
        bootstrap_linker_layout_image(&image) &&
        bootstrap_linker_apply_relocations(
            &image, objects, object_count, &placements[0] as *const BootstrapLinkPlacement) &&
        bootstrap_linker_resolve_entry(
            &image, objects, &placements[0] as *const BootstrapLinkPlacement)) {
        executable = bootstrap_linker_serialize(&image as *const BootstrapLinkImage);
        if (executable.error != runtime::Error.none) {
            image.error = executable.error;
        }
    }
    let image_error: runtime::Error = bootstrap_linker_image_release(image);
    if (image.error == runtime::Error.none && executable.error == runtime::Error.none &&
        image_error != runtime::Error.none) {
        bytes::release(executable.buffer);
        return {
            executable = bytes::empty(), error = image_error, input_index = image.input_index,
        };
    }
    if (image.error != runtime::Error.none) {
        if (executable.error == runtime::Error.none) {
            bytes::release(executable.buffer);
        }
        return {
            executable = bytes::empty(), error = image.error, input_index = image.input_index,
        };
    }
    return {
        executable = executable.buffer, error = executable.error, input_index = image.input_index,
    };
}

