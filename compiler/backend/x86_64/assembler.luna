module luna.bootstrap.backend.x86_64.assembler;

import luna.std.bytes;

enum BootstrapAssemblerLimit: usize {
    maximum_source = 67108864, maximum_line = 1048576, maximum_fixups = 1048576, maximum_numeric_labels = 1048576,
}

enum BootstrapAssemblerRegisterClass: usize {
    general = 0, vector = 1,
}

enum BootstrapAssemblerOperandKind: usize {
    none = 0, immediate = 1, register = 2, memory = 3, label = 4,
}

enum BootstrapAssemblerFixupKind: usize {
    branch = 0, call = 1, rip_relative = 2,
}

struct BootstrapAssemblerRegister {
    class: BootstrapAssemblerRegisterClass;
    code: u8;
    width: usize;
}

struct BootstrapAssemblerMemory {
    symbol: StdTextView;
    displacement: isize;
    base: BootstrapAssemblerRegister;
    index: BootstrapAssemblerRegister;
    scale: u8;
    rip_relative: bool;
    has_index: bool;
}

struct BootstrapAssemblerOperand {
    kind: BootstrapAssemblerOperandKind;
    immediate: u64;
    register: BootstrapAssemblerRegister;
    memory: BootstrapAssemblerMemory;
    label: StdTextView;
}

struct BootstrapAssemblerOperands {
    values: [3]BootstrapAssemblerOperand;
    count: usize;
}

struct BootstrapAssemblerFixup {
    target: StdTextView;
    section: BootstrapObjectSection;
    offset: usize;
    line: usize;
    kind: BootstrapAssemblerFixupKind;
    numeric_label: usize;
    numeric_forward: bool;
    is_numeric: bool;
}

struct BootstrapAssemblerNumericLabel {
    section: BootstrapObjectSection;
    offset: usize;
    number: usize;
}

struct BootstrapAssembler {
    object: BootstrapObject;
    section: BootstrapObjectSection;
    fixups: StdByteBuffer;
    numeric_labels: StdByteBuffer;
    line: usize;
    error: RuntimeError;
}

fn bootstrap_assembler_empty_register()
    -> BootstrapAssemblerRegister {
    return {
        class = BootstrapAssemblerRegisterClass.general, code = 0, width = 0,
    };
}

fn bootstrap_assembler_empty_memory() -> BootstrapAssemblerMemory {
    return {
        symbol = { data = null, length = 0, }, displacement = 0, base = bootstrap_assembler_empty_register(),
        index = bootstrap_assembler_empty_register(), scale = 1, rip_relative = false, has_index = false,
    };
}

fn bootstrap_assembler_empty_operand()
    -> BootstrapAssemblerOperand {
    return {
        kind = BootstrapAssemblerOperandKind.none, immediate = 0, register = bootstrap_assembler_empty_register(),
        memory = bootstrap_assembler_empty_memory(), label = { data = null, length = 0, },
    };
}

fn bootstrap_assembler_empty_operands()
    -> BootstrapAssemblerOperands {
    var result: BootstrapAssemblerOperands = {};
    result.count = 0;
    return result;
}

fn bootstrap_assembler_fail(assembler: *BootstrapAssembler, error: RuntimeError) -> bool {
    if (assembler != null && assembler->error == RuntimeError.none) {
        assembler->error = error;
    }
    return false;
}

fn bootstrap_assembler_is_space(value: u8) -> bool {
    return value == 32 || value == 9 || value == 13;
}

fn bootstrap_assembler_trim(view: StdTextView) -> StdTextView {
    var offset: usize = 0;
    while (offset < view.length && bootstrap_assembler_is_space(view.data[offset])) {
        offset += 1;
    }
    var end: usize = view.length;
    while (end > offset && bootstrap_assembler_is_space(view.data[end - 1])) {
        end -= 1;
    }
    return {
        data = end == offset ? null as *const u8 : &view.data[offset], length = end - offset,
    };
}

fn bootstrap_assembler_equal(view: StdTextView, text: *const u8, length: usize) -> bool {
    if (view.length != length || (length != 0 && (view.data == null || text == null))) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (view.data[index] != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_starts_with(view: StdTextView, text: *const u8, length: usize) -> bool {
    if (view.length < length || (length != 0 && (view.data == null || text == null))) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (view.data[index] != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_slice(view: StdTextView, offset: usize, length: usize) -> StdTextView {
    if (offset > view.length || length > view.length - offset || length == 0) {
        return { data = null, length = 0, };
    }
    return {
        data = &view.data[offset], length = length,
    };
}

fn bootstrap_assembler_find(view: StdTextView, value: u8) -> usize {
    var index: usize = 0;
    while (index < view.length) {
        if (view.data[index] == value) {
            return index;
        }
        index += 1;
    }
    return view.length;
}

fn bootstrap_assembler_digit(value: u8, base: u64, result: *u64) -> bool {
    var digit: u64 = 0;
    if (value >= 48 && value <= 57) {
        digit = (value - 48) as u64;
    } else if (value >= 97 && value <= 102) {
        digit = (value - 97 + 10) as u64;
    } else if (value >= 65 && value <= 70) {
        digit = (value - 65 + 10) as u64;
    } else {
        return false;
    }
    if (digit >= base || result == null) {
        return false;
    }
    *result = digit;
    return true;
}

fn bootstrap_assembler_parse_bits(input: StdTextView, result: *u64) -> bool {
    let view: StdTextView = bootstrap_assembler_trim(input);
    if (view.length == 0 || result == null) {
        return false;
    }
    var offset: usize = 0;
    var negative: bool = false;
    if (view.data[0] == 45) {
        negative = true;
        offset = 1;
        if (offset == view.length) {
            return false;
        }
    }
    var base: u64 = 10;
    if (view.length - offset >= 2 && view.data[offset] == 48 && (view.data[offset + 1] == 120 ||
         view.data[offset + 1] == 88)) {
        base = 16;
        offset += 2;
        if (offset == view.length) {
            return false;
        }
    }
    var value: u64 = 0;
    while (offset < view.length) {
        var digit: u64 = 0;
        if (!bootstrap_assembler_digit(view.data[offset], base, &digit) ||
            value > (18446744073709551615 as u64 - digit) / base) {
            return false;
        }
        value = value * base + digit;
        offset += 1;
    }
    if (!negative) {
        *result = value;
        return true;
    }
    if (value > 9223372036854775808 as u64) {
        return false;
    }
    if (value == 9223372036854775808 as u64) {
        *result = value;
    } else {
        *result = (-(value as isize)) as u64;
    }
    return true;
}

fn bootstrap_assembler_parse_i32(input: StdTextView, result: *isize) -> bool {
    let view: StdTextView = bootstrap_assembler_trim(input);
    var bits: u64 = 0;
    if (!bootstrap_assembler_parse_bits(view, &bits) || result == null) {
        return false;
    }
    if (view.data[0] != 45 && bits > 2147483647 as u64) {
        return false;
    }
    let value: isize = bits as isize;
    if (value < -2147483648 || value > 2147483647) {
        return false;
    }
    *result = value;
    return true;
}

fn bootstrap_assembler_parse_usize(input: StdTextView, result: *usize) -> bool {
    let view: StdTextView = bootstrap_assembler_trim(input);
    var bits: u64 = 0;
    if (view.length == 0 || view.data[0] == 45 || !bootstrap_assembler_parse_bits(view, &bits) ||
        bits > 18446744073709551615 as u64 || result == null) {
        return false;
    }
    *result = bits as usize;
    return true;
}

fn bootstrap_assembler_named_register(
    view: StdTextView, name: *const u8, length: usize, code: u8, width: usize, result: *BootstrapAssemblerRegister
) -> bool {
    if (!bootstrap_assembler_equal(view, name, length)) {
        return false;
    }
    result->class = BootstrapAssemblerRegisterClass.general;
    result->code = code;
    result->width = width;
    return true;
}

fn bootstrap_assembler_parse_register(input: StdTextView, result: *BootstrapAssemblerRegister) -> bool {
    let view: StdTextView = bootstrap_assembler_trim(input);
    if (result == null || view.length < 2 || view.data[0] != 37) {
        return false;
    }
    let name: StdTextView = bootstrap_assembler_slice(view, 1, view.length - 1);
    if (bootstrap_assembler_named_register(name, "al", 2, 0, 8, result) ||
        bootstrap_assembler_named_register(name, "cl", 2, 1, 8, result) ||
        bootstrap_assembler_named_register(name, "dl", 2, 2, 8, result) ||
        bootstrap_assembler_named_register(name, "bl", 2, 3, 8, result) ||
        bootstrap_assembler_named_register(name, "spl", 3, 4, 8, result) ||
        bootstrap_assembler_named_register(name, "bpl", 3, 5, 8, result) ||
        bootstrap_assembler_named_register(name, "sil", 3, 6, 8, result) ||
        bootstrap_assembler_named_register(name, "dil", 3, 7, 8, result) ||
        bootstrap_assembler_named_register(name, "ax", 2, 0, 16, result) ||
        bootstrap_assembler_named_register(name, "cx", 2, 1, 16, result) ||
        bootstrap_assembler_named_register(name, "dx", 2, 2, 16, result) ||
        bootstrap_assembler_named_register(name, "bx", 2, 3, 16, result) ||
        bootstrap_assembler_named_register(name, "sp", 2, 4, 16, result) ||
        bootstrap_assembler_named_register(name, "bp", 2, 5, 16, result) ||
        bootstrap_assembler_named_register(name, "si", 2, 6, 16, result) ||
        bootstrap_assembler_named_register(name, "di", 2, 7, 16, result) ||
        bootstrap_assembler_named_register(name, "eax", 3, 0, 32, result) ||
        bootstrap_assembler_named_register(name, "ecx", 3, 1, 32, result) ||
        bootstrap_assembler_named_register(name, "edx", 3, 2, 32, result) ||
        bootstrap_assembler_named_register(name, "ebx", 3, 3, 32, result) ||
        bootstrap_assembler_named_register(name, "esp", 3, 4, 32, result) ||
        bootstrap_assembler_named_register(name, "ebp", 3, 5, 32, result) ||
        bootstrap_assembler_named_register(name, "esi", 3, 6, 32, result) ||
        bootstrap_assembler_named_register(name, "edi", 3, 7, 32, result) ||
        bootstrap_assembler_named_register(name, "rax", 3, 0, 64, result) ||
        bootstrap_assembler_named_register(name, "rcx", 3, 1, 64, result) ||
        bootstrap_assembler_named_register(name, "rdx", 3, 2, 64, result) ||
        bootstrap_assembler_named_register(name, "rbx", 3, 3, 64, result) ||
        bootstrap_assembler_named_register(name, "rsp", 3, 4, 64, result) ||
        bootstrap_assembler_named_register(name, "rbp", 3, 5, 64, result) ||
        bootstrap_assembler_named_register(name, "rsi", 3, 6, 64, result) ||
        bootstrap_assembler_named_register(
            name, "rdi", 3, 7, 64, result)) {
        return true;
    }
    var vector: bool = false;
    var digit_offset: usize = 0;
    if (bootstrap_assembler_starts_with(name, "xmm", 3)) {
        vector = true;
        digit_offset = 3;
    } else if (name.length >= 2 && name.data[0] == 114) {
        digit_offset = 1;
    } else {
        return false;
    }
    var code: usize = 0;
    let digit_start: usize = digit_offset;
    while (digit_offset < name.length && name.data[digit_offset] >= 48 && name.data[digit_offset] <= 57) {
        code = code * 10 + (name.data[digit_offset] - 48) as usize;
        if (code > 15) {
            return false;
        }
        digit_offset += 1;
    }
    if (digit_offset == digit_start) {
        return false;
    }
    if (vector) {
        if (digit_offset != name.length) {
            return false;
        }
        result->class = BootstrapAssemblerRegisterClass.vector;
        result->code = code as u8;
        result->width = 128;
        return true;
    }
    if (code < 8) {
        return false;
    }
    var width: usize = 64;
    if (digit_offset < name.length) {
        if (digit_offset + 1 != name.length) {
            return false;
        }
        let suffix: u8 = name.data[digit_offset];
        if (suffix == 98) {
            width = 8;
        } else if (suffix == 119) {
            width = 16;
        } else if (suffix == 100) {
            width = 32;
        } else {
            return false;
        }
    }
    result->class = BootstrapAssemblerRegisterClass.general;
    result->code = code as u8;
    result->width = width;
    return true;
}

fn bootstrap_assembler_parse_memory(input: StdTextView, result: *BootstrapAssemblerMemory) -> bool {
    let view: StdTextView = bootstrap_assembler_trim(input);
    let open: usize = bootstrap_assembler_find(view, 40);
    if (result == null || open == view.length || view.length < open + 3 || view.data[view.length - 1] != 41) {
        return false;
    }
    *result = bootstrap_assembler_empty_memory();
    let displacement: StdTextView = bootstrap_assembler_trim(bootstrap_assembler_slice(view, 0, open));
    let inside: StdTextView = bootstrap_assembler_slice(view, open + 1, view.length - open - 2);
    var pieces: [3]StdTextView = {};
    var piece_count: usize = 0;
    var start: usize = 0;
    var index: usize = 0;
    while (index <= inside.length) {
        if (index == inside.length || inside.data[index] == 44) {
            if (piece_count >= 3) {
                return false;
            }
            pieces[piece_count] = bootstrap_assembler_trim(bootstrap_assembler_slice(inside, start, index - start));
            piece_count += 1;
            start = index + 1;
        }
        index += 1;
    }
    if (piece_count == 0 || pieces[0].length == 0) {
        return false;
    }
    if (bootstrap_assembler_equal(pieces[0], "%rip", 4)) {
        if (piece_count != 1 || displacement.length == 0) {
            return false;
        }
        result->rip_relative = true;
        result->symbol = displacement;
        return true;
    }
    if (!bootstrap_assembler_parse_register(pieces[0], &result->base) ||
        result->base.class != BootstrapAssemblerRegisterClass.general || result->base.width != 64) {
        return false;
    }
    if (displacement.length != 0 &&
        !bootstrap_assembler_parse_i32(
            displacement, &result->displacement)) {
        return false;
    }
    if (piece_count >= 2 && pieces[1].length != 0) {
        if (!bootstrap_assembler_parse_register(pieces[1], &result->index) ||
            result->index.class != BootstrapAssemblerRegisterClass.general || result->index.width != 64 ||
            result->index.code == 4) {
            return false;
        }
        result->has_index = true;
    }
    if (piece_count == 3) {
        var scale: u64 = 0;
        if (!result->has_index || !bootstrap_assembler_parse_bits(pieces[2], &scale) || (scale != 1 && scale != 2 &&
             scale != 4 && scale != 8)) {
            return false;
        }
        result->scale = scale as u8;
    }
    return true;
}

fn bootstrap_assembler_parse_operand(input: StdTextView, result: *BootstrapAssemblerOperand) -> bool {
    let trimmed: StdTextView = bootstrap_assembler_trim(input);
    if (result == null || trimmed.length == 0) {
        return false;
    }
    var view: StdTextView = trimmed;
    if (view.data[0] == 42) {
        view = bootstrap_assembler_trim(bootstrap_assembler_slice(view, 1, view.length - 1));
        if (view.length == 0) {
            return false;
        }
    }
    *result = bootstrap_assembler_empty_operand();
    if (view.data[0] == 36) {
        result->kind = BootstrapAssemblerOperandKind.immediate;
        return bootstrap_assembler_parse_bits(bootstrap_assembler_slice(view, 1, view.length - 1), &result->immediate);
    }
    if (view.data[0] == 37) {
        result->kind = BootstrapAssemblerOperandKind.register;
        return bootstrap_assembler_parse_register(view, &result->register);
    }
    if (bootstrap_assembler_find(view, 40) != view.length) {
        result->kind = BootstrapAssemblerOperandKind.memory;
        return bootstrap_assembler_parse_memory(view, &result->memory);
    }
    result->kind = BootstrapAssemblerOperandKind.label;
    result->label = view;
    return true;
}

fn bootstrap_assembler_parse_operands(input: StdTextView, result: *BootstrapAssemblerOperands) -> bool {
    if (result == null) {
        return false;
    }
    *result = bootstrap_assembler_empty_operands();
    let text: StdTextView = bootstrap_assembler_trim(input);
    if (text.length == 0) {
        return true;
    }
    var depth: usize = 0;
    var start: usize = 0;
    var index: usize = 0;
    while (index <= text.length) {
        if (index < text.length && text.data[index] == 40) {
            depth += 1;
        } else if (index < text.length && text.data[index] == 41) {
            if (depth == 0) {
                return false;
            }
            depth -= 1;
        }
        if (index == text.length || (text.data[index] == 44 && depth == 0)) {
            if (result->count >= 3 ||
                !bootstrap_assembler_parse_operand(
                    bootstrap_assembler_slice(text, start, index - start), &result->values[result->count])) {
                return false;
            }
            result->count += 1;
            start = index + 1;
        }
        index += 1;
    }
    return depth == 0;
}

fn bootstrap_assembler_is_gpr(operand: *const BootstrapAssemblerOperand, width: usize) -> bool {
    return operand != null && operand->kind == BootstrapAssemblerOperandKind.register && operand->register.class ==
            BootstrapAssemblerRegisterClass.general && operand->register.width == width;
}

fn bootstrap_assembler_is_xmm(operand: *const BootstrapAssemblerOperand) -> bool {
    return operand != null && operand->kind == BootstrapAssemblerOperandKind.register && operand->register.class ==
            BootstrapAssemblerRegisterClass.vector;
}

fn bootstrap_assembler_is_rm(operand: *const BootstrapAssemblerOperand, width: usize) -> bool {
    return operand != null && (operand->kind == BootstrapAssemblerOperandKind.memory ||
         bootstrap_assembler_is_gpr(operand, width));
}

fn bootstrap_assembler_section_buffer(assembler: *BootstrapAssembler) -> *StdByteBuffer {
    if (assembler == null) {
        return null;
    }
    if (assembler->section == BootstrapObjectSection.text) {
        return &assembler->object.text;
    }
    if (assembler->section == BootstrapObjectSection.rodata) {
        return &assembler->object.rodata;
    }
    if (assembler->section == BootstrapObjectSection.data) {
        return &assembler->object.data;
    }
    return null;
}

fn bootstrap_assembler_append_u8(assembler: *BootstrapAssembler, value: u8) -> bool {
    if (assembler == null ||
        !bootstrap_object_append_u8(
            &assembler->object, assembler->section, value)) {
        return bootstrap_assembler_fail(
            assembler, assembler == null ? RuntimeError.invalid_argument : assembler->object.error);
    }
    return true;
}

fn bootstrap_assembler_append_u16(assembler: *BootstrapAssembler, value: u16) -> bool {
    return bootstrap_assembler_append_u8(assembler, (value & 255) as u8) &&
        bootstrap_assembler_append_u8(assembler, ((value >> 8) & 255) as u8);
}

fn bootstrap_assembler_append_u32(assembler: *BootstrapAssembler, value: u32) -> bool {
    var index: usize = 0;
    while (index < 4) {
        if (!bootstrap_assembler_append_u8(
                assembler, ((value >> ((index * 8) as u32)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_append_u64(assembler: *BootstrapAssembler, value: u64) -> bool {
    var index: usize = 0;
    while (index < 8) {
        if (!bootstrap_assembler_append_u8(
                assembler, ((value >> ((index * 8) as u64)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_append_opcode(assembler: *BootstrapAssembler, first: u8, second: u8, count: usize) -> bool {
    return count >= 1 && bootstrap_assembler_append_u8(assembler, first) && (count == 1 ||
         bootstrap_assembler_append_u8(assembler, second));
}

fn bootstrap_assembler_numeric_reference(target: StdTextView, number: *usize, forward: *bool) -> bool {
    if (target.length < 2 || number == null || forward == null) {
        return false;
    }
    let suffix: u8 = target.data[target.length - 1];
    if (suffix != 102 && suffix != 98) {
        return false;
    }
    var value: usize = 0;
    var index: usize = 0;
    while (index + 1 < target.length) {
        let digit: u8 = target.data[index];
        if (digit < 48 || digit > 57 || value > (18446744073709551615 as usize - (digit - 48) as usize) / 10) {
            return false;
        }
        value = value * 10 + (digit - 48) as usize;
        index += 1;
    }
    *number = value;
    *forward = suffix == 102;
    return true;
}

fn bootstrap_assembler_add_fixup(
    assembler: *BootstrapAssembler, target: StdTextView, offset: usize, kind: BootstrapAssemblerFixupKind) -> bool {
    if (assembler == null || assembler->fixups.length / sizeof(BootstrapAssemblerFixup) >=
                BootstrapAssemblerLimit.maximum_fixups as usize) {
        return bootstrap_assembler_fail(assembler, RuntimeError.out_of_memory);
    }
    var fixup: BootstrapAssemblerFixup = {
        target = target, section = assembler->section, offset = offset, line = assembler->line, kind = kind,
        numeric_label = 0, numeric_forward = false, is_numeric = false,
    };
    fixup.is_numeric = bootstrap_assembler_numeric_reference(target, &fixup.numeric_label, &fixup.numeric_forward);
    let appended: StdByteBufferResult = std_byte_buffer_append(
        assembler->fixups, (&fixup) as *const BootstrapAssemblerFixup as *const u8, sizeof(BootstrapAssemblerFixup));
    assembler->fixups = appended.buffer;
    if (appended.error != RuntimeError.none) {
        return bootstrap_assembler_fail(assembler, appended.error);
    }
    return true;
}

fn bootstrap_assembler_rex_for_rm(operand: *const BootstrapAssemblerOperand) -> u8 {
    if (operand->kind == BootstrapAssemblerOperandKind.register) {
        return operand->register.code >= 8 ? 1 : 0;
    }
    if (operand->kind != BootstrapAssemblerOperandKind.memory || operand->memory.rip_relative) {
        return 0;
    }
    var rex: u8 = operand->memory.base.code >= 8 ? 1 : 0;
    if (operand->memory.has_index && operand->memory.index.code >= 8) {
        rex |= 2;
    }
    return rex;
}

fn bootstrap_assembler_emit_prefix_opcode(
    assembler: *BootstrapAssembler, legacy_prefix: u8, rex_w: bool, force_rex: bool, reg_field: u8,
    rm: *const BootstrapAssemblerOperand, opcode_first: u8, opcode_second: u8, opcode_count: usize) -> bool {
    if (legacy_prefix != 0 &&
        !bootstrap_assembler_append_u8(
            assembler, legacy_prefix)) {
        return false;
    }
    var rex: u8 = 64;
    if (rex_w) {
        rex |= 8;
    }
    if (reg_field >= 8) {
        rex |= 4;
    }
    rex |= bootstrap_assembler_rex_for_rm(rm);
    if ((rex != 64 || force_rex) && !bootstrap_assembler_append_u8(assembler, rex)) {
        return false;
    }
    return bootstrap_assembler_append_opcode(assembler, opcode_first, opcode_second, opcode_count);
}

fn bootstrap_assembler_emit_modrm(
    assembler: *BootstrapAssembler, reg_field: u8, rm: *const BootstrapAssemblerOperand) -> bool {
    if (rm->kind == BootstrapAssemblerOperandKind.register) {
        return bootstrap_assembler_append_u8(
            assembler, ((192 as u8) | ((reg_field & 7) << 3) | (rm->register.code & 7)) as u8);
    }
    if (rm->kind != BootstrapAssemblerOperandKind.memory) {
        return false;
    }
    if (rm->memory.rip_relative) {
        let modrm: u8 = (((reg_field & 7) << 3) | 5) as u8;
        if (!bootstrap_assembler_append_u8(assembler, modrm)) {
            return false;
        }
        let output: *StdByteBuffer = bootstrap_assembler_section_buffer(assembler);
        return output != null &&
            bootstrap_assembler_add_fixup(
                assembler, rm->memory.symbol, output->length, BootstrapAssemblerFixupKind.rip_relative) &&
            bootstrap_assembler_append_u32(assembler, 0);
    }
    let base: u8 = rm->memory.base.code & 7;
    var mode: u8 = 0;
    if (rm->memory.displacement == 0 && base != 5) {
        mode = 0;
    } else if (rm->memory.displacement >= -128 && rm->memory.displacement <= 127) {
        mode = 1;
    } else {
        mode = 2;
    }
    let sib_required: bool = base == 4 || rm->memory.has_index;
    let rm_field: u8 = sib_required ? 4 : base;
    if (!bootstrap_assembler_append_u8(
            assembler, ((mode << 6) | ((reg_field & 7) << 3) | rm_field) as u8)) {
        return false;
    }
    if (sib_required) {
        var scale_bits: u8 = 0;
        if (rm->memory.scale == 2) {
            scale_bits = 1;
        } else if (rm->memory.scale == 4) {
            scale_bits = 2;
        } else if (rm->memory.scale == 8) {
            scale_bits = 3;
        }
        let index: u8 = rm->memory.has_index ? rm->memory.index.code & 7 : 4;
        if (!bootstrap_assembler_append_u8(
                assembler, ((scale_bits << 6) | (index << 3) | base) as u8)) {
            return false;
        }
    }
    if (mode == 1) {
        return bootstrap_assembler_append_u8(assembler, rm->memory.displacement as u8);
    }
    if (mode == 2) {
        return bootstrap_assembler_append_u32(assembler, rm->memory.displacement as u32);
    }
    return true;
}

fn bootstrap_assembler_emit_rm(
    assembler: *BootstrapAssembler, legacy_prefix: u8, rex_w: bool, force_rex: bool, opcode_first: u8,
    opcode_second: u8, opcode_count: usize, reg_field: u8, rm: *const BootstrapAssemblerOperand) -> bool {
    return bootstrap_assembler_emit_prefix_opcode(
            assembler, legacy_prefix, rex_w, force_rex, reg_field, rm, opcode_first, opcode_second, opcode_count) &&
        bootstrap_assembler_emit_modrm(assembler, reg_field, rm);
}

fn bootstrap_assembler_emit_relative(
    assembler: *BootstrapAssembler, opcode_first: u8, opcode_second: u8, opcode_count: usize,
    operands: *const BootstrapAssemblerOperands, kind: BootstrapAssemblerFixupKind) -> bool {
    if (operands->count != 1 || operands->values[0].kind != BootstrapAssemblerOperandKind.label ||
        !bootstrap_assembler_append_opcode(
            assembler, opcode_first, opcode_second, opcode_count)) {
        return false;
    }
    let output: *StdByteBuffer = bootstrap_assembler_section_buffer(assembler);
    return output != null &&
        bootstrap_assembler_add_fixup(assembler, operands->values[0].label, output->length, kind) &&
        bootstrap_assembler_append_u32(assembler, 0);
}

fn bootstrap_assembler_emit_indirect_transfer(
    assembler: *BootstrapAssembler, operand: *const BootstrapAssemblerOperand, reg_field: u8) -> bool {
    let code: u8 = operand->register.code;
    return (code < 8 || bootstrap_assembler_append_u8(assembler, 65)) &&
        bootstrap_assembler_append_u8(assembler, 255) &&
        bootstrap_assembler_append_u8(assembler, ((192 as u8) | ((reg_field & 7) << 3) | (code & 7)) as u8);
}

fn bootstrap_assembler_fits_i32(bits: u64) -> bool {
    let value: isize = bits as isize;
    return value >= -2147483648 && value <= 2147483647;
}

fn bootstrap_assembler_fits_u32(bits: u64) -> bool {
    return bits <= 4294967295 as u64 || bootstrap_assembler_fits_i32(bits);
}

fn bootstrap_assembler_fits_u16(bits: u64) -> bool {
    let value: isize = bits as isize;
    return bits <= 65535 as u64 || (value >= -32768 && value <= 32767);
}

fn bootstrap_assembler_fits_u8(bits: u64) -> bool {
    let value: isize = bits as isize;
    return bits <= 255 as u64 || (value >= -128 && value <= 127);
}

fn bootstrap_assembler_emit_binary_alu(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, width: usize, register_opcode: u8,
    immediate_group: u8) -> bool {
    if (operands->count != 2 || !bootstrap_assembler_is_rm(&operands->values[1], width)) {
        return false;
    }
    let source: *const BootstrapAssemblerOperand = &operands->values[0];
    let destination: *const BootstrapAssemblerOperand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == BootstrapAssemblerOperandKind.immediate) {
        if ((width == 64 && !bootstrap_assembler_fits_i32(source->immediate)) || (width == 32 &&
                !bootstrap_assembler_fits_u32(source->immediate)) || (width == 16 &&
                !bootstrap_assembler_fits_u16(source->immediate)) || (width == 8 &&
                !bootstrap_assembler_fits_u8(source->immediate))) {
            return false;
        }
        if (!bootstrap_assembler_emit_rm(
                assembler, legacy, rex_w, byte && destination->kind == BootstrapAssemblerOperandKind.register &&
                    destination->register.code >= 4, byte ? 128 : 129, 0, 1, immediate_group, destination)) {
            return false;
        }
        if (byte) {
            return bootstrap_assembler_append_u8(assembler, source->immediate as u8);
        }
        if (word) {
            return bootstrap_assembler_append_u16(assembler, source->immediate as u16);
        }
        return bootstrap_assembler_append_u32(assembler, source->immediate as u32);
    }
    if (!bootstrap_assembler_is_gpr(source, width)) {
        return false;
    }
    return bootstrap_assembler_emit_rm(
        assembler, legacy, rex_w, byte && (source->register.code >= 4 || (destination->kind ==
                BootstrapAssemblerOperandKind.register && destination->register.code >= 4)), register_opcode, 0, 1,
        source->register.code, destination);
}

fn bootstrap_assembler_emit_move(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, width: usize) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const BootstrapAssemblerOperand = &operands->values[0];
    let destination: *const BootstrapAssemblerOperand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == BootstrapAssemblerOperandKind.immediate) {
        if (!bootstrap_assembler_is_rm(destination, width) || (width == 64 &&
                !bootstrap_assembler_fits_i32(source->immediate)) || (width == 32 &&
                !bootstrap_assembler_fits_u32(source->immediate)) || (width == 16 &&
                !bootstrap_assembler_fits_u16(source->immediate)) || (width == 8 &&
                !bootstrap_assembler_fits_u8(source->immediate))) {
            return false;
        }
        if (!bootstrap_assembler_emit_rm(
                assembler, legacy, rex_w, byte && destination->kind == BootstrapAssemblerOperandKind.register &&
                    destination->register.code >= 4, byte ? 198 : 199, 0, 1, 0, destination)) {
            return false;
        }
        if (byte) {
            return bootstrap_assembler_append_u8(assembler, source->immediate as u8);
        }
        if (word) {
            return bootstrap_assembler_append_u16(assembler, source->immediate as u16);
        }
        return bootstrap_assembler_append_u32(assembler, source->immediate as u32);
    }
    if (bootstrap_assembler_is_gpr(source, width) && bootstrap_assembler_is_rm(destination, width)) {
        return bootstrap_assembler_emit_rm(
            assembler, legacy, rex_w, byte && (source->register.code >= 4 || (destination->kind ==
                    BootstrapAssemblerOperandKind.register && destination->register.code >= 4)), byte ? 136 : 137, 0, 1,
            source->register.code, destination);
    }
    if (source->kind == BootstrapAssemblerOperandKind.memory && bootstrap_assembler_is_gpr(destination, width)) {
        return bootstrap_assembler_emit_rm(
            assembler, legacy, rex_w, byte && destination->register.code >= 4, byte ? 138 : 139, 0, 1,
            destination->register.code, source);
    }
    return false;
}

fn bootstrap_assembler_emit_xmm_move(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, double_precision: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const BootstrapAssemblerOperand = &operands->values[0];
    let destination: *const BootstrapAssemblerOperand = &operands->values[1];
    let prefix: u8 = double_precision ? 242 : 243;
    if (bootstrap_assembler_is_xmm(destination) && (bootstrap_assembler_is_xmm(source) ||
         source->kind == BootstrapAssemblerOperandKind.memory)) {
        return bootstrap_assembler_emit_rm(
            assembler, prefix, false, false, 15, 16, 2, destination->register.code, source);
    }
    if (bootstrap_assembler_is_xmm(source) && destination->kind == BootstrapAssemblerOperandKind.memory) {
        return bootstrap_assembler_emit_rm(
            assembler, prefix, false, false, 15, 17, 2, source->register.code, destination);
    }
    return false;
}

fn bootstrap_assembler_emit_movd_or_movq(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, quad: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const BootstrapAssemblerOperand = &operands->values[0];
    let destination: *const BootstrapAssemblerOperand = &operands->values[1];
    let width: usize = quad ? 64 : 32;
    if (bootstrap_assembler_is_gpr(source, width) && bootstrap_assembler_is_xmm(destination)) {
        return bootstrap_assembler_emit_rm(assembler, 102, quad, false, 15, 110, 2, destination->register.code, source);
    }
    if (bootstrap_assembler_is_xmm(source) && bootstrap_assembler_is_gpr(destination, width)) {
        return bootstrap_assembler_emit_rm(assembler, 102, quad, false, 15, 126, 2, source->register.code, destination);
    }
    if (quad && bootstrap_assembler_is_xmm(source) && destination->kind == BootstrapAssemblerOperandKind.memory) {
        return bootstrap_assembler_emit_rm(
            assembler, 102, false, false, 15, 214, 2, source->register.code, destination);
    }
    if (quad && bootstrap_assembler_is_xmm(destination) && (source->kind == BootstrapAssemblerOperandKind.memory ||
         bootstrap_assembler_is_xmm(source))) {
        return bootstrap_assembler_emit_rm(
            assembler, 243, false, false, 15, 126, 2, destination->register.code, source);
    }
    return false;
}

fn bootstrap_assembler_emit_extend(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, source_width: usize,
    destination_width: usize, sign_extend: bool) -> bool {
    if (operands->count != 2 || !(operands->values[0].kind == BootstrapAssemblerOperandKind.memory ||
          bootstrap_assembler_is_gpr(
            &operands->values[0], source_width)) ||
        !bootstrap_assembler_is_gpr(
            &operands->values[1], destination_width)) {
        return false;
    }
    let second: u8 = source_width == 8 ? (sign_extend ? 190 : 182) : source_width == 16 ? (sign_extend ? 191 : 183) : 0;
    if (second == 0) {
        return false;
    }
    return bootstrap_assembler_emit_rm(
        assembler, 0, destination_width == 64, operands->values[0].kind == BootstrapAssemblerOperandKind.register &&
            source_width == 8 && operands->values[0].register.code >= 4, 15, second, 2,
        operands->values[1].register.code, &operands->values[0]);
}

fn bootstrap_assembler_emit_unary(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, width: usize, group: u8) -> bool {
    return operands->count == 1 && (operands->values[0].kind == BootstrapAssemblerOperandKind.memory ||
         bootstrap_assembler_is_gpr(&operands->values[0], width)) &&
        bootstrap_assembler_emit_rm(
            assembler, width == 16 ? 102 : 0, width == 64, false, 247, 0, 1, group, &operands->values[0]);
}

fn bootstrap_assembler_emit_shift(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, width: usize, group: u8) -> bool {
    if (operands->count != 2 || !bootstrap_assembler_is_gpr(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == BootstrapAssemblerOperandKind.immediate && operands->values[0].immediate <= 255) {
        return bootstrap_assembler_emit_rm(assembler, 0, width == 64, false, 193, 0, 1, group, &operands->values[1]) &&
            bootstrap_assembler_append_u8(assembler, operands->values[0].immediate as u8);
    }
    return bootstrap_assembler_is_gpr(&operands->values[0], 8) && operands->values[0].register.code == 1 &&
        bootstrap_assembler_emit_rm(assembler, 0, width == 64, false, 211, 0, 1, group, &operands->values[1]);
}

fn bootstrap_assembler_condition(name: StdTextView, result: *u8) -> bool {
    if (result == null) {
        return false;
    }
    if (bootstrap_assembler_equal(name, "o", 1)) {
        *result = 0;
    } else if (bootstrap_assembler_equal(name, "no", 2)) {
        *result = 1;
    } else if (bootstrap_assembler_equal(name, "b", 1) || bootstrap_assembler_equal(name, "c", 1) ||
        bootstrap_assembler_equal(name, "nae", 3)) {
        *result = 2;
    } else if (bootstrap_assembler_equal(name, "ae", 2) || bootstrap_assembler_equal(name, "nb", 2) ||
        bootstrap_assembler_equal(name, "nc", 2)) {
        *result = 3;
    } else if (bootstrap_assembler_equal(name, "e", 1) || bootstrap_assembler_equal(name, "z", 1)) {
        *result = 4;
    } else if (bootstrap_assembler_equal(name, "ne", 2) || bootstrap_assembler_equal(name, "nz", 2)) {
        *result = 5;
    } else if (bootstrap_assembler_equal(name, "be", 2) || bootstrap_assembler_equal(name, "na", 2)) {
        *result = 6;
    } else if (bootstrap_assembler_equal(name, "a", 1) || bootstrap_assembler_equal(name, "nbe", 3)) {
        *result = 7;
    } else if (bootstrap_assembler_equal(name, "s", 1)) {
        *result = 8;
    } else if (bootstrap_assembler_equal(name, "ns", 2)) {
        *result = 9;
    } else if (bootstrap_assembler_equal(name, "p", 1) || bootstrap_assembler_equal(name, "pe", 2)) {
        *result = 10;
    } else if (bootstrap_assembler_equal(name, "np", 2) || bootstrap_assembler_equal(name, "po", 2)) {
        *result = 11;
    } else if (bootstrap_assembler_equal(name, "l", 1) || bootstrap_assembler_equal(name, "nge", 3)) {
        *result = 12;
    } else if (bootstrap_assembler_equal(name, "ge", 2) || bootstrap_assembler_equal(name, "nl", 2)) {
        *result = 13;
    } else if (bootstrap_assembler_equal(name, "le", 2) || bootstrap_assembler_equal(name, "ng", 2)) {
        *result = 14;
    } else if (bootstrap_assembler_equal(name, "g", 1) || bootstrap_assembler_equal(name, "nle", 3)) {
        *result = 15;
    } else {
        return false;
    }
    return true;
}

fn bootstrap_assembler_emit_set(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, condition: u8) -> bool {
    return operands->count == 1 && bootstrap_assembler_is_gpr(&operands->values[0], 8) &&
        bootstrap_assembler_emit_rm(
            assembler, 0, false, operands->values[0].register.code >= 4, 15, ((144 as u8) | condition) as u8, 2, 0,
            &operands->values[0]);
}

fn bootstrap_assembler_emit_sse_binary(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, prefix: u8, operation: u8) -> bool {
    return operands->count == 2 && (bootstrap_assembler_is_xmm(&operands->values[0]) || operands->values[0].kind ==
            BootstrapAssemblerOperandKind.memory) && bootstrap_assembler_is_xmm(&operands->values[1]) &&
        bootstrap_assembler_emit_rm(
            assembler, prefix, false, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

fn bootstrap_assembler_emit_conversion(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, prefix: u8, operation: u8, rex_w: bool,
    source_xmm: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    if (source_xmm) {
        if (!(bootstrap_assembler_is_xmm(&operands->values[0]) || operands->values[0].kind ==
                BootstrapAssemblerOperandKind.memory) ||
            !bootstrap_assembler_is_gpr(
                &operands->values[1], rex_w ? 64 : 32)) {
            return false;
        }
    } else if (!(bootstrap_assembler_is_gpr(&operands->values[0], rex_w ? 64 : 32) ||
                 operands->values[0].kind == BootstrapAssemblerOperandKind.memory) ||
               !bootstrap_assembler_is_xmm(&operands->values[1])) {
        return false;
    }
    return bootstrap_assembler_emit_rm(
        assembler, prefix, rex_w, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

fn bootstrap_assembler_emit_compare(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, width: usize, compare: bool) -> bool {
    if (operands->count != 2 || !bootstrap_assembler_is_rm(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == BootstrapAssemblerOperandKind.immediate) {
        if (!compare || (width == 64 && !bootstrap_assembler_fits_i32(operands->values[0].immediate)) || (width == 32 &&
                !bootstrap_assembler_fits_u32(operands->values[0].immediate)) || (width == 8 &&
                !bootstrap_assembler_fits_u8(
                    operands->values[0].immediate))) {
            return false;
        }
        let byte: bool = width == 8;
        if (!bootstrap_assembler_emit_rm(
                assembler, 0, width == 64, byte && operands->values[1].kind == BootstrapAssemblerOperandKind.register &&
                    operands->values[1].register.code >= 4, byte ? 128 : 129, 0, 1, 7, &operands->values[1])) {
            return false;
        }
        return byte ? bootstrap_assembler_append_u8(assembler, operands->values[0].immediate as u8) :
            bootstrap_assembler_append_u32(assembler, operands->values[0].immediate as u32);
    }
    if (!bootstrap_assembler_is_gpr(&operands->values[0], width)) {
        return false;
    }
    let opcode: u8 = compare ? (width == 8 ? 56 : 57) : (width == 8 ? 132 : 133);
    return bootstrap_assembler_emit_rm(
        assembler, 0, width == 64, width == 8 && (operands->values[0].register.code >= 4 || (operands->values[1].kind ==
                BootstrapAssemblerOperandKind.register && operands->values[1].register.code >= 4)), opcode, 0, 1,
        operands->values[0].register.code, &operands->values[1]);
}

fn bootstrap_assembler_emit_imul(
    assembler: *BootstrapAssembler, operands: *const BootstrapAssemblerOperands, width: usize) -> bool {
    if (operands->count == 2 && (bootstrap_assembler_is_gpr(&operands->values[0], width) || operands->values[0].kind ==
            BootstrapAssemblerOperandKind.memory) && bootstrap_assembler_is_gpr(&operands->values[1], width)) {
        return bootstrap_assembler_emit_rm(
            assembler, 0, width == 64, false, 15, 175, 2, operands->values[1].register.code, &operands->values[0]);
    }
    if (operands->count == 3 && operands->values[0].kind == BootstrapAssemblerOperandKind.immediate &&
        bootstrap_assembler_fits_i32(operands->values[0].immediate) &&
        (bootstrap_assembler_is_gpr(&operands->values[1], width) || operands->values[1].kind ==
            BootstrapAssemblerOperandKind.memory) && bootstrap_assembler_is_gpr(&operands->values[2], width)) {
        return bootstrap_assembler_emit_rm(
                assembler, 0, width == 64, false, 105, 0, 1, operands->values[2].register.code, &operands->values[1]) &&
            bootstrap_assembler_append_u32(assembler, operands->values[0].immediate as u32);
    }
    return false;
}

fn bootstrap_assembler_encode(
    assembler: *BootstrapAssembler, mnemonic: StdTextView, raw_operands: StdTextView,
    operands: *const BootstrapAssemblerOperands) -> bool {
    if (bootstrap_assembler_equal(mnemonic, "cld", 3)) {
        return operands->count == 0 && bootstrap_assembler_append_u8(assembler, 252);
    }
    if (bootstrap_assembler_equal(mnemonic, "std", 3)) {
        return operands->count == 0 && bootstrap_assembler_append_u8(assembler, 253);
    }
    if (bootstrap_assembler_equal(mnemonic, "cltd", 4)) {
        return operands->count == 0 && bootstrap_assembler_append_u8(assembler, 153);
    }
    if (bootstrap_assembler_equal(mnemonic, "cqto", 4)) {
        return operands->count == 0 && bootstrap_assembler_append_u8(assembler, 72) &&
            bootstrap_assembler_append_u8(assembler, 153);
    }
    if (bootstrap_assembler_equal(mnemonic, "leave", 5)) {
        return operands->count == 0 && bootstrap_assembler_append_u8(assembler, 201);
    }
    if (bootstrap_assembler_equal(mnemonic, "ret", 3)) {
        return operands->count == 0 && bootstrap_assembler_append_u8(assembler, 195);
    }
    if (bootstrap_assembler_equal(mnemonic, "syscall", 7)) {
        return operands->count == 0 && bootstrap_assembler_append_opcode(assembler, 15, 5, 2);
    }
    if (bootstrap_assembler_equal(mnemonic, "ud2", 3)) {
        return operands->count == 0 && bootstrap_assembler_append_opcode(assembler, 15, 11, 2);
    }
    if (bootstrap_assembler_equal(mnemonic, "rep", 3)) {
        if (operands->count != 1 || operands->values[0].kind != BootstrapAssemblerOperandKind.label ||
            !bootstrap_assembler_append_u8(assembler, 243)) {
            return false;
        }
        if (bootstrap_assembler_equal(raw_operands, "movsb", 5)) {
            return bootstrap_assembler_append_u8(assembler, 164);
        }
        if (bootstrap_assembler_equal(raw_operands, "stosb", 5)) {
            return bootstrap_assembler_append_u8(assembler, 170);
        }
        return false;
    }
    if (bootstrap_assembler_equal(mnemonic, "pushq", 5)) {
        if (operands->count != 1 || !bootstrap_assembler_is_gpr(&operands->values[0], 64)) {
            return false;
        }
        let code: u8 = operands->values[0].register.code;
        return (code < 8 || bootstrap_assembler_append_u8(assembler, 65)) &&
            bootstrap_assembler_append_u8(assembler, ((80 as u8) | (code & 7)) as u8);
    }
    if (bootstrap_assembler_equal(mnemonic, "call", 4) || bootstrap_assembler_equal(mnemonic, "jmp", 3)) {
        let is_call: bool = bootstrap_assembler_equal(mnemonic, "call", 4);
        if (operands->count == 1 &&
            bootstrap_assembler_is_gpr(
                &operands->values[0], 64)) {
            return bootstrap_assembler_emit_indirect_transfer(assembler, &operands->values[0], is_call ? 2 : 4);
        }
        return bootstrap_assembler_emit_relative(
            assembler, is_call ? 232 : 233, 0, 1, operands, is_call ? BootstrapAssemblerFixupKind.call :
                      BootstrapAssemblerFixupKind.branch);
    }
    if (mnemonic.length > 1 && mnemonic.data[0] == 106) {
        var condition: u8 = 0;
        if (bootstrap_assembler_condition(
                bootstrap_assembler_slice(mnemonic, 1, mnemonic.length - 1), &condition)) {
            return bootstrap_assembler_emit_relative(
                assembler, 15, ((128 as u8) | condition) as u8, 2, operands, BootstrapAssemblerFixupKind.branch);
        }
    }
    if (mnemonic.length > 3 && bootstrap_assembler_starts_with(mnemonic, "set", 3)) {
        var condition: u8 = 0;
        if (bootstrap_assembler_condition(
                bootstrap_assembler_slice(mnemonic, 3, mnemonic.length - 3), &condition)) {
            return bootstrap_assembler_emit_set(assembler, operands, condition);
        }
    }
    if (bootstrap_assembler_equal(mnemonic, "movabsq", 7)) {
        if (operands->count != 2 || operands->values[0].kind != BootstrapAssemblerOperandKind.immediate ||
            !bootstrap_assembler_is_gpr(&operands->values[1], 64)) {
            return false;
        }
        let code: u8 = operands->values[1].register.code;
        return bootstrap_assembler_append_u8(assembler, code >= 8 ? 73 : 72) &&
            bootstrap_assembler_append_u8(assembler, ((184 as u8) | (code & 7)) as u8) &&
            bootstrap_assembler_append_u64(assembler, operands->values[0].immediate);
    }
    if (bootstrap_assembler_equal(mnemonic, "movb", 4)) {
        return bootstrap_assembler_emit_move(assembler, operands, 8);
    }
    if (bootstrap_assembler_equal(mnemonic, "movw", 4)) {
        return bootstrap_assembler_emit_move(assembler, operands, 16);
    }
    if (bootstrap_assembler_equal(mnemonic, "movl", 4)) {
        return bootstrap_assembler_emit_move(assembler, operands, 32);
    }
    if (bootstrap_assembler_equal(mnemonic, "movd", 4)) {
        return bootstrap_assembler_emit_movd_or_movq(assembler, operands, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "movq", 4)) {
        if ((operands->count == 2 && (bootstrap_assembler_is_xmm(&operands->values[0]) ||
              bootstrap_assembler_is_xmm(&operands->values[1]))) &&
            bootstrap_assembler_emit_movd_or_movq(
                assembler, operands, true)) {
            return true;
        }
        return bootstrap_assembler_emit_move(assembler, operands, 64);
    }
    if (bootstrap_assembler_equal(mnemonic, "movss", 5)) {
        return bootstrap_assembler_emit_xmm_move(assembler, operands, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "movsd", 5)) {
        return bootstrap_assembler_emit_xmm_move(assembler, operands, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "movzbl", 6)) {
        return bootstrap_assembler_emit_extend(assembler, operands, 8, 32, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "movsbl", 6)) {
        return bootstrap_assembler_emit_extend(assembler, operands, 8, 32, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "movsbq", 6)) {
        return bootstrap_assembler_emit_extend(assembler, operands, 8, 64, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "movswl", 6)) {
        return bootstrap_assembler_emit_extend(assembler, operands, 16, 32, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "movswq", 6)) {
        return bootstrap_assembler_emit_extend(assembler, operands, 16, 64, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "movzwl", 6)) {
        return bootstrap_assembler_emit_extend(assembler, operands, 16, 32, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "movslq", 6)) {
        return operands->count == 2 && (bootstrap_assembler_is_gpr(&operands->values[0], 32) ||
             operands->values[0].kind == BootstrapAssemblerOperandKind.memory) &&
            bootstrap_assembler_is_gpr(&operands->values[1], 64) &&
            bootstrap_assembler_emit_rm(
                assembler, 0, true, false, 99, 0, 1, operands->values[1].register.code, &operands->values[0]);
    }
    if (bootstrap_assembler_equal(mnemonic, "leaq", 4)) {
        return operands->count == 2 && operands->values[0].kind == BootstrapAssemblerOperandKind.memory &&
            bootstrap_assembler_is_gpr(&operands->values[1], 64) &&
            bootstrap_assembler_emit_rm(
                assembler, 0, true, false, 141, 0, 1, operands->values[1].register.code, &operands->values[0]);
    }
    if (bootstrap_assembler_equal(mnemonic, "addl", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 32, 1, 0);
    }
    if (bootstrap_assembler_equal(mnemonic, "addq", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 64, 1, 0);
    }
    if (bootstrap_assembler_equal(mnemonic, "subl", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 32, 41, 5);
    }
    if (bootstrap_assembler_equal(mnemonic, "subq", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 64, 41, 5);
    }
    if (bootstrap_assembler_equal(mnemonic, "andl", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 32, 33, 4);
    }
    if (bootstrap_assembler_equal(mnemonic, "andb", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 8, 32, 4);
    }
    if (bootstrap_assembler_equal(mnemonic, "andq", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 64, 33, 4);
    }
    if (bootstrap_assembler_equal(mnemonic, "orq", 3)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 64, 9, 1);
    }
    if (bootstrap_assembler_equal(mnemonic, "orb", 3)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 8, 8, 1);
    }
    if (bootstrap_assembler_equal(mnemonic, "orl", 3)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 32, 9, 1);
    }
    if (bootstrap_assembler_equal(mnemonic, "xorl", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 32, 49, 6);
    }
    if (bootstrap_assembler_equal(mnemonic, "xorq", 4)) {
        return bootstrap_assembler_emit_binary_alu(assembler, operands, 64, 49, 6);
    }
    if (bootstrap_assembler_equal(mnemonic, "cmpl", 4)) {
        return bootstrap_assembler_emit_compare(assembler, operands, 32, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "cmpb", 4)) {
        return bootstrap_assembler_emit_compare(assembler, operands, 8, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "cmpq", 4)) {
        return bootstrap_assembler_emit_compare(assembler, operands, 64, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "testl", 5)) {
        return bootstrap_assembler_emit_compare(assembler, operands, 32, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "testb", 5)) {
        return bootstrap_assembler_emit_compare(assembler, operands, 8, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "testq", 5)) {
        return bootstrap_assembler_emit_compare(assembler, operands, 64, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "negq", 4)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 64, 3);
    }
    if (bootstrap_assembler_equal(mnemonic, "negl", 4)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 32, 3);
    }
    if (bootstrap_assembler_equal(mnemonic, "notq", 4)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 64, 2);
    }
    if (bootstrap_assembler_equal(mnemonic, "notl", 4)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 32, 2);
    }
    if (bootstrap_assembler_equal(mnemonic, "divq", 4)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 64, 6);
    }
    if (bootstrap_assembler_equal(mnemonic, "divl", 4)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 32, 6);
    }
    if (bootstrap_assembler_equal(mnemonic, "idivl", 5)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 32, 7);
    }
    if (bootstrap_assembler_equal(mnemonic, "idivq", 5)) {
        return bootstrap_assembler_emit_unary(assembler, operands, 64, 7);
    }
    if (bootstrap_assembler_equal(mnemonic, "imull", 5)) {
        return bootstrap_assembler_emit_imul(assembler, operands, 32);
    }
    if (bootstrap_assembler_equal(mnemonic, "imulq", 5)) {
        return bootstrap_assembler_emit_imul(assembler, operands, 64);
    }
    if (bootstrap_assembler_equal(mnemonic, "shlq", 4)) {
        return bootstrap_assembler_emit_shift(assembler, operands, 64, 4);
    }
    if (bootstrap_assembler_equal(mnemonic, "shll", 4)) {
        return bootstrap_assembler_emit_shift(assembler, operands, 32, 4);
    }
    if (bootstrap_assembler_equal(mnemonic, "shrq", 4)) {
        return bootstrap_assembler_emit_shift(assembler, operands, 64, 5);
    }
    if (bootstrap_assembler_equal(mnemonic, "shrl", 4)) {
        return bootstrap_assembler_emit_shift(assembler, operands, 32, 5);
    }
    if (bootstrap_assembler_equal(mnemonic, "sarl", 4)) {
        return bootstrap_assembler_emit_shift(assembler, operands, 32, 7);
    }
    if (bootstrap_assembler_equal(mnemonic, "sarq", 4)) {
        return bootstrap_assembler_emit_shift(assembler, operands, 64, 7);
    }
    if (bootstrap_assembler_equal(mnemonic, "ldmxcsr", 7)) {
        return operands->count == 1 && operands->values[0].kind == BootstrapAssemblerOperandKind.memory &&
            bootstrap_assembler_emit_rm(assembler, 0, false, false, 15, 174, 2, 2, &operands->values[0]);
    }
    if (bootstrap_assembler_equal(mnemonic, "addsd", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 88);
    }
    if (bootstrap_assembler_equal(mnemonic, "mulsd", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 89);
    }
    if (bootstrap_assembler_equal(mnemonic, "addss", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 88);
    }
    if (bootstrap_assembler_equal(mnemonic, "mulss", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 89);
    }
    if (bootstrap_assembler_equal(mnemonic, "subss", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 92);
    }
    if (bootstrap_assembler_equal(mnemonic, "subsd", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 92);
    }
    if (bootstrap_assembler_equal(mnemonic, "divss", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 94);
    }
    if (bootstrap_assembler_equal(mnemonic, "divsd", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 94);
    }
    if (bootstrap_assembler_equal(mnemonic, "sqrtsd", 6)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 81);
    }
    if (bootstrap_assembler_equal(mnemonic, "sqrtss", 6)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 81);
    }
    if (bootstrap_assembler_equal(mnemonic, "minsd", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 93);
    }
    if (bootstrap_assembler_equal(mnemonic, "minss", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 93);
    }
    if (bootstrap_assembler_equal(mnemonic, "maxsd", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 95);
    }
    if (bootstrap_assembler_equal(mnemonic, "maxss", 5)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 95);
    }
    if (bootstrap_assembler_equal(mnemonic, "ucomiss", 7)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 0, 46);
    }
    if (bootstrap_assembler_equal(mnemonic, "ucomisd", 7)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 102, 46);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvtss2sd", 8)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 243, 90);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvtsd2ss", 8)) {
        return bootstrap_assembler_emit_sse_binary(assembler, operands, 242, 90);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvtsi2sdq", 9)) {
        return bootstrap_assembler_emit_conversion(assembler, operands, 242, 42, true, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvtsi2ssq", 9)) {
        return bootstrap_assembler_emit_conversion(assembler, operands, 243, 42, true, false);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvttss2si", 9)) {
        return bootstrap_assembler_emit_conversion(assembler, operands, 243, 44, false, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvttss2siq", 10)) {
        return bootstrap_assembler_emit_conversion(assembler, operands, 243, 44, true, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvttsd2si", 9)) {
        return bootstrap_assembler_emit_conversion(assembler, operands, 242, 44, false, true);
    }
    if (bootstrap_assembler_equal(mnemonic, "cvttsd2siq", 10)) {
        return bootstrap_assembler_emit_conversion(assembler, operands, 242, 44, true, true);
    }
    return false;
}

fn bootstrap_assembler_symbol_name_is_valid(name: StdTextView) -> bool {
    if (name.length == 0 || name.data == null) {
        return false;
    }
    var index: usize = 0;
    while (index < name.length) {
        let value: u8 = name.data[index];
        let valid: bool = (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 95 || value == 46 || value == 36;
        if (!valid || (index == 0 && value >= 48 && value <= 57)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_get_symbol(assembler: *BootstrapAssembler, name: StdTextView) -> BootstrapObjectIndexResult {
    let result: BootstrapObjectIndexResult = bootstrap_object_add_symbol(&assembler->object, name);
    if (result.error != RuntimeError.none) {
        bootstrap_assembler_fail(assembler, result.error);
    }
    return result;
}

fn bootstrap_assembler_define_label(assembler: *BootstrapAssembler, name: StdTextView) -> bool {
    let section: *StdByteBuffer = bootstrap_assembler_section_buffer(assembler);
    if (section == null || name.length == 0) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    var numeric: bool = true;
    var index: usize = 0;
    var number: usize = 0;
    while (index < name.length) {
        if (name.data[index] < 48 || name.data[index] > 57) {
            numeric = false;
        } else if (numeric) {
            let digit: usize = (name.data[index] - 48) as usize;
            if (number > (18446744073709551615 as usize - digit) / 10) {
                return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
            }
            number = number * 10 + digit;
        }
        index += 1;
    }
    if (numeric) {
        let label: BootstrapAssemblerNumericLabel = {
            section = assembler->section, offset = section->length, number = number,
        };
        let appended: StdByteBufferResult = std_byte_buffer_append(
            assembler->numeric_labels, (&label) as *const BootstrapAssemblerNumericLabel as *const u8,
            sizeof(BootstrapAssemblerNumericLabel));
        assembler->numeric_labels = appended.buffer;
        if (appended.error != RuntimeError.none) {
            return bootstrap_assembler_fail(assembler, appended.error);
        }
        return true;
    }
    if (!bootstrap_assembler_symbol_name_is_valid(name)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let found: BootstrapObjectIndexResult = bootstrap_assembler_get_symbol(assembler, name);
    if (found.error != RuntimeError.none) {
        return false;
    }
    let symbol: *BootstrapObjectSymbol = bootstrap_object_symbol_mut(&assembler->object, found.index);
    if (symbol == null || symbol->defined || symbol->external) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    symbol->defined = true;
    symbol->section = assembler->section;
    symbol->value = section->length;
    return true;
}

fn bootstrap_assembler_mark_symbol(assembler: *BootstrapAssembler, input: StdTextView, external: bool) -> bool {
    let name: StdTextView = bootstrap_assembler_trim(input);
    if (!bootstrap_assembler_symbol_name_is_valid(name)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let found: BootstrapObjectIndexResult = bootstrap_assembler_get_symbol(assembler, name);
    if (found.error != RuntimeError.none) {
        return false;
    }
    let symbol: *BootstrapObjectSymbol = bootstrap_object_symbol_mut(&assembler->object, found.index);
    if (symbol == null || (external && symbol->defined)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    symbol->global = true;
    symbol->external = external;
    return true;
}

fn bootstrap_assembler_symbol_type(assembler: *BootstrapAssembler, input: StdTextView) -> bool {
    let comma: usize = bootstrap_assembler_find(input, 44);
    if (comma == input.length) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let name: StdTextView = bootstrap_assembler_trim(bootstrap_assembler_slice(input, 0, comma));
    let kind: StdTextView = bootstrap_assembler_trim(
        bootstrap_assembler_slice(input, comma + 1, input.length - comma - 1));
    if (!bootstrap_assembler_symbol_name_is_valid(name)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let found: BootstrapObjectIndexResult = bootstrap_assembler_get_symbol(assembler, name);
    let symbol: *BootstrapObjectSymbol = bootstrap_object_symbol_mut(&assembler->object, found.index);
    if (found.error != RuntimeError.none || symbol == null) {
        return false;
    }
    if (bootstrap_assembler_equal(kind, "@function", 9)) {
        symbol->kind = BootstrapObjectSymbolKind.function;
        return true;
    }
    if (bootstrap_assembler_equal(kind, "@object", 7)) {
        symbol->kind = BootstrapObjectSymbolKind.object;
        return true;
    }
    return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
}

fn bootstrap_assembler_symbol_size(assembler: *BootstrapAssembler, input: StdTextView) -> bool {
    let comma: usize = bootstrap_assembler_find(input, 44);
    if (comma == input.length) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let name: StdTextView = bootstrap_assembler_trim(bootstrap_assembler_slice(input, 0, comma));
    let expression: StdTextView = bootstrap_assembler_trim(
        bootstrap_assembler_slice(input, comma + 1, input.length - comma - 1));
    let found: BootstrapObjectIndexResult = bootstrap_object_find_symbol(assembler->object, name);
    let symbol: *BootstrapObjectSymbol = bootstrap_object_symbol_mut(&assembler->object, found.index);
    let section: *StdByteBuffer = bootstrap_assembler_section_buffer(assembler);
    if (!found.found || found.error != RuntimeError.none || symbol == null || !symbol->defined ||
        symbol->section != assembler->section || section == null || expression.length != name.length + 2 ||
        expression.data[0] != 46 || expression.data[1] != 45) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    var index: usize = 0;
    while (index < name.length) {
        if (expression.data[index + 2] != name.data[index]) {
            return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
        }
        index += 1;
    }
    if (symbol->value > section->length) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    symbol->size = section->length - symbol->value;
    return true;
}

fn bootstrap_assembler_alignment(assembler: *BootstrapAssembler, input: StdTextView, exponent: bool) -> bool {
    var parsed: usize = 0;
    if (!bootstrap_assembler_parse_usize(input, &parsed) || (exponent && parsed > 12)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let alignment: usize = exponent ? 1 << parsed : parsed;
    if (alignment == 0 || (alignment & (alignment - 1)) != 0 ||
        !bootstrap_object_set_alignment(
            &assembler->object, assembler->section, alignment)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let output: *StdByteBuffer = bootstrap_assembler_section_buffer(assembler);
    if (output == null) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let remainder: usize = output->length & (alignment - 1);
    var padding: usize = remainder == 0 ? 0 : alignment - remainder;
    let fill: u8 = assembler->section == BootstrapObjectSection.text ? 144 : 0;
    while (padding != 0) {
        if (!bootstrap_assembler_append_u8(assembler, fill)) {
            return false;
        }
        padding -= 1;
    }
    return true;
}

fn bootstrap_assembler_directive(assembler: *BootstrapAssembler, line: StdTextView) -> bool {
    var split: usize = 0;
    while (split < line.length && !bootstrap_assembler_is_space(line.data[split])) {
        split += 1;
    }
    let directive: StdTextView = bootstrap_assembler_slice(line, 0, split);
    let arguments: StdTextView = bootstrap_assembler_trim(bootstrap_assembler_slice(line, split, line.length - split));
    if (bootstrap_assembler_equal(directive, ".text", 5)) {
        assembler->section = BootstrapObjectSection.text;
        return true;
    }
    if (bootstrap_assembler_equal(directive, ".data", 5)) {
        assembler->section = BootstrapObjectSection.data;
        return true;
    }
    if (bootstrap_assembler_equal(directive, ".section", 8)) {
        let comma: usize = bootstrap_assembler_find(arguments, 44);
        let name: StdTextView = bootstrap_assembler_trim(
            bootstrap_assembler_slice(arguments, 0, comma == arguments.length ? arguments.length : comma));
        if (bootstrap_assembler_equal(name, ".text", 5)) {
            assembler->section = BootstrapObjectSection.text;
            return true;
        }
        if (bootstrap_assembler_equal(name, ".rodata", 7)) {
            assembler->section = BootstrapObjectSection.rodata;
            return true;
        }
        if (bootstrap_assembler_equal(name, ".data", 5)) {
            assembler->section = BootstrapObjectSection.data;
            return true;
        }
        if (bootstrap_assembler_equal(
                name, ".note.GNU-stack", 15)) {
            assembler->section = BootstrapObjectSection.undefined;
            return true;
        }
        return bootstrap_assembler_fail(assembler, RuntimeError.not_supported);
    }
    if (bootstrap_assembler_equal(directive, ".globl", 6)) {
        return bootstrap_assembler_mark_symbol(assembler, arguments, false);
    }
    if (bootstrap_assembler_equal(directive, ".extern", 7)) {
        return bootstrap_assembler_mark_symbol(assembler, arguments, true);
    }
    if (bootstrap_assembler_equal(directive, ".type", 5)) {
        return bootstrap_assembler_symbol_type(assembler, arguments);
    }
    if (bootstrap_assembler_equal(directive, ".size", 5)) {
        return bootstrap_assembler_symbol_size(assembler, arguments);
    }
    if (bootstrap_assembler_equal(directive, ".byte", 5)) {
        var bits: u64 = 0;
        let value: StdTextView = bootstrap_assembler_trim(arguments);
        return bootstrap_assembler_parse_bits(value, &bits) && bootstrap_assembler_fits_u8(bits) &&
            bootstrap_assembler_append_u8(assembler, bits as u8);
    }
    if (bootstrap_assembler_equal(directive, ".p2align", 8)) {
        return bootstrap_assembler_alignment(assembler, arguments, true);
    }
    if (bootstrap_assembler_equal(directive, ".balign", 7)) {
        return bootstrap_assembler_alignment(assembler, arguments, false);
    }
    return bootstrap_assembler_fail(assembler, RuntimeError.not_supported);
}

fn bootstrap_assembler_instruction(assembler: *BootstrapAssembler, line: StdTextView) -> bool {
    if (assembler->section != BootstrapObjectSection.text) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    var split: usize = 0;
    while (split < line.length && !bootstrap_assembler_is_space(line.data[split])) {
        split += 1;
    }
    let mnemonic: StdTextView = bootstrap_assembler_slice(line, 0, split);
    let raw_operands: StdTextView = bootstrap_assembler_trim(
        bootstrap_assembler_slice(line, split, line.length - split));
    var operands: BootstrapAssemblerOperands = bootstrap_assembler_empty_operands();
    if (!bootstrap_assembler_parse_operands(raw_operands, &operands) ||
        !bootstrap_assembler_encode(
            assembler, mnemonic, raw_operands, &operands as *const BootstrapAssemblerOperands)) {
        return bootstrap_assembler_fail(assembler, RuntimeError.not_supported);
    }
    return true;
}

fn bootstrap_assembler_line(assembler: *BootstrapAssembler, input: StdTextView) -> bool {
    let line: StdTextView = bootstrap_assembler_trim(input);
    if (line.length == 0) {
        return true;
    }
    if (line.data[line.length - 1] == 58) {
        return bootstrap_assembler_define_label(assembler, bootstrap_assembler_slice(line, 0, line.length - 1));
    }
    if (line.data[0] == 46) {
        return bootstrap_assembler_directive(assembler, line);
    }
    return bootstrap_assembler_instruction(assembler, line);
}

fn bootstrap_assembler_patch(assembler: *BootstrapAssembler, fixup: BootstrapAssemblerFixup, target: usize) -> bool {
    let output: *StdByteBuffer = fixup.section == BootstrapObjectSection.text ? &assembler->object.text :
        fixup.section == BootstrapObjectSection.rodata ? &assembler->object.rodata :
        fixup.section == BootstrapObjectSection.data ? &assembler->object.data : null;
    if (output == null || fixup.offset > output->length || (4 as usize) > output->length - fixup.offset ||
        target > 9223372036854775807 as usize || fixup.offset > 9223372036854775803 as usize) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let displacement: isize = target as isize - (fixup.offset + 4) as isize;
    if (displacement < -2147483648 || displacement > 2147483647) {
        return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
    }
    let bits: u32 = displacement as u32;
    var index: usize = 0;
    while (index < 4) {
        output->data[fixup.offset + index] = ((bits >> ((index * 8) as u32)) & 255) as u8;
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_numeric_target(
    assembler: *const BootstrapAssembler, fixup: BootstrapAssemblerFixup, result: *usize) -> bool {
    let labels: *const BootstrapAssemblerNumericLabel = assembler->numeric_labels.data as
            *const BootstrapAssemblerNumericLabel;
    let count: usize = assembler->numeric_labels.length / sizeof(BootstrapAssemblerNumericLabel);
    var found: bool = false;
    var selected: usize = fixup.numeric_forward ? 18446744073709551615 as usize : 0;
    var index: usize = 0;
    while (index < count) {
        let label: BootstrapAssemblerNumericLabel = labels[index];
        if (label.section == fixup.section && label.number == fixup.numeric_label) {
            if (fixup.numeric_forward && label.offset > fixup.offset && label.offset < selected) {
                selected = label.offset;
                found = true;
            } else if (!fixup.numeric_forward && label.offset <= fixup.offset && (!found || label.offset > selected)) {
                selected = label.offset;
                found = true;
            }
        }
        index += 1;
    }
    if (found) {
        *result = selected;
    }
    return found;
}

fn bootstrap_assembler_resolve_fixups(assembler: *BootstrapAssembler) -> bool {
    let fixups: *const BootstrapAssemblerFixup = assembler->fixups.data as *const BootstrapAssemblerFixup;
    let count: usize = assembler->fixups.length / sizeof(BootstrapAssemblerFixup);
    var index: usize = 0;
    while (index < count) {
        let fixup: BootstrapAssemblerFixup = fixups[index];
        assembler->line = fixup.line;
        if (fixup.is_numeric) {
            var target: usize = 0;
            if (fixup.kind == BootstrapAssemblerFixupKind.rip_relative ||
                !bootstrap_assembler_numeric_target(assembler as *const BootstrapAssembler, fixup, &target) ||
                !bootstrap_assembler_patch(
                    assembler, fixup, target)) {
                return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
            }
            index += 1;
            continue;
        }
        var found: BootstrapObjectIndexResult = bootstrap_object_find_symbol(assembler->object, fixup.target);
        if (!found.found && fixup.kind == BootstrapAssemblerFixupKind.call) {
            found = bootstrap_assembler_get_symbol(assembler, fixup.target);
            let created: *BootstrapObjectSymbol = bootstrap_object_symbol_mut(&assembler->object, found.index);
            if (created != null) {
                created->global = true;
                created->external = true;
            }
        }
        if (found.error != RuntimeError.none || !found.found && fixup.kind != BootstrapAssemblerFixupKind.call) {
            return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
        }
        let symbol: *BootstrapObjectSymbol = bootstrap_object_symbol_mut(&assembler->object, found.index);
        if (symbol == null) {
            return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
        }
        if (symbol->defined && symbol->section == fixup.section) {
            if (!bootstrap_assembler_patch(
                    assembler, fixup, symbol->value)) {
                return false;
            }
            index += 1;
            continue;
        }
        if (fixup.kind == BootstrapAssemblerFixupKind.branch) {
            return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
        }
        if (!symbol->defined) {
            symbol->global = true;
        }
        if (!bootstrap_object_add_relocation(
                &assembler->object, {
                    section = fixup.section, offset = fixup.offset, symbol_index = found.index, kind = fixup.kind ==
                            BootstrapAssemblerFixupKind.call ? BootstrapObjectRelocationKind.plt32 :
                            BootstrapObjectRelocationKind.pc32, addend = -4,
                })) {
            return bootstrap_assembler_fail(assembler, assembler->object.error);
        }
        index += 1;
    }
    return true;
}

fn bootstrap_assembler_validate_symbols(assembler: *BootstrapAssembler) -> bool {
    let count: usize = bootstrap_object_symbol_count(assembler->object);
    var index: usize = 0;
    while (index < count) {
        let result: BootstrapObjectSymbolResult = bootstrap_object_get_symbol(assembler->object, index);
        if (result.error != RuntimeError.none || (!result.symbol.defined && !result.symbol.global &&
             !result.symbol.external)) {
            return bootstrap_assembler_fail(assembler, RuntimeError.invalid_argument);
        }
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_assemble(assembly: StdTextView) -> BootstrapAssemblerResult {
    var assembler: BootstrapAssembler = {
        object = bootstrap_object_empty(), section = BootstrapObjectSection.undefined, fixups = std_byte_buffer_empty(),
        numeric_labels = std_byte_buffer_empty(), line = 1, error = RuntimeError.none,
    };
    if (!std_text_is_valid_utf8(assembly) || assembly.length > BootstrapAssemblerLimit.maximum_source as usize) {
        assembler.error = RuntimeError.invalid_argument;
    }
    var offset: usize = 0;
    while (assembler.error == RuntimeError.none && offset < assembly.length) {
        var end: usize = offset;
        while (end < assembly.length && assembly.data[end] != 10) {
            end += 1;
        }
        if (end - offset > BootstrapAssemblerLimit.maximum_line as usize ||
            !bootstrap_assembler_line(
                &assembler, bootstrap_assembler_slice(assembly, offset, end - offset))) {
            if (assembler.error == RuntimeError.none) {
                assembler.error = RuntimeError.invalid_argument;
            }
            break;
        }
        if (end == assembly.length) {
            offset = end;
        } else {
            offset = end + 1;
            assembler.line += 1;
        }
    }
    if (assembler.error == RuntimeError.none && (!bootstrap_assembler_resolve_fixups(&assembler) ||
         !bootstrap_assembler_validate_symbols(&assembler) || !bootstrap_object_is_valid(assembler.object))) {
        if (assembler.error == RuntimeError.none) {
            assembler.error = RuntimeError.invalid_argument;
        }
    }
    let fixup_error: RuntimeError = std_byte_buffer_release(assembler.fixups);
    let label_error: RuntimeError = std_byte_buffer_release(assembler.numeric_labels);
    if (assembler.error == RuntimeError.none && fixup_error != RuntimeError.none) {
        assembler.error = fixup_error;
    }
    if (assembler.error == RuntimeError.none && label_error != RuntimeError.none) {
        assembler.error = label_error;
    }
    if (assembler.error != RuntimeError.none) {
        bootstrap_object_release(assembler.object);
        assembler.object = bootstrap_object_empty();
    }
    return {
        object = assembler.object, error = assembler.error, line = assembler.line,
    };
}

