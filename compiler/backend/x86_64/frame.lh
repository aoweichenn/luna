export module luna.bootstrap.backend.x86_64.frame;

import luna.bootstrap.backend.x86_64.abi;
import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.type;
import luna.runtime;
import luna.std.bytes;

export enum BootstrapX8664StorageKind: usize {
    invalid, slot, value, aggregate_call_result, hidden_return_pointer, register_save_area,
}

export struct BootstrapX8664Storage {
    function_id: usize;
    kind: BootstrapX8664StorageKind;
    source_id: usize;
    type_id: usize;
    offset_bytes: usize;
    size_bytes: usize;
    alignment_bytes: usize;
}

export struct BootstrapX8664Frame {
    function_id: usize;
    first_storage: usize;
    storage_count: usize;
    frame_size_bytes: usize;
    // When nonzero, some storage requires alignment beyond the 16-byte stack
    // alignment: the prologue aligns rsp down to this boundary and every
    // frame reference is rsp-relative (rbp-relative offsets would not be
    // aligned, since rbp is only 16-byte aligned at entry).
    dynamic_alignment: usize;
}

export struct BootstrapX8664FramePlan {
    frames: bytes::Buffer;
    frame_count: usize;
    storage: bytes::Buffer;
    storage_count: usize;
    error: runtime::Error;
}

export struct BootstrapX8664FramePlanResult {
    plan: BootstrapX8664FramePlan;
    error: runtime::Error;
}

export struct BootstrapX8664FrameResult {
    frame: BootstrapX8664Frame;
    error: runtime::Error;
}

export struct BootstrapX8664StorageResult {
    storage: BootstrapX8664Storage;
    error: runtime::Error;
}

export fn bootstrap_x86_64_frame_plan_empty()
    -> BootstrapX8664FramePlan;
export fn bootstrap_x86_64_frame_plan_storage_is_valid(plan: BootstrapX8664FramePlan) -> bool;
export fn bootstrap_x86_64_frame_plan_build(
    ir: BootstrapTypedIr, types: BootstrapTypeTable, abi: BootstrapX8664Abi) -> BootstrapX8664FramePlanResult;
export fn bootstrap_x86_64_frame_plan_is_valid(
    plan: BootstrapX8664FramePlan, ir: BootstrapTypedIr, types: BootstrapTypeTable, abi: BootstrapX8664Abi) -> bool;
export fn bootstrap_x86_64_frame_get(plan: BootstrapX8664FramePlan, function_id: usize) -> BootstrapX8664FrameResult;
export fn bootstrap_x86_64_storage_find(
    plan: BootstrapX8664FramePlan, function_id: usize, kind: BootstrapX8664StorageKind, source_id: usize
) -> BootstrapX8664StorageResult;
export fn bootstrap_x86_64_frame_plan_release(plan: BootstrapX8664FramePlan) -> runtime::Error;

