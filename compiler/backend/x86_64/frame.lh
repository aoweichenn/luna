export module luna.bootstrap.backend.x86_64.frame;

import luna.bootstrap.backend.x86_64.abi as abi;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.bytes;

export enum StorageKind: usize {
    invalid, slot, value, aggregate_call_result, hidden_return_pointer, register_save_area,
}

export struct Storage {
    function_id: usize;
    kind: StorageKind;
    source_id: usize;
    type_id: usize;
    offset_bytes: usize;
    size_bytes: usize;
    alignment_bytes: usize;
}

export struct Frame {
    function_id: usize;
    first_storage: usize;
    storage_count: usize;
    frame_size_bytes: usize;
    // When nonzero, some storage requires alignment beyond the 16-byte stack
    // alignment: the prologue aligns rsp down to this boundary and every
    // frame reference is rsp-relative (rbp-relative offsets would not be
    // aligned, since rbp is only 16-byte aligned at entry).
    dynamic_alignment: usize;
}

export struct Plan {
    frames: bytes::Buffer;
    frame_count: usize;
    storage: bytes::Buffer;
    storage_count: usize;
    error: runtime::Error;
}

export struct PlanResult {
    plan: Plan;
    error: runtime::Error;
}

export struct Result {
    frame: Frame;
    error: runtime::Error;
}

export struct StorageResult {
    storage: Storage;
    error: runtime::Error;
}

export fn plan_empty()
    -> Plan;
export fn plan_storage_is_valid(plan: Plan) -> bool;
export fn plan_build(
    ir: ir::Store, types: type_info::Table, abi: abi::Abi) -> PlanResult;
export fn plan_is_valid(
    plan: Plan, ir: ir::Store, types: type_info::Table, abi: abi::Abi) -> bool;
export fn get(plan: Plan, function_id: usize) -> Result;
export fn storage_find(
    plan: Plan, function_id: usize, kind: StorageKind, source_id: usize
) -> StorageResult;
export fn plan_release(plan: Plan) -> runtime::Error;

