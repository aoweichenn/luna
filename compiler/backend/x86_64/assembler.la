module luna.bootstrap.backend.x86_64.assembler;

import luna.std.bytes as bytes;

enum Limit: usize {
    maximum_source = 67108864, maximum_line = 1048576, maximum_fixups = 1048576, maximum_numeric_labels = 1048576,
}

enum RegisterClass: usize {
    general = 0, vector = 1,
}

enum OperandKind: usize {
    none = 0, immediate = 1, register = 2, memory = 3, label = 4,
}

enum FixupKind: usize {
    branch = 0, call = 1, rip_relative = 2,
}

struct Register {
    class: RegisterClass;
    code: u8;
    width: usize;
}

struct Memory {
    symbol: text::View;
    displacement: isize;
    base: Register;
    index: Register;
    scale: u8;
    rip_relative: bool;
    has_index: bool;
}

struct Operand {
    kind: OperandKind;
    immediate: u64;
    register: Register;
    memory: Memory;
    label: text::View;
}

struct Operands {
    values: [3]Operand;
    count: usize;
}

struct Fixup {
    target: text::View;
    section: object::Section;
    offset: usize;
    line: usize;
    kind: FixupKind;
    numeric_label: usize;
    numeric_forward: bool;
    is_numeric: bool;
}

struct NumericLabel {
    section: object::Section;
    offset: usize;
    number: usize;
}

struct Assembler {
    object: object::Object;
    section: object::Section;
    fixups: bytes::Buffer;
    numeric_labels: bytes::Buffer;
    line: usize;
    error: runtime::Error;
}

fn empty_register()
    -> Register {
    return {
        class = RegisterClass.general, code = 0, width = 0,
    };
}

fn empty_memory() -> Memory {
    return {
        symbol = { data = null, length = 0, }, displacement = 0, base = empty_register(),
        index = empty_register(), scale = 1, rip_relative = false, has_index = false,
    };
}

fn empty_operand()
    -> Operand {
    return {
        kind = OperandKind.none, immediate = 0, register = empty_register(),
        memory = empty_memory(), label = { data = null, length = 0, },
    };
}

fn empty_operands()
    -> Operands {
    var result: Operands = {};
    result.count = 0;
    return result;
}

fn fail(assembler: *Assembler, error: runtime::Error) -> bool {
    if (assembler != null && assembler->error == runtime::Error.none) {
        assembler->error = error;
    }
    return false;
}

fn is_space(value: u8) -> bool {
    return value == 32 || value == 9 || value == 13;
}

fn trim(view: text::View) -> text::View {
    var offset: usize = 0;
    while (offset < view.length && is_space(view.data[offset])) {
        offset += 1;
    }
    var end: usize = view.length;
    while (end > offset && is_space(view.data[end - 1])) {
        end -= 1;
    }
    return {
        data = end == offset ? null as *const u8 : &view.data[offset], length = end - offset,
    };
}

fn equal(view: text::View, text: *const u8, length: usize) -> bool {
    if (view.length != length || (length != 0 && (view.data == null || text == null))) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (view.data[index] != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn starts_with(view: text::View, text: *const u8, length: usize) -> bool {
    if (view.length < length || (length != 0 && (view.data == null || text == null))) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (view.data[index] != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn slice(view: text::View, offset: usize, length: usize) -> text::View {
    if (offset > view.length || length > view.length - offset || length == 0) {
        return { data = null, length = 0, };
    }
    return {
        data = &view.data[offset], length = length,
    };
}

fn find(view: text::View, value: u8) -> usize {
    var index: usize = 0;
    while (index < view.length) {
        if (view.data[index] == value) {
            return index;
        }
        index += 1;
    }
    return view.length;
}

fn digit(value: u8, base: u64, result: *u64) -> bool {
    var digit: u64 = 0;
    if (value >= 48 && value <= 57) {
        digit = (value - 48) as u64;
    } else if (value >= 97 && value <= 102) {
        digit = (value - 97 + 10) as u64;
    } else if (value >= 65 && value <= 70) {
        digit = (value - 65 + 10) as u64;
    } else {
        return false;
    }
    if (digit >= base || result == null) {
        return false;
    }
    *result = digit;
    return true;
}

fn parse_bits(input: text::View, result: *u64) -> bool {
    let view: text::View = trim(input);
    if (view.length == 0 || result == null) {
        return false;
    }
    var offset: usize = 0;
    var negative: bool = false;
    if (view.data[0] == 45) {
        negative = true;
        offset = 1;
        if (offset == view.length) {
            return false;
        }
    }
    var base: u64 = 10;
    if (view.length - offset >= 2 && view.data[offset] == 48 && (view.data[offset + 1] == 120 ||
         view.data[offset + 1] == 88)) {
        base = 16;
        offset += 2;
        if (offset == view.length) {
            return false;
        }
    }
    var value: u64 = 0;
    while (offset < view.length) {
        var digit_value: u64 = 0;
        if (!digit(view.data[offset], base, &digit_value) ||
            value > (18446744073709551615 as u64 - digit_value) / base) {
            return false;
        }
        value = value * base + digit_value;
        offset += 1;
    }
    if (!negative) {
        *result = value;
        return true;
    }
    if (value > 9223372036854775808 as u64) {
        return false;
    }
    if (value == 9223372036854775808 as u64) {
        *result = value;
    } else {
        *result = (-(value as isize)) as u64;
    }
    return true;
}

fn parse_i32(input: text::View, result: *isize) -> bool {
    let view: text::View = trim(input);
    var bits: u64 = 0;
    if (!parse_bits(view, &bits) || result == null) {
        return false;
    }
    if (view.data[0] != 45 && bits > 2147483647 as u64) {
        return false;
    }
    let value: isize = bits as isize;
    if (value < -2147483648 || value > 2147483647) {
        return false;
    }
    *result = value;
    return true;
}

fn parse_usize(input: text::View, result: *usize) -> bool {
    let view: text::View = trim(input);
    var bits: u64 = 0;
    if (view.length == 0 || view.data[0] == 45 || !parse_bits(view, &bits) ||
        bits > 18446744073709551615 as u64 || result == null) {
        return false;
    }
    *result = bits as usize;
    return true;
}

fn named_register(
    view: text::View, name: *const u8, length: usize, code: u8, width: usize, result: *Register
) -> bool {
    if (!equal(view, name, length)) {
        return false;
    }
    result->class = RegisterClass.general;
    result->code = code;
    result->width = width;
    return true;
}

fn parse_register(input: text::View, result: *Register) -> bool {
    let view: text::View = trim(input);
    if (result == null || view.length < 2 || view.data[0] != 37) {
        return false;
    }
    let name: text::View = slice(view, 1, view.length - 1);
    if (named_register(name, "al", 2, 0, 8, result) ||
        named_register(name, "cl", 2, 1, 8, result) ||
        named_register(name, "dl", 2, 2, 8, result) ||
        named_register(name, "bl", 2, 3, 8, result) ||
        named_register(name, "spl", 3, 4, 8, result) ||
        named_register(name, "bpl", 3, 5, 8, result) ||
        named_register(name, "sil", 3, 6, 8, result) ||
        named_register(name, "dil", 3, 7, 8, result) ||
        named_register(name, "ax", 2, 0, 16, result) ||
        named_register(name, "cx", 2, 1, 16, result) ||
        named_register(name, "dx", 2, 2, 16, result) ||
        named_register(name, "bx", 2, 3, 16, result) ||
        named_register(name, "sp", 2, 4, 16, result) ||
        named_register(name, "bp", 2, 5, 16, result) ||
        named_register(name, "si", 2, 6, 16, result) ||
        named_register(name, "di", 2, 7, 16, result) ||
        named_register(name, "eax", 3, 0, 32, result) ||
        named_register(name, "ecx", 3, 1, 32, result) ||
        named_register(name, "edx", 3, 2, 32, result) ||
        named_register(name, "ebx", 3, 3, 32, result) ||
        named_register(name, "esp", 3, 4, 32, result) ||
        named_register(name, "ebp", 3, 5, 32, result) ||
        named_register(name, "esi", 3, 6, 32, result) ||
        named_register(name, "edi", 3, 7, 32, result) ||
        named_register(name, "rax", 3, 0, 64, result) ||
        named_register(name, "rcx", 3, 1, 64, result) ||
        named_register(name, "rdx", 3, 2, 64, result) ||
        named_register(name, "rbx", 3, 3, 64, result) ||
        named_register(name, "rsp", 3, 4, 64, result) ||
        named_register(name, "rbp", 3, 5, 64, result) ||
        named_register(name, "rsi", 3, 6, 64, result) ||
        named_register(
            name, "rdi", 3, 7, 64, result)) {
        return true;
    }
    var vector: bool = false;
    var digit_offset: usize = 0;
    if (starts_with(name, "xmm", 3)) {
        vector = true;
        digit_offset = 3;
    } else if (name.length >= 2 && name.data[0] == 114) {
        digit_offset = 1;
    } else {
        return false;
    }
    var code: usize = 0;
    let digit_start: usize = digit_offset;
    while (digit_offset < name.length && name.data[digit_offset] >= 48 && name.data[digit_offset] <= 57) {
        code = code * 10 + (name.data[digit_offset] - 48) as usize;
        if (code > 15) {
            return false;
        }
        digit_offset += 1;
    }
    if (digit_offset == digit_start) {
        return false;
    }
    if (vector) {
        if (digit_offset != name.length) {
            return false;
        }
        result->class = RegisterClass.vector;
        result->code = code as u8;
        result->width = 128;
        return true;
    }
    if (code < 8) {
        return false;
    }
    var width: usize = 64;
    if (digit_offset < name.length) {
        if (digit_offset + 1 != name.length) {
            return false;
        }
        let suffix: u8 = name.data[digit_offset];
        if (suffix == 98) {
            width = 8;
        } else if (suffix == 119) {
            width = 16;
        } else if (suffix == 100) {
            width = 32;
        } else {
            return false;
        }
    }
    result->class = RegisterClass.general;
    result->code = code as u8;
    result->width = width;
    return true;
}

fn parse_memory(input: text::View, result: *Memory) -> bool {
    let view: text::View = trim(input);
    let open: usize = find(view, 40);
    if (result == null || open == view.length || view.length < open + 3 || view.data[view.length - 1] != 41) {
        return false;
    }
    *result = empty_memory();
    let displacement: text::View = trim(slice(view, 0, open));
    let inside: text::View = slice(view, open + 1, view.length - open - 2);
    var pieces: [3]text::View = {};
    var piece_count: usize = 0;
    var start: usize = 0;
    var index: usize = 0;
    while (index <= inside.length) {
        if (index == inside.length || inside.data[index] == 44) {
            if (piece_count >= 3) {
                return false;
            }
            pieces[piece_count] = trim(slice(inside, start, index - start));
            piece_count += 1;
            start = index + 1;
        }
        index += 1;
    }
    if (piece_count == 0 || pieces[0].length == 0) {
        return false;
    }
    if (equal(pieces[0], "%rip", 4)) {
        if (piece_count != 1 || displacement.length == 0) {
            return false;
        }
        result->rip_relative = true;
        result->symbol = displacement;
        return true;
    }
    if (!parse_register(pieces[0], &result->base) ||
        result->base.class != RegisterClass.general || result->base.width != 64) {
        return false;
    }
    if (displacement.length != 0 &&
        !parse_i32(
            displacement, &result->displacement)) {
        return false;
    }
    if (piece_count >= 2 && pieces[1].length != 0) {
        if (!parse_register(pieces[1], &result->index) ||
            result->index.class != RegisterClass.general || result->index.width != 64 ||
            result->index.code == 4) {
            return false;
        }
        result->has_index = true;
    }
    if (piece_count == 3) {
        var scale: u64 = 0;
        if (!result->has_index || !parse_bits(pieces[2], &scale) || (scale != 1 && scale != 2 &&
             scale != 4 && scale != 8)) {
            return false;
        }
        result->scale = scale as u8;
    }
    return true;
}

fn parse_operand(input: text::View, result: *Operand) -> bool {
    let trimmed: text::View = trim(input);
    if (result == null || trimmed.length == 0) {
        return false;
    }
    var view: text::View = trimmed;
    if (view.data[0] == 42) {
        view = trim(slice(view, 1, view.length - 1));
        if (view.length == 0) {
            return false;
        }
    }
    *result = empty_operand();
    if (view.data[0] == 36) {
        result->kind = OperandKind.immediate;
        return parse_bits(slice(view, 1, view.length - 1), &result->immediate);
    }
    if (view.data[0] == 37) {
        result->kind = OperandKind.register;
        return parse_register(view, &result->register);
    }
    if (find(view, 40) != view.length) {
        result->kind = OperandKind.memory;
        return parse_memory(view, &result->memory);
    }
    result->kind = OperandKind.label;
    result->label = view;
    return true;
}

fn parse_operands(input: text::View, result: *Operands) -> bool {
    if (result == null) {
        return false;
    }
    *result = empty_operands();
    let text: text::View = trim(input);
    if (text.length == 0) {
        return true;
    }
    var depth: usize = 0;
    var start: usize = 0;
    var index: usize = 0;
    while (index <= text.length) {
        if (index < text.length && text.data[index] == 40) {
            depth += 1;
        } else if (index < text.length && text.data[index] == 41) {
            if (depth == 0) {
                return false;
            }
            depth -= 1;
        }
        if (index == text.length || (text.data[index] == 44 && depth == 0)) {
            if (result->count >= 3 ||
                !parse_operand(
                    slice(text, start, index - start), &result->values[result->count])) {
                return false;
            }
            result->count += 1;
            start = index + 1;
        }
        index += 1;
    }
    return depth == 0;
}

fn is_gpr(operand: *const Operand, width: usize) -> bool {
    return operand != null && operand->kind == OperandKind.register && operand->register.class ==
            RegisterClass.general && operand->register.width == width;
}

fn is_xmm(operand: *const Operand) -> bool {
    return operand != null && operand->kind == OperandKind.register && operand->register.class ==
            RegisterClass.vector;
}

fn is_rm(operand: *const Operand, width: usize) -> bool {
    return operand != null && (operand->kind == OperandKind.memory ||
         is_gpr(operand, width));
}

fn section_buffer(assembler: *Assembler) -> *bytes::Buffer {
    if (assembler == null) {
        return null;
    }
    if (assembler->section == object::Section.text) {
        return &assembler->object.text;
    }
    if (assembler->section == object::Section.rodata) {
        return &assembler->object.rodata;
    }
    if (assembler->section == object::Section.data) {
        return &assembler->object.data;
    }
    return null;
}

fn append_u8(assembler: *Assembler, value: u8) -> bool {
    if (assembler == null ||
        !object::append_u8(
            &assembler->object, assembler->section, value)) {
        return fail(
            assembler, assembler == null ? runtime::Error.invalid_argument : assembler->object.error);
    }
    return true;
}

fn append_u16(assembler: *Assembler, value: u16) -> bool {
    return append_u8(assembler, (value & 255) as u8) &&
        append_u8(assembler, ((value >> 8) & 255) as u8);
}

fn append_u32(assembler: *Assembler, value: u32) -> bool {
    var index: usize = 0;
    while (index < 4) {
        if (!append_u8(
                assembler, ((value >> ((index * 8) as u32)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn append_u64(assembler: *Assembler, value: u64) -> bool {
    var index: usize = 0;
    while (index < 8) {
        if (!append_u8(
                assembler, ((value >> ((index * 8) as u64)) & 255) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn append_opcode(assembler: *Assembler, first: u8, second: u8, count: usize) -> bool {
    return count >= 1 && append_u8(assembler, first) && (count == 1 ||
         append_u8(assembler, second));
}

fn numeric_reference(target: text::View, number: *usize, forward: *bool) -> bool {
    if (target.length < 2 || number == null || forward == null) {
        return false;
    }
    let suffix: u8 = target.data[target.length - 1];
    if (suffix != 102 && suffix != 98) {
        return false;
    }
    var value: usize = 0;
    var index: usize = 0;
    while (index + 1 < target.length) {
        let digit: u8 = target.data[index];
        if (digit < 48 || digit > 57 || value > (18446744073709551615 as usize - (digit - 48) as usize) / 10) {
            return false;
        }
        value = value * 10 + (digit - 48) as usize;
        index += 1;
    }
    *number = value;
    *forward = suffix == 102;
    return true;
}

fn add_fixup(
    assembler: *Assembler, target: text::View, offset: usize, kind: FixupKind) -> bool {
    if (assembler == null || assembler->fixups.length / sizeof(Fixup) >=
                Limit.maximum_fixups as usize) {
        return fail(assembler, runtime::Error.out_of_memory);
    }
    var fixup: Fixup = {
        target = target, section = assembler->section, offset = offset, line = assembler->line, kind = kind,
        numeric_label = 0, numeric_forward = false, is_numeric = false,
    };
    fixup.is_numeric = numeric_reference(target, &fixup.numeric_label, &fixup.numeric_forward);
    let appended: bytes::BufferResult = bytes::append(
        assembler->fixups, (&fixup) as *const Fixup as *const u8, sizeof(Fixup));
    assembler->fixups = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return fail(assembler, appended.error);
    }
    return true;
}

fn rex_for_rm(operand: *const Operand) -> u8 {
    if (operand->kind == OperandKind.register) {
        return operand->register.code >= 8 ? 1 : 0;
    }
    if (operand->kind != OperandKind.memory || operand->memory.rip_relative) {
        return 0;
    }
    var rex: u8 = operand->memory.base.code >= 8 ? 1 : 0;
    if (operand->memory.has_index && operand->memory.index.code >= 8) {
        rex |= 2;
    }
    return rex;
}

fn emit_prefix_opcode(
    assembler: *Assembler, legacy_prefix: u8, rex_w: bool, force_rex: bool, reg_field: u8,
    rm: *const Operand, opcode_first: u8, opcode_second: u8, opcode_count: usize) -> bool {
    if (legacy_prefix != 0 &&
        !append_u8(
            assembler, legacy_prefix)) {
        return false;
    }
    var rex: u8 = 64;
    if (rex_w) {
        rex |= 8;
    }
    if (reg_field >= 8) {
        rex |= 4;
    }
    rex |= rex_for_rm(rm);
    if ((rex != 64 || force_rex) && !append_u8(assembler, rex)) {
        return false;
    }
    return append_opcode(assembler, opcode_first, opcode_second, opcode_count);
}

fn emit_modrm(
    assembler: *Assembler, reg_field: u8, rm: *const Operand) -> bool {
    if (rm->kind == OperandKind.register) {
        return append_u8(
            assembler, ((192 as u8) | ((reg_field & 7) << 3) | (rm->register.code & 7)) as u8);
    }
    if (rm->kind != OperandKind.memory) {
        return false;
    }
    if (rm->memory.rip_relative) {
        let modrm: u8 = (((reg_field & 7) << 3) | 5) as u8;
        if (!append_u8(assembler, modrm)) {
            return false;
        }
        let output: *bytes::Buffer = section_buffer(assembler);
        return output != null &&
            add_fixup(
                assembler, rm->memory.symbol, output->length, FixupKind.rip_relative) &&
            append_u32(assembler, 0);
    }
    let base: u8 = rm->memory.base.code & 7;
    var mode: u8 = 0;
    if (rm->memory.displacement == 0 && base != 5) {
        mode = 0;
    } else if (rm->memory.displacement >= -128 && rm->memory.displacement <= 127) {
        mode = 1;
    } else {
        mode = 2;
    }
    let sib_required: bool = base == 4 || rm->memory.has_index;
    let rm_field: u8 = sib_required ? 4 : base;
    if (!append_u8(
            assembler, ((mode << 6) | ((reg_field & 7) << 3) | rm_field) as u8)) {
        return false;
    }
    if (sib_required) {
        var scale_bits: u8 = 0;
        if (rm->memory.scale == 2) {
            scale_bits = 1;
        } else if (rm->memory.scale == 4) {
            scale_bits = 2;
        } else if (rm->memory.scale == 8) {
            scale_bits = 3;
        }
        let index: u8 = rm->memory.has_index ? rm->memory.index.code & 7 : 4;
        if (!append_u8(
                assembler, ((scale_bits << 6) | (index << 3) | base) as u8)) {
            return false;
        }
    }
    if (mode == 1) {
        return append_u8(assembler, rm->memory.displacement as u8);
    }
    if (mode == 2) {
        return append_u32(assembler, rm->memory.displacement as u32);
    }
    return true;
}

fn emit_rm(
    assembler: *Assembler, legacy_prefix: u8, rex_w: bool, force_rex: bool, opcode_first: u8,
    opcode_second: u8, opcode_count: usize, reg_field: u8, rm: *const Operand) -> bool {
    return emit_prefix_opcode(
            assembler, legacy_prefix, rex_w, force_rex, reg_field, rm, opcode_first, opcode_second, opcode_count) &&
        emit_modrm(assembler, reg_field, rm);
}

fn emit_relative(
    assembler: *Assembler, opcode_first: u8, opcode_second: u8, opcode_count: usize,
    operands: *const Operands, kind: FixupKind) -> bool {
    if (operands->count != 1 || operands->values[0].kind != OperandKind.label ||
        !append_opcode(
            assembler, opcode_first, opcode_second, opcode_count)) {
        return false;
    }
    let output: *bytes::Buffer = section_buffer(assembler);
    return output != null &&
        add_fixup(assembler, operands->values[0].label, output->length, kind) &&
        append_u32(assembler, 0);
}

fn emit_indirect_transfer(
    assembler: *Assembler, operand: *const Operand, reg_field: u8) -> bool {
    let code: u8 = operand->register.code;
    return (code < 8 || append_u8(assembler, 65)) &&
        append_u8(assembler, 255) &&
        append_u8(assembler, ((192 as u8) | ((reg_field & 7) << 3) | (code & 7)) as u8);
}

fn fits_i32(bits: u64) -> bool {
    let value: isize = bits as isize;
    return value >= -2147483648 && value <= 2147483647;
}

fn fits_u32(bits: u64) -> bool {
    return bits <= 4294967295 as u64 || fits_i32(bits);
}

fn fits_u16(bits: u64) -> bool {
    let value: isize = bits as isize;
    return bits <= 65535 as u64 || (value >= -32768 && value <= 32767);
}

fn fits_u8(bits: u64) -> bool {
    let value: isize = bits as isize;
    return bits <= 255 as u64 || (value >= -128 && value <= 127);
}

fn emit_binary_alu(
    assembler: *Assembler, operands: *const Operands, width: usize, register_opcode: u8,
    immediate_group: u8) -> bool {
    if (operands->count != 2 || !is_rm(&operands->values[1], width)) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == OperandKind.immediate) {
        if ((width == 64 && !fits_i32(source->immediate)) || (width == 32 &&
                !fits_u32(source->immediate)) || (width == 16 &&
                !fits_u16(source->immediate)) || (width == 8 &&
                !fits_u8(source->immediate))) {
            return false;
        }
        if (!emit_rm(
                assembler, legacy, rex_w, byte && destination->kind == OperandKind.register &&
                    destination->register.code >= 4, byte ? 128 : 129, 0, 1, immediate_group, destination)) {
            return false;
        }
        if (byte) {
            return append_u8(assembler, source->immediate as u8);
        }
        if (word) {
            return append_u16(assembler, source->immediate as u16);
        }
        return append_u32(assembler, source->immediate as u32);
    }
    if (!is_gpr(source, width)) {
        return false;
    }
    return emit_rm(
        assembler, legacy, rex_w, byte && (source->register.code >= 4 || (destination->kind ==
                OperandKind.register && destination->register.code >= 4)), register_opcode, 0, 1,
        source->register.code, destination);
}

fn emit_move(
    assembler: *Assembler, operands: *const Operands, width: usize) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let byte: bool = width == 8;
    let word: bool = width == 16;
    let rex_w: bool = width == 64;
    let legacy: u8 = word ? 102 : 0;
    if (source->kind == OperandKind.immediate) {
        if (!is_rm(destination, width) || (width == 64 &&
                !fits_i32(source->immediate)) || (width == 32 &&
                !fits_u32(source->immediate)) || (width == 16 &&
                !fits_u16(source->immediate)) || (width == 8 &&
                !fits_u8(source->immediate))) {
            return false;
        }
        if (!emit_rm(
                assembler, legacy, rex_w, byte && destination->kind == OperandKind.register &&
                    destination->register.code >= 4, byte ? 198 : 199, 0, 1, 0, destination)) {
            return false;
        }
        if (byte) {
            return append_u8(assembler, source->immediate as u8);
        }
        if (word) {
            return append_u16(assembler, source->immediate as u16);
        }
        return append_u32(assembler, source->immediate as u32);
    }
    if (is_gpr(source, width) && is_rm(destination, width)) {
        return emit_rm(
            assembler, legacy, rex_w, byte && (source->register.code >= 4 || (destination->kind ==
                    OperandKind.register && destination->register.code >= 4)), byte ? 136 : 137, 0, 1,
            source->register.code, destination);
    }
    if (source->kind == OperandKind.memory && is_gpr(destination, width)) {
        return emit_rm(
            assembler, legacy, rex_w, byte && destination->register.code >= 4, byte ? 138 : 139, 0, 1,
            destination->register.code, source);
    }
    return false;
}

fn emit_xmm_move(
    assembler: *Assembler, operands: *const Operands, double_precision: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let prefix: u8 = double_precision ? 242 : 243;
    if (is_xmm(destination) && (is_xmm(source) ||
         source->kind == OperandKind.memory)) {
        return emit_rm(
            assembler, prefix, false, false, 15, 16, 2, destination->register.code, source);
    }
    if (is_xmm(source) && destination->kind == OperandKind.memory) {
        return emit_rm(
            assembler, prefix, false, false, 15, 17, 2, source->register.code, destination);
    }
    return false;
}

fn emit_movd_or_movq(
    assembler: *Assembler, operands: *const Operands, quad: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    let source: *const Operand = &operands->values[0];
    let destination: *const Operand = &operands->values[1];
    let width: usize = quad ? 64 : 32;
    if (is_gpr(source, width) && is_xmm(destination)) {
        return emit_rm(assembler, 102, quad, false, 15, 110, 2, destination->register.code, source);
    }
    if (is_xmm(source) && is_gpr(destination, width)) {
        return emit_rm(assembler, 102, quad, false, 15, 126, 2, source->register.code, destination);
    }
    if (quad && is_xmm(source) && destination->kind == OperandKind.memory) {
        return emit_rm(
            assembler, 102, false, false, 15, 214, 2, source->register.code, destination);
    }
    if (quad && is_xmm(destination) && (source->kind == OperandKind.memory ||
         is_xmm(source))) {
        return emit_rm(
            assembler, 243, false, false, 15, 126, 2, destination->register.code, source);
    }
    return false;
}

fn emit_extend(
    assembler: *Assembler, operands: *const Operands, source_width: usize,
    destination_width: usize, sign_extend: bool) -> bool {
    if (operands->count != 2 || !(operands->values[0].kind == OperandKind.memory ||
          is_gpr(
            &operands->values[0], source_width)) ||
        !is_gpr(
            &operands->values[1], destination_width)) {
        return false;
    }
    let second: u8 = source_width == 8 ? (sign_extend ? 190 : 182) : source_width == 16 ? (sign_extend ? 191 : 183) : 0;
    if (second == 0) {
        return false;
    }
    return emit_rm(
        assembler, 0, destination_width == 64, operands->values[0].kind == OperandKind.register &&
            source_width == 8 && operands->values[0].register.code >= 4, 15, second, 2,
        operands->values[1].register.code, &operands->values[0]);
}

fn emit_unary(
    assembler: *Assembler, operands: *const Operands, width: usize, group: u8) -> bool {
    return operands->count == 1 && (operands->values[0].kind == OperandKind.memory ||
         is_gpr(&operands->values[0], width)) &&
        emit_rm(
            assembler, width == 16 ? 102 : 0, width == 64, false, 247, 0, 1, group, &operands->values[0]);
}

fn emit_shift(
    assembler: *Assembler, operands: *const Operands, width: usize, group: u8) -> bool {
    if (operands->count != 2 || !is_gpr(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == OperandKind.immediate && operands->values[0].immediate <= 255) {
        return emit_rm(assembler, 0, width == 64, false, 193, 0, 1, group, &operands->values[1]) &&
            append_u8(assembler, operands->values[0].immediate as u8);
    }
    return is_gpr(&operands->values[0], 8) && operands->values[0].register.code == 1 &&
        emit_rm(assembler, 0, width == 64, false, 211, 0, 1, group, &operands->values[1]);
}

fn condition(name: text::View, result: *u8) -> bool {
    if (result == null) {
        return false;
    }
    if (equal(name, "o", 1)) {
        *result = 0;
    } else if (equal(name, "no", 2)) {
        *result = 1;
    } else if (equal(name, "b", 1) || equal(name, "c", 1) ||
        equal(name, "nae", 3)) {
        *result = 2;
    } else if (equal(name, "ae", 2) || equal(name, "nb", 2) ||
        equal(name, "nc", 2)) {
        *result = 3;
    } else if (equal(name, "e", 1) || equal(name, "z", 1)) {
        *result = 4;
    } else if (equal(name, "ne", 2) || equal(name, "nz", 2)) {
        *result = 5;
    } else if (equal(name, "be", 2) || equal(name, "na", 2)) {
        *result = 6;
    } else if (equal(name, "a", 1) || equal(name, "nbe", 3)) {
        *result = 7;
    } else if (equal(name, "s", 1)) {
        *result = 8;
    } else if (equal(name, "ns", 2)) {
        *result = 9;
    } else if (equal(name, "p", 1) || equal(name, "pe", 2)) {
        *result = 10;
    } else if (equal(name, "np", 2) || equal(name, "po", 2)) {
        *result = 11;
    } else if (equal(name, "l", 1) || equal(name, "nge", 3)) {
        *result = 12;
    } else if (equal(name, "ge", 2) || equal(name, "nl", 2)) {
        *result = 13;
    } else if (equal(name, "le", 2) || equal(name, "ng", 2)) {
        *result = 14;
    } else if (equal(name, "g", 1) || equal(name, "nle", 3)) {
        *result = 15;
    } else {
        return false;
    }
    return true;
}

fn emit_set(
    assembler: *Assembler, operands: *const Operands, condition: u8) -> bool {
    return operands->count == 1 && is_gpr(&operands->values[0], 8) &&
        emit_rm(
            assembler, 0, false, operands->values[0].register.code >= 4, 15, ((144 as u8) | condition) as u8, 2, 0,
            &operands->values[0]);
}

fn emit_sse_binary(
    assembler: *Assembler, operands: *const Operands, prefix: u8, operation: u8) -> bool {
    return operands->count == 2 && (is_xmm(&operands->values[0]) || operands->values[0].kind ==
            OperandKind.memory) && is_xmm(&operands->values[1]) &&
        emit_rm(
            assembler, prefix, false, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

fn emit_conversion(
    assembler: *Assembler, operands: *const Operands, prefix: u8, operation: u8, rex_w: bool,
    source_xmm: bool) -> bool {
    if (operands->count != 2) {
        return false;
    }
    if (source_xmm) {
        if (!(is_xmm(&operands->values[0]) || operands->values[0].kind ==
                OperandKind.memory) ||
            !is_gpr(
                &operands->values[1], rex_w ? 64 : 32)) {
            return false;
        }
    } else if (!(is_gpr(&operands->values[0], rex_w ? 64 : 32) ||
                 operands->values[0].kind == OperandKind.memory) ||
               !is_xmm(&operands->values[1])) {
        return false;
    }
    return emit_rm(
        assembler, prefix, rex_w, false, 15, operation, 2, operands->values[1].register.code, &operands->values[0]);
}

fn emit_compare(
    assembler: *Assembler, operands: *const Operands, width: usize, compare: bool) -> bool {
    if (operands->count != 2 || !is_rm(&operands->values[1], width)) {
        return false;
    }
    if (operands->values[0].kind == OperandKind.immediate) {
        if (!compare || (width == 64 && !fits_i32(operands->values[0].immediate)) || (width == 32 &&
                !fits_u32(operands->values[0].immediate)) || (width == 8 &&
                !fits_u8(
                    operands->values[0].immediate))) {
            return false;
        }
        let byte: bool = width == 8;
        if (!emit_rm(
                assembler, 0, width == 64, byte && operands->values[1].kind == OperandKind.register &&
                    operands->values[1].register.code >= 4, byte ? 128 : 129, 0, 1, 7, &operands->values[1])) {
            return false;
        }
        return byte ? append_u8(assembler, operands->values[0].immediate as u8) :
            append_u32(assembler, operands->values[0].immediate as u32);
    }
    if (!is_gpr(&operands->values[0], width)) {
        return false;
    }
    let opcode: u8 = compare ? (width == 8 ? 56 : 57) : (width == 8 ? 132 : 133);
    return emit_rm(
        assembler, 0, width == 64, width == 8 && (operands->values[0].register.code >= 4 || (operands->values[1].kind ==
                OperandKind.register && operands->values[1].register.code >= 4)), opcode, 0, 1,
        operands->values[0].register.code, &operands->values[1]);
}

fn emit_imul(
    assembler: *Assembler, operands: *const Operands, width: usize) -> bool {
    if (operands->count == 2 && (is_gpr(&operands->values[0], width) || operands->values[0].kind ==
            OperandKind.memory) && is_gpr(&operands->values[1], width)) {
        return emit_rm(
            assembler, 0, width == 64, false, 15, 175, 2, operands->values[1].register.code, &operands->values[0]);
    }
    if (operands->count == 3 && operands->values[0].kind == OperandKind.immediate &&
        fits_i32(operands->values[0].immediate) &&
        (is_gpr(&operands->values[1], width) || operands->values[1].kind ==
            OperandKind.memory) && is_gpr(&operands->values[2], width)) {
        return emit_rm(
                assembler, 0, width == 64, false, 105, 0, 1, operands->values[2].register.code, &operands->values[1]) &&
            append_u32(assembler, operands->values[0].immediate as u32);
    }
    return false;
}

fn encode(
    assembler: *Assembler, mnemonic: text::View, raw_operands: text::View,
    operands: *const Operands) -> bool {
    if (equal(mnemonic, "cld", 3)) {
        return operands->count == 0 && append_u8(assembler, 252);
    }
    if (equal(mnemonic, "std", 3)) {
        return operands->count == 0 && append_u8(assembler, 253);
    }
    if (equal(mnemonic, "cltd", 4)) {
        return operands->count == 0 && append_u8(assembler, 153);
    }
    if (equal(mnemonic, "cqto", 4)) {
        return operands->count == 0 && append_u8(assembler, 72) &&
            append_u8(assembler, 153);
    }
    if (equal(mnemonic, "leave", 5)) {
        return operands->count == 0 && append_u8(assembler, 201);
    }
    if (equal(mnemonic, "ret", 3)) {
        return operands->count == 0 && append_u8(assembler, 195);
    }
    if (equal(mnemonic, "syscall", 7)) {
        return operands->count == 0 && append_opcode(assembler, 15, 5, 2);
    }
    if (equal(mnemonic, "ud2", 3)) {
        return operands->count == 0 && append_opcode(assembler, 15, 11, 2);
    }
    if (equal(mnemonic, "rep", 3)) {
        if (operands->count != 1 || operands->values[0].kind != OperandKind.label ||
            !append_u8(assembler, 243)) {
            return false;
        }
        if (equal(raw_operands, "movsb", 5)) {
            return append_u8(assembler, 164);
        }
        if (equal(raw_operands, "stosb", 5)) {
            return append_u8(assembler, 170);
        }
        return false;
    }
    if (equal(mnemonic, "pushq", 5)) {
        if (operands->count != 1 || !is_gpr(&operands->values[0], 64)) {
            return false;
        }
        let code: u8 = operands->values[0].register.code;
        return (code < 8 || append_u8(assembler, 65)) &&
            append_u8(assembler, ((80 as u8) | (code & 7)) as u8);
    }
    if (equal(mnemonic, "call", 4) || equal(mnemonic, "jmp", 3)) {
        let is_call: bool = equal(mnemonic, "call", 4);
        if (operands->count == 1 &&
            is_gpr(
                &operands->values[0], 64)) {
            return emit_indirect_transfer(assembler, &operands->values[0], is_call ? 2 : 4);
        }
        return emit_relative(
            assembler, is_call ? 232 : 233, 0, 1, operands, is_call ? FixupKind.call :
                      FixupKind.branch);
    }
    if (mnemonic.length > 1 && mnemonic.data[0] == 106) {
        var condition_code: u8 = 0;
        if (condition(
                slice(mnemonic, 1, mnemonic.length - 1), &condition_code)) {
            return emit_relative(
                assembler, 15, ((128 as u8) | condition_code) as u8, 2, operands, FixupKind.branch);
        }
    }
    if (mnemonic.length > 3 && starts_with(mnemonic, "set", 3)) {
        var condition_code: u8 = 0;
        if (condition(
                slice(mnemonic, 3, mnemonic.length - 3), &condition_code)) {
            return emit_set(assembler, operands, condition_code);
        }
    }
    if (equal(mnemonic, "movabsq", 7)) {
        if (operands->count != 2 || operands->values[0].kind != OperandKind.immediate ||
            !is_gpr(&operands->values[1], 64)) {
            return false;
        }
        let code: u8 = operands->values[1].register.code;
        return append_u8(assembler, code >= 8 ? 73 : 72) &&
            append_u8(assembler, ((184 as u8) | (code & 7)) as u8) &&
            append_u64(assembler, operands->values[0].immediate);
    }
    if (equal(mnemonic, "movb", 4)) {
        return emit_move(assembler, operands, 8);
    }
    if (equal(mnemonic, "movw", 4)) {
        return emit_move(assembler, operands, 16);
    }
    if (equal(mnemonic, "movl", 4)) {
        return emit_move(assembler, operands, 32);
    }
    if (equal(mnemonic, "movd", 4)) {
        return emit_movd_or_movq(assembler, operands, false);
    }
    if (equal(mnemonic, "movq", 4)) {
        if ((operands->count == 2 && (is_xmm(&operands->values[0]) ||
              is_xmm(&operands->values[1]))) &&
            emit_movd_or_movq(
                assembler, operands, true)) {
            return true;
        }
        return emit_move(assembler, operands, 64);
    }
    if (equal(mnemonic, "movss", 5)) {
        return emit_xmm_move(assembler, operands, false);
    }
    if (equal(mnemonic, "movsd", 5)) {
        return emit_xmm_move(assembler, operands, true);
    }
    if (equal(mnemonic, "movzbl", 6)) {
        return emit_extend(assembler, operands, 8, 32, false);
    }
    if (equal(mnemonic, "movsbl", 6)) {
        return emit_extend(assembler, operands, 8, 32, true);
    }
    if (equal(mnemonic, "movsbq", 6)) {
        return emit_extend(assembler, operands, 8, 64, true);
    }
    if (equal(mnemonic, "movswl", 6)) {
        return emit_extend(assembler, operands, 16, 32, true);
    }
    if (equal(mnemonic, "movswq", 6)) {
        return emit_extend(assembler, operands, 16, 64, true);
    }
    if (equal(mnemonic, "movzwl", 6)) {
        return emit_extend(assembler, operands, 16, 32, false);
    }
    if (equal(mnemonic, "movslq", 6)) {
        return operands->count == 2 && (is_gpr(&operands->values[0], 32) ||
             operands->values[0].kind == OperandKind.memory) &&
            is_gpr(&operands->values[1], 64) &&
            emit_rm(
                assembler, 0, true, false, 99, 0, 1, operands->values[1].register.code, &operands->values[0]);
    }
    if (equal(mnemonic, "leaq", 4)) {
        return operands->count == 2 && operands->values[0].kind == OperandKind.memory &&
            is_gpr(&operands->values[1], 64) &&
            emit_rm(
                assembler, 0, true, false, 141, 0, 1, operands->values[1].register.code, &operands->values[0]);
    }
    if (equal(mnemonic, "addl", 4)) {
        return emit_binary_alu(assembler, operands, 32, 1, 0);
    }
    if (equal(mnemonic, "addq", 4)) {
        return emit_binary_alu(assembler, operands, 64, 1, 0);
    }
    if (equal(mnemonic, "subl", 4)) {
        return emit_binary_alu(assembler, operands, 32, 41, 5);
    }
    if (equal(mnemonic, "subq", 4)) {
        return emit_binary_alu(assembler, operands, 64, 41, 5);
    }
    if (equal(mnemonic, "andl", 4)) {
        return emit_binary_alu(assembler, operands, 32, 33, 4);
    }
    if (equal(mnemonic, "andb", 4)) {
        return emit_binary_alu(assembler, operands, 8, 32, 4);
    }
    if (equal(mnemonic, "andq", 4)) {
        return emit_binary_alu(assembler, operands, 64, 33, 4);
    }
    if (equal(mnemonic, "orq", 3)) {
        return emit_binary_alu(assembler, operands, 64, 9, 1);
    }
    if (equal(mnemonic, "orb", 3)) {
        return emit_binary_alu(assembler, operands, 8, 8, 1);
    }
    if (equal(mnemonic, "orl", 3)) {
        return emit_binary_alu(assembler, operands, 32, 9, 1);
    }
    if (equal(mnemonic, "xorl", 4)) {
        return emit_binary_alu(assembler, operands, 32, 49, 6);
    }
    if (equal(mnemonic, "xorq", 4)) {
        return emit_binary_alu(assembler, operands, 64, 49, 6);
    }
    if (equal(mnemonic, "cmpl", 4)) {
        return emit_compare(assembler, operands, 32, true);
    }
    if (equal(mnemonic, "cmpb", 4)) {
        return emit_compare(assembler, operands, 8, true);
    }
    if (equal(mnemonic, "cmpq", 4)) {
        return emit_compare(assembler, operands, 64, true);
    }
    if (equal(mnemonic, "testl", 5)) {
        return emit_compare(assembler, operands, 32, false);
    }
    if (equal(mnemonic, "testb", 5)) {
        return emit_compare(assembler, operands, 8, false);
    }
    if (equal(mnemonic, "testq", 5)) {
        return emit_compare(assembler, operands, 64, false);
    }
    if (equal(mnemonic, "negq", 4)) {
        return emit_unary(assembler, operands, 64, 3);
    }
    if (equal(mnemonic, "negl", 4)) {
        return emit_unary(assembler, operands, 32, 3);
    }
    if (equal(mnemonic, "notq", 4)) {
        return emit_unary(assembler, operands, 64, 2);
    }
    if (equal(mnemonic, "notl", 4)) {
        return emit_unary(assembler, operands, 32, 2);
    }
    if (equal(mnemonic, "divq", 4)) {
        return emit_unary(assembler, operands, 64, 6);
    }
    if (equal(mnemonic, "divl", 4)) {
        return emit_unary(assembler, operands, 32, 6);
    }
    if (equal(mnemonic, "idivl", 5)) {
        return emit_unary(assembler, operands, 32, 7);
    }
    if (equal(mnemonic, "idivq", 5)) {
        return emit_unary(assembler, operands, 64, 7);
    }
    if (equal(mnemonic, "imull", 5)) {
        return emit_imul(assembler, operands, 32);
    }
    if (equal(mnemonic, "imulq", 5)) {
        return emit_imul(assembler, operands, 64);
    }
    if (equal(mnemonic, "shlq", 4)) {
        return emit_shift(assembler, operands, 64, 4);
    }
    if (equal(mnemonic, "shll", 4)) {
        return emit_shift(assembler, operands, 32, 4);
    }
    if (equal(mnemonic, "shrq", 4)) {
        return emit_shift(assembler, operands, 64, 5);
    }
    if (equal(mnemonic, "shrl", 4)) {
        return emit_shift(assembler, operands, 32, 5);
    }
    if (equal(mnemonic, "sarl", 4)) {
        return emit_shift(assembler, operands, 32, 7);
    }
    if (equal(mnemonic, "sarq", 4)) {
        return emit_shift(assembler, operands, 64, 7);
    }
    if (equal(mnemonic, "ldmxcsr", 7)) {
        return operands->count == 1 && operands->values[0].kind == OperandKind.memory &&
            emit_rm(assembler, 0, false, false, 15, 174, 2, 2, &operands->values[0]);
    }
    if (equal(mnemonic, "addsd", 5)) {
        return emit_sse_binary(assembler, operands, 242, 88);
    }
    if (equal(mnemonic, "mulsd", 5)) {
        return emit_sse_binary(assembler, operands, 242, 89);
    }
    if (equal(mnemonic, "addss", 5)) {
        return emit_sse_binary(assembler, operands, 243, 88);
    }
    if (equal(mnemonic, "mulss", 5)) {
        return emit_sse_binary(assembler, operands, 243, 89);
    }
    if (equal(mnemonic, "subss", 5)) {
        return emit_sse_binary(assembler, operands, 243, 92);
    }
    if (equal(mnemonic, "subsd", 5)) {
        return emit_sse_binary(assembler, operands, 242, 92);
    }
    if (equal(mnemonic, "divss", 5)) {
        return emit_sse_binary(assembler, operands, 243, 94);
    }
    if (equal(mnemonic, "divsd", 5)) {
        return emit_sse_binary(assembler, operands, 242, 94);
    }
    if (equal(mnemonic, "sqrtsd", 6)) {
        return emit_sse_binary(assembler, operands, 242, 81);
    }
    if (equal(mnemonic, "sqrtss", 6)) {
        return emit_sse_binary(assembler, operands, 243, 81);
    }
    if (equal(mnemonic, "minsd", 5)) {
        return emit_sse_binary(assembler, operands, 242, 93);
    }
    if (equal(mnemonic, "minss", 5)) {
        return emit_sse_binary(assembler, operands, 243, 93);
    }
    if (equal(mnemonic, "maxsd", 5)) {
        return emit_sse_binary(assembler, operands, 242, 95);
    }
    if (equal(mnemonic, "maxss", 5)) {
        return emit_sse_binary(assembler, operands, 243, 95);
    }
    if (equal(mnemonic, "ucomiss", 7)) {
        return emit_sse_binary(assembler, operands, 0, 46);
    }
    if (equal(mnemonic, "ucomisd", 7)) {
        return emit_sse_binary(assembler, operands, 102, 46);
    }
    if (equal(mnemonic, "cvtss2sd", 8)) {
        return emit_sse_binary(assembler, operands, 243, 90);
    }
    if (equal(mnemonic, "cvtsd2ss", 8)) {
        return emit_sse_binary(assembler, operands, 242, 90);
    }
    if (equal(mnemonic, "cvtsi2sdq", 9)) {
        return emit_conversion(assembler, operands, 242, 42, true, false);
    }
    if (equal(mnemonic, "cvtsi2ssq", 9)) {
        return emit_conversion(assembler, operands, 243, 42, true, false);
    }
    if (equal(mnemonic, "cvttss2si", 9)) {
        return emit_conversion(assembler, operands, 243, 44, false, true);
    }
    if (equal(mnemonic, "cvttss2siq", 10)) {
        return emit_conversion(assembler, operands, 243, 44, true, true);
    }
    if (equal(mnemonic, "cvttsd2si", 9)) {
        return emit_conversion(assembler, operands, 242, 44, false, true);
    }
    if (equal(mnemonic, "cvttsd2siq", 10)) {
        return emit_conversion(assembler, operands, 242, 44, true, true);
    }
    return false;
}

fn symbol_name_is_valid(name: text::View) -> bool {
    if (name.length == 0 || name.data == null) {
        return false;
    }
    var index: usize = 0;
    while (index < name.length) {
        let value: u8 = name.data[index];
        let valid: bool = (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 95 || value == 46 || value == 36;
        if (!valid || (index == 0 && value >= 48 && value <= 57)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn get_symbol(assembler: *Assembler, name: text::View) -> object::IndexResult {
    let result: object::IndexResult = object::add_symbol(&assembler->object, name);
    if (result.error != runtime::Error.none) {
        fail(assembler, result.error);
    }
    return result;
}

fn define_label(assembler: *Assembler, name: text::View) -> bool {
    let section: *bytes::Buffer = section_buffer(assembler);
    if (section == null || name.length == 0) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    var numeric: bool = true;
    var index: usize = 0;
    var number: usize = 0;
    while (index < name.length) {
        if (name.data[index] < 48 || name.data[index] > 57) {
            numeric = false;
        } else if (numeric) {
            let digit: usize = (name.data[index] - 48) as usize;
            if (number > (18446744073709551615 as usize - digit) / 10) {
                return fail(assembler, runtime::Error.invalid_argument);
            }
            number = number * 10 + digit;
        }
        index += 1;
    }
    if (numeric) {
        let label: NumericLabel = {
            section = assembler->section, offset = section->length, number = number,
        };
        let appended: bytes::BufferResult = bytes::append(
            assembler->numeric_labels, (&label) as *const NumericLabel as *const u8,
            sizeof(NumericLabel));
        assembler->numeric_labels = appended.buffer;
        if (appended.error != runtime::Error.none) {
            return fail(assembler, appended.error);
        }
        return true;
    }
    if (!symbol_name_is_valid(name)) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let found: object::IndexResult = get_symbol(assembler, name);
    if (found.error != runtime::Error.none) {
        return false;
    }
    let symbol: *object::Symbol = object::symbol_mut(&assembler->object, found.index);
    if (symbol == null || symbol->defined || symbol->external) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    symbol->defined = true;
    symbol->section = assembler->section;
    symbol->value = section->length;
    return true;
}

fn mark_symbol(assembler: *Assembler, input: text::View, external: bool) -> bool {
    let name: text::View = trim(input);
    if (!symbol_name_is_valid(name)) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let found: object::IndexResult = get_symbol(assembler, name);
    if (found.error != runtime::Error.none) {
        return false;
    }
    let symbol: *object::Symbol = object::symbol_mut(&assembler->object, found.index);
    if (symbol == null || (external && symbol->defined)) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    symbol->global = true;
    symbol->external = external;
    return true;
}

fn symbol_type(assembler: *Assembler, input: text::View) -> bool {
    let comma: usize = find(input, 44);
    if (comma == input.length) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let name: text::View = trim(slice(input, 0, comma));
    let kind: text::View = trim(
        slice(input, comma + 1, input.length - comma - 1));
    if (!symbol_name_is_valid(name)) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let found: object::IndexResult = get_symbol(assembler, name);
    let symbol: *object::Symbol = object::symbol_mut(&assembler->object, found.index);
    if (found.error != runtime::Error.none || symbol == null) {
        return false;
    }
    if (equal(kind, "@function", 9)) {
        symbol->kind = object::SymbolKind.function;
        return true;
    }
    if (equal(kind, "@object", 7)) {
        symbol->kind = object::SymbolKind.object;
        return true;
    }
    return fail(assembler, runtime::Error.invalid_argument);
}

fn symbol_size(assembler: *Assembler, input: text::View) -> bool {
    let comma: usize = find(input, 44);
    if (comma == input.length) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let name: text::View = trim(slice(input, 0, comma));
    let expression: text::View = trim(
        slice(input, comma + 1, input.length - comma - 1));
    let found: object::IndexResult = object::find_symbol(assembler->object, name);
    let symbol: *object::Symbol = object::symbol_mut(&assembler->object, found.index);
    let section: *bytes::Buffer = section_buffer(assembler);
    if (!found.found || found.error != runtime::Error.none || symbol == null || !symbol->defined ||
        symbol->section != assembler->section || section == null || expression.length != name.length + 2 ||
        expression.data[0] != 46 || expression.data[1] != 45) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    var index: usize = 0;
    while (index < name.length) {
        if (expression.data[index + 2] != name.data[index]) {
            return fail(assembler, runtime::Error.invalid_argument);
        }
        index += 1;
    }
    if (symbol->value > section->length) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    symbol->size = section->length - symbol->value;
    return true;
}

fn alignment(assembler: *Assembler, input: text::View, exponent: bool) -> bool {
    var parsed: usize = 0;
    if (!parse_usize(input, &parsed) || (exponent && parsed > 12)) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let alignment: usize = exponent ? 1 << parsed : parsed;
    if (alignment == 0 || (alignment & (alignment - 1)) != 0 ||
        !object::set_alignment(
            &assembler->object, assembler->section, alignment)) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let output: *bytes::Buffer = section_buffer(assembler);
    if (output == null) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let remainder: usize = output->length & (alignment - 1);
    var padding: usize = remainder == 0 ? 0 : alignment - remainder;
    let fill: u8 = assembler->section == object::Section.text ? 144 : 0;
    while (padding != 0) {
        if (!append_u8(assembler, fill)) {
            return false;
        }
        padding -= 1;
    }
    return true;
}

fn directive(assembler: *Assembler, line: text::View) -> bool {
    var split: usize = 0;
    while (split < line.length && !is_space(line.data[split])) {
        split += 1;
    }
    let directive: text::View = slice(line, 0, split);
    let arguments: text::View = trim(slice(line, split, line.length - split));
    if (equal(directive, ".text", 5)) {
        assembler->section = object::Section.text;
        return true;
    }
    if (equal(directive, ".data", 5)) {
        assembler->section = object::Section.data;
        return true;
    }
    if (equal(directive, ".section", 8)) {
        let comma: usize = find(arguments, 44);
        let name: text::View = trim(
            slice(arguments, 0, comma == arguments.length ? arguments.length : comma));
        if (equal(name, ".text", 5)) {
            assembler->section = object::Section.text;
            return true;
        }
        if (equal(name, ".rodata", 7)) {
            assembler->section = object::Section.rodata;
            return true;
        }
        if (equal(name, ".data", 5)) {
            assembler->section = object::Section.data;
            return true;
        }
        if (equal(
                name, ".note.GNU-stack", 15)) {
            assembler->section = object::Section.undefined;
            return true;
        }
        return fail(assembler, runtime::Error.not_supported);
    }
    if (equal(directive, ".globl", 6)) {
        return mark_symbol(assembler, arguments, false);
    }
    if (equal(directive, ".extern", 7)) {
        return mark_symbol(assembler, arguments, true);
    }
    if (equal(directive, ".type", 5)) {
        return symbol_type(assembler, arguments);
    }
    if (equal(directive, ".size", 5)) {
        return symbol_size(assembler, arguments);
    }
    if (equal(directive, ".byte", 5)) {
        var bits: u64 = 0;
        let value: text::View = trim(arguments);
        return parse_bits(value, &bits) && fits_u8(bits) &&
            append_u8(assembler, bits as u8);
    }
    if (equal(directive, ".p2align", 8)) {
        return alignment(assembler, arguments, true);
    }
    if (equal(directive, ".balign", 7)) {
        return alignment(assembler, arguments, false);
    }
    return fail(assembler, runtime::Error.not_supported);
}

fn instruction(assembler: *Assembler, line: text::View) -> bool {
    if (assembler->section != object::Section.text) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    var split: usize = 0;
    while (split < line.length && !is_space(line.data[split])) {
        split += 1;
    }
    let mnemonic: text::View = slice(line, 0, split);
    let raw_operands: text::View = trim(
        slice(line, split, line.length - split));
    var operands: Operands = empty_operands();
    if (!parse_operands(raw_operands, &operands) ||
        !encode(
            assembler, mnemonic, raw_operands, &operands as *const Operands)) {
        return fail(assembler, runtime::Error.not_supported);
    }
    return true;
}

fn line(assembler: *Assembler, input: text::View) -> bool {
    let line: text::View = trim(input);
    if (line.length == 0) {
        return true;
    }
    if (line.data[line.length - 1] == 58) {
        return define_label(assembler, slice(line, 0, line.length - 1));
    }
    if (line.data[0] == 46) {
        return directive(assembler, line);
    }
    return instruction(assembler, line);
}

fn patch(assembler: *Assembler, fixup: Fixup, target: usize) -> bool {
    let output: *bytes::Buffer = fixup.section == object::Section.text ? &assembler->object.text :
        fixup.section == object::Section.rodata ? &assembler->object.rodata :
        fixup.section == object::Section.data ? &assembler->object.data : null;
    if (output == null || fixup.offset > output->length || (4 as usize) > output->length - fixup.offset ||
        target > 9223372036854775807 as usize || fixup.offset > 9223372036854775803 as usize) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let displacement: isize = target as isize - (fixup.offset + 4) as isize;
    if (displacement < -2147483648 || displacement > 2147483647) {
        return fail(assembler, runtime::Error.invalid_argument);
    }
    let bits: u32 = displacement as u32;
    var index: usize = 0;
    while (index < 4) {
        output->data[fixup.offset + index] = ((bits >> ((index * 8) as u32)) & 255) as u8;
        index += 1;
    }
    return true;
}

fn numeric_target(
    assembler: *const Assembler, fixup: Fixup, result: *usize) -> bool {
    let labels: *const NumericLabel = assembler->numeric_labels.data as
            *const NumericLabel;
    let count: usize = assembler->numeric_labels.length / sizeof(NumericLabel);
    var found: bool = false;
    var selected: usize = fixup.numeric_forward ? 18446744073709551615 as usize : 0;
    var index: usize = 0;
    while (index < count) {
        let label: NumericLabel = labels[index];
        if (label.section == fixup.section && label.number == fixup.numeric_label) {
            if (fixup.numeric_forward && label.offset > fixup.offset && label.offset < selected) {
                selected = label.offset;
                found = true;
            } else if (!fixup.numeric_forward && label.offset <= fixup.offset && (!found || label.offset > selected)) {
                selected = label.offset;
                found = true;
            }
        }
        index += 1;
    }
    if (found) {
        *result = selected;
    }
    return found;
}

fn resolve_fixups(assembler: *Assembler) -> bool {
    let fixups: *const Fixup = assembler->fixups.data as *const Fixup;
    let count: usize = assembler->fixups.length / sizeof(Fixup);
    var index: usize = 0;
    while (index < count) {
        let fixup: Fixup = fixups[index];
        assembler->line = fixup.line;
        if (fixup.is_numeric) {
            var target: usize = 0;
            if (fixup.kind == FixupKind.rip_relative ||
                !numeric_target(assembler as *const Assembler, fixup, &target) ||
                !patch(
                    assembler, fixup, target)) {
                return fail(assembler, runtime::Error.invalid_argument);
            }
            index += 1;
            continue;
        }
        var found: object::IndexResult = object::find_symbol(assembler->object, fixup.target);
        if (!found.found && fixup.kind == FixupKind.call) {
            found = get_symbol(assembler, fixup.target);
            let created: *object::Symbol = object::symbol_mut(&assembler->object, found.index);
            if (created != null) {
                created->global = true;
                created->external = true;
            }
        }
        if (found.error != runtime::Error.none || !found.found && fixup.kind != FixupKind.call) {
            return fail(assembler, runtime::Error.invalid_argument);
        }
        let symbol: *object::Symbol = object::symbol_mut(&assembler->object, found.index);
        if (symbol == null) {
            return fail(assembler, runtime::Error.invalid_argument);
        }
        if (symbol->defined && symbol->section == fixup.section) {
            if (!patch(
                    assembler, fixup, symbol->value)) {
                return false;
            }
            index += 1;
            continue;
        }
        if (fixup.kind == FixupKind.branch) {
            return fail(assembler, runtime::Error.invalid_argument);
        }
        if (!symbol->defined) {
            symbol->global = true;
        }
        if (!object::add_relocation(
                &assembler->object, {
                    section = fixup.section, offset = fixup.offset, symbol_index = found.index, kind = fixup.kind ==
                            FixupKind.call ? object::RelocationKind.plt32 :
                            object::RelocationKind.pc32, addend = -4,
                })) {
            return fail(assembler, assembler->object.error);
        }
        index += 1;
    }
    return true;
}

fn validate_symbols(assembler: *Assembler) -> bool {
    let count: usize = object::symbol_count(assembler->object);
    var index: usize = 0;
    while (index < count) {
        let result: object::SymbolResult = object::get_symbol(assembler->object, index);
        if (result.error != runtime::Error.none || (!result.symbol.defined && !result.symbol.global &&
             !result.symbol.external)) {
            return fail(assembler, runtime::Error.invalid_argument);
        }
        index += 1;
    }
    return true;
}

fn assemble(assembly: text::View) -> Result {
    var assembler: Assembler = {
        object = object::empty(), section = object::Section.undefined, fixups = bytes::empty(),
        numeric_labels = bytes::empty(), line = 1, error = runtime::Error.none,
    };
    if (!text::is_valid_utf8(assembly) || assembly.length > Limit.maximum_source as usize) {
        assembler.error = runtime::Error.invalid_argument;
    }
    var offset: usize = 0;
    while (assembler.error == runtime::Error.none && offset < assembly.length) {
        var end: usize = offset;
        while (end < assembly.length && assembly.data[end] != 10) {
            end += 1;
        }
        if (end - offset > Limit.maximum_line as usize ||
            !line(
                &assembler, slice(assembly, offset, end - offset))) {
            if (assembler.error == runtime::Error.none) {
                assembler.error = runtime::Error.invalid_argument;
            }
            break;
        }
        if (end == assembly.length) {
            offset = end;
        } else {
            offset = end + 1;
            assembler.line += 1;
        }
    }
    if (assembler.error == runtime::Error.none && (!resolve_fixups(&assembler) ||
         !validate_symbols(&assembler) || !object::is_valid(assembler.object))) {
        if (assembler.error == runtime::Error.none) {
            assembler.error = runtime::Error.invalid_argument;
        }
    }
    let fixup_error: runtime::Error = bytes::release(assembler.fixups);
    let label_error: runtime::Error = bytes::release(assembler.numeric_labels);
    if (assembler.error == runtime::Error.none && fixup_error != runtime::Error.none) {
        assembler.error = fixup_error;
    }
    if (assembler.error == runtime::Error.none && label_error != runtime::Error.none) {
        assembler.error = label_error;
    }
    if (assembler.error != runtime::Error.none) {
        object::release(assembler.object);
        assembler.object = object::empty();
    }
    return {
        object = assembler.object, error = assembler.error, line = assembler.line,
    };
}

