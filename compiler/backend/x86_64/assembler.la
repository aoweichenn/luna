module luna.bootstrap.backend.x86_64.assembler;

import luna.bootstrap.backend.x86_64.assembler.encoding as encoding;
import luna.bootstrap.backend.x86_64.assembler.operands as operands;
import luna.bootstrap.backend.x86_64.assembler.source as source;
import luna.std.bytes as bytes;

fn assemble(assembly: text::View) -> Result {
    var assembler: encoding::State = {
        object = object::empty(), section = object::Section.undefined, fixups = bytes::empty(),
        numeric_labels = bytes::empty(), line = 1, error = runtime::Error.none,
    };
    if (!text::is_valid_utf8(assembly) || assembly.length > encoding::Limit.maximum_source as usize) {
        assembler.error = runtime::Error.invalid_argument;
    }
    var offset: usize = 0;
    while (assembler.error == runtime::Error.none && offset < assembly.length) {
        var end: usize = offset;
        while (end < assembly.length && assembly.data[end] != '\n') {
            end += 1;
        }
        if (end - offset > encoding::Limit.maximum_line as usize ||
            !source::line(
                &assembler, operands::slice(assembly, offset, end - offset))) {
            if (assembler.error == runtime::Error.none) {
                assembler.error = runtime::Error.invalid_argument;
            }
            break;
        }
        if (end == assembly.length) {
            offset = end;
        } else {
            offset = end + 1;
            assembler.line += 1;
        }
    }
    if (assembler.error == runtime::Error.none && (!source::resolve_fixups(&assembler) ||
         !source::validate_symbols(&assembler) || !object::is_valid(assembler.object))) {
        if (assembler.error == runtime::Error.none) {
            assembler.error = runtime::Error.invalid_argument;
        }
    }
    let fixup_error: runtime::Error = bytes::release(assembler.fixups);
    let label_error: runtime::Error = bytes::release(assembler.numeric_labels);
    if (assembler.error == runtime::Error.none && fixup_error != runtime::Error.none) {
        assembler.error = fixup_error;
    }
    if (assembler.error == runtime::Error.none && label_error != runtime::Error.none) {
        assembler.error = label_error;
    }
    if (assembler.error != runtime::Error.none) {
        object::release(assembler.object);
        assembler.object = object::empty();
    }
    return {
        object = assembler.object, error = assembler.error, line = assembler.line,
    };
}
