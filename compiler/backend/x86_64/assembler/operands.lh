export module luna.bootstrap.backend.x86_64.assembler.operands;

import luna.std.text as text;

export enum RegisterClass: usize {
    general = 0, vector = 1,
}

export enum OperandKind: usize {
    none = 0, immediate = 1, register = 2, memory = 3, label = 4,
}

export struct Register {
    class: RegisterClass;
    code: u8;
    width: usize;
}

export struct Memory {
    symbol: text::View;
    displacement: isize;
    base: Register;
    index: Register;
    scale: u8;
    rip_relative: bool;
    has_index: bool;
}

export struct Operand {
    kind: OperandKind;
    immediate: u64;
    register: Register;
    memory: Memory;
    label: text::View;
}

export struct Operands {
    values: [3]Operand;
    count: usize;
}

export fn empty_operands()
    -> Operands;
export fn is_space(value: u8) -> bool;
export fn is_letter(value: u8) -> bool;
export fn is_decimal_digit(value: u8) -> bool;
export fn trim(view: text::View) -> text::View;
export fn equal(view: text::View, text: *const u8, length: usize) -> bool;
export fn starts_with(view: text::View, text: *const u8, length: usize) -> bool;
export fn slice(view: text::View, offset: usize, length: usize) -> text::View;
export fn find(view: text::View, value: u8) -> usize;
export fn parse_bits(input: text::View, result: *u64) -> bool;
export fn parse_usize(input: text::View, result: *usize) -> bool;
export fn parse_operands(input: text::View, result: *Operands) -> bool;
export fn is_gpr(operand: *const Operand, width: usize) -> bool;
export fn is_xmm(operand: *const Operand) -> bool;
export fn is_rm(operand: *const Operand, width: usize) -> bool;
