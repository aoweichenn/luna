module luna.bootstrap.middleend.ir;

enum BootstrapIrLimit: usize {
    maximum_size = 18446744073709551615, maximum_alignment = 8, maximum_slot_alignment = 4096,
}

fn bootstrap_ir_no_id() -> usize {
    return BootstrapIrLimit.maximum_size as usize;
}

fn bootstrap_ir_empty_span() -> BootstrapSourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn bootstrap_ir_invalid_function() -> BootstrapIrFunction {
    let none: usize = bootstrap_ir_no_id();
    return {
        declaration_unit = none, declaration_node = none, name_token = none, linkage = BootstrapIrLinkage.internal,
        return_type = none, first_parameter = none, parameter_count = 0, first_slot = none, slot_count = 0,
        first_block = none, block_count = 0, first_value = none, value_count = 0, has_body = false,
    };
}

fn bootstrap_ir_invalid_block() -> BootstrapIrBlock {
    let none: usize = bootstrap_ir_no_id();
    return {
        function_id = none, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
}

fn bootstrap_ir_invalid_instruction()
    -> BootstrapIrInstruction {
    let none: usize = bootstrap_ir_no_id();
    return {
        opcode = BootstrapIrOpcode.invalid, operation = BootstrapTokenKind.invalid, type_id = none, result = none,
        left = none, right = none, third = none, auxiliary = none, immediate = 0, floating = 0.0, block_id = none,
        next_instruction = none, span = bootstrap_ir_empty_span(),
    };
}

fn bootstrap_ir_empty() -> BootstrapTypedIr {
    return {
        globals = std_byte_buffer_empty(), global_count = 0, global_bytes = std_byte_buffer_empty(),
        functions = std_byte_buffer_empty(), function_count = 0, parameters = std_byte_buffer_empty(),
        parameter_count = 0, slots = std_byte_buffer_empty(), slot_count = 0, values = std_byte_buffer_empty(),
        value_count = 0, blocks = std_byte_buffer_empty(), block_count = 0, instructions = std_byte_buffer_empty(),
        instruction_count = 0, arguments = std_byte_buffer_empty(), argument_count = 0,
        entry_function = bootstrap_ir_no_id(), error = RuntimeError.none,
    };
}

fn bootstrap_ir_buffer_matches(buffer: StdByteBuffer, count: usize, record_size: usize) -> bool {
    return std_byte_buffer_is_valid(buffer) && record_size != 0 && buffer.length % record_size == 0 &&
        count == buffer.length / record_size;
}

fn bootstrap_ir_storage_is_valid(ir: BootstrapTypedIr) -> bool {
    return bootstrap_ir_buffer_matches(ir.globals, ir.global_count, sizeof(BootstrapIrGlobal)) &&
        std_byte_buffer_is_valid(ir.global_bytes) &&
        bootstrap_ir_buffer_matches(ir.functions, ir.function_count, sizeof(BootstrapIrFunction)) &&
        bootstrap_ir_buffer_matches(ir.parameters, ir.parameter_count, sizeof(BootstrapIrParameter)) &&
        bootstrap_ir_buffer_matches(ir.slots, ir.slot_count, sizeof(BootstrapIrSlot)) &&
        bootstrap_ir_buffer_matches(ir.values, ir.value_count, sizeof(BootstrapIrValue)) &&
        bootstrap_ir_buffer_matches(ir.blocks, ir.block_count, sizeof(BootstrapIrBlock)) &&
        bootstrap_ir_buffer_matches(ir.instructions, ir.instruction_count, sizeof(BootstrapIrInstruction)) &&
        bootstrap_ir_buffer_matches(ir.arguments, ir.argument_count, sizeof(BootstrapIrArgument));
}

fn bootstrap_ir_get_function(ir: BootstrapTypedIr, function_id: usize) -> BootstrapIrFunctionResult {
    if (!bootstrap_ir_storage_is_valid(ir) || function_id >= ir.function_count) {
        return {
            function = bootstrap_ir_invalid_function(), error = RuntimeError.invalid_argument,
        };
    }
    let functions: *const BootstrapIrFunction = ir.functions.data as *const BootstrapIrFunction;
    return {
        function = functions[function_id], error = RuntimeError.none,
    };
}

fn bootstrap_ir_get_block(ir: BootstrapTypedIr, block_id: usize) -> BootstrapIrBlockResult {
    if (!bootstrap_ir_storage_is_valid(ir) || block_id >= ir.block_count) {
        return {
            block = bootstrap_ir_invalid_block(), error = RuntimeError.invalid_argument,
        };
    }
    let blocks: *const BootstrapIrBlock = ir.blocks.data as *const BootstrapIrBlock;
    return {
        block = blocks[block_id], error = RuntimeError.none,
    };
}

fn bootstrap_ir_get_instruction(ir: BootstrapTypedIr, instruction_id: usize) -> BootstrapIrInstructionResult {
    if (!bootstrap_ir_storage_is_valid(ir) || instruction_id >= ir.instruction_count) {
        return {
            instruction = bootstrap_ir_invalid_instruction(), error = RuntimeError.invalid_argument,
        };
    }
    let instructions: *const BootstrapIrInstruction = ir.instructions.data as *const BootstrapIrInstruction;
    return {
        instruction = instructions[instruction_id], error = RuntimeError.none,
    };
}

fn bootstrap_ir_append(buffer: StdByteBuffer, data: *const u8, length: usize) -> StdByteBufferResult {
    if (length == 0 || data == null) {
        return {
            buffer = buffer, error = RuntimeError.invalid_argument,
        };
    }
    return std_byte_buffer_append(buffer, data, length);
}

fn bootstrap_ir_set_error(ir: *BootstrapTypedIr, error: RuntimeError) -> bool {
    if (ir == null) {
        return false;
    }
    if (ir->error == RuntimeError.none) {
        ir->error = error;
    }
    return false;
}

fn bootstrap_ir_add_global(
    ir: *BootstrapTypedIr, bytes: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        byte_count == 0 || bytes == null || alignment_bytes == 0 || alignment_bytes > 8 ||
        (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    let byte_offset: usize = ir->global_bytes.length;
    let appended_bytes: StdByteBufferResult = std_byte_buffer_append(ir->global_bytes, bytes, byte_count);
    ir->global_bytes = appended_bytes.buffer;
    if (appended_bytes.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended_bytes.error);
        return none;
    }
    let global: BootstrapIrGlobal = {
        byte_offset = byte_offset, byte_count = byte_count, alignment_bytes = alignment_bytes, read_only = read_only,
    };
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->globals, (&global) as *const BootstrapIrGlobal as *const u8, sizeof(BootstrapIrGlobal));
    ir->globals = appended.buffer;
    if (appended.error != RuntimeError.none) {
        let truncated: StdByteBufferResult = std_byte_buffer_truncate(ir->global_bytes, byte_offset);
        ir->global_bytes = truncated.buffer;
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let global_id: usize = ir->global_count;
    ir->global_count += 1;
    return global_id;
}

fn bootstrap_ir_add_function(ir: *BootstrapTypedIr, function: BootstrapIrFunction) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        function.declaration_unit == none || function.declaration_node == none || function.name_token == none ||
        function.return_type == none || function.parameter_count != 0 || function.slot_count != 0 ||
        function.block_count != 0 || function.value_count != 0) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    var record: BootstrapIrFunction = function;
    record.first_parameter = none;
    record.first_slot = none;
    record.first_block = none;
    record.first_value = none;
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->functions, (&record) as *const BootstrapIrFunction as *const u8, sizeof(BootstrapIrFunction));
    ir->functions = appended.buffer;
    if (appended.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let function_id: usize = ir->function_count;
    ir->function_count += 1;
    return function_id;
}

fn bootstrap_ir_function_can_extend_range(first: usize, count: usize, next: usize) -> bool {
    return count == 0 ? first == bootstrap_ir_no_id() : first + count == next;
}

fn bootstrap_ir_add_slot(
    ir: *BootstrapTypedIr, function_id: usize, type_id: usize, mutable_binding: bool,
    volatile_binding: bool, alignment_bytes: usize) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none ||
        alignment_bytes > (BootstrapIrLimit.maximum_slot_alignment as usize) ||
        (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    let functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    let slot: BootstrapIrSlot = {
        function_id = function_id, type_id = type_id, alignment_bytes = alignment_bytes,
        mutable_binding = mutable_binding, volatile_binding = volatile_binding,
    };
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->slots, (&slot) as *const BootstrapIrSlot as *const u8, sizeof(BootstrapIrSlot));
    ir->slots = appended.buffer;
    if (appended.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let result_functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (result_functions[function_id].slot_count == 0) {
        result_functions[function_id].first_slot = ir->slot_count;
    }
    result_functions[function_id].slot_count += 1;
    let slot_id: usize = ir->slot_count;
    ir->slot_count += 1;
    return slot_id;
}

fn bootstrap_ir_add_parameter(ir: *BootstrapTypedIr, function_id: usize, type_id: usize, name_token: usize) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none || name_token == none) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    let functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (!bootstrap_ir_function_can_extend_range(
            functions[function_id].first_parameter, functions[function_id].parameter_count, ir->parameter_count)) {
        bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        return none;
    }
    let slot_id: usize = bootstrap_ir_add_slot(ir, function_id, type_id, false, false, 0);
    if (slot_id == none) {
        return none;
    }
    let parameter: BootstrapIrParameter = {
        function_id = function_id, type_id = type_id, slot_id = slot_id, name_token = name_token,
    };
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->parameters, (&parameter) as *const BootstrapIrParameter as *const u8, sizeof(BootstrapIrParameter));
    ir->parameters = appended.buffer;
    if (appended.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let result_functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (result_functions[function_id].parameter_count == 0) {
        result_functions[function_id].first_parameter = ir->parameter_count;
    }
    result_functions[function_id].parameter_count += 1;
    let parameter_id: usize = ir->parameter_count;
    ir->parameter_count += 1;
    return parameter_id;
}

fn bootstrap_ir_add_block(ir: *BootstrapTypedIr, function_id: usize) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        function_id >= ir->function_count) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    let functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (!functions[function_id].has_body ||
        !bootstrap_ir_function_can_extend_range(
            functions[function_id].first_block, functions[function_id].block_count, ir->block_count)) {
        bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        return none;
    }
    let block: BootstrapIrBlock = {
        function_id = function_id, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->blocks, (&block) as *const BootstrapIrBlock as *const u8, sizeof(BootstrapIrBlock));
    ir->blocks = appended.buffer;
    if (appended.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let result_functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (result_functions[function_id].block_count == 0) {
        result_functions[function_id].first_block = ir->block_count;
    }
    result_functions[function_id].block_count += 1;
    let block_id: usize = ir->block_count;
    ir->block_count += 1;
    return block_id;
}

fn bootstrap_ir_add_value(ir: *BootstrapTypedIr, function_id: usize, block_id: usize, type_id: usize) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        function_id >= ir->function_count || block_id >= ir->block_count || type_id == none) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    let blocks: *const BootstrapIrBlock = ir->blocks.data as *const BootstrapIrBlock;
    let functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (blocks[block_id].function_id != function_id ||
        !bootstrap_ir_function_can_extend_range(
            functions[function_id].first_value, functions[function_id].value_count, ir->value_count)) {
        bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        return none;
    }
    let value: BootstrapIrValue = {
        function_id = function_id, block_id = block_id, type_id = type_id, definition = none,
    };
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->values, (&value) as *const BootstrapIrValue as *const u8, sizeof(BootstrapIrValue));
    ir->values = appended.buffer;
    if (appended.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let result_functions: *BootstrapIrFunction = ir->functions.data as *BootstrapIrFunction;
    if (result_functions[function_id].value_count == 0) {
        result_functions[function_id].first_value = ir->value_count;
    }
    result_functions[function_id].value_count += 1;
    let value_id: usize = ir->value_count;
    ir->value_count += 1;
    return value_id;
}

fn bootstrap_ir_opcode_is_terminator(opcode: BootstrapIrOpcode) -> bool {
    return opcode == BootstrapIrOpcode.jump || opcode == BootstrapIrOpcode.branch ||
        opcode == BootstrapIrOpcode.return_value || opcode == BootstrapIrOpcode.return_void ||
        opcode == BootstrapIrOpcode.unreachable;
}

fn bootstrap_ir_increment_predecessor(ir: *BootstrapTypedIr, source_block: usize, target_block: usize) -> bool {
    if (target_block >= ir->block_count) {
        return bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
    }
    let blocks: *BootstrapIrBlock = ir->blocks.data as *BootstrapIrBlock;
    if (blocks[source_block].function_id != blocks[target_block].function_id ||
        blocks[target_block].predecessor_count == BootstrapIrLimit.maximum_size as usize) {
        return bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
    }
    blocks[target_block].predecessor_count += 1;
    return true;
}

fn bootstrap_ir_emit(ir: *BootstrapTypedIr, instruction: BootstrapIrInstruction) -> usize {
    let none: usize = bootstrap_ir_no_id();
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        instruction.opcode == BootstrapIrOpcode.invalid || instruction.block_id >= ir->block_count ||
        instruction.next_instruction != none || instruction.span.line == 0 || instruction.span.column == 0) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return none;
    }
    let blocks: *BootstrapIrBlock = ir->blocks.data as *BootstrapIrBlock;
    if (blocks[instruction.block_id].terminated) {
        bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        return none;
    }
    if (instruction.result != none) {
        if (instruction.result >= ir->value_count) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
            return none;
        }
        let values: *const BootstrapIrValue = ir->values.data as *const BootstrapIrValue;
        if (values[instruction.result].block_id != instruction.block_id ||
            values[instruction.result].definition != none || values[instruction.result].type_id !=
                instruction.type_id) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
            return none;
        }
    }
    let instruction_id: usize = ir->instruction_count;
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->instructions, (&instruction) as *const BootstrapIrInstruction as *const u8, sizeof(BootstrapIrInstruction));
    ir->instructions = appended.buffer;
    if (appended.error != RuntimeError.none) {
        bootstrap_ir_set_error(ir, appended.error);
        return none;
    }
    let result_blocks: *BootstrapIrBlock = ir->blocks.data as *BootstrapIrBlock;
    if (result_blocks[instruction.block_id].instruction_count == 0) {
        result_blocks[instruction.block_id].first_instruction = instruction_id;
    } else {
        let instructions: *BootstrapIrInstruction = ir->instructions.data as *BootstrapIrInstruction;
        instructions[ result_blocks[instruction.block_id].last_instruction].next_instruction = instruction_id;
    }
    result_blocks[instruction.block_id].last_instruction = instruction_id;
    result_blocks[instruction.block_id].instruction_count += 1;
    if (instruction.result != none) {
        let values: *BootstrapIrValue = ir->values.data as *BootstrapIrValue;
        values[instruction.result].definition = instruction_id;
    }
    ir->instruction_count += 1;

    if (instruction.opcode == BootstrapIrOpcode.jump) {
        if (!bootstrap_ir_increment_predecessor(
                ir, instruction.block_id, instruction.auxiliary)) {
            return none;
        }
    } else if (instruction.opcode == BootstrapIrOpcode.branch) {
        if (!bootstrap_ir_increment_predecessor(ir, instruction.block_id, instruction.auxiliary) ||
            !bootstrap_ir_increment_predecessor(
                ir, instruction.block_id, instruction.third)) {
            return none;
        }
    }
    if (bootstrap_ir_opcode_is_terminator(
            instruction.opcode)) {
        result_blocks[instruction.block_id].terminated = true;
    }
    return instruction_id;
}

fn bootstrap_ir_add_argument(ir: *BootstrapTypedIr, instruction_id: usize, value_id: usize) -> bool {
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        instruction_id >= ir->instruction_count || value_id >= ir->value_count) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return false;
    }
    let instructions: *const BootstrapIrInstruction = ir->instructions.data as *const BootstrapIrInstruction;
    let values: *const BootstrapIrValue = ir->values.data as *const BootstrapIrValue;
    if ((instructions[instruction_id].opcode != BootstrapIrOpcode.call && instructions[instruction_id].opcode !=
            BootstrapIrOpcode.call_indirect) || values[value_id].function_id !=
            (ir->blocks.data as *const BootstrapIrBlock)[ instructions[instruction_id].block_id].function_id) {
        return bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
    }
    let argument: BootstrapIrArgument = {
        instruction_id = instruction_id, value_id = value_id,
    };
    let appended: StdByteBufferResult = bootstrap_ir_append(
        ir->arguments, (&argument) as *const BootstrapIrArgument as *const u8, sizeof(BootstrapIrArgument));
    ir->arguments = appended.buffer;
    if (appended.error != RuntimeError.none) {
        return bootstrap_ir_set_error(ir, appended.error);
    }
    ir->argument_count += 1;
    return true;
}

fn bootstrap_ir_set_entry(ir: *BootstrapTypedIr, function_id: usize) -> bool {
    if (ir == null || ir->error != RuntimeError.none || !bootstrap_ir_storage_is_valid(*ir) ||
        function_id >= ir->function_count || ir->entry_function != bootstrap_ir_no_id()) {
        if (ir != null) {
            bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
        }
        return false;
    }
    let functions: *const BootstrapIrFunction = ir->functions.data as *const BootstrapIrFunction;
    if (!functions[function_id].has_body) {
        return bootstrap_ir_set_error(ir, RuntimeError.invalid_argument);
    }
    ir->entry_function = function_id;
    return true;
}

fn bootstrap_ir_range_is_valid(first: usize, count: usize, total: usize) -> bool {
    if (count == 0) {
        return first == bootstrap_ir_no_id();
    }
    return first < total && count <= total - first;
}

fn bootstrap_ir_value_operand_is_valid(
    values: *const BootstrapIrValue, value_count: usize, value_id: usize, function_id: usize, instruction_id: usize
) -> bool {
    return value_id < value_count && values[value_id].function_id == function_id &&
        values[value_id].definition != bootstrap_ir_no_id() && values[value_id].definition < instruction_id;
}

fn bootstrap_ir_instruction_operands_are_valid(
    instruction: BootstrapIrInstruction, instruction_id: usize, function_id: usize, ir: BootstrapTypedIr,
    values: *const BootstrapIrValue) -> bool {
    let none: usize = bootstrap_ir_no_id();
    let unary: bool = instruction.opcode == BootstrapIrOpcode.store ||
        instruction.opcode == BootstrapIrOpcode.load_indirect || instruction.opcode == BootstrapIrOpcode.null_check ||
        instruction.opcode == BootstrapIrOpcode.unary_integer || instruction.opcode == BootstrapIrOpcode.unary_float ||
        instruction.opcode == BootstrapIrOpcode.boolean_not || instruction.opcode == BootstrapIrOpcode.convert ||
        instruction.opcode == BootstrapIrOpcode.return_value || instruction.opcode == BootstrapIrOpcode.call_indirect ||
        instruction.opcode == BootstrapIrOpcode.branch || instruction.opcode == BootstrapIrOpcode.float_sqrt;
    let binary: bool = instruction.opcode == BootstrapIrOpcode.memory_copy ||
        instruction.opcode == BootstrapIrOpcode.store_indirect ||
        instruction.opcode == BootstrapIrOpcode.bounds_check ||
        instruction.opcode == BootstrapIrOpcode.pointer_offset ||
        instruction.opcode == BootstrapIrOpcode.binary_integer ||
        instruction.opcode == BootstrapIrOpcode.binary_float || instruction.opcode == BootstrapIrOpcode.compare ||
        instruction.opcode == BootstrapIrOpcode.float_min || instruction.opcode == BootstrapIrOpcode.float_max;
    if ((unary || binary) &&
        !bootstrap_ir_value_operand_is_valid(
            values, ir.value_count, instruction.left, function_id, instruction_id)) {
        return false;
    }
    if (binary &&
        !bootstrap_ir_value_operand_is_valid(
            values, ir.value_count, instruction.right, function_id, instruction_id)) {
        return false;
    }
    if (instruction.opcode == BootstrapIrOpcode.call) {
        return instruction.auxiliary < ir.function_count;
    }
    if (instruction.opcode == BootstrapIrOpcode.address_of_slot || instruction.opcode == BootstrapIrOpcode.zero_slot ||
        instruction.opcode == BootstrapIrOpcode.load || instruction.opcode == BootstrapIrOpcode.store) {
        return instruction.auxiliary < ir.slot_count;
    }
    if (instruction.opcode == BootstrapIrOpcode.global_address) {
        return instruction.auxiliary < ir.global_count;
    }
    if (instruction.opcode == BootstrapIrOpcode.jump) {
        return instruction.auxiliary < ir.block_count && (ir.blocks.data as *const BootstrapIrBlock)[
                instruction.auxiliary].function_id == function_id;
    }
    if (instruction.opcode == BootstrapIrOpcode.branch) {
        return instruction.auxiliary < ir.block_count && instruction.third < ir.block_count &&
            (ir.blocks.data as *const BootstrapIrBlock)[ instruction.auxiliary].function_id == function_id &&
            (ir.blocks.data as *const BootstrapIrBlock)[ instruction.third].function_id == function_id;
    }
    if (instruction.opcode == BootstrapIrOpcode.return_void) {
        return instruction.left == none;
    }
    return true;
}

fn bootstrap_ir_carrier_matches_type(types: BootstrapTypeTable, carrier_type: usize, source_type: usize) -> bool {
    if (carrier_type == source_type) {
        return true;
    }
    if (carrier_type >= types.type_count || source_type >= types.type_count) {
        return false;
    }
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    return bootstrap_type_is_memory(records[source_type].kind) && records[carrier_type].kind ==
            BootstrapTypeKind.pointer && records[carrier_type].element_type == source_type;
}

fn bootstrap_ir_type_can_be_value(types: BootstrapTypeTable, type_id: usize) -> bool {
    if (type_id >= types.type_count) {
        return false;
    }
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    return records[type_id].kind != BootstrapTypeKind.invalid && records[type_id].kind != BootstrapTypeKind.type_void;
}

fn bootstrap_ir_instruction_expects_result(
    instruction: BootstrapIrInstruction, functions: *const BootstrapIrFunction, types: BootstrapTypeTable) -> bool {
    if (instruction.opcode == BootstrapIrOpcode.call) {
        let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
        return records[ functions[instruction.auxiliary].return_type].kind != BootstrapTypeKind.type_void;
    }
    if (instruction.opcode == BootstrapIrOpcode.call_indirect) {
        let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
        return records[instruction.type_id].kind != BootstrapTypeKind.type_void;
    }
    if (instruction.opcode == BootstrapIrOpcode.function_address) {
        return true;
    }
    return instruction.opcode == BootstrapIrOpcode.constant_integer ||
        instruction.opcode == BootstrapIrOpcode.constant_float ||
        instruction.opcode == BootstrapIrOpcode.constant_boolean ||
        instruction.opcode == BootstrapIrOpcode.constant_null ||
        instruction.opcode == BootstrapIrOpcode.address_of_slot ||
        instruction.opcode == BootstrapIrOpcode.member_address ||
        instruction.opcode == BootstrapIrOpcode.global_address || instruction.opcode == BootstrapIrOpcode.load ||
        instruction.opcode == BootstrapIrOpcode.load_indirect ||
        instruction.opcode == BootstrapIrOpcode.pointer_offset ||
        instruction.opcode == BootstrapIrOpcode.unary_integer || instruction.opcode == BootstrapIrOpcode.unary_float ||
        instruction.opcode == BootstrapIrOpcode.boolean_not || instruction.opcode == BootstrapIrOpcode.convert ||
        instruction.opcode == BootstrapIrOpcode.binary_integer ||
        instruction.opcode == BootstrapIrOpcode.binary_float || instruction.opcode == BootstrapIrOpcode.compare ||
        instruction.opcode == BootstrapIrOpcode.float_sqrt || instruction.opcode == BootstrapIrOpcode.float_min ||
        instruction.opcode == BootstrapIrOpcode.float_max || instruction.opcode == BootstrapIrOpcode.overflow_flag;
}

fn bootstrap_ir_member_address_is_valid(
    instruction: BootstrapIrInstruction, types: BootstrapTypeTable, values: *const BootstrapIrValue) -> bool {
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let fields: *const BootstrapTypeField = types.fields.data as *const BootstrapTypeField;
    let source_pointer: BootstrapTypeRecord = records[values[instruction.left].type_id];
    let result_pointer: BootstrapTypeRecord = records[instruction.type_id];
    if (result_pointer.kind != BootstrapTypeKind.pointer) {
        return false;
    }
    var owner_type: usize = values[instruction.left].type_id;
    var source_read_only: bool = true;
    if (source_pointer.kind == BootstrapTypeKind.pointer) {
        owner_type = source_pointer.element_type;
        source_read_only = (source_pointer.flags & (BootstrapTypeFlag.read_only as usize)) != 0;
    } else if (!bootstrap_type_is_memory(
            source_pointer.kind)) {
        return false;
    }
    let owner: BootstrapTypeRecord = records[owner_type];
    if (!bootstrap_type_is_memory(owner.kind)) {
        return false;
    }
    var index: usize = 0;
    while (index < owner.field_count) {
        let field: BootstrapTypeField = fields[owner.first_field + index];
        if (field.offset_bytes == instruction.auxiliary && field.type_id == result_pointer.element_type) {
            let result_read_only: bool = (result_pointer.flags & (BootstrapTypeFlag.read_only as usize)) != 0;
            return !source_read_only || result_read_only;
        }
        index += 1;
    }
    return false;
}

fn bootstrap_ir_instruction_types_are_valid(
    instruction: BootstrapIrInstruction, function_id: usize, types: BootstrapTypeTable, values: *const BootstrapIrValue,
    functions: *const BootstrapIrFunction, slots: *const BootstrapIrSlot) -> bool {
    let none: usize = bootstrap_ir_no_id();
    let records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;
    let expects_result: bool = bootstrap_ir_instruction_expects_result(instruction, functions, types);
    let requires_type: bool = expects_result || instruction.opcode == BootstrapIrOpcode.zero_slot ||
        instruction.opcode == BootstrapIrOpcode.memory_copy || instruction.opcode == BootstrapIrOpcode.store ||
        instruction.opcode == BootstrapIrOpcode.store_indirect || instruction.opcode == BootstrapIrOpcode.call ||
        instruction.opcode == BootstrapIrOpcode.call_indirect || instruction.opcode == BootstrapIrOpcode.return_value ||
        instruction.opcode == BootstrapIrOpcode.return_void;
    if (expects_result != (instruction.result != none) || (requires_type && instruction.type_id == none) ||
        (expects_result &&
            !bootstrap_ir_type_can_be_value(
                types, instruction.type_id))) {
        return false;
    }

    if (instruction.opcode == BootstrapIrOpcode.constant_integer) {
        return bootstrap_type_is_integer(records[instruction.type_id].kind) ||
            records[instruction.type_id].kind == BootstrapTypeKind.enumeration;
    }
    if (instruction.opcode == BootstrapIrOpcode.constant_float) {
        return bootstrap_type_is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.constant_boolean) {
        return instruction.type_id == BootstrapBuiltinType.boolean as usize && instruction.immediate <= 1;
    }
    if (instruction.opcode == BootstrapIrOpcode.constant_null) {
        return records[instruction.type_id].kind == BootstrapTypeKind.pointer || records[instruction.type_id].kind ==
                BootstrapTypeKind.function_pointer;
    }
    if (instruction.opcode == BootstrapIrOpcode.address_of_slot) {
        return slots[instruction.auxiliary].function_id == function_id && records[instruction.type_id].kind ==
                BootstrapTypeKind.pointer && records[instruction.type_id].element_type ==
                slots[instruction.auxiliary].type_id;
    }
    if (instruction.opcode == BootstrapIrOpcode.member_address) {
        return bootstrap_ir_member_address_is_valid(instruction, types, values);
    }
    if (instruction.opcode == BootstrapIrOpcode.global_address) {
        return records[instruction.type_id].kind == BootstrapTypeKind.pointer &&
            records[instruction.type_id].element_type == BootstrapBuiltinType.unsigned_8 as usize &&
            (records[instruction.type_id].flags & (BootstrapTypeFlag.read_only as usize)) != 0;
    }
    if (instruction.opcode == BootstrapIrOpcode.zero_slot) {
        return slots[instruction.auxiliary].function_id == function_id && slots[instruction.auxiliary].type_id ==
                instruction.type_id && bootstrap_type_is_memory(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.load) {
        return slots[instruction.auxiliary].function_id == function_id && slots[instruction.auxiliary].type_id ==
                instruction.type_id && bootstrap_type_is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.store) {
        return slots[instruction.auxiliary].function_id == function_id && slots[instruction.auxiliary].type_id ==
                values[instruction.left].type_id && instruction.type_id == values[instruction.left].type_id &&
            bootstrap_type_is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.load_indirect) {
        let pointer: BootstrapTypeRecord = records[values[instruction.left].type_id];
        return pointer.kind == BootstrapTypeKind.pointer && pointer.element_type == instruction.type_id &&
            bootstrap_type_is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.store_indirect || instruction.opcode == BootstrapIrOpcode.memory_copy) {
        let destination: BootstrapTypeRecord = records[values[instruction.left].type_id];
        if (destination.kind != BootstrapTypeKind.pointer || destination.element_type != instruction.type_id ||
            (destination.flags & (BootstrapTypeFlag.read_only as usize)) != 0 ||
            !bootstrap_ir_carrier_matches_type(types, values[instruction.right].type_id, instruction.type_id) ||
            instruction.auxiliary != records[instruction.type_id].size_bytes) {
            return false;
        }
        return instruction.opcode == BootstrapIrOpcode.memory_copy ?
            bootstrap_type_is_memory(records[instruction.type_id].kind) :
            bootstrap_type_is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.null_check) {
        let checked: BootstrapTypeKind = records[values[instruction.left].type_id].kind;
        return checked == BootstrapTypeKind.pointer || checked == BootstrapTypeKind.function_pointer;
    }
    if (instruction.opcode == BootstrapIrOpcode.bounds_check) {
        return values[instruction.left].type_id == BootstrapBuiltinType.unsigned_size as usize &&
            values[instruction.right].type_id == BootstrapBuiltinType.unsigned_size as usize;
    }
    if (instruction.opcode == BootstrapIrOpcode.pointer_offset) {
        let source: BootstrapTypeRecord = records[values[instruction.left].type_id];
        let result: BootstrapTypeRecord = records[instruction.type_id];
        let temporary_array: bool = source.kind == BootstrapTypeKind.array;
        var element_matches: bool = source.element_type == result.element_type;
        if (source.kind == BootstrapTypeKind.pointer && records[source.element_type].kind == BootstrapTypeKind.array) {
            element_matches = records[source.element_type].element_type == result.element_type;
        }
        let qualifier_matches: bool = temporary_array ? (result.flags & (BootstrapTypeFlag.read_only as usize)) != 0 :
                source.flags == result.flags;
        return (source.kind == BootstrapTypeKind.pointer || temporary_array) &&
            result.kind == BootstrapTypeKind.pointer && element_matches && qualifier_matches &&
            values[instruction.right].type_id == BootstrapBuiltinType.unsigned_size as usize && instruction.auxiliary ==
                records[result.element_type].size_bytes;
    }
    if (instruction.opcode == BootstrapIrOpcode.unary_integer) {
        return values[instruction.left].type_id == instruction.type_id &&
            bootstrap_type_is_integer(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.unary_float) {
        return values[instruction.left].type_id == instruction.type_id &&
            bootstrap_type_is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.float_sqrt) {
        return values[instruction.left].type_id == instruction.type_id &&
            bootstrap_type_is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.boolean_not) {
        return values[instruction.left].type_id == BootstrapBuiltinType.boolean as usize && instruction.type_id ==
                BootstrapBuiltinType.boolean as usize;
    }
    if (instruction.opcode == BootstrapIrOpcode.convert) {
        return instruction.auxiliary < types.type_count && values[instruction.left].type_id == instruction.auxiliary &&
            bootstrap_type_is_scalar(records[instruction.auxiliary].kind) &&
            bootstrap_type_is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.binary_integer || instruction.opcode ==
            BootstrapIrOpcode.binary_float) {
        let integer_operation: bool = instruction.opcode == BootstrapIrOpcode.binary_integer;
        return values[instruction.left].type_id == instruction.type_id && values[instruction.right].type_id ==
                instruction.type_id && (integer_operation ?
                bootstrap_type_is_integer(records[instruction.type_id].kind) :
                bootstrap_type_is_float(
                    records[instruction.type_id].kind));
    }
    if (instruction.opcode == BootstrapIrOpcode.float_min || instruction.opcode == BootstrapIrOpcode.float_max) {
        return values[instruction.left].type_id == instruction.type_id && values[instruction.right].type_id ==
                instruction.type_id && bootstrap_type_is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.overflow_flag) {
        return instruction.type_id == BootstrapBuiltinType.boolean as usize;
    }
    if (instruction.opcode == BootstrapIrOpcode.compare) {
        return instruction.type_id == BootstrapBuiltinType.boolean as usize && values[instruction.left].type_id ==
                values[instruction.right].type_id &&
            bootstrap_type_is_scalar(records[ values[instruction.left].type_id].kind);
    }
    if (instruction.opcode == BootstrapIrOpcode.call) {
        return instruction.type_id == functions[instruction.auxiliary].return_type;
    }
    if (instruction.opcode == BootstrapIrOpcode.call_indirect) {
        if (instruction.left >= bootstrap_ir_no_id()) {
            return false;
        }
        let callee: BootstrapTypeRecord = records[values[instruction.left].type_id];
        return callee.kind == BootstrapTypeKind.function_pointer && callee.element_type == instruction.type_id;
    }
    if (instruction.opcode == BootstrapIrOpcode.function_address) {
        return records[instruction.type_id].kind == BootstrapTypeKind.function_pointer;
    }
    if (instruction.opcode == BootstrapIrOpcode.branch) {
        return instruction.type_id == none && values[instruction.left].type_id == BootstrapBuiltinType.boolean as usize;
    }
    if (instruction.opcode == BootstrapIrOpcode.jump) {
        return instruction.type_id == none;
    }
    if (instruction.opcode == BootstrapIrOpcode.return_value) {
        return instruction.type_id == functions[function_id].return_type &&
            bootstrap_ir_carrier_matches_type(types, values[instruction.left].type_id, instruction.type_id);
    }
    if (instruction.opcode == BootstrapIrOpcode.return_void) {
        return instruction.type_id == functions[function_id].return_type && records[instruction.type_id].kind ==
                BootstrapTypeKind.type_void;
    }
    return instruction.type_id == none;
}

fn bootstrap_ir_is_valid(ir: BootstrapTypedIr, types: BootstrapTypeTable) -> bool {
    let none: usize = bootstrap_ir_no_id();
    if (ir.error != RuntimeError.none || !bootstrap_ir_storage_is_valid(ir) ||
        !bootstrap_type_table_is_valid(types, true) || (ir.entry_function != none &&
            ir.entry_function >= ir.function_count)) {
        return false;
    }
    let globals: *const BootstrapIrGlobal = ir.globals.data as *const BootstrapIrGlobal;
    let functions: *const BootstrapIrFunction = ir.functions.data as *const BootstrapIrFunction;
    let parameters: *const BootstrapIrParameter = ir.parameters.data as *const BootstrapIrParameter;
    let slots: *const BootstrapIrSlot = ir.slots.data as *const BootstrapIrSlot;
    let values: *const BootstrapIrValue = ir.values.data as *const BootstrapIrValue;
    let blocks: *const BootstrapIrBlock = ir.blocks.data as *const BootstrapIrBlock;
    let instructions: *const BootstrapIrInstruction = ir.instructions.data as *const BootstrapIrInstruction;
    let arguments: *const BootstrapIrArgument = ir.arguments.data as *const BootstrapIrArgument;
    let type_records: *const BootstrapTypeRecord = types.types.data as *const BootstrapTypeRecord;

    var index: usize = 0;
    var expected_global_offset: usize = 0;
    while (index < ir.global_count) {
        let global: BootstrapIrGlobal = globals[index];
        if (global.byte_count == 0 || global.byte_offset != expected_global_offset ||
            global.byte_offset > ir.global_bytes.length || global.byte_count >
                ir.global_bytes.length - global.byte_offset || global.alignment_bytes == 0 ||
            global.alignment_bytes > 8 || (global.alignment_bytes & (global.alignment_bytes - 1)) != 0) {
            return false;
        }
        expected_global_offset += global.byte_count;
        index += 1;
    }
    if (expected_global_offset != ir.global_bytes.length) {
        return false;
    }

    var counted_parameters: usize = 0;
    var counted_slots: usize = 0;
    var counted_blocks: usize = 0;
    var counted_values: usize = 0;
    index = 0;
    while (index < ir.function_count) {
        let function: BootstrapIrFunction = functions[index];
        if (function.declaration_unit == none || function.declaration_node == none || function.name_token == none ||
            (function.linkage as usize) > (BootstrapIrLinkage.external_c as usize) ||
            function.return_type >= types.type_count || type_records[function.return_type].kind ==
                BootstrapTypeKind.invalid ||
            !bootstrap_ir_range_is_valid(function.first_parameter, function.parameter_count, ir.parameter_count) ||
            !bootstrap_ir_range_is_valid(function.first_block, function.block_count, ir.block_count) ||
            !bootstrap_ir_range_is_valid(function.first_value, function.value_count, ir.value_count) ||
            (function.has_body && function.block_count == 0) || (!function.has_body && (function.block_count != 0 ||
                    function.value_count != 0 || function.slot_count != function.parameter_count))) {
            return false;
        }
        counted_parameters += function.parameter_count;
        counted_slots += function.slot_count;
        counted_blocks += function.block_count;
        counted_values += function.value_count;
        var item: usize = 0;
        while (item < function.parameter_count) {
            let parameter: BootstrapIrParameter = parameters[function.first_parameter + item];
            if (parameter.function_id != index || parameter.type_id >= types.type_count ||
                !bootstrap_ir_type_can_be_value(types, parameter.type_id) ||
                parameter.slot_id >= ir.slot_count || slots[parameter.slot_id].function_id != index ||
                slots[parameter.slot_id].type_id != parameter.type_id || parameter.name_token == none) {
                return false;
            }
            item += 1;
        }
        var owned_slot_count: usize = 0;
        var first_owned_slot: usize = none;
        item = 0;
        while (item < ir.slot_count) {
            if (slots[item].function_id == index) {
                if (owned_slot_count == 0) {
                    first_owned_slot = item;
                }
                owned_slot_count += 1;
            }
            item += 1;
        }
        if (owned_slot_count != function.slot_count || first_owned_slot != function.first_slot) {
            return false;
        }
        item = 0;
        while (item < function.value_count) {
            let value: BootstrapIrValue = values[function.first_value + item];
            if (value.function_id != index || value.block_id >= ir.block_count ||
                !bootstrap_ir_type_can_be_value(types, value.type_id) || value.definition >= ir.instruction_count) {
                return false;
            }
            item += 1;
        }
        index += 1;
    }
    if (counted_parameters != ir.parameter_count || counted_slots != ir.slot_count ||
        counted_blocks != ir.block_count || counted_values != ir.value_count) {
        return false;
    }
    if (ir.entry_function != none) {
        let entry: BootstrapIrFunction = functions[ir.entry_function];
        if (!entry.has_body || entry.linkage != BootstrapIrLinkage.internal || entry.return_type !=
                BootstrapBuiltinType.signed_32 as usize || (entry.parameter_count != 0 && entry.parameter_count != 2)) {
            return false;
        }
        if (entry.parameter_count == 2) {
            let argument_count: BootstrapIrParameter = parameters[entry.first_parameter];
            let argument_vector: BootstrapIrParameter = parameters[entry.first_parameter + 1];
            let outer: BootstrapTypeRecord = type_records[argument_vector.type_id];
            if (argument_count.type_id != BootstrapBuiltinType.unsigned_size as usize ||
                outer.kind != BootstrapTypeKind.pointer || (outer.flags &
                    (BootstrapTypeFlag.read_only as usize)) != 0) {
                return false;
            }
            let inner: BootstrapTypeRecord = type_records[outer.element_type];
            if (inner.kind != BootstrapTypeKind.pointer || (inner.flags &
                    (BootstrapTypeFlag.read_only as usize)) == 0 || inner.element_type !=
                    BootstrapBuiltinType.unsigned_8 as usize) {
                return false;
            }
        }
    }

    index = 0;
    while (index < ir.slot_count) {
        if (slots[index].function_id >= ir.function_count ||
            !bootstrap_ir_type_can_be_value(
                types, slots[index].type_id) ||
            slots[index].alignment_bytes > (BootstrapIrLimit.maximum_slot_alignment as usize) ||
            (slots[index].alignment_bytes & (slots[index].alignment_bytes - 1)) != 0) {
            return false;
        }
        index += 1;
    }

    index = 0;
    var counted_instructions: usize = 0;
    while (index < ir.block_count) {
        let block: BootstrapIrBlock = blocks[index];
        if (block.function_id >= ir.function_count || (block.instruction_count == 0 &&
                (block.first_instruction != none || block.last_instruction != none || block.terminated)) ||
            (block.instruction_count != 0 && (block.first_instruction >= ir.instruction_count ||
                    block.last_instruction >= ir.instruction_count || !block.terminated))) {
            return false;
        }
        counted_instructions += block.instruction_count;
        var instruction_id: usize = block.first_instruction;
        var visited: usize = 0;
        var previous: usize = none;
        while (visited < block.instruction_count) {
            if (instruction_id >= ir.instruction_count || instructions[instruction_id].block_id != index) {
                return false;
            }
            if (bootstrap_ir_opcode_is_terminator(
                    instructions[instruction_id].opcode) && visited + 1 != block.instruction_count) {
                return false;
            }
            previous = instruction_id;
            instruction_id = instructions[instruction_id].next_instruction;
            visited += 1;
        }
        if (block.instruction_count != 0 && (previous != block.last_instruction || instruction_id != none ||
                !bootstrap_ir_opcode_is_terminator(
                    instructions[block.last_instruction].opcode))) {
            return false;
        }
        index += 1;
    }
    if (counted_instructions != ir.instruction_count) {
        return false;
    }

    index = 0;
    while (index < ir.block_count) {
        var expected_predecessors: usize = 0;
        var instruction_index: usize = 0;
        while (instruction_index < ir.instruction_count) {
            let candidate: BootstrapIrInstruction = instructions[instruction_index];
            if (candidate.opcode == BootstrapIrOpcode.jump && candidate.auxiliary == index) {
                expected_predecessors += 1;
            }
            if (candidate.opcode == BootstrapIrOpcode.branch && candidate.auxiliary == index) {
                expected_predecessors += 1;
            }
            if (candidate.opcode == BootstrapIrOpcode.branch && candidate.third == index) {
                expected_predecessors += 1;
            }
            instruction_index += 1;
        }
        if (blocks[index].predecessor_count != expected_predecessors) {
            return false;
        }
        index += 1;
    }

    index = 0;
    while (index < ir.instruction_count) {
        let instruction: BootstrapIrInstruction = instructions[index];
        if ((instruction.opcode as usize) > (BootstrapIrOpcode.overflow_flag as usize) ||
            instruction.opcode == BootstrapIrOpcode.invalid || instruction.block_id >= ir.block_count ||
            instruction.span.line == 0 || instruction.span.column == 0 || (instruction.type_id != none &&
                instruction.type_id >= types.type_count) || (instruction.result != none &&
                (instruction.result >= ir.value_count || values[instruction.result].definition != index ||
                    values[instruction.result].block_id != instruction.block_id || values[instruction.result].type_id !=
                        instruction.type_id)) ||
            !bootstrap_ir_instruction_operands_are_valid(
                instruction, index, blocks[instruction.block_id].function_id, ir, values) ||
            !bootstrap_ir_instruction_types_are_valid(
                instruction, blocks[instruction.block_id].function_id, types, values, functions, slots)) {
            return false;
        }
        if (instruction.opcode == BootstrapIrOpcode.call || instruction.opcode == BootstrapIrOpcode.call_indirect) {
            var call_parameter_count: usize = 0;
            if (instruction.opcode == BootstrapIrOpcode.call) {
                call_parameter_count = functions[instruction.auxiliary].parameter_count;
            } else {
                let callee_records: *const
                    BootstrapTypeRecord = types.types.data as
                        *const BootstrapTypeRecord;
                let callee: BootstrapTypeRecord = callee_records[ values[instruction.left].type_id];
                call_parameter_count = callee.field_count;
            }
            var call_argument_count: usize = 0;
            var argument_index: usize = 0;
            while (argument_index < ir.argument_count) {
                let argument: BootstrapIrArgument = arguments[argument_index];
                if (argument.instruction_id == index) {
                    var parameter_type: usize = bootstrap_ir_no_id();
                    if (instruction.opcode == BootstrapIrOpcode.call) {
                        let parameters: *const
                            BootstrapIrParameter = ir.parameters.data as
                                *const BootstrapIrParameter;
                        parameter_type = parameters[ functions[instruction.auxiliary].first_parameter +
                                    call_argument_count].type_id;
                    } else {
                        let fields: *const BootstrapTypeField = types.fields.data as
                                *const BootstrapTypeField;
                        let records: *const
                            BootstrapTypeRecord = types.types.data as
                                *const BootstrapTypeRecord;
                        let callee: BootstrapTypeRecord = records[ values[instruction.left].type_id];
                        parameter_type = fields[ callee.first_field + call_argument_count].type_id;
                    }
                    if (call_argument_count >= call_parameter_count || argument.value_id >= ir.value_count ||
                        values[argument.value_id].function_id != blocks[ instruction.block_id].function_id ||
                        !bootstrap_ir_carrier_matches_type(types, values[argument.value_id].type_id, parameter_type) ||
                        values[argument.value_id].definition >= index) {
                        return false;
                    }
                    call_argument_count += 1;
                }
                argument_index += 1;
            }
            if (call_argument_count != call_parameter_count) {
                return false;
            }
        }
        index += 1;
    }

    index = 0;
    while (index < ir.argument_count) {
        let argument: BootstrapIrArgument = arguments[index];
        if (argument.instruction_id >= ir.instruction_count || argument.value_id >= ir.value_count ||
            (instructions[argument.instruction_id].opcode != BootstrapIrOpcode.call &&
                instructions[argument.instruction_id].opcode != BootstrapIrOpcode.call_indirect)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_ir_release(ir: BootstrapTypedIr) -> RuntimeError {
    if (!bootstrap_ir_storage_is_valid(ir)) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError = std_byte_buffer_release(ir.globals);
    let global_bytes_error: RuntimeError = std_byte_buffer_release(ir.global_bytes);
    if (error == RuntimeError.none) {
        error = global_bytes_error;
    }
    let function_error: RuntimeError = std_byte_buffer_release(ir.functions);
    if (error == RuntimeError.none) {
        error = function_error;
    }
    let parameter_error: RuntimeError = std_byte_buffer_release(ir.parameters);
    if (error == RuntimeError.none) {
        error = parameter_error;
    }
    let slot_error: RuntimeError = std_byte_buffer_release(ir.slots);
    if (error == RuntimeError.none) {
        error = slot_error;
    }
    let value_error: RuntimeError = std_byte_buffer_release(ir.values);
    if (error == RuntimeError.none) {
        error = value_error;
    }
    let block_error: RuntimeError = std_byte_buffer_release(ir.blocks);
    if (error == RuntimeError.none) {
        error = block_error;
    }
    let instruction_error: RuntimeError = std_byte_buffer_release(ir.instructions);
    if (error == RuntimeError.none) {
        error = instruction_error;
    }
    let argument_error: RuntimeError = std_byte_buffer_release(ir.arguments);
    if (error == RuntimeError.none) {
        error = argument_error;
    }
    return error;
}

