export module luna.bootstrap.middleend.ir;

import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.bytes as bytes;

export enum Linkage: usize {
    internal, module_export, module_import, external_c,
}

export enum Opcode: usize {
    invalid, constant_integer, constant_float, constant_boolean, constant_null, address_of_slot, member_address,
    global_address, zero_slot, memory_copy, load, store, load_indirect, store_indirect, null_check, bounds_check,
    pointer_offset, unary_integer, unary_float, boolean_not, convert, binary_integer, binary_float, compare, call,
    call_indirect, function_address, jump, branch, return_value, return_void, unreachable, float_sqrt, float_min,
    float_max, overflow_flag, va_list_start, va_list_arg,
}

export struct Global {
    byte_offset: usize;
    byte_count: usize;
    alignment_bytes: usize;
    read_only: bool;
}

export struct Function {
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    linkage: Linkage;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
    first_slot: usize;
    slot_count: usize;
    first_block: usize;
    block_count: usize;
    first_value: usize;
    value_count: usize;
    has_body: bool;
    // Variadic (`...`) callees accept call-site arguments beyond the named
    // parameters; the call site classifies and passes them per the ABI. A
    // variadic function with a body saves the argument registers in its
    // prologue so va_start/va_arg can walk the extras.
    variadic: bool;
    // @export_name override: token of the validated string literal in
    // export_name_unit, both no-id when absent. The symbol is emitted
    // verbatim, bypassing the module-fingerprint _L mangling by design.
    export_name_unit: usize;
    export_name_token: usize;
    // asm fn: the body string_expression syntax node in asm_body_unit,
    // both no-id for ordinary functions. The backend splices the decoded
    // string literals after the label and emits no prologue, epilogue or
    // ret; such a function has has_body set but no blocks or values.
    asm_body_unit: usize;
    asm_body_node: usize;
}

export struct Parameter {
    function_id: usize;
    type_id: usize;
    slot_id: usize;
    name_token: usize;
}

export struct Slot {
    function_id: usize;
    type_id: usize;
    // Raised slot alignment from @align, zero means natural alignment.
    alignment_bytes: usize;
    mutable_binding: bool;
    // A volatile slot's loads and stores are observable memory accesses: a
    // future optimizer must never elide, coalesce or reorder them.
    volatile_binding: bool;
}

export struct Value {
    function_id: usize;
    block_id: usize;
    type_id: usize;
    definition: usize;
}

export struct Block {
    function_id: usize;
    first_instruction: usize;
    last_instruction: usize;
    instruction_count: usize;
    predecessor_count: usize;
    terminated: bool;
}

export struct Instruction {
    opcode: Opcode;
    operation: lexer::TokenKind;
    type_id: usize;
    result: usize;
    left: usize;
    right: usize;
    third: usize;
    auxiliary: usize;
    immediate: u64;
    floating: f64;
    block_id: usize;
    next_instruction: usize;
    span: lexer::SourceSpan;
}

export struct Argument {
    instruction_id: usize;
    value_id: usize;
}

export struct Store {
    globals: bytes::Buffer;
    global_count: usize;
    global_bytes: bytes::Buffer;
    functions: bytes::Buffer;
    function_count: usize;
    parameters: bytes::Buffer;
    parameter_count: usize;
    slots: bytes::Buffer;
    slot_count: usize;
    values: bytes::Buffer;
    value_count: usize;
    blocks: bytes::Buffer;
    block_count: usize;
    instructions: bytes::Buffer;
    instruction_count: usize;
    arguments: bytes::Buffer;
    argument_count: usize;
    entry_function: usize;
    error: runtime::Error;
}

export struct FunctionResult {
    function: Function;
    error: runtime::Error;
}

export struct BlockResult {
    block: Block;
    error: runtime::Error;
}

export struct InstructionResult {
    instruction: Instruction;
    error: runtime::Error;
}

export fn no_id() -> usize;
export fn empty() -> Store;
export fn storage_is_valid(ir: Store) -> bool;
export fn is_valid(ir: Store, types: type_info::Table) -> bool;
export fn get_function(ir: Store, function_id: usize) -> FunctionResult;
export fn get_block(ir: Store, block_id: usize) -> BlockResult;
export fn get_instruction(ir: Store, instruction_id: usize) -> InstructionResult;
export fn add_global(
    ir: *Store, bytes: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize;
export fn add_function(ir: *Store, function: Function) -> usize;
export fn add_parameter(
    ir: *Store, function_id: usize, type_id: usize, name_token: usize) -> usize;
export fn add_slot(
    ir: *Store, function_id: usize, type_id: usize, mutable_binding: bool,
    volatile_binding: bool, alignment_bytes: usize) -> usize;
export fn add_block(ir: *Store, function_id: usize) -> usize;
export fn add_value(ir: *Store, function_id: usize, block_id: usize, type_id: usize) -> usize;
export fn emit(ir: *Store, instruction: Instruction) -> usize;
export fn add_argument(ir: *Store, instruction_id: usize, value_id: usize) -> bool;
export fn set_entry(ir: *Store, function_id: usize) -> bool;
export fn release(ir: Store) -> runtime::Error;

