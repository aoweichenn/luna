export module luna.bootstrap.middleend.ir;

import luna.bootstrap.frontend.lexer;
import luna.bootstrap.middleend.type;
import luna.runtime;
import luna.std.bytes;

export enum BootstrapIrLinkage: usize {
    internal, module_export, module_import, external_c,
}

export enum BootstrapIrOpcode: usize {
    invalid, constant_integer, constant_float, constant_boolean, constant_null, address_of_slot, member_address,
    global_address, zero_slot, memory_copy, load, store, load_indirect, store_indirect, null_check, bounds_check,
    pointer_offset, unary_integer, unary_float, boolean_not, convert, binary_integer, binary_float, compare, call,
    call_indirect, function_address, jump, branch, return_value, return_void, unreachable, float_sqrt, float_min,
    float_max, overflow_flag, va_list_start, va_list_arg,
}

export struct BootstrapIrGlobal {
    byte_offset: usize;
    byte_count: usize;
    alignment_bytes: usize;
    read_only: bool;
}

export struct BootstrapIrFunction {
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    linkage: BootstrapIrLinkage;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
    first_slot: usize;
    slot_count: usize;
    first_block: usize;
    block_count: usize;
    first_value: usize;
    value_count: usize;
    has_body: bool;
    // Variadic (`...`) callees accept call-site arguments beyond the named
    // parameters; the call site classifies and passes them per the ABI. A
    // variadic function with a body saves the argument registers in its
    // prologue so va_start/va_arg can walk the extras.
    variadic: bool;
    // @export_name override: token of the validated string literal in
    // export_name_unit, both no-id when absent. The symbol is emitted
    // verbatim, bypassing the module-fingerprint _L mangling by design.
    export_name_unit: usize;
    export_name_token: usize;
    // asm fn: the body string_expression syntax node in asm_body_unit,
    // both no-id for ordinary functions. The backend splices the decoded
    // string literals after the label and emits no prologue, epilogue or
    // ret; such a function has has_body set but no blocks or values.
    asm_body_unit: usize;
    asm_body_node: usize;
}

export struct BootstrapIrParameter {
    function_id: usize;
    type_id: usize;
    slot_id: usize;
    name_token: usize;
}

export struct BootstrapIrSlot {
    function_id: usize;
    type_id: usize;
    // Raised slot alignment from @align, zero means natural alignment.
    alignment_bytes: usize;
    mutable_binding: bool;
    // A volatile slot's loads and stores are observable memory accesses: a
    // future optimizer must never elide, coalesce or reorder them.
    volatile_binding: bool;
}

export struct BootstrapIrValue {
    function_id: usize;
    block_id: usize;
    type_id: usize;
    definition: usize;
}

export struct BootstrapIrBlock {
    function_id: usize;
    first_instruction: usize;
    last_instruction: usize;
    instruction_count: usize;
    predecessor_count: usize;
    terminated: bool;
}

export struct BootstrapIrInstruction {
    opcode: BootstrapIrOpcode;
    operation: BootstrapTokenKind;
    type_id: usize;
    result: usize;
    left: usize;
    right: usize;
    third: usize;
    auxiliary: usize;
    immediate: u64;
    floating: f64;
    block_id: usize;
    next_instruction: usize;
    span: BootstrapSourceSpan;
}

export struct BootstrapIrArgument {
    instruction_id: usize;
    value_id: usize;
}

export struct BootstrapTypedIr {
    globals: bytes::Buffer;
    global_count: usize;
    global_bytes: bytes::Buffer;
    functions: bytes::Buffer;
    function_count: usize;
    parameters: bytes::Buffer;
    parameter_count: usize;
    slots: bytes::Buffer;
    slot_count: usize;
    values: bytes::Buffer;
    value_count: usize;
    blocks: bytes::Buffer;
    block_count: usize;
    instructions: bytes::Buffer;
    instruction_count: usize;
    arguments: bytes::Buffer;
    argument_count: usize;
    entry_function: usize;
    error: runtime::Error;
}

export struct BootstrapIrFunctionResult {
    function: BootstrapIrFunction;
    error: runtime::Error;
}

export struct BootstrapIrBlockResult {
    block: BootstrapIrBlock;
    error: runtime::Error;
}

export struct BootstrapIrInstructionResult {
    instruction: BootstrapIrInstruction;
    error: runtime::Error;
}

export fn bootstrap_ir_no_id() -> usize;
export fn bootstrap_ir_empty() -> BootstrapTypedIr;
export fn bootstrap_ir_storage_is_valid(ir: BootstrapTypedIr) -> bool;
export fn bootstrap_ir_is_valid(ir: BootstrapTypedIr, types: BootstrapTypeTable) -> bool;
export fn bootstrap_ir_get_function(ir: BootstrapTypedIr, function_id: usize) -> BootstrapIrFunctionResult;
export fn bootstrap_ir_get_block(ir: BootstrapTypedIr, block_id: usize) -> BootstrapIrBlockResult;
export fn bootstrap_ir_get_instruction(ir: BootstrapTypedIr, instruction_id: usize) -> BootstrapIrInstructionResult;
export fn bootstrap_ir_add_global(
    ir: *BootstrapTypedIr, bytes: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize;
export fn bootstrap_ir_add_function(ir: *BootstrapTypedIr, function: BootstrapIrFunction) -> usize;
export fn bootstrap_ir_add_parameter(
    ir: *BootstrapTypedIr, function_id: usize, type_id: usize, name_token: usize) -> usize;
export fn bootstrap_ir_add_slot(
    ir: *BootstrapTypedIr, function_id: usize, type_id: usize, mutable_binding: bool,
    volatile_binding: bool, alignment_bytes: usize) -> usize;
export fn bootstrap_ir_add_block(ir: *BootstrapTypedIr, function_id: usize) -> usize;
export fn bootstrap_ir_add_value(ir: *BootstrapTypedIr, function_id: usize, block_id: usize, type_id: usize) -> usize;
export fn bootstrap_ir_emit(ir: *BootstrapTypedIr, instruction: BootstrapIrInstruction) -> usize;
export fn bootstrap_ir_add_argument(ir: *BootstrapTypedIr, instruction_id: usize, value_id: usize) -> bool;
export fn bootstrap_ir_set_entry(ir: *BootstrapTypedIr, function_id: usize) -> bool;
export fn bootstrap_ir_release(ir: BootstrapTypedIr) -> runtime::Error;

