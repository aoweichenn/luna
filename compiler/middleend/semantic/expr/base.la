module luna.bootstrap.middleend.semantic.expr.base;

fn invalid_expression()
    -> context::Expression {
    let none: usize = context::no_id();
    return {
        type_id = none, value_id = none, address_id = none, constant_value = 0, has_constant = false, lvalue = false,
        mutable_lvalue = false, volatile_lvalue = false, valid = false, bitfield_segment = context::no_id(),
    };
}

