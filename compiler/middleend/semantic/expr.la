module luna.bootstrap.middleend.semantic.expr;


fn invalid_expression()
    -> context::Expression {
    let none: usize = context::no_id();
    return {
        type_id = none,
        value_id = none,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = false,
        bitfield_segment = context::no_id(),
    };
}

fn type_for_integer_literal(
    context: *context::Context,
    expected_type: usize
) -> usize {
    if (expected_type < context->types.type_count) {
        let record: type_info::Record =
            context::type_record(
                context,
                expected_type
            );
        if (type_info::is_integer(record.kind)) {
            return expected_type;
        }
    }
    return type_info::BuiltinType.signed_32 as usize;
}

fn lower_integer_literal(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    var value: u64 = 0;
    let type_id: usize =
        type_for_integer_literal(
            context,
            expected_type
        );
    let kind: type_info::Kind =
        context::type_record(
            context,
            type_id
        ).kind;
    if (!context::parse_unsigned(
            context,
            context->current_unit,
            node.token_index,
            &value
        ) ||
        !context::integer_fits_type(
            kind,
            value,
            false
        )) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.integer_overflow,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    return context::emit_integer_constant(
        context,
        node,
        type_id,
        context::mask_integer(
            value,
            type_info::bit_width(kind)
        )
    );
}

fn lower_character_literal(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    var value: u64 = 0;
    if (!context::decode_character(
            context,
            context->current_unit,
            node.token_index,
            &value
        )) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_character,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            0
        );
        return invalid_expression();
    }
    let type_id: usize =
        type_for_integer_literal(
            context,
            expected_type
        );
    let kind: type_info::Kind =
        context::type_record(
            context,
            type_id
        ).kind;
    if (!context::integer_fits_type(
            kind,
            value,
            false
        )) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.integer_overflow,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    return context::emit_integer_constant(
        context,
        node,
        type_id,
        context::mask_integer(
            value,
            type_info::bit_width(kind)
        )
    );
}

fn lower_negative_integer_literal(
    context: *context::Context,
    unary_node: parser::SyntaxNode,
    literal_node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    var magnitude: u64 = 0;
    let type_id: usize =
        type_for_integer_literal(
            context,
            expected_type
        );
    let kind: type_info::Kind =
        context::type_record(
            context,
            type_id
        ).kind;
    if (!context::parse_unsigned(
            context,
            context->current_unit,
            literal_node.token_index,
            &magnitude
        ) ||
        !context::integer_fits_type(
            kind,
            magnitude,
            true
        )) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.integer_overflow,
            context->current_unit,
            unary_node.span,
            context::no_id(),
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    return context::emit_integer_constant(
        context,
        unary_node,
        type_id,
        context::mask_integer(
            0 - magnitude,
            type_info::bit_width(kind)
        )
    );
}

fn big_set(
    value: *context::BigUnsigned,
    small: u64
) -> bool {
    if (value == null) {
        return false;
    }
    value->count = small == 0 ? 0 : 1;
    value->limbs[0] = small;
    return true;
}

fn big_copy(
    destination: *context::BigUnsigned,
    source: *const context::BigUnsigned
) -> bool {
    if (destination == null || source == null ||
        source->count >
            context::Limit.maximum_floating_limbs as usize) {
        return false;
    }
    destination->count = source->count;
    var index: usize = 0;
    while (index < source->count) {
        destination->limbs[index] = source->limbs[index];
        index += 1;
    }
    return true;
}

fn big_multiply_small(
    value: *context::BigUnsigned,
    factor: u64
) -> bool {
    if (value == null || factor > 10 ||
        value->count >
            context::Limit.maximum_floating_limbs as usize) {
        return false;
    }
    if (factor == 0) {
        value->count = 0;
        return true;
    }
    let half_mask: u64 = 4294967295;
    var carry: u64 = 0;
    var index: usize = 0;
    while (index < value->count) {
        let limb: u64 = value->limbs[index];
        let lower_product: u64 =
            (limb & half_mask) * factor + carry;
        let upper_product: u64 =
            (limb >> 32) * factor +
                (lower_product >> 32);
        value->limbs[index] =
            (upper_product << 32) |
                (lower_product & half_mask);
        carry = upper_product >> 32;
        index += 1;
    }
    if (carry != 0) {
        if (value->count >=
            context::Limit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn big_add_small(
    value: *context::BigUnsigned,
    small: u64
) -> bool {
    if (value == null || small > 9 ||
        value->count >
            context::Limit.maximum_floating_limbs as usize) {
        return false;
    }
    var carry: u64 = small;
    var index: usize = 0;
    while (carry != 0 && index < value->count) {
        let original: u64 = value->limbs[index];
        let sum: u64 = original + carry;
        value->limbs[index] = sum;
        carry = sum < original ? 1 : 0;
        index += 1;
    }
    if (carry != 0) {
        if (value->count >=
            context::Limit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn big_add(
    value: *context::BigUnsigned,
    added: *const context::BigUnsigned
) -> bool {
    if (value == null || added == null ||
        value->count >
            context::Limit.maximum_floating_limbs as usize ||
        added->count >
            context::Limit.maximum_floating_limbs as usize) {
        return false;
    }
    let maximum_count: usize =
        value->count > added->count ?
            value->count : added->count;
    var carry: u64 = 0;
    var index: usize = 0;
    while (index < maximum_count) {
        let left: u64 =
            index < value->count ? value->limbs[index] : 0;
        let right: u64 =
            index < added->count ? added->limbs[index] : 0;
        let partial: u64 = left + right;
        let partial_overflow: bool = partial < left;
        let sum: u64 = partial + carry;
        let carry_overflow: bool = sum < partial;
        value->limbs[index] = sum;
        carry =
            partial_overflow || carry_overflow ? 1 : 0;
        index += 1;
    }
    value->count = maximum_count;
    if (carry != 0) {
        if (value->count >=
            context::Limit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn big_shift_left_one(
    value: *context::BigUnsigned
) -> bool {
    if (value == null ||
        value->count >
            context::Limit.maximum_floating_limbs as usize) {
        return false;
    }
    var carry: u64 = 0;
    var index: usize = 0;
    while (index < value->count) {
        let limb: u64 = value->limbs[index];
        value->limbs[index] = (limb << 1) | carry;
        carry = limb >> 63;
        index += 1;
    }
    if (carry != 0) {
        if (value->count >=
            context::Limit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn big_multiply_u64(
    source: *const context::BigUnsigned,
    multiplier: u64,
    result: *context::BigUnsigned
) -> bool {
    if (source == null || result == null ||
        !big_set(result, 0)) {
        return false;
    }
    if (multiplier == 0 || source->count == 0) {
        return true;
    }
    var addend: context::BigUnsigned = {};
    if (!big_copy(&addend, source)) {
        return false;
    }
    var remaining: u64 = multiplier;
    while (remaining != 0) {
        if ((remaining & 1) != 0 &&
            !big_add(
                result,
                (&addend) as
                    *const context::BigUnsigned
            )) {
            return false;
        }
        remaining >>= 1;
        if (remaining != 0 &&
            !big_shift_left_one(&addend)) {
            return false;
        }
    }
    return true;
}

fn big_bit_length(
    value: *const context::BigUnsigned
) -> usize {
    if (value == null || value->count == 0 ||
        value->count >
            context::Limit.maximum_floating_limbs as usize) {
        return 0;
    }
    var highest: u64 = value->limbs[value->count - 1];
    var highest_bits: usize = 0;
    while (highest != 0) {
        highest >>= 1;
        highest_bits += 1;
    }
    return (value->count - 1) * 64 + highest_bits;
}

fn big_bit(
    value: *const context::BigUnsigned,
    bit_index: usize
) -> bool {
    if (value == null ||
        bit_index / 64 >= value->count) {
        return false;
    }
    return ((value->limbs[bit_index / 64] >>
        ((bit_index % 64) as u64)) & 1) != 0;
}

fn big_compare_scaled(
    left: *const context::BigUnsigned,
    left_exponent: isize,
    right: *const context::BigUnsigned,
    right_exponent: isize
) -> i32 {
    let left_length: usize =
        big_bit_length(left);
    let right_length: usize =
        big_bit_length(right);
    if (left_length == 0 || right_length == 0) {
        if (left_length == right_length) {
            return 0;
        }
        return left_length == 0 ? -1 : 1;
    }
    let left_top: isize =
        (left_length - 1) as isize + left_exponent;
    let right_top: isize =
        (right_length - 1) as isize + right_exponent;
    if (left_top != right_top) {
        return left_top < right_top ? -1 : 1;
    }
    let minimum_position: isize =
        left_exponent < right_exponent ?
            left_exponent : right_exponent;
    var position: isize = left_top;
    while (position >= minimum_position) {
        var left_bit: bool = false;
        if (position >= left_exponent) {
            left_bit = big_bit(
                left,
                (position - left_exponent) as usize
            );
        }
        var right_bit: bool = false;
        if (position >= right_exponent) {
            right_bit = big_bit(
                right,
                (position - right_exponent) as usize
            );
        }
        if (left_bit != right_bit) {
            return left_bit ? 1 : -1;
        }
        if (position == minimum_position) {
            break;
        }
        position -= 1;
    }
    return 0;
}

fn signed_add(
    left: *const context::SignedMagnitude,
    right: *const context::SignedMagnitude,
    limit: usize,
    result: *context::SignedMagnitude
) -> bool {
    if (left == null || right == null || result == null ||
        left->magnitude > limit ||
        right->magnitude > limit) {
        return false;
    }
    if (left->magnitude == 0) {
        *result = {
            magnitude = right->magnitude,
            negative =
                right->magnitude != 0 && right->negative,
        };
        return true;
    }
    if (right->magnitude == 0) {
        *result = *left;
        return true;
    }
    if (left->negative == right->negative) {
        let magnitude: usize =
            left->magnitude > limit - right->magnitude ?
                limit : left->magnitude + right->magnitude;
        *result = {
            magnitude = magnitude,
            negative = left->negative,
        };
        return true;
    }
    if (left->magnitude >= right->magnitude) {
        let magnitude: usize =
            left->magnitude - right->magnitude;
        *result = {
            magnitude = magnitude,
            negative = magnitude != 0 && left->negative,
        };
        return true;
    }
    *result = {
        magnitude = right->magnitude - left->magnitude,
        negative = right->negative,
    };
    return true;
}

fn float_components(
    bits: u64,
    single: bool,
    significand: *u64,
    binary_exponent: *isize
) -> bool {
    if (significand == null || binary_exponent == null) {
        return false;
    }
    if (single) {
        let fraction: u64 = bits & 8388607;
        let exponent_field: u64 = (bits >> 23) & 255;
        *significand =
            exponent_field == 0 ?
                fraction : 8388608 + fraction;
        *binary_exponent =
            exponent_field == 0 ?
                -149 : exponent_field as isize - 150;
        return true;
    }
    let fraction: u64 = bits & 4503599627370495;
    let exponent_field: u64 = (bits >> 52) & 2047;
    *significand =
        exponent_field == 0 ?
            fraction : 4503599627370496 + fraction;
    *binary_exponent =
        exponent_field == 0 ?
            -1074 : exponent_field as isize - 1075;
    return true;
}

fn compare_decimal_dyadic(
    decimal: *const context::DecimalFloating,
    significand: u64,
    binary_exponent: isize,
    result: *i32
) -> bool {
    var candidate: context::BigUnsigned = {};
    if (decimal == null || result == null) {
        return false;
    }
    var comparison: i32 = 0;
    if (decimal->decimal_exponent >= 0) {
        if (!big_set(
                &candidate,
                significand
            )) {
            return false;
        }
        comparison = big_compare_scaled(
            &decimal->coefficient,
            decimal->decimal_exponent,
            (&candidate) as
                *const context::BigUnsigned,
            binary_exponent
        );
    } else {
        if (!big_multiply_u64(
                &decimal->five_power,
                significand,
                &candidate
            )) {
            return false;
        }
        comparison = big_compare_scaled(
            &decimal->coefficient,
            0,
            (&candidate) as
                *const context::BigUnsigned,
            binary_exponent -
                decimal->decimal_exponent
        );
    }
    if (comparison == 0 && decimal->truncated_nonzero) {
        comparison = 1;
    }
    *result = comparison;
    return true;
}

fn compare_decimal_float(
    decimal: *const context::DecimalFloating,
    bits: u64,
    single: bool,
    result: *i32
) -> bool {
    var significand: u64 = 0;
    var binary_exponent: isize = 0;
    if (!float_components(
            bits,
            single,
            &significand,
            &binary_exponent
        )) {
        return false;
    }
    return compare_decimal_dyadic(
        decimal,
        significand,
        binary_exponent,
        result
    );
}

fn prepare_decimal_floating(
    context: *context::Context,
    node: parser::SyntaxNode,
    single: bool,
    decimal: *context::DecimalFloating,
    zero: *bool
) -> bool {
    let unit: *const context::Unit =
        context::input_unit(
            context,
            context->current_unit
        );
    let token: lexer::Token = context::token(
        context,
        context->current_unit,
        node.token_index
    );
    if (decimal == null || zero == null ||
        token.kind != lexer::TokenKind.floating) {
        return false;
    }
    let maximum: usize = context::no_id();
    var exponent_limit: usize = maximum;
    if (token.span.length <=
        maximum -
            (context::Limit.floating_exponent_margin as usize)) {
        exponent_limit = token.span.length +
            (context::Limit.floating_exponent_margin as usize);
    }
    var coefficient: context::BigUnsigned = {};
    var significant_digits: usize = 0;
    var kept_digits: usize = 0;
    var fractional_digits: usize = 0;
    var exponent_magnitude: usize = 0;
    var exponent_negative: bool = false;
    var truncated_nonzero: bool = false;
    var seen_nonzero: bool = false;
    var after_decimal: bool = false;
    var in_exponent: bool = false;
    var index: usize = 0;
    while (index < token.span.length) {
        let byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte == 95) {
            index += 1;
            continue;
        }
        if (byte == 46) {
            after_decimal = true;
            index += 1;
            continue;
        }
        if (byte == 101 || byte == 69) {
            in_exponent = true;
            index += 1;
            if (index < token.span.length) {
                let sign: u8 =
                    unit->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    exponent_negative = sign == 45;
                    index += 1;
                }
            }
            continue;
        }
        if (byte < 48 || byte > 57) {
            return false;
        }
        let digit: usize = (byte - 48) as usize;
        if (in_exponent) {
            if (exponent_magnitude >
                (exponent_limit - digit) / 10) {
                exponent_magnitude = exponent_limit;
            } else {
                exponent_magnitude =
                    exponent_magnitude * 10 + digit;
            }
            index += 1;
            continue;
        }
        if (after_decimal) {
            if (fractional_digits == maximum) {
                return false;
            }
            fractional_digits += 1;
        }
        if (!seen_nonzero && digit == 0) {
            index += 1;
            continue;
        }
        seen_nonzero = true;
        if (significant_digits == maximum) {
            return false;
        }
        significant_digits += 1;
        if (kept_digits <
            context::Limit.maximum_floating_digits as usize) {
            if (!big_multiply_small(
                    &coefficient,
                    10
                ) ||
                !big_add_small(
                    &coefficient,
                    digit as u64
                )) {
                return false;
            }
            kept_digits += 1;
        } else if (digit != 0) {
            truncated_nonzero = true;
        }
        index += 1;
    }
    if (!seen_nonzero) {
        *zero = true;
        return true;
    }
    if (fractional_digits == maximum) {
        return false;
    }
    let fractional_with_unit: usize =
        fractional_digits + 1;
    let digit_adjustment: context::SignedMagnitude =
        significant_digits >= fractional_with_unit ?
            {
                magnitude =
                    significant_digits - fractional_with_unit,
                negative = false,
            } :
            {
                magnitude =
                    fractional_with_unit - significant_digits,
                negative = true,
            };
    let explicit_exponent: context::SignedMagnitude = {
        magnitude = exponent_magnitude,
        negative =
            exponent_magnitude != 0 && exponent_negative,
    };
    var adjusted: context::SignedMagnitude = {};
    if (!signed_add(
            (&explicit_exponent) as
                *const context::SignedMagnitude,
            (&digit_adjustment) as
                *const context::SignedMagnitude,
            exponent_limit,
            &adjusted
        )) {
        return false;
    }
    let maximum_adjusted: usize = single ? 38 : 308;
    let minimum_adjusted_magnitude: usize =
        single ? 46 : 324;
    if (!adjusted.negative &&
        adjusted.magnitude > maximum_adjusted) {
        return false;
    }
    if (adjusted.negative &&
        adjusted.magnitude >
            minimum_adjusted_magnitude) {
        *zero = true;
        return true;
    }
    let adjusted_exponent: isize =
        adjusted.negative ?
            0 - adjusted.magnitude as isize :
            adjusted.magnitude as isize;
    decimal->coefficient = coefficient;
    decimal->decimal_exponent =
        adjusted_exponent - kept_digits as isize + 1;
    decimal->truncated_nonzero = truncated_nonzero;
    big_set(&decimal->five_power, 1);
    if (decimal->decimal_exponent >= 0) {
        var power: isize = decimal->decimal_exponent;
        while (power > 0) {
            if (!big_multiply_small(
                    &decimal->coefficient,
                    5
                )) {
                return false;
            }
            power -= 1;
        }
    } else {
        var power: isize =
            0 - decimal->decimal_exponent;
        while (power > 0) {
            if (!big_multiply_small(
                    &decimal->five_power,
                    5
                )) {
                return false;
            }
            power -= 1;
        }
    }
    *zero = false;
    return true;
}

// Rounds `mantissa` (a binary fraction numerator) to the quantum implied by
// `shift`: kept = mantissa / 2^shift, ties to even, with `sticky` recording
// any value already lost below the mantissa's least significant bit.
fn round_hex_mantissa(
    mantissa: u64,
    shift: i64,
    sticky: bool
) -> u64 {
    if (shift <= 0) {
        return mantissa << (((0 as i64) - shift) as u64);
    }
    if (shift > 64) {
        return 0;
    }
    let amount: u64 = shift as u64;
    var kept: u64 = 0;
    var round_bit: u64 = 0;
    var below: bool = false;
    if (amount == 64) {
        round_bit = mantissa >> 63;
        below = (mantissa & 9223372036854775807) != 0;
    } else {
        kept = mantissa >> amount;
        round_bit = (mantissa >> (amount - 1)) & 1;
        if (amount >= 2) {
            below = (mantissa & (((1 as u64) << (amount - 1)) - 1)) != 0;
        }
    }
    if (round_bit == 1 && (sticky || below || (kept & 1) == 1)) {
        kept += 1;
    }
    return kept;
}

// Hexadecimal floating literals are exact binary fractions by construction,
// so parsing accumulates the mantissa into a 64-bit significand (extra bits
// fold into a sticky flag) and rounds directly at the target precision with
// no decimal round-trip.
fn parse_hex_floating_bits(
    context: *context::Context,
    node: parser::SyntaxNode,
    single: bool,
    bits: *u64
) -> bool {
    let unit: *const context::Unit =
        context::input_unit(
            context,
            context->current_unit
        );
    let token: lexer::Token = context::token(
        context,
        context->current_unit,
        node.token_index
    );
    if (bits == null || token.span.length < 4) {
        return false;
    }
    var mantissa: u64 = 0;
    var exponent: i64 = 0;
    var exponent_value: i64 = 0;
    var exponent_negative: bool = false;
    var sticky: bool = false;
    var after_dot: bool = false;
    var in_exponent: bool = false;
    var index: usize = 2;
    while (index < token.span.length) {
        let byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte == 95) {
            index += 1;
            continue;
        }
        if (byte == 46 && !in_exponent) {
            after_dot = true;
            index += 1;
            continue;
        }
        if ((byte == 112 || byte == 80) && !in_exponent) {
            in_exponent = true;
            index += 1;
            if (index < token.span.length) {
                let sign: u8 =
                    unit->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    exponent_negative = sign == 45;
                    index += 1;
                }
            }
            continue;
        }
        if (in_exponent) {
            if (byte < 48 || byte > 57) {
                return false;
            }
            if (exponent_value <= 100000) {
                exponent_value =
                    exponent_value * 10 + (byte - 48) as i64;
            }
            index += 1;
            continue;
        }
        let digit: usize = decode_hex(byte);
        if (digit == context::no_id()) {
            return false;
        }
        if (mantissa == 0 && digit == 0) {
            if (after_dot) {
                exponent -= 4;
            }
            index += 1;
            continue;
        }
        if (mantissa > (18446744073709551615 - 15) / 16) {
            if (digit != 0) {
                sticky = true;
            }
            if (!after_dot) {
                exponent += 4;
            }
            index += 1;
            continue;
        }
        mantissa = mantissa * 16 + digit as u64;
        if (after_dot) {
            exponent -= 4;
        }
        index += 1;
    }
    if (exponent_negative) {
        exponent_value = (0 as i64) - exponent_value;
    }
    exponent += exponent_value;
    if (mantissa == 0) {
        *bits = 0;
        return true;
    }
    var top: usize = 63;
    while (top > 0 && (mantissa >> (top as u64)) == 0) {
        top -= 1;
    }
    let precision: i64 = single ? 24 : 53;
    let exponent_maximum: i64 = single ? 127 : 1023;
    let exponent_minimum: i64 = single ? 0 - 126 : 0 - 1022;
    let bias: i64 = single ? 127 : 1023;
    var value_exponent: i64 = exponent + top as i64;
    if (value_exponent > exponent_maximum) {
        return false;
    }
    var kept: u64 = 0;
    if (value_exponent >= exponent_minimum) {
        kept = round_hex_mantissa(
            mantissa,
            top as i64 - (precision - 1),
            sticky
        );
        if ((kept >> (precision as u64)) != 0) {
            kept = kept >> 1;
            value_exponent += 1;
            if (value_exponent > exponent_maximum) {
                return false;
            }
        }
        *bits = ((value_exponent + bias) as u64 <<
            ((precision - 1) as u64)) |
            (kept & (((1 as u64) << ((precision - 1) as u64)) - 1));
        return true;
    }
    kept = round_hex_mantissa(
        mantissa,
        exponent_minimum - (precision - 1) - exponent,
        sticky
    );
    *bits = kept;
    return true;
}

fn parse_floating_bits(
    context: *context::Context,
    node: parser::SyntaxNode,
    single: bool,
    bits: *u64
) -> bool {
    if (bits == null) {
        return false;
    }
    let unit: *const context::Unit =
        context::input_unit(
            context,
            context->current_unit
        );
    let token: lexer::Token = context::token(
        context,
        context->current_unit,
        node.token_index
    );
    if (token.span.length >= 2 &&
        unit->source.data[token.span.offset] == 48 &&
        (unit->source.data[token.span.offset + 1] == 120 ||
            unit->source.data[token.span.offset + 1] == 88)) {
        return parse_hex_floating_bits(
            context,
            node,
            single,
            bits
        );
    }
    var decimal: context::DecimalFloating = {};
    var zero: bool = false;
    if (!prepare_decimal_floating(
            context,
            node,
            single,
            &decimal,
            &zero
        )) {
        return false;
    }
    if (zero) {
        *bits = 0;
        return true;
    }
    let maximum_bits: u64 =
        single ? 2139095039 : 9218868437227405311;
    var lower: u64 = 0;
    var upper: u64 = maximum_bits;
    while (lower < upper) {
        let middle: u64 =
            lower + (upper - lower) / 2 + 1;
        var comparison: i32 = 0;
        if (!compare_decimal_float(
                (&decimal) as
                    *const context::DecimalFloating,
                middle,
                single,
                &comparison
            )) {
            return false;
        }
        if (comparison >= 0) {
            lower = middle;
        } else {
            upper = middle - 1;
        }
    }
    var lower_significand: u64 = 0;
    var lower_exponent: isize = 0;
    if (!float_components(
            lower,
            single,
            &lower_significand,
            &lower_exponent
        )) {
        return false;
    }
    let midpoint_significand: u64 =
        lower_significand * 2 + 1;
    var midpoint_comparison: i32 = 0;
    if (!compare_decimal_dyadic(
            (&decimal) as
                *const context::DecimalFloating,
            midpoint_significand,
            lower_exponent - 1,
            &midpoint_comparison
        )) {
        return false;
    }
    if (lower == maximum_bits) {
        if (midpoint_comparison >= 0) {
            return false;
        }
        *bits = lower;
        return true;
    }
    if (midpoint_comparison < 0 ||
        (midpoint_comparison == 0 &&
            (lower & 1) == 0)) {
        *bits = lower;
    } else {
        *bits = lower + 1;
    }
    return true;
}

fn parse_floating(
    context: *context::Context,
    node: parser::SyntaxNode,
    single: bool,
    value: *f64
) -> bool {
    var bits: u64 = 0;
    if (value == null ||
        !parse_floating_bits(
            context,
            node,
            single,
            &bits
        )) {
        return false;
    }
    if (single) {
        let single_bits: u32 = bits as u32;
        *value =
            (*((&single_bits) as *const u32 as *const f32))
                as f64;
    } else {
        *value =
            *((&bits) as *const u64 as *const f64);
    }
    return true;
}

fn lower_floating_literal(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    var type_id: usize =
        type_info::BuiltinType.float_64 as usize;
    if (expected_type ==
        type_info::BuiltinType.float_32 as usize ||
        expected_type ==
        type_info::BuiltinType.float_64 as usize) {
        type_id = expected_type;
    }
    var value: f64 = 0.0;
    let single: bool =
        type_id == type_info::BuiltinType.float_32 as usize;
    if (!parse_floating(
            context,
            node,
            single,
            &value
        )) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.floating_overflow,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.constant_float,
            node
        );
    instruction.floating = value;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = context::no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
}

fn decode_hex(byte: u8) -> usize {
    if (byte >= 48 && byte <= 57) {
        return (byte - 48) as usize;
    }
    if (byte >= 65 && byte <= 70) {
        return (byte - 65 + 10) as usize;
    }
    if (byte >= 97 && byte <= 102) {
        return (byte - 97 + 10) as usize;
    }
    return context::no_id();
}

fn string_token_width(
    kind: lexer::TokenKind
) -> usize {
    if (kind == lexer::TokenKind.string_u16) {
        return 2;
    }
    if (kind == lexer::TokenKind.string_u32) {
        return 4;
    }
    return 1;
}

fn push_code_unit(
    context: *context::Context,
    decoded: *bytes::Buffer,
    value: usize,
    width: usize
) -> bool {
    var shift: usize = 0;
    while (shift < width * 8 &&
        context->error == runtime::Error.none) {
        let pushed: bytes::BufferResult =
            bytes::push(
                *decoded,
                ((value >> shift) & 255) as u8
            );
        *decoded = pushed.buffer;
        context->error = pushed.error;
        shift += 8;
    }
    return context->error == runtime::Error.none;
}

// Appends one code point to a decoded string buffer, encoded as UTF-8,
// UTF-16 (surrogate pairs above 0xFFFF) or UTF-32 per the unit width.
fn push_code_point(
    context: *context::Context,
    decoded: *bytes::Buffer,
    code_point: usize,
    width: usize
) -> bool {
    if (width == 4) {
        return push_code_unit(
            context, decoded, code_point, 4);
    }
    if (width == 2) {
        if (code_point < 65536) {
            return push_code_unit(
                context, decoded, code_point, 2);
        }
        let reduced: usize = code_point - 65536;
        return push_code_unit(
                context, decoded, 55296 + (reduced >> 10), 2) &&
            push_code_unit(
                context, decoded, 56320 + (reduced & 1023), 2);
    }
    if (code_point < 128) {
        return push_code_unit(
            context, decoded, code_point, 1);
    }
    if (code_point < 2048) {
        return push_code_unit(
                context, decoded, 192 + (code_point >> 6), 1) &&
            push_code_unit(
                context, decoded, 128 + (code_point & 63), 1);
    }
    if (code_point < 65536) {
        return push_code_unit(
                context, decoded, 224 + (code_point >> 12), 1) &&
            push_code_unit(
                context, decoded, 128 + ((code_point >> 6) & 63), 1) &&
            push_code_unit(
                context, decoded, 128 + (code_point & 63), 1);
    }
    return push_code_unit(
            context, decoded, 240 + (code_point >> 18), 1) &&
        push_code_unit(
            context, decoded, 128 + ((code_point >> 12) & 63), 1) &&
        push_code_unit(
            context, decoded, 128 + ((code_point >> 6) & 63), 1) &&
        push_code_unit(
            context, decoded, 128 + (code_point & 63), 1);
}

// Parses the braced hexadecimal code point of a \u{...} escape.
// escape_index points at the 'u' inside the token span; on success value
// receives the code point and last the index of the closing brace.
fn decode_unicode_escape(
    unit: *const context::Unit,
    token: lexer::Token,
    escape_index: usize,
    value: *usize,
    last: *usize
) -> bool {
    if (value == null || last == null ||
        escape_index + 2 >= token.span.length ||
        unit->source.data[
            token.span.offset + escape_index + 1
        ] != 123) {
        return false;
    }
    var code_point: usize = 0;
    var digits: usize = 0;
    var index: usize = escape_index + 2;
    while (index + 1 < token.span.length) {
        let digit: usize = decode_hex(
            unit->source.data[token.span.offset + index]
        );
        if (digit == context::no_id() || digits >= 6) {
            break;
        }
        code_point = code_point * 16 + digit;
        digits += 1;
        index += 1;
    }
    if (digits == 0 ||
        unit->source.data[token.span.offset + index] != 125) {
        return false;
    }
    if (code_point > 1114111 ||
        (code_point >= 55296 && code_point <= 57343)) {
        return false;
    }
    *value = code_point;
    *last = index;
    return true;
}

// Decodes one string literal token (width prefix and quotes included in
// the span) into code units of the literal's width. Raw non-ASCII source
// bytes pass through in u8 literals; u16/u32 literals UTF-8-decode them
// and re-encode (the lexer already validated the source as UTF-8).
fn decode_string_token(
    context: *context::Context,
    unit: *const context::Unit,
    token: lexer::Token,
    width: usize,
    decoded: *bytes::Buffer
) -> bool {
    var index: usize = width == 1 ? 1 : 4;
    while (index + 1 < token.span.length &&
        context->error == runtime::Error.none) {
        var byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte != 92 && byte < 128) {
            if (!push_code_unit(
                    context, decoded, byte as usize, width)) {
                return false;
            }
            index += 1;
            continue;
        }
        if (byte >= 128) {
            if (width == 1) {
                if (!push_code_unit(
                        context, decoded, byte as usize, 1)) {
                    return false;
                }
                index += 1;
                continue;
            }
            var code_point: usize = (byte & 31) as usize;
            var continuation: usize = 1;
            if (byte >= 240) {
                code_point = (byte & 7) as usize;
                continuation = 3;
            } else if (byte >= 224) {
                code_point = (byte & 15) as usize;
                continuation = 2;
            }
            var count: usize = 0;
            while (count < continuation &&
                index + 2 < token.span.length) {
                index += 1;
                code_point = (code_point << 6) +
                    (unit->source.data[
                        token.span.offset + index
                    ] & 63) as usize;
                count += 1;
            }
            if (!push_code_point(
                    context, decoded, code_point, width)) {
                return false;
            }
            index += 1;
            continue;
        }
        index += 1;
        byte = unit->source.data[token.span.offset + index];
        if (byte == 120) {
            let high: usize = decode_hex(
                unit->source.data[
                    token.span.offset + index + 1
                ]
            );
            let low: usize = decode_hex(
                unit->source.data[
                    token.span.offset + index + 2
                ]
            );
            if (!push_code_unit(
                    context, decoded, high * 16 + low, width)) {
                return false;
            }
            index += 3;
            continue;
        }
        if (byte == 117) {
            var escape_point: usize = 0;
            var last: usize = 0;
            if (!decode_unicode_escape(
                    unit, token, index, &escape_point, &last) ||
                !push_code_point(
                    context, decoded, escape_point, width)) {
                return false;
            }
            index = last + 1;
            continue;
        }
        if (byte == 110) {
            byte = 10;
        } else if (byte == 114) {
            byte = 13;
        } else if (byte == 116) {
            byte = 9;
        } else if (byte == 48) {
            byte = 0;
        }
        if (!push_code_unit(
                context, decoded, byte as usize, width)) {
            return false;
        }
        index += 1;
    }
    return context->error == runtime::Error.none;
}

// Decodes a string literal node (its own token plus adjacent concatenated parts) into raw code units
// of the literal's width, without any terminator. Shared by string literal lowering and @embed.
fn decode_string_literal(
    context: *context::Context,
    node: parser::SyntaxNode,
    width: usize,
    decoded: *bytes::Buffer
) -> bool {
    let unit: *const context::Unit =
        context::input_unit(
            context,
            context->current_unit
        );
    let token: lexer::Token = context::token(
        context,
        context->current_unit,
        node.token_index
    );
    var valid: bool = decode_string_token(
        context,
        unit,
        token,
        width,
        decoded
    );
    var child: usize = node.first_child;
    while (valid && child != context::no_id() &&
        context->error == runtime::Error.none) {
        let part: parser::SyntaxNode = context::node(
            context,
            context->current_unit,
            child
        );
        let part_token: lexer::Token = context::token(
            context,
            context->current_unit,
            part.token_index
        );
        if (part.kind != parser::SyntaxKind.string_expression ||
            part_token.kind != token.kind) {
            valid = false;
            break;
        }
        valid = decode_string_token(
            context,
            unit,
            part_token,
            width,
            decoded
        );
        child = part.next_sibling;
    }
    return valid && context->error == runtime::Error.none;
}

fn lower_string_literal(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let token: lexer::Token = context::token(
        context,
        context->current_unit,
        node.token_index
    );
    let width: usize =
        string_token_width(token.kind);
    var decoded: bytes::Buffer = bytes::empty();
    let valid: bool = decode_string_literal(
        context,
        node,
        width,
        &decoded
    );
    if (!valid) {
        let discard_error: runtime::Error =
            bytes::release(decoded);
        if (context->error == runtime::Error.none) {
            context->error = discard_error;
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_string,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                0
            );
        }
        return invalid_expression();
    }
    if (context->error == runtime::Error.none) {
        push_code_unit(
            context,
            &decoded,
            0,
            width
        );
    }
    let global_id: usize = context->error == runtime::Error.none ?
        ir::add_global(
            &context->ir,
            decoded.data as *const u8,
            decoded.length,
            width,
            true
        ) : context::no_id();
    let release_error: runtime::Error =
        bytes::release(decoded);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (global_id == context::no_id()) {
        if (context->error == runtime::Error.none) {
            context->error = context->ir.error;
        }
        return invalid_expression();
    }
    var element_type: usize =
        type_info::BuiltinType.unsigned_8 as usize;
    if (width == 2) {
        element_type = type_info::BuiltinType.unsigned_16 as usize;
    }
    if (width == 4) {
        element_type = type_info::BuiltinType.unsigned_32 as usize;
    }
    let pointer: type_info::IdResult =
        type_info::table_pointer(
            &context->types,
            element_type,
            true,
            false
        );
    context->error = pointer.error;
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.global_address,
            node
        );
    instruction.auxiliary = global_id;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        pointer.type_id
    );
    return {
        type_id = pointer.type_id,
        value_id = value_id,
        address_id = context::no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
}

enum EmbedLimit: usize {
    maximum_bytes = 16777216,
}

// @embed("path") reads the named file fresh on every compilation (the build is always from scratch,
// so there is no incremental tracking and no stale-embed hazard; embedded files live in the source
// tree like sources) and yields a read-only [N]u8 memory lvalue at a global holding the file's N
// bytes. A relative path resolves against the directory of the referencing unit; a leading '/' is
// used as-is. A non-u8-string argument, an undecodable path, a missing or unreadable file, an empty
// file (arrays are positive-length) and a file over the cap all fail with invalid_embed.
fn lower_embed(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let none: usize = context::no_id();
    let argument: parser::SyntaxNode =
        context::node(context, context->current_unit, node.first_child);
    let token: lexer::Token =
        context::token(context, context->current_unit, argument.token_index);
    var decoded: bytes::Buffer = bytes::empty();
    var path_bytes: bytes::Buffer = bytes::empty();
    var file: bytes::Buffer = bytes::empty();
    var path: path::Path = {
        storage = bytes::empty(), length = 0,
    };
    var has_path: bool = false;
    var valid: bool = argument.kind == parser::SyntaxKind.string_expression &&
        string_token_width(token.kind) == 1;
    if (valid) {
        valid = decode_string_literal(context, argument, 1, &decoded);
    }
    if (valid && context->error == runtime::Error.none) {
        var step: bytes::BufferResult = {
            buffer = path_bytes, error = runtime::Error.none,
        };
        if (decoded.length == 0 || decoded.data[0] != 47) {
            let unit_path: text::View = context::unit_path(context, context->current_unit);
            var directory: usize = unit_path.length;
            while (directory != 0 && unit_path.data[directory - 1] != 47) {
                directory -= 1;
            }
            if (directory != 0) {
                step = bytes::append(path_bytes, unit_path.data, directory);
                path_bytes = step.buffer;
            }
        }
        if (step.error == runtime::Error.none) {
            step = bytes::append(path_bytes, decoded.data as *const u8, decoded.length);
            path_bytes = step.buffer;
        }
        context->error = step.error;
    }
    if (valid && context->error == runtime::Error.none) {
        let text: text::ViewResult = text::view(path_bytes.data as *const u8, path_bytes.length);
        context->error = text.error;
        if (text.error == runtime::Error.none) {
            let resolved: path::PathResult = path::from_text(text.view);
            if (resolved.error == runtime::Error.none) {
                path = resolved.path;
                has_path = true;
            } else {
                valid = false;
            }
        }
    }
    if (valid && context->error == runtime::Error.none) {
        // The limited read also enforces the cap: a longer file is reported as a read error.
        let read: bytes::BufferResult =
            io::read_file_limited(path, EmbedLimit.maximum_bytes as usize);
        file = read.buffer;
        valid = read.error == runtime::Error.none && read.buffer.length != 0;
    }
    var array_type: usize = none;
    var global_id: usize = none;
    if (valid && context->error == runtime::Error.none) {
        let array: type_info::IdResult = type_info::table_array(
            &context->types, type_info::BuiltinType.unsigned_8 as usize, file.length);
        context->error = array.error;
        array_type = array.type_id;
    }
    if (valid && context->error == runtime::Error.none) {
        global_id = ir::add_global(&context->ir, file.data as *const u8, file.length, 1, true);
        if (global_id == none) {
            context->error = context->ir.error;
        }
    }
    var release_error: runtime::Error = bytes::release(decoded);
    let path_bytes_error: runtime::Error = bytes::release(path_bytes);
    if (release_error == runtime::Error.none) {
        release_error = path_bytes_error;
    }
    let file_error: runtime::Error = bytes::release(file);
    if (release_error == runtime::Error.none) {
        release_error = file_error;
    }
    if (has_path) {
        let path_error: runtime::Error = path::release(path);
        if (release_error == runtime::Error.none) {
            release_error = path_error;
        }
    }
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (global_id == none || context->error != runtime::Error.none) {
        if (!valid && context->error == runtime::Error.none) {
            context::add_diagnostic(
                context, context::DiagnosticKind.invalid_embed, context->current_unit, node.span, none,
                context::empty_span(), 0);
        }
        return invalid_expression();
    }
    let pointer: type_info::IdResult =
        type_info::table_pointer(&context->types, array_type, true, false);
    context->error = pointer.error;
    var instruction: ir::Instruction =
        context::instruction(ir::Opcode.global_address, node);
    instruction.auxiliary = global_id;
    let address_id: usize = context::emit_value(context, instruction, pointer.type_id);
    return {
        type_id = array_type,
        value_id = none,
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = address_id != none,
        bitfield_segment = none,
    };
}

fn lower_scalar_zero_initializer(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize,
    type_record: type_info::Record
) -> context::Expression {
    if (type_record.kind == type_info::Kind.boolean) {
        return context::emit_boolean_constant(
            context,
            node,
            false
        );
    }
    if (type_info::is_integer(type_record.kind) ||
        type_record.kind == type_info::Kind.enumeration) {
        return context::emit_integer_constant(
            context,
            node,
            expected_type,
            0
        );
    }
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.invalid,
            node
        );
    if (type_info::is_float(type_record.kind)) {
        instruction.opcode =
            ir::Opcode.constant_float;
        instruction.floating = 0.0;
    } else if (type_record.kind ==
        type_info::Kind.pointer) {
        instruction.opcode =
            ir::Opcode.constant_null;
    } else {
        return invalid_expression();
    }
    let value_id: usize = context::emit_value(
        context,
        instruction,
        expected_type
    );
    return {
        type_id = expected_type,
        value_id = value_id,
        address_id = context::no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
}

fn validate_initializer_fields(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize,
    type_record: type_info::Record
) -> bool {
    let none: usize = context::no_id();
    var seen_fields: bytes::Buffer =
        bytes::empty();
    var child: usize = node.first_child;
    var initializer_count: usize = 0;
    var valid: bool = true;
    while (child != none &&
        context->error == runtime::Error.none) {
        let initializer: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                child
            );
        if (initializer.kind ==
            parser::SyntaxKind.initializer_element) {
            // Positional and indexed entries are only valid for arrays.
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_initializer,
                context->current_unit,
                initializer.span,
                none,
                context::empty_span(),
                expected_type
            );
            valid = false;
            child = initializer.next_sibling;
            continue;
        }
        let lookup: types::FieldLookup =
            types::lookup_field(
                context,
                expected_type,
                context->current_unit,
                initializer.token_index
            );
        if (lookup.status ==
            types::FieldStatus.ambiguous) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.ambiguous_field,
                context->current_unit,
                initializer.span,
                none,
                context::empty_span(),
                expected_type
            );
            valid = false;
        } else if (lookup.status !=
            types::FieldStatus.found) {
            let segment_id: usize =
                context::lookup_bitfield_segment(
                    context,
                    expected_type,
                    context->current_unit,
                    initializer.token_index
                );
            // Segments are not directly initializable yet; naming one is a
            // bitfield error rather than an unknown field.
            context::add_diagnostic(
                context,
                segment_id != none ?
                    context::DiagnosticKind
                        .invalid_bitfield :
                    context::DiagnosticKind.unknown_field,
                context->current_unit,
                initializer.span,
                none,
                context::empty_span(),
                segment_id != none ? segment_id : expected_type
            );
            valid = false;
        } else {
            let field_id: usize = lookup.field_id;
            let seen: *const usize =
                seen_fields.data as *const usize;
            var duplicate: bool = false;
            var seen_index: usize = 0;
            while (seen_index <
                seen_fields.length / sizeof(usize)) {
                if (seen[seen_index] == field_id) {
                    duplicate = true;
                    break;
                }
                seen_index += 1;
            }
            if (duplicate ||
                (type_record.kind ==
                    type_info::Kind.record_union &&
                    initializer_count != 0)) {
                context::add_diagnostic(
                    context,
                    context::DiagnosticKind
                        .duplicate_initializer_field,
                    context->current_unit,
                    initializer.span,
                    none,
                    context::empty_span(),
                    field_id
                );
                valid = false;
            } else {
                let appended: bytes::BufferResult =
                    bytes::append(
                        seen_fields,
                        (&field_id) as
                            *const usize as *const u8,
                        sizeof(usize)
                    );
                seen_fields = appended.buffer;
                context->error = appended.error;
                initializer_count += 1;
            }
        }
        child = initializer.next_sibling;
    }
    let release_error: runtime::Error =
        bytes::release(seen_fields);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return valid && context->error == runtime::Error.none;
}

fn lower_array_initializer(
    context: *context::Context,
    node: parser::SyntaxNode,
    address_id: usize,
    expected_type: usize,
    type_record: type_info::Record
) -> bool {
    let none: usize = context::no_id();
    let element_type: usize = type_record.element_type;
    let element_count: usize = type_record.element_count;
    let element_record: type_info::Record =
        context::type_record(context, element_type);
    let pointer: type_info::IdResult =
        type_info::table_pointer(
            &context->types,
            element_type,
            false,
            false
        );
    context->error = pointer.error;
    if (context->error != runtime::Error.none) {
        return false;
    }
    var seen_indices: bytes::Buffer =
        bytes::empty();
    var cursor: usize = 0;
    var valid: bool = true;
    var child: usize = node.first_child;
    while (child != none &&
        context->error == runtime::Error.none) {
        let element: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                child
            );
        if (element.kind !=
            parser::SyntaxKind.initializer_element) {
            // Named `field =` entries are only valid for records.
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_initializer,
                context->current_unit,
                element.span,
                none,
                context::empty_span(),
                expected_type
            );
            valid = false;
            child = element.next_sibling;
            continue;
        }
        var position: u64 = cursor as u64;
        var value_child: usize = element.first_child;
        if ((element.flags &
                (parser::SyntaxFlag.indexed as usize)) != 0) {
            if (element.child_count != 2) {
                context->error = runtime::Error.invalid_argument;
                break;
            }
            let index: consteval::Value =
                consteval::expression(
                    context,
                    context->current_unit,
                    element.first_child
                );
            if (!index.is_constant || index.error ||
                index.is_boolean) {
                context::add_diagnostic(
                    context,
                    context::DiagnosticKind.invalid_index,
                    context->current_unit,
                    context::node(
                        context,
                        context->current_unit,
                        element.first_child
                    ).span,
                    none,
                    context::empty_span(),
                    expected_type
                );
                valid = false;
                child = element.next_sibling;
                continue;
            }
            position = index.value;
            value_child =
                context::node(
                    context,
                    context->current_unit,
                    element.first_child
                ).next_sibling;
        }
        if (position >= element_count as u64) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_index,
                context->current_unit,
                element.span,
                none,
                context::empty_span(),
                expected_type
            );
            valid = false;
            child = element.next_sibling;
            continue;
        }
        let slot: usize = position as usize;
        let seen: *const usize =
            seen_indices.data as *const usize;
        var duplicate: bool = false;
        var seen_index: usize = 0;
        while (seen_index <
            seen_indices.length / sizeof(usize)) {
            if (seen[seen_index] == slot) {
                duplicate = true;
                break;
            }
            seen_index += 1;
        }
        if (duplicate) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind
                    .duplicate_initializer_field,
                context->current_unit,
                element.span,
                none,
                context::empty_span(),
                expected_type
            );
            valid = false;
            child = element.next_sibling;
            continue;
        }
        let appended: bytes::BufferResult =
            bytes::append(
                seen_indices,
                (&slot) as *const usize as *const u8,
                sizeof(usize)
            );
        seen_indices = appended.buffer;
        context->error = appended.error;
        cursor = slot + 1;
        let value_node: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                value_child
            );
        if (element_record.kind == type_info::Kind.array &&
            value_node.kind ==
                parser::SyntaxKind.aggregate_initializer) {
            // Nested array-of-array lists are deferred.
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_initializer,
                context->current_unit,
                value_node.span,
                none,
                context::empty_span(),
                expected_type
            );
            valid = false;
            child = element.next_sibling;
            continue;
        }
        // Element addresses use pointer_offset with a constant index, the
        // same instruction shape as array indexing; member_address only
        // validates against record fields.
        let index_constant: context::Expression =
            context::emit_integer_constant(
                context,
                element,
                type_info::BuiltinType.unsigned_size as usize,
                slot as u64
            );
        var element_instruction: ir::Instruction =
            context::instruction(
                ir::Opcode.pointer_offset,
                element
            );
        element_instruction.left = address_id;
        element_instruction.right = index_constant.value_id;
        element_instruction.auxiliary =
            element_record.size_bytes;
        let element_address: usize =
            context::emit_value(
                context,
                element_instruction,
                pointer.type_id
            );
        let value: context::Expression =
            lower_expression(
                context,
                value_child,
                element_type
            );
        if (value.type_id != element_type) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.type_mismatch,
                context->current_unit,
                element.span,
                none,
                context::empty_span(),
                element_type
            );
            valid = false;
        } else {
            context::store_to_address(
                context,
                element,
                element_address,
                element_type,
                value
            );
        }
        child = element.next_sibling;
    }
    let release_error: runtime::Error =
        bytes::release(seen_indices);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return valid && context->error == runtime::Error.none;
}

fn lower_initializer(
    context: *context::Context,
    node_id: usize,
    expected_type: usize
) -> context::Expression {
    let none: usize = context::no_id();
    let node: parser::SyntaxNode = context::node(
        context,
        context->current_unit,
        node_id
    );
    let type_record: type_info::Record =
        context::type_record(
            context,
            expected_type
        );
    if (node.kind ==
            parser::SyntaxKind.aggregate_initializer &&
        type_record.kind != type_info::Kind.structure &&
        type_record.kind !=
            type_info::Kind.record_union &&
        type_record.kind != type_info::Kind.array) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_initializer,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            expected_type
        );
        return invalid_expression();
    }
    if (node.kind ==
            parser::SyntaxKind.aggregate_initializer &&
        type_record.kind != type_info::Kind.array &&
        !validate_initializer_fields(
            context,
            node,
            expected_type,
            type_record
        )) {
        return invalid_expression();
    }
    if (!type_info::is_memory(type_record.kind)) {
        if (node.kind ==
            parser::SyntaxKind.zero_initializer) {
            let zero: context::Expression =
                lower_scalar_zero_initializer(
                    context,
                    node,
                    expected_type,
                    type_record
                );
            if (zero.valid) {
                return zero;
            }
        }
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_initializer,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            expected_type
        );
        return invalid_expression();
    }
    let slot_id: usize = ir::add_slot(
        &context->ir,
        context::current_ir_function(context),
        expected_type,
        true,
        false,
        0
    );
    let address_id: usize = context::address_of_slot(
        context,
        node,
        slot_id,
        expected_type,
        false,
        false
    );
    if (slot_id == none || address_id == none ||
        !context::zero_slot(
            context,
            node,
            slot_id,
            expected_type
        )) {
        return invalid_expression();
    }
    if (node.kind ==
            parser::SyntaxKind.aggregate_initializer &&
        type_record.kind == type_info::Kind.array) {
        if (!lower_array_initializer(
                context,
                node,
                address_id,
                expected_type,
                type_record
            )) {
            return invalid_expression();
        }
    } else if (node.kind ==
        parser::SyntaxKind.aggregate_initializer) {
        let fields: *const type_info::Field =
            context->types.fields.data as
                *const type_info::Field;
        var seen_fields: bytes::Buffer =
            bytes::empty();
        var child: usize = node.first_child;
        var initializer_count: usize = 0;
        while (child != none &&
            context->error == runtime::Error.none) {
            let initializer: parser::SyntaxNode =
                context::node(
                    context,
                    context->current_unit,
                    child
                );
            let lookup: types::FieldLookup =
                types::lookup_field(
                    context,
                    expected_type,
                    context->current_unit,
                    initializer.token_index
                );
            if (lookup.status ==
                types::FieldStatus.ambiguous) {
                context::add_diagnostic(
                    context,
                    context::DiagnosticKind
                        .ambiguous_field,
                    context->current_unit,
                    initializer.span,
                    none,
                    context::empty_span(),
                    expected_type
                );
            } else if (lookup.status !=
                types::FieldStatus.found) {
                context::add_diagnostic(
                    context,
                    context::DiagnosticKind.unknown_field,
                    context->current_unit,
                    initializer.span,
                    none,
                    context::empty_span(),
                    expected_type
                );
            } else {
                let field_id: usize = lookup.field_id;
                let seen: *const usize =
                    seen_fields.data as *const usize;
                var duplicate: bool = false;
                var seen_index: usize = 0;
                while (seen_index <
                    seen_fields.length / sizeof(usize)) {
                    if (seen[seen_index] == field_id) {
                        duplicate = true;
                        break;
                    }
                    seen_index += 1;
                }
                if (duplicate ||
                    (type_record.kind ==
                        type_info::Kind.record_union &&
                        initializer_count != 0)) {
                    context::add_diagnostic(
                        context,
                        context::DiagnosticKind
                            .duplicate_initializer_field,
                        context->current_unit,
                        initializer.span,
                        none,
                        context::empty_span(),
                        field_id
                    );
                } else if (initializer.child_count == 1) {
                    let added: bytes::BufferResult =
                        bytes::append(
                            seen_fields,
                            (&field_id) as
                                *const usize as *const u8,
                            sizeof(usize)
                        );
                    seen_fields = added.buffer;
                    context->error = added.error;
                    let field: type_info::Field =
                        fields[field_id];
                    let pointer: type_info::IdResult =
                        type_info::table_pointer(
                            &context->types,
                            field.type_id,
                            false,
                            false
                        );
                    context->error = pointer.error;
                    var member_instruction:
                        ir::Instruction =
                        context::instruction(
                            ir::Opcode.member_address,
                            initializer
                        );
                    member_instruction.left = address_id;
                    member_instruction.auxiliary =
                        lookup.offset_bytes;
                    let field_address: usize =
                        context::emit_value(
                            context,
                            member_instruction,
                            pointer.type_id
                        );
                    let value: context::Expression =
                        lower_expression(
                            context,
                            initializer.first_child,
                            field.type_id
                        );
                    if (value.type_id != field.type_id) {
                        context::add_diagnostic(
                            context,
                            context::DiagnosticKind
                                .type_mismatch,
                            context->current_unit,
                            initializer.span,
                            none,
                            context::empty_span(),
                            field.type_id
                        );
                    } else {
                        context::store_to_address(
                            context,
                            initializer,
                            field_address,
                            field.type_id,
                            value
                        );
                    }
                    initializer_count += 1;
                }
            }
            child = initializer.next_sibling;
        }
        let release_error: runtime::Error =
            bytes::release(seen_fields);
        if (context->error == runtime::Error.none) {
            context->error = release_error;
        }
    }
    return {
        type_id = expected_type,
        value_id = none,
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = address_id != none,
        bitfield_segment = context::no_id(),
    };
}

fn function_value(
    context: *context::Context,
    node: parser::SyntaxNode,
    symbol_id: usize
) -> context::Expression {
    let none: usize = context::no_id();
    let symbols: *const context::Symbol =
        context->symbols.data as *const context::Symbol;
    let functions: *const context::Function =
        context->functions.data as
            *const context::Function;
    let function: context::Function =
        functions[symbols[symbol_id].function_id];
    var parameter_types: bytes::Buffer =
        bytes::empty();
    var index: usize = 0;
    while (index < function.parameter_count &&
        context->error == runtime::Error.none) {
        let parameters: *const context::Parameter =
            context->parameters.data as
                *const context::Parameter;
        let parameter_type: usize =
            parameters[function.first_parameter + index]
                .type_id;
        let appended: bytes::BufferResult =
            bytes::append(
                parameter_types,
                (&parameter_type) as *const usize as *const u8,
                sizeof(usize)
            );
        parameter_types = appended.buffer;
        context->error = appended.error;
        index += 1;
    }
    if (context->error != runtime::Error.none) {
        let release_error: runtime::Error =
            bytes::release(parameter_types);
        if (context->error == runtime::Error.none) {
            context->error = release_error;
        }
        return invalid_expression();
    }
    let parameters: *const usize =
        parameter_types.data as *const usize;
    let pointer_type: usize =
        context::function_pointer_type(
            context,
            function.return_type,
            parameters,
            function.parameter_count
        );
    let release_error: runtime::Error =
        bytes::release(parameter_types);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (pointer_type == none ||
        function.ir_function == none) {
        return invalid_expression();
    }
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.function_address,
            node
        );
    instruction.auxiliary = function.ir_function;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        pointer_type
    );
    return {
        type_id = pointer_type,
        value_id = value_id,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != none,
        bitfield_segment = context::no_id(),
    };
}

// Emits the resolved value of a module-level constant symbol (flat or
// qualified lookup), mirroring the literal lowering of a local constant.
fn emit_symbol_constant(
    context: *context::Context,
    node: parser::SyntaxNode,
    symbol_id: usize
) -> context::Expression {
    let symbols: *const context::Symbol =
        context->symbols.data as *const context::Symbol;
    let type_id: usize = symbols[symbol_id].type_id;
    let value: u64 = symbols[symbol_id].integer_value;
    if (type_id == (type_info::BuiltinType.boolean as usize)) {
        return context::emit_boolean_constant(
            context, node, value != 0
        );
    }
    let kind: type_info::Kind =
        context::type_record(context, type_id).kind;
    return context::emit_integer_constant(
        context,
        node,
        type_id,
        context::mask_integer(
            value, type_info::bit_width(kind)
        )
    );
}

fn lower_const_name(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let none: usize = context::no_id();
    if (node.child_count != 0) {
        // Qualified `qual::name`: only a module-level constant of the named
        // module applies; the lookup diagnoses failures itself.
        let qualified_symbol: usize =
            context::lookup_qualified_symbol(
                context,
                context->current_unit,
                node,
                context::SymbolKind.constant,
                true
            );
        if (qualified_symbol == none) {
            return invalid_expression();
        }
        return emit_symbol_constant(
            context,
            node,
            qualified_symbol
        );
    }
    var type_id: usize = none;
    var value: u64 = 0;
    let local_id: usize = context::find_local(
        context,
        context->current_unit,
        node.token_index
    );
    if (local_id != none) {
        let locals: *const context::Local =
            context->locals.data as *const context::Local;
        let local: context::Local = locals[local_id];
        if (!local.constant_binding) {
            return invalid_expression();
        }
        type_id = local.type_id;
        value = local.integer_value;
    } else {
        let symbol_id: usize = context::lookup_symbol(
            context,
            context->current_unit,
            node.token_index,
            context::SymbolKind.constant
        );
        if (symbol_id == none) {
            return invalid_expression();
        }
        let symbols: *const context::Symbol =
            context->symbols.data as *const context::Symbol;
        type_id = symbols[symbol_id].type_id;
        value = symbols[symbol_id].integer_value;
    }
    if (type_id == (type_info::BuiltinType.boolean as usize)) {
        return context::emit_boolean_constant(
            context, node, value != 0
        );
    }
    let kind: type_info::Kind =
        context::type_record(context, type_id).kind;
    return context::emit_integer_constant(
        context,
        node,
        type_id,
        context::mask_integer(
            value, type_info::bit_width(kind)
        )
    );
}

// Lowers a qualified `qual::name` expression: constant first, then function,
// probing quietly so a name found under either kind yields exactly one
// result; only a total miss re-runs the diagnosing lookup to report the
// qualifier or name failure once.
fn lower_qualified_name(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let none: usize = context::no_id();
    var symbol_id: usize =
        context::lookup_qualified_symbol(
            context,
            context->current_unit,
            node,
            context::SymbolKind.constant,
            false
        );
    if (symbol_id != none) {
        return emit_symbol_constant(
            context,
            node,
            symbol_id
        );
    }
    symbol_id = context::lookup_qualified_symbol(
        context,
        context->current_unit,
        node,
        context::SymbolKind.function,
        false
    );
    if (symbol_id != none) {
        return function_value(
            context,
            node,
            symbol_id
        );
    }
    context::lookup_qualified_symbol(
        context,
        context->current_unit,
        node,
        context::SymbolKind.constant,
        true
    );
    return invalid_expression();
}

fn lower_name(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    if (node.child_count != 0) {
        return lower_qualified_name(context, node);
    }
    let const_name: context::Expression =
        lower_const_name(context, node);
    if (const_name.valid) {
        return const_name;
    }
    let local_id: usize = context::find_local(
        context,
        context->current_unit,
        node.token_index
    );
    if (local_id == context::no_id()) {
        let function_symbol: usize =
            context::lookup_symbol(
                context,
                context->current_unit,
                node.token_index,
                context::SymbolKind.function
            );
        if (function_symbol != context::no_id()) {
            return function_value(
                context,
                node,
                function_symbol
            );
        }
        context::add_diagnostic(
            context,
            context::DiagnosticKind.unknown_name,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            node.token_index
        );
        return invalid_expression();
    }
    let locals: *const context::Local =
        context->locals.data as
            *const context::Local;
    let local: context::Local = locals[local_id];
    let address_id: usize = context::address_of_slot(
        context,
        node,
        local.slot_id,
        local.type_id,
        !local.mutable_binding,
        local.volatile_binding
    );
    let expression: context::Expression = {
        type_id = local.type_id,
        value_id = context::no_id(),
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = local.mutable_binding,
        volatile_lvalue = local.volatile_binding,
        valid = address_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
    return context::load_lvalue(
        context,
        node,
        expression
    );
}

fn lower_enum_member(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    if (node.child_count != 2) {
        return invalid_expression();
    }
    let owner_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let member_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            owner_node.next_sibling
        );
    if (owner_node.kind !=
            parser::SyntaxKind.name_expression ||
        member_node.kind !=
            parser::SyntaxKind.name_expression) {
        return invalid_expression();
    }
    let type_symbol: usize =
        context::lookup_qualified_symbol(
            context,
            context->current_unit,
            owner_node,
            context::SymbolKind.named_type,
            false
        );
    if (type_symbol == context::no_id()) {
        return invalid_expression();
    }
    let symbols: *const context::Symbol =
        context->symbols.data as
            *const context::Symbol;
    var type_id: usize = symbols[type_symbol].type_id;
    let alias_record: type_info::Record =
        context::type_record(context, type_id);
    if (alias_record.kind == type_info::Kind.alias &&
        types::require_complete_type(
            context,
            type_id
        )) {
        type_id = context::type_record(
            context,
            type_id
        ).element_type;
    }
    if (context::type_record(
            context,
            type_id
        ).kind != type_info::Kind.enumeration) {
        return invalid_expression();
    }
    let member_symbol: usize =
        types::find_enum_member(
            context,
            type_id,
            context->current_unit,
            member_node.token_index
        );
    if (member_symbol == context::no_id()) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.unknown_field,
            context->current_unit,
            member_node.span,
            context::no_id(),
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    return context::emit_integer_constant(
        context,
        node,
        type_id,
        symbols[member_symbol].integer_value
    );
}

fn emit_integer_binary(
    context: *context::Context,
    node: parser::SyntaxNode,
    operation: lexer::TokenKind,
    type_id: usize,
    left: usize,
    right: usize
) -> usize {
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.binary_integer,
            node
        );
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return context::emit_value(
        context,
        instruction,
        type_id
    );
}

fn emit_integer_shift(
    context: *context::Context,
    node: parser::SyntaxNode,
    operation: lexer::TokenKind,
    type_id: usize,
    value: usize,
    amount: usize
) -> usize {
    let count: context::Expression =
        context::emit_integer_constant(
            context,
            node,
            type_id,
            amount as u64
        );
    return emit_integer_binary(
        context,
        node,
        operation,
        type_id,
        value,
        count.value_id
    );
}

fn emit_integer_mask(
    context: *context::Context,
    node: parser::SyntaxNode,
    type_id: usize,
    value: usize,
    mask: u64
) -> usize {
    let mask_expression: context::Expression =
        context::emit_integer_constant(
            context,
            node,
            type_id,
            mask
        );
    return emit_integer_binary(
        context,
        node,
        lexer::TokenKind.ampersand,
        type_id,
        value,
        mask_expression.value_id
    );
}

fn bitfield_bit_mask(
    bits: usize
) -> u64 {
    return context::mask_integer(
        0xFFFFFFFFFFFFFFFF,
        bits
    );
}

// (raw >> offset) & mask(width) for unsigned storage; signed storage shifts
// the segment to the top of the word and arithmetic-shifts it back down so
// the segment's own sign bit extends.
fn emit_bitfield_extract(
    context: *context::Context,
    node: parser::SyntaxNode,
    type_id: usize,
    raw: usize,
    bit_offset: usize,
    bit_width: usize
) -> usize {
    let record: type_info::Record =
        context::type_record(context, type_id);
    let width: usize =
        type_info::bit_width(record.kind);
    var value: usize = raw;
    if (type_info::is_signed_integer(record.kind)) {
        if (bit_offset + bit_width < width) {
            value = emit_integer_shift(
                context,
                node,
                lexer::TokenKind.shift_left,
                type_id,
                value,
                width - bit_offset - bit_width
            );
        }
        if (bit_width < width) {
            value = emit_integer_shift(
                context,
                node,
                lexer::TokenKind.shift_right,
                type_id,
                value,
                width - bit_width
            );
        }
        return value;
    }
    if (bit_offset > 0) {
        value = emit_integer_shift(
            context,
            node,
            lexer::TokenKind.shift_right,
            type_id,
            value,
            bit_offset
        );
    }
    if (bit_width < width) {
        value = emit_integer_mask(
            context,
            node,
            type_id,
            value,
            bitfield_bit_mask(bit_width)
        );
    }
    return value;
}

fn lower_bitfield_member(
    context: *context::Context,
    node: parser::SyntaxNode,
    owner_address: usize,
    segment_id: usize,
    mutable_lvalue: bool,
    volatile_lvalue: bool
) -> context::Expression {
    let none: usize = context::no_id();
    let segment: context::BitfieldSegment =
        context::bitfield_segment(context, segment_id);
    let field_id: usize =
        context::bitfield_storage_field(context, segment);
    if (field_id == none) {
        return invalid_expression();
    }
    let fields: *const type_info::Field =
        context->types.fields.data as
            *const type_info::Field;
    let field: type_info::Field = fields[field_id];
    let pointer: type_info::IdResult =
        type_info::table_pointer(
            &context->types,
            field.type_id,
            !mutable_lvalue,
            volatile_lvalue
        );
    context->error = pointer.error;
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.member_address,
            node
        );
    instruction.left = owner_address;
    instruction.auxiliary = field.offset_bytes;
    let address_id: usize = context::emit_value(
        context,
        instruction,
        pointer.type_id
    );
    let loaded: context::Expression =
        context::load_lvalue(
            context,
            node,
            {
                type_id = field.type_id,
                value_id = none,
                address_id = address_id,
                constant_value = 0,
                has_constant = false,
                lvalue = true,
                mutable_lvalue = mutable_lvalue,
                volatile_lvalue = volatile_lvalue,
                valid = address_id != none,
                bitfield_segment = none,
            }
        );
    if (!loaded.valid) {
        return invalid_expression();
    }
    let extracted: usize =
        emit_bitfield_extract(
            context,
            node,
            field.type_id,
            loaded.value_id,
            segment.bit_offset,
            segment.bit_width
        );
    return {
        type_id = field.type_id,
        value_id = extracted,
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = mutable_lvalue,
        volatile_lvalue = volatile_lvalue,
        valid = extracted != none,
        bitfield_segment = segment_id,
    };
}

// Read-modify-write of the storage field: load the raw word, clear the
// segment's bits, insert the new value masked to its width, store back.
fn store_bitfield(
    context: *context::Context,
    node: parser::SyntaxNode,
    destination: usize,
    segment_id: usize,
    value: context::Expression
) -> bool {
    let none: usize = context::no_id();
    let segment: context::BitfieldSegment =
        context::bitfield_segment(context, segment_id);
    let field_id: usize =
        context::bitfield_storage_field(context, segment);
    if (!value.valid || field_id == none || destination == none) {
        return false;
    }
    let fields: *const type_info::Field =
        context->types.fields.data as
            *const type_info::Field;
    let field: type_info::Field = fields[field_id];
    if (value.type_id != field.type_id) {
        return false;
    }
    let record: type_info::Record =
        context::type_record(context, field.type_id);
    let width: usize =
        type_info::bit_width(record.kind);
    var load_instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.load_indirect,
            node
        );
    load_instruction.left = destination;
    let raw: usize = context::emit_value(
        context,
        load_instruction,
        field.type_id
    );
    if (raw == none) {
        return false;
    }
    var inserted: usize = value.value_id;
    if (segment.bit_width < width) {
        inserted = emit_integer_mask(
            context,
            node,
            field.type_id,
            inserted,
            bitfield_bit_mask(segment.bit_width)
        );
    }
    if (segment.bit_offset > 0) {
        inserted = emit_integer_shift(
            context,
            node,
            lexer::TokenKind.shift_left,
            field.type_id,
            inserted,
            segment.bit_offset
        );
    }
    var combined: usize = inserted;
    if (segment.bit_offset != 0 || segment.bit_width != width) {
        let clear_mask: u64 = context::mask_integer(
            bitfield_bit_mask(width) ^
                (bitfield_bit_mask(
                    segment.bit_width
                ) << (segment.bit_offset as u64)),
            width
        );
        let cleared: usize =
            emit_integer_mask(
                context,
                node,
                field.type_id,
                raw,
                clear_mask
            );
        combined = emit_integer_binary(
            context,
            node,
            lexer::TokenKind.pipe,
            field.type_id,
            cleared,
            inserted
        );
    }
    var store_instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.store_indirect,
            node
        );
    store_instruction.left = destination;
    store_instruction.right = combined;
    store_instruction.type_id = field.type_id;
    store_instruction.auxiliary = record.size_bytes;
    return context::emit_void(
        context,
        store_instruction
    ) != none;
}

fn lower_member(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let enum_member: context::Expression =
        lower_enum_member(context, node);
    if (enum_member.valid) {
        return enum_member;
    }
    if (node.child_count != 2) {
        return invalid_expression();
    }
    let base_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let name_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            base_node.next_sibling
        );
    let operation: lexer::TokenKind =
        context::token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    let base: context::Expression =
        lower_expression(
            context,
            node.first_child,
            context::no_id()
        );
    if (!base.valid) {
        return base;
    }
    var owner_type: usize = base.type_id;
    var owner_address: usize = base.address_id;
    var mutable_lvalue: bool = base.mutable_lvalue;
    var volatile_lvalue: bool = base.volatile_lvalue;
    if (operation == lexer::TokenKind.arrow) {
        let pointer_record: type_info::Record =
            context::type_record(
                context,
                base.type_id
            );
        if (pointer_record.kind !=
            type_info::Kind.pointer) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_member,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                base.type_id
            );
            return invalid_expression();
        }
        owner_type = pointer_record.element_type;
        owner_address = base.value_id;
        mutable_lvalue =
            (pointer_record.flags &
                (type_info::Flag.read_only as usize)) == 0;
        volatile_lvalue =
            (pointer_record.flags &
                (type_info::Flag.volatile_pointee as usize)) != 0;
        var check: ir::Instruction =
            context::instruction(
                ir::Opcode.null_check,
                node
            );
        check.left = owner_address;
        context::emit_void(context, check);
    } else if (operation != lexer::TokenKind.dot ||
        base.address_id == context::no_id()) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_member,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            base.type_id
        );
        return invalid_expression();
    }
    let owner_record: type_info::Record =
        context::type_record(context, owner_type);
    if (owner_record.kind != type_info::Kind.structure &&
        owner_record.kind != type_info::Kind.record_union) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_member,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            owner_type
        );
        return invalid_expression();
    }
    let lookup: types::FieldLookup =
        types::lookup_field(
            context,
            owner_type,
            context->current_unit,
            name_node.token_index
        );
    if (lookup.status == types::FieldStatus.ambiguous) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.ambiguous_field,
            context->current_unit,
            name_node.span,
            context::no_id(),
            context::empty_span(),
            owner_type
        );
        return invalid_expression();
    }
    if (lookup.status != types::FieldStatus.found) {
        let segment_id: usize =
            context::lookup_bitfield_segment(
                context,
                owner_type,
                context->current_unit,
                name_node.token_index
            );
        if (segment_id != context::no_id()) {
            return lower_bitfield_member(
                context,
                node,
                owner_address,
                segment_id,
                mutable_lvalue,
                volatile_lvalue
            );
        }
        context::add_diagnostic(
            context,
            context::DiagnosticKind.unknown_field,
            context->current_unit,
            name_node.span,
            context::no_id(),
            context::empty_span(),
            owner_type
        );
        return invalid_expression();
    }
    let fields: *const type_info::Field =
        context->types.fields.data as
            *const type_info::Field;
    let field: type_info::Field = fields[lookup.field_id];
    let field_record: type_info::Record =
        context::type_record(context, field.type_id);
    if (field_record.kind == type_info::Kind.array &&
        (field_record.flags &
            (type_info::Flag.flexible as usize)) != 0) {
        // A flexible member access yields *T at the member offset, not an
        // array lvalue; it composes with raw-pointer indexing and arithmetic.
        let element_pointer: type_info::IdResult =
            type_info::table_pointer(
                &context->types,
                field_record.element_type,
                !mutable_lvalue,
                volatile_lvalue
            );
        context->error = element_pointer.error;
        var flexible_instruction: ir::Instruction =
            context::instruction(
                ir::Opcode.member_address,
                node
            );
        flexible_instruction.left = owner_address;
        flexible_instruction.auxiliary = lookup.offset_bytes;
        let flexible_address: usize = context::emit_value(
            context,
            flexible_instruction,
            element_pointer.type_id
        );
        return {
            type_id = element_pointer.type_id,
            value_id = flexible_address,
            address_id = context::no_id(),
            constant_value = 0,
            has_constant = false,
            lvalue = false,
            mutable_lvalue = false,
            volatile_lvalue = false,
            valid = flexible_address != context::no_id(),
            bitfield_segment = context::no_id(),
        };
    }
    let pointer: type_info::IdResult =
        type_info::table_pointer(
            &context->types,
            field.type_id,
            !mutable_lvalue,
            volatile_lvalue
        );
    context->error = pointer.error;
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.member_address,
            node
        );
    instruction.left = owner_address;
    instruction.auxiliary = lookup.offset_bytes;
    let address_id: usize = context::emit_value(
        context,
        instruction,
        pointer.type_id
    );
    let result: context::Expression = {
        type_id = field.type_id,
        value_id = context::no_id(),
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = mutable_lvalue,
        volatile_lvalue = volatile_lvalue,
        valid = address_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
    return context::load_lvalue(
        context,
        node,
        result
    );
}

fn lower_index(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    if (node.child_count != 2) {
        return invalid_expression();
    }
    let base_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let index_node: usize = base_node.next_sibling;
    let base: context::Expression =
        lower_expression(
            context,
            node.first_child,
            context::no_id()
        );
    let index: context::Expression =
        lower_expression(
            context,
            index_node,
            type_info::BuiltinType.unsigned_size as usize
        );
    if (!base.valid || !index.valid ||
        index.type_id !=
            type_info::BuiltinType.unsigned_size as usize) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_index,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            index.type_id
        );
        return invalid_expression();
    }
    let base_record: type_info::Record =
        context::type_record(
            context,
            base.type_id
        );
    var element_type: usize = context::no_id();
    var base_address: usize = context::no_id();
    var mutable_lvalue: bool = false;
    var volatile_lvalue: bool = false;
    if (base_record.kind == type_info::Kind.array &&
        base.address_id != context::no_id()) {
        element_type = base_record.element_type;
        base_address = base.address_id;
        mutable_lvalue =
            base.lvalue && base.mutable_lvalue;
        volatile_lvalue =
            base.lvalue && base.volatile_lvalue;
        let bound: context::Expression =
            context::emit_integer_constant(
                context,
                node,
                type_info::BuiltinType.unsigned_size as usize,
                base_record.element_count as u64
            );
        var check: ir::Instruction =
            context::instruction(
                ir::Opcode.bounds_check,
                node
            );
        check.left = index.value_id;
        check.right = bound.value_id;
        context::emit_void(context, check);
    } else if (base_record.kind ==
        type_info::Kind.pointer) {
        element_type = base_record.element_type;
        base_address = base.value_id;
        mutable_lvalue =
            (base_record.flags &
                (type_info::Flag.read_only as usize)) == 0;
        volatile_lvalue =
            (base_record.flags &
                (type_info::Flag.volatile_pointee as usize)) != 0;
        if (context::type_record(
                context,
                element_type
            ).kind == type_info::Kind.type_void) {
            element_type = context::no_id();
        } else {
            var check: ir::Instruction =
                context::instruction(
                    ir::Opcode.null_check,
                    node
                );
            check.left = base_address;
            context::emit_void(context, check);
        }
    }
    if (element_type == context::no_id()) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_index,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            base.type_id
        );
        return invalid_expression();
    }
    let element_record: type_info::Record =
        context::type_record(
            context,
            element_type
        );
    let pointer: type_info::IdResult =
        type_info::table_pointer(
            &context->types,
            element_type,
            !mutable_lvalue,
            volatile_lvalue
        );
    context->error = pointer.error;
    var offset: ir::Instruction =
        context::instruction(
            ir::Opcode.pointer_offset,
            node
        );
    offset.left = base_address;
    offset.right = index.value_id;
    offset.auxiliary = element_record.size_bytes;
    let address_id: usize = context::emit_value(
        context,
        offset,
        pointer.type_id
    );
    let result: context::Expression = {
        type_id = element_type,
        value_id = context::no_id(),
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = mutable_lvalue,
        volatile_lvalue = volatile_lvalue,
        valid = address_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
    return context::load_lvalue(
        context,
        node,
        result
    );
}

fn lower_call(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let none: usize = context::no_id();
    if (node.child_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return invalid_expression();
    }
    let callee_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    var direct_symbol: usize = none;
    var callee_value: usize = none;
    if (callee_node.kind ==
        parser::SyntaxKind.name_expression &&
        callee_node.child_count != 0) {
        // A qualified callee names a function of the qualifier's module;
        // the lookup diagnoses unknown qualifiers and names itself.
        direct_symbol =
            context::lookup_qualified_symbol(
                context,
                context->current_unit,
                callee_node,
                context::SymbolKind.function,
                true
            );
        if (direct_symbol == none) {
            return invalid_expression();
        }
    } else if (callee_node.kind ==
        parser::SyntaxKind.name_expression &&
        context::find_local(
            context,
            context->current_unit,
            callee_node.token_index
        ) == none) {
        direct_symbol = context::lookup_symbol(
            context,
            context->current_unit,
            callee_node.token_index,
            context::SymbolKind.function
        );
    }
    var return_type: usize = none;
    var ir_callee: usize = none;
    var parameter_count: usize = 0;
    var first_parameter: usize = none;
    var parameters_from_fields: bool = false;
    var callee_no_return: bool = false;
    var callee_variadic: bool = false;
    let symbols: *const context::Symbol =
        context->symbols.data as
            *const context::Symbol;
    let functions: *const context::Function =
        context->functions.data as
            *const context::Function;
    if (direct_symbol != none) {
        let function: context::Function =
            functions[symbols[direct_symbol].function_id];
        return_type = function.return_type;
        ir_callee = function.ir_function;
        parameter_count = function.parameter_count;
        first_parameter = function.first_parameter;
        callee_no_return = (function.flags &
            (context::SymbolFlag.no_return as usize)) != 0;
        callee_variadic = (function.flags &
            (context::SymbolFlag.variadic as usize)) != 0;
    } else {
        let callee: context::Expression =
            lower_expression(
                context,
                node.first_child,
                none
            );
        if (!callee.valid) {
            return callee;
        }
        let callee_record: type_info::Record =
            context::type_record(
                context,
                callee.type_id
            );
        if (callee_record.kind !=
            type_info::Kind.function_pointer) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_call,
                context->current_unit,
                node.span,
                none,
                context::empty_span(),
                callee.type_id
            );
            return invalid_expression();
        }
        callee_value = callee.value_id;
        return_type = callee_record.element_type;
        parameter_count = callee_record.field_count;
        first_parameter = callee_record.first_field;
        parameters_from_fields = true;
    }
    let argument_total: usize = node.child_count - 1;
    if ((!callee_variadic && argument_total != parameter_count) ||
        (callee_variadic && argument_total < parameter_count)) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.argument_count,
            context->current_unit,
            node.span,
            direct_symbol != none ?
                symbols[direct_symbol].declaration_unit : none,
            context::empty_span(),
            parameter_count
        );
        return invalid_expression();
    }
    let parameters: *const context::Parameter =
        context->parameters.data as
            *const context::Parameter;
    let type_fields: *const type_info::Field =
        context->types.fields.data as
            *const type_info::Field;
    var argument_values: bytes::Buffer =
        bytes::empty();
    var child: usize = callee_node.next_sibling;
    var index: usize = 0;
    while (index < argument_total &&
        context->error == runtime::Error.none) {
        let variadic_extra: bool = index >= parameter_count;
        let parameter_type: usize =
            variadic_extra ?
                none :
                (parameters_from_fields ?
                    type_fields[first_parameter + index].type_id :
                    parameters[first_parameter + index].type_id);
        let argument: context::Expression =
            lower_expression(
                context,
                child,
                parameter_type
            );
        if (variadic_extra) {
            // Variadic extras pass at their declared width — no C default
            // argument promotions — and must classify to a single register or
            // stack slot, so aggregates are rejected.
            var extra_scalar: bool = false;
            if (argument.valid) {
                let extra_record: type_info::Record =
                    context::type_record(
                        context,
                        argument.type_id
                    );
                extra_scalar = type_info::is_scalar(extra_record.kind);
            }
            if (!extra_scalar) {
                context::add_diagnostic(
                    context,
                    context::DiagnosticKind.invalid_call,
                    context->current_unit,
                    context::node(
                        context,
                        context->current_unit,
                        child
                    ).span,
                    none,
                    context::empty_span(),
                    argument.valid ? argument.type_id : none
                );
            } else {
                var extra_value: usize = argument.value_id;
                let extra_appended: bytes::BufferResult =
                    bytes::append(
                        argument_values,
                        (&extra_value) as
                            *const usize as *const u8,
                        sizeof(usize)
                    );
                argument_values = extra_appended.buffer;
                context->error = extra_appended.error;
            }
        } else if (!argument.valid ||
            argument.type_id != parameter_type) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.type_mismatch,
                context->current_unit,
                context::node(
                    context,
                    context->current_unit,
                    child
                ).span,
                none,
                context::empty_span(),
                parameter_type
            );
        } else {
            let argument_type: type_info::Record =
                context::type_record(
                    context,
                    argument.type_id
                );
            var argument_value: usize = argument.value_id;
            if (type_info::is_memory(argument_type.kind)) {
                let snapshot_slot: usize = ir::add_slot(
                    &context->ir,
                    context::current_ir_function(context),
                    argument.type_id,
                    true,
                    false,
                    0
                );
                let snapshot_address: usize =
                    context::address_of_slot(
                        context,
                        context::node(
                            context,
                            context->current_unit,
                            child
                        ),
                        snapshot_slot,
                        argument.type_id,
                        false,
                        false
                    );
                if (snapshot_slot == none ||
                    snapshot_address == none ||
                    !context::store_to_address(
                        context,
                        context::node(
                            context,
                            context->current_unit,
                            child
                        ),
                        snapshot_address,
                        argument.type_id,
                        argument
                    )) {
                    context->error =
                        runtime::Error.invalid_argument;
                }
                argument_value = snapshot_address;
            }
            let appended: bytes::BufferResult =
                bytes::append(
                    argument_values,
                    (&argument_value) as
                        *const usize as *const u8,
                    sizeof(usize)
                );
            argument_values = appended.buffer;
            context->error = appended.error;
        }
        child = context::node(
            context,
            context->current_unit,
            child
        ).next_sibling;
        index += 1;
    }
    var instruction: ir::Instruction =
        context::instruction(
            direct_symbol != none ?
                ir::Opcode.call :
                ir::Opcode.call_indirect,
            node
        );
    if (direct_symbol != none) {
        instruction.auxiliary = ir_callee;
    } else {
        var check: ir::Instruction =
            context::instruction(
                ir::Opcode.null_check,
                node
            );
        check.left = callee_value;
        context::emit_void(context, check);
        instruction.left = callee_value;
    }
    let return_record: type_info::Record =
        context::type_record(
            context,
            return_type
        );
    let has_result: bool =
        return_record.kind != type_info::Kind.type_void;
    var result_value: usize = none;
    var instruction_id: usize = none;
    if (has_result) {
        result_value = context::emit_value(
            context,
            instruction,
            return_type
        );
        if (result_value != none) {
            let values: *const ir::Value =
                context->ir.values.data as
                    *const ir::Value;
            instruction_id =
                values[result_value].definition;
        }
    } else {
        instruction.type_id = return_type;
        instruction_id =
            context::emit_void(
                context,
                instruction
            );
    }
    let arguments: *const usize =
        argument_values.data as *const usize;
    index = 0;
    while (index <
        argument_values.length / sizeof(usize)) {
        ir::add_argument(
            &context->ir,
            instruction_id,
            arguments[index]
        );
        index += 1;
    }
    let release_error: runtime::Error =
        bytes::release(argument_values);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    if (callee_no_return &&
        instruction_id != context::no_id()) {
        var marker: ir::Instruction =
            context::instruction(
                ir::Opcode.unreachable,
                node
            );
        context::emit_void(context, marker);
        context->current_block =
            context::add_current_block(context);
    }
    return {
        type_id = return_type,
        value_id = type_info::is_memory(return_record.kind) ?
            none : result_value,
        address_id =
            type_info::is_memory(return_record.kind) ?
                result_value : none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = instruction_id != none,
        bitfield_segment = context::no_id(),
    };
}

fn address_chain_gcd(
    left: usize,
    right: usize
) -> usize {
    var a: usize = left;
    var b: usize = right;
    while (b != 0) {
        let remainder: usize = a % b;
        a = b;
        b = remainder;
    }
    return a;
}

// Walks an lvalue syntax chain (names, dereferences, member accesses and
// indexes) accumulating the static byte offset and the gcd of dynamic index
// strides relative to the innermost base, returning the chain's type.
fn address_chain_type(
    context: *context::Context,
    node_id: usize,
    offset: *usize,
    stride: *usize
) -> usize {
    let none: usize = context::no_id();
    let node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind ==
            parser::SyntaxKind.parenthesized_expression &&
        node.child_count == 1) {
        return address_chain_type(
            context,
            node.first_child,
            offset,
            stride
        );
    }
    if (node.kind == parser::SyntaxKind.name_expression) {
        let local_id: usize = context::find_local(
            context,
            context->current_unit,
            node.token_index
        );
        if (local_id == none) {
            return none;
        }
        let locals: *const context::Local =
            context->locals.data as
                *const context::Local;
        *offset = 0;
        *stride = 0;
        return locals[local_id].type_id;
    }
    if (node.child_count == 0) {
        return none;
    }
    let base_type: usize = address_chain_type(
        context,
        node.first_child,
        offset,
        stride
    );
    if (base_type == none) {
        return none;
    }
    let base_record: type_info::Record =
        context::type_record(context, base_type);
    let operation: lexer::TokenKind =
        context::token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    if (node.kind == parser::SyntaxKind.unary_expression &&
        node.child_count == 1 &&
        operation == lexer::TokenKind.star) {
        if (base_record.kind != type_info::Kind.pointer) {
            return none;
        }
        *offset = 0;
        *stride = 0;
        return base_record.element_type;
    }
    if (node.kind == parser::SyntaxKind.member_expression &&
        node.child_count == 2) {
        var owner_type: usize = base_type;
        if (operation == lexer::TokenKind.arrow) {
            if (base_record.kind != type_info::Kind.pointer) {
                return none;
            }
            owner_type = base_record.element_type;
            *offset = 0;
            *stride = 0;
        } else if (operation != lexer::TokenKind.dot) {
            return none;
        }
        let owner_record: type_info::Record =
            context::type_record(context, owner_type);
        if (owner_record.kind != type_info::Kind.structure &&
            owner_record.kind !=
                type_info::Kind.record_union) {
            return none;
        }
        let base_node: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                node.first_child
            );
        let lookup: types::FieldLookup =
            types::lookup_field(
                context,
                owner_type,
                context->current_unit,
                context::node(
                    context,
                    context->current_unit,
                    base_node.next_sibling
                ).token_index
            );
        if (lookup.status != types::FieldStatus.found) {
            return none;
        }
        let fields: *const type_info::Field =
            context->types.fields.data as
                *const type_info::Field;
        *offset += lookup.offset_bytes;
        return fields[lookup.field_id].type_id;
    }
    if (node.kind == parser::SyntaxKind.index_expression &&
        node.child_count == 2) {
        if (base_record.kind != type_info::Kind.array &&
            base_record.kind != type_info::Kind.pointer) {
            return none;
        }
        let element_size: usize =
            context::type_record(
                context,
                base_record.element_type
            ).size_bytes;
        if (base_record.kind == type_info::Kind.pointer) {
            *offset = 0;
            *stride = 0;
        }
        *stride = address_chain_gcd(
            *stride,
            element_size
        );
        return base_record.element_type;
    }
    return none;
}

fn address_is_aligned(
    context: *context::Context,
    node_id: usize,
    alignment: usize
) -> bool {
    var offset: usize = 0;
    var stride: usize = 0;
    if (address_chain_type(
            context,
            node_id,
            &offset,
            &stride
        ) == context::no_id()) {
        return true;
    }
    return address_chain_gcd(offset, stride) %
        alignment == 0;
}

fn lower_unary(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    if (node.child_count != 1) {
        return invalid_expression();
    }
    let operation: lexer::TokenKind =
        context::token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    let operand_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let expected_record: type_info::Record =
        context::type_record(
            context,
            type_for_integer_literal(
                context,
                expected_type
            )
        );
    if (operation == lexer::TokenKind.minus &&
        operand_node.kind ==
            parser::SyntaxKind.integer_expression &&
        type_info::is_signed_integer(
            expected_record.kind
        )) {
        return lower_negative_integer_literal(
            context,
            node,
            operand_node,
            expected_type
        );
    }
    if (operation == lexer::TokenKind.ampersand &&
        operand_node.kind ==
            parser::SyntaxKind.name_expression) {
        var address_symbol: usize = context::no_id();
        if (operand_node.child_count != 0) {
            address_symbol =
                context::lookup_qualified_symbol(
                    context,
                    context->current_unit,
                    operand_node,
                    context::SymbolKind.function,
                    false
                );
        } else if (context::find_local(
                context,
                context->current_unit,
                operand_node.token_index
            ) == context::no_id()) {
            address_symbol = context::lookup_symbol(
                context,
                context->current_unit,
                operand_node.token_index,
                context::SymbolKind.function
            );
        }
        if (address_symbol != context::no_id()) {
            return function_value(
                context,
                node,
                address_symbol
            );
        }
    }
    let operand: context::Expression =
        lower_expression(
            context,
            node.first_child,
            expected_type
        );
    if (!operand.valid) {
        return operand;
    }
    let operand_record: type_info::Record =
        context::type_record(
            context,
            operand.type_id
        );
    if (operation == lexer::TokenKind.ampersand) {
        if (operand.bitfield_segment !=
            context::no_id()) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_bitfield,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                operand.bitfield_segment
            );
            return invalid_expression();
        }
        if (!operand.lvalue) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_lvalue,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                operand.type_id
            );
            return invalid_expression();
        }
        if (operand_record.alignment_bytes > 1 &&
            !address_is_aligned(
                context,
                node.first_child,
                operand_record.alignment_bytes
            )) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind
                    .unaligned_field_address,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                operand.type_id
            );
            return invalid_expression();
        }
        let pointer: type_info::IdResult =
            type_info::table_pointer(
                &context->types,
                operand.type_id,
                !operand.mutable_lvalue,
                operand.volatile_lvalue
            );
        context->error = pointer.error;
        var result: context::Expression = operand;
        result.type_id = pointer.type_id;
        result.value_id = operand.address_id;
        result.address_id = context::no_id();
        result.lvalue = false;
        result.mutable_lvalue = false;
        result.volatile_lvalue = false;
        return result;
    }
    if (operation == lexer::TokenKind.star) {
        if (operand_record.kind !=
                type_info::Kind.pointer ||
            context::type_record(
                context,
                operand_record.element_type
            ).kind == type_info::Kind.type_void) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_operator,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                operand.type_id
            );
            return invalid_expression();
        }
        var check: ir::Instruction =
            context::instruction(
                ir::Opcode.null_check,
                node
            );
        check.left = operand.value_id;
        context::emit_void(context, check);
        let result: context::Expression = {
            type_id = operand_record.element_type,
            value_id = context::no_id(),
            address_id = operand.value_id,
            constant_value = 0,
            has_constant = false,
            lvalue = true,
            mutable_lvalue =
                (operand_record.flags &
                    (type_info::Flag.read_only as usize)) == 0,
            volatile_lvalue =
                (operand_record.flags &
                    (type_info::Flag.volatile_pointee as usize)) != 0,
            valid = true,
            bitfield_segment = context::no_id(),
        };
        return context::load_lvalue(
            context,
            node,
            result
        );
    }
    if (operation == lexer::TokenKind.plus) {
        if (!type_info::is_integer(operand_record.kind) &&
            !type_info::is_float(operand_record.kind)) {
            return invalid_expression();
        }
        return operand;
    }
    var opcode: ir::Opcode =
        ir::Opcode.invalid;
    if (operation == lexer::TokenKind.minus &&
        type_info::is_integer(operand_record.kind)) {
        opcode = ir::Opcode.unary_integer;
    } else if (operation == lexer::TokenKind.minus &&
        type_info::is_float(operand_record.kind)) {
        opcode = ir::Opcode.unary_float;
    } else if (operation == lexer::TokenKind.tilde &&
        type_info::is_integer(operand_record.kind)) {
        opcode = ir::Opcode.unary_integer;
    } else if (operation == lexer::TokenKind.bang &&
        operand_record.kind == type_info::Kind.boolean) {
        opcode = ir::Opcode.boolean_not;
    }
    if (opcode == ir::Opcode.invalid) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_operator,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            operand.type_id
        );
        return invalid_expression();
    }
    var instruction: ir::Instruction =
        context::instruction(opcode, node);
    instruction.operation = operation;
    instruction.left = operand.value_id;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        operand.type_id
    );
    var constant_value: u64 = 0;
    var has_constant: bool = false;
    if (operand.has_constant) {
        if (operation == lexer::TokenKind.minus &&
            type_info::is_integer(operand_record.kind)) {
            constant_value = context::mask_integer(
                0 - operand.constant_value,
                type_info::bit_width(operand_record.kind)
            );
            has_constant = true;
        } else if (operation == lexer::TokenKind.tilde) {
            constant_value = context::mask_integer(
                ~operand.constant_value,
                type_info::bit_width(operand_record.kind)
            );
            has_constant = true;
        } else if (operation == lexer::TokenKind.bang) {
            constant_value =
                operand.constant_value == 0 ? 1 : 0;
            has_constant = true;
        }
    }
    return {
        type_id = operand.type_id,
        value_id = value_id,
        address_id = context::no_id(),
        constant_value = constant_value,
        has_constant = has_constant,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
}

fn cast_is_valid(
    source: type_info::Record,
    target: type_info::Record,
    source_type: usize,
    target_type: usize
) -> bool {
    if (source_type == target_type) {
        return true;
    }
    if (type_info::is_integer(source.kind) &&
        type_info::is_integer(target.kind)) {
        return true;
    }
    if ((type_info::is_integer(source.kind) &&
            type_info::is_float(target.kind)) ||
        (type_info::is_float(source.kind) &&
            type_info::is_integer(target.kind)) ||
        (type_info::is_float(source.kind) &&
            type_info::is_float(target.kind))) {
        return true;
    }
    if (source.kind == type_info::Kind.enumeration) {
        return source.element_type == target_type;
    }
    if (target.kind == type_info::Kind.enumeration) {
        return target.element_type == source_type;
    }
    if (source.kind == type_info::Kind.pointer &&
        target.kind == type_info::Kind.pointer) {
        let drops_read_only: bool =
            (source.flags &
                (type_info::Flag.read_only as usize)) != 0 &&
            (target.flags &
                (type_info::Flag.read_only as usize)) == 0;
        let drops_volatile: bool =
            (source.flags &
                (type_info::Flag.volatile_pointee as usize)) != 0 &&
            (target.flags &
                (type_info::Flag.volatile_pointee as usize)) == 0;
        return !drops_read_only && !drops_volatile;
    }
    if (source.kind == type_info::Kind.function_pointer &&
        target.kind == type_info::Kind.function_pointer) {
        return true;
    }
    if (source.kind == type_info::Kind.function_pointer &&
        target.kind == type_info::Kind.unsigned_size) {
        return true;
    }
    if (target.kind == type_info::Kind.function_pointer &&
        source.kind == type_info::Kind.unsigned_size) {
        return true;
    }
    if (source.kind == type_info::Kind.pointer) {
        return target.kind ==
            type_info::Kind.unsigned_size;
    }
    if (target.kind == type_info::Kind.pointer) {
        return source.kind ==
            type_info::Kind.unsigned_size;
    }
    return false;
}

fn default_literal_family(
    context: *context::Context,
    node_id: usize
) -> context::LiteralFamily {
    let node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind ==
        parser::SyntaxKind.integer_expression) {
        return context::LiteralFamily.integer;
    }
    if (node.kind ==
        parser::SyntaxKind.character_expression) {
        return context::LiteralFamily.integer;
    }
    if (node.kind ==
        parser::SyntaxKind.floating_expression) {
        return context::LiteralFamily.floating;
    }
    if (node.kind == parser::SyntaxKind.null_expression) {
        return context::LiteralFamily.null_pointer;
    }
    if (node.kind ==
            parser::SyntaxKind.parenthesized_expression &&
        node.child_count == 1) {
        return default_literal_family(
            context,
            node.first_child
        );
    }
    if (node.kind == parser::SyntaxKind.unary_expression &&
        node.child_count == 1) {
        let operation: lexer::TokenKind =
            context::token(
                context,
                context->current_unit,
                node.token_index
            ).kind;
        if (operation == lexer::TokenKind.plus ||
            operation == lexer::TokenKind.minus) {
            return default_literal_family(
                context,
                node.first_child
            );
        }
        return context::LiteralFamily.none;
    }
    if (node.kind == parser::SyntaxKind.binary_expression &&
        node.child_count == 2) {
        let left: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                node.first_child
            );
        let left_family: context::LiteralFamily =
            default_literal_family(
                context,
                node.first_child
            );
        let right_family: context::LiteralFamily =
            default_literal_family(
                context,
                left.next_sibling
            );
        if (left_family ==
                context::LiteralFamily.floating ||
            right_family ==
                context::LiteralFamily.floating) {
            if ((left_family ==
                    context::LiteralFamily.integer ||
                    left_family ==
                        context::LiteralFamily.floating) &&
                (right_family ==
                    context::LiteralFamily.integer ||
                    right_family ==
                        context::LiteralFamily.floating)) {
                return context::LiteralFamily.floating;
            }
            return context::LiteralFamily.none;
        }
        return left_family ==
                context::LiteralFamily.integer &&
            right_family ==
                context::LiteralFamily.integer ?
            context::LiteralFamily.integer :
            context::LiteralFamily.none;
    }
    if (node.kind ==
            parser::SyntaxKind.conditional_expression &&
        node.child_count == 3) {
        let condition: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                node.first_child
            );
        let then_node: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                condition.next_sibling
            );
        let then_family: context::LiteralFamily =
            default_literal_family(
                context,
                condition.next_sibling
            );
        let else_family: context::LiteralFamily =
            default_literal_family(
                context,
                then_node.next_sibling
            );
        return then_family == else_family ?
            then_family : context::LiteralFamily.none;
    }
    return context::LiteralFamily.none;
}

fn lower_cast(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    if (node.child_count != 2) {
        return invalid_expression();
    }
    let operand_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let target_node: usize = operand_node.next_sibling;
    let target_type: usize =
        types::resolve_type_node(
            context,
            context->current_unit,
            target_node
        );
    if (target_type == context::no_id()) {
        return invalid_expression();
    }
    let target_record: type_info::Record =
        context::type_record(
            context,
            target_type
        );
    let target_storage: usize =
        target_record.kind ==
            type_info::Kind.enumeration ?
            target_record.element_type : target_type;
    let target_storage_record: type_info::Record =
        context::type_record(
            context,
            target_storage
        );
    let literal_family: context::LiteralFamily =
        default_literal_family(
            context,
            node.first_child
        );
    var operand_expected: usize =
        context::no_id();
    if (literal_family ==
            context::LiteralFamily.integer &&
        type_info::is_integer(
            target_storage_record.kind
        )) {
        operand_expected = target_storage;
    } else if (literal_family ==
            context::LiteralFamily.floating &&
        type_info::is_float(target_record.kind)) {
        operand_expected = target_type;
    } else if (literal_family ==
            context::LiteralFamily.null_pointer &&
        target_record.kind == type_info::Kind.pointer) {
        operand_expected = target_type;
    }
    let operand: context::Expression =
        lower_expression(
            context,
            node.first_child,
            operand_expected
        );
    if (!operand.valid) {
        return invalid_expression();
    }
    let source_record: type_info::Record =
        context::type_record(
            context,
            operand.type_id
        );
    if (!cast_is_valid(
            source_record,
            target_record,
            operand.type_id,
            target_type
        )) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_cast,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            target_type
        );
        return invalid_expression();
    }
    if (target_type == operand.type_id) {
        return operand;
    }
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.convert,
            node
        );
    instruction.left = operand.value_id;
    instruction.auxiliary = operand.type_id;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        target_type
    );
    return {
        type_id = target_type,
        value_id = value_id,
        address_id = context::no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
}

fn binary_is_comparison(
    operation: lexer::TokenKind
) -> bool {
    return operation == lexer::TokenKind.equal_equal ||
        operation == lexer::TokenKind.bang_equal ||
        operation == lexer::TokenKind.less ||
        operation == lexer::TokenKind.less_equal ||
        operation == lexer::TokenKind.greater ||
        operation == lexer::TokenKind.greater_equal;
}

fn binary_is_equality(
    operation: lexer::TokenKind
) -> bool {
    return operation == lexer::TokenKind.equal_equal ||
        operation == lexer::TokenKind.bang_equal;
}

fn binary_is_arithmetic(
    operation: lexer::TokenKind
) -> bool {
    return operation == lexer::TokenKind.plus ||
        operation == lexer::TokenKind.minus ||
        operation == lexer::TokenKind.star ||
        operation == lexer::TokenKind.slash ||
        operation == lexer::TokenKind.percent;
}

fn binary_is_bitwise(
    operation: lexer::TokenKind
) -> bool {
    return operation == lexer::TokenKind.ampersand ||
        operation == lexer::TokenKind.pipe ||
        operation == lexer::TokenKind.caret ||
        operation == lexer::TokenKind.shift_left ||
        operation == lexer::TokenKind.shift_right;
}

fn lower_short_circuit(
    context: *context::Context,
    node: parser::SyntaxNode,
    operation: lexer::TokenKind
) -> context::Expression {
    let none: usize = context::no_id();
    let left_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let left: context::Expression =
        lower_expression(
            context,
            node.first_child,
            type_info::BuiltinType.boolean as usize
        );
    if (!left.valid ||
        left.type_id != type_info::BuiltinType.boolean as usize) {
        return invalid_expression();
    }
    let slot_id: usize = ir::add_slot(
        &context->ir,
        context::current_ir_function(context),
        type_info::BuiltinType.boolean as usize,
        true,
        false,
        0
    );
    let address: usize = context::address_of_slot(
        context,
        node,
        slot_id,
        type_info::BuiltinType.boolean as usize,
        false,
        false
    );
    context::store_to_address(
        context,
        node,
        address,
        type_info::BuiltinType.boolean as usize,
        left
    );
    let right_block: usize =
        context::add_current_block(context);
    let merge_block: usize =
        context::add_current_block(context);
    if (operation == lexer::TokenKind.logical_and) {
        context::emit_branch(
            context,
            node,
            left.value_id,
            right_block,
            merge_block
        );
    } else {
        context::emit_branch(
            context,
            node,
            left.value_id,
            merge_block,
            right_block
        );
    }
    context->current_block = right_block;
    let right: context::Expression =
        lower_expression(
            context,
            left_node.next_sibling,
            type_info::BuiltinType.boolean as usize
        );
    if (!right.valid ||
        right.type_id != type_info::BuiltinType.boolean as usize) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            type_info::BuiltinType.boolean as usize
        );
        return invalid_expression();
    }
    context::store_to_address(
        context,
        node,
        address,
        type_info::BuiltinType.boolean as usize,
        right
    );
    context::emit_jump(
        context,
        node,
        merge_block
    );
    context->current_block = merge_block;
    let source: context::Expression = {
        type_id = type_info::BuiltinType.boolean as usize,
        value_id = none,
        address_id = address,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = true,
        bitfield_segment = context::no_id(),
    };
    let result: context::Expression =
        context::load_lvalue(
            context,
            node,
            source
        );
    var final_result: context::Expression = result;
    final_result.lvalue = false;
    return final_result;
}

fn convert_to_usize(
    context: *context::Context,
    node: parser::SyntaxNode,
    source_value: usize,
    source_type: usize
) -> usize {
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.convert,
            node
        );
    instruction.left = source_value;
    instruction.auxiliary = source_type;
    return context::emit_value(
        context,
        instruction,
        type_info::BuiltinType.unsigned_size as usize
    );
}

fn pointer_arithmetic_is_allowed(
    context: *context::Context,
    pointer_type: usize
) -> bool {
    let record: type_info::Record =
        context::type_record(context, pointer_type);
    if (record.kind != type_info::Kind.pointer ||
        record.element_type ==
            context::no_id()) {
        return false;
    }
    let element: type_info::Record =
        context::type_record(
            context,
            record.element_type
        );
    return element.kind != type_info::Kind.type_void &&
        element.kind != type_info::Kind.array &&
        element.size_bytes != 0;
}

fn emit_negated_usize(
    context: *context::Context,
    node: parser::SyntaxNode,
    value_id: usize
) -> usize {
    let zero: context::Expression =
        context::emit_integer_constant(
            context,
            node,
            type_info::BuiltinType.unsigned_size as usize,
            0
        );
    var negated: ir::Instruction =
        context::instruction(
            ir::Opcode.binary_integer,
            node
        );
    negated.operation = lexer::TokenKind.minus;
    negated.left = zero.value_id;
    negated.right = value_id;
    return context::emit_value(
        context,
        negated,
        type_info::BuiltinType.unsigned_size as usize
    );
}

fn emit_pointer_offset(
    context: *context::Context,
    node: parser::SyntaxNode,
    pointer_value: usize,
    pointer_type: usize,
    count_value: usize
) -> usize {
    let record: type_info::Record =
        context::type_record(context, pointer_type);
    let element: type_info::Record =
        context::type_record(
            context,
            record.element_type
        );
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.pointer_offset,
            node
        );
    instruction.left = pointer_value;
    instruction.right = count_value;
    instruction.auxiliary = element.size_bytes;
    return context::emit_value(
        context,
        instruction,
        pointer_type
    );
}

fn lower_binary(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    if (node.child_count != 2) {
        return invalid_expression();
    }
    let left_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let operation: lexer::TokenKind =
        context::token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    if (operation == lexer::TokenKind.logical_and ||
        operation == lexer::TokenKind.logical_or) {
        return lower_short_circuit(
            context,
            node,
            operation
        );
    }
    let operand_expected: usize =
        binary_is_comparison(operation) ?
            context::no_id() : expected_type;
    let left: context::Expression =
        lower_expression(
            context,
            node.first_child,
            operand_expected
        );
    let right: context::Expression =
        lower_expression(
            context,
            left_node.next_sibling,
            left.valid ? left.type_id : operand_expected
        );
    if (!left.valid || !right.valid) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            left.valid ? left.type_id : right.type_id
        );
        return invalid_expression();
    }
    let left_record: type_info::Record =
        context::type_record(context, left.type_id);
    let right_record: type_info::Record =
        context::type_record(context, right.type_id);
    let additive: bool =
        operation == lexer::TokenKind.plus ||
        operation == lexer::TokenKind.minus;
    let left_is_pointer: bool =
        left_record.kind == type_info::Kind.pointer;
    let right_is_pointer: bool =
        right_record.kind == type_info::Kind.pointer;
    if (additive && (left_is_pointer != right_is_pointer)) {
        let pointer_type: usize = left_is_pointer ?
            left.type_id : right.type_id;
        let count_type: usize = left_is_pointer ?
            right.type_id : left.type_id;
        if (count_type !=
                type_info::BuiltinType.unsigned_size as usize ||
            !pointer_arithmetic_is_allowed(
                context,
                pointer_type
            )) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.invalid_operator,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                left.type_id
            );
            return invalid_expression();
        }
        let pointer_value: usize = left_is_pointer ?
            left.value_id : right.value_id;
        var count_value: usize = left_is_pointer ?
            right.value_id : left.value_id;
        if (operation == lexer::TokenKind.minus) {
            count_value =
                emit_negated_usize(
                    context,
                    node,
                    count_value
                );
        }
        let value_id: usize =
            emit_pointer_offset(
                context,
                node,
                pointer_value,
                pointer_type,
                count_value
            );
        return {
            type_id = pointer_type,
            value_id = value_id,
            address_id = context::no_id(),
            constant_value = 0,
            has_constant = false,
            lvalue = false,
            mutable_lvalue = false,
            volatile_lvalue = false,
            valid = value_id != context::no_id(),
            bitfield_segment = context::no_id(),
        };
    }
    if (operation == lexer::TokenKind.minus &&
        left_is_pointer && right_is_pointer &&
        left.type_id == right.type_id &&
        pointer_arithmetic_is_allowed(
            context,
            left.type_id
        )) {
        let pointee: type_info::Record =
            context::type_record(
                context,
                left_record.element_type
            );
        let left_raw: usize =
            convert_to_usize(
                context,
                node,
                left.value_id,
                left.type_id
            );
        let right_raw: usize =
            convert_to_usize(
                context,
                node,
                right.value_id,
                right.type_id
            );
        var difference: ir::Instruction =
            context::instruction(
                ir::Opcode.binary_integer,
                node
            );
        difference.operation = lexer::TokenKind.minus;
        difference.left = left_raw;
        difference.right = right_raw;
        var byte_distance: usize =
            context::emit_value(
                context,
                difference,
                type_info::BuiltinType.unsigned_size as usize
            );
        if (pointee.size_bytes != 1 &&
            byte_distance !=
                context::no_id()) {
            let scale: context::Expression =
                context::emit_integer_constant(
                    context,
                    node,
                    type_info::BuiltinType.unsigned_size as
                        usize,
                    pointee.size_bytes as u64
                );
            var quotient: ir::Instruction =
                context::instruction(
                    ir::Opcode.binary_integer,
                    node
                );
            quotient.operation = lexer::TokenKind.slash;
            quotient.left = byte_distance;
            quotient.right = scale.value_id;
            byte_distance = context::emit_value(
                context,
                quotient,
                type_info::BuiltinType.unsigned_size as usize
            );
        }
        return {
            type_id =
                type_info::BuiltinType.unsigned_size as usize,
            value_id = byte_distance,
            address_id = context::no_id(),
            constant_value = 0,
            has_constant = false,
            lvalue = false,
            mutable_lvalue = false,
            volatile_lvalue = false,
            valid = byte_distance !=
                context::no_id(),
            bitfield_segment = context::no_id(),
        };
    }
    if (left.type_id != right.type_id) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            left.type_id
        );
        return invalid_expression();
    }
    let type_record: type_info::Record =
        context::type_record(
            context,
            left.type_id
        );
    var opcode: ir::Opcode =
        ir::Opcode.invalid;
    var result_type: usize = left.type_id;
    if (binary_is_comparison(operation) &&
        type_record.kind == type_info::Kind.pointer &&
        !binary_is_equality(operation)) {
        let left_raw: usize =
            convert_to_usize(
                context,
                node,
                left.value_id,
                left.type_id
            );
        let right_raw: usize =
            convert_to_usize(
                context,
                node,
                right.value_id,
                right.type_id
            );
        var instruction: ir::Instruction =
            context::instruction(
                ir::Opcode.compare,
                node
            );
        instruction.operation = operation;
        instruction.left = left_raw;
        instruction.right = right_raw;
        let value_id: usize = context::emit_value(
            context,
            instruction,
            type_info::BuiltinType.boolean as usize
        );
        return {
            type_id =
                type_info::BuiltinType.boolean as usize,
            value_id = value_id,
            address_id = context::no_id(),
            constant_value = 0,
            has_constant = false,
            lvalue = false,
            mutable_lvalue = false,
            volatile_lvalue = false,
            valid = value_id != context::no_id(),
            bitfield_segment = context::no_id(),
        };
    }
    if (binary_is_comparison(operation)) {
        let equality: bool =
            operation == lexer::TokenKind.equal_equal ||
            operation == lexer::TokenKind.bang_equal;
        if ((equality &&
                type_info::is_scalar(type_record.kind)) ||
            (!equality &&
                (type_info::is_integer(type_record.kind) ||
                    type_info::is_float(type_record.kind)))) {
            opcode = ir::Opcode.compare;
            result_type =
                type_info::BuiltinType.boolean as usize;
        }
    } else if (binary_is_arithmetic(
            operation
        )) {
        if (type_info::is_integer(type_record.kind)) {
            opcode = ir::Opcode.binary_integer;
        } else if (type_info::is_float(type_record.kind) &&
            operation != lexer::TokenKind.percent) {
            opcode = ir::Opcode.binary_float;
        }
    } else if (binary_is_bitwise(
            operation
        ) && type_info::is_integer(type_record.kind)) {
        opcode = ir::Opcode.binary_integer;
    }
    if (opcode == ir::Opcode.invalid) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_operator,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            left.type_id
        );
        return invalid_expression();
    }
    var instruction: ir::Instruction =
        context::instruction(opcode, node);
    instruction.operation = operation;
    instruction.left = left.value_id;
    instruction.right = right.value_id;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        result_type
    );
    return {
        type_id = result_type,
        value_id = value_id,
        address_id = context::no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != context::no_id(),
        bitfield_segment = context::no_id(),
    };
}

fn lower_conditional(
    context: *context::Context,
    node: parser::SyntaxNode,
    expected_type: usize
) -> context::Expression {
    let none: usize = context::no_id();
    if (node.child_count != 3) {
        return invalid_expression();
    }
    let condition_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            node.first_child
        );
    let then_node: parser::SyntaxNode =
        context::node(
            context,
            context->current_unit,
            condition_node.next_sibling
        );
    let condition: context::Expression =
        lower_expression(
            context,
            node.first_child,
            type_info::BuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            type_info::BuiltinType.boolean as usize) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_condition,
            context->current_unit,
            condition_node.span,
            none,
            context::empty_span(),
            condition.type_id
        );
        return invalid_expression();
    }
    let then_block: usize =
        context::add_current_block(context);
    let else_block: usize =
        context::add_current_block(context);
    let merge_block: usize =
        context::add_current_block(context);
    context::emit_branch(
        context,
        node,
        condition.value_id,
        then_block,
        else_block
    );
    context->current_block = then_block;
    let then_value: context::Expression =
        lower_expression(
            context,
            condition_node.next_sibling,
            expected_type
        );
    if (!then_value.valid) {
        return then_value;
    }
    let result_slot: usize = ir::add_slot(
        &context->ir,
        context::current_ir_function(context),
        then_value.type_id,
        true,
        false,
        0
    );
    let then_address: usize =
        context::address_of_slot(
            context,
            node,
            result_slot,
            then_value.type_id,
            false,
            false
        );
    context::store_to_address(
        context,
        node,
        then_address,
        then_value.type_id,
        then_value
    );
    context::emit_jump(
        context,
        node,
        merge_block
    );
    context->current_block = else_block;
    let else_value: context::Expression =
        lower_expression(
            context,
            then_node.next_sibling,
            then_value.type_id
        );
    if (!else_value.valid ||
        else_value.type_id != then_value.type_id) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            then_value.type_id
        );
        return invalid_expression();
    }
    let else_address: usize =
        context::address_of_slot(
            context,
            node,
            result_slot,
            then_value.type_id,
            false,
            false
        );
    context::store_to_address(
        context,
        node,
        else_address,
        then_value.type_id,
        else_value
    );
    context::emit_jump(
        context,
        node,
        merge_block
    );
    context->current_block = merge_block;
    let result_address: usize =
        context::address_of_slot(
            context,
            node,
            result_slot,
            then_value.type_id,
            false,
            false
        );
    let type_record: type_info::Record =
        context::type_record(
            context,
            then_value.type_id
        );
    if (type_info::is_memory(type_record.kind)) {
        return {
            type_id = then_value.type_id,
            value_id = none,
            address_id = result_address,
            constant_value = 0,
            has_constant = false,
            lvalue = false,
            mutable_lvalue = false,
            volatile_lvalue = false,
            valid = true,
            bitfield_segment = context::no_id(),
        };
    }
    let source: context::Expression = {
        type_id = then_value.type_id,
        value_id = none,
        address_id = result_address,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = true,
        bitfield_segment = context::no_id(),
    };
    let result: context::Expression =
        context::load_lvalue(
            context,
            node,
            source
        );
    var final_result: context::Expression = result;
    final_result.lvalue = false;
    return final_result;
}

fn lower_va_arg(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    let none: usize = context::no_id();
    if (node.child_count != 2) {
        context->error = runtime::Error.invalid_argument;
        return invalid_expression();
    }
    if (!context::current_function_is_variadic(context)) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_va_list,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            0
        );
        return invalid_expression();
    }
    let list: context::Expression =
        lower_expression(
            context,
            node.first_child,
            none
        );
    if (!list.valid) {
        return list;
    }
    if (!list.lvalue || !list.mutable_lvalue ||
        list.type_id != (type_info::BuiltinType.va_list_type as usize)) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_va_list,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            0
        );
        return invalid_expression();
    }
    let type_id: usize =
        types::resolve_type_node(
            context,
            context->current_unit,
            context::node(
                context,
                context->current_unit,
                node.first_child
            ).next_sibling
        );
    if (type_id == none) {
        return invalid_expression();
    }
    let record: type_info::Record =
        context::type_record(context, type_id);
    // Extraction is by argument class only, so the requested type must be a
    // scalar; aggregates have no register-save slot shape to read.
    if (!type_info::is_scalar(record.kind)) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            none,
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    var instruction: ir::Instruction =
        context::instruction(
            ir::Opcode.va_list_arg,
            node
        );
    instruction.left = list.address_id;
    let value_id: usize = context::emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != none,
        bitfield_segment = none,
    };
}

fn lower_layout_query(
    context: *context::Context,
    node: parser::SyntaxNode
) -> context::Expression {
    if (node.child_count == 0) {
        return invalid_expression();
    }
    var type_id: usize = context::no_id();
    if (context::node(
            context,
            context->current_unit,
            node.first_child
        ).kind ==
        parser::SyntaxKind.intrinsic_expression) {
        // Layout queries resolve type nodes; an intrinsic operand (e.g. sizeof(@embed("path"))) is
        // lowered as an expression instead and the query reads the lowered type's layout.
        let operand: context::Expression =
            lower_expression(
                context,
                node.first_child,
                context::no_id()
            );
        if (operand.valid) {
            type_id = operand.type_id;
        }
    } else {
        type_id =
            types::resolve_type_node(
                context,
                context->current_unit,
                node.first_child
            );
    }
    if (type_id == context::no_id() ||
        !types::require_complete_type(
            context,
            type_id
        )) {
        return invalid_expression();
    }
    let record: type_info::Record =
        context::type_record(context, type_id);
    if (record.kind == type_info::Kind.type_void ||
        record.size_bytes == 0 ||
        record.alignment_bytes == 0) {
        context::add_diagnostic(
            context,
            context::DiagnosticKind.invalid_layout_query,
            context->current_unit,
            node.span,
            context::no_id(),
            context::empty_span(),
            type_id
        );
        return invalid_expression();
    }
    var value: usize = 0;
    if (node.kind == parser::SyntaxKind.sizeof_expression) {
        value = record.size_bytes;
    } else if (node.kind ==
        parser::SyntaxKind.alignof_expression) {
        value = record.alignment_bytes;
    } else if (node.kind ==
        parser::SyntaxKind.offsetof_expression &&
        node.child_count >= 2) {
        let type_node: parser::SyntaxNode =
            context::node(
                context,
                context->current_unit,
                node.first_child
            );
        let fields: *const type_info::Field =
            context->types.fields.data as
                *const type_info::Field;
        var current_type: usize = type_id;
        var member_index: usize = type_node.next_sibling;
        var ambiguous: bool = false;
        var failed: bool = false;
        while (member_index != context::no_id() &&
            !ambiguous && !failed) {
            let member: parser::SyntaxNode =
                context::node(
                    context,
                    context->current_unit,
                    member_index
                );
            let lookup: types::FieldLookup =
                types::lookup_field(
                    context,
                    current_type,
                    context->current_unit,
                    member.token_index
                );
            if (lookup.status ==
                types::FieldStatus.ambiguous) {
                ambiguous = true;
            } else if (lookup.status !=
                types::FieldStatus.found) {
                // Missing fields and bitfield segments (which have no byte
                // offset) both reject the query.
                failed = true;
            } else {
                value += lookup.offset_bytes;
                current_type = fields[lookup.field_id].type_id;
            }
            member_index = member.next_sibling;
        }
        if (ambiguous) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind
                    .ambiguous_field,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                current_type
            );
            return invalid_expression();
        }
        if (failed) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind
                    .invalid_layout_query,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                current_type
            );
            return invalid_expression();
        }
    } else {
        return invalid_expression();
    }
    return context::emit_integer_constant(
        context,
        node,
        type_info::BuiltinType.unsigned_size as usize,
        value as u64
    );
}

fn lower_expression(
    context: *context::Context,
    node_id: usize,
    expected_type: usize
) -> context::Expression {
    let node: parser::SyntaxNode = context::node(
        context,
        context->current_unit,
        node_id
    );
    if (node.kind ==
        parser::SyntaxKind.integer_expression) {
        return lower_integer_literal(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        parser::SyntaxKind.character_expression) {
        return lower_character_literal(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        parser::SyntaxKind.floating_expression) {
        return lower_floating_literal(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        parser::SyntaxKind.boolean_expression) {
        return context::emit_boolean_constant(
            context,
            node,
            context::token(
                context,
                context->current_unit,
                node.token_index
            ).kind == lexer::TokenKind.keyword_true
        );
    }
    if (node.kind ==
        parser::SyntaxKind.string_expression) {
        return lower_string_literal(
            context,
            node
        );
    }
    if (node.kind == parser::SyntaxKind.null_expression) {
        if (expected_type >= context->types.type_count ||
            (context::type_record(
                    context,
                    expected_type
                ).kind != type_info::Kind.pointer &&
                context::type_record(
                    context,
                    expected_type
                ).kind !=
                    type_info::Kind.function_pointer)) {
            context::add_diagnostic(
                context,
                context::DiagnosticKind.type_mismatch,
                context->current_unit,
                node.span,
                context::no_id(),
                context::empty_span(),
                expected_type
            );
            return invalid_expression();
        }
        var instruction: ir::Instruction =
            context::instruction(
                ir::Opcode.constant_null,
                node
            );
        let value_id: usize = context::emit_value(
            context,
            instruction,
            expected_type
        );
        return {
            type_id = expected_type,
            value_id = value_id,
            address_id = context::no_id(),
            constant_value = 0,
            has_constant = true,
            lvalue = false,
            mutable_lvalue = false,
            volatile_lvalue = false,
            valid = value_id != context::no_id(),
            bitfield_segment = context::no_id(),
        };
    }
    if (node.kind == parser::SyntaxKind.name_expression) {
        return lower_name(context, node);
    }
    if (node.kind ==
        parser::SyntaxKind.parenthesized_expression) {
        if (node.child_count != 1) {
            return invalid_expression();
        }
        return lower_expression(
            context,
            node.first_child,
            expected_type
        );
    }
    if (node.kind == parser::SyntaxKind.call_expression) {
        return lower_call(context, node);
    }
    if (node.kind ==
        parser::SyntaxKind.intrinsic_expression) {
        let intrinsic: usize =
            intrinsics::intrinsic_resolve(context, node);
        if (intrinsic == context::no_id()) {
            return invalid_expression();
        }
        if (intrinsics::intrinsic_entry(intrinsic).operand_class ==
            intrinsics::IntrinsicOperandClass.embedded_file) {
            // @embed needs the argument's syntax node (string decoding lives here, and the import
            // order forbids intrinsics.la from reaching it), so it lowers before the operands.
            return lower_embed(context, node);
        }
        var operand: context::Expression =
            invalid_expression();
        if (node.child_count != 0) {
            operand = lower_expression(
                context,
                node.first_child,
                context::no_id()
            );
        }
        var count: context::Expression =
            invalid_expression();
        var destination: context::Expression =
            invalid_expression();
        if (operand.valid && node.child_count >= 2) {
            let second: usize =
                context::node(
                    context,
                    context->current_unit,
                    node.first_child
                ).next_sibling;
            count = lower_expression(
                context,
                second,
                node.child_count == 3 ?
                    operand.type_id :
                    type_info::BuiltinType.unsigned_size as usize
            );
            if (count.valid && node.child_count == 3) {
                destination = lower_expression(
                    context,
                    context::node(
                        context,
                        context->current_unit,
                        second
                    ).next_sibling,
                    context::no_id()
                );
            }
        }
        return intrinsics::lower_intrinsic(
            context,
            node,
            intrinsic,
            operand,
            count,
            destination
        );
    }
    if (node.kind == parser::SyntaxKind.index_expression) {
        return lower_index(context, node);
    }
    if (node.kind == parser::SyntaxKind.member_expression) {
        return lower_member(context, node);
    }
    if (node.kind == parser::SyntaxKind.unary_expression) {
        return lower_unary(
            context,
            node,
            expected_type
        );
    }
    if (node.kind == parser::SyntaxKind.cast_expression) {
        return lower_cast(context, node);
    }
    if (node.kind == parser::SyntaxKind.binary_expression) {
        return lower_binary(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        parser::SyntaxKind.conditional_expression) {
        return lower_conditional(
            context,
            node,
            expected_type
        );
    }
    if (node.kind == parser::SyntaxKind.zero_initializer ||
        node.kind ==
            parser::SyntaxKind.aggregate_initializer) {
        return lower_initializer(
            context,
            node_id,
            expected_type
        );
    }
    if (node.kind == parser::SyntaxKind.sizeof_expression ||
        node.kind == parser::SyntaxKind.alignof_expression ||
        node.kind == parser::SyntaxKind.offsetof_expression) {
        return lower_layout_query(
            context,
            node
        );
    }
    if (node.kind == parser::SyntaxKind.va_arg_expression) {
        return lower_va_arg(
            context,
            node
        );
    }
    context::add_diagnostic(
        context,
        context::DiagnosticKind.internal_invariant,
        context->current_unit,
        node.span,
        context::no_id(),
        context::empty_span(),
        node.kind as usize
    );
    return invalid_expression();
}
