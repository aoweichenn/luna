module luna.bootstrap.middleend.semantic.intrinsics;

enum BootstrapIntrinsicOperandClass: usize {
    integer_scalar,
    integer_scalar_rotated,
    integer_scalar_wide,
}

enum BootstrapIntrinsicLowering: usize {
    count_leading_zeros, count_trailing_zeros, population_count, rotate_left, rotate_right, byte_swap,
}

struct BootstrapIntrinsicEntry {
    name: *const u8;
    name_length: usize;
    arity: usize;
    operand_class: BootstrapIntrinsicOperandClass;
    lowering: BootstrapIntrinsicLowering;
}

struct BootstrapIntrinsicIntegerInfo {
    kind: BootstrapTypeKind;
    unsigned_type: usize;
    width: usize;
}

fn bootstrap_semantic_intrinsic_invalid_expression() -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    return {
        type_id = none,
        value_id = none,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = false,
    };
}

fn bootstrap_semantic_intrinsic_entry(index: usize) -> BootstrapIntrinsicEntry {
    var table: [6]BootstrapIntrinsicEntry = {};
    table[0] = {
        name = "clz", name_length = 3, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar,
        lowering = BootstrapIntrinsicLowering.count_leading_zeros,
    };
    table[1] = {
        name = "ctz", name_length = 3, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar,
        lowering = BootstrapIntrinsicLowering.count_trailing_zeros,
    };
    table[2] = {
        name = "popcount", name_length = 8, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar,
        lowering = BootstrapIntrinsicLowering.population_count,
    };
    table[3] = {
        name = "rotate_left", name_length = 11, arity = 2,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar_rotated,
        lowering = BootstrapIntrinsicLowering.rotate_left,
    };
    table[4] = {
        name = "rotate_right", name_length = 12, arity = 2,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar_rotated,
        lowering = BootstrapIntrinsicLowering.rotate_right,
    };
    table[5] = {
        name = "byte_swap", name_length = 9, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar_wide,
        lowering = BootstrapIntrinsicLowering.byte_swap,
    };
    return table[index];
}

fn bootstrap_semantic_intrinsic_integer_info(index: usize) -> BootstrapIntrinsicIntegerInfo {
    var table: [10]BootstrapIntrinsicIntegerInfo = {};
    table[0] = {
        kind = BootstrapTypeKind.signed_8,
        unsigned_type = BootstrapBuiltinType.unsigned_8 as usize, width = 8,
    };
    table[1] = {
        kind = BootstrapTypeKind.signed_16,
        unsigned_type = BootstrapBuiltinType.unsigned_16 as usize, width = 16,
    };
    table[2] = {
        kind = BootstrapTypeKind.signed_32,
        unsigned_type = BootstrapBuiltinType.unsigned_32 as usize, width = 32,
    };
    table[3] = {
        kind = BootstrapTypeKind.signed_64,
        unsigned_type = BootstrapBuiltinType.unsigned_64 as usize, width = 64,
    };
    table[4] = {
        kind = BootstrapTypeKind.signed_size,
        unsigned_type = BootstrapBuiltinType.unsigned_size as usize, width = 64,
    };
    table[5] = {
        kind = BootstrapTypeKind.unsigned_8,
        unsigned_type = BootstrapBuiltinType.unsigned_8 as usize, width = 8,
    };
    table[6] = {
        kind = BootstrapTypeKind.unsigned_16,
        unsigned_type = BootstrapBuiltinType.unsigned_16 as usize, width = 16,
    };
    table[7] = {
        kind = BootstrapTypeKind.unsigned_32,
        unsigned_type = BootstrapBuiltinType.unsigned_32 as usize, width = 32,
    };
    table[8] = {
        kind = BootstrapTypeKind.unsigned_64,
        unsigned_type = BootstrapBuiltinType.unsigned_64 as usize, width = 64,
    };
    table[9] = {
        kind = BootstrapTypeKind.unsigned_size,
        unsigned_type = BootstrapBuiltinType.unsigned_size as usize, width = 64,
    };
    return table[index];
}

fn bootstrap_semantic_intrinsic_constant(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, value: u64
) -> usize {
    let constant: BootstrapSemanticExpression =
        bootstrap_semantic_emit_integer_constant(context, node, type_id, value);
    return constant.value_id;
}

fn bootstrap_semantic_intrinsic_binary(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, operation: BootstrapTokenKind, type_id: usize,
    left: usize, right: usize
) -> usize {
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.binary_integer, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return bootstrap_semantic_emit_value(context, instruction, type_id);
}

fn bootstrap_semantic_intrinsic_shift(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, operation: BootstrapTokenKind, type_id: usize,
    value: usize, amount: usize
) -> usize {
    let count: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, amount as u64);
    return bootstrap_semantic_intrinsic_binary(context, node, operation, type_id, value, count);
}

fn bootstrap_semantic_intrinsic_convert(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, value: usize, source_type: usize, target_type: usize
) -> usize {
    if (source_type == target_type) {
        return value;
    }
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.convert, node);
    instruction.left = value;
    instruction.auxiliary = source_type;
    return bootstrap_semantic_emit_value(context, instruction, target_type);
}

// Sets every bit below the most significant set bit: x |= x >> 1; x |= x >> 2; ... x |= x >> (width / 2).
fn bootstrap_semantic_intrinsic_smear(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize
) -> usize {
    var result: usize = value;
    var shift: usize = 1;
    while (shift < width) {
        let shifted: usize = bootstrap_semantic_intrinsic_shift(
            context, node, BootstrapTokenKind.shift_right, type_id, result, shift);
        result = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.pipe, type_id, result, shifted);
        shift *= 2;
    }
    return result;
}

fn bootstrap_semantic_intrinsic_popcount(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize
) -> usize {
    let even_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x5555555555555555, width));
    let pair_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x3333333333333333, width));
    let nibble_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x0F0F0F0F0F0F0F0F, width));
    let lane_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x0101010101010101, width));
    var x: usize = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.minus, type_id, value,
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, type_id,
            bootstrap_semantic_intrinsic_shift(context, node, BootstrapTokenKind.shift_right, type_id, value, 1),
            even_bits));
    x = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.plus, type_id,
        bootstrap_semantic_intrinsic_binary(context, node, BootstrapTokenKind.ampersand, type_id, x, pair_bits),
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, type_id,
            bootstrap_semantic_intrinsic_shift(context, node, BootstrapTokenKind.shift_right, type_id, x, 2),
            pair_bits));
    x = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.ampersand, type_id,
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.plus, type_id, x,
            bootstrap_semantic_intrinsic_shift(context, node, BootstrapTokenKind.shift_right, type_id, x, 4)),
        nibble_bits);
    return bootstrap_semantic_intrinsic_shift(
        context, node, BootstrapTokenKind.shift_right, type_id,
        bootstrap_semantic_intrinsic_binary(context, node, BootstrapTokenKind.star, type_id, x, lane_bits),
        width - 8);
}

// s = n & (width - 1); rotated = (x << s) | (x >> ((width - s) & (width - 1))); every shift count stays in
// [0, width - 1]. rotate_right mirrors the two shift directions.
fn bootstrap_semantic_intrinsic_rotate(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize,
    count: usize, count_type: usize, left: bool
) -> usize {
    let mask: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, (width - 1) as u64);
    let n: usize = bootstrap_semantic_intrinsic_convert(context, node, count, count_type, type_id);
    let amount: usize = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.ampersand, type_id, n, mask);
    let complement: usize = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.ampersand, type_id,
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.minus, type_id,
            bootstrap_semantic_intrinsic_constant(context, node, type_id, width as u64), amount),
        mask);
    let forward: usize = bootstrap_semantic_intrinsic_binary(
        context, node, left ? BootstrapTokenKind.shift_left : BootstrapTokenKind.shift_right, type_id, value, amount);
    let backward: usize = bootstrap_semantic_intrinsic_binary(
        context, node, left ? BootstrapTokenKind.shift_right : BootstrapTokenKind.shift_left, type_id, value,
        complement);
    return bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.pipe, type_id, forward, backward);
}

// Isolates each byte and shifts it to the mirrored byte lane; shift amounts stay within [0, width - 8].
fn bootstrap_semantic_intrinsic_byte_swap(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    let byte_mask: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, 0xFF);
    let bytes: usize = width / 8;
    var result: usize = none;
    var index: usize = 0;
    while (index < bytes) {
        var term: usize = value;
        if (index != 0) {
            term = bootstrap_semantic_intrinsic_shift(
                context, node, BootstrapTokenKind.shift_right, type_id, term, index * 8);
        }
        term = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, type_id, term, byte_mask);
        let target: usize = (bytes - 1 - index) * 8;
        if (target != 0) {
            term = bootstrap_semantic_intrinsic_shift(
                context, node, BootstrapTokenKind.shift_left, type_id, term, target);
        }
        if (result == none) {
            result = term;
        } else {
            result = bootstrap_semantic_intrinsic_binary(
                context, node, BootstrapTokenKind.pipe, type_id, result, term);
        }
        index += 1;
    }
    return result;
}

fn bootstrap_semantic_intrinsic_resolve(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    var index: usize = 0;
    while (index < 6) {
        let entry: BootstrapIntrinsicEntry = bootstrap_semantic_intrinsic_entry(index);
        if (bootstrap_semantic_token_equals_bytes(
                context, context->current_unit, node.token_index, entry.name, entry.name_length)) {
            if (node.child_count != entry.arity) {
                bootstrap_semantic_add_diagnostic(
                    context, BootstrapSemanticDiagnosticKind.argument_count, context->current_unit, node.span, none,
                    bootstrap_semantic_empty_span(), entry.arity);
                return none;
            }
            return index;
        }
        index += 1;
    }
    bootstrap_semantic_add_diagnostic(
        context, BootstrapSemanticDiagnosticKind.unknown_intrinsic, context->current_unit, node.span, none,
        bootstrap_semantic_empty_span(), 0);
    return none;
}

fn bootstrap_semantic_lower_intrinsic(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, intrinsic_index: usize,
    operand: BootstrapSemanticExpression, count: BootstrapSemanticExpression
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let entry: BootstrapIntrinsicEntry = bootstrap_semantic_intrinsic_entry(intrinsic_index);
    if (!operand.valid || (entry.arity == 2 && !count.valid)) {
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    let record: BootstrapTypeRecord = bootstrap_semantic_type_record(context, operand.type_id);
    var width: usize = 0;
    var work_type: usize = none;
    var info_index: usize = 0;
    while (info_index < 10) {
        let info: BootstrapIntrinsicIntegerInfo = bootstrap_semantic_intrinsic_integer_info(info_index);
        if (info.kind == record.kind) {
            width = info.width;
            work_type = info.unsigned_type;
            break;
        }
        info_index += 1;
    }
    if (work_type == none ||
        (entry.operand_class == BootstrapIntrinsicOperandClass.integer_scalar_wide && width < 16) ||
        (entry.operand_class == BootstrapIntrinsicOperandClass.integer_scalar_rotated &&
            count.type_id != BootstrapBuiltinType.unsigned_size as usize)) {
        bootstrap_semantic_add_diagnostic(
            context, BootstrapSemanticDiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            bootstrap_semantic_empty_span(), operand.type_id);
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    // Signed operands are evaluated in the unsigned type of the same width so every expansion shift is
    // logical; the same-width conversions preserve the bit pattern and never trap.
    let x: usize =
        bootstrap_semantic_intrinsic_convert(context, node, operand.value_id, operand.type_id, work_type);
    var result: usize = none;
    switch (entry.lowering) {
    case BootstrapIntrinsicLowering.count_leading_zeros {
        let ones: usize = bootstrap_semantic_intrinsic_constant(
            context, node, work_type, bootstrap_semantic_mask_integer(0xFFFFFFFFFFFFFFFF, width));
        let smeared: usize = bootstrap_semantic_intrinsic_smear(context, node, work_type, width, x);
        let inverted: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.caret, work_type, smeared, ones);
        result = bootstrap_semantic_intrinsic_popcount(context, node, work_type, width, inverted);
    }
    case BootstrapIntrinsicLowering.count_trailing_zeros {
        let ones: usize = bootstrap_semantic_intrinsic_constant(
            context, node, work_type, bootstrap_semantic_mask_integer(0xFFFFFFFFFFFFFFFF, width));
        let inverted: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.caret, work_type, x, ones);
        let decremented: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.minus, work_type, x,
            bootstrap_semantic_intrinsic_constant(context, node, work_type, 1));
        let isolated: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, work_type, inverted, decremented);
        result = bootstrap_semantic_intrinsic_popcount(context, node, work_type, width, isolated);
    }
    case BootstrapIntrinsicLowering.population_count {
        result = bootstrap_semantic_intrinsic_popcount(context, node, work_type, width, x);
    }
    case BootstrapIntrinsicLowering.rotate_left {
        result = bootstrap_semantic_intrinsic_rotate(
            context, node, work_type, width, x, count.value_id, count.type_id, true);
    }
    case BootstrapIntrinsicLowering.rotate_right {
        result = bootstrap_semantic_intrinsic_rotate(
            context, node, work_type, width, x, count.value_id, count.type_id, false);
    }
    case BootstrapIntrinsicLowering.byte_swap {
        result = bootstrap_semantic_intrinsic_byte_swap(context, node, work_type, width, x);
    }
    }
    if (result != none) {
        result = bootstrap_semantic_intrinsic_convert(context, node, result, work_type, operand.type_id);
    }
    return {
        type_id = operand.type_id,
        value_id = result,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = result != none,
    };
}
