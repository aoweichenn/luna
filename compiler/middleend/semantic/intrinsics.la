module luna.bootstrap.middleend.semantic.intrinsics;

struct BootstrapIntrinsicIntegerInfo {
    kind: BootstrapTypeKind;
    unsigned_type: usize;
    width: usize;
}

struct BootstrapIntrinsicFloatInfo {
    kind: BootstrapTypeKind;
    // Values with |x| >= limit are already integral (or NaN/inf); below it the guarded expansions apply.
    limit: f64;
    // 1.5 * limit: adding then subtracting it forces a round-to-nearest-even at the unit bit.
    magic: f64;
}

fn bootstrap_semantic_intrinsic_invalid_expression() -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    return {
        type_id = none,
        value_id = none,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = false,
        bitfield_segment = bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_intrinsic_entry(index: usize) -> BootstrapIntrinsicEntry {
    var table: [20]BootstrapIntrinsicEntry = {};
    table[0] = {
        name = "file", name_length = 4, arity = 0,
        operand_class = BootstrapIntrinsicOperandClass.none,
        lowering = BootstrapIntrinsicLowering.source_file,
    };
    table[1] = {
        name = "line", name_length = 4, arity = 0,
        operand_class = BootstrapIntrinsicOperandClass.none,
        lowering = BootstrapIntrinsicLowering.source_line,
    };
    table[2] = {
        name = "clz", name_length = 3, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar,
        lowering = BootstrapIntrinsicLowering.count_leading_zeros,
    };
    table[3] = {
        name = "ctz", name_length = 3, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar,
        lowering = BootstrapIntrinsicLowering.count_trailing_zeros,
    };
    table[4] = {
        name = "popcount", name_length = 8, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar,
        lowering = BootstrapIntrinsicLowering.population_count,
    };
    table[5] = {
        name = "rotate_left", name_length = 11, arity = 2,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar_rotated,
        lowering = BootstrapIntrinsicLowering.rotate_left,
    };
    table[6] = {
        name = "rotate_right", name_length = 12, arity = 2,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar_rotated,
        lowering = BootstrapIntrinsicLowering.rotate_right,
    };
    table[7] = {
        name = "byte_swap", name_length = 9, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.integer_scalar_wide,
        lowering = BootstrapIntrinsicLowering.byte_swap,
    };
    table[8] = {
        name = "sqrt", name_length = 4, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar,
        lowering = BootstrapIntrinsicLowering.float_square_root,
    };
    table[9] = {
        name = "floor", name_length = 5, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar,
        lowering = BootstrapIntrinsicLowering.float_floor,
    };
    table[10] = {
        name = "ceil", name_length = 4, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar,
        lowering = BootstrapIntrinsicLowering.float_ceiling,
    };
    table[11] = {
        name = "trunc", name_length = 5, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar,
        lowering = BootstrapIntrinsicLowering.float_truncate,
    };
    table[12] = {
        name = "round", name_length = 5, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar,
        lowering = BootstrapIntrinsicLowering.float_round,
    };
    table[13] = {
        name = "min", name_length = 3, arity = 2,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar_binary,
        lowering = BootstrapIntrinsicLowering.float_minimum,
    };
    table[14] = {
        name = "max", name_length = 3, arity = 2,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar_binary,
        lowering = BootstrapIntrinsicLowering.float_maximum,
    };
    table[15] = {
        name = "abs", name_length = 3, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.float_scalar,
        lowering = BootstrapIntrinsicLowering.float_absolute,
    };
    table[16] = {
        name = "add_overflow", name_length = 12, arity = 3,
        operand_class = BootstrapIntrinsicOperandClass.integer_overflow,
        lowering = BootstrapIntrinsicLowering.overflow_add,
    };
    table[17] = {
        name = "sub_overflow", name_length = 12, arity = 3,
        operand_class = BootstrapIntrinsicOperandClass.integer_overflow,
        lowering = BootstrapIntrinsicLowering.overflow_subtract,
    };
    table[18] = {
        name = "mul_overflow", name_length = 12, arity = 3,
        operand_class = BootstrapIntrinsicOperandClass.integer_overflow,
        lowering = BootstrapIntrinsicLowering.overflow_multiply,
    };
    table[19] = {
        name = "embed", name_length = 5, arity = 1,
        operand_class = BootstrapIntrinsicOperandClass.embedded_file,
        lowering = BootstrapIntrinsicLowering.embed,
    };
    return table[index];
}

fn bootstrap_semantic_intrinsic_integer_info(index: usize) -> BootstrapIntrinsicIntegerInfo {
    var table: [10]BootstrapIntrinsicIntegerInfo = {};
    table[0] = {
        kind = BootstrapTypeKind.signed_8,
        unsigned_type = BootstrapBuiltinType.unsigned_8 as usize, width = 8,
    };
    table[1] = {
        kind = BootstrapTypeKind.signed_16,
        unsigned_type = BootstrapBuiltinType.unsigned_16 as usize, width = 16,
    };
    table[2] = {
        kind = BootstrapTypeKind.signed_32,
        unsigned_type = BootstrapBuiltinType.unsigned_32 as usize, width = 32,
    };
    table[3] = {
        kind = BootstrapTypeKind.signed_64,
        unsigned_type = BootstrapBuiltinType.unsigned_64 as usize, width = 64,
    };
    table[4] = {
        kind = BootstrapTypeKind.signed_size,
        unsigned_type = BootstrapBuiltinType.unsigned_size as usize, width = 64,
    };
    table[5] = {
        kind = BootstrapTypeKind.unsigned_8,
        unsigned_type = BootstrapBuiltinType.unsigned_8 as usize, width = 8,
    };
    table[6] = {
        kind = BootstrapTypeKind.unsigned_16,
        unsigned_type = BootstrapBuiltinType.unsigned_16 as usize, width = 16,
    };
    table[7] = {
        kind = BootstrapTypeKind.unsigned_32,
        unsigned_type = BootstrapBuiltinType.unsigned_32 as usize, width = 32,
    };
    table[8] = {
        kind = BootstrapTypeKind.unsigned_64,
        unsigned_type = BootstrapBuiltinType.unsigned_64 as usize, width = 64,
    };
    table[9] = {
        kind = BootstrapTypeKind.unsigned_size,
        unsigned_type = BootstrapBuiltinType.unsigned_size as usize, width = 64,
    };
    return table[index];
}

fn bootstrap_semantic_intrinsic_float_info(index: usize) -> BootstrapIntrinsicFloatInfo {
    var table: [2]BootstrapIntrinsicFloatInfo = {};
    table[0] = { kind = BootstrapTypeKind.float_32, limit = 8388608.0, magic = 12582912.0 };
    table[1] = { kind = BootstrapTypeKind.float_64, limit = 4503599627370496.0, magic = 6755399441055744.0 };
    return table[index];
}

fn bootstrap_semantic_intrinsic_constant(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, value: u64
) -> usize {
    let constant: BootstrapSemanticExpression =
        bootstrap_semantic_emit_integer_constant(context, node, type_id, value);
    return constant.value_id;
}

fn bootstrap_semantic_intrinsic_binary(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, operation: BootstrapTokenKind, type_id: usize,
    left: usize, right: usize
) -> usize {
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.binary_integer, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return bootstrap_semantic_emit_value(context, instruction, type_id);
}

fn bootstrap_semantic_intrinsic_shift(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, operation: BootstrapTokenKind, type_id: usize,
    value: usize, amount: usize
) -> usize {
    let count: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, amount as u64);
    return bootstrap_semantic_intrinsic_binary(context, node, operation, type_id, value, count);
}

fn bootstrap_semantic_intrinsic_convert(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, value: usize, source_type: usize, target_type: usize
) -> usize {
    if (source_type == target_type) {
        return value;
    }
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.convert, node);
    instruction.left = value;
    instruction.auxiliary = source_type;
    return bootstrap_semantic_emit_value(context, instruction, target_type);
}

// Sets every bit below the most significant set bit: x |= x >> 1; x |= x >> 2; ... x |= x >> (width / 2).
fn bootstrap_semantic_intrinsic_smear(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize
) -> usize {
    var result: usize = value;
    var shift: usize = 1;
    while (shift < width) {
        let shifted: usize = bootstrap_semantic_intrinsic_shift(
            context, node, BootstrapTokenKind.shift_right, type_id, result, shift);
        result = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.pipe, type_id, result, shifted);
        shift *= 2;
    }
    return result;
}

fn bootstrap_semantic_intrinsic_popcount(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize
) -> usize {
    let even_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x5555555555555555, width));
    let pair_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x3333333333333333, width));
    let nibble_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x0F0F0F0F0F0F0F0F, width));
    let lane_bits: usize = bootstrap_semantic_intrinsic_constant(
        context, node, type_id, bootstrap_semantic_mask_integer(0x0101010101010101, width));
    var x: usize = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.minus, type_id, value,
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, type_id,
            bootstrap_semantic_intrinsic_shift(context, node, BootstrapTokenKind.shift_right, type_id, value, 1),
            even_bits));
    x = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.plus, type_id,
        bootstrap_semantic_intrinsic_binary(context, node, BootstrapTokenKind.ampersand, type_id, x, pair_bits),
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, type_id,
            bootstrap_semantic_intrinsic_shift(context, node, BootstrapTokenKind.shift_right, type_id, x, 2),
            pair_bits));
    x = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.ampersand, type_id,
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.plus, type_id, x,
            bootstrap_semantic_intrinsic_shift(context, node, BootstrapTokenKind.shift_right, type_id, x, 4)),
        nibble_bits);
    return bootstrap_semantic_intrinsic_shift(
        context, node, BootstrapTokenKind.shift_right, type_id,
        bootstrap_semantic_intrinsic_binary(context, node, BootstrapTokenKind.star, type_id, x, lane_bits),
        width - 8);
}

// s = n & (width - 1); rotated = (x << s) | (x >> ((width - s) & (width - 1))); every shift count stays in
// [0, width - 1]. rotate_right mirrors the two shift directions.
fn bootstrap_semantic_intrinsic_rotate(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize,
    count: usize, count_type: usize, left: bool
) -> usize {
    let mask: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, (width - 1) as u64);
    let n: usize = bootstrap_semantic_intrinsic_convert(context, node, count, count_type, type_id);
    let amount: usize = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.ampersand, type_id, n, mask);
    let complement: usize = bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.ampersand, type_id,
        bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.minus, type_id,
            bootstrap_semantic_intrinsic_constant(context, node, type_id, width as u64), amount),
        mask);
    let forward: usize = bootstrap_semantic_intrinsic_binary(
        context, node, left ? BootstrapTokenKind.shift_left : BootstrapTokenKind.shift_right, type_id, value, amount);
    let backward: usize = bootstrap_semantic_intrinsic_binary(
        context, node, left ? BootstrapTokenKind.shift_right : BootstrapTokenKind.shift_left, type_id, value,
        complement);
    return bootstrap_semantic_intrinsic_binary(
        context, node, BootstrapTokenKind.pipe, type_id, forward, backward);
}

// Isolates each byte and shifts it to the mirrored byte lane; shift amounts stay within [0, width - 8].
fn bootstrap_semantic_intrinsic_byte_swap(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, width: usize, value: usize
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    let byte_mask: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, 0xFF);
    let bytes: usize = width / 8;
    var result: usize = none;
    var index: usize = 0;
    while (index < bytes) {
        var term: usize = value;
        if (index != 0) {
            term = bootstrap_semantic_intrinsic_shift(
                context, node, BootstrapTokenKind.shift_right, type_id, term, index * 8);
        }
        term = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, type_id, term, byte_mask);
        let target: usize = (bytes - 1 - index) * 8;
        if (target != 0) {
            term = bootstrap_semantic_intrinsic_shift(
                context, node, BootstrapTokenKind.shift_left, type_id, term, target);
        }
        if (result == none) {
            result = term;
        } else {
            result = bootstrap_semantic_intrinsic_binary(
                context, node, BootstrapTokenKind.pipe, type_id, result, term);
        }
        index += 1;
    }
    return result;
}

fn bootstrap_semantic_intrinsic_float_constant(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, value: f64
) -> usize {
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(BootstrapIrOpcode.constant_float, node);
    instruction.floating = value;
    return bootstrap_semantic_emit_value(context, instruction, type_id);
}

fn bootstrap_semantic_intrinsic_float_negate(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, type_id: usize, value: usize
) -> usize {
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.unary_float, node);
    instruction.operation = BootstrapTokenKind.minus;
    instruction.left = value;
    return bootstrap_semantic_emit_value(context, instruction, type_id);
}

fn bootstrap_semantic_intrinsic_float_binary(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, opcode: BootstrapIrOpcode,
    operation: BootstrapTokenKind, type_id: usize, left: usize, right: usize
) -> usize {
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(opcode, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return bootstrap_semantic_emit_value(context, instruction, type_id);
}

fn bootstrap_semantic_intrinsic_float_compare(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, operation: BootstrapTokenKind, left: usize,
    right: usize
) -> usize {
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.compare, node);
    instruction.operation = operation;
    instruction.left = left;
    instruction.right = right;
    return bootstrap_semantic_emit_value(context, instruction, BootstrapBuiltinType.boolean as usize);
}

fn bootstrap_semantic_intrinsic_float_rvalue(type_id: usize, value_id: usize) -> BootstrapSemanticExpression {
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
        bitfield_segment = bootstrap_semantic_no_id(),
    };
}

// Emits `|x| < limit ? expansion(x) : x` through a temporary slot, mirroring the conditional-expression
// lowering. The ordered-less guard is false for NaN and for already-integral magnitudes, so the expansion
// path's trapping float->integer conversion only ever runs on finite values below 2^(precision - 1).
fn bootstrap_semantic_intrinsic_float_guarded(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, lowering: BootstrapIntrinsicLowering,
    type_id: usize, info: BootstrapIntrinsicFloatInfo, x: usize
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    let magnitude: usize = bootstrap_semantic_intrinsic_float_binary(
        context, node, BootstrapIrOpcode.float_max, BootstrapTokenKind.invalid, type_id, x,
        bootstrap_semantic_intrinsic_float_negate(context, node, type_id, x));
    let in_range: usize = bootstrap_semantic_intrinsic_float_compare(
        context, node, BootstrapTokenKind.less, magnitude,
        bootstrap_semantic_intrinsic_float_constant(context, node, type_id, info.limit));
    let result_slot: usize = bootstrap_ir_add_slot(
        &context->ir, bootstrap_semantic_current_ir_function(context), type_id, true, false, 0);
    let compute_block: usize = bootstrap_semantic_add_current_block(context);
    let merge_block: usize = bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_store_to_address(
        context, node, bootstrap_semantic_address_of_slot(context, node, result_slot, type_id, false, false),
        type_id, bootstrap_semantic_intrinsic_float_rvalue(type_id, x));
    bootstrap_semantic_emit_branch(context, node, in_range, compute_block, merge_block);
    context->current_block = compute_block;
    var result: usize = none;
    if (lowering == BootstrapIntrinsicLowering.float_round) {
        let magic: usize = bootstrap_semantic_intrinsic_float_constant(context, node, type_id, info.magic);
        result = bootstrap_semantic_intrinsic_float_binary(
            context, node, BootstrapIrOpcode.binary_float, BootstrapTokenKind.minus, type_id,
            bootstrap_semantic_intrinsic_float_binary(
                context, node, BootstrapIrOpcode.binary_float, BootstrapTokenKind.plus, type_id, x, magic),
            magic);
    } else {
        let integer_type: usize = BootstrapBuiltinType.signed_64 as usize;
        let truncated: usize = bootstrap_semantic_intrinsic_convert(context, node, x, type_id, integer_type);
        let integral: usize = bootstrap_semantic_intrinsic_convert(context, node, truncated, integer_type, type_id);
        if (lowering == BootstrapIntrinsicLowering.float_truncate) {
            result = integral;
        } else {
            let downward: bool = lowering == BootstrapIntrinsicLowering.float_floor;
            let adjust: usize = bootstrap_semantic_intrinsic_float_compare(
                context, node, downward ? BootstrapTokenKind.greater : BootstrapTokenKind.less, integral, x);
            let adjustment: usize = bootstrap_semantic_intrinsic_convert(
                context, node, adjust, BootstrapBuiltinType.boolean as usize, type_id);
            result = bootstrap_semantic_intrinsic_float_binary(
                context, node, BootstrapIrOpcode.binary_float,
                downward ? BootstrapTokenKind.minus : BootstrapTokenKind.plus, type_id, integral, adjustment);
        }
    }
    bootstrap_semantic_store_to_address(
        context, node, bootstrap_semantic_address_of_slot(context, node, result_slot, type_id, false, false),
        type_id, bootstrap_semantic_intrinsic_float_rvalue(type_id, result));
    bootstrap_semantic_emit_jump(context, node, merge_block);
    context->current_block = merge_block;
    let source: BootstrapSemanticExpression = {
        type_id = type_id,
        value_id = none,
        address_id = bootstrap_semantic_address_of_slot(context, node, result_slot, type_id, false, false),
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = true,
        bitfield_segment = bootstrap_semantic_no_id(),
    };
    return bootstrap_semantic_load_lvalue(context, node, source).value_id;
}

fn bootstrap_semantic_lower_float_intrinsic(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, entry: BootstrapIntrinsicEntry,
    operand: BootstrapSemanticExpression, second: BootstrapSemanticExpression
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let record: BootstrapTypeRecord = bootstrap_semantic_type_record(context, operand.type_id);
    var info: BootstrapIntrinsicFloatInfo = bootstrap_semantic_intrinsic_float_info(0);
    var float_operand: bool = false;
    var info_index: usize = 0;
    while (info_index < 2) {
        info = bootstrap_semantic_intrinsic_float_info(info_index);
        if (info.kind == record.kind) {
            float_operand = true;
            break;
        }
        info_index += 1;
    }
    if (!float_operand ||
        (entry.operand_class == BootstrapIntrinsicOperandClass.float_scalar_binary &&
            second.type_id != operand.type_id)) {
        bootstrap_semantic_add_diagnostic(
            context, BootstrapSemanticDiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            bootstrap_semantic_empty_span(), operand.type_id);
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    let type_id: usize = operand.type_id;
    var result: usize = none;
    switch (entry.lowering) {
    case BootstrapIntrinsicLowering.float_square_root {
        var instruction: BootstrapIrInstruction =
            bootstrap_semantic_instruction(BootstrapIrOpcode.float_sqrt, node);
        instruction.left = operand.value_id;
        result = bootstrap_semantic_emit_value(context, instruction, type_id);
    }
    case BootstrapIntrinsicLowering.float_minimum {
        result = bootstrap_semantic_intrinsic_float_binary(
            context, node, BootstrapIrOpcode.float_min, BootstrapTokenKind.invalid, type_id, operand.value_id,
            second.value_id);
    }
    case BootstrapIntrinsicLowering.float_maximum {
        result = bootstrap_semantic_intrinsic_float_binary(
            context, node, BootstrapIrOpcode.float_max, BootstrapTokenKind.invalid, type_id, operand.value_id,
            second.value_id);
    }
    case BootstrapIntrinsicLowering.float_absolute {
        // maxsd(x, -x) clears the sign bit except that +0.0 compares equal to -0.0 and the second operand
        // (-0.0) wins; the final add of +0.0 maps -0.0 back to +0.0 and is otherwise exact. NaN stays NaN.
        let magnitude: usize = bootstrap_semantic_intrinsic_float_binary(
            context, node, BootstrapIrOpcode.float_max, BootstrapTokenKind.invalid, type_id, operand.value_id,
            bootstrap_semantic_intrinsic_float_negate(context, node, type_id, operand.value_id));
        result = bootstrap_semantic_intrinsic_float_binary(
            context, node, BootstrapIrOpcode.binary_float, BootstrapTokenKind.plus, type_id, magnitude,
            bootstrap_semantic_intrinsic_float_constant(context, node, type_id, 0.0));
    }
    case BootstrapIntrinsicLowering.float_floor {
        result = bootstrap_semantic_intrinsic_float_guarded(
            context, node, entry.lowering, type_id, info, operand.value_id);
    }
    case BootstrapIntrinsicLowering.float_ceiling {
        result = bootstrap_semantic_intrinsic_float_guarded(
            context, node, entry.lowering, type_id, info, operand.value_id);
    }
    case BootstrapIntrinsicLowering.float_truncate {
        result = bootstrap_semantic_intrinsic_float_guarded(
            context, node, entry.lowering, type_id, info, operand.value_id);
    }
    case BootstrapIntrinsicLowering.float_round {
        result = bootstrap_semantic_intrinsic_float_guarded(
            context, node, entry.lowering, type_id, info, operand.value_id);
    }
    }
    return {
        type_id = type_id,
        value_id = result,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = result != none,
        bitfield_segment = bootstrap_semantic_no_id(),
    };
}

// @add_overflow/@sub_overflow/@mul_overflow: both operands share an integer scalar type T and the third
// argument is a mutable *T. The wrapped result is always stored through the pointer; the intrinsic returns
// whether the operation overflowed T.
fn bootstrap_semantic_lower_overflow_intrinsic(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, entry: BootstrapIntrinsicEntry,
    operand: BootstrapSemanticExpression, count: BootstrapSemanticExpression,
    destination: BootstrapSemanticExpression
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let record: BootstrapTypeRecord = bootstrap_semantic_type_record(context, operand.type_id);
    var width: usize = 0;
    var info_index: usize = 0;
    while (info_index < 10) {
        let info: BootstrapIntrinsicIntegerInfo = bootstrap_semantic_intrinsic_integer_info(info_index);
        if (info.kind == record.kind) {
            width = info.width;
            break;
        }
        info_index += 1;
    }
    let destination_record: BootstrapTypeRecord = bootstrap_semantic_type_record(context, destination.type_id);
    if (width == 0 || count.type_id != operand.type_id || destination_record.kind != BootstrapTypeKind.pointer ||
        destination_record.element_type != operand.type_id ||
        (destination_record.flags & (BootstrapTypeFlag.read_only as usize)) != 0) {
        bootstrap_semantic_add_diagnostic(
            context, BootstrapSemanticDiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            bootstrap_semantic_empty_span(), operand.type_id);
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    let operation: BootstrapTokenKind = entry.lowering == BootstrapIntrinsicLowering.overflow_add ?
        BootstrapTokenKind.plus : entry.lowering == BootstrapIntrinsicLowering.overflow_subtract ?
        BootstrapTokenKind.minus : BootstrapTokenKind.star;
    let type_id: usize = operand.type_id;
    let boolean_type: usize = BootstrapBuiltinType.boolean as usize;
    // The narrow result wraps at width T in a plain binary_integer, so the wrapped value is available
    // whether or not the operation overflowed.
    let wrapped: usize = bootstrap_semantic_intrinsic_binary(
        context, node, operation, type_id, operand.value_id, count.value_id);
    var overflow: usize = none;
    if (width < 64) {
        // Redo the operation in the i64 domain (sign- or zero-extended per T), where it is exact, and
        // compare against the re-widened wrapped value; every conversion here widens and never traps.
        let wide_type: usize = BootstrapBuiltinType.signed_64 as usize;
        let wide: usize = bootstrap_semantic_intrinsic_binary(
            context, node, operation, wide_type,
            bootstrap_semantic_intrinsic_convert(context, node, operand.value_id, type_id, wide_type),
            bootstrap_semantic_intrinsic_convert(context, node, count.value_id, type_id, wide_type));
        overflow = bootstrap_semantic_intrinsic_float_compare(
            context, node, BootstrapTokenKind.bang_equal, wide,
            bootstrap_semantic_intrinsic_convert(context, node, wrapped, type_id, wide_type));
    } else if (entry.lowering == BootstrapIntrinsicLowering.overflow_multiply &&
        !bootstrap_type_is_signed_integer(record.kind)) {
        // Two-operand imul sets OF on signed significance only, so it misses unsigned 64-bit overflows
        // (0xFFFFFFFFFFFFFFFF * 2 reads as -1 * 2 = -2, which "fits"). Expand instead: overflow iff
        // a != 0 && wrapped / a != b. The divisor is forced to 1 when a == 0 (a | (a == 0)), so the
        // division never traps; a == 0 cannot overflow and is masked out of the result.
        let zero: usize = bootstrap_semantic_intrinsic_constant(context, node, type_id, 0);
        let is_zero: usize = bootstrap_semantic_intrinsic_convert(
            context, node,
            bootstrap_semantic_intrinsic_float_compare(
                context, node, BootstrapTokenKind.equal_equal, operand.value_id, zero),
            boolean_type, type_id);
        let divisor: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.pipe, type_id, operand.value_id, is_zero);
        let quotient: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.slash, type_id, wrapped, divisor);
        let mismatch: usize = bootstrap_semantic_intrinsic_convert(
            context, node,
            bootstrap_semantic_intrinsic_float_compare(
                context, node, BootstrapTokenKind.bang_equal, quotient, count.value_id),
            boolean_type, type_id);
        let nonzero: usize = bootstrap_semantic_intrinsic_convert(
            context, node,
            bootstrap_semantic_intrinsic_float_compare(
                context, node, BootstrapTokenKind.bang_equal, operand.value_id, zero),
            boolean_type, type_id);
        overflow = bootstrap_semantic_intrinsic_float_compare(
            context, node, BootstrapTokenKind.bang_equal,
            bootstrap_semantic_intrinsic_binary(
                context, node, BootstrapTokenKind.ampersand, type_id, mismatch, nonzero),
            zero);
    } else {
        // overflow_flag must be emitted immediately after the arithmetic: codegen for binary_integer ends
        // with a mov store, so the add/sub/imul flags reach the setcc unclobbered. Only signed operations
        // and unsigned add/sub come here: signed uses seto, unsigned add/sub uses setc.
        var flag: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.overflow_flag, node);
        flag.auxiliary = bootstrap_type_is_signed_integer(record.kind) ? 1 : 0;
        overflow = bootstrap_semantic_emit_value(context, flag, boolean_type);
    }
    if (wrapped == none || overflow == none ||
        !bootstrap_semantic_store_to_address(
            context, node, destination.value_id, type_id,
            bootstrap_semantic_intrinsic_float_rvalue(type_id, wrapped))) {
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    return bootstrap_semantic_intrinsic_float_rvalue(boolean_type, overflow);
}

fn bootstrap_semantic_intrinsic_resolve(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    var index: usize = 0;
    while (index < 20) {
        let entry: BootstrapIntrinsicEntry = bootstrap_semantic_intrinsic_entry(index);
        if (bootstrap_semantic_token_equals_bytes(
                context, context->current_unit, node.token_index, entry.name, entry.name_length)) {
            if (node.child_count != entry.arity) {
                bootstrap_semantic_add_diagnostic(
                    context, BootstrapSemanticDiagnosticKind.argument_count, context->current_unit, node.span, none,
                    bootstrap_semantic_empty_span(), entry.arity);
                return none;
            }
            return index;
        }
        index += 1;
    }
    bootstrap_semantic_add_diagnostic(
        context, BootstrapSemanticDiagnosticKind.unknown_intrinsic, context->current_unit, node.span, none,
        bootstrap_semantic_empty_span(), 0);
    return none;
}

// @file() yields a *const u8 to a NUL-terminated global holding the unit's path as the driver recorded
// it; @line() yields the 1-based line of the intrinsic's own span as a usize constant.
fn bootstrap_semantic_lower_source_intrinsic(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, entry: BootstrapIntrinsicEntry
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    if (entry.lowering == BootstrapIntrinsicLowering.source_line) {
        return bootstrap_semantic_emit_integer_constant(
            context, node, BootstrapBuiltinType.unsigned_size as usize, node.span.line as u64);
    }
    let path: StdTextView = bootstrap_semantic_unit_path(context, context->current_unit);
    var bytes: StdByteBuffer = std_byte_buffer_empty();
    var step: StdByteBufferResult = std_byte_buffer_append(bytes, path.data, path.length);
    bytes = step.buffer;
    if (step.error == runtime::Error.none) {
        step = std_byte_buffer_push(bytes, 0);
        bytes = step.buffer;
    }
    if (step.error != runtime::Error.none) {
        context->error = step.error;
        let discard_error: runtime::Error = std_byte_buffer_release(bytes);
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    let global_id: usize = bootstrap_ir_add_global(&context->ir, bytes.data as *const u8, bytes.length, 1, true);
    let release_error: runtime::Error = std_byte_buffer_release(bytes);
    if (global_id == none) {
        if (context->error == runtime::Error.none) {
            context->error = context->ir.error;
        }
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    if (release_error != runtime::Error.none) {
        context->error = release_error;
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    let pointer: BootstrapTypeIdResult =
        bootstrap_type_table_pointer(&context->types, BootstrapBuiltinType.unsigned_8 as usize, true, false);
    context->error = pointer.error;
    var instruction: BootstrapIrInstruction = bootstrap_semantic_instruction(BootstrapIrOpcode.global_address, node);
    instruction.auxiliary = global_id;
    let value_id: usize = bootstrap_semantic_emit_value(context, instruction, pointer.type_id);
    return {
        type_id = pointer.type_id,
        value_id = value_id,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != none,
        bitfield_segment = none,
    };
}

fn bootstrap_semantic_lower_intrinsic(
    context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, intrinsic_index: usize,
    operand: BootstrapSemanticExpression, count: BootstrapSemanticExpression,
    destination: BootstrapSemanticExpression
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let entry: BootstrapIntrinsicEntry = bootstrap_semantic_intrinsic_entry(intrinsic_index);
    if ((entry.arity >= 1 && !operand.valid) || (entry.arity >= 2 && !count.valid) ||
        (entry.arity == 3 && !destination.valid)) {
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    if (entry.operand_class == BootstrapIntrinsicOperandClass.none) {
        return bootstrap_semantic_lower_source_intrinsic(context, node, entry);
    }
    if (entry.operand_class == BootstrapIntrinsicOperandClass.embedded_file) {
        // @embed is intercepted in bootstrap_semantic_lower_expression and lowered by
        // bootstrap_semantic_lower_embed (expr.la), which owns the string decoding helpers.
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    if (entry.operand_class == BootstrapIntrinsicOperandClass.integer_overflow) {
        return bootstrap_semantic_lower_overflow_intrinsic(context, node, entry, operand, count, destination);
    }
    if (entry.operand_class == BootstrapIntrinsicOperandClass.float_scalar ||
        entry.operand_class == BootstrapIntrinsicOperandClass.float_scalar_binary) {
        return bootstrap_semantic_lower_float_intrinsic(context, node, entry, operand, count);
    }
    let record: BootstrapTypeRecord = bootstrap_semantic_type_record(context, operand.type_id);
    var width: usize = 0;
    var work_type: usize = none;
    var info_index: usize = 0;
    while (info_index < 10) {
        let info: BootstrapIntrinsicIntegerInfo = bootstrap_semantic_intrinsic_integer_info(info_index);
        if (info.kind == record.kind) {
            width = info.width;
            work_type = info.unsigned_type;
            break;
        }
        info_index += 1;
    }
    if (work_type == none ||
        (entry.operand_class == BootstrapIntrinsicOperandClass.integer_scalar_wide && width < 16) ||
        (entry.operand_class == BootstrapIntrinsicOperandClass.integer_scalar_rotated &&
            count.type_id != BootstrapBuiltinType.unsigned_size as usize)) {
        bootstrap_semantic_add_diagnostic(
            context, BootstrapSemanticDiagnosticKind.type_mismatch, context->current_unit, node.span, none,
            bootstrap_semantic_empty_span(), operand.type_id);
        return bootstrap_semantic_intrinsic_invalid_expression();
    }
    // Signed operands are evaluated in the unsigned type of the same width so every expansion shift is
    // logical; the same-width conversions preserve the bit pattern and never trap.
    let x: usize =
        bootstrap_semantic_intrinsic_convert(context, node, operand.value_id, operand.type_id, work_type);
    var result: usize = none;
    switch (entry.lowering) {
    case BootstrapIntrinsicLowering.count_leading_zeros {
        let ones: usize = bootstrap_semantic_intrinsic_constant(
            context, node, work_type, bootstrap_semantic_mask_integer(0xFFFFFFFFFFFFFFFF, width));
        let smeared: usize = bootstrap_semantic_intrinsic_smear(context, node, work_type, width, x);
        let inverted: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.caret, work_type, smeared, ones);
        result = bootstrap_semantic_intrinsic_popcount(context, node, work_type, width, inverted);
    }
    case BootstrapIntrinsicLowering.count_trailing_zeros {
        let ones: usize = bootstrap_semantic_intrinsic_constant(
            context, node, work_type, bootstrap_semantic_mask_integer(0xFFFFFFFFFFFFFFFF, width));
        let inverted: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.caret, work_type, x, ones);
        let decremented: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.minus, work_type, x,
            bootstrap_semantic_intrinsic_constant(context, node, work_type, 1));
        let isolated: usize = bootstrap_semantic_intrinsic_binary(
            context, node, BootstrapTokenKind.ampersand, work_type, inverted, decremented);
        result = bootstrap_semantic_intrinsic_popcount(context, node, work_type, width, isolated);
    }
    case BootstrapIntrinsicLowering.population_count {
        result = bootstrap_semantic_intrinsic_popcount(context, node, work_type, width, x);
    }
    case BootstrapIntrinsicLowering.rotate_left {
        result = bootstrap_semantic_intrinsic_rotate(
            context, node, work_type, width, x, count.value_id, count.type_id, true);
    }
    case BootstrapIntrinsicLowering.rotate_right {
        result = bootstrap_semantic_intrinsic_rotate(
            context, node, work_type, width, x, count.value_id, count.type_id, false);
    }
    case BootstrapIntrinsicLowering.byte_swap {
        result = bootstrap_semantic_intrinsic_byte_swap(context, node, work_type, width, x);
    }
    }
    if (result != none) {
        result = bootstrap_semantic_intrinsic_convert(context, node, result, work_type, operand.type_id);
    }
    return {
        type_id = operand.type_id,
        value_id = result,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = result != none,
        bitfield_segment = bootstrap_semantic_no_id(),
    };
}
