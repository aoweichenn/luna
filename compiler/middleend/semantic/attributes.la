module luna.bootstrap.middleend.semantic.attributes;

struct BootstrapSemanticAttributeEntry {
    name: *const u8;
    name_length: usize;
    mounts: usize;
    arguments: BootstrapSemanticAttributeArgumentPolicy;
}

struct BootstrapSemanticAttributeMountEntry {
    kind: parser::SyntaxKind;
    mount: usize;
}

fn bootstrap_semantic_attribute_entry(
    index: usize
) -> BootstrapSemanticAttributeEntry {
    var table: [6]BootstrapSemanticAttributeEntry = {};
    table[0] = {
        name = "inline", name_length = 6,
        mounts = BootstrapSemanticAttributeMount.function as usize,
        arguments = BootstrapSemanticAttributeArgumentPolicy.none,
    };
    table[1] = {
        name = "noreturn", name_length = 8,
        mounts = BootstrapSemanticAttributeMount.function as usize,
        arguments = BootstrapSemanticAttributeArgumentPolicy.none,
    };
    table[2] = {
        name = "align", name_length = 5,
        mounts = (BootstrapSemanticAttributeMount.variable as usize) |
            (BootstrapSemanticAttributeMount.field as usize) |
            (BootstrapSemanticAttributeMount.record as usize),
        arguments = BootstrapSemanticAttributeArgumentPolicy.one_constant_integer,
    };
    table[3] = {
        name = "packed", name_length = 6,
        mounts = BootstrapSemanticAttributeMount.structure as usize,
        arguments = BootstrapSemanticAttributeArgumentPolicy.none,
    };
    table[4] = {
        name = "bits", name_length = 4,
        mounts = BootstrapSemanticAttributeMount.field as usize,
        arguments = BootstrapSemanticAttributeArgumentPolicy.named_bitfields,
    };
    table[5] = {
        name = "export_name", name_length = 11,
        mounts = BootstrapSemanticAttributeMount.function as usize,
        arguments = BootstrapSemanticAttributeArgumentPolicy
            .one_string_literal,
    };
    let entry: BootstrapSemanticAttributeEntry = table[index];
    return entry;
}

fn bootstrap_semantic_attribute_mount_for(
    kind: parser::SyntaxKind
) -> usize {
    var table: [7]BootstrapSemanticAttributeMountEntry = {};
    table[0] = {
        kind = parser::SyntaxKind.function_declaration,
        mount = BootstrapSemanticAttributeMount.function as usize,
    };
    table[1] = {
        kind = parser::SyntaxKind.structure_declaration,
        mount = (BootstrapSemanticAttributeMount.record as usize) |
            (BootstrapSemanticAttributeMount.structure as usize),
    };
    table[2] = {
        kind = parser::SyntaxKind.union_declaration,
        mount = BootstrapSemanticAttributeMount.record as usize,
    };
    table[3] = {
        kind = parser::SyntaxKind.enum_declaration,
        mount = BootstrapSemanticAttributeMount.enumeration as usize,
    };
    table[4] = {
        kind = parser::SyntaxKind.field_declaration,
        mount = BootstrapSemanticAttributeMount.field as usize,
    };
    table[5] = {
        kind = parser::SyntaxKind.variable_declaration,
        mount = BootstrapSemanticAttributeMount.variable as usize,
    };
    table[6] = {
        kind = parser::SyntaxKind.type_alias_declaration,
        mount = BootstrapSemanticAttributeMount.alias as usize,
    };
    var index: usize = 0;
    while (index < 7) {
        if (table[index].kind == kind) {
            return table[index].mount;
        }
        index += 1;
    }
    return BootstrapSemanticAttributeMount.none as usize;
}

fn bootstrap_semantic_find_attribute(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_token: usize
) -> usize {
    var index: usize = 0;
    while (index < 6) {
        let entry: BootstrapSemanticAttributeEntry =
            bootstrap_semantic_attribute_entry(index);
        if (bootstrap_semantic_token_equals_bytes(
                context,
                unit_index,
                name_token,
                entry.name,
                entry.name_length
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_count_attribute_children(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration: parser::SyntaxNode
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    var count: usize = 0;
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, child);
        if (node.kind == parser::SyntaxKind.attribute) {
            count += 1;
        }
        child = node.next_sibling;
    }
    return count;
}

fn bootstrap_semantic_declaration_has_attribute(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration: parser::SyntaxNode,
    attribute: BootstrapSemanticAttribute
) -> bool {
    let entry: BootstrapSemanticAttributeEntry =
        bootstrap_semantic_attribute_entry(attribute as usize);
    let none: usize = bootstrap_semantic_no_id();
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, child);
        if (node.kind == parser::SyntaxKind.attribute &&
            bootstrap_semantic_token_equals_bytes(
                context,
                unit_index,
                node.token_index,
                entry.name,
                entry.name_length
            )) {
            return true;
        }
        child = node.next_sibling;
    }
    return false;
}

fn bootstrap_semantic_declaration_attribute_argument(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration: parser::SyntaxNode,
    attribute: BootstrapSemanticAttribute
) -> usize {
    let entry: BootstrapSemanticAttributeEntry =
        bootstrap_semantic_attribute_entry(attribute as usize);
    let none: usize = bootstrap_semantic_no_id();
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, child);
        if (node.kind == parser::SyntaxKind.attribute &&
            bootstrap_semantic_token_equals_bytes(
                context,
                unit_index,
                node.token_index,
                entry.name,
                entry.name_length
            )) {
            if ((node.flags &
                    (parser::SyntaxFlag.has_arguments as usize)) != 0 &&
                node.child_count == 1) {
                return node.first_child;
            }
            return none;
        }
        child = node.next_sibling;
    }
    return none;
}

// A one_string_literal argument must be a plain u8 string literal whose raw
// bytes form a nonempty C identifier; escapes and wide prefixes can never
// qualify, so the raw token bytes (quotes included in the span) are checked
// directly instead of decoding.
fn bootstrap_semantic_attribute_string_is_identifier(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize
) -> bool {
    let token: lexer::Token =
        bootstrap_semantic_token(context, unit_index, token_index);
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    if (unit == null || token.kind != lexer::TokenKind.string ||
        token.span.length < 3 ||
        token.span.offset > unit->source.length ||
        token.span.length > unit->source.length - token.span.offset) {
        return false;
    }
    var index: usize = 1;
    while (index + 1 < token.span.length) {
        let byte: u8 = unit->source.data[token.span.offset + index];
        let letter: bool = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95;
        let digit: bool = byte >= 48 && byte <= 57;
        if ((!letter && !digit) || (index == 1 && digit)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_attribute_string_matches(
    unit: *const BootstrapSemanticUnit,
    token: lexer::Token,
    expected: *const u8,
    expected_length: usize
) -> bool {
    if (unit == null || token.span.length != expected_length + 2 ||
        token.span.offset > unit->source.length ||
        token.span.length > unit->source.length - token.span.offset) {
        return false;
    }
    var index: usize = 0;
    while (index < expected_length) {
        if (unit->source.data[token.span.offset + 1 + index] !=
            expected[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Reserved export names collide with the runtime entry point or the
// module-fingerprint mangling scheme ("_L<module-hex>_<name-hex>"); the same
// rule already applies to extern symbol names.
fn bootstrap_semantic_attribute_string_is_reserved(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize
) -> bool {
    let token: lexer::Token =
        bootstrap_semantic_token(context, unit_index, token_index);
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    if (unit == null || token.span.length < 4 ||
        token.span.offset > unit->source.length ||
        token.span.length > unit->source.length - token.span.offset) {
        return false;
    }
    return bootstrap_semantic_attribute_string_matches(
            unit, token, "_start", 6) ||
        (unit->source.data[token.span.offset + 1] == 95 &&
            unit->source.data[token.span.offset + 2] == 76);
}

fn bootstrap_semantic_validate_attribute(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    var mount: usize =
        BootstrapSemanticAttributeMount.none as usize;
    if (node.parent != none) {
        mount = bootstrap_semantic_attribute_mount_for(
            bootstrap_semantic_node(
                context, unit_index, node.parent
            ).kind
        );
    }
    let table_index: usize =
        bootstrap_semantic_find_attribute(
            context, unit_index, node.token_index
        );
    if (table_index == none) {
        return bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.unknown_attribute,
            unit_index,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
    }
    let entry: BootstrapSemanticAttributeEntry =
        bootstrap_semantic_attribute_entry(table_index);
    let has_arguments: bool =
        (node.flags &
            (parser::SyntaxFlag.has_arguments as usize)) != 0;
    if (mount == (BootstrapSemanticAttributeMount.none as usize) ||
        (entry.mounts & mount) == 0 ||
        (entry.arguments ==
                BootstrapSemanticAttributeArgumentPolicy.none &&
            has_arguments) ||
        (entry.arguments ==
                BootstrapSemanticAttributeArgumentPolicy
                    .one_constant_integer &&
            (!has_arguments || node.child_count != 1)) ||
        (entry.arguments ==
                BootstrapSemanticAttributeArgumentPolicy
                    .named_bitfields &&
            (!has_arguments || node.child_count == 0)) ||
        (entry.arguments ==
                BootstrapSemanticAttributeArgumentPolicy
                    .one_string_literal &&
            (!has_arguments || node.child_count != 1))) {
        return bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_attribute,
            unit_index,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            table_index
        );
    }
    // Positional policies take plain expressions; named arguments are left
    // for the named_bitfields consumer to validate so it can report
    // invalid_bitfield rather than a framework error.
    let expects_named: bool =
        entry.arguments ==
            BootstrapSemanticAttributeArgumentPolicy.named_bitfields;
    var argument: usize = node.first_child;
    while (!expects_named && argument != none) {
        let argument_node: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, argument);
        if ((argument_node.kind ==
                parser::SyntaxKind.named_argument) != expects_named ||
            (entry.arguments ==
                    BootstrapSemanticAttributeArgumentPolicy
                        .one_string_literal &&
                argument_node.kind !=
                    parser::SyntaxKind.string_expression)) {
            return bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_attribute,
                unit_index,
                argument_node.span,
                none,
                bootstrap_semantic_empty_span(),
                table_index
            );
        }
        argument = argument_node.next_sibling;
    }
    if (table_index == (BootstrapSemanticAttribute.packed as usize) &&
        node.parent != none) {
        let parent: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, node.parent);
        if (parent.kind == parser::SyntaxKind.structure_declaration &&
            bootstrap_semantic_declaration_has_attribute(
                context,
                unit_index,
                parent,
                BootstrapSemanticAttribute.align
            )) {
            return bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_attribute,
                unit_index,
                node.span,
                none,
                bootstrap_semantic_empty_span(),
                table_index
            );
        }
    }
    // @export_name mounts only on a definition with a body (never on
    // extern, const fn or bodyless declarations) and takes one string
    // literal holding a valid, non-reserved C identifier; the emitted
    // symbol is that name verbatim, bypassing the _L mangling scheme.
    if (table_index == (BootstrapSemanticAttribute.export_name as usize) &&
        node.parent != none) {
        let parent: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, node.parent);
        if ((parent.flags &
                ((parser::SyntaxFlag.external as usize) |
                    (parser::SyntaxFlag.const_function as usize) |
                    (parser::SyntaxFlag.bodyless as usize))) != 0) {
            return bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_attribute,
                unit_index,
                node.span,
                none,
                bootstrap_semantic_empty_span(),
                table_index
            );
        }
        let argument_node: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, node.first_child);
        if (argument_node.child_count != 0 ||
            !bootstrap_semantic_attribute_string_is_identifier(
                context, unit_index, argument_node.token_index)) {
            return bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_attribute,
                unit_index,
                argument_node.span,
                none,
                bootstrap_semantic_empty_span(),
                table_index
            );
        }
        if (bootstrap_semantic_attribute_string_is_reserved(
                context, unit_index, argument_node.token_index)) {
            return bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_export_name,
                unit_index,
                argument_node.span,
                none,
                bootstrap_semantic_empty_span(),
                table_index
            );
        }
    }
    return true;
}

fn bootstrap_semantic_validate_attributes(
    context: *BootstrapSemanticContext
) -> bool {
    var unit_index: usize = 0;
    while (unit_index < context->input.unit_count &&
        context->error == runtime::Error.none) {
        let unit: *const BootstrapSemanticUnit =
            bootstrap_semantic_input_unit(context, unit_index);
        var node_index: usize = 0;
        while (node_index < unit->tree.count &&
            context->error == runtime::Error.none) {
            let node: parser::SyntaxNode =
                bootstrap_semantic_node(
                    context, unit_index, node_index
                );
            if (node.kind == parser::SyntaxKind.attribute &&
                !bootstrap_semantic_validate_attribute(
                    context, unit_index, node
                )) {
                return false;
            }
            node_index += 1;
        }
        unit_index += 1;
    }
    return context->error == runtime::Error.none;
}
