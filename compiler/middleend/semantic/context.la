module luna.bootstrap.middleend.semantic.context;


fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty_span() -> lexer::SourceSpan {
    return {
        offset = 0,
        length = 0,
        line = 0,
        column = 0,
    };
}

fn invalid_diagnostic()
    -> Diagnostic {
    let none: usize = no_id();
    return {
        kind = DiagnosticKind.invalid_input,
        unit_index = none,
        span = empty_span(),
        related_unit = none,
        related_span = empty_span(),
        detail = 0,
    };
}

fn input_empty(
    executable: bool
) -> Input {
    return {
        units = bytes::empty(),
        paths = bytes::empty(),
        unit_count = 0,
        executable = executable,
    };
}

fn input_storage_is_valid(
    input: Input
) -> bool {
    return bytes::is_valid(input.units) &&
        bytes::is_valid(input.paths) &&
        input.units.length % sizeof(Unit) == 0 &&
        input.unit_count <=
            Limit.maximum_modules as usize * 2 &&
        input.unit_count ==
            input.units.length / sizeof(Unit);
}

fn source_is_valid(
    source: text::View
) -> bool {
    if (!text::is_valid_utf8(source)) {
        return false;
    }
    var index: usize = 0;
    while (index < source.length) {
        if (source.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn unit_is_valid(
    unit: Unit
) -> bool {
    return source_is_valid(unit.source) &&
        lexer::token_buffer_is_valid(unit.tokens) &&
        parser::syntax_tree_is_valid(unit.tree) &&
        unit.tokens.count == unit.tree.token_count;
}

fn input_is_valid(
    input: Input
) -> bool {
    if (!input_storage_is_valid(input) ||
        input.unit_count == 0 ||
        input.unit_count >
            Limit.maximum_modules as usize * 2) {
        return false;
    }
    let units: *const Unit =
        input.units.data as *const Unit;
    var index: usize = 0;
    while (index < input.unit_count) {
        if (!unit_is_valid(units[index]) ||
            units[index].path_length > input.paths.length ||
            units[index].path_offset >
                input.paths.length - units[index].path_length) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn input_add(
    input: *Input,
    unit: Unit,
    path: text::View
) -> bool {
    if (input == null ||
        !input_storage_is_valid(*input) ||
        !unit_is_valid(unit) ||
        (path.length != 0 && path.data == null) ||
        input->unit_count >=
            Limit.maximum_modules as usize * 2) {
        return false;
    }
    var record: Unit = unit;
    record.path_offset = input->paths.length;
    record.path_length = path.length;
    let path_appended: bytes::BufferResult = bytes::append(
        input->paths,
        path.data,
        path.length
    );
    input->paths = path_appended.buffer;
    if (path_appended.error != runtime::Error.none) {
        return false;
    }
    let appended: bytes::BufferResult = bytes::append(
        input->units,
        (&record) as *const Unit as *const u8,
        sizeof(Unit)
    );
    input->units = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return false;
    }
    input->unit_count += 1;
    return true;
}

fn input_release(
    input: Input
) -> runtime::Error {
    if (!input_storage_is_valid(input)) {
        return runtime::Error.invalid_argument;
    }
    let units_error: runtime::Error = bytes::release(input.units);
    let paths_error: runtime::Error = bytes::release(input.paths);
    return units_error != runtime::Error.none ? units_error : paths_error;
}

fn diagnostics_empty()
    -> DiagnosticBuffer {
    return {
        storage = bytes::empty(),
        count = 0,
    };
}

fn diagnostics_storage_is_valid(
    diagnostics: DiagnosticBuffer
) -> bool {
    return bytes::is_valid(diagnostics.storage) &&
        diagnostics.storage.length %
            sizeof(Diagnostic) == 0 &&
        diagnostics.count <=
            Limit.maximum_diagnostics as usize &&
        diagnostics.count ==
            diagnostics.storage.length /
                sizeof(Diagnostic);
}

fn diagnostic_get(
    diagnostics: DiagnosticBuffer,
    index: usize
) -> DiagnosticResult {
    if (!diagnostics_storage_is_valid(
            diagnostics
        ) || index >= diagnostics.count) {
        return {
            diagnostic = invalid_diagnostic(),
            error = runtime::Error.invalid_argument,
        };
    }
    let records: *const Diagnostic =
        diagnostics.storage.data as
            *const Diagnostic;
    return {
        diagnostic = records[index],
        error = runtime::Error.none,
    };
}

fn add_diagnostic(
    context: *Context,
    kind: DiagnosticKind,
    unit_index: usize,
    span: lexer::SourceSpan,
    related_unit: usize,
    related_span: lexer::SourceSpan,
    detail: usize
) -> bool {
    if (context->error != runtime::Error.none) {
        return false;
    }
    if (context->diagnostics.count >=
        Limit.maximum_diagnostics as usize) {
        context->error = runtime::Error.out_of_memory;
        return false;
    }
    let diagnostic: Diagnostic = {
        kind = kind,
        unit_index = unit_index,
        span = span,
        related_unit = related_unit,
        related_span = related_span,
        detail = detail,
    };
    let appended: bytes::BufferResult = bytes::append(
        context->diagnostics.storage,
        (&diagnostic) as
            *const Diagnostic as *const u8,
        sizeof(Diagnostic)
    );
    context->diagnostics.storage = appended.buffer;
    context->error = appended.error;
    if (appended.error == runtime::Error.none) {
        context->diagnostics.count += 1;
        return true;
    }
    return false;
}

fn result_is_success(
    result: Result
) -> bool {
    return result.error == runtime::Error.none &&
        result.diagnostics.count == 0 &&
        type_info::table_is_valid(result.types, true) &&
        ir::is_valid(result.ir, result.types);
}

fn release_error(
    current: runtime::Error,
    next: runtime::Error
) -> runtime::Error {
    return current == runtime::Error.none ? next : current;
}

fn result_release(
    result: Result
) -> runtime::Error {
    if (!diagnostics_storage_is_valid(
            result.diagnostics
        ) ||
        !type_info::table_storage_is_valid(result.types) ||
        !ir::storage_is_valid(result.ir)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error =
        type_info::table_release(result.types);
    error = release_error(
        error,
        ir::release(result.ir)
    );
    error = release_error(
        error,
        bytes::release(result.diagnostics.storage)
    );
    return error;
}

fn context_storage_is_valid(
    context: *Context
) -> bool {
    return context != null &&
        bytes::is_valid(context->units) &&
        context->units.length %
            sizeof(UnitInfo) == 0 &&
        context->unit_count ==
            context->units.length /
                sizeof(UnitInfo) &&
        bytes::is_valid(context->modules) &&
        context->modules.length %
            sizeof(Module) == 0 &&
        context->module_count ==
            context->modules.length /
                sizeof(Module) &&
        bytes::is_valid(context->imports) &&
        context->imports.length %
            sizeof(Import) == 0 &&
        context->import_count ==
            context->imports.length /
                sizeof(Import) &&
        bytes::is_valid(context->symbols) &&
        context->symbols.length %
            sizeof(Symbol) == 0 &&
        context->symbol_count ==
            context->symbols.length /
                sizeof(Symbol) &&
        bytes::is_valid(context->functions) &&
        context->functions.length %
            sizeof(Function) == 0 &&
        context->function_count ==
            context->functions.length /
                sizeof(Function) &&
        bytes::is_valid(context->parameters) &&
        context->parameters.length %
            sizeof(Parameter) == 0 &&
        context->parameter_count ==
            context->parameters.length /
                sizeof(Parameter) &&
        bytes::is_valid(context->locals) &&
        context->locals.length %
            sizeof(Local) == 0 &&
        context->local_count ==
            context->locals.length /
                sizeof(Local) &&
        bytes::is_valid(
            context->alignment_overrides
        ) &&
        context->alignment_overrides.length %
            sizeof(AlignmentOverride) == 0 &&
        context->alignment_override_count ==
            context->alignment_overrides.length /
                sizeof(AlignmentOverride) &&
        bytes::is_valid(context->bitfield_segments) &&
        context->bitfield_segments.length %
            sizeof(BitfieldSegment) == 0 &&
        context->bitfield_segment_count ==
            context->bitfield_segments.length /
                sizeof(BitfieldSegment) &&
        bytes::is_valid(context->const_functions) &&
        context->const_functions.length %
            sizeof(ConstFunction) == 0 &&
        context->const_function_count ==
            context->const_functions.length /
                sizeof(ConstFunction) &&
        bytes::is_valid(context->const_locals) &&
        context->const_locals.length %
            sizeof(ConstLocal) == 0 &&
        context->const_local_count ==
            context->const_locals.length /
                sizeof(ConstLocal) &&
        bytes::is_valid(context->array_lengths) &&
        context->array_lengths.length %
            sizeof(ArrayLength) == 0 &&
        context->array_length_count ==
            context->array_lengths.length /
                sizeof(ArrayLength) &&
        bytes::is_valid(context->labels) &&
        context->labels.length %
            sizeof(Label) == 0 &&
        context->label_count ==
            context->labels.length /
                sizeof(Label) &&
        bytes::is_valid(context->label_locals) &&
        context->label_locals.length % sizeof(usize) == 0 &&
        bytes::is_valid(context->pending_gotos) &&
        context->pending_gotos.length %
            sizeof(PendingGoto) == 0 &&
        context->pending_goto_count ==
            context->pending_gotos.length /
                sizeof(PendingGoto) &&
        bytes::is_valid(context->goto_locals) &&
        context->goto_locals.length % sizeof(usize) == 0 &&
        bytes::is_valid(context->loop_labels) &&
        context->loop_labels.length %
            sizeof(LoopLabel) == 0 &&
        context->loop_label_count ==
            context->loop_labels.length /
                sizeof(LoopLabel) &&
        context->scope_depth <=
            Limit.maximum_scope_depth as usize &&
        context->type_depth <=
            Limit.maximum_type_depth as usize &&
        diagnostics_storage_is_valid(
            context->diagnostics
        ) &&
        type_info::table_storage_is_valid(context->types) &&
        ir::storage_is_valid(context->ir);
}

fn context_init(
    input: Input
) -> Context {
    return {
        input = input,
        units = bytes::empty(),
        unit_count = 0,
        modules = bytes::empty(),
        module_count = 0,
        imports = bytes::empty(),
        import_count = 0,
        symbols = bytes::empty(),
        symbol_count = 0,
        functions = bytes::empty(),
        function_count = 0,
        parameters = bytes::empty(),
        parameter_count = 0,
        locals = bytes::empty(),
        local_count = 0,
        alignment_overrides = bytes::empty(),
        alignment_override_count = 0,
        bitfield_segments = bytes::empty(),
        bitfield_segment_count = 0,
        const_functions = bytes::empty(),
        const_function_count = 0,
        const_locals = bytes::empty(),
        const_local_count = 0,
        array_lengths = bytes::empty(),
        array_length_count = 0,
        labels = bytes::empty(),
        label_count = 0,
        label_locals = bytes::empty(),
        pending_gotos = bytes::empty(),
        pending_goto_count = 0,
        goto_locals = bytes::empty(),
        loop_labels = bytes::empty(),
        loop_label_count = 0,
        pending_loop_label = no_id(),
        const_call_depth = 0,
        const_steps = 0,
        types = type_info::table_empty(),
        ir = ir::empty(),
        diagnostics = diagnostics_empty(),
        error = runtime::Error.none,
        current_function = no_id(),
        current_unit = no_id(),
        current_block = no_id(),
        scope_depth = 0,
        type_depth = 0,
        break_block = no_id(),
        continue_block = no_id(),
    };
}

fn context_release_work(
    context: *Context
) -> runtime::Error {
    if (!context_storage_is_valid(context)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error =
        bytes::release(context->units);
    error = release_error(
        error,
        bytes::release(context->modules)
    );
    error = release_error(
        error,
        bytes::release(context->imports)
    );
    error = release_error(
        error,
        bytes::release(context->symbols)
    );
    error = release_error(
        error,
        bytes::release(context->functions)
    );
    error = release_error(
        error,
        bytes::release(context->parameters)
    );
    error = release_error(
        error,
        bytes::release(context->locals)
    );
    error = release_error(
        error,
        bytes::release(context->alignment_overrides)
    );
    error = release_error(
        error,
        bytes::release(context->bitfield_segments)
    );
    error = release_error(
        error,
        bytes::release(context->const_functions)
    );
    error = release_error(
        error,
        bytes::release(context->const_locals)
    );
    error = release_error(
        error,
        bytes::release(context->array_lengths)
    );
    error = release_error(
        error,
        bytes::release(context->labels)
    );
    error = release_error(
        error,
        bytes::release(context->label_locals)
    );
    error = release_error(
        error,
        bytes::release(context->pending_gotos)
    );
    error = release_error(
        error,
        bytes::release(context->goto_locals)
    );
    error = release_error(
        error,
        bytes::release(context->loop_labels)
    );
    return error;
}

fn input_unit(
    context: *Context,
    unit_index: usize
) -> *const Unit {
    if (context == null ||
        unit_index >= context->input.unit_count) {
        return null;
    }
    let units: *const Unit =
        context->input.units.data as
            *const Unit;
    return &units[unit_index];
}

fn unit_path(
    context: *Context,
    unit_index: usize
) -> text::View {
    let unit: *const Unit =
        input_unit(context, unit_index);
    if (unit == null || unit->path_length == 0) {
        return { data = null, length = 0 };
    }
    let paths: *const u8 = context->input.paths.data as *const u8;
    return {
        data = &paths[unit->path_offset],
        length = unit->path_length,
    };
}

fn node(
    context: *Context,
    unit_index: usize,
    node_index: usize
) -> parser::SyntaxNode {
    let unit: *const Unit =
        input_unit(context, unit_index);
    if (unit == null) {
        return {
            kind = parser::SyntaxKind.invalid,
            span = empty_span(),
            token_index = no_id(),
            parent = no_id(),
            first_child = no_id(),
            last_child = no_id(),
            next_sibling = no_id(),
            child_count = 0,
            flags = 0,
        };
    }
    let result: parser::SyntaxNodeResult =
        parser::syntax_tree_get(unit->tree, node_index);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
    }
    return result.node;
}

fn token(
    context: *Context,
    unit_index: usize,
    token_index: usize
) -> lexer::Token {
    let unit: *const Unit =
        input_unit(context, unit_index);
    if (unit == null) {
        return {
            kind = lexer::TokenKind.invalid,
            span = empty_span(),
        };
    }
    let result: lexer::TokenResult =
        lexer::token_buffer_get(unit->tokens, token_index);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
    }
    return result.token;
}

fn text_equal(
    context: *Context,
    left_unit: usize,
    left_span: lexer::SourceSpan,
    right_unit: usize,
    right_span: lexer::SourceSpan
) -> bool {
    if (left_span.length != right_span.length) {
        return false;
    }
    let left: *const Unit =
        input_unit(context, left_unit);
    let right: *const Unit =
        input_unit(context, right_unit);
    if (left == null || right == null ||
        left_span.offset > left->source.length ||
        left_span.length >
            left->source.length - left_span.offset ||
        right_span.offset > right->source.length ||
        right_span.length >
            right->source.length - right_span.offset) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var index: usize = 0;
    while (index < left_span.length) {
        if (left->source.data[left_span.offset + index] !=
            right->source.data[right_span.offset + index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn tokens_equal(
    context: *Context,
    left_unit: usize,
    left_token: usize,
    right_unit: usize,
    right_token: usize
) -> bool {
    return text_equal(
        context,
        left_unit,
        token(
            context,
            left_unit,
            left_token
        ).span,
        right_unit,
        token(
            context,
            right_unit,
            right_token
        ).span
    );
}

// Children of an import declaration beyond the dotted module name — the
// `as` alias and the selective_import_names container — are not part of the
// module name being matched.
fn module_name_segment_count(node: parser::SyntaxNode) -> usize {
    var count: usize = node.child_count;
    if ((node.flags &
            (parser::SyntaxFlag.aliased_import as usize)) != 0 &&
        count != 0) {
        count -= 1;
    }
    if ((node.flags &
            (parser::SyntaxFlag.selective_import as usize)) != 0 &&
        count != 0) {
        count -= 1;
    }
    return count;
}

fn module_names_equal(
    context: *Context,
    left_unit: usize,
    left_node: usize,
    right_unit: usize,
    right_node: usize
) -> bool {
    let left: parser::SyntaxNode =
        node(context, left_unit, left_node);
    let right: parser::SyntaxNode =
        node(context, right_unit, right_node);
    let left_count: usize =
        module_name_segment_count(left);
    let right_count: usize =
        module_name_segment_count(right);
    if (left_count != right_count || left_count == 0) {
        return false;
    }
    var left_child: usize = left.first_child;
    var right_child: usize = right.first_child;
    var index: usize = 0;
    while (index < left_count) {
        let left_name: parser::SyntaxNode =
            node(
                context,
                left_unit,
                left_child
            );
        let right_name: parser::SyntaxNode =
            node(
                context,
                right_unit,
                right_child
            );
        if (!tokens_equal(
                context,
                left_unit,
                left_name.token_index,
                right_unit,
                right_name.token_index
            )) {
            return false;
        }
        left_child = left_name.next_sibling;
        right_child = right_name.next_sibling;
        index += 1;
    }
    return true;
}

fn append_record(
    context: *Context,
    destination: *bytes::Buffer,
    data: *const u8,
    length: usize
) -> bool {
    if (context->error != runtime::Error.none ||
        destination == null || data == null || length == 0) {
        return false;
    }
    let appended: bytes::BufferResult =
        bytes::append(*destination, data, length);
    *destination = appended.buffer;
    context->error = appended.error;
    return appended.error == runtime::Error.none;
}

fn append_unit_info(
    context: *Context,
    info: UnitInfo
) -> bool {
    if (!append_record(
            context,
            &context->units,
            (&info) as
                *const UnitInfo as *const u8,
            sizeof(UnitInfo)
        )) {
        return false;
    }
    context->unit_count += 1;
    return true;
}

fn append_module(
    context: *Context,
    module_record: Module
) -> usize {
    let result: usize = context->module_count;
    if (!append_record(
            context,
            &context->modules,
            (&module_record) as
                *const Module as *const u8,
            sizeof(Module)
        )) {
        return no_id();
    }
    context->module_count += 1;
    return result;
}

fn find_module_by_name(
    context: *Context,
    unit_index: usize,
    name_node: usize
) -> usize {
    let modules: *const Module =
        context->modules.data as
            *const Module;
    var index: usize = 0;
    while (index < context->module_count) {
        if (module_names_equal(
                context,
                unit_index,
                name_node,
                modules[index].name_unit,
                modules[index].name_node
            )) {
            return index;
        }
        index += 1;
    }
    return no_id();
}

fn program_module_node(
    context: *Context,
    unit_index: usize
) -> usize {
    let unit: *const Unit =
        input_unit(context, unit_index);
    let root: parser::SyntaxNode = node(
        context,
        unit_index,
        unit->tree.root
    );
    if (root.kind != parser::SyntaxKind.program ||
        root.child_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }
    let module_declaration: parser::SyntaxNode =
        node(
            context,
            unit_index,
            root.first_child
        );
    if (module_declaration.kind !=
        parser::SyntaxKind.module_declaration) {
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }
    return root.first_child;
}

fn append_import(
    context: *Context,
    record: Import
) -> usize {
    let result: usize = context->import_count;
    if (!append_record(
            context,
            &context->imports,
            (&record) as
                *const Import as *const u8,
            sizeof(Import)
        )) {
        return no_id();
    }
    context->import_count += 1;
    return result;
}

fn append_symbol(
    context: *Context,
    symbol: Symbol
) -> usize {
    let result: usize = context->symbol_count;
    if (!append_record(
            context,
            &context->symbols,
            (&symbol) as
                *const Symbol as *const u8,
            sizeof(Symbol)
        )) {
        return no_id();
    }
    context->symbol_count += 1;
    return result;
}

fn find_local_symbol(
    context: *Context,
    module_id: usize,
    unit_index: usize,
    name_token: usize,
    kind: SymbolKind,
    interface_scope: bool
) -> usize {
    let symbols: *const Symbol =
        context->symbols.data as
            *const Symbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        let symbol: Symbol = symbols[index];
        if (symbol.module_id == module_id &&
            symbol.kind == kind &&
            (!interface_scope ||
                (symbol.flags &
                    (SymbolFlag
                        .interface_declaration as usize)) != 0) &&
            tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return no_id();
}

fn find_any_local_symbol(
    context: *Context,
    module_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let symbols: *const Symbol =
        context->symbols.data as
            *const Symbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        let symbol: Symbol = symbols[index];
        if (symbol.module_id == module_id &&
            symbol.kind !=
                SymbolKind.enum_member &&
            tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return no_id();
}

fn unit_module(
    context: *Context,
    unit_index: usize
) -> usize {
    if (unit_index >= context->unit_count) {
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }
    let units: *const UnitInfo =
        context->units.data as
            *const UnitInfo;
    return units[unit_index].module_id;
}

fn unit_is_interface(
    context: *Context,
    unit_index: usize
) -> bool {
    if (unit_index >= context->unit_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let units: *const UnitInfo =
        context->units.data as
            *const UnitInfo;
    return units[unit_index].interface_unit != 0;
}

// Flat visibility contributed by one import: an aliased import binds no
// flat names, a selective import binds only the names listed in its
// selective_import_names container, and a plain import binds every exported
// name of its target module. Emits no diagnostics.
fn import_binds_name(
    context: *Context,
    import_record: Import,
    unit_index: usize,
    name_token: usize
) -> bool {
    let none: usize = no_id();
    if (import_record.alias_token != none) {
        return false;
    }
    if (import_record.selective_node == none) {
        return true;
    }
    var child: usize = node(
        context,
        import_record.source_unit,
        import_record.selective_node
    ).first_child;
    while (child != none) {
        let name_node: parser::SyntaxNode =
            node(
                context,
                import_record.source_unit,
                child
            );
        if (tokens_equal(
                context,
                unit_index,
                name_token,
                import_record.source_unit,
                name_node.token_index
            )) {
            return true;
        }
        child = name_node.next_sibling;
    }
    return false;
}

fn import_binds_symbol(
    context: *Context,
    import_record: Import,
    symbol: Symbol
) -> bool {
    return import_binds_name(
        context,
        import_record,
        symbol.declaration_unit,
        symbol.name_token
    );
}

fn find_imported_symbol(
    context: *Context,
    unit_index: usize,
    name_token: usize,
    kind: SymbolKind
) -> usize {
    let none: usize = no_id();
    let module_id: usize = unit_module(
        context,
        unit_index
    );
    let interface_scope: bool =
        unit_is_interface(
            context,
            unit_index
        );
    let modules: *const Module =
        context->modules.data as
            *const Module;
    let imports: *const Import =
        context->imports.data as
            *const Import;
    let symbols: *const Symbol =
        context->symbols.data as
            *const Symbol;
    var found: usize = none;
    var import_index: usize = 0;
    while (import_index < modules[module_id].import_count) {
        let import_record: Import =
            imports[modules[module_id].first_import + import_index];
        // An aliased import binds only its `<alias>::` qualifier and
        // contributes no flat names; a selective import binds only its
        // listed names flat.
        if ((!interface_scope ||
            import_record.interface_import) &&
            import_binds_name(
                context,
                import_record,
                unit_index,
                name_token
            )) {
            var symbol_index: usize = 0;
            while (symbol_index < context->symbol_count) {
                let symbol: Symbol =
                    symbols[symbol_index];
                if (symbol.module_id ==
                        import_record.target_module &&
                    symbol.kind == kind &&
                    (symbol.flags &
                        (SymbolFlag
                            .exported as usize)) != 0 &&
                    tokens_equal(
                        context,
                        unit_index,
                        name_token,
                        symbol.declaration_unit,
                        symbol.name_token
                    )) {
                    if (found != none && found != symbol_index) {
                        add_diagnostic(
                            context,
                            DiagnosticKind
                                .ambiguous_import,
                            unit_index,
                            token(
                                context,
                                unit_index,
                                name_token
                            ).span,
                            symbols[found].declaration_unit,
                            token(
                                context,
                                symbols[found].declaration_unit,
                                symbols[found].name_token
                            ).span,
                            symbol_index
                        );
                        return none;
                    }
                    found = symbol_index;
                }
                symbol_index += 1;
            }
        }
        import_index += 1;
    }
    return found;
}

fn lookup_symbol(
    context: *Context,
    unit_index: usize,
    name_token: usize,
    kind: SymbolKind
) -> usize {
    let module_id: usize = unit_module(
        context,
        unit_index
    );
    let local: usize = find_local_symbol(
        context,
        module_id,
        unit_index,
        name_token,
        kind,
        unit_is_interface(
            context,
            unit_index
        )
    );
    if (local != no_id()) {
        return local;
    }
    return find_imported_symbol(
        context,
        unit_index,
        name_token,
        kind
    );
}

// Resolves a `qual::` qualifier against the unit's direct imports, using the
// same visibility rule as flat imports (an interface unit sees only imports
// written in the interface). A qualifier matches an import's alias, or — for
// a plain import — the last segment of the target module's name. Returns the
// target module, or no-id when nothing matches or when two or more distinct
// modules match (then *ambiguous is set). Emits no diagnostics.
fn find_qualifier_target(
    context: *Context,
    unit_index: usize,
    qualifier_token: usize,
    ambiguous: *bool
) -> usize {
    let none: usize = no_id();
    if (ambiguous == null) {
        context->error = runtime::Error.invalid_argument;
        return none;
    }
    *ambiguous = false;
    let module_id: usize = unit_module(
        context,
        unit_index
    );
    let interface_scope: bool =
        unit_is_interface(
            context,
            unit_index
        );
    let modules: *const Module =
        context->modules.data as
            *const Module;
    let imports: *const Import =
        context->imports.data as
            *const Import;
    var found: usize = none;
    var import_index: usize = 0;
    while (import_index < modules[module_id].import_count) {
        let import_record: Import =
            imports[modules[module_id].first_import + import_index];
        if (!interface_scope ||
            import_record.interface_import) {
            var matches: bool = false;
            if (import_record.alias_token != none) {
                matches = tokens_equal(
                    context,
                    unit_index,
                    qualifier_token,
                    import_record.source_unit,
                    import_record.alias_token
                );
            } else {
                let name_node: parser::SyntaxNode =
                    node(
                        context,
                        modules[import_record.target_module].name_unit,
                        modules[import_record.target_module].name_node
                    );
                if (name_node.child_count != 0) {
                    let last_segment: parser::SyntaxNode =
                        node(
                            context,
                            modules[import_record.target_module]
                                .name_unit,
                            name_node.last_child
                        );
                    matches = tokens_equal(
                        context,
                        unit_index,
                        qualifier_token,
                        modules[import_record.target_module].name_unit,
                        last_segment.token_index
                    );
                }
            }
            if (matches) {
                if (found != none &&
                    found != import_record.target_module) {
                    *ambiguous = true;
                    return none;
                }
                found = import_record.target_module;
            }
        }
        import_index += 1;
    }
    return found;
}

// Diagnosing wrapper around find_qualifier_target:
// reports unknown_module_qualifier or ambiguous_module_qualifier.
fn resolve_module_qualifier(
    context: *Context,
    unit_index: usize,
    qualifier_token: usize,
    qualifier_span: lexer::SourceSpan
) -> usize {
    var ambiguous: bool = false;
    let target: usize = find_qualifier_target(
        context,
        unit_index,
        qualifier_token,
        &ambiguous
    );
    if (target == no_id()) {
        add_diagnostic(
            context,
            ambiguous ?
                DiagnosticKind
                    .ambiguous_module_qualifier :
                DiagnosticKind
                    .unknown_module_qualifier,
            unit_index,
            qualifier_span,
            no_id(),
            empty_span(),
            qualifier_token
        );
    }
    return target;
}

// Finds the exported symbol of `kind` named `name_token` inside `module_id`,
// without considering any imports. Emits no diagnostics.
fn find_module_symbol(
    context: *Context,
    unit_index: usize,
    module_id: usize,
    name_token: usize,
    kind: SymbolKind
) -> usize {
    let symbols: *const Symbol =
        context->symbols.data as
            *const Symbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        let symbol: Symbol = symbols[index];
        if (symbol.module_id == module_id &&
            symbol.kind == kind &&
            (symbol.flags &
                (SymbolFlag
                    .exported as usize)) != 0 &&
            tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return no_id();
}

// Node-aware lookup: an unqualified name_expression delegates to
// lookup_symbol; a qualified `qual::name` node (qualifier
// segments carried as children) resolves the qualifier against the unit's
// direct imports and searches only that module's exports. Exactly one
// qualifier segment is supported; longer chains are rejected with
// invalid_qualified_path. Diagnostics (unknown/ambiguous qualifier, unknown
// qualified name, invalid path) are emitted only when `diagnose` is set, so
// speculative callers can probe quietly and report once.
fn lookup_qualified_symbol(
    context: *Context,
    unit_index: usize,
    path: parser::SyntaxNode,
    kind: SymbolKind,
    diagnose: bool
) -> usize {
    let none: usize = no_id();
    if (path.child_count == 0) {
        return lookup_symbol(
            context,
            unit_index,
            path.token_index,
            kind
        );
    }
    if (path.child_count > 1) {
        if (diagnose) {
            add_diagnostic(
                context,
                DiagnosticKind
                    .invalid_qualified_path,
                unit_index,
                path.span,
                none,
                empty_span(),
                path.token_index
            );
        }
        return none;
    }
    let qualifier: parser::SyntaxNode = node(
        context,
        unit_index,
        path.first_child
    );
    var ambiguous: bool = false;
    let target: usize = find_qualifier_target(
        context,
        unit_index,
        qualifier.token_index,
        &ambiguous
    );
    if (target == none) {
        if (diagnose) {
            add_diagnostic(
                context,
                ambiguous ?
                    DiagnosticKind
                        .ambiguous_module_qualifier :
                    DiagnosticKind
                        .unknown_module_qualifier,
                unit_index,
                qualifier.span,
                none,
                empty_span(),
                qualifier.token_index
            );
        }
        return none;
    }
    let symbol_id: usize = find_module_symbol(
        context,
        unit_index,
        target,
        path.token_index,
        kind
    );
    if (symbol_id == none && diagnose) {
        let modules: *const Module =
            context->modules.data as
                *const Module;
        add_diagnostic(
            context,
            DiagnosticKind
                .unknown_qualified_name,
            unit_index,
            path.span,
            modules[target].name_unit,
            node(
                context,
                modules[target].name_unit,
                modules[target].name_node
            ).span,
            path.token_index
        );
    }
    return symbol_id;
}

fn first_declaration(
    context: *Context,
    unit_index: usize
) -> usize {
    let none: usize = no_id();
    if (unit_index == none) {
        return none;
    }
    let unit: *const Unit =
        input_unit(context, unit_index);
    let root: parser::SyntaxNode =
        node(
            context,
            unit_index,
            unit->tree.root
        );
    var child: usize = root.first_child;
    while (child != none) {
        let node: parser::SyntaxNode =
            node(
                context,
                unit_index,
                child
            );
        if (node.kind !=
                parser::SyntaxKind.module_declaration &&
            node.kind !=
                parser::SyntaxKind.import_declaration) {
            return child;
        }
        child = node.next_sibling;
    }
    return none;
}

fn parse_unsigned(
    context: *Context,
    unit_index: usize,
    token_index: usize,
    value: *u64
) -> bool {
    let token: lexer::Token = token(
        context,
        unit_index,
        token_index
    );
    let unit: *const Unit =
        input_unit(context, unit_index);
    if (token.kind != lexer::TokenKind.integer ||
        value == null || token.span.length == 0) {
        return false;
    }
    var base: u64 = 10;
    var index: usize = 0;
    if (token.span.length >= 2 &&
        unit->source.data[token.span.offset] == 48) {
        let prefix: u8 =
            unit->source.data[token.span.offset + 1];
        if (prefix == 98 || prefix == 66) {
            base = 2;
            index = 2;
        } else if (prefix == 111 || prefix == 79) {
            base = 8;
            index = 2;
        } else if (prefix == 120 || prefix == 88) {
            base = 16;
            index = 2;
        }
    }
    var result: u64 = 0;
    while (index < token.span.length) {
        let byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte == 95) {
            index += 1;
            continue;
        }
        var digit: u64 = 0;
        if (byte >= 48 && byte <= 57) {
            digit = (byte - 48) as u64;
        } else if (byte >= 65 && byte <= 70) {
            digit = (byte - 65 + 10) as u64;
        } else if (byte >= 97 && byte <= 102) {
            digit = (byte - 97 + 10) as u64;
        } else {
            return false;
        }
        if (digit >= base ||
            result > (18446744073709551615 - digit) / base) {
            return false;
        }
        result = result * base + digit;
        index += 1;
    }
    *value = result;
    return true;
}

fn hex_digit_value(
    byte: u8
) -> usize {
    if (byte >= 48 && byte <= 57) {
        return (byte - 48) as usize;
    }
    if (byte >= 65 && byte <= 70) {
        return (byte - 65 + 10) as usize;
    }
    if (byte >= 97 && byte <= 102) {
        return (byte - 97 + 10) as usize;
    }
    return no_id();
}

// Decodes a character literal token (quotes included in the span) into its
// single code unit. The escape set matches string literals; anything that
// does not decode to exactly one code unit (empty, multi-code-unit content or
// an unknown escape) is rejected so C-style multi-character constants never
// reach lowering.
fn decode_character(
    context: *Context,
    unit_index: usize,
    token_index: usize,
    value: *u64
) -> bool {
    let token: lexer::Token = token(
        context,
        unit_index,
        token_index
    );
    let unit: *const Unit =
        input_unit(context, unit_index);
    if (token.kind != lexer::TokenKind.character || value == null ||
        token.span.length < 3) {
        return false;
    }
    var code: u64 = 0;
    var next: usize = 0;
    let first: u8 = unit->source.data[token.span.offset + 1];
    if (first != 92) {
        code = first as u64;
        next = 2;
    } else {
        if (token.span.length < 4) {
            return false;
        }
        let escape: u8 = unit->source.data[token.span.offset + 2];
        if (escape == 110) {
            code = 10;
            next = 3;
        } else if (escape == 114) {
            code = 13;
            next = 3;
        } else if (escape == 116) {
            code = 9;
            next = 3;
        } else if (escape == 48) {
            code = 0;
            next = 3;
        } else if (escape == 92 || escape == 39 || escape == 34) {
            code = escape as u64;
            next = 3;
        } else if (escape == 120) {
            if (token.span.length < 6) {
                return false;
            }
            let high: usize = hex_digit_value(
                unit->source.data[token.span.offset + 3]
            );
            let low: usize = hex_digit_value(
                unit->source.data[token.span.offset + 4]
            );
            if (high == no_id() ||
                low == no_id()) {
                return false;
            }
            code = (high * 16 + low) as u64;
            next = 5;
        } else {
            return false;
        }
    }
    if (next != token.span.length - 1) {
        return false;
    }
    *value = code;
    return true;
}

fn function_pointer_type(
    context: *Context,
    return_type: usize,
    parameter_types: *const usize,
    parameter_count: usize
) -> usize {
    let none: usize = no_id();
    if (parameter_count != 0 && parameter_types == null) {
        context->error = runtime::Error.invalid_argument;
        return none;
    }
    let records: *const type_info::Record =
        context->types.types.data as
            *const type_info::Record;
    let fields: *const type_info::Field =
        context->types.fields.data as
            *const type_info::Field;
    var candidate: usize =
        type_info::BuiltinType.count as usize;
    while (candidate < context->types.type_count) {
        let record: type_info::Record = records[candidate];
        if (record.kind ==
                type_info::Kind.function_pointer &&
            record.element_type == return_type &&
            record.field_count == parameter_count) {
            var index: usize = 0;
            var same: bool = true;
            while (index < parameter_count && same) {
                if (fields[record.first_field + index]
                        .type_id != parameter_types[index]) {
                    same = false;
                }
                index += 1;
            }
            if (same) {
                return candidate;
            }
        }
        candidate += 1;
    }
    let type_id: usize = context->types.type_count;
    let created: type_info::TableResult =
        type_info::table_add_function_pointer(
            context->types,
            return_type
        );
    context->types = created.table;
    if (created.error != runtime::Error.none) {
        context->error = created.error;
        return none;
    }
    var index: usize = 0;
    while (index < parameter_count) {
        let added: type_info::TableResult =
            type_info::table_add_parameter(
                context->types,
                type_id,
                parameter_types[index]
            );
        context->types = added.table;
        if (added.error != runtime::Error.none) {
            add_diagnostic(
                context,
                DiagnosticKind.invalid_external,
                context->current_unit,
                empty_span(),
                none,
                empty_span(),
                parameter_types[index]
            );
            return none;
        }
        index += 1;
    }
    context->error = type_info::table_set_layout(
        context->types,
        type_id,
        8,
        8
    );
    if (context->error != runtime::Error.none) {
        return none;
    }
    return type_id;
}

fn align_up(
    value: usize,
    alignment: usize,
    result: *usize
) -> bool {
    if (alignment == 0 ||
        (alignment & (alignment - 1)) != 0 ||
        result == null) {
        return false;
    }
    let mask: usize = alignment - 1;
    if (value >
        (Limit.maximum_size as usize) - mask) {
        return false;
    }
    *result = (value + mask) & ~mask;
    return true;
}

fn integer_fits_type(
    kind: type_info::Kind,
    magnitude: u64,
    negative: bool
) -> bool {
    let bits: usize = type_info::bit_width(kind);
    if (bits == 0 || bits > 64) {
        return false;
    }
    if (!type_info::is_signed_integer(kind)) {
        return !negative &&
            (bits == 64 ||
                magnitude < (1 as u64) << (bits as u64));
    }
    if (bits == 64) {
        return negative ?
            magnitude <= 9223372036854775808 :
            magnitude <= 9223372036854775807;
    }
    let maximum: u64 =
        (1 as u64) << ((bits - 1) as u64);
    return negative ?
        magnitude <= maximum :
        magnitude < maximum;
}

fn type_record(
    context: *Context,
    type_id: usize
) -> type_info::Record {
    let result: type_info::RecordResult =
        type_info::table_get(context->types, type_id);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
    }
    return result.record;
}

fn current_ir_function(
    context: *Context
) -> usize {
    if (context->current_function >=
        context->function_count) {
        context->error = runtime::Error.invalid_argument;
        return no_id();
    }
    let functions: *const Function =
        context->functions.data as
            *const Function;
    return functions[context->current_function].ir_function;
}

fn current_function_is_variadic(
    context: *Context
) -> bool {
    if (context->current_function >=
        context->function_count) {
        return false;
    }
    let functions: *const Function =
        context->functions.data as
            *const Function;
    return (functions[context->current_function].flags &
        (SymbolFlag.variadic as usize)) != 0;
}

fn instruction(
    opcode: ir::Opcode,
    node: parser::SyntaxNode
) -> ir::Instruction {
    let none: usize = no_id();
    return {
        opcode = opcode,
        operation = lexer::TokenKind.invalid,
        type_id = none,
        result = none,
        left = none,
        right = none,
        third = none,
        auxiliary = none,
        immediate = 0,
        floating = 0.0,
        block_id = none,
        next_instruction = none,
        span = node.span,
    };
}

fn emit_value(
    context: *Context,
    instruction: ir::Instruction,
    type_id: usize
) -> usize {
    let none: usize = no_id();
    if (context->error != runtime::Error.none ||
        context->current_block == none ||
        type_id == none) {
        return none;
    }
    let value_id: usize = ir::add_value(
        &context->ir,
        current_ir_function(context),
        context->current_block,
        type_id
    );
    if (value_id == none) {
        context->error = context->ir.error;
        return none;
    }
    var record: ir::Instruction = instruction;
    record.type_id = type_id;
    record.result = value_id;
    record.block_id = context->current_block;
    if (ir::emit(&context->ir, record) == none) {
        context->error = context->ir.error;
        return none;
    }
    return value_id;
}

fn emit_void(
    context: *Context,
    instruction: ir::Instruction
) -> usize {
    var record: ir::Instruction = instruction;
    record.block_id = context->current_block;
    let instruction_id: usize =
        ir::emit(&context->ir, record);
    if (instruction_id == no_id()) {
        context->error = context->ir.error;
    }
    return instruction_id;
}

fn emit_integer_constant(
    context: *Context,
    node: parser::SyntaxNode,
    type_id: usize,
    value: u64
) -> Expression {
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.constant_integer,
            node
        );
    instruction.immediate = value;
    let value_id: usize = emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = no_id(),
        constant_value = value,
        has_constant = true,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != no_id(),
        bitfield_segment = no_id(),
    };
}

fn emit_boolean_constant(
    context: *Context,
    node: parser::SyntaxNode,
    value: bool
) -> Expression {
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.constant_boolean,
            node
        );
    instruction.immediate = value ? 1 : 0;
    let type_id: usize =
        type_info::BuiltinType.boolean as usize;
    let value_id: usize = emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = no_id(),
        constant_value = instruction.immediate,
        has_constant = true,
        lvalue = false,
        mutable_lvalue = false,
        volatile_lvalue = false,
        valid = value_id != no_id(),
        bitfield_segment = no_id(),
    };
}

fn append_local(
    context: *Context,
    local: Local
) -> usize {
    let result: usize = context->local_count;
    if (!append_record(
            context,
            &context->locals,
            (&local) as
                *const Local as *const u8,
            sizeof(Local)
        )) {
        return no_id();
    }
    context->local_count += 1;
    return result;
}

fn append_alignment_override(
    context: *Context,
    declaration_unit: usize,
    declaration_node: usize,
    alignment: usize
) -> bool {
    let entry: AlignmentOverride = {
        declaration_unit = declaration_unit,
        declaration_node = declaration_node,
        alignment = alignment,
    };
    if (!append_record(
            context,
            &context->alignment_overrides,
            (&entry) as
                *const AlignmentOverride as
                *const u8,
            sizeof(AlignmentOverride)
        )) {
        return false;
    }
    context->alignment_override_count += 1;
    return true;
}

fn alignment_override(
    context: *Context,
    declaration_unit: usize,
    declaration_node: usize
) -> usize {
    let overrides: *const AlignmentOverride =
        context->alignment_overrides.data as
            *const AlignmentOverride;
    var index: usize = 0;
    while (index < context->alignment_override_count) {
        if (overrides[index].declaration_unit == declaration_unit &&
            overrides[index].declaration_node == declaration_node) {
            return overrides[index].alignment;
        }
        index += 1;
    }
    return 0;
}

fn append_bitfield_segment(
    context: *Context,
    segment: BitfieldSegment
) -> bool {
    if (!append_record(
            context,
            &context->bitfield_segments,
            (&segment) as
                *const BitfieldSegment as *const u8,
            sizeof(BitfieldSegment)
        )) {
        return false;
    }
    context->bitfield_segment_count += 1;
    return true;
}

fn find_array_length(
    context: *Context,
    unit_index: usize,
    node_index: usize
) -> usize {
    let lengths: *const ArrayLength =
        context->array_lengths.data as
            *const ArrayLength;
    var index: usize = 0;
    while (index < context->array_length_count) {
        if (lengths[index].unit_index == unit_index &&
            lengths[index].node_index == node_index) {
            return index;
        }
        index += 1;
    }
    return no_id();
}

fn bitfield_segment(
    context: *Context,
    segment_id: usize
) -> BitfieldSegment {
    let segments: *const BitfieldSegment =
        context->bitfield_segments.data as
            *const BitfieldSegment;
    if (segment_id >= context->bitfield_segment_count) {
        return {
            declaration_unit = no_id(),
            declaration_node = no_id(),
            name_token = no_id(),
            bit_offset = 0,
            bit_width = 0,
        };
    }
    return segments[segment_id];
}

fn bitfield_storage_field(
    context: *Context,
    segment: BitfieldSegment
) -> usize {
    let fields: *const type_info::Field =
        context->types.fields.data as *const type_info::Field;
    var field_id: usize = 0;
    while (field_id < context->types.field_count) {
        if (fields[field_id].declaration_unit ==
                segment.declaration_unit &&
            fields[field_id].declaration_node ==
                segment.declaration_node) {
            return field_id;
        }
        field_id += 1;
    }
    return no_id();
}

fn lookup_bitfield_segment(
    context: *Context,
    owner_type: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let record: type_info::Record =
        type_record(context, owner_type);
    let fields: *const type_info::Field =
        context->types.fields.data as *const type_info::Field;
    let segments: *const BitfieldSegment =
        context->bitfield_segments.data as
            *const BitfieldSegment;
    var field_index: usize = 0;
    while (field_index < record.field_count) {
        let field: type_info::Field =
            fields[record.first_field + field_index];
        var segment_id: usize = 0;
        while (segment_id < context->bitfield_segment_count) {
            if (segments[segment_id].declaration_unit ==
                    field.declaration_unit &&
                segments[segment_id].declaration_node ==
                    field.declaration_node &&
                tokens_equal(
                    context,
                    unit_index,
                    name_token,
                    segments[segment_id].declaration_unit,
                    segments[segment_id].name_token
                )) {
                return segment_id;
            }
            segment_id += 1;
        }
        field_index += 1;
    }
    return no_id();
}

fn find_local(
    context: *Context,
    unit_index: usize,
    name_token: usize
) -> usize {
    let locals: *const Local =
        context->locals.data as
            *const Local;
    var index: usize = context->local_count;
    while (index != 0) {
        index -= 1;
        if (locals[index].function_id ==
                context->current_function &&
            locals[index].scope_depth <= context->scope_depth &&
            tokens_equal(
                context,
                unit_index,
                name_token,
                locals[index].unit_index,
                locals[index].name_token
            )) {
            return index;
        }
    }
    return no_id();
}

fn local_in_current_scope(
    context: *Context,
    unit_index: usize,
    name_token: usize
) -> usize {
    let locals: *const Local =
        context->locals.data as
            *const Local;
    var index: usize = context->local_count;
    while (index != 0) {
        index -= 1;
        if (locals[index].function_id !=
            context->current_function) {
            break;
        }
        if (locals[index].scope_depth < context->scope_depth) {
            break;
        }
        if (locals[index].scope_depth == context->scope_depth &&
            tokens_equal(
                context,
                unit_index,
                name_token,
                locals[index].unit_index,
                locals[index].name_token
            )) {
            return index;
        }
    }
    return no_id();
}

fn address_of_slot(
    context: *Context,
    node: parser::SyntaxNode,
    slot_id: usize,
    value_type: usize,
    read_only: bool,
    volatile_pointee: bool
) -> usize {
    let pointer: type_info::IdResult =
        type_info::table_pointer(
            &context->types,
            value_type,
            read_only,
            volatile_pointee
        );
    if (pointer.error != runtime::Error.none) {
        context->error = pointer.error;
        return no_id();
    }
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.address_of_slot,
            node
        );
    instruction.auxiliary = slot_id;
    return emit_value(
        context,
        instruction,
        pointer.type_id
    );
}

fn load_lvalue(
    context: *Context,
    node: parser::SyntaxNode,
    expression: Expression
) -> Expression {
    if (!expression.valid || !expression.lvalue) {
        return expression;
    }
    let type_record: type_info::Record =
        type_record(
            context,
            expression.type_id
        );
    if (type_info::is_memory(type_record.kind)) {
        return expression;
    }
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.load_indirect,
            node
        );
    instruction.left = expression.address_id;
    let value_id: usize = emit_value(
        context,
        instruction,
        expression.type_id
    );
    var result: Expression = expression;
    result.value_id = value_id;
    result.valid =
        value_id != no_id();
    return result;
}

fn mask_integer(
    value: u64,
    bits: usize
) -> u64 {
    if (bits >= 64) {
        return value;
    }
    return value & (((1 as u64) << (bits as u64)) - 1);
}

fn store_to_address(
    context: *Context,
    node: parser::SyntaxNode,
    destination: usize,
    type_id: usize,
    value: Expression
) -> bool {
    if (!value.valid || value.type_id != type_id ||
        destination == no_id()) {
        return false;
    }
    let type_record: type_info::Record =
        type_record(context, type_id);
    var instruction: ir::Instruction =
        instruction(
            type_info::is_memory(type_record.kind) ?
                ir::Opcode.memory_copy :
                ir::Opcode.store_indirect,
            node
        );
    instruction.left = destination;
    instruction.right = type_info::is_memory(
        type_record.kind
    ) ? value.address_id : value.value_id;
    instruction.type_id = type_id;
    instruction.auxiliary = type_record.size_bytes;
    return emit_void(
        context,
        instruction
    ) != no_id();
}

fn zero_slot(
    context: *Context,
    node: parser::SyntaxNode,
    slot_id: usize,
    type_id: usize
) -> bool {
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.zero_slot,
            node
        );
    instruction.type_id = type_id;
    instruction.auxiliary = slot_id;
    return emit_void(
        context,
        instruction
    ) != no_id();
}

fn emit_jump(
    context: *Context,
    node: parser::SyntaxNode,
    target_block: usize
) -> bool {
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.jump,
            node
        );
    instruction.auxiliary = target_block;
    return emit_void(
        context,
        instruction
    ) != no_id();
}

fn emit_branch(
    context: *Context,
    node: parser::SyntaxNode,
    condition: usize,
    true_block: usize,
    false_block: usize
) -> bool {
    var instruction: ir::Instruction =
        instruction(
            ir::Opcode.branch,
            node
        );
    instruction.left = condition;
    instruction.auxiliary = true_block;
    instruction.third = false_block;
    return emit_void(
        context,
        instruction
    ) != no_id();
}

fn add_current_block(
    context: *Context
) -> usize {
    let block_id: usize = ir::add_block(
        &context->ir,
        current_ir_function(context)
    );
    if (block_id == no_id()) {
        context->error = context->ir.error;
    }
    return block_id;
}

fn block_is_terminated(
    context: *Context,
    block_id: usize
) -> bool {
    let result: ir::BlockResult =
        ir::get_block(context->ir, block_id);
    if (result.error != runtime::Error.none) {
        context->error = result.error;
        return true;
    }
    return result.block.terminated;
}

fn enqueue_reachable_block(
    context: *Context,
    function: ir::Function,
    block_id: usize,
    reached: *bytes::Buffer,
    pending: *bytes::Buffer
) -> bool {
    if (block_id < function.first_block ||
        block_id - function.first_block >=
            function.block_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let local_id: usize =
        block_id - function.first_block;
    if (reached->data[local_id] != 0) {
        return true;
    }
    reached->data[local_id] = 1;
    let appended: bytes::BufferResult =
        bytes::append(
            *pending,
            (&block_id) as *const usize as *const u8,
            sizeof(usize)
        );
    *pending = appended.buffer;
    context->error = appended.error;
    return appended.error == runtime::Error.none;
}

fn block_is_reachable(
    context: *Context,
    function: ir::Function,
    target_block: usize
) -> bool {
    if (function.block_count == 0 ||
        target_block < function.first_block ||
        target_block - function.first_block >=
            function.block_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    var reached: bytes::Buffer =
        bytes::empty();
    while (reached.length < function.block_count &&
        context->error == runtime::Error.none) {
        let pushed: bytes::BufferResult =
            bytes::push(reached, 0);
        reached = pushed.buffer;
        context->error = pushed.error;
    }
    var pending: bytes::Buffer =
        bytes::empty();
    if (context->error == runtime::Error.none) {
        enqueue_reachable_block(
            context,
            function,
            function.first_block,
            &reached,
            &pending
        );
    }
    var cursor: usize = 0;
    let blocks: *const ir::Block =
        context->ir.blocks.data as
            *const ir::Block;
    let instructions: *const ir::Instruction =
        context->ir.instructions.data as
            *const ir::Instruction;
    while (cursor < pending.length &&
        context->error == runtime::Error.none) {
        let pending_blocks: *const usize =
            pending.data as *const usize;
        let block_id: usize =
            pending_blocks[cursor / sizeof(usize)];
        cursor += sizeof(usize);
        let block: ir::Block =
            blocks[block_id];
        if (block.terminated) {
            let instruction: ir::Instruction =
                instructions[block.last_instruction];
            if (instruction.opcode ==
                ir::Opcode.jump) {
                enqueue_reachable_block(
                    context,
                    function,
                    instruction.auxiliary,
                    &reached,
                    &pending
                );
            } else if (instruction.opcode ==
                ir::Opcode.branch) {
                enqueue_reachable_block(
                    context,
                    function,
                    instruction.auxiliary,
                    &reached,
                    &pending
                );
                enqueue_reachable_block(
                    context,
                    function,
                    instruction.third,
                    &reached,
                    &pending
                );
            }
        }
    }
    let reachable: bool =
        context->error == runtime::Error.none &&
        reached.data[
            target_block - function.first_block
        ] != 0;
    var release_result: runtime::Error =
        bytes::release(reached);
    release_result = release_error(
        release_result,
        bytes::release(pending)
    );
    if (context->error == runtime::Error.none) {
        context->error = release_result;
    }
    return reachable;
}

fn terminate_unreachable_blocks(
    context: *Context,
    function: ir::Function,
    node: parser::SyntaxNode
) -> bool {
    var index: usize = 0;
    while (index < function.block_count &&
        context->error == runtime::Error.none) {
        let block_id: usize = function.first_block + index;
        let result: ir::BlockResult =
            ir::get_block(context->ir, block_id);
        if (result.error != runtime::Error.none) {
            context->error = result.error;
            return false;
        }
        if (result.block.instruction_count != 0 &&
            !result.block.terminated &&
            !block_is_reachable(
                context,
                function,
                block_id
            )) {
            let saved_block: usize = context->current_block;
            context->current_block = block_id;
            var instruction: ir::Instruction =
                instruction(
                    ir::Opcode.unreachable,
                    node
                );
            emit_void(context, instruction);
            context->current_block = saved_block;
        }
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn enter_scope(
    context: *Context
) -> usize {
    let local_start: usize = context->local_count;
    if (context->scope_depth >=
        Limit.maximum_scope_depth as usize) {
        add_diagnostic(
            context,
            DiagnosticKind.resource_limit,
            context->current_unit,
            empty_span(),
            no_id(),
            empty_span(),
            context->scope_depth
        );
        return no_id();
    }
    context->scope_depth += 1;
    return local_start;
}

fn leave_scope(
    context: *Context,
    local_start: usize
) -> bool {
    if (context->scope_depth == 0 ||
        local_start == no_id() ||
        local_start > context->local_count) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let truncated: bytes::BufferResult =
        bytes::truncate(
            context->locals,
            local_start * sizeof(Local)
        );
    context->locals = truncated.buffer;
    context->error = truncated.error;
    context->local_count = local_start;
    context->scope_depth -= 1;
    return context->error == runtime::Error.none;
}

fn token_equals_bytes(
    context: *Context,
    unit_index: usize,
    token_index: usize,
    bytes: *const u8,
    length: usize
) -> bool {
    if (bytes == null) {
        return false;
    }
    let token: lexer::Token = token(
        context,
        unit_index,
        token_index
    );
    let unit: *const Unit =
        input_unit(context, unit_index);
    if (token.span.length != length) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (unit->source.data[token.span.offset + index] !=
            bytes[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}
