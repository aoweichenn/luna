export fn bootstrap_semantic_find_field( context: *BootstrapSemanticContext, type_id: usize, unit_index: usize, name_token: usize ) -> usize;

export enum BootstrapSemanticFieldStatus: usize {
    missing, found, ambiguous,
}

export struct BootstrapSemanticFieldLookup {
    status: BootstrapSemanticFieldStatus;
    field_id: usize;
    offset_bytes: usize;
}

export fn bootstrap_semantic_field_is_anonymous( context: *BootstrapSemanticContext, field: type_info::Field ) -> bool;

