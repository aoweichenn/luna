export fn bootstrap_semantic_declaration_type_kind( kind: parser::SyntaxKind ) -> type_info::Kind;

export fn bootstrap_semantic_collect_types_in_unit( context: *BootstrapSemanticContext, module_id: usize, unit_index: usize ) -> bool;

