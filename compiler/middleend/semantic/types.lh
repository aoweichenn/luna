export fn bootstrap_semantic_resolve_record_layout( context: *BootstrapSemanticContext, type_id: usize, record: type_info::Record ) -> bool;

export fn bootstrap_semantic_enum_value( context: *BootstrapSemanticContext, unit_index: usize, member: parser::SyntaxNode, underlying_kind: type_info::Kind, implicit_value: u64, value: *u64, pending: *bool ) -> bool;

export fn bootstrap_semantic_enum_can_increment( kind: type_info::Kind, value: u64 ) -> bool;

