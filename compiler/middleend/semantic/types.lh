export fn bootstrap_semantic_public_anonymous_fields_valid( context: *BootstrapSemanticContext, type_id: usize, symbol: BootstrapSemanticSymbol ) -> bool;

export fn bootstrap_semantic_find_enum_member( context: *BootstrapSemanticContext, type_id: usize, unit_index: usize, name_token: usize ) -> usize;

