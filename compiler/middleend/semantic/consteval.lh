export struct BootstrapConstValue {
    is_constant: bool;
    is_boolean: bool;
    value: u64;
    error: bool;
}

export struct BootstrapSemanticAlignment {
    alignment: usize;
    valid: bool;
}

export fn bootstrap_consteval_expression( context: *BootstrapSemanticContext, unit_index: usize, node_index: usize ) -> BootstrapConstValue;

export fn bootstrap_const_eval_name( context: *BootstrapSemanticContext, unit_index: usize, node: BootstrapSyntaxNode ) -> BootstrapConstValue;

export fn bootstrap_semantic_const_integer_fits( kind: BootstrapTypeKind, value: u64 ) -> bool;

export fn bootstrap_semantic_const_value_conforms( context: *BootstrapSemanticContext, unit_index: usize, span: BootstrapSourceSpan, type_id: usize, value: BootstrapConstValue ) -> bool;

export fn bootstrap_semantic_collect_constant_declarations( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_resolve_constants( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_prescan_array_lengths( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_finalize_enum_constants( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_declaration_alignment( context: *BootstrapSemanticContext, unit_index: usize, declaration_node: usize ) -> BootstrapSemanticAlignment;

export fn bootstrap_semantic_resolve_alignment_attributes( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_resolve_bitfield_attributes( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_validate_bitfields( context: *BootstrapSemanticContext ) -> bool;

export fn bootstrap_semantic_check_assert( context: *BootstrapSemanticContext, unit_index: usize, node_index: usize ) -> bool;

export fn bootstrap_semantic_check_module_asserts( context: *BootstrapSemanticContext ) -> bool;
