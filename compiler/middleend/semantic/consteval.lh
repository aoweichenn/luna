export module luna.bootstrap.middleend.semantic.consteval;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;
import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.parser as parser;
import luna.bootstrap.middleend.type as type_info;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.types as types;

export struct Value {
    is_constant: bool;
    is_boolean: bool;
    value: u64;
    error: bool;
}

export struct Alignment {
    alignment: usize;
    valid: bool;
}

export fn expression( context: *context::Context, unit_index: usize, node_index: usize ) -> Value;

export fn eval_name( context: *context::Context, unit_index: usize, node: parser::SyntaxNode ) -> Value;

export fn const_integer_fits( kind: type_info::Kind, value: u64 ) -> bool;

export fn const_value_conforms(
    context: *context::Context, unit_index: usize, span: lexer::SourceSpan, type_id: usize, value: Value) -> bool;

export fn collect_constant_declarations( context: *context::Context ) -> bool;

export fn resolve_constants( context: *context::Context ) -> bool;

export fn prescan_array_lengths( context: *context::Context ) -> bool;

export fn finalize_enum_constants( context: *context::Context ) -> bool;

export fn declaration_alignment( context: *context::Context, unit_index: usize, declaration_node: usize ) -> Alignment;

export fn resolve_alignment_attributes( context: *context::Context ) -> bool;

export fn resolve_bitfield_attributes( context: *context::Context ) -> bool;

export fn validate_bitfields( context: *context::Context ) -> bool;

export fn check_assert( context: *context::Context, unit_index: usize, node_index: usize ) -> bool;

export fn check_module_asserts( context: *context::Context ) -> bool;
