export module luna.bootstrap.middleend.semantic.attributes;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.middleend.type;
import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.semantic.context;

export enum BootstrapSemanticAttributeMount: usize {
    none = 0,
    function = 1,
    record = 2,
    enumeration = 4,
    field = 8,
    variable = 16,
    alias = 32,
}

export enum BootstrapSemanticAttribute: usize {
    inline_hint,
    no_return,
}

export fn bootstrap_semantic_count_attribute_children( context: *BootstrapSemanticContext, unit_index: usize, declaration: BootstrapSyntaxNode ) -> usize;

export fn bootstrap_semantic_declaration_has_attribute( context: *BootstrapSemanticContext, unit_index: usize, declaration: BootstrapSyntaxNode, attribute: BootstrapSemanticAttribute ) -> bool;

export fn bootstrap_semantic_validate_attributes( context: *BootstrapSemanticContext ) -> bool;
