export module luna.bootstrap.middleend.semantic.attributes;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;
import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.parser as parser;
import luna.bootstrap.middleend.type as type_info;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.context as context;

export enum AttributeMount: usize {
    none = 0,
    function = 1,
    record = 2,
    enumeration = 4,
    field = 8,
    variable = 16,
    alias = 32,
    structure = 64,
}

export enum Attribute: usize {
    inline_hint,
    no_return,
    align,
    packed,
    bits,
    export_name,
}

export enum AttributeArgumentPolicy: usize {
    none,
    one_constant_integer,
    named_bitfields,
    one_string_literal,
}

export fn count_attribute_children(
    context: *context::Context, unit_index: usize, declaration: parser::SyntaxNode) -> usize;

export fn find_attribute( context: *context::Context, unit_index: usize, name_token: usize ) -> usize;

export fn declaration_has_attribute(
    context: *context::Context, unit_index: usize, declaration: parser::SyntaxNode, attribute: Attribute) -> bool;

export fn declaration_attribute_argument(
    context: *context::Context, unit_index: usize, declaration: parser::SyntaxNode, attribute: Attribute) -> usize;

export fn attribute_string_is_identifier( context: *context::Context, unit_index: usize, token_index: usize ) -> bool;

export fn validate_attributes( context: *context::Context ) -> bool;
