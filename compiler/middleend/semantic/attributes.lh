export module luna.bootstrap.middleend.semantic.attributes;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;
import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.parser as parser;
import luna.bootstrap.middleend.type as type_info;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.context;

export enum BootstrapSemanticAttributeMount: usize {
    none = 0,
    function = 1,
    record = 2,
    enumeration = 4,
    field = 8,
    variable = 16,
    alias = 32,
    structure = 64,
}

export enum BootstrapSemanticAttribute: usize {
    inline_hint,
    no_return,
    align,
    packed,
    bits,
    export_name,
}

export enum BootstrapSemanticAttributeArgumentPolicy: usize {
    none,
    one_constant_integer,
    named_bitfields,
    one_string_literal,
}

export fn bootstrap_semantic_count_attribute_children( context: *BootstrapSemanticContext, unit_index: usize, declaration: parser::SyntaxNode ) -> usize;

export fn bootstrap_semantic_find_attribute( context: *BootstrapSemanticContext, unit_index: usize, name_token: usize ) -> usize;

export fn bootstrap_semantic_declaration_has_attribute( context: *BootstrapSemanticContext, unit_index: usize, declaration: parser::SyntaxNode, attribute: BootstrapSemanticAttribute ) -> bool;

export fn bootstrap_semantic_declaration_attribute_argument( context: *BootstrapSemanticContext, unit_index: usize, declaration: parser::SyntaxNode, attribute: BootstrapSemanticAttribute ) -> usize;

export fn bootstrap_semantic_attribute_string_is_identifier( context: *BootstrapSemanticContext, unit_index: usize, token_index: usize ) -> bool;

export fn bootstrap_semantic_validate_attributes( context: *BootstrapSemanticContext ) -> bool;
