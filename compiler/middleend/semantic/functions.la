module luna.bootstrap.middleend.semantic.functions;


fn bootstrap_semantic_append_function(
    context: *BootstrapSemanticContext,
    function: BootstrapSemanticFunction
) -> usize {
    let result: usize = context->function_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->functions,
            (&function) as
                *const BootstrapSemanticFunction as *const u8,
            sizeof(BootstrapSemanticFunction)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->function_count += 1;
    return result;
}

fn bootstrap_semantic_append_parameter(
    context: *BootstrapSemanticContext,
    parameter: BootstrapSemanticParameter
) -> usize {
    let result: usize = context->parameter_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->parameters,
            (&parameter) as
                *const BootstrapSemanticParameter as *const u8,
            sizeof(BootstrapSemanticParameter)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->parameter_count += 1;
    return result;
}

fn bootstrap_semantic_function_parts(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration: parser::SyntaxNode,
    parameter_count: *usize,
    return_node: *usize,
    body_node: *usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (parameter_count == null ||
        return_node == null || body_node == null) {
        return false;
    }
    *parameter_count = 0;
    *return_node = none;
    *body_node = none;
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        if (node.kind == parser::SyntaxKind.parameter &&
            *return_node == none && *body_node == none) {
            *parameter_count += 1;
        } else if ((node.kind ==
                    parser::SyntaxKind.type_builtin ||
                node.kind == parser::SyntaxKind.type_named ||
                node.kind == parser::SyntaxKind.type_pointer ||
                node.kind == parser::SyntaxKind.type_array ||
                node.kind ==
                    parser::SyntaxKind.type_function) &&
            *return_node == none && *body_node == none) {
            *return_node = child;
        } else if (node.kind ==
                parser::SyntaxKind.block_statement &&
            *body_node == none) {
            *body_node = child;
        } else if ((node.kind ==
                    parser::SyntaxKind.string_expression ||
                node.kind == parser::SyntaxKind.invalid) &&
            *body_node == none &&
            (declaration.flags &
                (parser::SyntaxFlag.asm_function as usize)) != 0) {
            // An asm fn body is one string_expression (adjacent literals
            // concatenate in the parser); a non-string body was carried as
            // an invalid node for the semantic diagnostic.
            *body_node = child;
        } else if (node.kind != parser::SyntaxKind.attribute) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        child = node.next_sibling;
    }
    return true;
}

fn bootstrap_semantic_parameter_name_exists(
    context: *BootstrapSemanticContext,
    function_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var index: usize = 0;
    while (index < context->parameter_count) {
        if (parameters[index].function_id == function_id &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                parameters[index].unit_index,
                parameters[index].name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_collect_function_parameters(
    context: *BootstrapSemanticContext,
    function_id: usize,
    unit_index: usize,
    declaration: parser::SyntaxNode,
    expected_parameter_count: usize
) -> bool {
    var functions: *BootstrapSemanticFunction =
        context->functions.data as
            *BootstrapSemanticFunction;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < expected_parameter_count) {
        let parameter_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        if (parameter_node.kind !=
                parser::SyntaxKind.parameter ||
            parameter_node.child_count != 1) {
            context->error = runtime::Error.invalid_argument;
            return false;
        }
        let duplicate: usize =
            bootstrap_semantic_parameter_name_exists(
                context,
                function_id,
                unit_index,
                parameter_node.token_index
            );
        if (duplicate != bootstrap_semantic_no_id()) {
            let parameters: *const BootstrapSemanticParameter =
                context->parameters.data as
                    *const BootstrapSemanticParameter;
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .duplicate_parameter,
                unit_index,
                bootstrap_semantic_token(
                    context,
                    unit_index,
                    parameter_node.token_index
                ).span,
                parameters[duplicate].unit_index,
                bootstrap_semantic_token(
                    context,
                    parameters[duplicate].unit_index,
                    parameters[duplicate].name_token
                ).span,
                duplicate
            );
        }
        let type_id: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                unit_index,
                parameter_node.first_child
            );
        if (type_id != bootstrap_semantic_no_id()) {
            let type_record: type_info::RecordResult =
                type_info::table_get(
                    context->types,
                    type_id
                );
            if (type_record.error != runtime::Error.none) {
                context->error = type_record.error;
                return false;
            }
            if (type_record.record.kind ==
                    type_info::Kind.type_void ||
                (type_record.record.flags &
                    ((type_info::Flag.header as usize) |
                        (type_info::Flag.flexible as
                            usize))) != 0) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .incomplete_type,
                    unit_index,
                    parameter_node.span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    type_id
                );
            }
            if (functions[function_id].parameter_count == 0) {
                functions[function_id].first_parameter =
                    context->parameter_count;
            }
            bootstrap_semantic_append_parameter(
                context,
                {
                    function_id = function_id,
                    type_id = type_id,
                    unit_index = unit_index,
                    declaration_node = child,
                    name_token = parameter_node.token_index,
                }
            );
            functions = context->functions.data as
                *BootstrapSemanticFunction;
            functions[function_id].parameter_count += 1;
        }
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_external_name_is_reserved(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize
) -> bool {
    let token: lexer::Token = bootstrap_semantic_token(
        context,
        unit_index,
        token_index
    );
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    return bootstrap_semantic_token_equals_bytes(
            context,
            unit_index,
            token_index,
            "_start",
            6
        ) ||
        (unit != null && token.span.length >= 2 &&
            unit->source.data[token.span.offset] == 95 &&
            unit->source.data[token.span.offset + 1] == 76);
}

fn bootstrap_semantic_validate_external_signature(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let symbol: BootstrapSemanticSymbol =
        symbols[function.symbol_id];
    if (bootstrap_semantic_external_name_is_reserved(
            context,
            symbol.declaration_unit,
            symbol.name_token
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_external,
            symbol.declaration_unit,
            bootstrap_semantic_token(
                context,
                symbol.declaration_unit,
                symbol.name_token
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            function_id
        );
    }
    if (function.return_type != bootstrap_semantic_no_id() &&
        bootstrap_semantic_type_record(
            context,
            function.return_type
        ).kind == type_info::Kind.array) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_external,
            symbol.declaration_unit,
            bootstrap_semantic_node(
                context,
                symbol.declaration_unit,
                symbol.declaration_node
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            function.return_type
        );
    }
    var index: usize = 0;
    while (index < function.parameter_count) {
        let parameter: BootstrapSemanticParameter =
            parameters[function.first_parameter + index];
        let record: type_info::Record =
            bootstrap_semantic_type_record(
                context,
                parameter.type_id
            );
        if (record.kind == type_info::Kind.array) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .invalid_external,
                parameter.unit_index,
                bootstrap_semantic_node(
                    context,
                    parameter.unit_index,
                    parameter.declaration_node
                ).span,
                symbol.declaration_unit,
                bootstrap_semantic_node(
                    context,
                    symbol.declaration_unit,
                    symbol.declaration_node
                ).span,
                parameter.type_id
            );
        }
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_find_module_function(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var index: usize = 0;
    while (index < context->function_count) {
        let symbol: BootstrapSemanticSymbol =
            symbols[functions[index].symbol_id];
        if (symbol.module_id == module_id &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

// An `asm fn` is an implementation-unit definition whose entire body is
// one or more adjacent string literals (m1.4 concatenation included) and
// nothing else, carried as one string_expression of plain-width literals.
// Interface-unit, extern or bodyless asm declarations and any other body
// content are invalid_asm_function.
fn bootstrap_semantic_validate_asm_function(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration: parser::SyntaxNode,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if ((declaration.flags &
            (parser::SyntaxFlag.asm_function as usize)) == 0) {
        return true;
    }
    var valid: bool = !interface_unit &&
        (declaration.flags &
            ((parser::SyntaxFlag.external as usize) |
                (parser::SyntaxFlag.bodyless as usize))) == 0;
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (valid && !bootstrap_semantic_function_parts(
            context, unit_index, declaration, &parameter_count, &return_node, &body_node)) {
        return false;
    }
    if (valid && body_node != none) {
        let body: parser::SyntaxNode = bootstrap_semantic_node(context, unit_index, body_node);
        if (body.kind != parser::SyntaxKind.string_expression ||
            bootstrap_semantic_token(context, unit_index, body.token_index).kind != lexer::TokenKind.string) {
            valid = false;
        }
        var part: usize = body.first_child;
        while (valid && part != none) {
            let part_node: parser::SyntaxNode = bootstrap_semantic_node(context, unit_index, part);
            if (part_node.kind != parser::SyntaxKind.string_expression ||
                bootstrap_semantic_token(context, unit_index, part_node.token_index).kind !=
                    lexer::TokenKind.string) {
                valid = false;
                break;
            }
            part = part_node.next_sibling;
        }
    } else if (valid) {
        valid = false;
    }
    if (!valid) {
        bootstrap_semantic_add_diagnostic(
            context, BootstrapSemanticDiagnosticKind.invalid_asm_function, unit_index, declaration.span, none,
            bootstrap_semantic_empty_span(), 0);
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_add_function_declaration(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    declaration_id: usize,
    declaration: parser::SyntaxNode,
    interface_unit: bool
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!bootstrap_semantic_function_parts(
            context,
            unit_index,
            declaration,
            &parameter_count,
            &return_node,
            &body_node
        )) {
        return none;
    }
    let external: bool =
        (declaration.flags &
            (parser::SyntaxFlag.external as usize)) != 0;
    let exported: bool =
        (declaration.flags &
            (parser::SyntaxFlag.exported as usize)) != 0;
    let bodyless: bool =
        (declaration.flags &
            (parser::SyntaxFlag.bodyless as usize)) != 0;
    // A `...` tail requires at least one named parameter; it is legal both
    // on extern declarations and on Luna-defined variadic functions (their
    // prologue builds the System V register save area for va_start/va_arg).
    let variadic: bool =
        (declaration.flags &
            (parser::SyntaxFlag.variadic as usize)) != 0;
    if ((!interface_unit && exported) ||
        (external && !bodyless) ||
        (interface_unit && !bodyless)) {
        bootstrap_semantic_add_diagnostic(
            context,
            (!interface_unit && exported) ?
                BootstrapSemanticDiagnosticKind.invalid_export :
                BootstrapSemanticDiagnosticKind.invalid_external,
            unit_index,
            declaration.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
    }
    if (variadic && parameter_count == 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_variadic,
            unit_index,
            declaration.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
    }
    var flags: usize =
        BootstrapSemanticSymbolFlag.none as usize;
    if (exported) {
        flags |= BootstrapSemanticSymbolFlag.exported as usize;
    }
    if (external) {
        flags |= BootstrapSemanticSymbolFlag.external as usize;
    }
    if (variadic && parameter_count != 0) {
        flags |= BootstrapSemanticSymbolFlag.variadic as usize;
    }
    if ((declaration.flags &
            (parser::SyntaxFlag.asm_function as usize)) != 0) {
        flags |= BootstrapSemanticSymbolFlag.asm_function as usize;
    }
    if (interface_unit) {
        flags |= BootstrapSemanticSymbolFlag
            .interface_declaration as usize;
    }
    if (bootstrap_semantic_declaration_has_attribute(
            context,
            unit_index,
            declaration,
            BootstrapSemanticAttribute.no_return
        )) {
        flags |= BootstrapSemanticSymbolFlag.no_return as usize;
    }
    if (bootstrap_semantic_declaration_has_attribute(
            context,
            unit_index,
            declaration,
            BootstrapSemanticAttribute.inline_hint
        )) {
        flags |= BootstrapSemanticSymbolFlag
            .inline_hint as usize;
    }
    let symbol_id: usize = bootstrap_semantic_append_symbol(
        context,
        {
            kind = BootstrapSemanticSymbolKind.function,
            module_id = module_id,
            declaration_unit = unit_index,
            declaration_node = declaration_id,
            name_token = declaration.token_index,
            type_id = none,
            function_id = context->function_count,
            integer_value = 0,
            flags = flags,
        }
    );
    if (symbol_id == none) {
        return none;
    }
    let function_id: usize = bootstrap_semantic_append_function(
        context,
        {
            symbol_id = symbol_id,
            interface_unit = interface_unit ?
                unit_index : none,
            interface_node = interface_unit ?
                declaration_id : none,
            implementation_unit = interface_unit ?
                none : unit_index,
            implementation_node = interface_unit ?
                none : declaration_id,
            return_type = type_info::BuiltinType.type_void as usize,
            first_parameter = none,
            parameter_count = 0,
            ir_function = none,
            flags = flags,
        }
    );
    if (function_id == none) {
        return none;
    }
    if (return_node != none) {
        let return_type: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                unit_index,
                return_node
            );
        if (return_type != none &&
            (bootstrap_semantic_type_record(
                    context,
                    return_type
                ).flags &
                ((type_info::Flag.header as usize) |
                    (type_info::Flag.flexible as usize))) != 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.incomplete_type,
                unit_index,
                bootstrap_semantic_node(
                    context,
                    unit_index,
                    return_node
                ).span,
                none,
                bootstrap_semantic_empty_span(),
                return_type
            );
        }
        let functions: *BootstrapSemanticFunction =
            context->functions.data as
                *BootstrapSemanticFunction;
        functions[function_id].return_type = return_type;
    }
    bootstrap_semantic_collect_function_parameters(
        context,
        function_id,
        unit_index,
        declaration,
        parameter_count
    );
    if (external) {
        bootstrap_semantic_validate_external_signature(
            context,
            function_id
        );
    }
    return function_id;
}

fn bootstrap_semantic_function_signature_matches(
    context: *BootstrapSemanticContext,
    function_id: usize,
    unit_index: usize,
    declaration: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!bootstrap_semantic_function_parts(
            context,
            unit_index,
            declaration,
            &parameter_count,
            &return_node,
            &body_node
        )) {
        return false;
    }
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    if (parameter_count != function.parameter_count) {
        return false;
    }
    let variadic: bool =
        (declaration.flags &
            (parser::SyntaxFlag.variadic as usize)) != 0;
    if (variadic != ((function.flags &
            (BootstrapSemanticSymbolFlag.variadic as usize)) != 0)) {
        return false;
    }
    let actual_return: usize = return_node == none ?
        type_info::BuiltinType.type_void as usize :
        bootstrap_semantic_resolve_type_node(
            context,
            unit_index,
            return_node
        );
    if (actual_return != function.return_type) {
        return false;
    }
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < parameter_count) {
        let parameter_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        let actual_type: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                unit_index,
                parameter_node.first_child
            );
        if (actual_type !=
            parameters[function.first_parameter + index].type_id) {
            return false;
        }
        child = parameter_node.next_sibling;
        index += 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// const fn collection and body validation
//
// A `const fn` exists only for the constant evaluator: it registers a
// const_function symbol (never a runtime function, so a runtime call
// resolves to unknown_name) plus a BootstrapSemanticConstFunction record
// whose parameters reuse the shared parameter buffer with function_id set
// to no-id so regular duplicate detection never matches them. Bodies are
// restricted to the statement subset the interpreter walks; anything else
// is invalid_const_function.

fn bootstrap_semantic_append_const_function(
    context: *BootstrapSemanticContext,
    record: BootstrapSemanticConstFunction
) -> usize {
    let result: usize = context->const_function_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->const_functions,
            (&record) as
                *const BootstrapSemanticConstFunction as *const u8,
            sizeof(BootstrapSemanticConstFunction)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->const_function_count += 1;
    return result;
}

fn bootstrap_semantic_report_invalid_const_function(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    span: lexer::SourceSpan
) -> bool {
    return bootstrap_semantic_add_diagnostic(
        context,
        BootstrapSemanticDiagnosticKind.invalid_const_function,
        unit_index,
        span,
        bootstrap_semantic_no_id(),
        bootstrap_semantic_empty_span(),
        0
    );
}

fn bootstrap_semantic_const_scalar_type(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> bool {
    var record: type_info::Record =
        bootstrap_semantic_type_record(context, type_id);
    if (record.kind == type_info::Kind.alias &&
        bootstrap_semantic_require_complete_type(context, type_id)) {
        record = bootstrap_semantic_type_record(
            context, record.element_type
        );
    }
    return type_info::is_integer(record.kind) ||
        record.kind == type_info::Kind.boolean;
}

fn bootstrap_semantic_validate_const_call(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count == 0) {
        return false;
    }
    let callee: parser::SyntaxNode = bootstrap_semantic_node(
        context, unit_index, node.first_child
    );
    if (callee.kind != parser::SyntaxKind.name_expression) {
        return false;
    }
    let symbol_id: usize =
        bootstrap_semantic_lookup_qualified_symbol(
            context,
            unit_index,
            callee,
            BootstrapSemanticSymbolKind.const_function,
            false
        );
    if (symbol_id == none) {
        return false;
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    let records: *const BootstrapSemanticConstFunction =
        context->const_functions.data as
            *const BootstrapSemanticConstFunction;
    if (node.child_count - 1 !=
        records[symbols[symbol_id].function_id].parameter_count) {
        return false;
    }
    var valid: bool = true;
    var argument: usize = callee.next_sibling;
    while (argument != none && valid) {
        valid = bootstrap_semantic_validate_const_expression(
            context, unit_index, argument
        );
        argument = bootstrap_semantic_node(
            context, unit_index, argument
        ).next_sibling;
    }
    return valid;
}

fn bootstrap_semantic_validate_const_expression(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let node: parser::SyntaxNode = bootstrap_semantic_node(
        context, unit_index, node_index
    );
    var valid: bool = false;
    if (node.kind == parser::SyntaxKind.integer_expression ||
        node.kind == parser::SyntaxKind.character_expression ||
        node.kind == parser::SyntaxKind.boolean_expression ||
        node.kind == parser::SyntaxKind.name_expression) {
        valid = true;
    } else if (node.kind ==
        parser::SyntaxKind.parenthesized_expression) {
        valid = node.child_count == 1 &&
            bootstrap_semantic_validate_const_expression(
                context, unit_index, node.first_child
            );
    } else if (node.kind == parser::SyntaxKind.member_expression) {
        valid = node.child_count == 2 &&
            bootstrap_semantic_node(
                context, unit_index, node.first_child
            ).kind == parser::SyntaxKind.name_expression &&
            bootstrap_semantic_node(
                context,
                unit_index,
                bootstrap_semantic_node(
                    context, unit_index, node.first_child
                ).next_sibling
            ).kind == parser::SyntaxKind.name_expression;
    } else if (node.kind == parser::SyntaxKind.unary_expression) {
        let operation: lexer::TokenKind =
            bootstrap_semantic_token(
                context, unit_index, node.token_index
            ).kind;
        valid = node.child_count == 1 &&
            (operation == lexer::TokenKind.minus ||
                operation == lexer::TokenKind.tilde ||
                operation == lexer::TokenKind.bang) &&
            bootstrap_semantic_validate_const_expression(
                context, unit_index, node.first_child
            );
    } else if (node.kind == parser::SyntaxKind.binary_expression ||
        node.kind == parser::SyntaxKind.conditional_expression) {
        var operands: bool = true;
        var operand: usize = node.first_child;
        while (operand != none && operands) {
            operands =
                bootstrap_semantic_validate_const_expression(
                    context, unit_index, operand
                );
            operand = bootstrap_semantic_node(
                context, unit_index, operand
            ).next_sibling;
        }
        valid = operands &&
            node.child_count ==
                (node.kind == parser::SyntaxKind.binary_expression ?
                    2 : 3);
    } else if (node.kind == parser::SyntaxKind.sizeof_expression ||
        node.kind == parser::SyntaxKind.alignof_expression) {
        valid = node.child_count == 1;
    } else if (node.kind ==
        parser::SyntaxKind.offsetof_expression) {
        valid = node.child_count >= 1;
    } else if (node.kind == parser::SyntaxKind.cast_expression) {
        if (node.child_count == 2 &&
            bootstrap_semantic_validate_const_expression(
                context, unit_index, node.first_child
            )) {
            let target: usize =
                bootstrap_semantic_resolve_type_node(
                    context,
                    unit_index,
                    bootstrap_semantic_node(
                        context, unit_index, node.first_child
                    ).next_sibling
                );
            valid = target != none &&
                bootstrap_semantic_const_scalar_type(
                    context, target
                );
        }
    } else if (node.kind == parser::SyntaxKind.call_expression) {
        valid = bootstrap_semantic_validate_const_call(
            context, unit_index, node
        );
    }
    if (!valid) {
        bootstrap_semantic_report_invalid_const_function(
            context, unit_index, node.span
        );
    }
    return valid;
}

fn bootstrap_semantic_validate_const_statement(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let node: parser::SyntaxNode = bootstrap_semantic_node(
        context, unit_index, node_index
    );
    var valid: bool = false;
    if (node.kind == parser::SyntaxKind.block_statement) {
        valid = true;
        var child: usize = node.first_child;
        while (child != none && valid) {
            valid = bootstrap_semantic_validate_const_statement(
                context, unit_index, child
            );
            child = bootstrap_semantic_node(
                context, unit_index, child
            ).next_sibling;
        }
        return valid;
    }
    if (node.kind == parser::SyntaxKind.variable_declaration ||
        node.kind == parser::SyntaxKind.const_declaration) {
        if (node.child_count == 2 &&
            (node.flags &
                ((parser::SyntaxFlag.inferred_type as usize) |
                    (parser::SyntaxFlag.volatile_ as usize))) == 0) {
            let type_id: usize =
                bootstrap_semantic_resolve_type_node(
                    context, unit_index, node.first_child
                );
            valid = type_id != none &&
                bootstrap_semantic_const_scalar_type(
                    context, type_id
                ) &&
                bootstrap_semantic_validate_const_expression(
                    context,
                    unit_index,
                    bootstrap_semantic_node(
                        context, unit_index, node.first_child
                    ).next_sibling
                );
        }
    } else if (node.kind ==
        parser::SyntaxKind.assignment_statement) {
        valid = node.child_count == 2 &&
            bootstrap_semantic_token(
                context, unit_index, node.token_index
            ).kind == lexer::TokenKind.equal &&
            bootstrap_semantic_node(
                context, unit_index, node.first_child
            ).kind == parser::SyntaxKind.name_expression &&
            bootstrap_semantic_validate_const_expression(
                context,
                unit_index,
                bootstrap_semantic_node(
                    context, unit_index, node.first_child
                ).next_sibling
            );
    } else if (node.kind ==
        parser::SyntaxKind.expression_statement) {
        valid = node.child_count == 1 &&
            bootstrap_semantic_validate_const_expression(
                context, unit_index, node.first_child
            );
    } else if (node.kind == parser::SyntaxKind.if_statement) {
        if (node.child_count >= 2 && node.child_count <= 3 &&
            bootstrap_semantic_validate_const_expression(
                context, unit_index, node.first_child
            )) {
            let then_id: usize = bootstrap_semantic_node(
                context, unit_index, node.first_child
            ).next_sibling;
            valid = bootstrap_semantic_validate_const_statement(
                context, unit_index, then_id
            );
            if (valid && node.child_count == 3) {
                valid = bootstrap_semantic_validate_const_statement(
                    context,
                    unit_index,
                    bootstrap_semantic_node(
                        context, unit_index, then_id
                    ).next_sibling
                );
            }
        }
    } else if (node.kind == parser::SyntaxKind.return_statement) {
        valid = node.child_count == 1 &&
            bootstrap_semantic_validate_const_expression(
                context, unit_index, node.first_child
            );
    }
    if (!valid) {
        bootstrap_semantic_report_invalid_const_function(
            context, unit_index, node.span
        );
    }
    return valid;
}

fn bootstrap_semantic_validate_const_function(
    context: *BootstrapSemanticContext,
    const_function_id: usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let records: *const BootstrapSemanticConstFunction =
        context->const_functions.data as
            *const BootstrapSemanticConstFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    let symbol: BootstrapSemanticSymbol =
        symbols[records[const_function_id].symbol_id];
    var body_id: usize = none;
    var child: usize = bootstrap_semantic_node(
        context, symbol.declaration_unit, symbol.declaration_node
    ).first_child;
    while (child != none) {
        let part: parser::SyntaxNode = bootstrap_semantic_node(
            context, symbol.declaration_unit, child
        );
        if (part.kind == parser::SyntaxKind.block_statement) {
            body_id = child;
        }
        child = part.next_sibling;
    }
    if (body_id == none) {
        bootstrap_semantic_report_invalid_const_function(
            context,
            symbol.declaration_unit,
            bootstrap_semantic_node(
                context,
                symbol.declaration_unit,
                symbol.declaration_node
            ).span
        );
        return false;
    }
    var valid: bool = true;
    var statement: usize = bootstrap_semantic_node(
        context, symbol.declaration_unit, body_id
    ).first_child;
    while (statement != none && valid &&
        context->error == runtime::Error.none) {
        valid = bootstrap_semantic_validate_const_statement(
            context, symbol.declaration_unit, statement
        );
        statement = bootstrap_semantic_node(
            context, symbol.declaration_unit, statement
        ).next_sibling;
    }
    return valid;
}

fn bootstrap_semantic_collect_const_function(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    declaration_id: usize,
    declaration: parser::SyntaxNode,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (interface_unit) {
        // Interface units carry no bodies, and a const fn without a body
        // is useless to the evaluator.
        bootstrap_semantic_report_invalid_const_function(
            context, unit_index, declaration.span
        );
        return context->error == runtime::Error.none;
    }
    if ((declaration.flags &
            (parser::SyntaxFlag.exported as usize)) != 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_export,
            unit_index,
            declaration.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
    }
    let duplicate: usize =
        bootstrap_semantic_find_any_local_symbol(
            context,
            module_id,
            unit_index,
            declaration.token_index
        );
    if (duplicate != none) {
        let symbols: *const BootstrapSemanticSymbol =
            context->symbols.data as *const BootstrapSemanticSymbol;
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.duplicate_name,
            unit_index,
            bootstrap_semantic_token(
                context, unit_index, declaration.token_index
            ).span,
            symbols[duplicate].declaration_unit,
            bootstrap_semantic_token(
                context,
                symbols[duplicate].declaration_unit,
                symbols[duplicate].name_token
            ).span,
            duplicate
        );
        return context->error == runtime::Error.none;
    }
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!bootstrap_semantic_function_parts(
            context,
            unit_index,
            declaration,
            &parameter_count,
            &return_node,
            &body_node
        )) {
        return false;
    }
    if ((declaration.flags &
            (parser::SyntaxFlag.variadic as usize)) != 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_variadic,
            unit_index,
            declaration.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            0
        );
        return context->error == runtime::Error.none;
    }
    if (body_node == none || return_node == none) {
        bootstrap_semantic_report_invalid_const_function(
            context, unit_index, declaration.span
        );
        return context->error == runtime::Error.none;
    }
    let return_type: usize =
        bootstrap_semantic_resolve_type_node(
            context, unit_index, return_node
        );
    if (return_type == none) {
        return context->error == runtime::Error.none;
    }
    if (!bootstrap_semantic_const_scalar_type(context, return_type)) {
        bootstrap_semantic_report_invalid_const_function(
            context,
            unit_index,
            bootstrap_semantic_node(
                context, unit_index, return_node
            ).span
        );
    }
    let symbol_id: usize = bootstrap_semantic_append_symbol(
        context,
        {
            kind = BootstrapSemanticSymbolKind.const_function,
            module_id = module_id,
            declaration_unit = unit_index,
            declaration_node = declaration_id,
            name_token = declaration.token_index,
            type_id = return_type,
            function_id = context->const_function_count,
            integer_value = 0,
            flags = BootstrapSemanticSymbolFlag.none as usize,
        }
    );
    if (symbol_id == none) {
        return false;
    }
    let const_id: usize =
        bootstrap_semantic_append_const_function(
            context,
            {
                symbol_id = symbol_id,
                return_type = return_type,
                first_parameter = none,
                parameter_count = 0,
            }
        );
    if (const_id == none) {
        return false;
    }
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < parameter_count) {
        let parameter_node: parser::SyntaxNode =
            bootstrap_semantic_node(context, unit_index, child);
        let type_id: usize =
            bootstrap_semantic_resolve_type_node(
                context, unit_index, parameter_node.first_child
            );
        if (type_id == none) {
            return context->error == runtime::Error.none;
        }
        if (!bootstrap_semantic_const_scalar_type(
                context, type_id
            )) {
            bootstrap_semantic_report_invalid_const_function(
                context, unit_index, parameter_node.span
            );
        }
        let records: *const BootstrapSemanticConstFunction =
            context->const_functions.data as
                *const BootstrapSemanticConstFunction;
        let parameters: *const BootstrapSemanticParameter =
            context->parameters.data as
                *const BootstrapSemanticParameter;
        let base: usize = records[const_id].first_parameter;
        let collected: usize =
            records[const_id].parameter_count;
        var previous: usize = 0;
        while (previous < collected) {
            if (bootstrap_semantic_tokens_equal(
                    context,
                    unit_index,
                    parameter_node.token_index,
                    parameters[base + previous].unit_index,
                    parameters[base + previous].name_token
                )) {
                bootstrap_semantic_report_invalid_const_function(
                    context, unit_index, parameter_node.span
                );
            }
            previous += 1;
        }
        if (bootstrap_semantic_append_parameter(
                context,
                {
                    function_id = none,
                    type_id = type_id,
                    unit_index = unit_index,
                    declaration_node = child,
                    name_token = parameter_node.token_index,
                }
            ) == none) {
            return false;
        }
        let writable: *BootstrapSemanticConstFunction =
            context->const_functions.data as
                *BootstrapSemanticConstFunction;
        if (writable[const_id].parameter_count == 0) {
            writable[const_id].first_parameter =
                context->parameter_count - 1;
        }
        writable[const_id].parameter_count += 1;
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_collect_const_functions_in_unit(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize =
        bootstrap_semantic_first_declaration(context, unit_index);
    while (declaration_id != none &&
        context->error == runtime::Error.none) {
        let declaration: parser::SyntaxNode =
            bootstrap_semantic_node(
                context, unit_index, declaration_id
            );
        if (declaration.kind ==
                parser::SyntaxKind.function_declaration &&
            (declaration.flags &
                (parser::SyntaxFlag.const_function as usize)) != 0 &&
            !bootstrap_semantic_collect_const_function(
                context,
                module_id,
                unit_index,
                declaration_id,
                declaration,
                interface_unit
            )) {
            return false;
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_collect_const_functions(
    context: *BootstrapSemanticContext
) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count &&
        context->error == runtime::Error.none) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as *const BootstrapSemanticModule;
        if (!bootstrap_semantic_collect_const_functions_in_unit(
                context,
                module_id,
                modules[module_id].interface_unit,
                true
            ) ||
            !bootstrap_semantic_collect_const_functions_in_unit(
                context,
                module_id,
                modules[module_id].implementation_unit,
                false
            )) {
            return false;
        }
        module_id += 1;
    }
    var index: usize = 0;
    while (index < context->const_function_count &&
        context->error == runtime::Error.none) {
        bootstrap_semantic_validate_const_function(context, index);
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_collect_functions_in_unit(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize =
        bootstrap_semantic_first_declaration(
            context,
            unit_index
        );
    while (declaration_id != none &&
        context->error == runtime::Error.none) {
        let declaration: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                declaration_id
            );
        if (declaration.kind ==
                parser::SyntaxKind.function_declaration &&
            (declaration.flags &
                (parser::SyntaxFlag.const_function as usize)) == 0) {
            bootstrap_semantic_validate_asm_function(
                context,
                unit_index,
                declaration,
                interface_unit
            );
            let duplicate_name: usize =
                bootstrap_semantic_find_any_local_symbol(
                    context,
                    module_id,
                    unit_index,
                    declaration.token_index
                );
            let existing_function: usize =
                bootstrap_semantic_find_module_function(
                    context,
                    module_id,
                    unit_index,
                    declaration.token_index
                );
            if (!interface_unit && existing_function != none) {
                if ((declaration.flags &
                        (parser::SyntaxFlag.exported as usize)) != 0) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind.invalid_export,
                        unit_index,
                        declaration.span,
                        none,
                        bootstrap_semantic_empty_span(),
                        existing_function
                    );
                }
                var functions: *BootstrapSemanticFunction =
                    context->functions.data as
                        *BootstrapSemanticFunction;
                let existing: BootstrapSemanticFunction =
                    functions[existing_function];
                if (existing.implementation_unit != none ||
                    (existing.flags &
                        (BootstrapSemanticSymbolFlag
                            .external as usize)) != 0) {
                    let symbols: *const BootstrapSemanticSymbol =
                        context->symbols.data as
                            *const BootstrapSemanticSymbol;
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .duplicate_function,
                        unit_index,
                        declaration.span,
                        symbols[existing.symbol_id].declaration_unit,
                        bootstrap_semantic_node(
                            context,
                            symbols[existing.symbol_id]
                                .declaration_unit,
                            symbols[existing.symbol_id]
                                .declaration_node
                        ).span,
                        existing_function
                    );
                } else if (!bootstrap_semantic_function_signature_matches(
                        context,
                        existing_function,
                        unit_index,
                        declaration
                    )) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .signature_mismatch,
                        unit_index,
                        declaration.span,
                        existing.interface_unit,
                        bootstrap_semantic_node(
                            context,
                            existing.interface_unit,
                            existing.interface_node
                        ).span,
                        existing_function
                    );
                } else {
                    functions =
                        context->functions.data as
                            *BootstrapSemanticFunction;
                    functions[existing_function]
                        .implementation_unit = unit_index;
                    functions[existing_function]
                        .implementation_node = declaration_id;
                    // The interface declaration was collected without the
                    // asm flag; the implementation carries it.
                    if ((declaration.flags &
                            (parser::SyntaxFlag.asm_function as usize)) != 0) {
                        functions[existing_function].flags |=
                            BootstrapSemanticSymbolFlag.asm_function as usize;
                    }
                }
            } else if (duplicate_name != none) {
                let symbols: *const BootstrapSemanticSymbol =
                    context->symbols.data as
                        *const BootstrapSemanticSymbol;
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.duplicate_name,
                    unit_index,
                    declaration.span,
                    symbols[duplicate_name].declaration_unit,
                    bootstrap_semantic_node(
                        context,
                        symbols[duplicate_name].declaration_unit,
                        symbols[duplicate_name].declaration_node
                    ).span,
                    duplicate_name
                );
            } else {
                bootstrap_semantic_add_function_declaration(
                    context,
                    module_id,
                    unit_index,
                    declaration_id,
                    declaration,
                    interface_unit
                );
            }
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_collect_functions(
    context: *BootstrapSemanticContext
) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count &&
        context->error == runtime::Error.none) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as
                *const BootstrapSemanticModule;
        if (!bootstrap_semantic_collect_functions_in_unit(
                context,
                module_id,
                modules[module_id].interface_unit,
                true
            ) ||
            !bootstrap_semantic_collect_functions_in_unit(
                context,
                module_id,
                modules[module_id].implementation_unit,
                false
            )) {
            return false;
        }
        module_id += 1;
    }
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let root_module: usize =
        bootstrap_semantic_unit_module(context, 0);
    var function_id: usize = 0;
    while (function_id < context->function_count) {
        let function: BootstrapSemanticFunction =
            functions[function_id];
        let symbol: BootstrapSemanticSymbol =
            symbols[function.symbol_id];
        if (function.interface_unit !=
                bootstrap_semantic_no_id() &&
            function.implementation_unit ==
                bootstrap_semantic_no_id() &&
            symbol.module_id == root_module &&
            (function.flags &
                (BootstrapSemanticSymbolFlag.external as usize)) == 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.missing_definition,
                symbol.declaration_unit,
                bootstrap_semantic_node(
                    context,
                    symbol.declaration_unit,
                    symbol.declaration_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                function_id
            );
        }
        if (function.implementation_unit !=
                bootstrap_semantic_no_id() &&
            (function.flags &
                (BootstrapSemanticSymbolFlag.external as usize)) == 0) {
            let implementation: parser::SyntaxNode =
                bootstrap_semantic_node(
                    context,
                    function.implementation_unit,
                    function.implementation_node
                );
            if ((implementation.flags &
                    (parser::SyntaxFlag.bodyless as usize)) != 0) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .missing_definition,
                    function.implementation_unit,
                    implementation.span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    function_id
                );
            }
        }
        function_id += 1;
    }
    // Export names live outside the module-fingerprint scheme, so the usual
    // per-module name uniqueness cannot catch collisions: two functions
    // emitting the same verbatim symbol are a duplicate_function.
    var outer: usize = 0;
    while (outer < context->function_count &&
        context->error == runtime::Error.none) {
        let outer_function: BootstrapSemanticFunction = functions[outer];
        let outer_token: usize =
            bootstrap_semantic_function_export_name_token(
                context, outer_function
            );
        if (outer_token != bootstrap_semantic_no_id()) {
            let outer_span: lexer::SourceSpan = bootstrap_semantic_token(
                context, outer_function.implementation_unit, outer_token
            ).span;
            let outer_content: lexer::SourceSpan = {
                offset = outer_span.offset + 1,
                length = outer_span.length - 2,
                line = outer_span.line,
                column = outer_span.column,
            };
            var inner: usize = outer + 1;
            while (inner < context->function_count &&
                context->error == runtime::Error.none) {
                let inner_function: BootstrapSemanticFunction =
                    functions[inner];
                let inner_token: usize =
                    bootstrap_semantic_function_export_name_token(
                        context, inner_function
                    );
                if (inner_token != bootstrap_semantic_no_id()) {
                    let inner_span: lexer::SourceSpan =
                        bootstrap_semantic_token(
                            context,
                            inner_function.implementation_unit,
                            inner_token
                        ).span;
                    let inner_content: lexer::SourceSpan = {
                        offset = inner_span.offset + 1,
                        length = inner_span.length - 2,
                        line = inner_span.line,
                        column = inner_span.column,
                    };
                    if (bootstrap_semantic_text_equal(
                            context,
                            outer_function.implementation_unit,
                            outer_content,
                            inner_function.implementation_unit,
                            inner_content
                        )) {
                        bootstrap_semantic_add_diagnostic(
                            context,
                            BootstrapSemanticDiagnosticKind
                                .duplicate_function,
                            inner_function.implementation_unit,
                            inner_span,
                            outer_function.implementation_unit,
                            outer_span,
                            outer
                        );
                    }
                }
                inner += 1;
            }
        }
        outer += 1;
    }
    return context->error == runtime::Error.none;
}

// Token of a function's validated @export_name string literal in the
// function's implementation unit, no-id when the function carries no (valid)
// export name. Invalid arguments were already diagnosed by the attribute
// pass; they fall back to the mangled symbol here.
fn bootstrap_semantic_function_export_name_token(
    context: *BootstrapSemanticContext,
    function: BootstrapSemanticFunction
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    if (function.implementation_unit == none ||
        (function.flags &
            (BootstrapSemanticSymbolFlag.external as usize)) != 0) {
        return none;
    }
    let argument: usize =
        bootstrap_semantic_declaration_attribute_argument(
            context,
            function.implementation_unit,
            bootstrap_semantic_node(
                context,
                function.implementation_unit,
                function.implementation_node
            ),
            BootstrapSemanticAttribute.export_name
        );
    if (argument == none) {
        return none;
    }
    let argument_node: parser::SyntaxNode = bootstrap_semantic_node(
        context, function.implementation_unit, argument
    );
    if (argument_node.kind != parser::SyntaxKind.string_expression ||
        argument_node.child_count != 0 ||
        !bootstrap_semantic_attribute_string_is_identifier(
            context,
            function.implementation_unit,
            argument_node.token_index
        )) {
        return none;
    }
    return argument_node.token_index;
}

fn bootstrap_semantic_ir_function_record(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> ir::Function {
    let none: usize = bootstrap_semantic_no_id();
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let symbol: BootstrapSemanticSymbol =
        symbols[function.symbol_id];
    let external: bool =
        (function.flags &
            (BootstrapSemanticSymbolFlag.external as usize)) != 0;
    let exported: bool =
        (function.flags &
            (BootstrapSemanticSymbolFlag.exported as usize)) != 0;
    var has_body: bool = false;
    var asm_body_node: usize = none;
    if (function.implementation_unit != none &&
        !external) {
        let implementation: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                function.implementation_unit,
                function.implementation_node
            );
        has_body =
            (implementation.flags &
                (parser::SyntaxFlag.bodyless as usize)) == 0;
        // An asm fn's body stays a syntax reference (unit + string node);
        // the backend decodes and splices the string literals verbatim.
        if (has_body &&
            (function.flags &
                (BootstrapSemanticSymbolFlag.asm_function as usize)) != 0) {
            var ignored_count: usize = 0;
            var ignored_return: usize = none;
            bootstrap_semantic_function_parts(
                context,
                function.implementation_unit,
                implementation,
                &ignored_count,
                &ignored_return,
                &asm_body_node
            );
        }
    }
    let export_name_token: usize =
        bootstrap_semantic_function_export_name_token(context, function);
    return {
        declaration_unit = symbol.declaration_unit,
        declaration_node = symbol.declaration_node,
        name_token = symbol.name_token,
        linkage = external ?
            ir::Linkage.external_c :
            (exported ?
                ir::Linkage.module_export :
                ir::Linkage.internal),
        return_type = function.return_type,
        first_parameter = none,
        parameter_count = 0,
        first_slot = none,
        slot_count = 0,
        first_block = none,
        block_count = 0,
        first_value = none,
        value_count = 0,
        has_body = has_body,
        variadic = (function.flags &
            (BootstrapSemanticSymbolFlag.variadic as usize)) != 0,
        export_name_unit = export_name_token == none ?
            none : function.implementation_unit,
        export_name_token = export_name_token,
        asm_body_unit = asm_body_node == none ?
            none : function.implementation_unit,
        asm_body_node = asm_body_node,
    };
}

fn bootstrap_semantic_text_is_before(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_span: lexer::SourceSpan,
    right_unit: usize,
    right_span: lexer::SourceSpan
) -> bool {
    let left: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, left_unit);
    let right: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, right_unit);
    if (left == null || right == null ||
        left_span.offset > left->source.length ||
        left_span.length >
            left->source.length - left_span.offset ||
        right_span.offset > right->source.length ||
        right_span.length >
            right->source.length - right_span.offset) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let shared_length: usize =
        left_span.length < right_span.length ?
            left_span.length : right_span.length;
    var index: usize = 0;
    while (index < shared_length) {
        let left_byte: u8 =
            left->source.data[left_span.offset + index];
        let right_byte: u8 =
            right->source.data[right_span.offset + index];
        if (left_byte != right_byte) {
            return left_byte < right_byte;
        }
        index += 1;
    }
    return left_span.length < right_span.length;
}

fn bootstrap_semantic_token_is_before(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_token: usize,
    right_unit: usize,
    right_token: usize
) -> bool {
    return bootstrap_semantic_text_is_before(
        context,
        left_unit,
        bootstrap_semantic_token(
            context,
            left_unit,
            left_token
        ).span,
        right_unit,
        bootstrap_semantic_token(
            context,
            right_unit,
            right_token
        ).span
    );
}

fn bootstrap_semantic_module_name_is_before(
    context: *BootstrapSemanticContext,
    left_module: usize,
    right_module: usize
) -> bool {
    let modules: *const BootstrapSemanticModule =
        context->modules.data as
            *const BootstrapSemanticModule;
    let left: BootstrapSemanticModule =
        modules[left_module];
    let right: BootstrapSemanticModule =
        modules[right_module];
    let left_name: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            left.name_unit,
            left.name_node
        );
    let right_name: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            right.name_unit,
            right.name_node
        );
    var left_child: usize = left_name.first_child;
    var right_child: usize = right_name.first_child;
    let shared_count: usize =
        left_name.child_count < right_name.child_count ?
            left_name.child_count : right_name.child_count;
    var index: usize = 0;
    while (index < shared_count) {
        let left_component: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                left.name_unit,
                left_child
            );
        let right_component: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                right.name_unit,
                right_child
            );
        if (!bootstrap_semantic_tokens_equal(
                context,
                left.name_unit,
                left_component.token_index,
                right.name_unit,
                right_component.token_index
            )) {
            return bootstrap_semantic_token_is_before(
                context,
                left.name_unit,
                left_component.token_index,
                right.name_unit,
                right_component.token_index
            );
        }
        left_child = left_component.next_sibling;
        right_child = right_component.next_sibling;
        index += 1;
    }
    return left_name.child_count < right_name.child_count;
}

fn bootstrap_semantic_function_is_before(
    context: *BootstrapSemanticContext,
    left_function: usize,
    right_function: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let left: BootstrapSemanticSymbol =
        symbols[functions[left_function].symbol_id];
    let right: BootstrapSemanticSymbol =
        symbols[functions[right_function].symbol_id];
    if (left.module_id != right.module_id) {
        return bootstrap_semantic_module_name_is_before(
            context,
            left.module_id,
            right.module_id
        );
    }
    return bootstrap_semantic_token_is_before(
        context,
        left.declaration_unit,
        left.name_token,
        right.declaration_unit,
        right.name_token
    );
}

fn bootstrap_semantic_function_order_sift_down(
    context: *BootstrapSemanticContext,
    ordered: *usize,
    start: usize,
    count: usize
) -> bool {
    if (ordered == null || start >= count) {
        return false;
    }
    var root: usize = start;
    while (root < count / 2 &&
        context->error == runtime::Error.none) {
        let left_child: usize = root * 2 + 1;
        var selected: usize = root;
        if (bootstrap_semantic_function_is_before(
                context,
                ordered[selected],
                ordered[left_child]
            )) {
            selected = left_child;
        }
        let right_child: usize = left_child + 1;
        if (right_child < count &&
            bootstrap_semantic_function_is_before(
                context,
                ordered[selected],
                ordered[right_child]
            )) {
            selected = right_child;
        }
        if (selected == root) {
            return true;
        }
        let saved: usize = ordered[root];
        ordered[root] = ordered[selected];
        ordered[selected] = saved;
        root = selected;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_function_order(
    context: *BootstrapSemanticContext
) -> bytes::Buffer {
    var order: bytes::Buffer =
        bytes::empty();
    var function_id: usize = 0;
    while (function_id < context->function_count &&
        context->error == runtime::Error.none) {
        let appended: bytes::BufferResult =
            bytes::append(
                order,
                (&function_id) as *const usize as *const u8,
                sizeof(usize)
            );
        order = appended.buffer;
        context->error = appended.error;
        function_id += 1;
    }
    let ordered: *usize =
        order.data as *usize;
    var heap_index: usize =
        context->function_count / 2;
    while (heap_index != 0 &&
        context->error == runtime::Error.none) {
        heap_index -= 1;
        bootstrap_semantic_function_order_sift_down(
            context,
            ordered,
            heap_index,
            context->function_count
        );
    }
    var remaining: usize = context->function_count;
    while (remaining > 1 &&
        context->error == runtime::Error.none) {
        remaining -= 1;
        let saved: usize = ordered[0];
        ordered[0] = ordered[remaining];
        ordered[remaining] = saved;
        bootstrap_semantic_function_order_sift_down(
            context,
            ordered,
            0,
            remaining
        );
    }
    return order;
}

fn bootstrap_semantic_create_ir_functions(
    context: *BootstrapSemanticContext
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let order: bytes::Buffer =
        bootstrap_semantic_function_order(context);
    let ordered: *const usize =
        order.data as *const usize;
    var order_index: usize = 0;
    while (order_index < context->function_count &&
        context->error == runtime::Error.none) {
        let function_id: usize = ordered[order_index];
        let ir_function: usize = ir::add_function(
            &context->ir,
            bootstrap_semantic_ir_function_record(
                context,
                function_id
            )
        );
        if (ir_function == none) {
            context->error = context->ir.error;
            break;
        }
        let functions: *BootstrapSemanticFunction =
            context->functions.data as
                *BootstrapSemanticFunction;
        functions[function_id].ir_function = ir_function;
        order_index += 1;
    }

    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    order_index = 0;
    while (order_index < context->function_count &&
        context->error == runtime::Error.none) {
        let function_id: usize = ordered[order_index];
        let function: BootstrapSemanticFunction =
            functions[function_id];
        var index: usize = 0;
        while (index < function.parameter_count) {
            let parameter: BootstrapSemanticParameter =
                parameters[function.first_parameter + index];
            if (ir::add_parameter(
                    &context->ir,
                    function.ir_function,
                    parameter.type_id,
                    parameter.name_token
                ) == none) {
                context->error = context->ir.error;
                break;
            }
            index += 1;
        }
        order_index += 1;
    }
    let release_error: runtime::Error =
        bytes::release(order);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none;
}
