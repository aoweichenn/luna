module luna.bootstrap.middleend.semantic.stmt;


fn bootstrap_semantic_lower_variable(
    context: *BootstrapSemanticContext,
    node_id: usize,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let inferred: bool =
        (node.flags &
            (parser::SyntaxFlag.inferred_type as usize)) != 0;
    if (node.child_count !=
        (inferred ? 1 : 2) + bootstrap_semantic_count_attribute_children(
            context,
            context->current_unit,
            node
        )) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let duplicate: usize =
        bootstrap_semantic_local_in_current_scope(
            context,
            context->current_unit,
            node.token_index
        );
    if (duplicate != none) {
        let locals: *const BootstrapSemanticLocal =
            context->locals.data as
                *const BootstrapSemanticLocal;
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.duplicate_local,
            context->current_unit,
            node.span,
            locals[duplicate].unit_index,
            bootstrap_semantic_node(
                context,
                locals[duplicate].unit_index,
                locals[duplicate].declaration_node
            ).span,
            duplicate
        );
        return false;
    }
    var type_id: usize = none;
    var initializer: BootstrapSemanticExpression =
        bootstrap_semantic_invalid_expression();
    if (inferred) {
        let inferred_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            );
        if (inferred_node.kind ==
                parser::SyntaxKind.zero_initializer ||
            inferred_node.kind ==
                parser::SyntaxKind.aggregate_initializer ||
            inferred_node.kind ==
                parser::SyntaxKind.null_expression) {
            // These forms are context-directed and have no standalone type.
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_initializer,
                context->current_unit,
                inferred_node.span,
                none,
                bootstrap_semantic_empty_span(),
                none
            );
            return false;
        }
        initializer =
            bootstrap_semantic_lower_expression(
                context,
                node.first_child,
                none
            );
        if (!initializer.valid || initializer.type_id == none) {
            return false;
        }
        type_id = initializer.type_id;
    } else {
        let declared_type: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            );
        if (declared_type.kind ==
                parser::SyntaxKind.type_builtin &&
            bootstrap_semantic_token(
                context,
                context->current_unit,
                declared_type.token_index
            ).kind == lexer::TokenKind.keyword_va_list) {
            // A va_list mounts only as a local var inside a variadic
            // function; every other position (parameters, fields, return
            // types, aliases, pointers to it, ...) is rejected with
            // invalid_va_list at type resolution.
            if ((node.flags &
                    (parser::SyntaxFlag.mutable_binding as usize)) == 0 ||
                !bootstrap_semantic_current_function_is_variadic(
                    context
                )) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.invalid_va_list,
                    context->current_unit,
                    node.span,
                    none,
                    bootstrap_semantic_empty_span(),
                    0
                );
                return false;
            }
            type_id = type_info::BuiltinType.va_list_type as usize;
        } else {
            type_id =
                bootstrap_semantic_resolve_type_node(
                    context,
                    context->current_unit,
                    node.first_child
                );
        }
        if (type_id == none) {
            return false;
        }
    }
    let type_record: type_info::Record =
        bootstrap_semantic_type_record(context, type_id);
    if (type_record.kind == type_info::Kind.type_void ||
        (type_record.flags &
            ((type_info::Flag.header as usize) |
                (type_info::Flag.flexible as usize))) != 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.incomplete_type,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    if (!inferred) {
        let type_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            );
        let initializer_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                type_node.next_sibling
            );
        if (type_info::is_memory(type_record.kind) &&
            initializer_node.kind !=
                parser::SyntaxKind.zero_initializer &&
            initializer_node.kind !=
                parser::SyntaxKind.aggregate_initializer &&
            initializer_node.kind !=
                parser::SyntaxKind.name_expression &&
            initializer_node.kind !=
                parser::SyntaxKind.member_expression &&
            initializer_node.kind !=
                parser::SyntaxKind.index_expression &&
            initializer_node.kind !=
                parser::SyntaxKind.call_expression &&
            initializer_node.kind !=
                parser::SyntaxKind.intrinsic_expression &&
            initializer_node.kind !=
                parser::SyntaxKind.conditional_expression &&
            initializer_node.kind !=
                parser::SyntaxKind.parenthesized_expression) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_initializer,
                context->current_unit,
                initializer_node.span,
                none,
                bootstrap_semantic_empty_span(),
                type_id
            );
            return false;
        }
        initializer =
            bootstrap_semantic_lower_expression(
                context,
                type_node.next_sibling,
                type_id
            );
        if (!initializer.valid ||
            initializer.type_id != type_id) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.type_mismatch,
                context->current_unit,
                node.span,
                none,
                bootstrap_semantic_empty_span(),
                type_id
            );
            return false;
        }
    }
    let mutable_binding: bool =
        (node.flags &
            (parser::SyntaxFlag.mutable_binding as usize)) != 0;
    let volatile_binding: bool =
        (node.flags &
            (parser::SyntaxFlag.volatile_ as usize)) != 0;
    let alignment: BootstrapSemanticAlignment =
        bootstrap_semantic_declaration_alignment(
            context,
            context->current_unit,
            node_id
        );
    if (!alignment.valid) {
        return false;
    }
    let slot_id: usize = ir::add_slot(
        &context->ir,
        bootstrap_semantic_current_ir_function(context),
        type_id,
        mutable_binding,
        volatile_binding,
        alignment.alignment
    );
    let address: usize = bootstrap_semantic_address_of_slot(
        context,
        node,
        slot_id,
        type_id,
        false,
        volatile_binding
    );
    if (!bootstrap_semantic_store_to_address(
            context,
            node,
            address,
            type_id,
            initializer
        )) {
        return false;
    }
    return bootstrap_semantic_append_local(
        context,
        {
            function_id = context->current_function,
            type_id = type_id,
            slot_id = slot_id,
            unit_index = context->current_unit,
            declaration_node = node_id,
            name_token = node.token_index,
            scope_depth = context->scope_depth,
            mutable_binding = mutable_binding,
            volatile_binding = volatile_binding,
            constant_binding = false,
            integer_value = 0,
        }
    ) != none;
}

fn bootstrap_semantic_lower_constant(
    context: *BootstrapSemanticContext,
    node_id: usize,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count !=
        2 + bootstrap_semantic_count_attribute_children(
            context,
            context->current_unit,
            node
        )) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let duplicate: usize =
        bootstrap_semantic_local_in_current_scope(
            context,
            context->current_unit,
            node.token_index
        );
    if (duplicate != none) {
        let locals: *const BootstrapSemanticLocal =
            context->locals.data as *const BootstrapSemanticLocal;
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.duplicate_local,
            context->current_unit,
            node.span,
            locals[duplicate].unit_index,
            bootstrap_semantic_node(
                context,
                locals[duplicate].unit_index,
                locals[duplicate].declaration_node
            ).span,
            duplicate
        );
        return false;
    }
    let type_id: usize = bootstrap_semantic_resolve_type_node(
        context,
        context->current_unit,
        node.first_child
    );
    if (type_id == none) {
        return false;
    }
    let type_record: type_info::Record =
        bootstrap_semantic_type_record(context, type_id);
    if (!type_info::is_integer(type_record.kind) &&
        type_record.kind != type_info::Kind.boolean) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            ).span,
            none,
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    let initializer_id: usize = bootstrap_semantic_node(
        context,
        context->current_unit,
        node.first_child
    ).next_sibling;
    let value: BootstrapConstValue =
        bootstrap_consteval_expression(
            context,
            context->current_unit,
            initializer_id
        );
    if (!value.is_constant || value.error) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind
                .non_constant_expression,
            context->current_unit,
            bootstrap_semantic_node(
                context,
                context->current_unit,
                initializer_id
            ).span,
            none,
            bootstrap_semantic_empty_span(),
            node_id
        );
        return false;
    }
    if (!bootstrap_semantic_const_value_conforms(
            context,
            context->current_unit,
            bootstrap_semantic_node(
                context,
                context->current_unit,
                initializer_id
            ).span,
            type_id,
            value
        )) {
        return false;
    }
    return bootstrap_semantic_append_local(
        context,
        {
            function_id = context->current_function,
            type_id = type_id,
            slot_id = none,
            unit_index = context->current_unit,
            declaration_node = node_id,
            name_token = node.token_index,
            scope_depth = context->scope_depth,
            mutable_binding = false,
            volatile_binding = false,
            constant_binding = true,
            integer_value = value.value,
        }
    ) != none;
}

fn bootstrap_semantic_assignment_operation(
    operation: lexer::TokenKind
) -> lexer::TokenKind {
    if (operation == lexer::TokenKind.plus_equal) {
        return lexer::TokenKind.plus;
    }
    if (operation == lexer::TokenKind.minus_equal) {
        return lexer::TokenKind.minus;
    }
    if (operation == lexer::TokenKind.star_equal) {
        return lexer::TokenKind.star;
    }
    if (operation == lexer::TokenKind.slash_equal) {
        return lexer::TokenKind.slash;
    }
    if (operation == lexer::TokenKind.percent_equal) {
        return lexer::TokenKind.percent;
    }
    if (operation == lexer::TokenKind.ampersand_equal) {
        return lexer::TokenKind.ampersand;
    }
    if (operation == lexer::TokenKind.pipe_equal) {
        return lexer::TokenKind.pipe;
    }
    if (operation == lexer::TokenKind.caret_equal) {
        return lexer::TokenKind.caret;
    }
    if (operation == lexer::TokenKind.shift_left_equal) {
        return lexer::TokenKind.shift_left;
    }
    if (operation == lexer::TokenKind.shift_right_equal) {
        return lexer::TokenKind.shift_right;
    }
    return lexer::TokenKind.invalid;
}

fn bootstrap_semantic_lower_assignment(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    if (node.child_count != 2) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let target_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let target: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            bootstrap_semantic_no_id()
        );
    if (!target.valid || !target.lvalue ||
        !target.mutable_lvalue) {
        bootstrap_semantic_add_diagnostic(
            context,
            target.lvalue ?
                BootstrapSemanticDiagnosticKind
                    .immutable_assignment :
                BootstrapSemanticDiagnosticKind.invalid_lvalue,
            context->current_unit,
            target_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            target.type_id
        );
        return false;
    }
    let target_record: type_info::Record =
        bootstrap_semantic_type_record(
            context,
            target.type_id
        );
    if ((target_record.flags &
            ((type_info::Flag.header as usize) |
                (type_info::Flag.flexible as usize))) != 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.incomplete_type,
            context->current_unit,
            target_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            target.type_id
        );
        return false;
    }
    let assignment: lexer::TokenKind =
        bootstrap_semantic_token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    let compound_operation: lexer::TokenKind =
        assignment != lexer::TokenKind.equal ?
            bootstrap_semantic_assignment_operation(assignment) :
            lexer::TokenKind.invalid;
    let pointer_additive: bool =
        compound_operation == lexer::TokenKind.plus ||
        compound_operation == lexer::TokenKind.minus;
    let value_expected: usize =
        pointer_additive &&
        bootstrap_semantic_type_record(
            context,
            target.type_id
        ).kind == type_info::Kind.pointer ?
            type_info::BuiltinType.unsigned_size as usize :
            target.type_id;
    let value: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            target_node.next_sibling,
            value_expected
        );
    if (!value.valid || value.type_id != value_expected) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            target.type_id
        );
        return false;
    }
    var stored: BootstrapSemanticExpression = value;
    if (assignment != lexer::TokenKind.equal) {
        let type_record: type_info::Record =
            bootstrap_semantic_type_record(
                context,
                target.type_id
            );
        if (type_record.kind == type_info::Kind.pointer &&
            pointer_additive) {
            if (!bootstrap_semantic_pointer_arithmetic_is_allowed(
                    context,
                    target.type_id
                )) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .invalid_operator,
                    context->current_unit,
                    node.span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    target.type_id
                );
                return false;
            }
            var count_value: usize = value.value_id;
            if (compound_operation ==
                lexer::TokenKind.minus) {
                count_value =
                    bootstrap_semantic_emit_negated_usize(
                        context,
                        node,
                        value.value_id
                    );
            }
            let result_value: usize =
                bootstrap_semantic_emit_pointer_offset(
                    context,
                    node,
                    target.value_id,
                    target.type_id,
                    count_value
                );
            stored.type_id = target.type_id;
            stored.address_id = bootstrap_semantic_no_id();
            stored.lvalue = false;
            stored.mutable_lvalue = false;
            stored.volatile_lvalue = false;
            stored.value_id = result_value;
            stored.valid =
                result_value != bootstrap_semantic_no_id();
        } else {
        var opcode: ir::Opcode =
            ir::Opcode.invalid;
        if (type_info::is_integer(type_record.kind) &&
            (bootstrap_semantic_binary_is_arithmetic(compound_operation) ||
                bootstrap_semantic_binary_is_bitwise(compound_operation))) {
            opcode = ir::Opcode.binary_integer;
        } else if (type_info::is_float(type_record.kind) &&
            bootstrap_semantic_binary_is_arithmetic(compound_operation) &&
            compound_operation != lexer::TokenKind.percent) {
            opcode = ir::Opcode.binary_float;
        }
        if (opcode == ir::Opcode.invalid) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_operator,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                target.type_id
            );
            return false;
        }
        var instruction: ir::Instruction =
            bootstrap_semantic_instruction(opcode, node);
        instruction.operation = compound_operation;
        instruction.left = target.value_id;
        instruction.right = value.value_id;
        let result_value: usize =
            bootstrap_semantic_emit_value(
                context,
                instruction,
                target.type_id
            );
        stored.value_id = result_value;
        stored.valid =
            result_value != bootstrap_semantic_no_id();
        }
    }
    if (target.bitfield_segment !=
        bootstrap_semantic_no_id()) {
        return bootstrap_semantic_store_bitfield(
            context,
            node,
            target.address_id,
            target.bitfield_segment,
            stored
        );
    }
    return bootstrap_semantic_store_to_address(
        context,
        node,
        target.address_id,
        target.type_id,
        stored
    );
}

fn bootstrap_semantic_lower_if(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count < 2 || node.child_count > 3) {
        return false;
    }
    let condition_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            type_info::BuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            type_info::BuiltinType.boolean as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_condition,
            context->current_unit,
            condition_node.span,
            none,
            bootstrap_semantic_empty_span(),
            condition.type_id
        );
        return false;
    }
    let then_block: usize =
        bootstrap_semantic_add_current_block(context);
    let else_block: usize =
        bootstrap_semantic_add_current_block(context);
    let merge_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        then_block,
        else_block
    );
    context->current_block = then_block;
    bootstrap_semantic_lower_block(
        context,
        condition_node.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            merge_block
        );
    }
    context->current_block = else_block;
    if (node.child_count == 3) {
        let then_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                condition_node.next_sibling
            );
        let else_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                then_node.next_sibling
            );
        if (else_node.kind == parser::SyntaxKind.if_statement) {
            bootstrap_semantic_lower_if(context, else_node);
        } else {
            bootstrap_semantic_lower_block(
                context,
                then_node.next_sibling
            );
        }
    }
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            merge_block
        );
    }
    context->current_block = merge_block;
    return true;
}

fn bootstrap_semantic_lower_while(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    if (node.child_count != 2) {
        return false;
    }
    let condition_block: usize =
        bootstrap_semantic_add_current_block(context);
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(
        context,
        node,
        condition_block
    );
    context->current_block = condition_block;
    let condition_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            type_info::BuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            type_info::BuiltinType.boolean as usize) {
        return false;
    }
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        body_block,
        exit_block
    );
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = condition_block;
    let pushed_label: bool =
        bootstrap_semantic_push_loop_label(context);
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        condition_node.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            condition_block
        );
    }
    if (pushed_label) {
        bootstrap_semantic_pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn bootstrap_semantic_lower_do(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    if (node.child_count != 2) {
        return false;
    }
    let body_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let condition_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(context, node, body_block);
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = condition_block;
    let pushed_label: bool =
        bootstrap_semantic_push_loop_label(context);
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        node.first_child
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            condition_block
        );
    }
    context->current_block = condition_block;
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            body_node.next_sibling,
            type_info::BuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            type_info::BuiltinType.boolean as usize) {
        return false;
    }
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        body_block,
        exit_block
    );
    if (pushed_label) {
        bootstrap_semantic_pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn bootstrap_semantic_lower_loop(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    if (node.child_count != 1) {
        return false;
    }
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(context, node, body_block);
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = body_block;
    let pushed_label: bool =
        bootstrap_semantic_push_loop_label(context);
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        node.first_child
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            body_block
        );
    }
    if (pushed_label) {
        bootstrap_semantic_pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn bootstrap_semantic_lower_for_clause(
    context: *BootstrapSemanticContext,
    wrapper_id: usize
) -> bool {
    let wrapper: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            wrapper_id
        );
    if (wrapper.child_count == 0) {
        return true;
    }
    if (wrapper.child_count != 1) {
        return false;
    }
    let child: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            wrapper.first_child
        );
    if (child.kind ==
        parser::SyntaxKind.variable_declaration) {
        return bootstrap_semantic_lower_variable(
            context,
            wrapper.first_child,
            child
        );
    }
    if (child.kind ==
        parser::SyntaxKind.assignment_statement) {
        return bootstrap_semantic_lower_assignment(
            context,
            child
        );
    }
    if (child.kind ==
            parser::SyntaxKind.expression_statement &&
        child.child_count == 1) {
        return bootstrap_semantic_lower_expression(
            context,
            child.first_child,
            bootstrap_semantic_no_id()
        ).valid;
    }
    return false;
}

fn bootstrap_semantic_lower_for(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    if (node.child_count != 4) {
        return false;
    }
    let local_start: usize =
        bootstrap_semantic_enter_scope(context);
    if (local_start == bootstrap_semantic_no_id()) {
        return false;
    }
    let initializer: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let condition_wrapper: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            initializer.next_sibling
        );
    let update_wrapper: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            condition_wrapper.next_sibling
        );
    bootstrap_semantic_lower_for_clause(
        context,
        node.first_child
    );
    let condition_block: usize =
        bootstrap_semantic_add_current_block(context);
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let update_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(
        context,
        node,
        condition_block
    );
    context->current_block = condition_block;
    if (condition_wrapper.child_count == 0) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            body_block
        );
    } else {
        let condition: BootstrapSemanticExpression =
            bootstrap_semantic_lower_expression(
                context,
                condition_wrapper.first_child,
                type_info::BuiltinType.boolean as usize
            );
        if (!condition.valid ||
            condition.type_id !=
                type_info::BuiltinType.boolean as usize) {
            bootstrap_semantic_leave_scope(
                context,
                local_start
            );
            return false;
        }
        bootstrap_semantic_emit_branch(
            context,
            node,
            condition.value_id,
            body_block,
            exit_block
        );
    }
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = update_block;
    let pushed_label: bool =
        bootstrap_semantic_push_loop_label(context);
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        update_wrapper.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            update_block
        );
    }
    context->current_block = update_block;
    bootstrap_semantic_lower_for_clause(
        context,
        condition_wrapper.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            condition_block
        );
    }
    if (pushed_label) {
        bootstrap_semantic_pop_loop_label(context);
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    bootstrap_semantic_leave_scope(context, local_start);
    return true;
}

fn bootstrap_semantic_switch_label(
    context: *BootstrapSemanticContext,
    node_id: usize,
    control_type: usize
) -> BootstrapSemanticExpression {
    let node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    let control_record: type_info::Record =
        bootstrap_semantic_type_record(
            context,
            control_type
        );
    if (control_record.kind ==
        type_info::Kind.enumeration) {
        let result: BootstrapSemanticExpression =
            bootstrap_semantic_lower_enum_member(context, node);
        if (result.type_id == control_type) {
            return result;
        }
        return bootstrap_semantic_invalid_expression();
    }
    if (node.kind ==
        parser::SyntaxKind.integer_expression) {
        return bootstrap_semantic_lower_integer_literal(
            context,
            node,
            control_type
        );
    }
    if (node.kind == parser::SyntaxKind.name_expression) {
        return bootstrap_semantic_lower_const_name(context, node);
    }
    if (node.kind ==
        parser::SyntaxKind.unary_expression) {
        return bootstrap_semantic_lower_unary(
            context,
            node,
            control_type
        );
    }
    return bootstrap_semantic_invalid_expression();
}

fn bootstrap_semantic_lower_switch(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count < 2) {
        return false;
    }
    let expression_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let control: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            none
        );
    if (!control.valid) {
        return false;
    }
    let control_record: type_info::Record =
        bootstrap_semantic_type_record(
            context,
            control.type_id
        );
    if (!type_info::is_integer(control_record.kind) &&
        control_record.kind != type_info::Kind.enumeration) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_switch,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            control.type_id
        );
        return false;
    }
    var arm_blocks: bytes::Buffer =
        bytes::empty();
    var arm_node: usize = expression_node.next_sibling;
    var default_block: usize = none;
    while (arm_node != none &&
        context->error == runtime::Error.none) {
        let arm: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                arm_node
            );
        let block_id: usize =
            bootstrap_semantic_add_current_block(context);
        let appended: bytes::BufferResult =
            bytes::append(
                arm_blocks,
                (&block_id) as *const usize as *const u8,
                sizeof(usize)
            );
        arm_blocks = appended.buffer;
        context->error = appended.error;
        if ((arm.flags &
                (parser::SyntaxFlag.default_arm as usize)) != 0) {
            if (default_block != none) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .duplicate_default,
                    context->current_unit,
                    arm.span,
                    none,
                    bootstrap_semantic_empty_span(),
                    0
                );
            }
            default_block = block_id;
        }
        arm_node = arm.next_sibling;
    }
    var seen_values: bytes::Buffer =
        bytes::empty();
    let blocks: *const usize =
        arm_blocks.data as *const usize;
    arm_node = expression_node.next_sibling;
    var arm_index: usize = 0;
    while (arm_node != none &&
        context->error == runtime::Error.none) {
        let arm: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                arm_node
            );
        let is_default: bool =
            (arm.flags &
                (parser::SyntaxFlag.default_arm as usize)) != 0;
        var child: usize = arm.first_child;
        let label_count: usize =
            is_default ? 0 : arm.child_count - 1;
        var label_index: usize = 0;
        while (label_index < label_count) {
            let label: BootstrapSemanticExpression =
                bootstrap_semantic_switch_label(
                    context,
                    child,
                    control.type_id
                );
            if (!label.valid ||
                label.type_id != control.type_id) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .invalid_switch,
                    context->current_unit,
                    bootstrap_semantic_node(
                        context,
                        context->current_unit,
                        child
                    ).span,
                    none,
                    bootstrap_semantic_empty_span(),
                    control.type_id
                );
            } else {
                let values: *const u64 =
                    seen_values.data as *const u64;
                var duplicate: bool = false;
                var value_index: usize = 0;
                while (value_index <
                    seen_values.length / sizeof(u64)) {
                    if (values[value_index] ==
                        label.constant_value) {
                        duplicate = true;
                        break;
                    }
                    value_index += 1;
                }
                if (duplicate) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .duplicate_case,
                        context->current_unit,
                        bootstrap_semantic_node(
                            context,
                            context->current_unit,
                            child
                        ).span,
                        none,
                        bootstrap_semantic_empty_span(),
                        value_index
                    );
                }
                let appended: bytes::BufferResult =
                    bytes::append(
                        seen_values,
                        (&label.constant_value) as
                            *const u64 as *const u8,
                        sizeof(u64)
                    );
                seen_values = appended.buffer;
                context->error = appended.error;
                var comparison: ir::Instruction =
                    bootstrap_semantic_instruction(
                        ir::Opcode.compare,
                        arm
                    );
                comparison.operation =
                    lexer::TokenKind.equal_equal;
                comparison.left = control.value_id;
                comparison.right = label.value_id;
                let comparison_value: usize =
                    bootstrap_semantic_emit_value(
                        context,
                        comparison,
                        type_info::BuiltinType.boolean as usize
                    );
                let next_test: usize =
                    bootstrap_semantic_add_current_block(
                        context
                    );
                bootstrap_semantic_emit_branch(
                    context,
                    arm,
                    comparison_value,
                    blocks[arm_index],
                    next_test
                );
                context->current_block = next_test;
            }
            child = bootstrap_semantic_node(
                context,
                context->current_unit,
                child
            ).next_sibling;
            label_index += 1;
        }
        arm_node = arm.next_sibling;
        arm_index += 1;
    }
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(
        context,
        node,
        default_block != none ? default_block : exit_block
    );
    let saved_break: usize = context->break_block;
    context->break_block = exit_block;
    arm_node = expression_node.next_sibling;
    arm_index = 0;
    while (arm_node != none) {
        let arm: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                arm_node
            );
        context->current_block = blocks[arm_index];
        bootstrap_semantic_lower_block(
            context,
            arm.last_child
        );
        if (!bootstrap_semantic_block_is_terminated(
                context,
                context->current_block
            )) {
            bootstrap_semantic_emit_jump(
                context,
                arm,
                exit_block
            );
        }
        arm_node = arm.next_sibling;
        arm_index += 1;
    }
    context->break_block = saved_break;
    context->current_block = exit_block;
    var release_error: runtime::Error =
        bytes::release(arm_blocks);
    release_error = bootstrap_semantic_release_error(
        release_error,
        bytes::release(seen_values)
    );
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return true;
}

fn bootstrap_semantic_lower_return(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let return_type: usize =
        functions[context->current_function].return_type;
    let return_record: type_info::Record =
        bootstrap_semantic_type_record(
            context,
            return_type
        );
    if ((functions[context->current_function].flags &
            (BootstrapSemanticSymbolFlag.no_return as usize)) != 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.noreturn_returns,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            0
        );
    }
    var instruction: ir::Instruction =
        bootstrap_semantic_instruction(
            return_record.kind == type_info::Kind.type_void ?
                ir::Opcode.return_void :
                ir::Opcode.return_value,
            node
        );
    instruction.type_id = return_type;
    if (return_record.kind ==
        type_info::Kind.type_void) {
        if (node.child_count != 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.return_type,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                return_type
            );
            return false;
        }
    } else {
        if (node.child_count != 1) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.return_type,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                return_type
            );
            return false;
        }
        let value: BootstrapSemanticExpression =
            bootstrap_semantic_lower_expression(
                context,
                node.first_child,
                return_type
            );
        if (!value.valid || value.type_id != return_type) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.return_type,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                return_type
            );
            return false;
        }
        instruction.left =
            type_info::is_memory(return_record.kind) ?
                value.address_id : value.value_id;
    }
    bootstrap_semantic_emit_void(context, instruction);
    context->current_block =
        bootstrap_semantic_add_current_block(context);
    return true;
}

fn bootstrap_semantic_find_label(
    context: *BootstrapSemanticContext,
    name_token: usize
) -> usize {
    let labels: *const BootstrapSemanticLabel =
        context->labels.data as *const BootstrapSemanticLabel;
    var index: usize = 0;
    while (index < context->label_count) {
        if (bootstrap_semantic_tokens_equal(
                context,
                context->current_unit,
                name_token,
                context->current_unit,
                labels[index].name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_append_label(
    context: *BootstrapSemanticContext,
    label: BootstrapSemanticLabel
) -> usize {
    let result: usize = context->label_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->labels,
            (&label) as *const BootstrapSemanticLabel as *const u8,
            sizeof(BootstrapSemanticLabel)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->label_count += 1;
    return result;
}

// Appends the declaration-node identity of every live local of the current
// function to destination and returns the index of the first identity.
fn bootstrap_semantic_snapshot_locals(
    context: *BootstrapSemanticContext,
    destination: *bytes::Buffer
) -> usize {
    let first: usize = destination->length / sizeof(usize);
    let locals: *const BootstrapSemanticLocal =
        context->locals.data as *const BootstrapSemanticLocal;
    var index: usize = 0;
    while (index < context->local_count &&
        context->error == runtime::Error.none) {
        let identity: usize = locals[index].declaration_node;
        let appended: bytes::BufferResult =
            bytes::append(
                *destination,
                (&identity) as *const usize as *const u8,
                sizeof(usize)
            );
        *destination = appended.buffer;
        context->error = appended.error;
        index += 1;
    }
    return first;
}

// The label's live-local set must be a subset of the locals live right now
// (a backward goto may not land inside the extent of an initialization it
// jumps over).
fn bootstrap_semantic_label_subset_of_current(
    context: *BootstrapSemanticContext,
    label: BootstrapSemanticLabel
) -> bool {
    let identities: *const usize =
        context->label_locals.data as *const usize;
    let locals: *const BootstrapSemanticLocal =
        context->locals.data as *const BootstrapSemanticLocal;
    var index: usize = 0;
    while (index < label.local_count) {
        let identity: usize = identities[label.first_local + index];
        var found: bool = false;
        var local_index: usize = 0;
        while (local_index < context->local_count) {
            if (locals[local_index].declaration_node == identity) {
                found = true;
                break;
            }
            local_index += 1;
        }
        if (!found) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Same subset rule for a forward goto, whose live-local set was snapshotted
// into goto_locals when the jump was lowered.
fn bootstrap_semantic_label_subset_of_goto(
    context: *BootstrapSemanticContext,
    label: BootstrapSemanticLabel,
    pending: BootstrapSemanticPendingGoto
) -> bool {
    let identities: *const usize =
        context->label_locals.data as *const usize;
    let live: *const usize = context->goto_locals.data as *const usize;
    var index: usize = 0;
    while (index < label.local_count) {
        let identity: usize = identities[label.first_local + index];
        var found: bool = false;
        var local_index: usize = 0;
        while (local_index < pending.local_count) {
            if (live[pending.first_local + local_index] == identity) {
                found = true;
                break;
            }
            local_index += 1;
        }
        if (!found) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Pushes the label carried by pending_loop_label (set when a labeled
// statement wraps a loop) onto the loop-label stack; returns whether an
// entry was pushed so the caller can pop it when the loop is done.
fn bootstrap_semantic_push_loop_label(
    context: *BootstrapSemanticContext
) -> bool {
    if (context->pending_loop_label == bootstrap_semantic_no_id()) {
        return false;
    }
    let entry: BootstrapSemanticLoopLabel = {
        name_token = context->pending_loop_label,
        break_block = context->break_block,
        continue_block = context->continue_block,
    };
    context->pending_loop_label = bootstrap_semantic_no_id();
    if (!bootstrap_semantic_append_record(
            context,
            &context->loop_labels,
            (&entry) as *const BootstrapSemanticLoopLabel as *const u8,
            sizeof(BootstrapSemanticLoopLabel)
        )) {
        return false;
    }
    context->loop_label_count += 1;
    return true;
}

fn bootstrap_semantic_pop_loop_label(
    context: *BootstrapSemanticContext
) -> bool {
    if (context->loop_label_count == 0) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let truncated: bytes::BufferResult =
        bytes::truncate(
            context->loop_labels,
            (context->loop_label_count - 1) *
                sizeof(BootstrapSemanticLoopLabel)
        );
    context->loop_labels = truncated.buffer;
    context->error = truncated.error;
    context->loop_label_count -= 1;
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_lower_labeled_control(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode,
    is_break: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let name_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let entries: *const BootstrapSemanticLoopLabel =
        context->loop_labels.data as *const BootstrapSemanticLoopLabel;
    var index: usize = context->loop_label_count;
    while (index != 0) {
        index -= 1;
        if (bootstrap_semantic_tokens_equal(
                context,
                context->current_unit,
                name_node.token_index,
                context->current_unit,
                entries[index].name_token
            )) {
            bootstrap_semantic_emit_jump(
                context,
                node,
                is_break ?
                    entries[index].break_block :
                    entries[index].continue_block
            );
            context->current_block =
                bootstrap_semantic_add_current_block(context);
            return context->error == runtime::Error.none;
        }
    }
    bootstrap_semantic_add_diagnostic(
        context,
        bootstrap_semantic_find_label(context, name_node.token_index) !=
            none ?
            BootstrapSemanticDiagnosticKind.non_loop_label :
            BootstrapSemanticDiagnosticKind.unknown_label,
        context->current_unit,
        name_node.span,
        none,
        bootstrap_semantic_empty_span(),
        0
    );
    return false;
}

fn bootstrap_semantic_lower_labeled(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let statement: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let is_loop: bool =
        statement.kind == parser::SyntaxKind.while_statement ||
        statement.kind == parser::SyntaxKind.do_statement ||
        statement.kind == parser::SyntaxKind.for_statement ||
        statement.kind == parser::SyntaxKind.loop_statement;
    var label_index: usize =
        bootstrap_semantic_find_label(context, node.token_index);
    if (label_index != none) {
        let labels: *BootstrapSemanticLabel =
            context->labels.data as *BootstrapSemanticLabel;
        if (labels[label_index].defined) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.duplicate_label,
                context->current_unit,
                node.span,
                context->current_unit,
                labels[label_index].span,
                label_index
            );
            return false;
        }
        labels[label_index].defined = true;
        labels[label_index].is_loop = is_loop;
        labels[label_index].span = node.span;
    } else {
        let block: usize = bootstrap_semantic_add_current_block(context);
        if (block == none) {
            return false;
        }
        label_index = bootstrap_semantic_append_label(
            context,
            {
                name_token = node.token_index,
                span = node.span,
                block = block,
                first_local = 0,
                local_count = 0,
                is_loop = is_loop,
                defined = true,
            }
        );
        if (label_index == none) {
            return false;
        }
    }
    let labels: *BootstrapSemanticLabel =
        context->labels.data as *BootstrapSemanticLabel;
    let first_local: usize =
        bootstrap_semantic_snapshot_locals(
            context,
            &context->label_locals
        );
    if (context->error != runtime::Error.none) {
        return false;
    }
    labels[label_index].first_local = first_local;
    labels[label_index].local_count = context->local_count;
    let label: BootstrapSemanticLabel = labels[label_index];
    let pendings: *BootstrapSemanticPendingGoto =
        context->pending_gotos.data as *BootstrapSemanticPendingGoto;
    var pending_index: usize = 0;
    while (pending_index < context->pending_goto_count) {
        if (!pendings[pending_index].resolved &&
            bootstrap_semantic_tokens_equal(
                context,
                context->current_unit,
                pendings[pending_index].label_token,
                context->current_unit,
                label.name_token
            )) {
            if (!bootstrap_semantic_label_subset_of_goto(
                    context,
                    label,
                    pendings[pending_index]
                )) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.invalid_goto,
                    context->current_unit,
                    pendings[pending_index].span,
                    context->current_unit,
                    label.span,
                    label_index
                );
            }
            pendings[pending_index].resolved = true;
        }
        pending_index += 1;
    }
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(context, node, label.block);
    }
    context->current_block = label.block;
    if (is_loop) {
        context->pending_loop_label = node.token_index;
    }
    let result: bool =
        bootstrap_semantic_lower_statement(context, node.first_child);
    context->pending_loop_label = none;
    return result;
}

fn bootstrap_semantic_lower_goto(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let name_node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    var label_index: usize =
        bootstrap_semantic_find_label(context, name_node.token_index);
    if (label_index != none) {
        let labels: *const BootstrapSemanticLabel =
            context->labels.data as *const BootstrapSemanticLabel;
        if (labels[label_index].defined) {
            if (!bootstrap_semantic_label_subset_of_current(
                    context,
                    labels[label_index]
                )) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.invalid_goto,
                    context->current_unit,
                    name_node.span,
                    context->current_unit,
                    labels[label_index].span,
                    label_index
                );
                return false;
            }
            bootstrap_semantic_emit_jump(
                context,
                node,
                labels[label_index].block
            );
            context->current_block =
                bootstrap_semantic_add_current_block(context);
            return context->error == runtime::Error.none;
        }
    }
    var block: usize = none;
    if (label_index == none) {
        block = bootstrap_semantic_add_current_block(context);
        if (block == none) {
            return false;
        }
        label_index = bootstrap_semantic_append_label(
            context,
            {
                name_token = name_node.token_index,
                span = name_node.span,
                block = block,
                first_local = 0,
                local_count = 0,
                is_loop = false,
                defined = false,
            }
        );
        if (label_index == none) {
            return false;
        }
    } else {
        let labels: *const BootstrapSemanticLabel =
            context->labels.data as *const BootstrapSemanticLabel;
        block = labels[label_index].block;
    }
    let first_local: usize =
        bootstrap_semantic_snapshot_locals(context, &context->goto_locals);
    if (context->error != runtime::Error.none) {
        return false;
    }
    let pending: BootstrapSemanticPendingGoto = {
        label_token = name_node.token_index,
        span = name_node.span,
        first_local = first_local,
        local_count = context->local_count,
        resolved = false,
    };
    if (!bootstrap_semantic_append_record(
            context,
            &context->pending_gotos,
            (&pending) as *const BootstrapSemanticPendingGoto as *const u8,
            sizeof(BootstrapSemanticPendingGoto)
        )) {
        return false;
    }
    context->pending_goto_count += 1;
    bootstrap_semantic_emit_jump(context, node, block);
    context->current_block = bootstrap_semantic_add_current_block(context);
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_validate_labels(
    context: *BootstrapSemanticContext
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let labels: *const BootstrapSemanticLabel =
        context->labels.data as *const BootstrapSemanticLabel;
    var index: usize = 0;
    while (index < context->label_count) {
        if (!labels[index].defined) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.unknown_label,
                context->current_unit,
                labels[index].span,
                none,
                bootstrap_semantic_empty_span(),
                index
            );
        }
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_clear_label_state(
    context: *BootstrapSemanticContext
) -> bool {
    var error: runtime::Error = runtime::Error.none;
    let cleared_labels: bytes::BufferResult =
        bytes::clear(context->labels);
    context->labels = cleared_labels.buffer;
    error = bootstrap_semantic_release_error(error, cleared_labels.error);
    let cleared_label_locals: bytes::BufferResult =
        bytes::clear(context->label_locals);
    context->label_locals = cleared_label_locals.buffer;
    error =
        bootstrap_semantic_release_error(error, cleared_label_locals.error);
    let cleared_gotos: bytes::BufferResult =
        bytes::clear(context->pending_gotos);
    context->pending_gotos = cleared_gotos.buffer;
    error = bootstrap_semantic_release_error(error, cleared_gotos.error);
    let cleared_goto_locals: bytes::BufferResult =
        bytes::clear(context->goto_locals);
    context->goto_locals = cleared_goto_locals.buffer;
    error =
        bootstrap_semantic_release_error(error, cleared_goto_locals.error);
    let cleared_loops: bytes::BufferResult =
        bytes::clear(context->loop_labels);
    context->loop_labels = cleared_loops.buffer;
    error = bootstrap_semantic_release_error(error, cleared_loops.error);
    context->label_count = 0;
    context->pending_goto_count = 0;
    context->loop_label_count = 0;
    context->pending_loop_label = bootstrap_semantic_no_id();
    if (context->error == runtime::Error.none) {
        context->error = error;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_lower_va_start(
    context: *BootstrapSemanticContext,
    node: parser::SyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count != 1) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    // va_start initializes a local va_list against the variadic function's
    // register save area; outside a variadic function there is nothing to
    // bind it to.
    if (!bootstrap_semantic_current_function_is_variadic(context)) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_va_list,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
        return false;
    }
    let list: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            none
        );
    if (!list.valid) {
        return false;
    }
    if (!list.lvalue || !list.mutable_lvalue ||
        list.type_id != (type_info::BuiltinType.va_list_type as usize)) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_va_list,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
        return false;
    }
    var instruction: ir::Instruction =
        bootstrap_semantic_instruction(
            ir::Opcode.va_list_start,
            node
        );
    instruction.left = list.address_id;
    return bootstrap_semantic_emit_void(
        context,
        instruction
    ) != none;
}

fn bootstrap_semantic_lower_statement(
    context: *BootstrapSemanticContext,
    node_id: usize
) -> bool {
    let node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind ==
        parser::SyntaxKind.variable_declaration) {
        return bootstrap_semantic_lower_variable(
            context,
            node_id,
            node
        );
    }
    if (node.kind == parser::SyntaxKind.const_declaration) {
        return bootstrap_semantic_lower_constant(
            context,
            node_id,
            node
        );
    }
    if (node.kind ==
        parser::SyntaxKind.assignment_statement) {
        return bootstrap_semantic_lower_assignment(
            context,
            node
        );
    }
    if (node.kind ==
        parser::SyntaxKind.expression_statement) {
        return node.child_count == 1 &&
            bootstrap_semantic_lower_expression(
                context,
                node.first_child,
                bootstrap_semantic_no_id()
            ).valid;
    }
    if (node.kind == parser::SyntaxKind.block_statement) {
        return bootstrap_semantic_lower_block(
            context,
            node_id
        );
    }
    if (node.kind == parser::SyntaxKind.if_statement) {
        return bootstrap_semantic_lower_if(context, node);
    }
    if (node.kind == parser::SyntaxKind.while_statement) {
        return bootstrap_semantic_lower_while(context, node);
    }
    if (node.kind == parser::SyntaxKind.do_statement) {
        return bootstrap_semantic_lower_do(context, node);
    }
    if (node.kind == parser::SyntaxKind.for_statement) {
        return bootstrap_semantic_lower_for(context, node);
    }
    if (node.kind == parser::SyntaxKind.loop_statement) {
        return bootstrap_semantic_lower_loop(context, node);
    }
    if (node.kind == parser::SyntaxKind.switch_statement) {
        return bootstrap_semantic_lower_switch(context, node);
    }
    if (node.kind == parser::SyntaxKind.break_statement) {
        if (node.child_count == 1) {
            return bootstrap_semantic_lower_labeled_control(
                context,
                node,
                true
            );
        }
        if (context->break_block ==
            bootstrap_semantic_no_id()) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .break_outside_control,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                0
            );
            return false;
        }
        bootstrap_semantic_emit_jump(
            context,
            node,
            context->break_block
        );
        context->current_block =
            bootstrap_semantic_add_current_block(context);
        return true;
    }
    if (node.kind ==
        parser::SyntaxKind.continue_statement) {
        if (node.child_count == 1) {
            return bootstrap_semantic_lower_labeled_control(
                context,
                node,
                false
            );
        }
        if (context->continue_block ==
            bootstrap_semantic_no_id()) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .continue_outside_loop,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                0
            );
            return false;
        }
        bootstrap_semantic_emit_jump(
            context,
            node,
            context->continue_block
        );
        context->current_block =
            bootstrap_semantic_add_current_block(context);
        return true;
    }
    if (node.kind == parser::SyntaxKind.return_statement) {
        return bootstrap_semantic_lower_return(context, node);
    }
    if (node.kind == parser::SyntaxKind.labeled_statement) {
        return bootstrap_semantic_lower_labeled(context, node);
    }
    if (node.kind == parser::SyntaxKind.goto_statement) {
        return bootstrap_semantic_lower_goto(context, node);
    }
    if (node.kind == parser::SyntaxKind.assert_statement) {
        return bootstrap_semantic_check_assert(
            context,
            context->current_unit,
            node_id
        );
    }
    if (node.kind == parser::SyntaxKind.va_start_statement) {
        return bootstrap_semantic_lower_va_start(
            context,
            node
        );
    }
    bootstrap_semantic_add_diagnostic(
        context,
        BootstrapSemanticDiagnosticKind.internal_invariant,
        context->current_unit,
        node.span,
        bootstrap_semantic_no_id(),
        bootstrap_semantic_empty_span(),
        node.kind as usize
    );
    return false;
}

fn bootstrap_semantic_lower_block(
    context: *BootstrapSemanticContext,
    node_id: usize
) -> bool {
    let node: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind != parser::SyntaxKind.block_statement) {
        context->error = runtime::Error.invalid_argument;
        return false;
    }
    let local_start: usize =
        bootstrap_semantic_enter_scope(context);
    if (local_start == bootstrap_semantic_no_id()) {
        return false;
    }
    var child: usize = node.first_child;
    while (child != bootstrap_semantic_no_id() &&
        context->error == runtime::Error.none) {
        bootstrap_semantic_lower_statement(context, child);
        child = bootstrap_semantic_node(
            context,
            context->current_unit,
            child
        ).next_sibling;
    }
    bootstrap_semantic_leave_scope(context, local_start);
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_function_body(
    context: *BootstrapSemanticContext,
    function: BootstrapSemanticFunction
) -> usize {
    if (function.implementation_unit ==
        bootstrap_semantic_no_id()) {
        return bootstrap_semantic_no_id();
    }
    let declaration: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            function.implementation_unit,
            function.implementation_node
        );
    var parameter_count: usize = 0;
    var return_node: usize = bootstrap_semantic_no_id();
    var body_node: usize = bootstrap_semantic_no_id();
    bootstrap_semantic_function_parts(
        context,
        function.implementation_unit,
        declaration,
        &parameter_count,
        &return_node,
        &body_node
    );
    return body_node;
}

fn bootstrap_semantic_add_parameter_locals(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let declaration: parser::SyntaxNode =
        bootstrap_semantic_node(
            context,
            function.implementation_unit,
            function.implementation_node
        );
    let ir_functions: *const ir::Function =
        context->ir.functions.data as
            *const ir::Function;
    let ir_function: ir::Function =
        ir_functions[function.ir_function];
    let ir_parameters: *const ir::Parameter =
        context->ir.parameters.data as
            *const ir::Parameter;
    let semantic_parameters:
        *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < function.parameter_count) {
        let parameter_node: parser::SyntaxNode =
            bootstrap_semantic_node(
                context,
                function.implementation_unit,
                child
            );
        let parameter: BootstrapSemanticParameter =
            semantic_parameters[
                function.first_parameter + index
            ];
        let ir_parameter: ir::Parameter =
            ir_parameters[
                ir_function.first_parameter + index
            ];
        bootstrap_semantic_append_local(
            context,
            {
                function_id = function_id,
                type_id = parameter.type_id,
                slot_id = ir_parameter.slot_id,
                unit_index = function.implementation_unit,
                declaration_node = child,
                name_token = parameter_node.token_index,
                scope_depth = 0,
                mutable_binding = false,
                volatile_binding = false,
                constant_binding = false,
                integer_value = 0,
            }
        );
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_lower_function(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let body_node: usize =
        bootstrap_semantic_function_body(context, function);
    if (body_node == bootstrap_semantic_no_id()) {
        return true;
    }
    // An asm fn body is raw assembly text spliced into the emitted
    // assembly by the backend; it lowers to no IR blocks at all (the
    // semantic pass already validated that it holds only string literals).
    if ((function.flags &
            (BootstrapSemanticSymbolFlag.asm_function as usize)) != 0) {
        return context->error == runtime::Error.none;
    }
    context->current_function = function_id;
    context->current_unit = function.implementation_unit;
    context->scope_depth = 0;
    context->local_count = 0;
    let cleared: bytes::BufferResult =
        bytes::clear(context->locals);
    context->locals = cleared.buffer;
    context->error = cleared.error;
    bootstrap_semantic_clear_label_state(context);
    context->break_block = bootstrap_semantic_no_id();
    context->continue_block = bootstrap_semantic_no_id();
    context->current_block =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_add_parameter_locals(
        context,
        function_id
    );
    bootstrap_semantic_lower_block(context, body_node);
    bootstrap_semantic_validate_labels(context);
    let return_record: type_info::Record =
        bootstrap_semantic_type_record(
            context,
            function.return_type
        );
    let ir_functions: *const ir::Function =
        context->ir.functions.data as
            *const ir::Function;
    let reachable: bool =
        bootstrap_semantic_block_is_reachable(
            context,
            ir_functions[function.ir_function],
            context->current_block
        );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        ) && reachable) {
        if ((function.flags &
                (BootstrapSemanticSymbolFlag.no_return as usize)) != 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.noreturn_returns,
                context->current_unit,
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    body_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                0
            );
        } else if (return_record.kind ==
            type_info::Kind.type_void) {
            let body: parser::SyntaxNode =
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    body_node
                );
            var instruction: ir::Instruction =
                bootstrap_semantic_instruction(
                    ir::Opcode.return_void,
                    body
                );
            instruction.type_id = function.return_type;
            bootstrap_semantic_emit_void(
                context,
                instruction
            );
        } else {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.missing_return,
                context->current_unit,
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    body_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                function.return_type
            );
        }
    }
    bootstrap_semantic_terminate_unreachable_blocks(
        context,
        ir_functions[function.ir_function],
        bootstrap_semantic_node(
            context,
            context->current_unit,
            body_node
        )
    );
    return context->error == runtime::Error.none;
}

fn bootstrap_semantic_lower_functions(
    context: *BootstrapSemanticContext
) -> bool {
    let order: bytes::Buffer =
        bootstrap_semantic_function_order(context);
    let ordered: *const usize =
        order.data as *const usize;
    var order_index: usize = 0;
    while (order_index < context->function_count &&
        context->error == runtime::Error.none) {
        bootstrap_semantic_lower_function(
            context,
            ordered[order_index]
        );
        order_index += 1;
    }
    let release_error: runtime::Error =
        bytes::release(order);
    if (context->error == runtime::Error.none) {
        context->error = release_error;
    }
    return context->error == runtime::Error.none;
}
