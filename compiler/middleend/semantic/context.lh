export fn bootstrap_semantic_diagnostic_get( diagnostics: BootstrapSemanticDiagnosticBuffer, index: usize ) -> BootstrapSemanticDiagnosticResult;

export fn bootstrap_semantic_add_diagnostic( context: *BootstrapSemanticContext, kind: BootstrapSemanticDiagnosticKind, unit_index: usize, span: BootstrapSourceSpan, related_unit: usize, related_span: BootstrapSourceSpan, detail: usize ) -> bool;

export fn bootstrap_semantic_result_is_success( result: BootstrapSemanticResult ) -> bool;

export fn bootstrap_semantic_release_error( current: RuntimeError, next: RuntimeError ) -> RuntimeError;

export fn bootstrap_semantic_result_release( result: BootstrapSemanticResult ) -> RuntimeError;

