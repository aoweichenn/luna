export fn bootstrap_semantic_empty_span() -> BootstrapSourceSpan;

export fn bootstrap_semantic_invalid_diagnostic() -> BootstrapSemanticDiagnostic;

export fn bootstrap_semantic_input_empty( executable: bool ) -> BootstrapSemanticInput;

export fn bootstrap_semantic_input_storage_is_valid( input: BootstrapSemanticInput ) -> bool;

export fn bootstrap_semantic_source_is_valid( source: StdTextView ) -> bool;

export fn bootstrap_semantic_unit_is_valid( unit: BootstrapSemanticUnit ) -> bool;

export fn bootstrap_semantic_input_is_valid( input: BootstrapSemanticInput ) -> bool;

