export module luna.bootstrap.middleend.semantic.context;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.middleend.type;
import luna.bootstrap.middleend.ir;

export enum BootstrapSemanticDiagnosticKind: usize {
    invalid_input,
    duplicate_interface,
    duplicate_implementation,
    unknown_import,
    self_import,
    duplicate_import,
    import_cycle,
    unreachable_module,
    duplicate_name,
    ambiguous_import,
    invalid_export,
    private_type_exposure,
    unknown_type,
    duplicate_field,
    recursive_type,
    incomplete_type,
    object_too_large,
    invalid_enum_underlying,
    invalid_type_alias,
    invalid_enum_value,
    enum_value_overflow,
    duplicate_enum_member,
    duplicate_function,
    missing_definition,
    signature_mismatch,
    invalid_external,
    duplicate_parameter,
    unknown_name,
    duplicate_local,
    immutable_assignment,
    type_mismatch,
    invalid_condition,
    invalid_operator,
    invalid_cast,
    invalid_lvalue,
    invalid_call,
    argument_count,
    invalid_initializer,
    duplicate_initializer_field,
    unknown_field,
    invalid_index,
    invalid_member,
    invalid_layout_query,
    break_outside_control,
    continue_outside_loop,
    return_type,
    missing_return,
    invalid_switch,
    duplicate_case,
    duplicate_default,
    integer_overflow,
    floating_overflow,
    resource_limit,
    internal_invariant,
    unknown_attribute,
    invalid_attribute,
    noreturn_returns,
    assertion_failed,
    invalid_assert,
    unknown_intrinsic,
    invalid_alignment,
    unaligned_field_address,
    ambiguous_field,
    invalid_flexible_member,
    invalid_bitfield,
    invalid_character,
    invalid_string,
    non_constant_expression,
    invalid_const_function,
    invalid_array_length,
    duplicate_label,
    unknown_label,
    invalid_goto,
    non_loop_label,
    invalid_variadic,
    invalid_export_name,
    invalid_va_list,
    invalid_asm_function,
    invalid_embed,
    unknown_module_qualifier,
    ambiguous_module_qualifier,
    unknown_qualified_name,
    invalid_qualified_path,
}

// path_offset/path_length name the source file (as the driver received it)
// inside the input's paths byte buffer; @file() emits those bytes.
export struct BootstrapSemanticUnit {
    source: StdTextView;
    tokens: BootstrapTokenBuffer;
    tree: BootstrapSyntaxTree;
    path_offset: usize;
    path_length: usize;
}

export struct BootstrapSemanticInput {
    units: StdByteBuffer;
    paths: StdByteBuffer;
    unit_count: usize;
    executable: bool;
}

export struct BootstrapSemanticDiagnostic {
    kind: BootstrapSemanticDiagnosticKind;
    unit_index: usize;
    span: BootstrapSourceSpan;
    related_unit: usize;
    related_span: BootstrapSourceSpan;
    detail: usize;
}

export struct BootstrapSemanticDiagnosticBuffer {
    storage: StdByteBuffer;
    count: usize;
}

export struct BootstrapSemanticResult {
    types: BootstrapTypeTable;
    ir: BootstrapTypedIr;
    diagnostics: BootstrapSemanticDiagnosticBuffer;
    error: RuntimeError;
}

export struct BootstrapSemanticDiagnosticResult {
    diagnostic: BootstrapSemanticDiagnostic;
    error: RuntimeError;
}

export enum BootstrapSemanticLimit: usize {
    maximum_size = 18446744073709551615,
    maximum_modules = 1024,
    maximum_module_depth = 256,
    maximum_diagnostics = 4096,
    maximum_scope_depth = 256,
    maximum_type_depth = 256,
    target_maximum_alignment = 8,
    maximum_attribute_alignment = 4096,
    target_maximum_object_size = 2147483647,
    maximum_floating_digits = 1200,
    maximum_floating_limbs = 128,
    floating_exponent_margin = 2048,
    maximum_const_steps = 65536,
    maximum_const_call_depth = 128,
}

export enum BootstrapSemanticSymbolKind: usize {
    named_type,
    function,
    enum_member,
    constant,
    const_function,
}

export enum BootstrapSemanticSymbolFlag: usize {
    none = 0,
    exported = 1,
    external = 2,
    interface_declaration = 4,
    no_return = 8,
    inline_hint = 16,
    constant_resolved = 32,
    constant_resolving = 64,
    enum_value_pending = 128,
    enum_values_resolving = 256,
    variadic = 512,
    asm_function = 1024,
}

export enum BootstrapSemanticLiteralFamily: usize {
    none,
    integer,
    floating,
    null_pointer,
}

export struct BootstrapSemanticModule {
    interface_unit: usize;
    implementation_unit: usize;
    name_unit: usize;
    name_node: usize;
    first_import: usize;
    import_count: usize;
    visit_state: usize;
    reachable: bool;
}

export struct BootstrapSemanticUnitInfo {
    module_id: usize;
    interface_unit: usize;
}

export struct BootstrapSemanticImport {
    owner_module: usize;
    source_unit: usize;
    declaration_node: usize;
    target_module: usize;
    interface_import: bool;
    // Token index (in source_unit) of the `as` alias, or no-id for a plain
    // import. An aliased import binds only the `<alias>::` qualifier and
    // contributes no flat names.
    alias_token: usize;
}

export struct BootstrapSemanticSymbol {
    kind: BootstrapSemanticSymbolKind;
    module_id: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    type_id: usize;
    function_id: usize;
    integer_value: u64;
    flags: usize;
}

export struct BootstrapSemanticFunction {
    symbol_id: usize;
    interface_unit: usize;
    interface_node: usize;
    implementation_unit: usize;
    implementation_node: usize;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
    ir_function: usize;
    flags: usize;
}

export struct BootstrapSemanticParameter {
    function_id: usize;
    type_id: usize;
    unit_index: usize;
    declaration_node: usize;
    name_token: usize;
}

export struct BootstrapSemanticLocal {
    function_id: usize;
    type_id: usize;
    slot_id: usize;
    unit_index: usize;
    declaration_node: usize;
    name_token: usize;
    scope_depth: usize;
    mutable_binding: bool;
    volatile_binding: bool;
    constant_binding: bool;
    integer_value: u64;
}

// A `name:` label in the function being lowered. Labels share function
// scope; first_local/local_count slice the label_locals snapshot buffer
// holding the declaration-node identity of every local live at the label.
export struct BootstrapSemanticLabel {
    name_token: usize;
    span: BootstrapSourceSpan;
    block: usize;
    first_local: usize;
    local_count: usize;
    is_loop: bool;
    defined: bool;
}

// A `goto` whose label was not yet defined when the jump was lowered; its
// live-local snapshot (in goto_locals) is validated at definition time.
export struct BootstrapSemanticPendingGoto {
    label_token: usize;
    span: BootstrapSourceSpan;
    first_local: usize;
    local_count: usize;
    resolved: bool;
}

// One enclosing loop's label on the per-function stack; labeled
// break/continue walk it to find the loop's exit/continue blocks.
export struct BootstrapSemanticLoopLabel {
    name_token: usize;
    break_block: usize;
    continue_block: usize;
}

export struct BootstrapSemanticExpression {
    type_id: usize;
    value_id: usize;
    address_id: usize;
    constant_value: u64;
    has_constant: bool;
    lvalue: bool;
    mutable_lvalue: bool;
    volatile_lvalue: bool;
    valid: bool;
    // Bit segment id when the expression accesses an @bits segment; the
    // address is the storage field's and writes go through a masking
    // read-modify-write instead of a plain store.
    bitfield_segment: usize;
}

// One `name: width` segment of an @bits attribute. Segments are sema-level
// metadata keyed by the storage field's declaration; IR and codegen never
// see them because access lowers to shift/mask on the storage field.
export struct BootstrapSemanticBitfieldSegment {
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    bit_offset: usize;
    bit_width: usize;
}

export struct BootstrapSemanticBigUnsigned {
    limbs: [128]u64;
    count: usize;
}

export struct BootstrapSemanticSignedMagnitude {
    magnitude: usize;
    negative: bool;
}

export struct BootstrapSemanticDecimalFloating {
    coefficient: BootstrapSemanticBigUnsigned;
    five_power: BootstrapSemanticBigUnsigned;
    decimal_exponent: isize;
    truncated_nonzero: bool;
}

export struct BootstrapSemanticAlignmentOverride {
    declaration_unit: usize;
    declaration_node: usize;
    alignment: usize;
}

// A `const fn` declaration: evaluator-only, never lowered to IR. Parameters
// reuse the shared parameter buffer (with function_id set to no-id so regular
// duplicate detection never matches them); the symbol's function_id indexes
// this table.
export struct BootstrapSemanticConstFunction {
    symbol_id: usize;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
}

// One live binding of the const-function interpreter. The stack is shared by
// every active call frame; frames truncate it on exit.
export struct BootstrapSemanticConstLocal {
    unit_index: usize;
    name_token: usize;
    type_id: usize;
    value: u64;
    is_boolean: bool;
    mutable_binding: bool;
}

// Cached constant value of an array length expression, filled by the consteval
// prescan so type resolution (which cannot import consteval) can read it.
export struct BootstrapSemanticArrayLength {
    unit_index: usize;
    node_index: usize;
    value: u64;
    valid: bool;
}

export struct BootstrapSemanticContext {
    input: BootstrapSemanticInput;
    units: StdByteBuffer;
    unit_count: usize;
    modules: StdByteBuffer;
    module_count: usize;
    imports: StdByteBuffer;
    import_count: usize;
    symbols: StdByteBuffer;
    symbol_count: usize;
    functions: StdByteBuffer;
    function_count: usize;
    parameters: StdByteBuffer;
    parameter_count: usize;
    locals: StdByteBuffer;
    local_count: usize;
    alignment_overrides: StdByteBuffer;
    alignment_override_count: usize;
    bitfield_segments: StdByteBuffer;
    bitfield_segment_count: usize;
    const_functions: StdByteBuffer;
    const_function_count: usize;
    const_locals: StdByteBuffer;
    const_local_count: usize;
    array_lengths: StdByteBuffer;
    array_length_count: usize;
    labels: StdByteBuffer;
    label_count: usize;
    label_locals: StdByteBuffer;
    pending_gotos: StdByteBuffer;
    pending_goto_count: usize;
    goto_locals: StdByteBuffer;
    loop_labels: StdByteBuffer;
    loop_label_count: usize;
    pending_loop_label: usize;
    const_call_depth: usize;
    const_steps: usize;
    types: BootstrapTypeTable;
    ir: BootstrapTypedIr;
    diagnostics: BootstrapSemanticDiagnosticBuffer;
    error: RuntimeError;
    current_function: usize;
    current_unit: usize;
    current_block: usize;
    scope_depth: usize;
    type_depth: usize;
    break_block: usize;
    continue_block: usize;
}

