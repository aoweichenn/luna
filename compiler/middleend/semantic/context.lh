export fn bootstrap_semantic_find_module_symbol( context: *BootstrapSemanticContext, unit_index: usize, module_id: usize, name_token: usize, kind: BootstrapSemanticSymbolKind ) -> usize;

export fn bootstrap_semantic_lookup_qualified_symbol( context: *BootstrapSemanticContext, unit_index: usize, node: BootstrapSyntaxNode, kind: BootstrapSemanticSymbolKind, diagnose: bool ) -> usize;

