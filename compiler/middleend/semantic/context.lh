export fn bootstrap_semantic_token( context: *BootstrapSemanticContext, unit_index: usize, token_index: usize ) -> BootstrapToken;

export fn bootstrap_semantic_text_equal( context: *BootstrapSemanticContext, left_unit: usize, left_span: BootstrapSourceSpan, right_unit: usize, right_span: BootstrapSourceSpan ) -> bool;

