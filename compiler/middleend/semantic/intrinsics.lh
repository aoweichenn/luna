export module luna.bootstrap.middleend.semantic.intrinsics;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.middleend.type;
import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.semantic.context;
import luna.bootstrap.middleend.semantic.types;

export enum BootstrapIntrinsicOperandClass: usize {
    none,
    integer_scalar,
    integer_scalar_rotated,
    integer_scalar_wide,
    float_scalar,
    float_scalar_binary,
    integer_overflow,
    embedded_file,
}

export enum BootstrapIntrinsicLowering: usize {
    source_file, source_line,
    count_leading_zeros, count_trailing_zeros, population_count, rotate_left, rotate_right, byte_swap,
    float_square_root, float_floor, float_ceiling, float_truncate, float_round, float_minimum, float_maximum,
    float_absolute, overflow_add, overflow_subtract, overflow_multiply,
    embed,
}

export struct BootstrapIntrinsicEntry {
    name: *const u8;
    name_length: usize;
    arity: usize;
    operand_class: BootstrapIntrinsicOperandClass;
    lowering: BootstrapIntrinsicLowering;
}

export fn bootstrap_semantic_intrinsic_entry(index: usize) -> BootstrapIntrinsicEntry;

export fn bootstrap_semantic_intrinsic_resolve( context: *BootstrapSemanticContext, node: BootstrapSyntaxNode ) -> usize;

export fn bootstrap_semantic_lower_intrinsic( context: *BootstrapSemanticContext, node: BootstrapSyntaxNode, intrinsic_index: usize, operand: BootstrapSemanticExpression, count: BootstrapSemanticExpression, destination: BootstrapSemanticExpression ) -> BootstrapSemanticExpression;
