module luna.bootstrap.middleend.semantic.consteval;

fn bootstrap_const_integer(
    value: u64
) -> BootstrapConstValue {
    return {
        is_constant = true, is_boolean = false, value = value,
        error = false,
    };
}

fn bootstrap_const_boolean(
    value: bool
) -> BootstrapConstValue {
    var result: BootstrapConstValue = {
        is_constant = true, is_boolean = true, value = 0,
        error = false,
    };
    if (value) {
        result.value = 1;
    }
    return result;
}

fn bootstrap_const_not_constant() -> BootstrapConstValue {
    return {
        is_constant = false, is_boolean = false, value = 0,
        error = false,
    };
}

fn bootstrap_const_error() -> BootstrapConstValue {
    return {
        is_constant = false, is_boolean = false, value = 0,
        error = true,
    };
}

fn bootstrap_const_eval_enum_member(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    if (node.child_count != 2) {
        return bootstrap_const_not_constant();
    }
    let owner_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, node.first_child
        );
    let member_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, owner_node.next_sibling
        );
    if (owner_node.kind !=
            BootstrapSyntaxKind.name_expression ||
        member_node.kind !=
            BootstrapSyntaxKind.name_expression) {
        return bootstrap_const_not_constant();
    }
    let type_symbol: usize = bootstrap_semantic_lookup_symbol(
        context,
        unit_index,
        owner_node.token_index,
        BootstrapSemanticSymbolKind.named_type
    );
    if (type_symbol == bootstrap_semantic_no_id()) {
        return bootstrap_const_not_constant();
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var type_id: usize = symbols[type_symbol].type_id;
    let alias_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (alias_record.kind == BootstrapTypeKind.alias &&
        bootstrap_semantic_require_complete_type(
            context, type_id
        )) {
        type_id = bootstrap_semantic_type_record(
            context, type_id
        ).element_type;
    }
    if (bootstrap_semantic_type_record(
            context, type_id
        ).kind != BootstrapTypeKind.enumeration ||
        !bootstrap_semantic_require_complete_type(
            context, type_id
        )) {
        return bootstrap_const_not_constant();
    }
    let member_symbol: usize =
        bootstrap_semantic_find_enum_member(
            context,
            type_id,
            unit_index,
            member_node.token_index
        );
    if (member_symbol == bootstrap_semantic_no_id()) {
        return bootstrap_const_not_constant();
    }
    // require_complete_type may have appended member symbols, so take a
    // fresh pointer before reading them.
    let resolved_symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    if ((resolved_symbols[member_symbol].flags &
            (BootstrapSemanticSymbolFlag.enum_value_pending as
                usize)) == 0) {
        return bootstrap_const_integer(
            resolved_symbols[member_symbol].integer_value
        );
    }
    if (!bootstrap_semantic_resolve_enum_constant_values(
            context, type_id
        )) {
        return bootstrap_const_error();
    }
    let folded: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    if ((folded[member_symbol].flags &
            (BootstrapSemanticSymbolFlag.enum_value_pending as
                usize)) != 0) {
        return bootstrap_const_error();
    }
    return bootstrap_const_integer(
        folded[member_symbol].integer_value
    );
}

fn bootstrap_const_eval_name(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    let none: usize = bootstrap_semantic_no_id();
    if (context->const_call_depth > 0) {
        let slot: usize = bootstrap_const_env_find(
            context, unit_index, node.token_index
        );
        if (slot != none) {
            let bindings: *const BootstrapSemanticConstLocal =
                context->const_locals.data as
                    *const BootstrapSemanticConstLocal;
            let binding: BootstrapSemanticConstLocal = bindings[slot];
            if (binding.is_boolean) {
                return bootstrap_const_boolean(binding.value != 0);
            }
            return bootstrap_const_integer(binding.value);
        }
    }
    let local_id: usize = bootstrap_semantic_find_local(
        context, unit_index, node.token_index
    );
    if (local_id != none) {
        let locals: *const BootstrapSemanticLocal =
            context->locals.data as *const BootstrapSemanticLocal;
        let local: BootstrapSemanticLocal = locals[local_id];
        if (!local.constant_binding) {
            return bootstrap_const_not_constant();
        }
        if (local.type_id ==
            (BootstrapBuiltinType.boolean as usize)) {
            return bootstrap_const_boolean(local.integer_value != 0);
        }
        return bootstrap_const_integer(local.integer_value);
    }
    let symbol_id: usize = bootstrap_semantic_lookup_symbol(
        context,
        unit_index,
        node.token_index,
        BootstrapSemanticSymbolKind.constant
    );
    if (symbol_id == none) {
        return bootstrap_const_not_constant();
    }
    var symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    var symbol: BootstrapSemanticSymbol = symbols[symbol_id];
    if ((symbol.flags &
            (BootstrapSemanticSymbolFlag.constant_resolved as
                usize)) == 0) {
        // Resolve the initializer on demand so constants declared anywhere
        // (including later passes' feeding sites) are visible here.
        if (!bootstrap_semantic_resolve_constant(context, symbol_id)) {
            return bootstrap_const_not_constant();
        }
        symbols = context->symbols.data as
            *const BootstrapSemanticSymbol;
        symbol = symbols[symbol_id];
    }
    if (symbol.type_id == (BootstrapBuiltinType.boolean as usize)) {
        return bootstrap_const_boolean(symbol.integer_value != 0);
    }
    return bootstrap_const_integer(symbol.integer_value);
}

fn bootstrap_const_eval_unary(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    if (node.child_count != 1) {
        return bootstrap_const_not_constant();
    }
    let operation: BootstrapTokenKind =
        bootstrap_semantic_token(
            context, unit_index, node.token_index
        ).kind;
    let operand: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, node.first_child
        );
    if (!operand.is_constant || operand.error) {
        return operand;
    }
    if (operation == BootstrapTokenKind.minus) {
        return bootstrap_const_integer(
            (0 as u64) - operand.value
        );
    }
    if (operation == BootstrapTokenKind.tilde) {
        return bootstrap_const_integer(~(operand.value));
    }
    if (operation == BootstrapTokenKind.bang) {
        if (!operand.is_boolean) {
            return bootstrap_const_error();
        }
        return bootstrap_const_boolean(operand.value == 0);
    }
    return bootstrap_const_not_constant();
}

fn bootstrap_const_eval_logical(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    left_index: usize,
    right_index: usize,
    operation: BootstrapTokenKind
) -> BootstrapConstValue {
    let left: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, left_index
        );
    if (!left.is_constant || left.error) {
        return left;
    }
    if (!left.is_boolean) {
        return bootstrap_const_error();
    }
    if (operation == BootstrapTokenKind.logical_and &&
        left.value == 0) {
        return bootstrap_const_boolean(false);
    }
    if (operation == BootstrapTokenKind.logical_or &&
        left.value != 0) {
        return bootstrap_const_boolean(true);
    }
    let right: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, right_index
        );
    if (!right.is_constant || right.error) {
        return right;
    }
    if (!right.is_boolean) {
        return bootstrap_const_error();
    }
    return bootstrap_const_boolean(right.value != 0);
}

fn bootstrap_const_eval_binary(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    if (node.child_count != 2) {
        return bootstrap_const_not_constant();
    }
    let operation: BootstrapTokenKind =
        bootstrap_semantic_token(
            context, unit_index, node.token_index
        ).kind;
    let left_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, node.first_child
        );
    let right_index: usize = left_node.next_sibling;
    if (operation == BootstrapTokenKind.logical_and ||
        operation == BootstrapTokenKind.logical_or) {
        return bootstrap_const_eval_logical(
            context,
            unit_index,
            node.first_child,
            right_index,
            operation
        );
    }
    let left: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, node.first_child
        );
    if (!left.is_constant || left.error) {
        return left;
    }
    let right: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, right_index
        );
    if (!right.is_constant || right.error) {
        return right;
    }
    if (operation == BootstrapTokenKind.plus) {
        return bootstrap_const_integer(
            left.value + right.value
        );
    }
    if (operation == BootstrapTokenKind.minus) {
        return bootstrap_const_integer(
            left.value - right.value
        );
    }
    if (operation == BootstrapTokenKind.star) {
        return bootstrap_const_integer(
            left.value * right.value
        );
    }
    if (operation == BootstrapTokenKind.slash ||
        operation == BootstrapTokenKind.percent) {
        if (right.value == 0) {
            return bootstrap_const_error();
        }
        let dividend: i64 = left.value as i64;
        let divisor: i64 = right.value as i64;
        if (divisor == -1 &&
            left.value == ((1 as u64) << 63)) {
            return bootstrap_const_error();
        }
        if (operation == BootstrapTokenKind.slash) {
            return bootstrap_const_integer(
                (dividend / divisor) as u64
            );
        }
        return bootstrap_const_integer(
            (dividend % divisor) as u64
        );
    }
    if (operation == BootstrapTokenKind.shift_left ||
        operation == BootstrapTokenKind.shift_right) {
        if (right.value >= 64) {
            return bootstrap_const_error();
        }
        if (operation == BootstrapTokenKind.shift_left) {
            return bootstrap_const_integer(
                left.value << right.value
            );
        }
        var shifted: u64 = left.value >> right.value;
        if (right.value != 0 &&
            (left.value & ((1 as u64) << 63)) != 0) {
            shifted = shifted |
                ~((~((0 as u64))) >> right.value);
        }
        return bootstrap_const_integer(shifted);
    }
    if (operation == BootstrapTokenKind.ampersand) {
        return bootstrap_const_integer(
            left.value & right.value
        );
    }
    if (operation == BootstrapTokenKind.pipe) {
        return bootstrap_const_integer(
            left.value | right.value
        );
    }
    if (operation == BootstrapTokenKind.caret) {
        return bootstrap_const_integer(
            left.value ^ right.value
        );
    }
    if (operation == BootstrapTokenKind.equal_equal) {
        return bootstrap_const_boolean(
            left.value == right.value
        );
    }
    if (operation == BootstrapTokenKind.bang_equal) {
        return bootstrap_const_boolean(
            left.value != right.value
        );
    }
    if (operation == BootstrapTokenKind.less) {
        return bootstrap_const_boolean(
            (left.value as i64) < (right.value as i64)
        );
    }
    if (operation == BootstrapTokenKind.less_equal) {
        return bootstrap_const_boolean(
            (left.value as i64) <= (right.value as i64)
        );
    }
    if (operation == BootstrapTokenKind.greater) {
        return bootstrap_const_boolean(
            (left.value as i64) > (right.value as i64)
        );
    }
    if (operation == BootstrapTokenKind.greater_equal) {
        return bootstrap_const_boolean(
            (left.value as i64) >= (right.value as i64)
        );
    }
    return bootstrap_const_not_constant();
}

fn bootstrap_const_eval_conditional(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    if (node.child_count != 3) {
        return bootstrap_const_not_constant();
    }
    let condition_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, node.first_child
        );
    let then_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, condition_node.next_sibling
        );
    let condition: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, node.first_child
        );
    if (!condition.is_constant || condition.error) {
        return condition;
    }
    if (!condition.is_boolean) {
        return bootstrap_const_error();
    }
    if (condition.value != 0) {
        return bootstrap_consteval_expression(
            context, unit_index, condition_node.next_sibling
        );
    }
    return bootstrap_consteval_expression(
        context, unit_index, then_node.next_sibling
    );
}

fn bootstrap_const_eval_layout_query(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    if (node.child_count == 0) {
        return bootstrap_const_error();
    }
    let type_id: usize =
        bootstrap_semantic_resolve_type_node(
            context, unit_index, node.first_child
        );
    if (type_id == bootstrap_semantic_no_id() ||
        !bootstrap_semantic_require_complete_type(
            context, type_id
        )) {
        return bootstrap_const_error();
    }
    let record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (record.kind == BootstrapTypeKind.type_void ||
        record.size_bytes == 0 ||
        record.alignment_bytes == 0) {
        return bootstrap_const_error();
    }
    var value: usize = 0;
    if (node.kind == BootstrapSyntaxKind.sizeof_expression) {
        value = record.size_bytes;
    } else if (node.kind ==
        BootstrapSyntaxKind.alignof_expression) {
        value = record.alignment_bytes;
    } else if (node.kind ==
            BootstrapSyntaxKind.offsetof_expression &&
        node.child_count >= 2) {
        let type_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context, unit_index, node.first_child
            );
        let fields: *const BootstrapTypeField =
            context->types.fields.data as
                *const BootstrapTypeField;
        var current_type: usize = type_id;
        var member_index: usize = type_node.next_sibling;
        while (member_index != bootstrap_semantic_no_id()) {
            let member: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context, unit_index, member_index
                );
            let lookup: BootstrapSemanticFieldLookup =
                bootstrap_semantic_lookup_field(
                    context,
                    current_type,
                    unit_index,
                    member.token_index
                );
            if (lookup.status != BootstrapSemanticFieldStatus.found) {
                return bootstrap_const_error();
            }
            value += lookup.offset_bytes;
            current_type = fields[lookup.field_id].type_id;
            member_index = member.next_sibling;
        }
    } else {
        return bootstrap_const_error();
    }
    return bootstrap_const_integer(value as u64);
}

fn bootstrap_const_eval_cast(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    if (node.child_count != 2) {
        return bootstrap_const_not_constant();
    }
    let operand_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, node.first_child
        );
    let target_type: usize =
        bootstrap_semantic_resolve_type_node(
            context, unit_index, operand_node.next_sibling
        );
    if (target_type == bootstrap_semantic_no_id()) {
        return bootstrap_const_error();
    }
    let operand: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, node.first_child
        );
    if (!operand.is_constant || operand.error) {
        return operand;
    }
    let target_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, target_type);
    if (!bootstrap_type_is_integer(target_record.kind)) {
        return bootstrap_const_not_constant();
    }
    let width: usize =
        bootstrap_type_bit_width(target_record.kind);
    var value: u64 =
        bootstrap_semantic_mask_integer(operand.value, width);
    if (width < 64 &&
        bootstrap_type_is_signed_integer(target_record.kind) &&
        (value & ((1 as u64) << ((width - 1) as u64))) != 0) {
        value = value | ~(((1 as u64) << (width as u64)) - 1);
    }
    return bootstrap_const_integer(value);
}

// ---------------------------------------------------------------------------
// const fn interpreter
//
// A `const fn` call whose arguments are all constant is evaluated by
// tree-walking the callee body with a parameter environment. Environment
// entries share the BootstrapConstValue currency (u64 value + boolean flag)
// and live on a single stack in the context; each call frame records the
// stack base and truncates on exit. Evaluation is bounded by a per-top-level
// -call step budget (statements + expression nodes) and a call depth cap;
// hitting either makes the call non-constant, and the use site diagnoses.

struct BootstrapConstExec {
    valid: bool;
    returned: bool;
    is_boolean: bool;
    value: u64;
}

fn bootstrap_const_exec_invalid() -> BootstrapConstExec {
    return {
        valid = false, returned = false, is_boolean = false, value = 0,
    };
}

fn bootstrap_const_exec_continue() -> BootstrapConstExec {
    return {
        valid = true, returned = false, is_boolean = false, value = 0,
    };
}

fn bootstrap_const_exec_return(
    value: BootstrapConstValue
) -> BootstrapConstExec {
    return {
        valid = true, returned = true, is_boolean = value.is_boolean,
        value = value.value,
    };
}

fn bootstrap_const_step(
    context: *BootstrapSemanticContext
) -> bool {
    if (context->const_steps == 0) {
        return false;
    }
    context->const_steps -= 1;
    return true;
}

fn bootstrap_const_env_find(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_token: usize
) -> usize {
    let bindings: *const BootstrapSemanticConstLocal =
        context->const_locals.data as
            *const BootstrapSemanticConstLocal;
    var index: usize = context->const_local_count;
    while (index > 0) {
        index -= 1;
        if (bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                bindings[index].unit_index,
                bindings[index].name_token
            )) {
            return index;
        }
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_const_env_push(
    context: *BootstrapSemanticContext,
    binding: BootstrapSemanticConstLocal
) -> bool {
    if (!bootstrap_semantic_append_record(
            context,
            &context->const_locals,
            (&binding) as
                *const BootstrapSemanticConstLocal as *const u8,
            sizeof(BootstrapSemanticConstLocal)
        )) {
        return false;
    }
    context->const_local_count += 1;
    return true;
}

// Frame/block teardown: the buffer must shrink with the watermark so the
// context storage invariant (count == length / sizeof) keeps holding.
fn bootstrap_const_env_truncate(
    context: *BootstrapSemanticContext,
    base: usize
) -> bool {
    let truncated: StdByteBufferResult =
        std_byte_buffer_truncate(
            context->const_locals,
            base * sizeof(BootstrapSemanticConstLocal)
        );
    context->const_locals = truncated.buffer;
    if (truncated.error != RuntimeError.none) {
        context->error = truncated.error;
        return false;
    }
    context->const_local_count = base;
    return true;
}

// Unwraps aliases; the result is BootstrapTypeKind.invalid unless the type
// resolves to an integer scalar or bool.
fn bootstrap_const_scalar_kind(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> BootstrapTypeKind {
    var record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (record.kind == BootstrapTypeKind.alias &&
        bootstrap_semantic_require_complete_type(context, type_id)) {
        record = bootstrap_semantic_type_record(
            context, record.element_type
        );
    }
    if (!bootstrap_type_is_integer(record.kind) &&
        record.kind != BootstrapTypeKind.boolean) {
        return BootstrapTypeKind.invalid;
    }
    return record.kind;
}

fn bootstrap_const_narrow_value(
    kind: BootstrapTypeKind,
    value: u64
) -> u64 {
    let width: usize = bootstrap_type_bit_width(kind);
    var narrowed: u64 =
        bootstrap_semantic_mask_integer(value, width);
    if (width < 64 &&
        bootstrap_type_is_signed_integer(kind) &&
        (narrowed & ((1 as u64) << ((width - 1) as u64))) != 0) {
        narrowed = narrowed |
            ~(((1 as u64) << (width as u64)) - 1);
    }
    return narrowed;
}

fn bootstrap_const_exec_block(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    block_index: usize
) -> BootstrapConstExec {
    let scope_base: usize = context->const_local_count;
    var result: BootstrapConstExec =
        bootstrap_const_exec_continue();
    var child: usize = bootstrap_semantic_node(
        context, unit_index, block_index
    ).first_child;
    while (child != bootstrap_semantic_no_id() &&
        result.valid && !result.returned &&
        context->error == RuntimeError.none) {
        result = bootstrap_const_exec_statement(
            context, unit_index, child
        );
        child = bootstrap_semantic_node(
            context, unit_index, child
        ).next_sibling;
    }
    if (!bootstrap_const_env_truncate(context, scope_base)) {
        return bootstrap_const_exec_invalid();
    }
    return result;
}

fn bootstrap_const_exec_statement(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> BootstrapConstExec {
    if (!bootstrap_const_step(context)) {
        return bootstrap_const_exec_invalid();
    }
    let node: BootstrapSyntaxNode = bootstrap_semantic_node(
        context, unit_index, node_index
    );
    if (node.kind == BootstrapSyntaxKind.block_statement) {
        return bootstrap_const_exec_block(
            context, unit_index, node_index
        );
    }
    if (node.kind == BootstrapSyntaxKind.variable_declaration ||
        node.kind == BootstrapSyntaxKind.const_declaration) {
        if (node.child_count != 2) {
            return bootstrap_const_exec_invalid();
        }
        let type_id: usize =
            bootstrap_semantic_resolve_type_node(
                context, unit_index, node.first_child
            );
        if (type_id == bootstrap_semantic_no_id()) {
            return bootstrap_const_exec_invalid();
        }
        let kind: BootstrapTypeKind =
            bootstrap_const_scalar_kind(context, type_id);
        if (kind == BootstrapTypeKind.invalid) {
            return bootstrap_const_exec_invalid();
        }
        let initializer_id: usize = bootstrap_semantic_node(
            context, unit_index, node.first_child
        ).next_sibling;
        let value: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, initializer_id
            );
        if (!value.is_constant || value.error) {
            return bootstrap_const_exec_invalid();
        }
        let is_boolean: bool =
            kind == BootstrapTypeKind.boolean;
        if (value.is_boolean != is_boolean ||
            (!is_boolean &&
                !bootstrap_semantic_const_integer_fits(
                    kind, value.value
                ))) {
            return bootstrap_const_exec_invalid();
        }
        var stored: u64 = 0;
        if (value.value != 0) {
            stored = 1;
        }
        if (!is_boolean) {
            stored = bootstrap_const_narrow_value(
                kind, value.value
            );
        }
        if (!bootstrap_const_env_push(
                context,
                {
                    unit_index = unit_index,
                    name_token = node.token_index,
                    type_id = type_id,
                    value = stored,
                    is_boolean = is_boolean,
                    mutable_binding = (node.flags &
                        (BootstrapSyntaxFlag.mutable_binding as
                            usize)) != 0,
                }
            )) {
            return bootstrap_const_exec_invalid();
        }
        return bootstrap_const_exec_continue();
    }
    if (node.kind == BootstrapSyntaxKind.assignment_statement) {
        if (node.child_count != 2 ||
            bootstrap_semantic_token(
                context, unit_index, node.token_index
            ).kind != BootstrapTokenKind.equal) {
            return bootstrap_const_exec_invalid();
        }
        let target: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context, unit_index, node.first_child
            );
        if (target.kind != BootstrapSyntaxKind.name_expression) {
            return bootstrap_const_exec_invalid();
        }
        let slot: usize = bootstrap_const_env_find(
            context, unit_index, target.token_index
        );
        if (slot == bootstrap_semantic_no_id()) {
            return bootstrap_const_exec_invalid();
        }
        let value_id: usize = target.next_sibling;
        let value: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, value_id
            );
        if (!value.is_constant || value.error) {
            return bootstrap_const_exec_invalid();
        }
        // Nested calls may have grown the binding stack; take a fresh
        // pointer before mutating.
        let bindings: *BootstrapSemanticConstLocal =
            context->const_locals.data as
                *BootstrapSemanticConstLocal;
        let kind: BootstrapTypeKind =
            bootstrap_const_scalar_kind(
                context, bindings[slot].type_id
            );
        if (kind == BootstrapTypeKind.invalid ||
            !bindings[slot].mutable_binding ||
            bindings[slot].is_boolean != value.is_boolean ||
            (!value.is_boolean &&
                !bootstrap_semantic_const_integer_fits(
                    kind, value.value
                ))) {
            return bootstrap_const_exec_invalid();
        }
        var stored: u64 = 0;
        if (value.value != 0) {
            stored = 1;
        }
        if (!value.is_boolean) {
            stored = bootstrap_const_narrow_value(
                kind, value.value
            );
        }
        bindings[slot].value = stored;
        return bootstrap_const_exec_continue();
    }
    if (node.kind == BootstrapSyntaxKind.expression_statement) {
        if (node.child_count != 1) {
            return bootstrap_const_exec_invalid();
        }
        let value: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, node.first_child
            );
        if (!value.is_constant || value.error) {
            return bootstrap_const_exec_invalid();
        }
        return bootstrap_const_exec_continue();
    }
    if (node.kind == BootstrapSyntaxKind.if_statement) {
        if (node.child_count < 2 || node.child_count > 3) {
            return bootstrap_const_exec_invalid();
        }
        let condition: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, node.first_child
            );
        if (!condition.is_constant || condition.error ||
            !condition.is_boolean) {
            return bootstrap_const_exec_invalid();
        }
        let then_id: usize = bootstrap_semantic_node(
            context, unit_index, node.first_child
        ).next_sibling;
        if (condition.value != 0) {
            return bootstrap_const_exec_statement(
                context, unit_index, then_id
            );
        }
        if (node.child_count == 3) {
            return bootstrap_const_exec_statement(
                context,
                unit_index,
                bootstrap_semantic_node(
                    context, unit_index, then_id
                ).next_sibling
            );
        }
        return bootstrap_const_exec_continue();
    }
    if (node.kind == BootstrapSyntaxKind.return_statement) {
        if (node.child_count != 1) {
            return bootstrap_const_exec_invalid();
        }
        let value: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, node.first_child
            );
        if (!value.is_constant || value.error) {
            return bootstrap_const_exec_invalid();
        }
        return bootstrap_const_exec_return(value);
    }
    return bootstrap_const_exec_invalid();
}

fn bootstrap_const_eval_call(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node: BootstrapSyntaxNode
) -> BootstrapConstValue {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count == 0) {
        return bootstrap_const_not_constant();
    }
    let callee: BootstrapSyntaxNode = bootstrap_semantic_node(
        context, unit_index, node.first_child
    );
    if (callee.kind != BootstrapSyntaxKind.name_expression ||
        bootstrap_const_env_find(
            context, unit_index, callee.token_index
        ) != none) {
        return bootstrap_const_not_constant();
    }
    let symbol_id: usize = bootstrap_semantic_lookup_symbol(
        context,
        unit_index,
        callee.token_index,
        BootstrapSemanticSymbolKind.const_function
    );
    if (symbol_id == none ||
        context->const_call_depth >=
            BootstrapSemanticLimit.maximum_const_call_depth as
                usize) {
        return bootstrap_const_not_constant();
    }
    if (context->const_call_depth == 0) {
        context->const_steps =
            BootstrapSemanticLimit.maximum_const_steps as usize;
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
    let const_functions: *const BootstrapSemanticConstFunction =
        context->const_functions.data as
            *const BootstrapSemanticConstFunction;
    let record: BootstrapSemanticConstFunction =
        const_functions[symbol.function_id];
    if (node.child_count - 1 != record.parameter_count) {
        return bootstrap_const_not_constant();
    }
    let body_unit: usize = symbol.declaration_unit;
    var body_id: usize = none;
    var child: usize = bootstrap_semantic_node(
        context, body_unit, symbol.declaration_node
    ).first_child;
    while (child != none) {
        let part: BootstrapSyntaxNode = bootstrap_semantic_node(
            context, body_unit, child
        );
        if (part.kind == BootstrapSyntaxKind.block_statement) {
            body_id = child;
        }
        child = part.next_sibling;
    }
    if (body_id == none) {
        return bootstrap_const_not_constant();
    }
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    let frame_base: usize = context->const_local_count;
    var argument_id: usize = callee.next_sibling;
    var index: usize = 0;
    var arguments_ok: bool = true;
    while (index < record.parameter_count && arguments_ok) {
        let parameter: BootstrapSemanticParameter =
            parameters[record.first_parameter + index];
        let kind: BootstrapTypeKind =
            bootstrap_const_scalar_kind(context, parameter.type_id);
        let value: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, argument_id
            );
        let is_boolean: bool =
            kind == BootstrapTypeKind.boolean;
        if (kind == BootstrapTypeKind.invalid ||
            !value.is_constant || value.error ||
            value.is_boolean != is_boolean ||
            (!is_boolean &&
                !bootstrap_semantic_const_integer_fits(
                    kind, value.value
                ))) {
            arguments_ok = false;
            break;
        }
        var stored: u64 = 0;
        if (value.value != 0) {
            stored = 1;
        }
        if (!is_boolean) {
            stored = bootstrap_const_narrow_value(
                kind, value.value
            );
        }
        arguments_ok = bootstrap_const_env_push(
            context,
            {
                unit_index = body_unit,
                name_token = parameter.name_token,
                type_id = parameter.type_id,
                value = stored,
                is_boolean = is_boolean,
                mutable_binding = false,
            }
        );
        argument_id = bootstrap_semantic_node(
            context, unit_index, argument_id
        ).next_sibling;
        index += 1;
    }
    var result: BootstrapConstExec =
        bootstrap_const_exec_invalid();
    if (arguments_ok) {
        context->const_call_depth += 1;
        result = bootstrap_const_exec_block(
            context, body_unit, body_id
        );
        context->const_call_depth -= 1;
    }
    if (!bootstrap_const_env_truncate(context, frame_base)) {
        return bootstrap_const_not_constant();
    }
    if (!result.valid || !result.returned) {
        return bootstrap_const_not_constant();
    }
    let return_kind: BootstrapTypeKind =
        bootstrap_const_scalar_kind(context, record.return_type);
    let return_boolean: bool =
        return_kind == BootstrapTypeKind.boolean;
    if (return_kind == BootstrapTypeKind.invalid ||
        result.is_boolean != return_boolean ||
        (!return_boolean &&
            !bootstrap_semantic_const_integer_fits(
                return_kind, result.value
            ))) {
        return bootstrap_const_not_constant();
    }
    if (return_boolean) {
        return bootstrap_const_boolean(result.value != 0);
    }
    return bootstrap_const_integer(result.value);
}

fn bootstrap_consteval_expression(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> BootstrapConstValue {
    if (context->const_call_depth > 0 &&
        !bootstrap_const_step(context)) {
        return bootstrap_const_not_constant();
    }
    let node: BootstrapSyntaxNode = bootstrap_semantic_node(
        context, unit_index, node_index
    );
    if (node.kind == BootstrapSyntaxKind.integer_expression) {
        var value: u64 = 0;
        if (!bootstrap_semantic_parse_unsigned(
                context, unit_index, node.token_index, &value
            )) {
            return bootstrap_const_error();
        }
        return bootstrap_const_integer(value);
    }
    if (node.kind == BootstrapSyntaxKind.character_expression) {
        var value: u64 = 0;
        if (!bootstrap_semantic_decode_character(
                context, unit_index, node.token_index, &value
            )) {
            return bootstrap_const_error();
        }
        return bootstrap_const_integer(value);
    }
    if (node.kind == BootstrapSyntaxKind.boolean_expression) {
        return bootstrap_const_boolean(
            bootstrap_semantic_token(
                context, unit_index, node.token_index
            ).kind == BootstrapTokenKind.keyword_true
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.parenthesized_expression) {
        if (node.child_count != 1) {
            return bootstrap_const_not_constant();
        }
        return bootstrap_consteval_expression(
            context, unit_index, node.first_child
        );
    }
    if (node.kind == BootstrapSyntaxKind.member_expression) {
        return bootstrap_const_eval_enum_member(
            context, unit_index, node
        );
    }
    if (node.kind == BootstrapSyntaxKind.name_expression) {
        return bootstrap_const_eval_name(
            context, unit_index, node
        );
    }
    if (node.kind == BootstrapSyntaxKind.unary_expression) {
        return bootstrap_const_eval_unary(
            context, unit_index, node
        );
    }
    if (node.kind == BootstrapSyntaxKind.binary_expression) {
        return bootstrap_const_eval_binary(
            context, unit_index, node
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.conditional_expression) {
        return bootstrap_const_eval_conditional(
            context, unit_index, node
        );
    }
    if (node.kind == BootstrapSyntaxKind.sizeof_expression ||
        node.kind == BootstrapSyntaxKind.alignof_expression ||
        node.kind ==
            BootstrapSyntaxKind.offsetof_expression) {
        return bootstrap_const_eval_layout_query(
            context, unit_index, node
        );
    }
    if (node.kind == BootstrapSyntaxKind.cast_expression) {
        return bootstrap_const_eval_cast(
            context, unit_index, node
        );
    }
    if (node.kind == BootstrapSyntaxKind.call_expression) {
        return bootstrap_const_eval_call(
            context, unit_index, node
        );
    }
    return bootstrap_const_not_constant();
}

fn bootstrap_semantic_alignment_value_is_valid(
    value: u64
) -> bool {
    return value != 0 &&
        value <=
            BootstrapSemanticLimit.maximum_attribute_alignment as
                usize as u64 &&
        (value & (value - 1)) == 0;
}

fn bootstrap_semantic_declaration_alignment(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration_node: usize
) -> BootstrapSemanticAlignment {
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context, unit_index, declaration_node
        );
    let argument: usize =
        bootstrap_semantic_declaration_attribute_argument(
            context,
            unit_index,
            declaration,
            BootstrapSemanticAttribute.align
        );
    if (argument == bootstrap_semantic_no_id()) {
        return {
            alignment = 0, valid = true,
        };
    }
    let argument_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(context, unit_index, argument);
    let value: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, argument
        );
    if (value.error || !value.is_constant || value.is_boolean ||
        !bootstrap_semantic_alignment_value_is_valid(
            value.value
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_alignment,
            unit_index,
            argument_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            declaration_node
        );
        return {
            alignment = 0, valid = false,
        };
    }
    return {
        alignment = value.value as usize, valid = true,
    };
}

fn bootstrap_semantic_resolve_alignment_attributes(
    context: *BootstrapSemanticContext
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    var valid: bool = true;
    var symbol_id: usize = 0;
    while (symbol_id < context->symbol_count &&
        context->error == RuntimeError.none) {
        let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
        if (symbol.kind ==
            BootstrapSemanticSymbolKind.named_type) {
            let record: BootstrapTypeRecord =
                bootstrap_semantic_type_record(
                    context, symbol.type_id
                );
            if (record.kind == BootstrapTypeKind.structure ||
                record.kind == BootstrapTypeKind.record_union) {
                let type_alignment: BootstrapSemanticAlignment =
                    bootstrap_semantic_declaration_alignment(
                        context,
                        symbol.declaration_unit,
                        symbol.declaration_node
                    );
                if (!type_alignment.valid) {
                    valid = false;
                } else if (type_alignment.alignment != 0) {
                    bootstrap_semantic_append_alignment_override(
                        context,
                        symbol.declaration_unit,
                        symbol.declaration_node,
                        type_alignment.alignment
                    );
                }
                let declaration: BootstrapSyntaxNode =
                    bootstrap_semantic_node(
                        context,
                        symbol.declaration_unit,
                        symbol.declaration_node
                    );
                var child: usize = declaration.first_child;
                while (child != none &&
                    context->error == RuntimeError.none) {
                    let node: BootstrapSyntaxNode =
                        bootstrap_semantic_node(
                            context,
                            symbol.declaration_unit,
                            child
                        );
                    if (node.kind ==
                        BootstrapSyntaxKind.field_declaration) {
                        let field_alignment:
                            BootstrapSemanticAlignment =
                                bootstrap_semantic_declaration_alignment(
                                    context,
                                    symbol.declaration_unit,
                                    child
                                );
                        if (!field_alignment.valid) {
                            valid = false;
                        } else if (field_alignment.alignment != 0) {
                            bootstrap_semantic_append_alignment_override(
                                context,
                                symbol.declaration_unit,
                                child,
                                field_alignment.alignment
                            );
                        }
                    }
                    child = node.next_sibling;
                }
            }
        }
        symbol_id += 1;
    }
    return valid && context->error == RuntimeError.none;
}

fn bootstrap_semantic_resolve_bitfield_attribute(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    attribute_node: BootstrapSyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (attribute_node.parent == none) {
        return true;
    }
    let parent: BootstrapSyntaxNode = bootstrap_semantic_node(
        context, unit_index, attribute_node.parent
    );
    if (parent.kind != BootstrapSyntaxKind.field_declaration) {
        // Mis-mounted; validate_attributes already reported it.
        return true;
    }
    var valid: bool = true;
    var bit_offset: usize = 0;
    var child: usize = attribute_node.first_child;
    while (child != none && context->error == RuntimeError.none) {
        let argument: BootstrapSyntaxNode =
            bootstrap_semantic_node(context, unit_index, child);
        if (argument.kind != BootstrapSyntaxKind.named_argument ||
            argument.child_count != 1) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_bitfield,
                unit_index,
                argument.span,
                none,
                bootstrap_semantic_empty_span(),
                child
            );
            valid = false;
            break;
        }
        let segments: *const BootstrapSemanticBitfieldSegment =
            context->bitfield_segments.data as
                *const BootstrapSemanticBitfieldSegment;
        var duplicate: bool = false;
        var segment_id: usize = 0;
        while (segment_id < context->bitfield_segment_count) {
            if (segments[segment_id].declaration_unit == unit_index &&
                segments[segment_id].declaration_node ==
                    attribute_node.parent &&
                bootstrap_semantic_tokens_equal(
                    context,
                    unit_index,
                    argument.token_index,
                    unit_index,
                    segments[segment_id].name_token
                )) {
                duplicate = true;
            }
            segment_id += 1;
        }
        let width: BootstrapConstValue =
            bootstrap_consteval_expression(
                context, unit_index, argument.first_child
            );
        if (duplicate || width.error || !width.is_constant ||
            width.is_boolean || width.value == 0 ||
            width.value > 64) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_bitfield,
                unit_index,
                argument.span,
                none,
                bootstrap_semantic_empty_span(),
                child
            );
            valid = false;
            break;
        }
        if (!bootstrap_semantic_append_bitfield_segment(
                context,
                {
                    declaration_unit = unit_index,
                    declaration_node = attribute_node.parent,
                    name_token = argument.token_index,
                    bit_offset = bit_offset,
                    bit_width = width.value as usize,
                }
            )) {
            return false;
        }
        bit_offset += width.value as usize;
        child = argument.next_sibling;
    }
    return valid && context->error == RuntimeError.none;
}

fn bootstrap_semantic_resolve_bitfield_attributes(
    context: *BootstrapSemanticContext
) -> bool {
    var valid: bool = true;
    var unit_index: usize = 0;
    while (unit_index < context->input.unit_count &&
        context->error == RuntimeError.none) {
        let unit: *const BootstrapSemanticUnit =
            bootstrap_semantic_input_unit(context, unit_index);
        var node_index: usize = 0;
        while (node_index < unit->tree.count &&
            context->error == RuntimeError.none) {
            let node: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context, unit_index, node_index
                );
            if (node.kind == BootstrapSyntaxKind.attribute &&
                bootstrap_semantic_find_attribute(
                    context, unit_index, node.token_index
                ) == (BootstrapSemanticAttribute.bits as usize) &&
                !bootstrap_semantic_resolve_bitfield_attribute(
                    context, unit_index, node
                )) {
                valid = false;
            }
            node_index += 1;
        }
        unit_index += 1;
    }
    return valid && context->error == RuntimeError.none;
}

// The storage type is only known after layout resolution, so the integer
// kind and exact width-sum checks live in a second pass.
fn bootstrap_semantic_validate_bitfields(
    context: *BootstrapSemanticContext
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let segments: *const BootstrapSemanticBitfieldSegment =
        context->bitfield_segments.data as
            *const BootstrapSemanticBitfieldSegment;
    let fields: *const BootstrapTypeField =
        context->types.fields.data as *const BootstrapTypeField;
    var valid: bool = true;
    var index: usize = 0;
    while (index < context->bitfield_segment_count &&
        context->error == RuntimeError.none) {
        let first: BootstrapSemanticBitfieldSegment = segments[index];
        var total: usize = 0;
        var group_end: usize = index;
        while (group_end < context->bitfield_segment_count &&
            segments[group_end].declaration_unit ==
                first.declaration_unit &&
            segments[group_end].declaration_node ==
                first.declaration_node) {
            total += segments[group_end].bit_width;
            group_end += 1;
        }
        let field_id: usize =
            bootstrap_semantic_bitfield_storage_field(context, first);
        if (field_id != none) {
            let field_record: BootstrapTypeRecord =
                bootstrap_semantic_type_record(
                    context, fields[field_id].type_id
                );
            if (!bootstrap_type_is_integer(field_record.kind) ||
                total !=
                    bootstrap_type_bit_width(field_record.kind)) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.invalid_bitfield,
                    first.declaration_unit,
                    bootstrap_semantic_node(
                        context,
                        first.declaration_unit,
                        first.declaration_node
                    ).span,
                    none,
                    bootstrap_semantic_empty_span(),
                    field_id
                );
                valid = false;
            }
        }
        index = group_end;
    }
    return valid && context->error == RuntimeError.none;
}

fn bootstrap_semantic_check_assert(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> bool {
    let node: BootstrapSyntaxNode = bootstrap_semantic_node(
        context, unit_index, node_index
    );
    if (node.child_count != 1) {
        return true;
    }
    let result: BootstrapConstValue =
        bootstrap_consteval_expression(
            context, unit_index, node.first_child
        );
    if (result.error || !result.is_constant) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_assert,
            unit_index,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            0
        );
        return false;
    }
    if (result.value == 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.assertion_failed,
            unit_index,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            0
        );
        return false;
    }
    return true;
}

fn bootstrap_semantic_check_module_asserts(
    context: *BootstrapSemanticContext
) -> bool {
    var unit_index: usize = 0;
    while (unit_index < context->input.unit_count &&
        context->error == RuntimeError.none) {
        var declaration_id: usize =
            bootstrap_semantic_first_declaration(
                context, unit_index
            );
        while (declaration_id != bootstrap_semantic_no_id() &&
            context->error == RuntimeError.none) {
            let declaration: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context, unit_index, declaration_id
                );
            if (declaration.kind ==
                BootstrapSyntaxKind.assert_statement) {
                bootstrap_semantic_check_assert(
                    context, unit_index, declaration_id
                );
            }
            declaration_id = declaration.next_sibling;
        }
        unit_index += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_const_integer_fits(
    kind: BootstrapTypeKind,
    value: u64
) -> bool {
    let width: usize = bootstrap_type_bit_width(kind);
    if (width >= 64) {
        return true;
    }
    let masked: u64 = bootstrap_semantic_mask_integer(value, width);
    if (!bootstrap_type_is_signed_integer(kind)) {
        return masked == value;
    }
    var extended: u64 = masked;
    if ((masked & ((1 as u64) << ((width - 1) as u64))) != 0) {
        extended = masked | ~(((1 as u64) << (width as u64)) - 1);
    }
    return extended == value;
}

fn bootstrap_semantic_const_value_conforms(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    span: BootstrapSourceSpan,
    type_id: usize,
    value: BootstrapConstValue
) -> bool {
    let record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    let boolean_type: bool = record.kind == BootstrapTypeKind.boolean;
    if (value.is_boolean != boolean_type) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            unit_index,
            span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    if (!boolean_type &&
        !bootstrap_semantic_const_integer_fits(
            record.kind, value.value
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.integer_overflow,
            unit_index,
            span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    return true;
}

fn bootstrap_semantic_collect_constant_declaration(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    declaration_id: usize,
    declaration: BootstrapSyntaxNode,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let exported: bool =
        (declaration.flags &
            (BootstrapSyntaxFlag.exported as usize)) != 0;
    if (!interface_unit && exported) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_export,
            unit_index,
            declaration.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
    }
    let duplicate: usize =
        bootstrap_semantic_find_any_local_symbol(
            context,
            module_id,
            unit_index,
            declaration.token_index
        );
    if (duplicate != none) {
        let symbols: *const BootstrapSemanticSymbol =
            context->symbols.data as *const BootstrapSemanticSymbol;
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.duplicate_name,
            unit_index,
            bootstrap_semantic_token(
                context, unit_index, declaration.token_index
            ).span,
            symbols[duplicate].declaration_unit,
            bootstrap_semantic_token(
                context,
                symbols[duplicate].declaration_unit,
                symbols[duplicate].name_token
            ).span,
            duplicate
        );
        return context->error == RuntimeError.none;
    }
    if (declaration.child_count < 2) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let type_id: usize = bootstrap_semantic_resolve_type_node(
        context, unit_index, declaration.first_child
    );
    if (type_id == none) {
        return context->error == RuntimeError.none;
    }
    let record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (!bootstrap_type_is_integer(record.kind) &&
        record.kind != BootstrapTypeKind.boolean) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            unit_index,
            bootstrap_semantic_node(
                context, unit_index, declaration.first_child
            ).span,
            none,
            bootstrap_semantic_empty_span(),
            type_id
        );
        return context->error == RuntimeError.none;
    }
    var flags: usize = BootstrapSemanticSymbolFlag.none as usize;
    if (exported) {
        flags |= BootstrapSemanticSymbolFlag.exported as usize;
    }
    if (interface_unit) {
        flags |=
            BootstrapSemanticSymbolFlag.interface_declaration as usize;
    }
    return bootstrap_semantic_append_symbol(
        context,
        {
            kind = BootstrapSemanticSymbolKind.constant,
            module_id = module_id,
            declaration_unit = unit_index,
            declaration_node = declaration_id,
            name_token = declaration.token_index,
            type_id = type_id,
            function_id = none,
            integer_value = 0,
            flags = flags,
        }
    ) != none;
}

fn bootstrap_semantic_collect_constants_in_unit(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize =
        bootstrap_semantic_first_declaration(context, unit_index);
    while (declaration_id != none &&
        context->error == RuntimeError.none) {
        let declaration: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context, unit_index, declaration_id
            );
        if (declaration.kind ==
                BootstrapSyntaxKind.const_declaration &&
            !bootstrap_semantic_collect_constant_declaration(
                context,
                module_id,
                unit_index,
                declaration_id,
                declaration,
                interface_unit
            )) {
            return false;
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == RuntimeError.none;
}

// Resolves one collected constant on demand: evaluates its initializer,
// checks conformance and marks it resolved. The resolving flag breaks
// initializer cycles (A through B back to A), which simply fail as
// non-constant; the fixpoint below reports whatever stays unresolved.
fn bootstrap_semantic_resolve_constant(
    context: *BootstrapSemanticContext,
    symbol_id: usize
) -> bool {
    let resolved_flag: usize =
        BootstrapSemanticSymbolFlag.constant_resolved as usize;
    let resolving_flag: usize =
        BootstrapSemanticSymbolFlag.constant_resolving as usize;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
    if ((symbol.flags & resolved_flag) != 0) {
        return true;
    }
    if ((symbol.flags & resolving_flag) != 0) {
        return false;
    }
    let writable: *BootstrapSemanticSymbol =
        context->symbols.data as *BootstrapSemanticSymbol;
    writable[symbol_id].flags |= resolving_flag;
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            symbol.declaration_unit,
            symbol.declaration_node
        );
    let initializer_id: usize =
        bootstrap_semantic_node(
            context,
            symbol.declaration_unit,
            declaration.first_child
        ).next_sibling;
    let value: BootstrapConstValue =
        bootstrap_consteval_expression(
            context,
            symbol.declaration_unit,
            initializer_id
        );
    // Consteval may complete enum layouts and append member symbols, so
    // take a fresh pointer before mutating.
    let fresh: *BootstrapSemanticSymbol =
        context->symbols.data as *BootstrapSemanticSymbol;
    fresh[symbol_id].flags =
        fresh[symbol_id].flags & ~resolving_flag;
    if (!value.is_constant || value.error) {
        return false;
    }
    fresh[symbol_id].flags |= resolved_flag;
    if (bootstrap_semantic_const_value_conforms(
            context,
            symbol.declaration_unit,
            bootstrap_semantic_node(
                context,
                symbol.declaration_unit,
                initializer_id
            ).span,
            symbol.type_id,
            value
        )) {
        fresh[symbol_id].integer_value = value.value;
    }
    return true;
}

// Initializers may reference constants declared later in the unit or in
// another module, so evaluation runs as a fixpoint: every resolved constant
// enables more evaluations, and whatever remains unresolved afterwards is
// diagnosed as non-constant (including cyclic definitions).
fn bootstrap_semantic_resolve_constants(
    context: *BootstrapSemanticContext
) -> bool {
    let resolved_flag: usize =
        BootstrapSemanticSymbolFlag.constant_resolved as usize;
    var progress: bool = true;
    while (progress && context->error == RuntimeError.none) {
        progress = false;
        var symbol_id: usize = 0;
        while (symbol_id < context->symbol_count &&
            context->error == RuntimeError.none) {
            let symbols: *const BootstrapSemanticSymbol =
                context->symbols.data as
                    *const BootstrapSemanticSymbol;
            let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
            if (symbol.kind == BootstrapSemanticSymbolKind.constant &&
                (symbol.flags & resolved_flag) == 0 &&
                bootstrap_semantic_resolve_constant(
                    context, symbol_id
                )) {
                progress = true;
            }
            symbol_id += 1;
        }
    }
    var symbol_id: usize = 0;
    while (symbol_id < context->symbol_count &&
        context->error == RuntimeError.none) {
        let symbols: *const BootstrapSemanticSymbol =
            context->symbols.data as *const BootstrapSemanticSymbol;
        let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
        if (symbol.kind == BootstrapSemanticSymbolKind.constant &&
            (symbol.flags & resolved_flag) == 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .non_constant_expression,
                symbol.declaration_unit,
                bootstrap_semantic_node(
                    context,
                    symbol.declaration_unit,
                    symbol.declaration_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                symbol_id
            );
        }
        symbol_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_collect_constant_declarations(
    context: *BootstrapSemanticContext
) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count &&
        context->error == RuntimeError.none) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as *const BootstrapSemanticModule;
        if (!bootstrap_semantic_collect_constants_in_unit(
                context,
                module_id,
                modules[module_id].interface_unit,
                true
            ) ||
            !bootstrap_semantic_collect_constants_in_unit(
                context,
                module_id,
                modules[module_id].implementation_unit,
                false
            )) {
            return false;
        }
        module_id += 1;
    }
    return context->error == RuntimeError.none;
}

// Array length expressions are folded here because type resolution cannot
// import consteval (consteval already imports types); the cached values are
// read back by bootstrap_semantic_resolve_type_node. The walk covers every
// node of every unit, including function bodies.
fn bootstrap_semantic_prescan_array_lengths(
    context: *BootstrapSemanticContext
) -> bool {
    var unit_index: usize = 0;
    while (unit_index < context->input.unit_count &&
        context->error == RuntimeError.none) {
        let unit: *const BootstrapSemanticUnit =
            bootstrap_semantic_input_unit(context, unit_index);
        var node_index: usize = 0;
        while (node_index < unit->tree.count &&
            context->error == RuntimeError.none) {
            let node: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context, unit_index, node_index
                );
            if (node.kind == BootstrapSyntaxKind.type_array &&
                (node.flags &
                    (BootstrapSyntaxFlag.flexible as usize)) == 0 &&
                node.child_count == 2) {
                let value: BootstrapConstValue =
                    bootstrap_consteval_expression(
                        context, unit_index, node.first_child
                    );
                var entry: BootstrapSemanticArrayLength = {
                    unit_index = unit_index,
                    node_index = node_index,
                    value = 0,
                    valid = false,
                };
                if (value.is_constant && !value.error &&
                    !value.is_boolean) {
                    entry.value = value.value;
                    entry.valid = true;
                }
                if (!bootstrap_semantic_append_record(
                        context,
                        &context->array_lengths,
                        (&entry) as
                            *const BootstrapSemanticArrayLength as
                                *const u8,
                        sizeof(BootstrapSemanticArrayLength)
                    )) {
                    return false;
                }
                context->array_length_count += 1;
            }
            node_index += 1;
        }
        unit_index += 1;
    }
    return context->error == RuntimeError.none;
}

// Folds the enum discriminants that resolve_enum_layout left pending
// (anything beyond signed integer literals) in declaration order, so
// implicit members continue from the value of their explicit predecessor.
// The resolving flag on the type symbol breaks discriminant cycles.
fn bootstrap_semantic_resolve_enum_constant_values(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let pending_flag: usize =
        BootstrapSemanticSymbolFlag.enum_value_pending as usize;
    let resolving_flag: usize =
        BootstrapSemanticSymbolFlag.enum_values_resolving as usize;
    if (!bootstrap_semantic_require_complete_type(context, type_id)) {
        return false;
    }
    var has_pending: bool = false;
    var scan: usize = 0;
    let all_symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as *const BootstrapSemanticSymbol;
    while (scan < context->symbol_count) {
        let candidate: BootstrapSemanticSymbol = all_symbols[scan];
        if (candidate.kind == BootstrapSemanticSymbolKind.enum_member &&
            candidate.type_id == type_id &&
            (candidate.flags & pending_flag) != 0) {
            has_pending = true;
        }
        scan += 1;
    }
    if (!has_pending) {
        return true;
    }
    let type_symbol: usize =
        bootstrap_semantic_find_type_symbol(context, type_id);
    if (type_symbol == none) {
        return false;
    }
    let symbols: *BootstrapSemanticSymbol =
        context->symbols.data as *BootstrapSemanticSymbol;
    if ((symbols[type_symbol].flags & resolving_flag) != 0) {
        return false;
    }
    symbols[type_symbol].flags |= resolving_flag;
    let record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    let underlying_kind: BootstrapTypeKind =
        bootstrap_semantic_type_record(
            context, record.element_type
        ).kind;
    let bits: usize = bootstrap_type_bit_width(underlying_kind);
    var success: bool = true;
    var next_value: u64 = 0;
    var next_value_valid: bool = true;
    var member_id: usize = bootstrap_semantic_node(
        context,
        record.declaration_unit,
        bootstrap_semantic_node(
            context, record.declaration_unit, record.declaration_node
        ).first_child
    ).next_sibling;
    while (member_id != none && success &&
        context->error == RuntimeError.none) {
        let member: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context, record.declaration_unit, member_id
            );
        if (member.kind == BootstrapSyntaxKind.attribute) {
            member_id = member.next_sibling;
            continue;
        }
        var member_symbol: usize = none;
        var index: usize = 0;
        let members: *const BootstrapSemanticSymbol =
            context->symbols.data as
                *const BootstrapSemanticSymbol;
        while (index < context->symbol_count) {
            let candidate: BootstrapSemanticSymbol = members[index];
            if (candidate.kind ==
                    BootstrapSemanticSymbolKind.enum_member &&
                candidate.type_id == type_id &&
                candidate.declaration_node == member_id) {
                member_symbol = index;
            }
            index += 1;
        }
        if (member_symbol == none) {
            // A duplicate member (already diagnosed) has no symbol.
            member_id = member.next_sibling;
            continue;
        }
        let current: BootstrapSemanticSymbol = members[member_symbol];
        if ((current.flags & pending_flag) == 0) {
            next_value = bootstrap_semantic_mask_integer(
                current.integer_value + 1, bits
            );
            next_value_valid =
                bootstrap_semantic_enum_can_increment(
                    underlying_kind, current.integer_value
                );
        } else {
            var value: u64 = next_value;
            if (member.child_count == 0) {
                if (!next_value_valid) {
                    success = false;
                    break;
                }
            } else {
                let evaluated: BootstrapConstValue =
                    bootstrap_consteval_expression(
                        context,
                        record.declaration_unit,
                        member.first_child
                    );
                if (!evaluated.is_constant || evaluated.error ||
                    evaluated.is_boolean ||
                    !bootstrap_semantic_const_integer_fits(
                        underlying_kind, evaluated.value
                    )) {
                    success = false;
                    break;
                }
                value = bootstrap_semantic_mask_integer(
                    evaluated.value, bits
                );
            }
            let fresh: *BootstrapSemanticSymbol =
                context->symbols.data as *BootstrapSemanticSymbol;
            fresh[member_symbol].integer_value = value;
            fresh[member_symbol].flags =
                fresh[member_symbol].flags & ~pending_flag;
            next_value = bootstrap_semantic_mask_integer(
                value + 1, bits
            );
            next_value_valid =
                bootstrap_semantic_enum_can_increment(
                    underlying_kind, value
                );
        }
        member_id = member.next_sibling;
    }
    let done: *BootstrapSemanticSymbol =
        context->symbols.data as *BootstrapSemanticSymbol;
    done[type_symbol].flags =
        done[type_symbol].flags & ~resolving_flag;
    return success && context->error == RuntimeError.none;
}

// Forces every enum with pending discriminants to fold them; enums nothing
// referenced during type resolution still get their values (or an
// invalid_enum_value diagnostic) here.
fn bootstrap_semantic_finalize_enum_constants(
    context: *BootstrapSemanticContext
) -> bool {
    var symbol_id: usize = 0;
    while (symbol_id < context->symbol_count &&
        context->error == RuntimeError.none) {
        let symbols: *const BootstrapSemanticSymbol =
            context->symbols.data as *const BootstrapSemanticSymbol;
        let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
        if (symbol.kind == BootstrapSemanticSymbolKind.named_type &&
            bootstrap_semantic_type_record(
                context, symbol.type_id
            ).kind == BootstrapTypeKind.enumeration &&
            bootstrap_semantic_require_complete_type(
                context, symbol.type_id
            ) &&
            !bootstrap_semantic_resolve_enum_constant_values(
                context, symbol.type_id
            )) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_enum_value,
                symbol.declaration_unit,
                bootstrap_semantic_node(
                    context,
                    symbol.declaration_unit,
                    symbol.declaration_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                symbol.type_id
            );
        }
        symbol_id += 1;
    }
    return context->error == RuntimeError.none;
}
