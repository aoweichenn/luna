export module luna.bootstrap.middleend.semantic.functions;

import luna.runtime;
import luna.std.bytes;
import luna.std.text as text;
import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.parser as parser;
import luna.bootstrap.middleend.type as type_info;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.attributes as attributes;
import luna.bootstrap.middleend.semantic.types as types;

export fn append_function( context: *context::Context, function: context::Function ) -> usize;

export fn append_parameter( context: *context::Context, parameter: context::Parameter ) -> usize;

export fn function_parts(
    context: *context::Context, unit_index: usize, declaration: parser::SyntaxNode, parameter_count: *usize,
    return_node: *usize, body_node: *usize) -> bool;

export fn parameter_name_exists(
    context: *context::Context, function_id: usize, unit_index: usize, name_token: usize) -> usize;

export fn collect_function_parameters(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: parser::SyntaxNode,
    expected_parameter_count: usize) -> bool;

export fn external_name_is_reserved( context: *context::Context, unit_index: usize, token_index: usize ) -> bool;

export fn validate_external_signature( context: *context::Context, function_id: usize ) -> bool;

export fn find_module_function(
    context: *context::Context, module_id: usize, unit_index: usize, name_token: usize) -> usize;

export fn add_function_declaration(
    context: *context::Context, module_id: usize, unit_index: usize, declaration_id: usize,
    declaration: parser::SyntaxNode, interface_unit: bool) -> usize;

export fn function_signature_matches(
    context: *context::Context, function_id: usize, unit_index: usize, declaration: parser::SyntaxNode) -> bool;

export fn collect_functions_in_unit(
    context: *context::Context, module_id: usize, unit_index: usize, interface_unit: bool) -> bool;

export fn collect_functions( context: *context::Context ) -> bool;

export fn collect_const_functions( context: *context::Context ) -> bool;

export fn ir_function_record( context: *context::Context, function_id: usize ) -> ir::Function;

export fn text_is_before(
    context: *context::Context, left_unit: usize, left_span: lexer::SourceSpan, right_unit: usize,
    right_span: lexer::SourceSpan) -> bool;

export fn token_is_before(
    context: *context::Context, left_unit: usize, left_token: usize, right_unit: usize, right_token: usize) -> bool;

export fn module_name_is_before( context: *context::Context, left_module: usize, right_module: usize ) -> bool;

export fn function_is_before( context: *context::Context, left_function: usize, right_function: usize ) -> bool;

export fn function_order_sift_down( context: *context::Context, ordered: *usize, start: usize, count: usize ) -> bool;

export fn function_order( context: *context::Context ) -> bytes::Buffer;

export fn create_ir_functions( context: *context::Context ) -> bool;
