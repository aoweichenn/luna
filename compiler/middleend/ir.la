module luna.bootstrap.middleend.ir;

import luna.std.checked as checked;

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty_span() -> lexer::SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn invalid_function() -> Function {
    let none: usize = no_id();
    return {
        declaration_unit = none, declaration_node = none, name_token = none, linkage = Linkage.internal,
        return_type = none, first_parameter = none, parameter_count = 0, first_slot = none, slot_count = 0,
        first_block = none, block_count = 0, first_value = none, value_count = 0, has_body = false, variadic = false,
        export_name_unit = none, export_name_token = none, asm_body_unit = none, asm_body_node = none,
    };
}

fn invalid_block() -> Block {
    let none: usize = no_id();
    return {
        function_id = none, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
}

fn invalid_instruction()
    -> Instruction {
    let none: usize = no_id();
    return {
        opcode = Opcode.invalid, operation = lexer::TokenKind.invalid, type_id = none, result = none,
        left = none, right = none, third = none, auxiliary = none, immediate = 0, floating = 0.0, block_id = none,
        next_instruction = none, span = empty_span(),
    };
}

fn empty() -> Store {
    return {
        globals = bytes::empty(), global_count = 0, global_bytes = bytes::empty(),
        functions = bytes::empty(), function_count = 0, parameters = bytes::empty(),
        parameter_count = 0, slots = bytes::empty(), slot_count = 0, values = bytes::empty(),
        value_count = 0, blocks = bytes::empty(), block_count = 0, instructions = bytes::empty(),
        instruction_count = 0, arguments = bytes::empty(), argument_count = 0,
        entry_function = no_id(), error = runtime::Error.none,
    };
}

fn buffer_matches(buffer: bytes::Buffer, count: usize, record_size: usize) -> bool {
    return bytes::is_valid(buffer) && record_size != 0 && buffer.length % record_size == 0 &&
        count == buffer.length / record_size;
}

fn storage_is_valid(ir: Store) -> bool {
    return buffer_matches(ir.globals, ir.global_count, sizeof(Global)) && bytes::is_valid(ir.global_bytes) &&
        buffer_matches(ir.functions, ir.function_count, sizeof(Function)) &&
        buffer_matches(ir.parameters, ir.parameter_count, sizeof(Parameter)) &&
        buffer_matches(ir.slots, ir.slot_count, sizeof(Slot)) &&
        buffer_matches(ir.values, ir.value_count, sizeof(Value)) &&
        buffer_matches(ir.blocks, ir.block_count, sizeof(Block)) &&
        buffer_matches(ir.instructions, ir.instruction_count, sizeof(Instruction)) &&
        buffer_matches(ir.arguments, ir.argument_count, sizeof(Argument));
}

fn get_function(ir: Store, function_id: usize) -> FunctionResult {
    if (!storage_is_valid(ir) || function_id >= ir.function_count) {
        return {
            function = invalid_function(), error = runtime::Error.invalid_argument,
        };
    }
    let functions: *const Function = ir.functions.data as *const Function;
    return {
        function = functions[function_id], error = runtime::Error.none,
    };
}

fn get_block(ir: Store, block_id: usize) -> BlockResult {
    if (!storage_is_valid(ir) || block_id >= ir.block_count) {
        return {
            block = invalid_block(), error = runtime::Error.invalid_argument,
        };
    }
    let blocks: *const Block = ir.blocks.data as *const Block;
    return {
        block = blocks[block_id], error = runtime::Error.none,
    };
}

fn get_instruction(ir: Store, instruction_id: usize) -> InstructionResult {
    if (!storage_is_valid(ir) || instruction_id >= ir.instruction_count) {
        return {
            instruction = invalid_instruction(), error = runtime::Error.invalid_argument,
        };
    }
    let instructions: *const Instruction = ir.instructions.data as *const Instruction;
    return {
        instruction = instructions[instruction_id], error = runtime::Error.none,
    };
}

fn append(buffer: bytes::Buffer, data: *const u8, length: usize) -> bytes::BufferResult {
    if (length == 0 || data == null) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }
    return bytes::append(buffer, data, length);
}

fn set_error(ir: *Store, error: runtime::Error) -> bool {
    if (ir == null) {
        return false;
    }
    if (ir->error == runtime::Error.none) {
        ir->error = error;
    }
    return false;
}

fn add_global(ir: *Store, bytes: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        byte_count == 0 || bytes == null || alignment_bytes == 0 || alignment_bytes > 8 ||
        (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let byte_offset: usize = ir->global_bytes.length;
    let appended_bytes: bytes::BufferResult = bytes::append(ir->global_bytes, bytes, byte_count);
    ir->global_bytes = appended_bytes.buffer;
    if (appended_bytes.error != runtime::Error.none) {
        set_error(ir, appended_bytes.error);
        return none;
    }
    let global: Global = {
        byte_offset = byte_offset, byte_count = byte_count, alignment_bytes = alignment_bytes, read_only = read_only,
    };
    let appended: bytes::BufferResult = append(ir->globals, (&global) as *const Global as *const u8, sizeof(Global));
    ir->globals = appended.buffer;
    if (appended.error != runtime::Error.none) {
        let truncated: bytes::BufferResult = bytes::truncate(ir->global_bytes, byte_offset);
        ir->global_bytes = truncated.buffer;
        set_error(ir, appended.error);
        return none;
    }
    let global_id: usize = ir->global_count;
    ir->global_count += 1;
    return global_id;
}

fn add_function(ir: *Store, function: Function) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function.declaration_unit == none || function.declaration_node == none || function.name_token == none ||
        function.return_type == none || function.parameter_count != 0 || function.slot_count != 0 ||
        function.block_count != 0 || function.value_count != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    var record: Function = function;
    record.first_parameter = none;
    record.first_slot = none;
    record.first_block = none;
    record.first_value = none;
    let appended: bytes::BufferResult = append(
        ir->functions, (&record) as *const Function as *const u8, sizeof(Function));
    ir->functions = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let function_id: usize = ir->function_count;
    ir->function_count += 1;
    return function_id;
}

fn function_can_extend_range(first: usize, count: usize, next: usize) -> bool {
    return count == 0 ? first == no_id() : first + count == next;
}

fn add_slot(
    ir: *Store, function_id: usize, type_id: usize, mutable_binding: bool,
    volatile_binding: bool, alignment_bytes: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none ||
        alignment_bytes > (Limit.maximum_slot_alignment as usize) || (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    let slot: Slot = {
        function_id = function_id, type_id = type_id, alignment_bytes = alignment_bytes,
        mutable_binding = mutable_binding, volatile_binding = volatile_binding,
    };
    let appended: bytes::BufferResult = append(ir->slots, (&slot) as *const Slot as *const u8, sizeof(Slot));
    ir->slots = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].slot_count == 0) {
        result_functions[function_id].first_slot = ir->slot_count;
    }
    result_functions[function_id].slot_count += 1;
    let slot_id: usize = ir->slot_count;
    ir->slot_count += 1;
    return slot_id;
}

fn add_parameter(ir: *Store, function_id: usize, type_id: usize, name_token: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none || name_token == none) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    if (!function_can_extend_range(
            functions[function_id].first_parameter, functions[function_id].parameter_count, ir->parameter_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let slot_id: usize = add_slot(ir, function_id, type_id, false, false, 0);
    if (slot_id == none) {
        return none;
    }
    let parameter: Parameter = {
        function_id = function_id, type_id = type_id, slot_id = slot_id, name_token = name_token,
    };
    let appended: bytes::BufferResult = append(
        ir->parameters, (&parameter) as *const Parameter as *const u8, sizeof(Parameter));
    ir->parameters = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].parameter_count == 0) {
        result_functions[function_id].first_parameter = ir->parameter_count;
    }
    result_functions[function_id].parameter_count += 1;
    let parameter_id: usize = ir->parameter_count;
    ir->parameter_count += 1;
    return parameter_id;
}

fn add_block(ir: *Store, function_id: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) || function_id >= ir->function_count) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    if (!functions[function_id].has_body ||
        !function_can_extend_range(
            functions[function_id].first_block, functions[function_id].block_count, ir->block_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let block: Block = {
        function_id = function_id, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
    let appended: bytes::BufferResult = append(ir->blocks, (&block) as *const Block as *const u8, sizeof(Block));
    ir->blocks = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].block_count == 0) {
        result_functions[function_id].first_block = ir->block_count;
    }
    result_functions[function_id].block_count += 1;
    let block_id: usize = ir->block_count;
    ir->block_count += 1;
    return block_id;
}

fn add_value(ir: *Store, function_id: usize, block_id: usize, type_id: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || block_id >= ir->block_count || type_id == none) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let blocks: *const Block = ir->blocks.data as *const Block;
    let functions: *Function = ir->functions.data as *Function;
    if (blocks[block_id].function_id != function_id ||
        !function_can_extend_range(
            functions[function_id].first_value, functions[function_id].value_count, ir->value_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let value: Value = {
        function_id = function_id, block_id = block_id, type_id = type_id, definition = none,
    };
    let appended: bytes::BufferResult = append(ir->values, (&value) as *const Value as *const u8, sizeof(Value));
    ir->values = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].value_count == 0) {
        result_functions[function_id].first_value = ir->value_count;
    }
    result_functions[function_id].value_count += 1;
    let value_id: usize = ir->value_count;
    ir->value_count += 1;
    return value_id;
}

fn opcode_is_terminator(opcode: Opcode) -> bool {
    return opcode == Opcode.jump || opcode == Opcode.branch ||
        opcode == Opcode.return_value || opcode == Opcode.return_void || opcode == Opcode.unreachable;
}

fn increment_predecessor(ir: *Store, source_block: usize, target_block: usize) -> bool {
    if (target_block >= ir->block_count) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let blocks: *Block = ir->blocks.data as *Block;
    if (blocks[source_block].function_id != blocks[target_block].function_id ||
        blocks[target_block].predecessor_count == Limit.maximum_size as usize) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    blocks[target_block].predecessor_count += 1;
    return true;
}

fn emit(ir: *Store, instruction: Instruction) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        instruction.opcode == Opcode.invalid || instruction.block_id >= ir->block_count ||
        instruction.next_instruction != none || instruction.span.line == 0 || instruction.span.column == 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let blocks: *Block = ir->blocks.data as *Block;
    if (blocks[instruction.block_id].terminated) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    if (instruction.result != none) {
        if (instruction.result >= ir->value_count) {
            set_error(ir, runtime::Error.invalid_argument);
            return none;
        }
        let values: *const Value = ir->values.data as *const Value;
        if (values[instruction.result].block_id != instruction.block_id ||
            values[instruction.result].definition != none || values[instruction.result].type_id !=
                instruction.type_id) {
            set_error(ir, runtime::Error.invalid_argument);
            return none;
        }
    }
    let instruction_id: usize = ir->instruction_count;
    let appended: bytes::BufferResult = append(
        ir->instructions, (&instruction) as *const Instruction as *const u8, sizeof(Instruction));
    ir->instructions = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_blocks: *Block = ir->blocks.data as *Block;
    if (result_blocks[instruction.block_id].instruction_count == 0) {
        result_blocks[instruction.block_id].first_instruction = instruction_id;
    } else {
        let instructions: *Instruction = ir->instructions.data as *Instruction;
        instructions[ result_blocks[instruction.block_id].last_instruction].next_instruction = instruction_id;
    }
    result_blocks[instruction.block_id].last_instruction = instruction_id;
    result_blocks[instruction.block_id].instruction_count += 1;
    if (instruction.result != none) {
        let values: *Value = ir->values.data as *Value;
        values[instruction.result].definition = instruction_id;
    }
    ir->instruction_count += 1;

    if (instruction.opcode == Opcode.jump) {
        if (!increment_predecessor(
                ir, instruction.block_id, instruction.auxiliary)) {
            return none;
        }
    } else if (instruction.opcode == Opcode.branch) {
        if (!increment_predecessor(ir, instruction.block_id, instruction.auxiliary) ||
            !increment_predecessor(
                ir, instruction.block_id, instruction.third)) {
            return none;
        }
    }
    if (opcode_is_terminator(
            instruction.opcode)) {
        result_blocks[instruction.block_id].terminated = true;
    }
    return instruction_id;
}

fn add_argument(ir: *Store, instruction_id: usize, value_id: usize) -> bool {
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        instruction_id >= ir->instruction_count || value_id >= ir->value_count) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return false;
    }
    let instructions: *const Instruction = ir->instructions.data as *const Instruction;
    let values: *const Value = ir->values.data as *const Value;
    if ((instructions[instruction_id].opcode != Opcode.call && instructions[instruction_id].opcode !=
            Opcode.call_indirect) || values[value_id].function_id !=
            (ir->blocks.data as *const Block)[ instructions[instruction_id].block_id].function_id) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let argument: Argument = {
        instruction_id = instruction_id, value_id = value_id,
    };
    let appended: bytes::BufferResult = append(
        ir->arguments, (&argument) as *const Argument as *const u8, sizeof(Argument));
    ir->arguments = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return set_error(ir, appended.error);
    }
    ir->argument_count += 1;
    return true;
}

fn set_entry(ir: *Store, function_id: usize) -> bool {
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || ir->entry_function != no_id()) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return false;
    }
    let functions: *const Function = ir->functions.data as *const Function;
    if (!functions[function_id].has_body) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    ir->entry_function = function_id;
    return true;
}

fn release(ir: Store) -> runtime::Error {
    if (!storage_is_valid(ir)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(ir.globals);
    let global_bytes_error: runtime::Error = bytes::release(ir.global_bytes);
    if (error == runtime::Error.none) {
        error = global_bytes_error;
    }
    let function_error: runtime::Error = bytes::release(ir.functions);
    if (error == runtime::Error.none) {
        error = function_error;
    }
    let parameter_error: runtime::Error = bytes::release(ir.parameters);
    if (error == runtime::Error.none) {
        error = parameter_error;
    }
    let slot_error: runtime::Error = bytes::release(ir.slots);
    if (error == runtime::Error.none) {
        error = slot_error;
    }
    let value_error: runtime::Error = bytes::release(ir.values);
    if (error == runtime::Error.none) {
        error = value_error;
    }
    let block_error: runtime::Error = bytes::release(ir.blocks);
    if (error == runtime::Error.none) {
        error = block_error;
    }
    let instruction_error: runtime::Error = bytes::release(ir.instructions);
    if (error == runtime::Error.none) {
        error = instruction_error;
    }
    let argument_error: runtime::Error = bytes::release(ir.arguments);
    if (error == runtime::Error.none) {
        error = argument_error;
    }
    return error;
}

