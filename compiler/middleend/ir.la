module luna.bootstrap.middleend.ir;

enum Limit: usize {
    maximum_size = 18446744073709551615, maximum_alignment = 8, maximum_slot_alignment = 4096,
    maximum_type_depth = 256,
}

fn no_id() -> usize {
    return Limit.maximum_size as usize;
}

fn empty_span() -> lexer::SourceSpan {
    return {
        offset = 0, length = 0, line = 0, column = 0,
    };
}

fn invalid_function() -> Function {
    let none: usize = no_id();
    return {
        declaration_unit = none, declaration_node = none, name_token = none, linkage = Linkage.internal,
        return_type = none, first_parameter = none, parameter_count = 0, first_slot = none, slot_count = 0,
        first_block = none, block_count = 0, first_value = none, value_count = 0, has_body = false, variadic = false,
        export_name_unit = none, export_name_token = none, asm_body_unit = none, asm_body_node = none,
    };
}

fn invalid_block() -> Block {
    let none: usize = no_id();
    return {
        function_id = none, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
}

fn invalid_instruction()
    -> Instruction {
    let none: usize = no_id();
    return {
        opcode = Opcode.invalid, operation = lexer::TokenKind.invalid, type_id = none, result = none,
        left = none, right = none, third = none, auxiliary = none, immediate = 0, floating = 0.0, block_id = none,
        next_instruction = none, span = empty_span(),
    };
}

fn empty() -> Store {
    return {
        globals = bytes::empty(), global_count = 0, global_bytes = bytes::empty(),
        functions = bytes::empty(), function_count = 0, parameters = bytes::empty(),
        parameter_count = 0, slots = bytes::empty(), slot_count = 0, values = bytes::empty(),
        value_count = 0, blocks = bytes::empty(), block_count = 0, instructions = bytes::empty(),
        instruction_count = 0, arguments = bytes::empty(), argument_count = 0,
        entry_function = no_id(), error = runtime::Error.none,
    };
}

fn buffer_matches(buffer: bytes::Buffer, count: usize, record_size: usize) -> bool {
    return bytes::is_valid(buffer) && record_size != 0 && buffer.length % record_size == 0 &&
        count == buffer.length / record_size;
}

fn storage_is_valid(ir: Store) -> bool {
    return buffer_matches(ir.globals, ir.global_count, sizeof(Global)) &&
        bytes::is_valid(ir.global_bytes) &&
        buffer_matches(ir.functions, ir.function_count, sizeof(Function)) &&
        buffer_matches(ir.parameters, ir.parameter_count, sizeof(Parameter)) &&
        buffer_matches(ir.slots, ir.slot_count, sizeof(Slot)) &&
        buffer_matches(ir.values, ir.value_count, sizeof(Value)) &&
        buffer_matches(ir.blocks, ir.block_count, sizeof(Block)) &&
        buffer_matches(ir.instructions, ir.instruction_count, sizeof(Instruction)) &&
        buffer_matches(ir.arguments, ir.argument_count, sizeof(Argument));
}

fn get_function(ir: Store, function_id: usize) -> FunctionResult {
    if (!storage_is_valid(ir) || function_id >= ir.function_count) {
        return {
            function = invalid_function(), error = runtime::Error.invalid_argument,
        };
    }
    let functions: *const Function = ir.functions.data as *const Function;
    return {
        function = functions[function_id], error = runtime::Error.none,
    };
}

fn get_block(ir: Store, block_id: usize) -> BlockResult {
    if (!storage_is_valid(ir) || block_id >= ir.block_count) {
        return {
            block = invalid_block(), error = runtime::Error.invalid_argument,
        };
    }
    let blocks: *const Block = ir.blocks.data as *const Block;
    return {
        block = blocks[block_id], error = runtime::Error.none,
    };
}

fn get_instruction(ir: Store, instruction_id: usize) -> InstructionResult {
    if (!storage_is_valid(ir) || instruction_id >= ir.instruction_count) {
        return {
            instruction = invalid_instruction(), error = runtime::Error.invalid_argument,
        };
    }
    let instructions: *const Instruction = ir.instructions.data as *const Instruction;
    return {
        instruction = instructions[instruction_id], error = runtime::Error.none,
    };
}

fn append(buffer: bytes::Buffer, data: *const u8, length: usize) -> bytes::BufferResult {
    if (length == 0 || data == null) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }
    return bytes::append(buffer, data, length);
}

fn set_error(ir: *Store, error: runtime::Error) -> bool {
    if (ir == null) {
        return false;
    }
    if (ir->error == runtime::Error.none) {
        ir->error = error;
    }
    return false;
}

fn add_global(
    ir: *Store, bytes: *const u8, byte_count: usize, alignment_bytes: usize, read_only: bool) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        byte_count == 0 || bytes == null || alignment_bytes == 0 || alignment_bytes > 8 ||
        (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let byte_offset: usize = ir->global_bytes.length;
    let appended_bytes: bytes::BufferResult = bytes::append(ir->global_bytes, bytes, byte_count);
    ir->global_bytes = appended_bytes.buffer;
    if (appended_bytes.error != runtime::Error.none) {
        set_error(ir, appended_bytes.error);
        return none;
    }
    let global: Global = {
        byte_offset = byte_offset, byte_count = byte_count, alignment_bytes = alignment_bytes, read_only = read_only,
    };
    let appended: bytes::BufferResult = append(
        ir->globals, (&global) as *const Global as *const u8, sizeof(Global));
    ir->globals = appended.buffer;
    if (appended.error != runtime::Error.none) {
        let truncated: bytes::BufferResult = bytes::truncate(ir->global_bytes, byte_offset);
        ir->global_bytes = truncated.buffer;
        set_error(ir, appended.error);
        return none;
    }
    let global_id: usize = ir->global_count;
    ir->global_count += 1;
    return global_id;
}

fn add_function(ir: *Store, function: Function) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function.declaration_unit == none || function.declaration_node == none || function.name_token == none ||
        function.return_type == none || function.parameter_count != 0 || function.slot_count != 0 ||
        function.block_count != 0 || function.value_count != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    var record: Function = function;
    record.first_parameter = none;
    record.first_slot = none;
    record.first_block = none;
    record.first_value = none;
    let appended: bytes::BufferResult = append(
        ir->functions, (&record) as *const Function as *const u8, sizeof(Function));
    ir->functions = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let function_id: usize = ir->function_count;
    ir->function_count += 1;
    return function_id;
}

fn function_can_extend_range(first: usize, count: usize, next: usize) -> bool {
    return count == 0 ? first == no_id() : first + count == next;
}

fn add_slot(
    ir: *Store, function_id: usize, type_id: usize, mutable_binding: bool,
    volatile_binding: bool, alignment_bytes: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none ||
        alignment_bytes > (Limit.maximum_slot_alignment as usize) ||
        (alignment_bytes & (alignment_bytes - 1)) != 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    let slot: Slot = {
        function_id = function_id, type_id = type_id, alignment_bytes = alignment_bytes,
        mutable_binding = mutable_binding, volatile_binding = volatile_binding,
    };
    let appended: bytes::BufferResult = append(
        ir->slots, (&slot) as *const Slot as *const u8, sizeof(Slot));
    ir->slots = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].slot_count == 0) {
        result_functions[function_id].first_slot = ir->slot_count;
    }
    result_functions[function_id].slot_count += 1;
    let slot_id: usize = ir->slot_count;
    ir->slot_count += 1;
    return slot_id;
}

fn add_parameter(ir: *Store, function_id: usize, type_id: usize, name_token: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || type_id == none || name_token == none) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    if (!function_can_extend_range(
            functions[function_id].first_parameter, functions[function_id].parameter_count, ir->parameter_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let slot_id: usize = add_slot(ir, function_id, type_id, false, false, 0);
    if (slot_id == none) {
        return none;
    }
    let parameter: Parameter = {
        function_id = function_id, type_id = type_id, slot_id = slot_id, name_token = name_token,
    };
    let appended: bytes::BufferResult = append(
        ir->parameters, (&parameter) as *const Parameter as *const u8, sizeof(Parameter));
    ir->parameters = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].parameter_count == 0) {
        result_functions[function_id].first_parameter = ir->parameter_count;
    }
    result_functions[function_id].parameter_count += 1;
    let parameter_id: usize = ir->parameter_count;
    ir->parameter_count += 1;
    return parameter_id;
}

fn add_block(ir: *Store, function_id: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let functions: *Function = ir->functions.data as *Function;
    if (!functions[function_id].has_body ||
        !function_can_extend_range(
            functions[function_id].first_block, functions[function_id].block_count, ir->block_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let block: Block = {
        function_id = function_id, first_instruction = none, last_instruction = none, instruction_count = 0,
        predecessor_count = 0, terminated = false,
    };
    let appended: bytes::BufferResult = append(
        ir->blocks, (&block) as *const Block as *const u8, sizeof(Block));
    ir->blocks = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].block_count == 0) {
        result_functions[function_id].first_block = ir->block_count;
    }
    result_functions[function_id].block_count += 1;
    let block_id: usize = ir->block_count;
    ir->block_count += 1;
    return block_id;
}

fn add_value(ir: *Store, function_id: usize, block_id: usize, type_id: usize) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || block_id >= ir->block_count || type_id == none) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let blocks: *const Block = ir->blocks.data as *const Block;
    let functions: *Function = ir->functions.data as *Function;
    if (blocks[block_id].function_id != function_id ||
        !function_can_extend_range(
            functions[function_id].first_value, functions[function_id].value_count, ir->value_count)) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    let value: Value = {
        function_id = function_id, block_id = block_id, type_id = type_id, definition = none,
    };
    let appended: bytes::BufferResult = append(
        ir->values, (&value) as *const Value as *const u8, sizeof(Value));
    ir->values = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_functions: *Function = ir->functions.data as *Function;
    if (result_functions[function_id].value_count == 0) {
        result_functions[function_id].first_value = ir->value_count;
    }
    result_functions[function_id].value_count += 1;
    let value_id: usize = ir->value_count;
    ir->value_count += 1;
    return value_id;
}

fn opcode_is_terminator(opcode: Opcode) -> bool {
    return opcode == Opcode.jump || opcode == Opcode.branch ||
        opcode == Opcode.return_value || opcode == Opcode.return_void ||
        opcode == Opcode.unreachable;
}

fn increment_predecessor(ir: *Store, source_block: usize, target_block: usize) -> bool {
    if (target_block >= ir->block_count) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let blocks: *Block = ir->blocks.data as *Block;
    if (blocks[source_block].function_id != blocks[target_block].function_id ||
        blocks[target_block].predecessor_count == Limit.maximum_size as usize) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    blocks[target_block].predecessor_count += 1;
    return true;
}

fn emit(ir: *Store, instruction: Instruction) -> usize {
    let none: usize = no_id();
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        instruction.opcode == Opcode.invalid || instruction.block_id >= ir->block_count ||
        instruction.next_instruction != none || instruction.span.line == 0 || instruction.span.column == 0) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return none;
    }
    let blocks: *Block = ir->blocks.data as *Block;
    if (blocks[instruction.block_id].terminated) {
        set_error(ir, runtime::Error.invalid_argument);
        return none;
    }
    if (instruction.result != none) {
        if (instruction.result >= ir->value_count) {
            set_error(ir, runtime::Error.invalid_argument);
            return none;
        }
        let values: *const Value = ir->values.data as *const Value;
        if (values[instruction.result].block_id != instruction.block_id ||
            values[instruction.result].definition != none || values[instruction.result].type_id !=
                instruction.type_id) {
            set_error(ir, runtime::Error.invalid_argument);
            return none;
        }
    }
    let instruction_id: usize = ir->instruction_count;
    let appended: bytes::BufferResult = append(
        ir->instructions, (&instruction) as *const Instruction as *const u8, sizeof(Instruction));
    ir->instructions = appended.buffer;
    if (appended.error != runtime::Error.none) {
        set_error(ir, appended.error);
        return none;
    }
    let result_blocks: *Block = ir->blocks.data as *Block;
    if (result_blocks[instruction.block_id].instruction_count == 0) {
        result_blocks[instruction.block_id].first_instruction = instruction_id;
    } else {
        let instructions: *Instruction = ir->instructions.data as *Instruction;
        instructions[ result_blocks[instruction.block_id].last_instruction].next_instruction = instruction_id;
    }
    result_blocks[instruction.block_id].last_instruction = instruction_id;
    result_blocks[instruction.block_id].instruction_count += 1;
    if (instruction.result != none) {
        let values: *Value = ir->values.data as *Value;
        values[instruction.result].definition = instruction_id;
    }
    ir->instruction_count += 1;

    if (instruction.opcode == Opcode.jump) {
        if (!increment_predecessor(
                ir, instruction.block_id, instruction.auxiliary)) {
            return none;
        }
    } else if (instruction.opcode == Opcode.branch) {
        if (!increment_predecessor(ir, instruction.block_id, instruction.auxiliary) ||
            !increment_predecessor(
                ir, instruction.block_id, instruction.third)) {
            return none;
        }
    }
    if (opcode_is_terminator(
            instruction.opcode)) {
        result_blocks[instruction.block_id].terminated = true;
    }
    return instruction_id;
}

fn add_argument(ir: *Store, instruction_id: usize, value_id: usize) -> bool {
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        instruction_id >= ir->instruction_count || value_id >= ir->value_count) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return false;
    }
    let instructions: *const Instruction = ir->instructions.data as *const Instruction;
    let values: *const Value = ir->values.data as *const Value;
    if ((instructions[instruction_id].opcode != Opcode.call && instructions[instruction_id].opcode !=
            Opcode.call_indirect) || values[value_id].function_id !=
            (ir->blocks.data as *const Block)[ instructions[instruction_id].block_id].function_id) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    let argument: Argument = {
        instruction_id = instruction_id, value_id = value_id,
    };
    let appended: bytes::BufferResult = append(
        ir->arguments, (&argument) as *const Argument as *const u8, sizeof(Argument));
    ir->arguments = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return set_error(ir, appended.error);
    }
    ir->argument_count += 1;
    return true;
}

fn set_entry(ir: *Store, function_id: usize) -> bool {
    if (ir == null || ir->error != runtime::Error.none || !storage_is_valid(*ir) ||
        function_id >= ir->function_count || ir->entry_function != no_id()) {
        if (ir != null) {
            set_error(ir, runtime::Error.invalid_argument);
        }
        return false;
    }
    let functions: *const Function = ir->functions.data as *const Function;
    if (!functions[function_id].has_body) {
        return set_error(ir, runtime::Error.invalid_argument);
    }
    ir->entry_function = function_id;
    return true;
}

fn range_is_valid(first: usize, count: usize, total: usize) -> bool {
    if (count == 0) {
        return first == no_id();
    }
    return first < total && count <= total - first;
}

fn value_operand_is_valid(
    values: *const Value, value_count: usize, value_id: usize, function_id: usize, instruction_id: usize
) -> bool {
    return value_id < value_count && values[value_id].function_id == function_id &&
        values[value_id].definition != no_id() && values[value_id].definition < instruction_id;
}

fn instruction_operands_are_valid(
    instruction: Instruction, instruction_id: usize, function_id: usize, ir: Store,
    values: *const Value) -> bool {
    let none: usize = no_id();
    let unary: bool = instruction.opcode == Opcode.store ||
        instruction.opcode == Opcode.load_indirect || instruction.opcode == Opcode.null_check ||
        instruction.opcode == Opcode.unary_integer || instruction.opcode == Opcode.unary_float ||
        instruction.opcode == Opcode.boolean_not || instruction.opcode == Opcode.convert ||
        instruction.opcode == Opcode.return_value || instruction.opcode == Opcode.call_indirect ||
        instruction.opcode == Opcode.branch || instruction.opcode == Opcode.float_sqrt ||
        instruction.opcode == Opcode.va_list_start || instruction.opcode == Opcode.va_list_arg;
    let binary: bool = instruction.opcode == Opcode.memory_copy ||
        instruction.opcode == Opcode.store_indirect ||
        instruction.opcode == Opcode.bounds_check ||
        instruction.opcode == Opcode.pointer_offset ||
        instruction.opcode == Opcode.binary_integer ||
        instruction.opcode == Opcode.binary_float || instruction.opcode == Opcode.compare ||
        instruction.opcode == Opcode.float_min || instruction.opcode == Opcode.float_max;
    if ((unary || binary) &&
        !value_operand_is_valid(
            values, ir.value_count, instruction.left, function_id, instruction_id)) {
        return false;
    }
    if (binary &&
        !value_operand_is_valid(
            values, ir.value_count, instruction.right, function_id, instruction_id)) {
        return false;
    }
    if (instruction.opcode == Opcode.call) {
        return instruction.auxiliary < ir.function_count;
    }
    if (instruction.opcode == Opcode.address_of_slot || instruction.opcode == Opcode.zero_slot ||
        instruction.opcode == Opcode.load || instruction.opcode == Opcode.store) {
        return instruction.auxiliary < ir.slot_count;
    }
    if (instruction.opcode == Opcode.global_address) {
        return instruction.auxiliary < ir.global_count;
    }
    if (instruction.opcode == Opcode.jump) {
        return instruction.auxiliary < ir.block_count && (ir.blocks.data as *const Block)[
                instruction.auxiliary].function_id == function_id;
    }
    if (instruction.opcode == Opcode.branch) {
        return instruction.auxiliary < ir.block_count && instruction.third < ir.block_count &&
            (ir.blocks.data as *const Block)[ instruction.auxiliary].function_id == function_id &&
            (ir.blocks.data as *const Block)[ instruction.third].function_id == function_id;
    }
    if (instruction.opcode == Opcode.return_void) {
        return instruction.left == none;
    }
    return true;
}

fn carrier_matches_type(types: type_info::Table, carrier_type: usize, source_type: usize) -> bool {
    if (carrier_type == source_type) {
        return true;
    }
    if (carrier_type >= types.type_count || source_type >= types.type_count) {
        return false;
    }
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    return type_info::is_memory(records[source_type].kind) && records[carrier_type].kind ==
            type_info::Kind.pointer && records[carrier_type].element_type == source_type;
}

fn type_can_be_value(types: type_info::Table, type_id: usize) -> bool {
    if (type_id >= types.type_count) {
        return false;
    }
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    return records[type_id].kind != type_info::Kind.invalid && records[type_id].kind != type_info::Kind.type_void;
}

fn instruction_expects_result(
    instruction: Instruction, functions: *const Function, types: type_info::Table) -> bool {
    if (instruction.opcode == Opcode.call) {
        let records: *const type_info::Record = types.types.data as *const type_info::Record;
        return records[ functions[instruction.auxiliary].return_type].kind != type_info::Kind.type_void;
    }
    if (instruction.opcode == Opcode.call_indirect) {
        let records: *const type_info::Record = types.types.data as *const type_info::Record;
        return records[instruction.type_id].kind != type_info::Kind.type_void;
    }
    if (instruction.opcode == Opcode.function_address) {
        return true;
    }
    return instruction.opcode == Opcode.constant_integer ||
        instruction.opcode == Opcode.constant_float ||
        instruction.opcode == Opcode.constant_boolean ||
        instruction.opcode == Opcode.constant_null ||
        instruction.opcode == Opcode.address_of_slot ||
        instruction.opcode == Opcode.member_address ||
        instruction.opcode == Opcode.global_address || instruction.opcode == Opcode.load ||
        instruction.opcode == Opcode.load_indirect ||
        instruction.opcode == Opcode.pointer_offset ||
        instruction.opcode == Opcode.unary_integer || instruction.opcode == Opcode.unary_float ||
        instruction.opcode == Opcode.boolean_not || instruction.opcode == Opcode.convert ||
        instruction.opcode == Opcode.binary_integer ||
        instruction.opcode == Opcode.binary_float || instruction.opcode == Opcode.compare ||
        instruction.opcode == Opcode.float_sqrt || instruction.opcode == Opcode.float_min ||
        instruction.opcode == Opcode.float_max || instruction.opcode == Opcode.overflow_flag ||
        instruction.opcode == Opcode.va_list_arg;
}

fn member_address_offset_is_valid(
    types: type_info::Table, owner_type: usize, offset: usize, element_type: usize, depth: usize) -> bool {
    if (depth > (Limit.maximum_type_depth as usize)) {
        return false;
    }
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let fields: *const type_info::Field = types.fields.data as *const type_info::Field;
    let owner: type_info::Record = records[owner_type];
    var index: usize = 0;
    while (index < owner.field_count) {
        let field: type_info::Field = fields[owner.first_field + index];
        if (field.offset_bytes == offset && field.type_id == element_type) {
            return true;
        }
        let field_record: type_info::Record = records[field.type_id];
        // A flexible array member is addressed as a pointer to its element
        // type at the member offset.
        if ((field_record.flags & (type_info::Flag.flexible as usize)) != 0 && field.offset_bytes == offset &&
            field_record.element_type == element_type) {
            return true;
        }
        // A promoted member of an anonymous record field is addressed through
        // the enclosing record at the accumulated offset.
        if ((field_record.kind == type_info::Kind.structure || field_record.kind == type_info::Kind.record_union) &&
            offset >= field.offset_bytes && offset - field.offset_bytes < field_record.size_bytes &&
            member_address_offset_is_valid(
                types, field.type_id, offset - field.offset_bytes, element_type, depth + 1)) {
            return true;
        }
        index += 1;
    }
    return false;
}

fn member_address_is_valid(
    instruction: Instruction, types: type_info::Table, values: *const Value) -> bool {
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let source_pointer: type_info::Record = records[values[instruction.left].type_id];
    let result_pointer: type_info::Record = records[instruction.type_id];
    if (result_pointer.kind != type_info::Kind.pointer) {
        return false;
    }
    var owner_type: usize = values[instruction.left].type_id;
    var source_read_only: bool = true;
    if (source_pointer.kind == type_info::Kind.pointer) {
        owner_type = source_pointer.element_type;
        source_read_only = (source_pointer.flags & (type_info::Flag.read_only as usize)) != 0;
    } else if (!type_info::is_memory(
            source_pointer.kind)) {
        return false;
    }
    let owner: type_info::Record = records[owner_type];
    if (!type_info::is_memory(owner.kind)) {
        return false;
    }
    if (!member_address_offset_is_valid(
            types, owner_type, instruction.auxiliary, result_pointer.element_type, 0)) {
        return false;
    }
    let result_read_only: bool = (result_pointer.flags & (type_info::Flag.read_only as usize)) != 0;
    return !source_read_only || result_read_only;
}

fn instruction_types_are_valid(
    instruction: Instruction, function_id: usize, types: type_info::Table, values: *const Value,
    functions: *const Function, slots: *const Slot) -> bool {
    let none: usize = no_id();
    let records: *const type_info::Record = types.types.data as *const type_info::Record;
    let expects_result: bool = instruction_expects_result(instruction, functions, types);
    let requires_type: bool = expects_result || instruction.opcode == Opcode.zero_slot ||
        instruction.opcode == Opcode.memory_copy || instruction.opcode == Opcode.store ||
        instruction.opcode == Opcode.store_indirect || instruction.opcode == Opcode.call ||
        instruction.opcode == Opcode.call_indirect || instruction.opcode == Opcode.return_value ||
        instruction.opcode == Opcode.return_void;
    if (expects_result != (instruction.result != none) || (requires_type && instruction.type_id == none) ||
        (expects_result &&
            !type_can_be_value(
                types, instruction.type_id))) {
        return false;
    }

    if (instruction.opcode == Opcode.constant_integer) {
        return type_info::is_integer(records[instruction.type_id].kind) ||
            records[instruction.type_id].kind == type_info::Kind.enumeration;
    }
    if (instruction.opcode == Opcode.constant_float) {
        return type_info::is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.constant_boolean) {
        return instruction.type_id == type_info::BuiltinType.boolean as usize && instruction.immediate <= 1;
    }
    if (instruction.opcode == Opcode.constant_null) {
        return records[instruction.type_id].kind == type_info::Kind.pointer || records[instruction.type_id].kind ==
                type_info::Kind.function_pointer;
    }
    if (instruction.opcode == Opcode.address_of_slot) {
        return slots[instruction.auxiliary].function_id == function_id && records[instruction.type_id].kind ==
                type_info::Kind.pointer && records[instruction.type_id].element_type ==
                slots[instruction.auxiliary].type_id;
    }
    if (instruction.opcode == Opcode.member_address) {
        return member_address_is_valid(instruction, types, values);
    }
    if (instruction.opcode == Opcode.global_address) {
        let result_pointer: type_info::Record = records[instruction.type_id];
        if (result_pointer.kind != type_info::Kind.pointer ||
            (result_pointer.flags & (type_info::Flag.read_only as usize)) == 0) {
            return false;
        }
        var element_type: usize = result_pointer.element_type;
        if (records[element_type].kind == type_info::Kind.array) {
            // @embed addresses a whole byte-array global rather than a scalar string element.
            element_type = records[element_type].element_type;
        }
        return element_type == type_info::BuiltinType.unsigned_8 as usize ||
            element_type == type_info::BuiltinType.unsigned_16 as usize ||
            element_type == type_info::BuiltinType.unsigned_32 as usize;
    }
    if (instruction.opcode == Opcode.zero_slot) {
        return slots[instruction.auxiliary].function_id == function_id && slots[instruction.auxiliary].type_id ==
                instruction.type_id && type_info::is_memory(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.load) {
        return slots[instruction.auxiliary].function_id == function_id && slots[instruction.auxiliary].type_id ==
                instruction.type_id && type_info::is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.store) {
        return slots[instruction.auxiliary].function_id == function_id && slots[instruction.auxiliary].type_id ==
                values[instruction.left].type_id && instruction.type_id == values[instruction.left].type_id &&
            type_info::is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.load_indirect) {
        let pointer: type_info::Record = records[values[instruction.left].type_id];
        return pointer.kind == type_info::Kind.pointer && pointer.element_type == instruction.type_id &&
            type_info::is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.store_indirect || instruction.opcode == Opcode.memory_copy) {
        let destination: type_info::Record = records[values[instruction.left].type_id];
        if (destination.kind != type_info::Kind.pointer || destination.element_type != instruction.type_id ||
            (destination.flags & (type_info::Flag.read_only as usize)) != 0 ||
            !carrier_matches_type(types, values[instruction.right].type_id, instruction.type_id) ||
            instruction.auxiliary != records[instruction.type_id].size_bytes) {
            return false;
        }
        return instruction.opcode == Opcode.memory_copy ?
            type_info::is_memory(records[instruction.type_id].kind) :
            type_info::is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.null_check) {
        let checked: type_info::Kind = records[values[instruction.left].type_id].kind;
        return checked == type_info::Kind.pointer || checked == type_info::Kind.function_pointer;
    }
    if (instruction.opcode == Opcode.bounds_check) {
        return values[instruction.left].type_id == type_info::BuiltinType.unsigned_size as usize &&
            values[instruction.right].type_id == type_info::BuiltinType.unsigned_size as usize;
    }
    if (instruction.opcode == Opcode.pointer_offset) {
        let source: type_info::Record = records[values[instruction.left].type_id];
        let result: type_info::Record = records[instruction.type_id];
        let temporary_array: bool = source.kind == type_info::Kind.array;
        var element_matches: bool = source.element_type == result.element_type;
        if (source.kind == type_info::Kind.pointer && records[source.element_type].kind == type_info::Kind.array) {
            element_matches = records[source.element_type].element_type == result.element_type;
        }
        let qualifier_matches: bool = temporary_array ? (result.flags & (type_info::Flag.read_only as usize)) != 0 :
                source.flags == result.flags;
        return (source.kind == type_info::Kind.pointer || temporary_array) &&
            result.kind == type_info::Kind.pointer && element_matches && qualifier_matches &&
            values[instruction.right].type_id == type_info::BuiltinType.unsigned_size as usize &&
                instruction.auxiliary == records[result.element_type].size_bytes;
    }
    if (instruction.opcode == Opcode.unary_integer) {
        return values[instruction.left].type_id == instruction.type_id &&
            type_info::is_integer(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.unary_float) {
        return values[instruction.left].type_id == instruction.type_id &&
            type_info::is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.float_sqrt) {
        return values[instruction.left].type_id == instruction.type_id &&
            type_info::is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.boolean_not) {
        return values[instruction.left].type_id == type_info::BuiltinType.boolean as usize && instruction.type_id ==
                type_info::BuiltinType.boolean as usize;
    }
    if (instruction.opcode == Opcode.convert) {
        return instruction.auxiliary < types.type_count && values[instruction.left].type_id == instruction.auxiliary &&
            type_info::is_scalar(records[instruction.auxiliary].kind) &&
            type_info::is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.binary_integer || instruction.opcode ==
            Opcode.binary_float) {
        let integer_operation: bool = instruction.opcode == Opcode.binary_integer;
        return values[instruction.left].type_id == instruction.type_id && values[instruction.right].type_id ==
                instruction.type_id && (integer_operation ?
                type_info::is_integer(records[instruction.type_id].kind) :
                type_info::is_float(
                    records[instruction.type_id].kind));
    }
    if (instruction.opcode == Opcode.float_min || instruction.opcode == Opcode.float_max) {
        return values[instruction.left].type_id == instruction.type_id && values[instruction.right].type_id ==
                instruction.type_id && type_info::is_float(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.overflow_flag) {
        return instruction.type_id == type_info::BuiltinType.boolean as usize;
    }
    if (instruction.opcode == Opcode.compare) {
        return instruction.type_id == type_info::BuiltinType.boolean as usize && values[instruction.left].type_id ==
                values[instruction.right].type_id &&
            type_info::is_scalar(records[ values[instruction.left].type_id].kind);
    }
    if (instruction.opcode == Opcode.call) {
        return instruction.type_id == functions[instruction.auxiliary].return_type;
    }
    if (instruction.opcode == Opcode.call_indirect) {
        if (instruction.left >= no_id()) {
            return false;
        }
        let callee: type_info::Record = records[values[instruction.left].type_id];
        return callee.kind == type_info::Kind.function_pointer && callee.element_type == instruction.type_id;
    }
    if (instruction.opcode == Opcode.function_address) {
        return records[instruction.type_id].kind == type_info::Kind.function_pointer;
    }
    if (instruction.opcode == Opcode.va_list_start || instruction.opcode == Opcode.va_list_arg) {
        // Both walk a caller-owned va_list through a mutable pointer to it;
        // va_arg additionally yields a scalar at the requested width.
        let pointer: type_info::Record = records[values[instruction.left].type_id];
        if (pointer.kind != type_info::Kind.pointer || pointer.element_type >= types.type_count ||
            records[pointer.element_type].kind != type_info::Kind.va_list_type ||
            (pointer.flags & (type_info::Flag.read_only as usize)) != 0) {
            return false;
        }
        return instruction.opcode == Opcode.va_list_start ? instruction.type_id == none :
            type_info::is_scalar(records[instruction.type_id].kind);
    }
    if (instruction.opcode == Opcode.branch) {
        return instruction.type_id == none && values[instruction.left].type_id ==
            type_info::BuiltinType.boolean as usize;
    }
    if (instruction.opcode == Opcode.jump) {
        return instruction.type_id == none;
    }
    if (instruction.opcode == Opcode.return_value) {
        return instruction.type_id == functions[function_id].return_type &&
            carrier_matches_type(types, values[instruction.left].type_id, instruction.type_id);
    }
    if (instruction.opcode == Opcode.return_void) {
        return instruction.type_id == functions[function_id].return_type && records[instruction.type_id].kind ==
                type_info::Kind.type_void;
    }
    return instruction.type_id == none;
}

fn is_valid(ir: Store, types: type_info::Table) -> bool {
    let none: usize = no_id();
    if (ir.error != runtime::Error.none || !storage_is_valid(ir) ||
        !type_info::table_is_valid(types, true) || (ir.entry_function != none &&
            ir.entry_function >= ir.function_count)) {
        return false;
    }
    let globals: *const Global = ir.globals.data as *const Global;
    let functions: *const Function = ir.functions.data as *const Function;
    let parameters: *const Parameter = ir.parameters.data as *const Parameter;
    let slots: *const Slot = ir.slots.data as *const Slot;
    let values: *const Value = ir.values.data as *const Value;
    let blocks: *const Block = ir.blocks.data as *const Block;
    let instructions: *const Instruction = ir.instructions.data as *const Instruction;
    let arguments: *const Argument = ir.arguments.data as *const Argument;
    let type_records: *const type_info::Record = types.types.data as *const type_info::Record;

    var index: usize = 0;
    var expected_global_offset: usize = 0;
    while (index < ir.global_count) {
        let global: Global = globals[index];
        if (global.byte_count == 0 || global.byte_offset != expected_global_offset ||
            global.byte_offset > ir.global_bytes.length || global.byte_count >
                ir.global_bytes.length - global.byte_offset || global.alignment_bytes == 0 ||
            global.alignment_bytes > 8 || (global.alignment_bytes & (global.alignment_bytes - 1)) != 0) {
            return false;
        }
        expected_global_offset += global.byte_count;
        index += 1;
    }
    if (expected_global_offset != ir.global_bytes.length) {
        return false;
    }

    var counted_parameters: usize = 0;
    var counted_slots: usize = 0;
    var counted_blocks: usize = 0;
    var counted_values: usize = 0;
    index = 0;
    while (index < ir.function_count) {
        let function: Function = functions[index];
        if (function.declaration_unit == none || function.declaration_node == none || function.name_token == none ||
            (function.linkage as usize) > (Linkage.external_c as usize) ||
            function.return_type >= types.type_count || type_records[function.return_type].kind ==
                type_info::Kind.invalid ||
            !range_is_valid(function.first_parameter, function.parameter_count, ir.parameter_count) ||
            !range_is_valid(function.first_block, function.block_count, ir.block_count) ||
            !range_is_valid(function.first_value, function.value_count, ir.value_count) ||
            (function.has_body && function.block_count == 0 && function.asm_body_node == none) ||
            (!function.has_body && (function.block_count != 0 ||
                    function.value_count != 0 || function.slot_count != function.parameter_count))) {
            return false;
        }
        counted_parameters += function.parameter_count;
        counted_slots += function.slot_count;
        counted_blocks += function.block_count;
        counted_values += function.value_count;
        var item: usize = 0;
        while (item < function.parameter_count) {
            let parameter: Parameter = parameters[function.first_parameter + item];
            if (parameter.function_id != index || parameter.type_id >= types.type_count ||
                !type_can_be_value(types, parameter.type_id) ||
                parameter.slot_id >= ir.slot_count || slots[parameter.slot_id].function_id != index ||
                slots[parameter.slot_id].type_id != parameter.type_id || parameter.name_token == none) {
                return false;
            }
            item += 1;
        }
        var owned_slot_count: usize = 0;
        var first_owned_slot: usize = none;
        item = 0;
        while (item < ir.slot_count) {
            if (slots[item].function_id == index) {
                if (owned_slot_count == 0) {
                    first_owned_slot = item;
                }
                owned_slot_count += 1;
            }
            item += 1;
        }
        if (owned_slot_count != function.slot_count || first_owned_slot != function.first_slot) {
            return false;
        }
        item = 0;
        while (item < function.value_count) {
            let value: Value = values[function.first_value + item];
            if (value.function_id != index || value.block_id >= ir.block_count ||
                !type_can_be_value(types, value.type_id) || value.definition >= ir.instruction_count) {
                return false;
            }
            item += 1;
        }
        index += 1;
    }
    if (counted_parameters != ir.parameter_count || counted_slots != ir.slot_count ||
        counted_blocks != ir.block_count || counted_values != ir.value_count) {
        return false;
    }
    if (ir.entry_function != none) {
        let entry: Function = functions[ir.entry_function];
        if (!entry.has_body || entry.linkage != Linkage.internal ||
                entry.return_type != type_info::BuiltinType.signed_32 as usize ||
                (entry.parameter_count != 0 && entry.parameter_count != 2)) {
            return false;
        }
        if (entry.parameter_count == 2) {
            let argument_count: Parameter = parameters[entry.first_parameter];
            let argument_vector: Parameter = parameters[entry.first_parameter + 1];
            let outer: type_info::Record = type_records[argument_vector.type_id];
            if (argument_count.type_id != type_info::BuiltinType.unsigned_size as usize ||
                outer.kind != type_info::Kind.pointer || (outer.flags &
                    (type_info::Flag.read_only as usize)) != 0) {
                return false;
            }
            let inner: type_info::Record = type_records[outer.element_type];
            if (inner.kind != type_info::Kind.pointer || (inner.flags &
                    (type_info::Flag.read_only as usize)) == 0 || inner.element_type !=
                    type_info::BuiltinType.unsigned_8 as usize) {
                return false;
            }
        }
    }

    index = 0;
    while (index < ir.slot_count) {
        if (slots[index].function_id >= ir.function_count ||
            !type_can_be_value(
                types, slots[index].type_id) ||
            slots[index].alignment_bytes > (Limit.maximum_slot_alignment as usize) ||
            (slots[index].alignment_bytes & (slots[index].alignment_bytes - 1)) != 0) {
            return false;
        }
        index += 1;
    }

    index = 0;
    var counted_instructions: usize = 0;
    while (index < ir.block_count) {
        let block: Block = blocks[index];
        if (block.function_id >= ir.function_count || (block.instruction_count == 0 &&
                (block.first_instruction != none || block.last_instruction != none || block.terminated)) ||
            (block.instruction_count != 0 && (block.first_instruction >= ir.instruction_count ||
                    block.last_instruction >= ir.instruction_count || !block.terminated))) {
            return false;
        }
        counted_instructions += block.instruction_count;
        var instruction_id: usize = block.first_instruction;
        var visited: usize = 0;
        var previous: usize = none;
        while (visited < block.instruction_count) {
            if (instruction_id >= ir.instruction_count || instructions[instruction_id].block_id != index) {
                return false;
            }
            if (opcode_is_terminator(
                    instructions[instruction_id].opcode) && visited + 1 != block.instruction_count) {
                return false;
            }
            previous = instruction_id;
            instruction_id = instructions[instruction_id].next_instruction;
            visited += 1;
        }
        if (block.instruction_count != 0 && (previous != block.last_instruction || instruction_id != none ||
                !opcode_is_terminator(
                    instructions[block.last_instruction].opcode))) {
            return false;
        }
        index += 1;
    }
    if (counted_instructions != ir.instruction_count) {
        return false;
    }

    index = 0;
    while (index < ir.block_count) {
        var expected_predecessors: usize = 0;
        var instruction_index: usize = 0;
        while (instruction_index < ir.instruction_count) {
            let candidate: Instruction = instructions[instruction_index];
            if (candidate.opcode == Opcode.jump && candidate.auxiliary == index) {
                expected_predecessors += 1;
            }
            if (candidate.opcode == Opcode.branch && candidate.auxiliary == index) {
                expected_predecessors += 1;
            }
            if (candidate.opcode == Opcode.branch && candidate.third == index) {
                expected_predecessors += 1;
            }
            instruction_index += 1;
        }
        if (blocks[index].predecessor_count != expected_predecessors) {
            return false;
        }
        index += 1;
    }

    index = 0;
    while (index < ir.instruction_count) {
        let instruction: Instruction = instructions[index];
        if ((instruction.opcode as usize) > (Opcode.va_list_arg as usize) ||
            instruction.opcode == Opcode.invalid || instruction.block_id >= ir.block_count ||
            instruction.span.line == 0 || instruction.span.column == 0 || (instruction.type_id != none &&
                instruction.type_id >= types.type_count) || (instruction.result != none &&
                (instruction.result >= ir.value_count || values[instruction.result].definition != index ||
                    values[instruction.result].block_id != instruction.block_id || values[instruction.result].type_id !=
                        instruction.type_id)) ||
            !instruction_operands_are_valid(
                instruction, index, blocks[instruction.block_id].function_id, ir, values) ||
            !instruction_types_are_valid(
                instruction, blocks[instruction.block_id].function_id, types, values, functions, slots)) {
            return false;
        }
        if (instruction.opcode == Opcode.call || instruction.opcode == Opcode.call_indirect) {
            var call_parameter_count: usize = 0;
            var call_variadic: bool = false;
            if (instruction.opcode == Opcode.call) {
                call_parameter_count = functions[instruction.auxiliary].parameter_count;
                call_variadic = functions[instruction.auxiliary].variadic;
            } else {
                let callee_records: *const
                    type_info::Record = types.types.data as
                        *const type_info::Record;
                let callee: type_info::Record = callee_records[ values[instruction.left].type_id];
                call_parameter_count = callee.field_count;
            }
            var call_argument_count: usize = 0;
            var argument_index: usize = 0;
            while (argument_index < ir.argument_count) {
                let argument: Argument = arguments[argument_index];
                if (argument.instruction_id == index) {
                    if (argument.value_id >= ir.value_count ||
                        values[argument.value_id].function_id != blocks[ instruction.block_id].function_id ||
                        values[argument.value_id].definition >= index) {
                        return false;
                    }
                    // Variadic extras carry no declared parameter type; the
                    // call site classifies them at their own width instead.
                    if (call_argument_count >= call_parameter_count) {
                        if (!call_variadic) {
                            return false;
                        }
                    } else {
                        var parameter_type: usize = no_id();
                        if (instruction.opcode == Opcode.call) {
                            let parameters: *const
                                Parameter = ir.parameters.data as
                                    *const Parameter;
                            parameter_type = parameters[ functions[instruction.auxiliary].first_parameter +
                                        call_argument_count].type_id;
                        } else {
                            let fields: *const type_info::Field = types.fields.data as
                                    *const type_info::Field;
                            let records: *const
                                type_info::Record = types.types.data as
                                    *const type_info::Record;
                            let callee: type_info::Record = records[ values[instruction.left].type_id];
                            parameter_type = fields[ callee.first_field + call_argument_count].type_id;
                        }
                        if (!carrier_matches_type(
                                types, values[argument.value_id].type_id, parameter_type)) {
                            return false;
                        }
                    }
                    call_argument_count += 1;
                }
                argument_index += 1;
            }
            if (call_variadic ? call_argument_count < call_parameter_count : call_argument_count !=
                    call_parameter_count) {
                return false;
            }
        }
        index += 1;
    }

    index = 0;
    while (index < ir.argument_count) {
        let argument: Argument = arguments[index];
        if (argument.instruction_id >= ir.instruction_count || argument.value_id >= ir.value_count ||
            (instructions[argument.instruction_id].opcode != Opcode.call &&
                instructions[argument.instruction_id].opcode != Opcode.call_indirect)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn release(ir: Store) -> runtime::Error {
    if (!storage_is_valid(ir)) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = bytes::release(ir.globals);
    let global_bytes_error: runtime::Error = bytes::release(ir.global_bytes);
    if (error == runtime::Error.none) {
        error = global_bytes_error;
    }
    let function_error: runtime::Error = bytes::release(ir.functions);
    if (error == runtime::Error.none) {
        error = function_error;
    }
    let parameter_error: runtime::Error = bytes::release(ir.parameters);
    if (error == runtime::Error.none) {
        error = parameter_error;
    }
    let slot_error: runtime::Error = bytes::release(ir.slots);
    if (error == runtime::Error.none) {
        error = slot_error;
    }
    let value_error: runtime::Error = bytes::release(ir.values);
    if (error == runtime::Error.none) {
        error = value_error;
    }
    let block_error: runtime::Error = bytes::release(ir.blocks);
    if (error == runtime::Error.none) {
        error = block_error;
    }
    let instruction_error: runtime::Error = bytes::release(ir.instructions);
    if (error == runtime::Error.none) {
        error = instruction_error;
    }
    let argument_error: runtime::Error = bytes::release(ir.arguments);
    if (error == runtime::Error.none) {
        error = argument_error;
    }
    return error;
}

