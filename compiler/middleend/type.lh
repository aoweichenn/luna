export module luna.bootstrap.middleend.type;

import luna.bootstrap.frontend.lexer;
import luna.runtime;
import luna.std.bytes;

export enum BootstrapTypeKind: usize {
    invalid, type_void, boolean, signed_8, signed_16, signed_32, signed_64, signed_size, unsigned_8, unsigned_16,
    unsigned_32, unsigned_64, unsigned_size, float_32, float_64, pointer, array, structure, record_union, enumeration,
    alias, function_pointer, va_list_type,
}

export enum BootstrapBuiltinType: usize {
    invalid = 0, type_void = 1, boolean = 2, signed_8 = 3, signed_16 = 4, signed_32 = 5, signed_64 = 6, signed_size = 7,
    unsigned_8 = 8, unsigned_16 = 9, unsigned_32 = 10, unsigned_64 = 11, unsigned_size = 12, float_32 = 13,
    float_64 = 14, va_list_type = 15, count = 16,
}

export enum BootstrapTypeFlag: usize {
    none = 0, read_only = 1, complete = 2, resolving = 4, exported = 8, volatile_pointee = 16, packed = 32,
    flexible = 64, header = 128,
}

export struct BootstrapTypeRecord {
    kind: BootstrapTypeKind;
    element_type: usize;
    element_count: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    first_field: usize;
    field_count: usize;
    size_bytes: usize;
    alignment_bytes: usize;
    flags: usize;
}

export struct BootstrapTypeField {
    owner_type: usize;
    type_id: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    offset_bytes: usize;
    // Raised field alignment from @align, zero means natural alignment.
    alignment_bytes: usize;
}

export struct BootstrapTypeTable {
    types: bytes::Buffer;
    type_count: usize;
    fields: bytes::Buffer;
    field_count: usize;
}

export struct BootstrapTypeRecordResult {
    record: BootstrapTypeRecord;
    error: runtime::Error;
}

export struct BootstrapTypeFieldResult {
    field: BootstrapTypeField;
    error: runtime::Error;
}

export struct BootstrapTypeIdResult {
    type_id: usize;
    error: runtime::Error;
}

export struct BootstrapTypeTableResult {
    table: BootstrapTypeTable;
    error: runtime::Error;
}

export fn bootstrap_type_no_id() -> usize;
export fn bootstrap_type_table_empty() -> BootstrapTypeTable;
export fn bootstrap_type_table_create() -> BootstrapTypeTableResult;
export fn bootstrap_type_table_storage_is_valid(table: BootstrapTypeTable) -> bool;
export fn bootstrap_type_table_is_valid(table: BootstrapTypeTable, require_complete: bool) -> bool;
export fn bootstrap_type_table_get(table: BootstrapTypeTable, type_id: usize) -> BootstrapTypeRecordResult;
export fn bootstrap_type_table_get_field(table: BootstrapTypeTable, field_id: usize) -> BootstrapTypeFieldResult;
export fn bootstrap_type_table_add_named(
    table: BootstrapTypeTable, kind: BootstrapTypeKind, declaration_unit: usize, declaration_node: usize,
    name_token: usize, exported: bool) -> BootstrapTypeTableResult;
export fn bootstrap_type_table_pointer(
    table: *BootstrapTypeTable, element_type: usize, read_only: bool, volatile_pointee: bool) -> BootstrapTypeIdResult;
export fn bootstrap_type_table_array(
    table: *BootstrapTypeTable, element_type: usize, element_count: usize) -> BootstrapTypeIdResult;
export fn bootstrap_type_table_flexible_array(
    table: *BootstrapTypeTable, element_type: usize) -> BootstrapTypeIdResult;
export fn bootstrap_type_table_add_field(
    table: BootstrapTypeTable, field: BootstrapTypeField) -> BootstrapTypeTableResult;
export fn bootstrap_type_table_add_function_pointer(
    table: BootstrapTypeTable, return_type: usize) -> BootstrapTypeTableResult;
export fn bootstrap_type_table_add_parameter(
    table: BootstrapTypeTable, owner_type: usize, parameter_type: usize) -> BootstrapTypeTableResult;
export fn bootstrap_type_table_set_layout(
    table: BootstrapTypeTable, type_id: usize, size_bytes: usize, alignment_bytes: usize) -> runtime::Error;
export fn bootstrap_type_table_set_packed(table: BootstrapTypeTable, type_id: usize, packed: bool) -> runtime::Error;
export fn bootstrap_type_table_set_header(table: BootstrapTypeTable, type_id: usize, header: bool) -> runtime::Error;
export fn bootstrap_type_table_set_enum_underlying(
    table: BootstrapTypeTable, type_id: usize, underlying_type: usize) -> runtime::Error;
export fn bootstrap_type_table_set_alias_target(
    table: BootstrapTypeTable, type_id: usize, target_type: usize) -> runtime::Error;
export fn bootstrap_type_table_set_resolving(
    table: BootstrapTypeTable, type_id: usize, resolving: bool) -> runtime::Error;
export fn bootstrap_type_table_release(table: BootstrapTypeTable) -> runtime::Error;

export fn bootstrap_type_is_integer(kind: BootstrapTypeKind) -> bool;
export fn bootstrap_type_is_signed_integer(kind: BootstrapTypeKind) -> bool;
export fn bootstrap_type_is_float(kind: BootstrapTypeKind) -> bool;
export fn bootstrap_type_is_scalar(kind: BootstrapTypeKind) -> bool;
export fn bootstrap_type_is_memory(kind: BootstrapTypeKind) -> bool;
export fn bootstrap_type_bit_width(kind: BootstrapTypeKind) -> usize;

