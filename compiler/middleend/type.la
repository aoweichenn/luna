module luna.bootstrap.middleend.type;

enum BootstrapTypeLimit: usize {
    maximum_size = 18446744073709551615, target_pointer_bytes = 8, target_pointer_alignment = 8,
    maximum_alignment = 4096,
}

fn bootstrap_type_no_id() -> usize {
    return BootstrapTypeLimit.maximum_size as usize;
}

fn bootstrap_type_invalid_record() -> BootstrapTypeRecord {
    let none: usize = bootstrap_type_no_id();
    return {
        kind = BootstrapTypeKind.invalid, element_type = none, element_count = 0, declaration_unit = none,
        declaration_node = none, name_token = none, first_field = none, field_count = 0, size_bytes = 0,
        alignment_bytes = 0, flags = BootstrapTypeFlag.none as usize,
    };
}

fn bootstrap_type_invalid_field() -> BootstrapTypeField {
    let none: usize = bootstrap_type_no_id();
    return {
        owner_type = none, type_id = none, declaration_unit = none, declaration_node = none, name_token = none,
        offset_bytes = 0, alignment_bytes = 0,
    };
}

fn bootstrap_type_table_empty() -> BootstrapTypeTable {
    return {
        types = bytes::empty(), type_count = 0, fields = bytes::empty(), field_count = 0,
    };
}

fn bootstrap_type_table_storage_is_valid(table: BootstrapTypeTable) -> bool {
    return bytes::is_valid(table.types) && bytes::is_valid(table.fields) &&
        table.types.length % sizeof(BootstrapTypeRecord) == 0 &&
        table.fields.length % sizeof(BootstrapTypeField) == 0 && table.type_count ==
            table.types.length / sizeof(BootstrapTypeRecord) && table.field_count ==
            table.fields.length / sizeof(BootstrapTypeField);
}

fn bootstrap_type_table_get(table: BootstrapTypeTable, type_id: usize) -> BootstrapTypeRecordResult {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id >= table.type_count) {
        return {
            record = bootstrap_type_invalid_record(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const BootstrapTypeRecord = table.types.data as *const BootstrapTypeRecord;
    return {
        record = records[type_id], error = runtime::Error.none,
    };
}

fn bootstrap_type_table_get_field(table: BootstrapTypeTable, field_id: usize) -> BootstrapTypeFieldResult {
    if (!bootstrap_type_table_storage_is_valid(table) || field_id >= table.field_count) {
        return {
            field = bootstrap_type_invalid_field(), error = runtime::Error.invalid_argument,
        };
    }
    let fields: *const BootstrapTypeField = table.fields.data as *const BootstrapTypeField;
    return {
        field = fields[field_id], error = runtime::Error.none,
    };
}

fn bootstrap_type_append_record(table: BootstrapTypeTable, record: BootstrapTypeRecord) -> BootstrapTypeTableResult {
    if (!bootstrap_type_table_storage_is_valid(table) || table.type_count ==
            (BootstrapTypeLimit.maximum_size as usize)) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let appended: bytes::BufferResult = bytes::append(
        table.types, (&record) as *const BootstrapTypeRecord as *const u8, sizeof(BootstrapTypeRecord));
    var result: BootstrapTypeTable = table;
    result.types = appended.buffer;
    if (appended.error == runtime::Error.none) {
        result.type_count += 1;
    }
    return {
        table = result, error = appended.error,
    };
}

fn bootstrap_type_builtin_record(
    kind: BootstrapTypeKind, size_bytes: usize, alignment_bytes: usize) -> BootstrapTypeRecord {
    var record: BootstrapTypeRecord = bootstrap_type_invalid_record();
    record.kind = kind;
    record.size_bytes = size_bytes;
    record.alignment_bytes = alignment_bytes;
    record.flags = BootstrapTypeFlag.complete as usize;
    return record;
}

fn bootstrap_type_builtin_kind(index: usize) -> BootstrapTypeKind {
    if (index == BootstrapBuiltinType.type_void as usize) {
        return BootstrapTypeKind.type_void;
    }
    if (index == BootstrapBuiltinType.boolean as usize) {
        return BootstrapTypeKind.boolean;
    }
    if (index == BootstrapBuiltinType.signed_8 as usize) {
        return BootstrapTypeKind.signed_8;
    }
    if (index == BootstrapBuiltinType.signed_16 as usize) {
        return BootstrapTypeKind.signed_16;
    }
    if (index == BootstrapBuiltinType.signed_32 as usize) {
        return BootstrapTypeKind.signed_32;
    }
    if (index == BootstrapBuiltinType.signed_64 as usize) {
        return BootstrapTypeKind.signed_64;
    }
    if (index == BootstrapBuiltinType.signed_size as usize) {
        return BootstrapTypeKind.signed_size;
    }
    if (index == BootstrapBuiltinType.unsigned_8 as usize) {
        return BootstrapTypeKind.unsigned_8;
    }
    if (index == BootstrapBuiltinType.unsigned_16 as usize) {
        return BootstrapTypeKind.unsigned_16;
    }
    if (index == BootstrapBuiltinType.unsigned_32 as usize) {
        return BootstrapTypeKind.unsigned_32;
    }
    if (index == BootstrapBuiltinType.unsigned_64 as usize) {
        return BootstrapTypeKind.unsigned_64;
    }
    if (index == BootstrapBuiltinType.unsigned_size as usize) {
        return BootstrapTypeKind.unsigned_size;
    }
    if (index == BootstrapBuiltinType.float_32 as usize) {
        return BootstrapTypeKind.float_32;
    }
    if (index == BootstrapBuiltinType.float_64 as usize) {
        return BootstrapTypeKind.float_64;
    }
    if (index == BootstrapBuiltinType.va_list_type as usize) {
        return BootstrapTypeKind.va_list_type;
    }
    return BootstrapTypeKind.invalid;
}

fn bootstrap_type_builtin_size(index: usize) -> usize {
    if (index == BootstrapBuiltinType.type_void as usize || index == BootstrapBuiltinType.invalid as usize) {
        return 0;
    }
    // The System V va_list object: u32 gp_offset, u32 fp_offset, then the
    // overflow_arg_area and reg_save_area pointers.
    if (index == BootstrapBuiltinType.va_list_type as usize) {
        return 24;
    }
    return bootstrap_type_bit_width(bootstrap_type_builtin_kind(index)) / 8;
}

fn bootstrap_type_builtin_alignment(index: usize) -> usize {
    if (index == BootstrapBuiltinType.va_list_type as usize) {
        return 8;
    }
    return bootstrap_type_builtin_size(index);
}

fn bootstrap_type_table_create() -> BootstrapTypeTableResult {
    var table: BootstrapTypeTable = bootstrap_type_table_empty();
    var index: usize = 0;
    while (index < BootstrapBuiltinType.count as usize) {
        let size_bytes: usize = bootstrap_type_builtin_size(index);
        let added: BootstrapTypeTableResult =
            bootstrap_type_append_record(
                table, bootstrap_type_builtin_record(
                    bootstrap_type_builtin_kind(index), size_bytes, bootstrap_type_builtin_alignment(index)));
        table = added.table;
        if (added.error != runtime::Error.none) {
            bootstrap_type_table_release(table);
            return {
                table = bootstrap_type_table_empty(), error = added.error,
            };
        }
        index += 1;
    }
    return {
        table = table, error = runtime::Error.none,
    };
}

fn bootstrap_type_kind_is_named(kind: BootstrapTypeKind) -> bool {
    return kind == BootstrapTypeKind.structure || kind == BootstrapTypeKind.record_union ||
        kind == BootstrapTypeKind.enumeration;
}

fn bootstrap_type_kind_is_declared(kind: BootstrapTypeKind) -> bool {
    return bootstrap_type_kind_is_named(kind) || kind == BootstrapTypeKind.alias;
}

fn bootstrap_type_table_add_named(
    table: BootstrapTypeTable, kind: BootstrapTypeKind, declaration_unit: usize, declaration_node: usize,
    name_token: usize, exported: bool) -> BootstrapTypeTableResult {
    if (!bootstrap_type_kind_is_declared(kind) || declaration_unit == bootstrap_type_no_id() ||
        declaration_node == bootstrap_type_no_id() || name_token == bootstrap_type_no_id()) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    var record: BootstrapTypeRecord = bootstrap_type_invalid_record();
    record.kind = kind;
    record.declaration_unit = declaration_unit;
    record.declaration_node = declaration_node;
    record.name_token = name_token;
    if (exported) {
        record.flags = BootstrapTypeFlag.exported as usize;
    }
    return bootstrap_type_append_record(table, record);
}

fn bootstrap_type_table_pointer(
    table: *BootstrapTypeTable, element_type: usize, read_only: bool, volatile_pointee: bool) -> BootstrapTypeIdResult {
    if (table == null || !bootstrap_type_table_storage_is_valid(*table) || element_type >= table->type_count) {
        return {
            type_id = bootstrap_type_no_id(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const BootstrapTypeRecord = table->types.data as *const BootstrapTypeRecord;
    if (records[element_type].kind == BootstrapTypeKind.invalid) {
        return {
            type_id = bootstrap_type_no_id(), error = runtime::Error.invalid_argument,
        };
    }
    var index: usize = BootstrapBuiltinType.count as usize;
    while (index < table->type_count) {
        let record: BootstrapTypeRecord = records[index];
        let record_read_only: bool = (record.flags & (BootstrapTypeFlag.read_only as usize)) != 0;
        let record_volatile: bool = (record.flags & (BootstrapTypeFlag.volatile_pointee as usize)) != 0;
        if (record.kind == BootstrapTypeKind.pointer && record.element_type == element_type &&
            record_read_only == read_only && record_volatile == volatile_pointee) {
            return {
                type_id = index, error = runtime::Error.none,
            };
        }
        index += 1;
    }

    var record: BootstrapTypeRecord = bootstrap_type_invalid_record();
    record.kind = BootstrapTypeKind.pointer;
    record.element_type = element_type;
    record.size_bytes = BootstrapTypeLimit.target_pointer_bytes as usize;
    record.alignment_bytes = BootstrapTypeLimit.target_pointer_alignment as usize;
    record.flags = BootstrapTypeFlag.complete as usize;
    if (read_only) {
        record.flags |= BootstrapTypeFlag.read_only as usize;
    }
    if (volatile_pointee) {
        record.flags |= BootstrapTypeFlag.volatile_pointee as usize;
    }
    let type_id: usize = table->type_count;
    let added: BootstrapTypeTableResult = bootstrap_type_append_record(*table, record);
    *table = added.table;
    return {
        type_id = added.error == runtime::Error.none ? type_id : bootstrap_type_no_id(), error = added.error,
    };
}

fn bootstrap_type_table_array(
    table: *BootstrapTypeTable, element_type: usize, element_count: usize) -> BootstrapTypeIdResult {
    if (table == null || !bootstrap_type_table_storage_is_valid(*table) || element_type >= table->type_count ||
        element_count == 0) {
        return {
            type_id = bootstrap_type_no_id(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const BootstrapTypeRecord = table->types.data as *const BootstrapTypeRecord;
    let element: BootstrapTypeRecord = records[element_type];
    if ((element.flags & (BootstrapTypeFlag.complete as usize)) == 0 || element.size_bytes == 0 || element_count >
            (BootstrapTypeLimit.maximum_size as usize) / element.size_bytes) {
        return {
            type_id = bootstrap_type_no_id(), error = runtime::Error.invalid_argument,
        };
    }
    var index: usize = BootstrapBuiltinType.count as usize;
    while (index < table->type_count) {
        let record: BootstrapTypeRecord = records[index];
        if (record.kind == BootstrapTypeKind.array && record.element_type == element_type &&
            record.element_count == element_count) {
            return {
                type_id = index, error = runtime::Error.none,
            };
        }
        index += 1;
    }

    var record: BootstrapTypeRecord = bootstrap_type_invalid_record();
    record.kind = BootstrapTypeKind.array;
    record.element_type = element_type;
    record.element_count = element_count;
    record.size_bytes = element.size_bytes * element_count;
    record.alignment_bytes = element.alignment_bytes;
    record.flags = BootstrapTypeFlag.complete as usize;
    let type_id: usize = table->type_count;
    let added: BootstrapTypeTableResult = bootstrap_type_append_record(*table, record);
    *table = added.table;
    return {
        type_id = added.error == runtime::Error.none ? type_id : bootstrap_type_no_id(), error = added.error,
    };
}

fn bootstrap_type_table_flexible_array(
    table: *BootstrapTypeTable, element_type: usize) -> BootstrapTypeIdResult {
    if (table == null || !bootstrap_type_table_storage_is_valid(*table) || element_type >= table->type_count) {
        return {
            type_id = bootstrap_type_no_id(), error = runtime::Error.invalid_argument,
        };
    }
    let records: *const BootstrapTypeRecord = table->types.data as *const BootstrapTypeRecord;
    let element: BootstrapTypeRecord = records[element_type];
    if (element.kind == BootstrapTypeKind.invalid || element.kind == BootstrapTypeKind.type_void ||
        (element.flags & (BootstrapTypeFlag.complete as usize)) == 0 || element.size_bytes == 0 ||
        (element.flags & ((BootstrapTypeFlag.flexible as usize) | (BootstrapTypeFlag.header as usize))) != 0) {
        return {
            type_id = bootstrap_type_no_id(), error = runtime::Error.invalid_argument,
        };
    }
    var index: usize = BootstrapBuiltinType.count as usize;
    while (index < table->type_count) {
        let record: BootstrapTypeRecord = records[index];
        if (record.kind == BootstrapTypeKind.array && record.element_type == element_type && record.element_count == 0) {
            return {
                type_id = index, error = runtime::Error.none,
            };
        }
        index += 1;
    }

    var record: BootstrapTypeRecord = bootstrap_type_invalid_record();
    record.kind = BootstrapTypeKind.array;
    record.element_type = element_type;
    record.element_count = 0;
    record.size_bytes = 0;
    record.alignment_bytes = element.alignment_bytes;
    record.flags = (BootstrapTypeFlag.complete as usize) | (BootstrapTypeFlag.flexible as usize);
    let type_id: usize = table->type_count;
    let added: BootstrapTypeTableResult = bootstrap_type_append_record(*table, record);
    *table = added.table;
    return {
        type_id = added.error == runtime::Error.none ? type_id : bootstrap_type_no_id(), error = added.error,
    };
}

fn bootstrap_type_table_add_field(table: BootstrapTypeTable, field: BootstrapTypeField) -> BootstrapTypeTableResult {
    if (!bootstrap_type_table_storage_is_valid(table) || field.owner_type >= table.type_count ||
        field.type_id >= table.type_count || field.declaration_unit == bootstrap_type_no_id() ||
        field.declaration_node == bootstrap_type_no_id() || field.name_token == bootstrap_type_no_id() ||
        field.alignment_bytes > (BootstrapTypeLimit.maximum_alignment as usize) ||
        (field.alignment_bytes & (field.alignment_bytes - 1)) != 0) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    let owner: BootstrapTypeRecord = records[field.owner_type];
    if (!bootstrap_type_kind_is_named(owner.kind) || (owner.flags & (BootstrapTypeFlag.complete as usize)) != 0 ||
        (owner.field_count == 0 && owner.first_field != bootstrap_type_no_id()) || (owner.field_count != 0 &&
            owner.first_field + owner.field_count != table.field_count)) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }

    let appended: bytes::BufferResult = bytes::append(
        table.fields, (&field) as *const BootstrapTypeField as *const u8, sizeof(BootstrapTypeField));
    var result: BootstrapTypeTable = table;
    result.fields = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return {
            table = result, error = appended.error,
        };
    }
    let result_records: *BootstrapTypeRecord = result.types.data as *BootstrapTypeRecord;
    if (result_records[field.owner_type].field_count == 0) {
        result_records[field.owner_type].first_field = result.field_count;
    }
    result_records[field.owner_type].field_count += 1;
    result.field_count += 1;
    return {
        table = result, error = runtime::Error.none,
    };
}

fn bootstrap_type_table_add_function_pointer(
    table: BootstrapTypeTable, return_type: usize) -> BootstrapTypeTableResult {
    if (!bootstrap_type_table_storage_is_valid(table) || return_type >= table.type_count) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let records: *const BootstrapTypeRecord = table.types.data as *const BootstrapTypeRecord;
    let return_record: BootstrapTypeRecord = records[return_type];
    if (return_record.kind == BootstrapTypeKind.invalid || return_record.kind == BootstrapTypeKind.alias ||
        return_record.kind == BootstrapTypeKind.array || (return_record.flags &
            (BootstrapTypeFlag.complete as usize)) == 0) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    var record: BootstrapTypeRecord = bootstrap_type_invalid_record();
    record.kind = BootstrapTypeKind.function_pointer;
    record.element_type = return_type;
    record.size_bytes = BootstrapTypeLimit.target_pointer_bytes as usize;
    record.alignment_bytes = BootstrapTypeLimit.target_pointer_alignment as usize;
    return bootstrap_type_append_record(table, record);
}

fn bootstrap_type_table_add_parameter(
    table: BootstrapTypeTable, owner_type: usize, parameter_type: usize) -> BootstrapTypeTableResult {
    if (!bootstrap_type_table_storage_is_valid(table) || owner_type >= table.type_count ||
        parameter_type >= table.type_count) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    let owner: BootstrapTypeRecord = records[owner_type];
    let parameter: BootstrapTypeRecord = records[parameter_type];
    if (owner.kind != BootstrapTypeKind.function_pointer || (owner.flags &
            (BootstrapTypeFlag.complete as usize)) != 0 || (owner.field_count == 0 && owner.first_field !=
            bootstrap_type_no_id()) || (owner.field_count != 0 && owner.first_field + owner.field_count !=
                table.field_count) || parameter.kind == BootstrapTypeKind.invalid ||
        parameter.kind == BootstrapTypeKind.type_void || parameter.kind == BootstrapTypeKind.alias ||
        parameter.kind == BootstrapTypeKind.array || (parameter.flags & (BootstrapTypeFlag.complete as usize)) == 0 ||
        parameter.size_bytes == 0 || owner.field_count == BootstrapTypeLimit.maximum_size as usize) {
        return {
            table = table, error = runtime::Error.invalid_argument,
        };
    }

    var field: BootstrapTypeField = bootstrap_type_invalid_field();
    field.owner_type = owner_type;
    field.type_id = parameter_type;
    field.offset_bytes = 0;
    let appended: bytes::BufferResult =
        bytes::append(
            table.fields, (&field) as *const BootstrapTypeField as *const u8, sizeof(BootstrapTypeField));
    var result: BootstrapTypeTable = table;
    result.fields = appended.buffer;
    if (appended.error != runtime::Error.none) {
        return {
            table = result, error = appended.error,
        };
    }
    let result_records: *BootstrapTypeRecord = result.types.data as *BootstrapTypeRecord;
    if (result_records[owner_type].field_count == 0) {
        result_records[owner_type].first_field = result.field_count;
    }
    result_records[owner_type].field_count += 1;
    result.field_count += 1;
    return {
        table = result, error = runtime::Error.none,
    };
}

fn bootstrap_type_layout_parameters_are_valid(
    record: BootstrapTypeRecord, size_bytes: usize, alignment_bytes: usize) -> bool {
    let declared: bool = bootstrap_type_kind_is_declared(record.kind) ||
        record.kind == BootstrapTypeKind.function_pointer;
    if (!declared || (record.flags & (BootstrapTypeFlag.complete as usize)) != 0 ||
        size_bytes == 0 || alignment_bytes == 0 ||
        alignment_bytes > (BootstrapTypeLimit.maximum_alignment as usize) ||
        (alignment_bytes & (alignment_bytes - 1)) != 0 || size_bytes % alignment_bytes != 0) {
        return false;
    }
    return true;
}

fn bootstrap_type_table_set_layout(
    table: BootstrapTypeTable, type_id: usize, size_bytes: usize, alignment_bytes: usize) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    if (!bootstrap_type_layout_parameters_are_valid(
            records[type_id], size_bytes, alignment_bytes)) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].size_bytes = size_bytes;
    records[type_id].alignment_bytes = alignment_bytes;
    records[type_id].flags &= ~(BootstrapTypeFlag.resolving as usize);
    records[type_id].flags |= BootstrapTypeFlag.complete as usize;
    return runtime::Error.none;
}

fn bootstrap_type_table_set_packed(table: BootstrapTypeTable, type_id: usize, packed: bool) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    if (records[type_id].kind != BootstrapTypeKind.structure || (records[type_id].flags &
            (BootstrapTypeFlag.complete as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    if (packed) {
        records[type_id].flags |= BootstrapTypeFlag.packed as usize;
    } else {
        records[type_id].flags &= ~(BootstrapTypeFlag.packed as usize);
    }
    return runtime::Error.none;
}

fn bootstrap_type_table_set_header(table: BootstrapTypeTable, type_id: usize, header: bool) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    if (records[type_id].kind != BootstrapTypeKind.structure || (records[type_id].flags &
            (BootstrapTypeFlag.complete as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    if (header) {
        records[type_id].flags |= BootstrapTypeFlag.header as usize;
    } else {
        records[type_id].flags &= ~(BootstrapTypeFlag.header as usize);
    }
    return runtime::Error.none;
}

fn bootstrap_type_table_set_enum_underlying(
    table: BootstrapTypeTable, type_id: usize, underlying_type: usize) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id >= table.type_count ||
        underlying_type >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    if (records[type_id].kind != BootstrapTypeKind.enumeration ||
        !bootstrap_type_is_integer(records[underlying_type].kind) ||
        records[type_id].element_type != bootstrap_type_no_id()) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].element_type = underlying_type;
    return runtime::Error.none;
}

fn bootstrap_type_table_set_alias_target(
    table: BootstrapTypeTable, type_id: usize, target_type: usize) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id >= table.type_count ||
        target_type >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    if (records[type_id].kind != BootstrapTypeKind.alias || (records[type_id].flags &
            (BootstrapTypeFlag.complete as usize)) != 0 || records[type_id].element_type != bootstrap_type_no_id()) {
        return runtime::Error.invalid_argument;
    }
    let target: BootstrapTypeRecord = records[target_type];
    if ((target.flags & (BootstrapTypeFlag.complete as usize)) == 0 || target.kind == BootstrapTypeKind.invalid ||
        target.kind == BootstrapTypeKind.type_void || target.size_bytes == 0 || target.alignment_bytes == 0) {
        return runtime::Error.invalid_argument;
    }
    records[type_id].element_type = target_type;
    records[type_id].size_bytes = target.size_bytes;
    records[type_id].alignment_bytes = target.alignment_bytes;
    records[type_id].flags &= ~(BootstrapTypeFlag.resolving as usize);
    records[type_id].flags |= BootstrapTypeFlag.complete as usize;
    return runtime::Error.none;
}

fn bootstrap_type_table_set_resolving(table: BootstrapTypeTable, type_id: usize, resolving: bool) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table) || type_id < BootstrapBuiltinType.count as usize ||
        type_id >= table.type_count) {
        return runtime::Error.invalid_argument;
    }
    let records: *BootstrapTypeRecord = table.types.data as *BootstrapTypeRecord;
    if (!bootstrap_type_kind_is_declared(records[type_id].kind) || (records[type_id].flags &
            (BootstrapTypeFlag.complete as usize)) != 0) {
        return runtime::Error.invalid_argument;
    }
    if (resolving) {
        records[type_id].flags |= BootstrapTypeFlag.resolving as usize;
    } else {
        records[type_id].flags &= ~(BootstrapTypeFlag.resolving as usize);
    }
    return runtime::Error.none;
}

fn bootstrap_type_is_integer(kind: BootstrapTypeKind) -> bool {
    return kind == BootstrapTypeKind.signed_8 || kind == BootstrapTypeKind.signed_16 ||
        kind == BootstrapTypeKind.signed_32 || kind == BootstrapTypeKind.signed_64 ||
        kind == BootstrapTypeKind.signed_size || kind == BootstrapTypeKind.unsigned_8 ||
        kind == BootstrapTypeKind.unsigned_16 || kind == BootstrapTypeKind.unsigned_32 ||
        kind == BootstrapTypeKind.unsigned_64 || kind == BootstrapTypeKind.unsigned_size;
}

fn bootstrap_type_is_signed_integer(kind: BootstrapTypeKind) -> bool {
    return kind == BootstrapTypeKind.signed_8 || kind == BootstrapTypeKind.signed_16 ||
        kind == BootstrapTypeKind.signed_32 || kind == BootstrapTypeKind.signed_64 ||
        kind == BootstrapTypeKind.signed_size;
}

fn bootstrap_type_is_float(kind: BootstrapTypeKind) -> bool {
    return kind == BootstrapTypeKind.float_32 || kind == BootstrapTypeKind.float_64;
}

fn bootstrap_type_is_scalar(kind: BootstrapTypeKind) -> bool {
    return kind == BootstrapTypeKind.boolean || bootstrap_type_is_integer(kind) || bootstrap_type_is_float(kind) ||
        kind == BootstrapTypeKind.pointer || kind == BootstrapTypeKind.enumeration ||
        kind == BootstrapTypeKind.function_pointer;
}

fn bootstrap_type_is_memory(kind: BootstrapTypeKind) -> bool {
    return kind == BootstrapTypeKind.array || kind == BootstrapTypeKind.structure ||
        kind == BootstrapTypeKind.record_union || kind == BootstrapTypeKind.va_list_type;
}

fn bootstrap_type_bit_width(kind: BootstrapTypeKind) -> usize {
    if (kind == BootstrapTypeKind.boolean || kind == BootstrapTypeKind.signed_8 ||
        kind == BootstrapTypeKind.unsigned_8) {
        return 8;
    }
    if (kind == BootstrapTypeKind.signed_16 || kind == BootstrapTypeKind.unsigned_16) {
        return 16;
    }
    if (kind == BootstrapTypeKind.signed_32 || kind == BootstrapTypeKind.unsigned_32 ||
        kind == BootstrapTypeKind.float_32) {
        return 32;
    }
    if (kind == BootstrapTypeKind.signed_64 || kind == BootstrapTypeKind.signed_size ||
        kind == BootstrapTypeKind.unsigned_64 || kind == BootstrapTypeKind.unsigned_size ||
        kind == BootstrapTypeKind.float_64 || kind == BootstrapTypeKind.pointer ||
        kind == BootstrapTypeKind.function_pointer) {
        return 64;
    }
    return 0;
}

fn bootstrap_type_table_is_valid(table: BootstrapTypeTable, require_complete: bool) -> bool {
    if (!bootstrap_type_table_storage_is_valid(table) || table.type_count < BootstrapBuiltinType.count as usize) {
        return false;
    }
    let records: *const BootstrapTypeRecord = table.types.data as *const BootstrapTypeRecord;
    let fields: *const BootstrapTypeField = table.fields.data as *const BootstrapTypeField;
    var index: usize = 0;
    while (index < table.type_count) {
        let record: BootstrapTypeRecord = records[index];
        if ((record.kind as usize) > (BootstrapTypeKind.va_list_type as usize) || record.flags > 255) {
            return false;
        }
        if (index < BootstrapBuiltinType.count as usize) {
            if (record.kind != bootstrap_type_builtin_kind(index) || record.element_type != bootstrap_type_no_id() ||
                record.element_count != 0 || record.declaration_unit != bootstrap_type_no_id() ||
                record.declaration_node != bootstrap_type_no_id() || record.name_token != bootstrap_type_no_id() ||
                record.first_field != bootstrap_type_no_id() || record.field_count != 0 || record.flags !=
                    BootstrapTypeFlag.complete as usize || record.size_bytes != bootstrap_type_builtin_size(index) ||
                record.alignment_bytes != bootstrap_type_builtin_alignment(index)) {
                return false;
            }
        } else if (record.kind == BootstrapTypeKind.pointer) {
            if (record.element_type >= table.type_count || records[record.element_type].kind ==
                    BootstrapTypeKind.invalid || record.element_count != 0 ||
                record.declaration_unit != bootstrap_type_no_id() ||
                record.declaration_node != bootstrap_type_no_id() || record.name_token != bootstrap_type_no_id() ||
                record.first_field != bootstrap_type_no_id() || record.field_count != 0 || record.size_bytes != 8 ||
                record.alignment_bytes != 8 || (record.flags & (BootstrapTypeFlag.complete as usize)) == 0 ||
                (record.flags & ~((BootstrapTypeFlag.complete as usize) | (BootstrapTypeFlag.read_only as usize) |
                        (BootstrapTypeFlag.volatile_pointee as usize))) != 0) {
                return false;
            }
            var previous: usize = BootstrapBuiltinType.count as usize;
            while (previous < index) {
                if (records[previous].kind == BootstrapTypeKind.pointer && records[previous].element_type ==
                        record.element_type && (records[previous].flags & ((BootstrapTypeFlag.read_only as usize) |
                            (BootstrapTypeFlag.volatile_pointee as usize))) ==
                        (record.flags & ((BootstrapTypeFlag.read_only as usize) |
                            (BootstrapTypeFlag.volatile_pointee as usize)))) {
                    return false;
                }
                previous += 1;
            }
        } else if (record.kind == BootstrapTypeKind.array) {
            // A flexible array is the type of a trailing [?]T member: no
            // elements of its own, size zero, element alignment only.
            let flexible: bool = (record.flags & (BootstrapTypeFlag.flexible as usize)) != 0;
            if (flexible) {
                if (record.element_type >= table.type_count || records[record.element_type].kind ==
                        BootstrapTypeKind.invalid || records[record.element_type].kind == BootstrapTypeKind.type_void ||
                    record.element_count != 0 || record.declaration_unit != bootstrap_type_no_id() ||
                    record.declaration_node != bootstrap_type_no_id() || record.name_token != bootstrap_type_no_id() ||
                    record.first_field != bootstrap_type_no_id() || record.field_count != 0 || record.size_bytes != 0 ||
                    (records[record.element_type].flags & (BootstrapTypeFlag.complete as usize)) == 0 ||
                    records[record.element_type].size_bytes == 0 || (records[record.element_type].flags &
                        ((BootstrapTypeFlag.flexible as usize) | (BootstrapTypeFlag.header as usize))) != 0 ||
                    record.alignment_bytes != records[record.element_type].alignment_bytes || record.flags !=
                        ((BootstrapTypeFlag.complete as usize) | (BootstrapTypeFlag.flexible as usize))) {
                    return false;
                }
            } else if (record.element_type >= table.type_count || records[record.element_type].kind ==
                    BootstrapTypeKind.invalid || records[record.element_type].kind == BootstrapTypeKind.type_void ||
                record.element_count == 0 || record.declaration_unit != bootstrap_type_no_id() ||
                record.declaration_node != bootstrap_type_no_id() || record.name_token != bootstrap_type_no_id() ||
                record.first_field != bootstrap_type_no_id() || record.field_count != 0 || record.size_bytes == 0 ||
                record.alignment_bytes == 0 || (records[record.element_type].flags &
                    (BootstrapTypeFlag.complete as usize)) == 0 || records[record.element_type].size_bytes == 0 ||
                record.element_count > (BootstrapTypeLimit.maximum_size as usize) /
                        records[record.element_type].size_bytes || record.size_bytes !=
                    records[record.element_type].size_bytes * record.element_count || record.alignment_bytes !=
                    records[record.element_type].alignment_bytes || record.flags !=
                    BootstrapTypeFlag.complete as usize) {
                return false;
            }
            var previous: usize = BootstrapBuiltinType.count as usize;
            while (previous < index) {
                if (records[previous].kind == BootstrapTypeKind.array && records[previous].element_type ==
                        record.element_type && records[previous].element_count == record.element_count) {
                    return false;
                }
                previous += 1;
            }
        } else if (record.kind == BootstrapTypeKind.function_pointer) {
            if ((record.flags & (BootstrapTypeFlag.complete as usize)) == 0 ||
                record.element_type >= table.type_count || record.element_count != 0 || record.declaration_unit !=
                    bootstrap_type_no_id() || record.declaration_node != bootstrap_type_no_id() ||
                record.name_token != bootstrap_type_no_id() || record.size_bytes != 8 || record.alignment_bytes != 8 ||
                records[record.element_type].kind == BootstrapTypeKind.invalid) {
                return false;
            }
            var previous: usize = BootstrapBuiltinType.count as usize;
            while (previous < index) {
                if (records[previous].kind == BootstrapTypeKind.function_pointer && records[previous].element_type ==
                        record.element_type && records[previous].field_count == record.field_count) {
                    var parameter_index: usize = 0;
                    var same: bool = true;
                    while (parameter_index < record.field_count && same) {
                        if (fields[records[previous].first_field + parameter_index].type_id !=
                            fields[record.first_field + parameter_index].type_id) {
                            same = false;
                        }
                        parameter_index += 1;
                    }
                    if (same) {
                        return false;
                    }
                }
                previous += 1;
            }
        } else if (record.kind == BootstrapTypeKind.alias) {
            let complete: bool = (record.flags & (BootstrapTypeFlag.complete as usize)) != 0;
            if (record.declaration_unit == bootstrap_type_no_id() ||
                record.declaration_node == bootstrap_type_no_id() || record.name_token == bootstrap_type_no_id() ||
                record.element_count != 0 || record.first_field != bootstrap_type_no_id() || record.field_count != 0 ||
                (complete && record.element_type == bootstrap_type_no_id()) || (!complete && record.element_type !=
                    bootstrap_type_no_id())) {
                return false;
            }
            if (complete) {
                if ((record.flags & (BootstrapTypeFlag.resolving as usize)) != 0 ||
                    record.element_type >= table.type_count || record.size_bytes == 0 || record.alignment_bytes == 0) {
                    return false;
                }
                let target: BootstrapTypeRecord = records[record.element_type];
                if ((target.flags & (BootstrapTypeFlag.complete as usize)) == 0 ||
                    target.kind == BootstrapTypeKind.invalid || target.kind == BootstrapTypeKind.type_void ||
                    record.size_bytes != target.size_bytes || record.alignment_bytes != target.alignment_bytes) {
                    return false;
                }
            }
        } else if (bootstrap_type_kind_is_named(record.kind)) {
            let complete: bool = (record.flags & (BootstrapTypeFlag.complete as usize)) != 0;
            if (record.declaration_unit == bootstrap_type_no_id() ||
                record.declaration_node == bootstrap_type_no_id() || record.name_token == bootstrap_type_no_id() ||
                record.element_count != 0 || (require_complete && !complete) || (complete && (record.size_bytes == 0 ||
                        record.alignment_bytes == 0)) || (complete && (record.flags &
                        (BootstrapTypeFlag.resolving as usize)) != 0)) {
                return false;
            }
            if (record.kind == BootstrapTypeKind.enumeration && complete && (record.element_type >= table.type_count ||
                    !bootstrap_type_is_integer(
                        records[record.element_type].kind))) {
                return false;
            }
            if (record.kind != BootstrapTypeKind.enumeration && record.element_type != bootstrap_type_no_id()) {
                return false;
            }
        } else {
            return false;
        }
        if (record.field_count == 0) {
            if (record.first_field != bootstrap_type_no_id()) {
                return false;
            }
        } else if (record.first_field >= table.field_count || record.field_count >
                table.field_count - record.first_field) {
            return false;
        }
        index += 1;
    }

    index = 0;
    while (index < table.field_count) {
        let field: BootstrapTypeField = fields[index];
        let owner_kind: BootstrapTypeKind = records[field.owner_type].kind;
        let parameter_owner: bool = owner_kind == BootstrapTypeKind.function_pointer;
        if (!(parameter_owner || bootstrap_type_is_memory(owner_kind)) || field.type_id >= table.type_count ||
            records[field.type_id].kind == BootstrapTypeKind.invalid || records[field.type_id].kind ==
                BootstrapTypeKind.type_void || (!parameter_owner && field.declaration_unit == bootstrap_type_no_id()) ||
            (!parameter_owner && field.declaration_node == bootstrap_type_no_id()) || (!parameter_owner &&
                field.name_token == bootstrap_type_no_id()) || field.offset_bytes >
                records[field.owner_type].size_bytes || (records[field.type_id].flags &
                (BootstrapTypeFlag.complete as usize)) == 0 || (records[field.type_id].size_bytes == 0 &&
                (records[field.type_id].flags & (BootstrapTypeFlag.flexible as usize)) == 0) ||
            (!parameter_owner && records[field.type_id].size_bytes > records[field.owner_type].size_bytes -
                        field.offset_bytes)) {
            return false;
        }
        let owner: BootstrapTypeRecord = records[field.owner_type];
        if (owner.field_count == 0 || index < owner.first_field || index >= owner.first_field + owner.field_count) {
            return false;
        }
        index += 1;
    }

    index = BootstrapBuiltinType.count as usize;
    while (index < table.type_count) {
        let record: BootstrapTypeRecord = records[index];
        if (record.kind == BootstrapTypeKind.enumeration) {
            let underlying: BootstrapTypeRecord = records[record.element_type];
            if (record.size_bytes != underlying.size_bytes || record.alignment_bytes != underlying.alignment_bytes ||
                record.field_count != 0) {
                return false;
            }
        } else if (record.kind == BootstrapTypeKind.structure || record.kind == BootstrapTypeKind.record_union) {
            let is_union: bool = record.kind == BootstrapTypeKind.record_union;
            // A packed structure lays fields out back to back with alignment 1.
            let is_packed: bool = (record.flags & (BootstrapTypeFlag.packed as usize)) != 0;
            var expected_size: usize = 0;
            var expected_alignment: usize = 1;
            var has_flexible: bool = false;
            var field_index: usize = 0;
            while (field_index < record.field_count) {
                let field: BootstrapTypeField = fields[record.first_field + field_index];
                let field_type: BootstrapTypeRecord = records[field.type_id];
                if (field.owner_type != index ||
                    field.alignment_bytes > (BootstrapTypeLimit.maximum_alignment as usize) ||
                    (field.alignment_bytes & (field.alignment_bytes - 1)) != 0) {
                    return false;
                }
                // A flexible member contributes only its element alignment and
                // is legal solely in last position of a structure.
                let field_flexible: bool = (field_type.flags & (BootstrapTypeFlag.flexible as usize)) != 0;
                if (field_flexible) {
                    if (is_union || field_index + 1 != record.field_count) {
                        return false;
                    }
                    has_flexible = true;
                }
                var field_alignment: usize = field.alignment_bytes > field_type.alignment_bytes ?
                    field.alignment_bytes : field_type.alignment_bytes;
                if (is_packed) {
                    field_alignment = 1;
                }
                if (field_alignment > expected_alignment) {
                    expected_alignment = field_alignment;
                }
                if (is_union) {
                    if (field.offset_bytes != 0) {
                        return false;
                    }
                    if (field_type.size_bytes > expected_size) {
                        expected_size = field_type.size_bytes;
                    }
                } else {
                    let mask: usize = field_alignment - 1;
                    if (expected_size > (BootstrapTypeLimit.maximum_size as usize) - mask) {
                        return false;
                    }
                    let expected_offset: usize = (expected_size + mask) & ~mask;
                    if (field.offset_bytes != expected_offset || field_type.size_bytes >
                            (BootstrapTypeLimit.maximum_size as usize) - expected_offset) {
                        return false;
                    }
                    expected_size = expected_offset + field_type.size_bytes;
                }
                field_index += 1;
            }
            if (expected_size == 0) {
                expected_size = 1;
            }
            // The header flag marks exactly the structures with a flexible
            // trailing member.
            let is_header: bool = (record.flags & (BootstrapTypeFlag.header as usize)) != 0;
            if (is_header != has_flexible) {
                return false;
            }
            // A type-level @align may raise the record alignment beyond the
            // field-derived maximum; the size is then tail-padded to it.
            if (record.alignment_bytes < expected_alignment ||
                record.alignment_bytes > (BootstrapTypeLimit.maximum_alignment as usize) ||
                (record.alignment_bytes & (record.alignment_bytes - 1)) != 0) {
                return false;
            }
            let alignment_mask: usize = record.alignment_bytes - 1;
            if (expected_size > (BootstrapTypeLimit.maximum_size as usize) - alignment_mask) {
                return false;
            }
            expected_size = (expected_size + alignment_mask) & ~alignment_mask;
            if (record.size_bytes != expected_size) {
                return false;
            }
        }
        index += 1;
    }
    return true;
}

fn bootstrap_type_table_release(table: BootstrapTypeTable) -> runtime::Error {
    if (!bootstrap_type_table_storage_is_valid(table)) {
        return runtime::Error.invalid_argument;
    }
    let type_error: runtime::Error = bytes::release(table.types);
    let field_error: runtime::Error = bytes::release(table.fields);
    return type_error != runtime::Error.none ? type_error : field_error;
}

