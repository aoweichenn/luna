module luna.tools.bootstrap.stage_compiler;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.std.path;
import luna.std.io;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.middleend.type;
import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.sema;
import luna.bootstrap.backend.x86_64.text;
import luna.bootstrap.backend.x86_64.abi;
import luna.bootstrap.backend.x86_64.frame;
import luna.bootstrap.backend.x86_64.codegen;

enum BootstrapStageLimit: usize {
    maximum_units = 64,
}

enum BootstrapStageStatus: i32 {
    mode_error = 1,
    input_error = 2,
    unit_limit = 3,
    semantic_error = 4,
    backend_error = 5,
    output_error = 6,
    release_error = 7,
    semantic_diagnostic_base = 64,
    success = 42,
}

fn bootstrap_stage_invalid_path_result(
    error: RuntimeError
) -> StdPathResult {
    return {
        path = {
            storage = std_byte_buffer_empty(),
            length = 0,
        },
        error = error,
    };
}

fn bootstrap_stage_unit_path(index: usize) -> StdPathResult {
    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(
            &text,
            "bootstrap-stage-unit-",
            32
        ) ||
        !bootstrap_x86_64_text_append_usize(&text, index) ||
        !bootstrap_x86_64_text_append_c_string(
            &text,
            ".luna",
            8
        )) {
        let error: RuntimeError =
            text.error == RuntimeError.none ?
                RuntimeError.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return bootstrap_stage_invalid_path_result(error);
    }
    let bytes: StdByteBufferResult =
        bootstrap_x86_64_text_take(&text);
    if (bytes.error != RuntimeError.none) {
        bootstrap_x86_64_text_release(text);
        return bootstrap_stage_invalid_path_result(bytes.error);
    }
    let view: StdTextViewResult = std_text_view(
        bytes.buffer.data as *const u8,
        bytes.buffer.length
    );
    var result: StdPathResult =
        bootstrap_stage_invalid_path_result(view.error);
    if (view.error == RuntimeError.none) {
        result = std_path_from_text(view.view);
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    if (result.error == RuntimeError.none &&
        release_error != RuntimeError.none) {
        std_path_release(result.path);
        return bootstrap_stage_invalid_path_result(release_error);
    }
    return result;
}

fn bootstrap_stage_read_mode(
    executable: *bool
) -> RuntimeError {
    if (executable == null) {
        return RuntimeError.invalid_argument;
    }
    let path: StdPathResult =
        std_path_from_c_string("bootstrap-stage-mode", 32);
    if (path.error != RuntimeError.none) {
        return path.error;
    }
    let bytes: StdByteBufferResult =
        std_io_read_file(path.path);
    let path_error: RuntimeError =
        std_path_release(path.path);
    if (bytes.error != RuntimeError.none) {
        return bytes.error;
    }
    var error: RuntimeError = path_error;
    if (error == RuntimeError.none) {
        if (bytes.buffer.length != 2 ||
            bytes.buffer.data[1] != 10) {
            error = RuntimeError.invalid_argument;
        } else if (bytes.buffer.data[0] == 69) {
            *executable = true;
        } else if (bytes.buffer.data[0] == 76) {
            *executable = false;
        } else {
            error = RuntimeError.invalid_argument;
        }
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    return error == RuntimeError.none ? release_error : error;
}

fn bootstrap_stage_source_release(
    source: StdByteBuffer,
    frontend: BootstrapFrontendResult
) -> RuntimeError {
    var error: RuntimeError =
        bootstrap_frontend_result_release(frontend);
    let source_error: RuntimeError =
        std_byte_buffer_release(source);
    if (error == RuntimeError.none) {
        error = source_error;
    }
    return error;
}

fn bootstrap_stage_sources_release(
    sources: *StdByteBuffer,
    frontends: *BootstrapFrontendResult,
    count: usize
) -> RuntimeError {
    if (sources == null || frontends == null ||
        count > BootstrapStageLimit.maximum_units as usize) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError = RuntimeError.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: RuntimeError =
            bootstrap_stage_source_release(
                sources[index],
                frontends[index]
            );
        if (error == RuntimeError.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_source_load(
    index: usize,
    result_source: *StdByteBuffer,
    result_frontend: *BootstrapFrontendResult
) -> RuntimeError {
    if (result_source == null || result_frontend == null) {
        return RuntimeError.invalid_argument;
    }
    let path: StdPathResult = bootstrap_stage_unit_path(index);
    if (path.error != RuntimeError.none) {
        return path.error;
    }
    let source: StdByteBufferResult =
        std_io_read_file(path.path);
    let path_error: RuntimeError =
        std_path_release(path.path);
    if (source.error != RuntimeError.none) {
        return source.error;
    }
    if (path_error != RuntimeError.none) {
        std_byte_buffer_release(source.buffer);
        return path_error;
    }
    let view: StdTextViewResult = std_text_view(
        source.buffer.data as *const u8,
        source.buffer.length
    );
    if (view.error != RuntimeError.none) {
        std_byte_buffer_release(source.buffer);
        return view.error;
    }
    let frontend: BootstrapFrontendResult =
        bootstrap_frontend_parse(view.view);
    if (frontend.error != RuntimeError.none ||
        frontend.lex.diagnostics.count != 0 ||
        frontend.parse.diagnostics.count != 0) {
        bootstrap_frontend_result_release(frontend);
        std_byte_buffer_release(source.buffer);
        return frontend.error == RuntimeError.none ?
            RuntimeError.invalid_argument : frontend.error;
    }
    *result_source = source.buffer;
    *result_frontend = frontend;
    return RuntimeError.none;
}

fn bootstrap_stage_input_add(
    input: *BootstrapSemanticInput,
    source: StdByteBuffer,
    frontend: BootstrapFrontendResult
) -> bool {
    if (input == null) {
        return false;
    }
    let view: StdTextViewResult = std_text_view(
        source.data as *const u8,
        source.length
    );
    return view.error == RuntimeError.none &&
        bootstrap_semantic_input_add(
            input,
            {
                source = view.view,
                tokens = frontend.lex.tokens,
                tree = frontend.parse.tree,
            }
        );
}

fn bootstrap_stage_semantic_status(
    semantic: BootstrapSemanticResult
) -> i32 {
    if (semantic.diagnostics.count == 0) {
        return BootstrapStageStatus.semantic_error as i32;
    }
    let diagnostic: BootstrapSemanticDiagnosticResult =
        bootstrap_semantic_diagnostic_get(
            semantic.diagnostics,
            0
        );
    if (diagnostic.error != RuntimeError.none) {
        return BootstrapStageStatus.semantic_error as i32;
    }
    return BootstrapStageStatus.semantic_diagnostic_base as i32 +
        diagnostic.diagnostic.kind as usize as i32;
}

fn bootstrap_stage_report_semantic(
    semantic: BootstrapSemanticResult
) -> RuntimeError {
    if (semantic.diagnostics.count == 0) {
        return RuntimeError.none;
    }
    let diagnostic: BootstrapSemanticDiagnosticResult =
        bootstrap_semantic_diagnostic_get(
            semantic.diagnostics,
            0
        );
    if (diagnostic.error != RuntimeError.none) {
        return diagnostic.error;
    }
    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(
            &text,
            "semantic:",
            16
        ) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.kind as usize
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.unit_index
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.span.offset
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.detail
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: RuntimeError =
            text.error == RuntimeError.none ?
                RuntimeError.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    let bytes: StdByteBufferResult =
        bootstrap_x86_64_text_take(&text);
    if (bytes.error != RuntimeError.none) {
        bootstrap_x86_64_text_release(text);
        return bytes.error;
    }
    let view: StdTextViewResult = std_text_view(
        bytes.buffer.data as *const u8,
        bytes.buffer.length
    );
    var error: RuntimeError = view.error;
    if (error == RuntimeError.none) {
        error = std_io_print_error(view.view);
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    return error == RuntimeError.none ? release_error : error;
}

fn main() -> i32 {
    var executable: bool = false;
    if (bootstrap_stage_read_mode(&executable) !=
        RuntimeError.none) {
        return BootstrapStageStatus.mode_error as i32;
    }

    var sources: [64]StdByteBuffer = {};
    var frontends: [64]BootstrapFrontendResult = {};
    var source_count: usize = 0;
    while (source_count <
        BootstrapStageLimit.maximum_units as usize) {
        let error: RuntimeError =
            bootstrap_stage_source_load(
                source_count,
                &sources[source_count],
                &frontends[source_count]
            );
        if (error == RuntimeError.not_found) {
            break;
        }
        if (error != RuntimeError.none) {
            bootstrap_stage_sources_release(
                &sources[0],
                &frontends[0],
                source_count
            );
            return BootstrapStageStatus.input_error as i32;
        }
        source_count += 1;
    }
    if (source_count == 0) {
        return BootstrapStageStatus.input_error as i32;
    }
    if (source_count ==
        BootstrapStageLimit.maximum_units as usize) {
        var excess_source: StdByteBuffer =
            std_byte_buffer_empty();
        var excess_frontend: BootstrapFrontendResult = {};
        let excess_error: RuntimeError =
            bootstrap_stage_source_load(
                source_count,
                &excess_source,
                &excess_frontend
            );
        if (excess_error == RuntimeError.none) {
            bootstrap_stage_source_release(
                excess_source,
                excess_frontend
            );
        }
        if (excess_error != RuntimeError.not_found) {
            bootstrap_stage_sources_release(
                &sources[0],
                &frontends[0],
                source_count
            );
            return BootstrapStageStatus.unit_limit as i32;
        }
    }

    var input: BootstrapSemanticInput =
        bootstrap_semantic_input_empty(executable);
    var added: bool = true;
    var index: usize = 0;
    while (index < source_count && added) {
        added = bootstrap_stage_input_add(
            &input,
            sources[index],
            frontends[index]
        );
        index += 1;
    }
    if (!added) {
        bootstrap_semantic_input_release(input);
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
        return BootstrapStageStatus.semantic_error as i32;
    }

    let semantic: BootstrapSemanticResult =
        bootstrap_semantic_check(input);
    if (!bootstrap_semantic_result_is_success(semantic)) {
        let status: i32 =
            bootstrap_stage_semantic_status(semantic);
        bootstrap_stage_report_semantic(semantic);
        bootstrap_semantic_result_release(semantic);
        bootstrap_semantic_input_release(input);
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
        return status;
    }
    let backend: BootstrapX8664BackendResult =
        bootstrap_x86_64_emit_assembly(
            input,
            semantic.ir,
            semantic.types
        );
    if (!bootstrap_x86_64_backend_is_success(
            backend,
            input,
            semantic.ir,
            semantic.types
        )) {
        bootstrap_x86_64_backend_release(backend);
        bootstrap_semantic_result_release(semantic);
        bootstrap_semantic_input_release(input);
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
        return BootstrapStageStatus.backend_error as i32;
    }

    let output_path: StdPathResult =
        std_path_from_c_string("bootstrap-stage-output.s", 32);
    var write_error: RuntimeError = output_path.error;
    if (output_path.error == RuntimeError.none) {
        write_error = std_io_write_file(
            output_path.path,
            backend.assembly.data as *const u8,
            backend.assembly.length
        );
        let path_error: RuntimeError =
            std_path_release(output_path.path);
        if (write_error == RuntimeError.none) {
            write_error = path_error;
        }
    }

    let backend_error: RuntimeError =
        bootstrap_x86_64_backend_release(backend);
    let semantic_error: RuntimeError =
        bootstrap_semantic_result_release(semantic);
    let input_error: RuntimeError =
        bootstrap_semantic_input_release(input);
    let sources_error: RuntimeError =
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
    if (write_error != RuntimeError.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    if (backend_error != RuntimeError.none ||
        semantic_error != RuntimeError.none ||
        input_error != RuntimeError.none ||
        sources_error != RuntimeError.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return BootstrapStageStatus.success as i32;
}
