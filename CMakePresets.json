{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "sanitize",
      "displayName": "UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "LUNA_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan (native Linux or CI)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "LUNA_ENABLE_ASAN": "ON",
        "LUNA_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer + UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "LUNA_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "fuzz-asan",
      "displayName": "libFuzzer + ASan + UBSan (native Linux or CI)",
      "inherits": "fuzz",
      "binaryDir": "${sourceDir}/build/fuzz-asan",
      "cacheVariables": {
        "LUNA_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "fuzz-asan",
      "configurePreset": "fuzz-asan"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz-asan",
      "configurePreset": "fuzz-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
