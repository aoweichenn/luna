export module luna.runtime;

export enum RuntimeError: isize {
    none = 0,
    operation_not_permitted = 1,
    not_found = 2,
    interrupted = 4,
    io = 5,
    bad_descriptor = 9,
    would_block = 11,
    out_of_memory = 12,
    permission_denied = 13,
    bad_address = 14,
    exists = 17,
    not_directory = 20,
    is_directory = 21,
    invalid_argument = 22,
    too_many_open_files = 24,
    no_space = 28,
    broken_pipe = 32,
    name_too_long = 36,
    not_supported = 95,
}

export struct RuntimeFile {
    descriptor: isize;
}

export struct RuntimeMemory {
    address: *u8;
    length: usize;
}

export struct RuntimeIoResult {
    count: usize;
    error: RuntimeError;
}

export struct RuntimeFileResult {
    file: RuntimeFile;
    error: RuntimeError;
}

export struct RuntimeMemoryResult {
    memory: RuntimeMemory;
    error: RuntimeError;
}

export struct RuntimeProcessIdResult {
    process_id: usize;
    error: RuntimeError;
}

export fn runtime_error_is_none(error: RuntimeError) -> bool;
export fn runtime_process_id() -> RuntimeProcessIdResult;
export fn runtime_process_exit(status: i32) -> void;

export fn runtime_standard_input() -> RuntimeFile;
export fn runtime_standard_output() -> RuntimeFile;
export fn runtime_standard_error() -> RuntimeFile;
export fn runtime_file_open_read(path: *const u8) -> RuntimeFileResult;
export fn runtime_file_create(path: *const u8) -> RuntimeFileResult;
export fn runtime_file_create_executable(
    path: *const u8
) -> RuntimeFileResult;
export fn runtime_file_make_executable(
    file: RuntimeFile
) -> RuntimeError;
export fn runtime_file_close(file: RuntimeFile) -> RuntimeError;
export fn runtime_file_read(
    file: RuntimeFile,
    buffer: *u8,
    length: usize
) -> RuntimeIoResult;
export fn runtime_file_write(
    file: RuntimeFile,
    buffer: *const u8,
    length: usize
) -> RuntimeIoResult;

export fn runtime_memory_map(length: usize) -> RuntimeMemoryResult;
export fn runtime_memory_unmap(memory: RuntimeMemory) -> RuntimeError;
