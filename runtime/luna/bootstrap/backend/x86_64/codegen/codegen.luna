module luna.bootstrap.backend.x86_64.codegen;

import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.backend.x86_64.text;

enum BootstrapX8664CodegenLimit: usize {
    maximum_size = 18446744073709551615,
    text_limit = 4096,
}

struct BootstrapX8664CodegenContext {
    semantic_input: BootstrapSemanticInput;
    ir: BootstrapTypedIr;
    types: BootstrapTypeTable;
    abi: BootstrapX8664Abi;
    frames: BootstrapX8664FramePlan;
    text: BootstrapX8664Text;
    current_function: usize;
    error: RuntimeError;
}

fn bootstrap_x86_64_codegen_no_id() -> usize {
    return BootstrapX8664CodegenLimit.maximum_size as usize;
}

fn bootstrap_x86_64_backend_empty()
    -> BootstrapX8664BackendResult {
    return {
        assembly = std_byte_buffer_empty(),
        abi = bootstrap_x86_64_abi_empty(),
        frames = bootstrap_x86_64_frame_plan_empty(),
        error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_codegen_fail(
    context: *BootstrapX8664CodegenContext,
    error: RuntimeError
) -> bool {
    if (context != null &&
        context->error == RuntimeError.none) {
        context->error = error;
    }
    return false;
}

fn bootstrap_x86_64_codegen_literal(
    context: *BootstrapX8664CodegenContext,
    literal: *const u8
) -> bool {
    if (context == null ||
        context->error != RuntimeError.none ||
        !bootstrap_x86_64_text_append_c_string(
            &context->text,
            literal,
            BootstrapX8664CodegenLimit.text_limit as usize
        )) {
        if (context != null &&
            context->error == RuntimeError.none) {
            context->error = context->text.error;
        }
        return false;
    }
    return true;
}

fn bootstrap_x86_64_codegen_usize(
    context: *BootstrapX8664CodegenContext,
    value: usize
) -> bool {
    if (context == null ||
        context->error != RuntimeError.none ||
        !bootstrap_x86_64_text_append_usize(
            &context->text,
            value
        )) {
        if (context != null &&
            context->error == RuntimeError.none) {
            context->error = context->text.error;
        }
        return false;
    }
    return true;
}

fn bootstrap_x86_64_codegen_hex(
    context: *BootstrapX8664CodegenContext,
    value: u64,
    digits: usize
) -> bool {
    if (context == null ||
        context->error != RuntimeError.none ||
        !bootstrap_x86_64_text_append_hex(
            &context->text,
            value,
            digits
        )) {
        if (context != null &&
            context->error == RuntimeError.none) {
            context->error = context->text.error;
        }
        return false;
    }
    return true;
}

fn bootstrap_x86_64_codegen_type(
    context: *BootstrapX8664CodegenContext,
    type_id: usize
) -> *const BootstrapTypeRecord {
    if (context == null || type_id >= context->types.type_count) {
        bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
        return null;
    }
    let records: *const BootstrapTypeRecord =
        context->types.types.data as
            *const BootstrapTypeRecord;
    return &records[type_id];
}

fn bootstrap_x86_64_codegen_unit(
    context: *BootstrapX8664CodegenContext,
    unit_id: usize
) -> *const BootstrapSemanticUnit {
    if (context == null ||
        unit_id >= context->semantic_input.unit_count) {
        bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
        return null;
    }
    let units: *const BootstrapSemanticUnit =
        context->semantic_input.units.data as
            *const BootstrapSemanticUnit;
    return &units[unit_id];
}

fn bootstrap_x86_64_codegen_token(
    context: *BootstrapX8664CodegenContext,
    unit_id: usize,
    token_id: usize
) -> BootstrapToken {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_x86_64_codegen_unit(context, unit_id);
    if (unit == null || token_id >= unit->tokens.count) {
        bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
        return {
            kind = BootstrapTokenKind.invalid,
            span = {
                offset = 0,
                length = 0,
                line = 0,
                column = 0,
            },
        };
    }
    let tokens: *const BootstrapToken =
        unit->tokens.storage.data as *const BootstrapToken;
    return tokens[token_id];
}

fn bootstrap_x86_64_codegen_node(
    context: *BootstrapX8664CodegenContext,
    unit_id: usize,
    node_id: usize
) -> BootstrapSyntaxNode {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_x86_64_codegen_unit(context, unit_id);
    if (unit == null || node_id >= unit->tree.count) {
        bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
        return {
            kind = BootstrapSyntaxKind.invalid,
            span = {
                offset = 0,
                length = 0,
                line = 0,
                column = 0,
            },
            token_index = 0,
            parent = 0,
            first_child = 0,
            last_child = 0,
            next_sibling = 0,
            child_count = 0,
            flags = 0,
        };
    }
    let nodes: *const BootstrapSyntaxNode =
        unit->tree.storage.data as *const BootstrapSyntaxNode;
    return nodes[node_id];
}

fn bootstrap_x86_64_codegen_append_token_hex(
    context: *BootstrapX8664CodegenContext,
    unit_id: usize,
    token_id: usize
) -> bool {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_x86_64_codegen_unit(context, unit_id);
    let token: BootstrapToken =
        bootstrap_x86_64_codegen_token(
            context,
            unit_id,
            token_id
        );
    if (unit == null || token.kind != BootstrapTokenKind.identifier ||
        token.span.offset > unit->source.length ||
        token.span.length >
            unit->source.length - token.span.offset) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    if (!bootstrap_x86_64_text_append_hex_bytes(
            &context->text,
            &unit->source.data[token.span.offset],
            token.span.length
        )) {
        context->error = context->text.error;
        return false;
    }
    return true;
}

fn bootstrap_x86_64_codegen_append_module_hex(
    context: *BootstrapX8664CodegenContext,
    unit_id: usize
) -> bool {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_x86_64_codegen_unit(context, unit_id);
    if (unit == null) {
        return false;
    }
    let root: BootstrapSyntaxNode =
        bootstrap_x86_64_codegen_node(
            context,
            unit_id,
            unit->tree.root
        );
    let declaration: BootstrapSyntaxNode =
        bootstrap_x86_64_codegen_node(
            context,
            unit_id,
            root.first_child
        );
    if (root.kind != BootstrapSyntaxKind.program ||
        declaration.kind !=
            BootstrapSyntaxKind.module_declaration ||
        declaration.child_count == 0) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < declaration.child_count) {
        let name: BootstrapSyntaxNode =
            bootstrap_x86_64_codegen_node(
                context,
                unit_id,
                child
            );
        if (name.kind != BootstrapSyntaxKind.name_expression ||
            (index != 0 &&
                !bootstrap_x86_64_codegen_hex(
                    context,
                    46,
                    2
                )) ||
            !bootstrap_x86_64_codegen_append_token_hex(
                context,
                unit_id,
                name.token_index
            )) {
            return false;
        }
        child = name.next_sibling;
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_codegen_append_function_symbol(
    context: *BootstrapX8664CodegenContext,
    function_id: usize
) -> bool {
    if (context == null || function_id >= context->ir.function_count) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    let functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    let function: BootstrapIrFunction =
        functions[function_id];
    if (function.linkage == BootstrapIrLinkage.external_c) {
        let unit: *const BootstrapSemanticUnit =
            bootstrap_x86_64_codegen_unit(
                context,
                function.declaration_unit
            );
        let token: BootstrapToken =
            bootstrap_x86_64_codegen_token(
                context,
                function.declaration_unit,
                function.name_token
            );
        if (unit == null ||
            token.kind != BootstrapTokenKind.identifier ||
            token.span.offset > unit->source.length ||
            token.span.length >
                unit->source.length - token.span.offset ||
            !bootstrap_x86_64_text_append(
                &context->text,
                &unit->source.data[token.span.offset],
                token.span.length
            )) {
            return bootstrap_x86_64_codegen_fail(
                context,
                RuntimeError.invalid_argument
            );
        }
        return true;
    }
    return bootstrap_x86_64_codegen_literal(context, "_L") &&
        bootstrap_x86_64_codegen_append_module_hex(
            context,
            function.declaration_unit
        ) &&
        bootstrap_x86_64_codegen_literal(context, "_") &&
        bootstrap_x86_64_codegen_append_token_hex(
            context,
            function.declaration_unit,
            function.name_token
        );
}

fn bootstrap_x86_64_codegen_storage(
    context: *BootstrapX8664CodegenContext,
    kind: BootstrapX8664StorageKind,
    source_id: usize
) -> BootstrapX8664Storage {
    let found: BootstrapX8664StorageResult =
        bootstrap_x86_64_storage_find(
            context->frames,
            context->current_function,
            kind,
            source_id
        );
    if (found.error != RuntimeError.none) {
        bootstrap_x86_64_codegen_fail(
            context,
            found.error
        );
    }
    return found.storage;
}

fn bootstrap_x86_64_codegen_append_stack(
    context: *BootstrapX8664CodegenContext,
    storage: BootstrapX8664Storage
) -> bool {
    return bootstrap_x86_64_codegen_literal(context, "-") &&
        bootstrap_x86_64_codegen_usize(
            context,
            storage.offset_bytes
        ) &&
        bootstrap_x86_64_codegen_literal(context, "(%rbp)");
}

fn bootstrap_x86_64_codegen_append_value(
    context: *BootstrapX8664CodegenContext,
    value_id: usize
) -> bool {
    let storage: BootstrapX8664Storage =
        bootstrap_x86_64_codegen_storage(
            context,
            BootstrapX8664StorageKind.value,
            value_id
        );
    return context->error == RuntimeError.none &&
        bootstrap_x86_64_codegen_append_stack(
            context,
            storage
        );
}

fn bootstrap_x86_64_codegen_append_slot(
    context: *BootstrapX8664CodegenContext,
    slot_id: usize
) -> bool {
    let storage: BootstrapX8664Storage =
        bootstrap_x86_64_codegen_storage(
            context,
            BootstrapX8664StorageKind.slot,
            slot_id
        );
    return context->error == RuntimeError.none &&
        bootstrap_x86_64_codegen_append_stack(
            context,
            storage
        );
}

fn bootstrap_x86_64_codegen_block_label(
    context: *BootstrapX8664CodegenContext,
    block_id: usize
) -> bool {
    return bootstrap_x86_64_codegen_literal(context, ".Lbf") &&
        bootstrap_x86_64_codegen_usize(
            context,
            context->current_function
        ) &&
        bootstrap_x86_64_codegen_literal(context, "_bb") &&
        bootstrap_x86_64_codegen_usize(context, block_id);
}

fn bootstrap_x86_64_codegen_return_label(
    context: *BootstrapX8664CodegenContext
) -> bool {
    return bootstrap_x86_64_codegen_literal(context, ".Lbf") &&
        bootstrap_x86_64_codegen_usize(
            context,
            context->current_function
        ) &&
        bootstrap_x86_64_codegen_literal(context, "_return");
}

fn bootstrap_x86_64_codegen_instruction_label(
    context: *BootstrapX8664CodegenContext,
    instruction_id: usize,
    suffix: *const u8
) -> bool {
    return bootstrap_x86_64_codegen_literal(context, ".Lbi") &&
        bootstrap_x86_64_codegen_usize(
            context,
            instruction_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, "_") &&
        bootstrap_x86_64_codegen_literal(context, suffix);
}

fn bootstrap_x86_64_codegen_append_global_label(
    context: *BootstrapX8664CodegenContext,
    global_id: usize
) -> bool {
    return bootstrap_x86_64_codegen_literal(context, ".Lbg") &&
        bootstrap_x86_64_codegen_usize(context, global_id);
}

fn bootstrap_x86_64_codegen_bit_width(
    record: *const BootstrapTypeRecord
) -> usize {
    if (record == null) {
        return 0;
    }
    if (record->kind == BootstrapTypeKind.enumeration) {
        return record->size_bytes * 8;
    }
    if (record->kind == BootstrapTypeKind.pointer) {
        return 64;
    }
    if (bootstrap_type_is_memory(record->kind)) {
        return 64;
    }
    return bootstrap_type_bit_width(record->kind);
}

fn bootstrap_x86_64_codegen_is_signed(
    context: *BootstrapX8664CodegenContext,
    record: *const BootstrapTypeRecord
) -> bool {
    if (record == null) {
        return false;
    }
    if (record->kind == BootstrapTypeKind.enumeration) {
        let underlying: *const BootstrapTypeRecord =
            bootstrap_x86_64_codegen_type(
                context,
                record->element_type
            );
        return underlying != null &&
            bootstrap_type_is_signed_integer(
                underlying->kind
            );
    }
    return bootstrap_type_is_signed_integer(record->kind);
}

fn bootstrap_x86_64_codegen_load_integer(
    context: *BootstrapX8664CodegenContext,
    value_id: usize,
    record: *const BootstrapTypeRecord,
    destination_32: *const u8,
    destination_64: *const u8,
    signed_value: bool
) -> bool {
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    var mnemonic: *const u8 = null;
    var destination: *const u8 = destination_32;
    if (signed_value && width == 8) {
        mnemonic = "    movsbl ";
    } else if (signed_value && width == 16) {
        mnemonic = "    movswl ";
    } else if (signed_value && width == 32 &&
        destination_64 != null) {
        mnemonic = "    movslq ";
        destination = destination_64;
    } else if (width <= 32) {
        mnemonic = "    movl ";
    } else if (width == 64) {
        mnemonic = "    movq ";
        destination = destination_64;
    } else {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) &&
        bootstrap_x86_64_codegen_append_value(
            context,
            value_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, ", ") &&
        bootstrap_x86_64_codegen_literal(
            context,
            destination
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_load_rax(
    context: *BootstrapX8664CodegenContext,
    value_id: usize,
    record: *const BootstrapTypeRecord
) -> bool {
    return bootstrap_x86_64_codegen_load_integer(
        context,
        value_id,
        record,
        "%eax",
        "%rax",
        false
    );
}

fn bootstrap_x86_64_codegen_load_rcx(
    context: *BootstrapX8664CodegenContext,
    value_id: usize,
    record: *const BootstrapTypeRecord
) -> bool {
    return bootstrap_x86_64_codegen_load_integer(
        context,
        value_id,
        record,
        "%ecx",
        "%rcx",
        false
    );
}

fn bootstrap_x86_64_codegen_load_signed_rax(
    context: *BootstrapX8664CodegenContext,
    value_id: usize,
    record: *const BootstrapTypeRecord
) -> bool {
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    let mnemonic: *const u8 =
        width == 8 ? "    movsbq " :
        width == 16 ? "    movswq " :
        width == 32 ? "    movslq " :
        width == 64 ? "    movq " : null;
    if (mnemonic == null) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) &&
        bootstrap_x86_64_codegen_append_value(
            context,
            value_id
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            ", %rax\n"
        );
}

fn bootstrap_x86_64_codegen_store_rax(
    context: *BootstrapX8664CodegenContext,
    result: usize,
    record: *const BootstrapTypeRecord
) -> bool {
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    if (width == 8 &&
        !bootstrap_x86_64_codegen_literal(
            context,
            "    andl $255, %eax\n"
        )) {
        return false;
    }
    if (width == 16 &&
        !bootstrap_x86_64_codegen_literal(
            context,
            "    andl $65535, %eax\n"
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ? "    movl %eax, " :
                "    movq %rax, "
        ) &&
        bootstrap_x86_64_codegen_append_value(
            context,
            result
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_float_move(
    record: *const BootstrapTypeRecord
) -> *const u8 {
    if (record == null) {
        return null;
    }
    return record->kind == BootstrapTypeKind.float_32 ?
        "movss" : "movsd";
}

fn bootstrap_x86_64_codegen_load_xmm(
    context: *BootstrapX8664CodegenContext,
    value_id: usize,
    record: *const BootstrapTypeRecord,
    register_name: *const u8
) -> bool {
    let mnemonic: *const u8 =
        bootstrap_x86_64_codegen_float_move(record);
    return bootstrap_x86_64_codegen_literal(context, "    ") &&
        bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) &&
        bootstrap_x86_64_codegen_literal(context, " ") &&
        bootstrap_x86_64_codegen_append_value(
            context,
            value_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, ", ") &&
        bootstrap_x86_64_codegen_literal(
            context,
            register_name
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_store_xmm(
    context: *BootstrapX8664CodegenContext,
    result: usize,
    record: *const BootstrapTypeRecord,
    register_name: *const u8
) -> bool {
    let mnemonic: *const u8 =
        bootstrap_x86_64_codegen_float_move(record);
    return bootstrap_x86_64_codegen_literal(context, "    ") &&
        bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) &&
        bootstrap_x86_64_codegen_literal(context, " ") &&
        bootstrap_x86_64_codegen_literal(
            context,
            register_name
        ) &&
        bootstrap_x86_64_codegen_literal(context, ", ") &&
        bootstrap_x86_64_codegen_append_value(
            context,
            result
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_constant(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (record == null) {
        return false;
    }
    if (instruction.opcode == BootstrapIrOpcode.constant_null) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    xorq %rax, %rax\n"
            ) &&
            bootstrap_x86_64_codegen_store_rax(
                context,
                instruction.result,
                record
            );
    }
    if (instruction.opcode ==
            BootstrapIrOpcode.constant_boolean ||
        instruction.opcode ==
            BootstrapIrOpcode.constant_integer) {
        let width: usize =
            bootstrap_x86_64_codegen_bit_width(record);
        if (width <= 32) {
            if (!bootstrap_x86_64_codegen_literal(
                    context,
                    "    movl $0x"
                ) ||
                !bootstrap_x86_64_codegen_hex(
                    context,
                    instruction.immediate & 4294967295,
                    8
                ) ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    ", %eax\n"
                )) {
                return false;
            }
        } else if (!bootstrap_x86_64_codegen_literal(
                context,
                "    movabsq $0x"
            ) ||
            !bootstrap_x86_64_codegen_hex(
                context,
                instruction.immediate,
                16
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", %rax\n"
            )) {
            return false;
        }
        return bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            record
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.constant_float) {
        if (record->kind == BootstrapTypeKind.float_32) {
            let value: f32 = instruction.floating as f32;
            let bits: u32 =
                *((&value) as *const f32 as *const u32);
            return bootstrap_x86_64_codegen_literal(
                    context,
                    "    movl $0x"
                ) &&
                bootstrap_x86_64_codegen_hex(
                    context,
                    bits as u64,
                    8
                ) &&
                bootstrap_x86_64_codegen_literal(
                    context,
                    ", %eax\n    movl %eax, "
                ) &&
                bootstrap_x86_64_codegen_append_value(
                    context,
                    instruction.result
                ) &&
                bootstrap_x86_64_codegen_literal(
                    context,
                    "\n"
                );
        }
        let bits: u64 =
            *((&instruction.floating) as *const f64 as *const u64);
        return bootstrap_x86_64_codegen_literal(
                context,
                "    movabsq $0x"
            ) &&
            bootstrap_x86_64_codegen_hex(
                context,
                bits,
                16
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                ", %rax\n    movq %rax, "
            ) &&
            bootstrap_x86_64_codegen_append_value(
                context,
                instruction.result
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    return bootstrap_x86_64_codegen_fail(
        context,
        RuntimeError.invalid_argument
    );
}

fn bootstrap_x86_64_codegen_emit_address(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    if (instruction.opcode ==
        BootstrapIrOpcode.address_of_slot) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    leaq "
            ) &&
            bootstrap_x86_64_codegen_append_slot(
                context,
                instruction.auxiliary
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                ", %rax\n"
            ) &&
            bootstrap_x86_64_codegen_store_rax(
                context,
                instruction.result,
                bootstrap_x86_64_codegen_type(
                    context,
                    instruction.type_id
                )
            );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.global_address) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    leaq "
            ) &&
            bootstrap_x86_64_codegen_append_global_label(
                context,
                instruction.auxiliary
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%rip), %rax\n"
            ) &&
            bootstrap_x86_64_codegen_store_rax(
                context,
                instruction.result,
                bootstrap_x86_64_codegen_type(
                    context,
                    instruction.type_id
                )
            );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.member_address) {
        if (!bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                bootstrap_x86_64_codegen_type(
                    context,
                    instruction.type_id
                )
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    addq $"
            ) ||
            !bootstrap_x86_64_codegen_usize(
                context,
                instruction.auxiliary
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", %rax\n"
            )) {
            return false;
        }
        return bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            bootstrap_x86_64_codegen_type(
                context,
                instruction.type_id
            )
        );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.pointer_offset) {
        let values: *const BootstrapIrValue =
            context->ir.values.data as *const BootstrapIrValue;
        let left_record: *const BootstrapTypeRecord =
            bootstrap_x86_64_codegen_type(
                context,
                values[instruction.left].type_id
            );
        let index_record: *const BootstrapTypeRecord =
            bootstrap_x86_64_codegen_type(
                context,
                values[instruction.right].type_id
            );
        if (left_record == null || index_record == null ||
            (left_record->kind != BootstrapTypeKind.pointer &&
                left_record->kind != BootstrapTypeKind.array) ||
            instruction.auxiliary == 0 ||
            !bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                left_record
            ) ||
            !bootstrap_x86_64_codegen_load_rcx(
                context,
                instruction.right,
                index_record
            )) {
            return false;
        }
        if (!bootstrap_x86_64_codegen_literal(
                context,
                "    movabsq $0x"
            ) ||
            !bootstrap_x86_64_codegen_hex(
                context,
                instruction.auxiliary as u64,
                16
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", %rdx\n    imulq %rdx, %rcx\n    addq %rcx, %rax\n"
            )) {
            return false;
        }
        return bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            bootstrap_x86_64_codegen_type(
                context,
                instruction.type_id
            )
        );
    }
    return bootstrap_x86_64_codegen_fail(
        context,
        RuntimeError.invalid_argument
    );
}

fn bootstrap_x86_64_codegen_emit_zero(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let slot: BootstrapX8664Storage =
        bootstrap_x86_64_codegen_storage(
            context,
            BootstrapX8664StorageKind.slot,
            instruction.auxiliary
        );
    if (context->error != RuntimeError.none) {
        return false;
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            "    leaq "
        ) &&
        bootstrap_x86_64_codegen_append_stack(
            context,
            slot
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            ", %rdi\n    xorl %eax, %eax\n    movq $"
        ) &&
        bootstrap_x86_64_codegen_usize(
            context,
            slot.size_bytes
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            ", %rcx\n    rep stosb\n"
        );
}

fn bootstrap_x86_64_codegen_emit_memory_copy(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    instruction_id: usize
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let pointer_record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    if (pointer_record == null ||
        !bootstrap_x86_64_codegen_load_integer(
            context,
            instruction.left,
            pointer_record,
            "%edi",
            "%rdi",
            false
        ) ||
        !bootstrap_x86_64_codegen_load_integer(
            context,
            instruction.right,
            pointer_record,
            "%esi",
            "%rsi",
            false
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    movabsq $0x"
        ) ||
        !bootstrap_x86_64_codegen_hex(
            context,
            instruction.auxiliary as u64,
            16
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %rcx\n    cmpq %rsi, %rdi\n    jbe "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "copy_forward"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "\n    leaq (%rsi,%rcx), %rax\n    cmpq %rax, %rdi\n    jae "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "copy_forward"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "\n    testq %rcx, %rcx\n    je "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "copy_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "\n    leaq -1(%rsi,%rcx), %rsi\n    leaq -1(%rdi,%rcx), %rdi\n    std\n    rep movsb\n    cld\n    jmp "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "copy_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "\n") ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "copy_forward"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ":\n    cld\n    rep movsb\n"
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "copy_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, ":\n")) {
        return false;
    }
    return true;
}

fn bootstrap_x86_64_codegen_indirect_load_mnemonic(
    record: *const BootstrapTypeRecord
) -> *const u8 {
    if (record == null) {
        return null;
    }
    if (record->kind == BootstrapTypeKind.float_32) {
        return "movss";
    }
    if (record->kind == BootstrapTypeKind.float_64) {
        return "movsd";
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    if (width == 8) {
        return "movzbl";
    }
    if (width == 16) {
        return "movzwl";
    }
    if (width == 32) {
        return "movl";
    }
    return width == 64 ? "movq" : null;
}

fn bootstrap_x86_64_codegen_emit_load_indirect(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let pointer_record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    let mnemonic: *const u8 =
        bootstrap_x86_64_codegen_indirect_load_mnemonic(
            record
        );
    if (pointer_record == null || record == null ||
        mnemonic == null ||
        !bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            pointer_record
        )) {
        return false;
    }
    if (bootstrap_type_is_float(record->kind)) {
        return bootstrap_x86_64_codegen_literal(context, "    ") &&
            bootstrap_x86_64_codegen_literal(
                context,
                mnemonic
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                " (%rax), %xmm0\n"
            ) &&
            bootstrap_x86_64_codegen_store_xmm(
                context,
                instruction.result,
                record,
                "%xmm0"
            );
    }
    if (!bootstrap_x86_64_codegen_literal(context, "    ") ||
        !bootstrap_x86_64_codegen_literal(context, mnemonic) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            " (%rax), "
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            bootstrap_x86_64_codegen_bit_width(record) <= 32 ?
                "%eax\n" : "%rax\n"
        )) {
        return false;
    }
    if (record->kind == BootstrapTypeKind.boolean &&
        !bootstrap_x86_64_codegen_literal(
            context,
            "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n"
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_store_rax(
        context,
        instruction.result,
        record
    );
}

fn bootstrap_x86_64_codegen_emit_store_indirect(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let pointer_record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (pointer_record == null || record == null ||
        !bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            pointer_record
        )) {
        return false;
    }
    if (bootstrap_type_is_float(record->kind)) {
        return bootstrap_x86_64_codegen_load_xmm(
                context,
                instruction.right,
                record,
                "%xmm0"
            ) &&
            bootstrap_x86_64_codegen_literal(context, "    ") &&
            bootstrap_x86_64_codegen_literal(
                context,
                bootstrap_x86_64_codegen_float_move(record)
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                " %xmm0, (%rax)\n"
            );
    }
    if (!bootstrap_x86_64_codegen_load_rcx(
            context,
            instruction.right,
            record
        )) {
        return false;
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    return bootstrap_x86_64_codegen_literal(
            context,
            width == 8 ? "    movb %cl, (%rax)\n" :
            width == 16 ? "    movw %cx, (%rax)\n" :
            width == 32 ? "    movl %ecx, (%rax)\n" :
                "    movq %rcx, (%rax)\n"
        );
}

fn bootstrap_x86_64_codegen_emit_slot_access(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (record == null) {
        return false;
    }
    if (instruction.opcode == BootstrapIrOpcode.load) {
        if (bootstrap_type_is_float(record->kind)) {
            return bootstrap_x86_64_codegen_literal(context, "    ") &&
                bootstrap_x86_64_codegen_literal(
                    context,
                    bootstrap_x86_64_codegen_float_move(record)
                ) &&
                bootstrap_x86_64_codegen_literal(context, " ") &&
                bootstrap_x86_64_codegen_append_slot(
                    context,
                    instruction.auxiliary
                ) &&
                bootstrap_x86_64_codegen_literal(
                    context,
                    ", %xmm0\n"
                ) &&
                bootstrap_x86_64_codegen_store_xmm(
                    context,
                    instruction.result,
                    record,
                    "%xmm0"
                );
        }
        let width: usize =
            bootstrap_x86_64_codegen_bit_width(record);
        if (!bootstrap_x86_64_codegen_literal(
                context,
                width <= 32 ? "    movl " : "    movq "
            ) ||
            !bootstrap_x86_64_codegen_append_slot(
                context,
                instruction.auxiliary
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                width <= 32 ? ", %eax\n" : ", %rax\n"
            )) {
            return false;
        }
        if (record->kind == BootstrapTypeKind.boolean &&
            !bootstrap_x86_64_codegen_literal(
                context,
                "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n"
            )) {
            return false;
        }
        return bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            record
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.store) {
        if (bootstrap_type_is_float(record->kind)) {
            return bootstrap_x86_64_codegen_load_xmm(
                    context,
                    instruction.left,
                    record,
                    "%xmm0"
                ) &&
                bootstrap_x86_64_codegen_literal(context, "    ") &&
                bootstrap_x86_64_codegen_literal(
                    context,
                    bootstrap_x86_64_codegen_float_move(record)
                ) &&
                bootstrap_x86_64_codegen_literal(
                    context,
                    " %xmm0, "
                ) &&
                bootstrap_x86_64_codegen_append_slot(
                    context,
                    instruction.auxiliary
                ) &&
                bootstrap_x86_64_codegen_literal(context, "\n");
        }
        let width: usize =
            bootstrap_x86_64_codegen_bit_width(record);
        return bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                width <= 32 ?
                    "    movl %eax, " : "    movq %rax, "
            ) &&
            bootstrap_x86_64_codegen_append_slot(
                context,
                instruction.auxiliary
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    return bootstrap_x86_64_codegen_fail(
        context,
        RuntimeError.invalid_argument
    );
}

fn bootstrap_x86_64_codegen_emit_check(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    instruction_id: usize
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let left_record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    if (left_record == null ||
        !bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            left_record
        )) {
        return false;
    }
    if (instruction.opcode == BootstrapIrOpcode.null_check) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    testq %rax, %rax\n    jne "
            ) &&
            bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "check_ok"
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "\n    ud2\n"
            ) &&
            bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "check_ok"
            ) &&
            bootstrap_x86_64_codegen_literal(context, ":\n");
    }
    let right_record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.right].type_id
        );
    return right_record != null &&
        bootstrap_x86_64_codegen_load_rcx(
            context,
            instruction.right,
            right_record
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            "    cmpq %rcx, %rax\n    jb "
        ) &&
        bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "check_ok"
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            "\n    ud2\n"
        ) &&
        bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "check_ok"
        ) &&
        bootstrap_x86_64_codegen_literal(context, ":\n");
}

fn bootstrap_x86_64_codegen_emit_unary(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    if (record == null) {
        return false;
    }
    if (instruction.opcode == BootstrapIrOpcode.boolean_not) {
        return bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "    testl %eax, %eax\n    sete %al\n    movzbl %al, %eax\n"
            ) &&
            bootstrap_x86_64_codegen_store_rax(
                context,
                instruction.result,
                bootstrap_x86_64_codegen_type(
                    context,
                    instruction.type_id
                )
            );
    }
    if (instruction.opcode == BootstrapIrOpcode.unary_float) {
        let width: usize =
            bootstrap_x86_64_codegen_bit_width(record);
        return bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                width == 32 ?
                    "    xorl $0x80000000, %eax\n" :
                    "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, %rax\n"
            ) &&
            bootstrap_x86_64_codegen_store_rax(
                context,
                instruction.result,
                record
            );
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    let mnemonic: *const u8 =
        instruction.operation == BootstrapTokenKind.minus ?
            (width <= 32 ? "    negl %eax\n" :
                "    negq %rax\n") :
            (width <= 32 ? "    notl %eax\n" :
                "    notq %rax\n");
    return bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            record
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) &&
        bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            record
        );
}

fn bootstrap_x86_64_codegen_binary_mnemonic(
    operation: BootstrapTokenKind,
    width: usize
) -> *const u8 {
    if (operation == BootstrapTokenKind.plus) {
        return width <= 32 ? "addl" : "addq";
    }
    if (operation == BootstrapTokenKind.minus) {
        return width <= 32 ? "subl" : "subq";
    }
    if (operation == BootstrapTokenKind.star) {
        return width <= 32 ? "imull" : "imulq";
    }
    if (operation == BootstrapTokenKind.ampersand) {
        return width <= 32 ? "andl" : "andq";
    }
    if (operation == BootstrapTokenKind.pipe) {
        return width <= 32 ? "orl" : "orq";
    }
    if (operation == BootstrapTokenKind.caret) {
        return width <= 32 ? "xorl" : "xorq";
    }
    return null;
}

fn bootstrap_x86_64_codegen_emit_division(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    record: *const BootstrapTypeRecord,
    instruction_id: usize
) -> bool {
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    let signed_value: bool =
        bootstrap_x86_64_codegen_is_signed(context, record);
    if (width < 32 && signed_value) {
        if (!bootstrap_x86_64_codegen_load_integer(
                context,
                instruction.left,
                record,
                "%eax",
                "%rax",
                true
            ) ||
            !bootstrap_x86_64_codegen_load_integer(
                context,
                instruction.right,
                record,
                "%ecx",
                "%rcx",
                true
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                width == 8 ?
                    "    cmpl $-128, %eax\n" :
                    "    cmpl $-32768, %eax\n"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    jne "
            ) ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "division_safe"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "\n    cmpl $-1, %ecx\n    jne "
            ) ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "division_safe"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "\n    xorl %edx, %edx\n    xorl %ecx, %ecx\n    divl %ecx\n"
            ) ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "division_safe"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ":\n    cltd\n    idivl %ecx\n"
            )) {
            return false;
        }
    } else {
        if (!bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            ) ||
            !bootstrap_x86_64_codegen_load_rcx(
                context,
                instruction.right,
                record
            )) {
            return false;
        }
        if (width <= 32) {
            if (!bootstrap_x86_64_codegen_literal(
                    context,
                    signed_value ?
                        "    cltd\n    idivl %ecx\n" :
                        "    xorl %edx, %edx\n    divl %ecx\n"
                )) {
                return false;
            }
        } else if (!bootstrap_x86_64_codegen_literal(
                context,
                signed_value ?
                    "    cqto\n    idivq %rcx\n" :
                    "    xorq %rdx, %rdx\n    divq %rcx\n"
            )) {
            return false;
        }
    }
    if (instruction.operation == BootstrapTokenKind.percent &&
        !bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ?
                "    movl %edx, %eax\n" :
                "    movq %rdx, %rax\n"
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_store_rax(
        context,
        instruction.result,
        record
    );
}

fn bootstrap_x86_64_codegen_emit_binary_integer(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    instruction_id: usize
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (record == null) {
        return false;
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    if (instruction.operation == BootstrapTokenKind.slash ||
        instruction.operation == BootstrapTokenKind.percent) {
        return bootstrap_x86_64_codegen_emit_division(
            context,
            instruction,
            record,
            instruction_id
        );
    }
    if (instruction.operation ==
            BootstrapTokenKind.shift_left ||
        instruction.operation ==
            BootstrapTokenKind.shift_right) {
        let signed_narrow_right: bool =
            instruction.operation ==
                BootstrapTokenKind.shift_right &&
            bootstrap_x86_64_codegen_is_signed(
                context,
                record
            ) &&
            width < 32;
        if (!(signed_narrow_right ?
                bootstrap_x86_64_codegen_load_integer(
                    context,
                    instruction.left,
                    record,
                    "%eax",
                    "%rax",
                    true
                ) :
                bootstrap_x86_64_codegen_load_rax(
                    context,
                    instruction.left,
                    record
                )) ||
            !bootstrap_x86_64_codegen_load_rcx(
                context,
                instruction.right,
                record
            )) {
            return false;
        }
        if (width < 32 &&
            (!bootstrap_x86_64_codegen_literal(
                context,
                "    andl $"
            ) ||
            !bootstrap_x86_64_codegen_usize(
                context,
                width - 1
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", %ecx\n"
            ))) {
            return false;
        }
        let mnemonic: *const u8 =
            instruction.operation ==
                    BootstrapTokenKind.shift_left ?
                (width <= 32 ? "    shll %cl, %eax\n" :
                    "    shlq %cl, %rax\n") :
                (bootstrap_x86_64_codegen_is_signed(
                        context,
                        record
                    ) ?
                    (width <= 32 ?
                        "    sarl %cl, %eax\n" :
                        "    sarq %cl, %rax\n") :
                    (width <= 32 ?
                        "    shrl %cl, %eax\n" :
                        "    shrq %cl, %rax\n"));
        return bootstrap_x86_64_codegen_literal(
                context,
                mnemonic
            ) &&
            bootstrap_x86_64_codegen_store_rax(
                context,
                instruction.result,
                record
            );
    }
    let mnemonic: *const u8 =
        bootstrap_x86_64_codegen_binary_mnemonic(
            instruction.operation,
            width
        );
    if (mnemonic == null ||
        !bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            record
        ) ||
        !bootstrap_x86_64_codegen_load_rcx(
            context,
            instruction.right,
            record
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "    ") ||
        !bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) ||
        !bootstrap_x86_64_codegen_literal(context, " ") ||
        !bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ?
                "%ecx, %eax\n" : "%rcx, %rax\n"
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_store_rax(
        context,
        instruction.result,
        record
    );
}

fn bootstrap_x86_64_codegen_emit_binary_float(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (record == null ||
        !bootstrap_x86_64_codegen_load_xmm(
            context,
            instruction.left,
            record,
            "%xmm0"
        )) {
        return false;
    }
    var mnemonic: *const u8 = null;
    if (instruction.operation == BootstrapTokenKind.plus) {
        mnemonic = record->kind == BootstrapTypeKind.float_32 ?
            "addss" : "addsd";
    } else if (instruction.operation ==
        BootstrapTokenKind.minus) {
        mnemonic = record->kind == BootstrapTypeKind.float_32 ?
            "subss" : "subsd";
    } else if (instruction.operation ==
        BootstrapTokenKind.star) {
        mnemonic = record->kind == BootstrapTypeKind.float_32 ?
            "mulss" : "mulsd";
    } else if (instruction.operation ==
        BootstrapTokenKind.slash) {
        mnemonic = record->kind == BootstrapTypeKind.float_32 ?
            "divss" : "divsd";
    }
    if (mnemonic == null ||
        !bootstrap_x86_64_codegen_literal(context, "    ") ||
        !bootstrap_x86_64_codegen_literal(
            context,
            mnemonic
        ) ||
        !bootstrap_x86_64_codegen_literal(context, " ") ||
        !bootstrap_x86_64_codegen_append_value(
            context,
            instruction.right
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %xmm0\n"
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_store_xmm(
        context,
        instruction.result,
        record,
        "%xmm0"
    );
}

fn bootstrap_x86_64_codegen_condition(
    operation: BootstrapTokenKind,
    signed_value: bool
) -> *const u8 {
    if (operation == BootstrapTokenKind.equal_equal) {
        return "sete";
    }
    if (operation == BootstrapTokenKind.bang_equal) {
        return "setne";
    }
    if (operation == BootstrapTokenKind.less) {
        return signed_value ? "setl" : "setb";
    }
    if (operation == BootstrapTokenKind.less_equal) {
        return signed_value ? "setle" : "setbe";
    }
    if (operation == BootstrapTokenKind.greater) {
        return signed_value ? "setg" : "seta";
    }
    if (operation == BootstrapTokenKind.greater_equal) {
        return signed_value ? "setge" : "setae";
    }
    return null;
}

fn bootstrap_x86_64_codegen_emit_compare_float(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    record: *const BootstrapTypeRecord
) -> bool {
    if (!bootstrap_x86_64_codegen_load_xmm(
            context,
            instruction.left,
            record,
            "%xmm0"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            record->kind == BootstrapTypeKind.float_32 ?
                "    ucomiss " : "    ucomisd "
        ) ||
        !bootstrap_x86_64_codegen_append_value(
            context,
            instruction.right
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %xmm0\n"
        )) {
        return false;
    }
    var sequence: *const u8 = null;
    if (instruction.operation == BootstrapTokenKind.equal_equal) {
        sequence =
            "    sete %al\n    setnp %cl\n    andb %cl, %al\n";
    } else if (instruction.operation ==
        BootstrapTokenKind.bang_equal) {
        sequence =
            "    setne %al\n    setp %cl\n    orb %cl, %al\n";
    } else if (instruction.operation == BootstrapTokenKind.less) {
        sequence =
            "    setb %al\n    setnp %cl\n    andb %cl, %al\n";
    } else if (instruction.operation ==
        BootstrapTokenKind.less_equal) {
        sequence =
            "    setbe %al\n    setnp %cl\n    andb %cl, %al\n";
    } else if (instruction.operation ==
        BootstrapTokenKind.greater) {
        sequence = "    seta %al\n";
    } else if (instruction.operation ==
        BootstrapTokenKind.greater_equal) {
        sequence = "    setae %al\n";
    }
    return sequence != null &&
        bootstrap_x86_64_codegen_literal(
            context,
            sequence
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            "    movzbl %al, %eax\n"
        ) &&
        bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            bootstrap_x86_64_codegen_type(
                context,
                instruction.type_id
            )
        );
}

fn bootstrap_x86_64_codegen_emit_compare(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    if (record == null) {
        return false;
    }
    if (bootstrap_type_is_float(record->kind)) {
        return bootstrap_x86_64_codegen_emit_compare_float(
            context,
            instruction,
            record
        );
    }
    let condition: *const u8 =
        bootstrap_x86_64_codegen_condition(
            instruction.operation,
            bootstrap_x86_64_codegen_is_signed(
                context,
                record
            )
        );
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    if (condition == null) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    if (bootstrap_x86_64_codegen_is_signed(
            context,
            record
        ) &&
        width < 32) {
        if (!bootstrap_x86_64_codegen_load_integer(
                context,
                instruction.left,
                record,
                "%eax",
                "%rax",
                true
            ) ||
            !bootstrap_x86_64_codegen_load_integer(
                context,
                instruction.right,
                record,
                "%ecx",
                "%rcx",
                true
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    cmpl %ecx, %eax\n"
            )) {
            return false;
        }
    } else if (!bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            record
        ) ||
        !bootstrap_x86_64_codegen_load_rcx(
            context,
            instruction.right,
            record
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ?
                "    cmpl %ecx, %eax\n" :
                "    cmpq %rcx, %rax\n"
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_literal(context, "    ") &&
        bootstrap_x86_64_codegen_literal(
            context,
            condition
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            " %al\n    movzbl %al, %eax\n"
        ) &&
        bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            bootstrap_x86_64_codegen_type(
                context,
                instruction.type_id
            )
        );
}

fn bootstrap_x86_64_codegen_float_power_bits(
    record: *const BootstrapTypeRecord,
    exponent: usize,
    negative: bool
) -> u64 {
    if (record->kind == BootstrapTypeKind.float_32) {
        let sign: u64 = negative ? 2147483648 : 0;
        return sign |
            ((exponent as u64 + 127) << 23);
    }
    let sign: u64 =
        negative ? 9223372036854775808 : 0;
    return sign |
        ((exponent as u64 + 1023) << 52);
}

fn bootstrap_x86_64_codegen_float_maximum_bits(
    record: *const BootstrapTypeRecord,
    integer_width: usize
) -> u64 {
    let precision: usize =
        record->kind == BootstrapTypeKind.float_32 ? 24 : 53;
    let fraction_width: usize =
        record->kind == BootstrapTypeKind.float_32 ? 23 : 52;
    let bias: usize =
        record->kind == BootstrapTypeKind.float_32 ? 127 : 1023;
    let fraction: u64 =
        ((1 as u64 << ((integer_width - 1) as u64)) - 1) <<
            ((precision - integer_width) as u64);
    return (((integer_width - 1 + bias) as u64) <<
            (fraction_width as u64)) |
        fraction;
}

fn bootstrap_x86_64_codegen_emit_float_bits_xmm1(
    context: *BootstrapX8664CodegenContext,
    record: *const BootstrapTypeRecord,
    bits: u64
) -> bool {
    if (record->kind == BootstrapTypeKind.float_32) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    movl $0x"
            ) &&
            bootstrap_x86_64_codegen_hex(
                context,
                bits & 4294967295,
                8
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                ", %eax\n    movd %eax, %xmm1\n"
            );
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            "    movabsq $0x"
        ) &&
        bootstrap_x86_64_codegen_hex(
            context,
            bits,
            16
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            ", %rax\n    movq %rax, %xmm1\n"
        );
}

fn bootstrap_x86_64_codegen_emit_integer_conversion(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    source: *const BootstrapTypeRecord,
    target: *const BootstrapTypeRecord
) -> bool {
    let source_width: usize =
        bootstrap_x86_64_codegen_bit_width(source);
    let target_width: usize =
        bootstrap_x86_64_codegen_bit_width(target);
    let signed_source: bool =
        bootstrap_x86_64_codegen_is_signed(
            context,
            source
        );
    if (signed_source && target_width == 64 &&
        source_width < 64) {
        if (!bootstrap_x86_64_codegen_load_signed_rax(
                context,
                instruction.left,
                source
            )) {
            return false;
        }
    } else if (!bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            source
        )) {
        return false;
    }
    return bootstrap_x86_64_codegen_store_rax(
        context,
        instruction.result,
        target
    );
}

fn bootstrap_x86_64_codegen_emit_integer_to_float(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    source: *const BootstrapTypeRecord,
    target: *const BootstrapTypeRecord,
    instruction_id: usize
) -> bool {
    let source_width: usize =
        bootstrap_x86_64_codegen_bit_width(source);
    let signed_source: bool =
        bootstrap_x86_64_codegen_is_signed(
            context,
            source
        );
    let convert: *const u8 =
        target->kind == BootstrapTypeKind.float_32 ?
            "    cvtsi2ssq %rax, %xmm0\n" :
            "    cvtsi2sdq %rax, %xmm0\n";
    let add: *const u8 =
        target->kind == BootstrapTypeKind.float_32 ?
            "    addss %xmm0, %xmm0\n" :
            "    addsd %xmm0, %xmm0\n";
    if (signed_source && source_width < 64) {
        if (!bootstrap_x86_64_codegen_load_signed_rax(
                context,
                instruction.left,
                source
            )) {
            return false;
        }
    } else if (!bootstrap_x86_64_codegen_load_rax(
            context,
            instruction.left,
            source
        )) {
        return false;
    }
    if (signed_source || source_width < 64) {
        if (!bootstrap_x86_64_codegen_literal(
                context,
                convert
            )) {
            return false;
        }
    } else if (!bootstrap_x86_64_codegen_literal(
            context,
            "    testq %rax, %rax\n    js "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "uitofp_large"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "\n") ||
        !bootstrap_x86_64_codegen_literal(context, convert) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    jmp "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "uitofp_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "\n") ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "uitofp_large"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ":\n    movq %rax, %rdx\n    shrq $1, %rax\n    andl $1, %edx\n    orq %rdx, %rax\n"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, convert) ||
        !bootstrap_x86_64_codegen_literal(context, add) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "uitofp_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, ":\n")) {
        return false;
    }
    return bootstrap_x86_64_codegen_store_xmm(
        context,
        instruction.result,
        target,
        "%xmm0"
    );
}

fn bootstrap_x86_64_codegen_emit_float_range_check(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    source: *const BootstrapTypeRecord,
    target: *const BootstrapTypeRecord,
    instruction_id: usize
) -> bool {
    let target_width: usize =
        bootstrap_x86_64_codegen_bit_width(target);
    let signed_target: bool =
        bootstrap_x86_64_codegen_is_signed(
            context,
            target
        );
    let bound_exponent: usize =
        signed_target ? target_width - 1 : target_width;
    let maximum_width: usize =
        signed_target ? target_width - 1 : target_width;
    let precision: usize =
        source->kind == BootstrapTypeKind.float_32 ? 24 : 53;
    let exact_maximum: bool = maximum_width <= precision;
    let lower_bits: u64 = signed_target ?
        bootstrap_x86_64_codegen_float_power_bits(
            source,
            bound_exponent,
            true
        ) : 0;
    let upper_bits: u64 = exact_maximum ?
        bootstrap_x86_64_codegen_float_maximum_bits(
            source,
            maximum_width
        ) :
        bootstrap_x86_64_codegen_float_power_bits(
            source,
            bound_exponent,
            false
        );
    let compare: *const u8 =
        source->kind == BootstrapTypeKind.float_32 ?
            "    ucomiss %xmm1, %xmm0\n" :
            "    ucomisd %xmm1, %xmm0\n";
    return bootstrap_x86_64_codegen_emit_float_bits_xmm1(
            context,
            source,
            lower_bits
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            compare
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            "    jb "
        ) &&
        bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "fptoi_trap"
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n") &&
        bootstrap_x86_64_codegen_emit_float_bits_xmm1(
            context,
            source,
            upper_bits
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            compare
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            exact_maximum ? "    ja " : "    jae "
        ) &&
        bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "fptoi_trap"
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_float_to_integer(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    source: *const BootstrapTypeRecord,
    target: *const BootstrapTypeRecord,
    instruction_id: usize
) -> bool {
    if (!bootstrap_x86_64_codegen_load_xmm(
            context,
            instruction.left,
            source,
            "%xmm0"
        ) ||
        !bootstrap_x86_64_codegen_emit_float_range_check(
            context,
            instruction,
            source,
            target,
            instruction_id
        )) {
        return false;
    }
    let target_width: usize =
        bootstrap_x86_64_codegen_bit_width(target);
    let signed_target: bool =
        bootstrap_x86_64_codegen_is_signed(
            context,
            target
        );
    let convert_32: *const u8 =
        source->kind == BootstrapTypeKind.float_32 ?
            "    cvttss2si %xmm0, %eax\n" :
            "    cvttsd2si %xmm0, %eax\n";
    let convert_64: *const u8 =
        source->kind == BootstrapTypeKind.float_32 ?
            "    cvttss2siq %xmm0, %rax\n" :
            "    cvttsd2siq %xmm0, %rax\n";
    if (signed_target) {
        if (!bootstrap_x86_64_codegen_literal(
                context,
                target_width == 64 ?
                    convert_64 : convert_32
            )) {
            return false;
        }
    } else if (target_width < 64) {
        if (!bootstrap_x86_64_codegen_literal(
                context,
                convert_64
            )) {
            return false;
        }
    } else {
        let split_bits: u64 =
            bootstrap_x86_64_codegen_float_power_bits(
                source,
                63,
                false
            );
        if (!bootstrap_x86_64_codegen_emit_float_bits_xmm1(
                context,
                source,
                split_bits
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                source->kind == BootstrapTypeKind.float_32 ?
                    "    ucomiss %xmm1, %xmm0\n" :
                    "    ucomisd %xmm1, %xmm0\n"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    jb "
            ) ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "fptoi_low"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                source->kind == BootstrapTypeKind.float_32 ?
                    "\n    subss %xmm1, %xmm0\n" :
                    "\n    subsd %xmm1, %xmm0\n"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                convert_64
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    movabsq $0x8000000000000000, %rdx\n    orq %rdx, %rax\n    jmp "
            ) ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "fptoi_converted"
            ) ||
            !bootstrap_x86_64_codegen_literal(context, "\n") ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "fptoi_low"
            ) ||
            !bootstrap_x86_64_codegen_literal(context, ":\n") ||
            !bootstrap_x86_64_codegen_literal(
                context,
                convert_64
            ) ||
            !bootstrap_x86_64_codegen_instruction_label(
                context,
                instruction_id,
                "fptoi_converted"
            ) ||
            !bootstrap_x86_64_codegen_literal(context, ":\n")) {
            return false;
        }
    }
    if (!bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            target
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    jmp "
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "fptoi_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "\n") ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "fptoi_trap"
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ":\n    ud2\n"
        ) ||
        !bootstrap_x86_64_codegen_instruction_label(
            context,
            instruction_id,
            "fptoi_done"
        ) ||
        !bootstrap_x86_64_codegen_literal(context, ":\n")) {
        return false;
    }
    return true;
}

fn bootstrap_x86_64_codegen_emit_convert(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    instruction_id: usize
) -> bool {
    let values: *const BootstrapIrValue =
        context->ir.values.data as *const BootstrapIrValue;
    let source: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            values[instruction.left].type_id
        );
    let target: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (source == null || target == null) {
        return false;
    }
    if (bootstrap_type_is_float(source->kind) &&
        bootstrap_type_is_float(target->kind)) {
        return bootstrap_x86_64_codegen_load_xmm(
                context,
                instruction.left,
                source,
                "%xmm0"
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                source->kind == BootstrapTypeKind.float_32 ?
                    "    cvtss2sd %xmm0, %xmm0\n" :
                    "    cvtsd2ss %xmm0, %xmm0\n"
            ) &&
            bootstrap_x86_64_codegen_store_xmm(
                context,
                instruction.result,
                target,
                "%xmm0"
            );
    }
    if (bootstrap_type_is_float(target->kind)) {
        return bootstrap_x86_64_codegen_emit_integer_to_float(
            context,
            instruction,
            source,
            target,
            instruction_id
        );
    }
    if (bootstrap_type_is_float(source->kind)) {
        return bootstrap_x86_64_codegen_emit_float_to_integer(
            context,
            instruction,
            source,
            target,
            instruction_id
        );
    }
    return bootstrap_x86_64_codegen_emit_integer_conversion(
        context,
        instruction,
        source,
        target
    );
}

fn bootstrap_x86_64_codegen_general_register_64(
    index: usize
) -> *const u8 {
    if (index == 0) {
        return "%rdi";
    }
    if (index == 1) {
        return "%rsi";
    }
    if (index == 2) {
        return "%rdx";
    }
    if (index == 3) {
        return "%rcx";
    }
    if (index == 4) {
        return "%r8";
    }
    return index == 5 ? "%r9" : null;
}

fn bootstrap_x86_64_codegen_general_register_32(
    index: usize
) -> *const u8 {
    if (index == 0) {
        return "%edi";
    }
    if (index == 1) {
        return "%esi";
    }
    if (index == 2) {
        return "%edx";
    }
    if (index == 3) {
        return "%ecx";
    }
    if (index == 4) {
        return "%r8d";
    }
    return index == 5 ? "%r9d" : null;
}

fn bootstrap_x86_64_codegen_vector_register(
    index: usize
) -> *const u8 {
    if (index == 0) {
        return "%xmm0";
    }
    if (index == 1) {
        return "%xmm1";
    }
    if (index == 2) {
        return "%xmm2";
    }
    if (index == 3) {
        return "%xmm3";
    }
    if (index == 4) {
        return "%xmm4";
    }
    if (index == 5) {
        return "%xmm5";
    }
    if (index == 6) {
        return "%xmm6";
    }
    return index == 7 ? "%xmm7" : null;
}

fn bootstrap_x86_64_codegen_return_general_register(
    index: usize
) -> *const u8 {
    if (index == 0) {
        return "%rax";
    }
    return index == 1 ? "%rdx" : null;
}

fn bootstrap_x86_64_codegen_argument_at(
    context: *BootstrapX8664CodegenContext,
    instruction_id: usize,
    argument_index: usize
) -> usize {
    let arguments: *const BootstrapIrArgument =
        context->ir.arguments.data as
            *const BootstrapIrArgument;
    var found: usize = 0;
    var index: usize = 0;
    while (index < context->ir.argument_count) {
        if (arguments[index].instruction_id == instruction_id) {
            if (found == argument_index) {
                return arguments[index].value_id;
            }
            found += 1;
        }
        index += 1;
    }
    bootstrap_x86_64_codegen_fail(
        context,
        RuntimeError.invalid_argument
    );
    return bootstrap_x86_64_codegen_no_id();
}

fn bootstrap_x86_64_codegen_emit_load_piece(
    context: *BootstrapX8664CodegenContext,
    piece: BootstrapX8664AbiPiece,
    destination: *const u8
) -> bool {
    if (piece.size_bytes == 8) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    movq "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                piece.value_offset_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%r11), "
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                destination
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    if (piece.size_bytes == 4) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    movl "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                piece.value_offset_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%r11), %eax\n    movq %rax, "
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                destination
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    if (piece.size_bytes == 2) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    movzwl "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                piece.value_offset_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%r11), %eax\n    movq %rax, "
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                destination
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    if (piece.size_bytes == 1) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    movzbl "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                piece.value_offset_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%r11), %eax\n    movq %rax, "
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                destination
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    if (piece.size_bytes == 0 || piece.size_bytes > 8 ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    xorq %rax, %rax\n"
        )) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    var index: usize = 0;
    while (index < piece.size_bytes) {
        if (!bootstrap_x86_64_codegen_literal(
                context,
                "    movzbl "
            ) ||
            !bootstrap_x86_64_codegen_usize(
                context,
                piece.value_offset_bytes + index
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "(%r11), %r10d\n"
            ) ||
            (index != 0 &&
                (!bootstrap_x86_64_codegen_literal(
                    context,
                    "    shlq $"
                ) ||
                !bootstrap_x86_64_codegen_usize(
                    context,
                    index * 8
                ) ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    ", %r10\n"
                ))) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    orq %r10, %rax\n"
            )) {
            return false;
        }
        index += 1;
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            "    movq %rax, "
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            destination
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_store_piece(
    context: *BootstrapX8664CodegenContext,
    piece: BootstrapX8664AbiPiece,
    source: *const u8
) -> bool {
    if (piece.size_bytes == 0 || piece.size_bytes > 8 ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    movq "
        ) ||
        !bootstrap_x86_64_codegen_literal(context, source) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %r10\n"
        )) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    var index: usize = 0;
    while (index < piece.size_bytes) {
        if (!bootstrap_x86_64_codegen_literal(
                context,
                "    movb %r10b, "
            ) ||
            !bootstrap_x86_64_codegen_usize(
                context,
                piece.value_offset_bytes + index
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "(%r11)\n"
            ) ||
            (index + 1 != piece.size_bytes &&
                !bootstrap_x86_64_codegen_literal(
                    context,
                    "    shrq $8, %r10\n"
                ))) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_codegen_emit_call_stack_argument(
    context: *BootstrapX8664CodegenContext,
    parameter: BootstrapX8664AbiParameter,
    argument: usize,
    external_c: bool
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            parameter.type_id
        );
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        let values: *const BootstrapIrValue =
            context->ir.values.data as *const BootstrapIrValue;
        let pointer_record: *const BootstrapTypeRecord =
            bootstrap_x86_64_codegen_type(
                context,
                values[argument].type_id
            );
        return pointer_record != null &&
            bootstrap_x86_64_codegen_load_integer(
                context,
                argument,
                pointer_record,
                "%esi",
                "%rsi",
                false
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "    leaq "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                parameter.stack_offset_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%rsp), %rdi\n    movq $"
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                parameter.size_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                ", %rcx\n    cld\n    rep movsb\n"
            );
    }
    if (bootstrap_type_is_float(record->kind)) {
        return bootstrap_x86_64_codegen_load_xmm(
                context,
                argument,
                record,
                "%xmm0"
            ) &&
            bootstrap_x86_64_codegen_literal(context, "    ") &&
            bootstrap_x86_64_codegen_literal(
                context,
                bootstrap_x86_64_codegen_float_move(record)
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                " %xmm0, "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                parameter.stack_offset_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%rsp)\n"
            );
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    let extend_signed: bool =
        external_c &&
        bootstrap_x86_64_codegen_is_signed(
            context,
            record
        ) &&
        width < 32;
    return (extend_signed ?
            bootstrap_x86_64_codegen_load_integer(
                context,
                argument,
                record,
                "%eax",
                "%rax",
                true
            ) :
            bootstrap_x86_64_codegen_load_rax(
                context,
                argument,
                record
            )) &&
        bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ?
                "    movl %eax, " : "    movq %rax, "
        ) &&
        bootstrap_x86_64_codegen_usize(
            context,
            parameter.stack_offset_bytes
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            "(%rsp)\n"
        );
}

fn bootstrap_x86_64_codegen_emit_call_register_argument(
    context: *BootstrapX8664CodegenContext,
    parameter: BootstrapX8664AbiParameter,
    argument: usize,
    external_c: bool
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            parameter.type_id
        );
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        let values: *const BootstrapIrValue =
            context->ir.values.data as *const BootstrapIrValue;
        let pointer_record: *const BootstrapTypeRecord =
            bootstrap_x86_64_codegen_type(
                context,
                values[argument].type_id
            );
        if (pointer_record == null ||
            !bootstrap_x86_64_codegen_load_integer(
                context,
                argument,
                pointer_record,
                "%r11d",
                "%r11",
                false
            )) {
            return false;
        }
        let pieces: *const BootstrapX8664AbiPiece =
            context->abi.pieces.data as
                *const BootstrapX8664AbiPiece;
        var index: usize = 0;
        while (index < parameter.piece_count) {
            let piece: BootstrapX8664AbiPiece =
                pieces[parameter.first_piece + index];
            if (piece.abi_class ==
                BootstrapX8664AbiClass.integer) {
                let destination: *const u8 =
                    bootstrap_x86_64_codegen_general_register_64(
                        piece.register_index
                    );
                if (destination == null ||
                    !bootstrap_x86_64_codegen_emit_load_piece(
                        context,
                        piece,
                        destination
                    )) {
                    return false;
                }
            } else {
                let destination: *const u8 =
                    bootstrap_x86_64_codegen_vector_register(
                        piece.register_index
                    );
                if (destination == null ||
                    (piece.size_bytes != 4 &&
                        piece.size_bytes != 8) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        piece.size_bytes == 4 ?
                            "    movss " : "    movq "
                    ) ||
                    !bootstrap_x86_64_codegen_usize(
                        context,
                        piece.value_offset_bytes
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        "(%r11), "
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        destination
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        "\n"
                    )) {
                    return false;
                }
            }
            index += 1;
        }
        return true;
    }
    if (parameter.location ==
        BootstrapX8664AbiLocationKind.vector_register) {
        let destination: *const u8 =
            bootstrap_x86_64_codegen_vector_register(
                parameter.register_index
            );
        return destination != null &&
            bootstrap_x86_64_codegen_load_xmm(
                context,
                argument,
                record,
                destination
            );
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    let destination: *const u8 =
        width <= 32 ?
            bootstrap_x86_64_codegen_general_register_32(
                parameter.register_index
            ) :
            bootstrap_x86_64_codegen_general_register_64(
                parameter.register_index
            );
    if (destination == null) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    return bootstrap_x86_64_codegen_load_integer(
        context,
        argument,
        record,
        destination,
        destination,
        external_c &&
            bootstrap_x86_64_codegen_is_signed(
                context,
                record
            ) &&
            width < 32
    );
}

fn bootstrap_x86_64_codegen_emit_call_result(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    function_abi: BootstrapX8664AbiFunction
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            instruction.type_id
        );
    if (record == null ||
        record->kind == BootstrapTypeKind.type_void) {
        return record != null;
    }
    if (!function_abi.return_aggregate) {
        if (bootstrap_type_is_float(record->kind)) {
            return bootstrap_x86_64_codegen_store_xmm(
                context,
                instruction.result,
                record,
                "%xmm0"
            );
        }
        if (record->kind == BootstrapTypeKind.boolean &&
            !bootstrap_x86_64_codegen_literal(
                context,
                "    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n"
            )) {
            return false;
        }
        return bootstrap_x86_64_codegen_store_rax(
            context,
            instruction.result,
            record
        );
    }
    let destination: BootstrapX8664Storage =
        bootstrap_x86_64_codegen_storage(
            context,
            BootstrapX8664StorageKind.aggregate_call_result,
            instruction.result
        );
    if (context->error != RuntimeError.none ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    leaq "
        ) ||
        !bootstrap_x86_64_codegen_append_stack(
            context,
            destination
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %r11\n"
        )) {
        return false;
    }
    if (!function_abi.hidden_return_pointer) {
        let pieces: *const BootstrapX8664AbiPiece =
            context->abi.pieces.data as
                *const BootstrapX8664AbiPiece;
        var index: usize = 0;
        while (index < function_abi.return_piece_count) {
            let piece: BootstrapX8664AbiPiece =
                pieces[function_abi.first_return_piece + index];
            if (piece.abi_class ==
                BootstrapX8664AbiClass.integer) {
                let source: *const u8 =
                    bootstrap_x86_64_codegen_return_general_register(
                        piece.register_index
                    );
                if (source == null ||
                    !bootstrap_x86_64_codegen_emit_store_piece(
                        context,
                        piece,
                        source
                    )) {
                    return false;
                }
            } else {
                let source: *const u8 =
                    bootstrap_x86_64_codegen_vector_register(
                        piece.register_index
                    );
                if (source == null ||
                    (piece.size_bytes != 4 &&
                        piece.size_bytes != 8) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        piece.size_bytes == 4 ?
                            "    movss " : "    movq "
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        source
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        ", "
                    ) ||
                    !bootstrap_x86_64_codegen_usize(
                        context,
                        piece.value_offset_bytes
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        "(%r11)\n"
                    )) {
                    return false;
                }
            }
            index += 1;
        }
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            "    leaq "
        ) &&
        bootstrap_x86_64_codegen_append_stack(
            context,
            destination
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            ", %rax\n    movq %rax, "
        ) &&
        bootstrap_x86_64_codegen_append_value(
            context,
            instruction.result
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_call(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    instruction_id: usize
) -> bool {
    if (instruction.auxiliary >= context->ir.function_count) {
        return bootstrap_x86_64_codegen_fail(
            context,
            RuntimeError.invalid_argument
        );
    }
    let abi_functions: *const BootstrapX8664AbiFunction =
        context->abi.functions.data as
            *const BootstrapX8664AbiFunction;
    let function_abi: BootstrapX8664AbiFunction =
        abi_functions[instruction.auxiliary];
    let functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    let external_c: bool =
        functions[instruction.auxiliary].linkage ==
            BootstrapIrLinkage.external_c;
    let parameters: *const BootstrapX8664AbiParameter =
        context->abi.parameters.data as
            *const BootstrapX8664AbiParameter;
    if (function_abi.call_frame_size_bytes != 0 &&
        (!bootstrap_x86_64_codegen_literal(
            context,
            "    subq $"
        ) ||
        !bootstrap_x86_64_codegen_usize(
            context,
            function_abi.call_frame_size_bytes
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %rsp\n"
        ))) {
        return false;
    }
    var index: usize = 0;
    while (index < function_abi.parameter_count) {
        let parameter: BootstrapX8664AbiParameter =
            parameters[function_abi.first_parameter + index];
        if (parameter.location ==
            BootstrapX8664AbiLocationKind.stack) {
            let argument: usize =
                bootstrap_x86_64_codegen_argument_at(
                    context,
                    instruction_id,
                    index
                );
            if (argument ==
                    bootstrap_x86_64_codegen_no_id() ||
                !bootstrap_x86_64_codegen_emit_call_stack_argument(
                    context,
                    parameter,
                    argument,
                    external_c
                )) {
                return false;
            }
        }
        index += 1;
    }
    if (function_abi.hidden_return_pointer) {
        let destination: BootstrapX8664Storage =
            bootstrap_x86_64_codegen_storage(
                context,
                BootstrapX8664StorageKind.aggregate_call_result,
                instruction.result
            );
        if (context->error != RuntimeError.none ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    leaq "
            ) ||
            !bootstrap_x86_64_codegen_append_stack(
                context,
                destination
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", %rdi\n"
            )) {
            return false;
        }
    }
    index = 0;
    while (index < function_abi.parameter_count) {
        let parameter: BootstrapX8664AbiParameter =
            parameters[function_abi.first_parameter + index];
        if (parameter.location !=
            BootstrapX8664AbiLocationKind.stack) {
            let argument: usize =
                bootstrap_x86_64_codegen_argument_at(
                    context,
                    instruction_id,
                    index
                );
            if (argument ==
                    bootstrap_x86_64_codegen_no_id() ||
                !bootstrap_x86_64_codegen_emit_call_register_argument(
                    context,
                    parameter,
                    argument,
                    external_c
                )) {
                return false;
            }
        }
        index += 1;
    }
    if (!bootstrap_x86_64_codegen_literal(
            context,
            "    call "
        ) ||
        !bootstrap_x86_64_codegen_append_function_symbol(
            context,
            instruction.auxiliary
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "\n")) {
        return false;
    }
    if (function_abi.call_frame_size_bytes != 0 &&
        (!bootstrap_x86_64_codegen_literal(
            context,
            "    addq $"
        ) ||
        !bootstrap_x86_64_codegen_usize(
            context,
            function_abi.call_frame_size_bytes
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %rsp\n"
        ))) {
        return false;
    }
    return bootstrap_x86_64_codegen_emit_call_result(
        context,
        instruction,
        function_abi
    );
}

fn bootstrap_x86_64_codegen_emit_parameter_register(
    context: *BootstrapX8664CodegenContext,
    parameter: BootstrapX8664AbiParameter,
    ir_parameter: BootstrapIrParameter
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            parameter.type_id
        );
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        if (!bootstrap_x86_64_codegen_literal(
                context,
                "    leaq "
            ) ||
            !bootstrap_x86_64_codegen_append_slot(
                context,
                ir_parameter.slot_id
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", %r11\n"
            )) {
            return false;
        }
        let pieces: *const BootstrapX8664AbiPiece =
            context->abi.pieces.data as
                *const BootstrapX8664AbiPiece;
        var index: usize = 0;
        while (index < parameter.piece_count) {
            let piece: BootstrapX8664AbiPiece =
                pieces[parameter.first_piece + index];
            if (piece.abi_class ==
                BootstrapX8664AbiClass.integer) {
                let source: *const u8 =
                    bootstrap_x86_64_codegen_general_register_64(
                        piece.register_index
                    );
                if (source == null ||
                    !bootstrap_x86_64_codegen_emit_store_piece(
                        context,
                        piece,
                        source
                    )) {
                    return false;
                }
            } else {
                let source: *const u8 =
                    bootstrap_x86_64_codegen_vector_register(
                        piece.register_index
                    );
                if (source == null ||
                    (piece.size_bytes != 4 &&
                        piece.size_bytes != 8) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        piece.size_bytes == 4 ?
                            "    movss " : "    movq "
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        source
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        ", "
                    ) ||
                    !bootstrap_x86_64_codegen_usize(
                        context,
                        piece.value_offset_bytes
                    ) ||
                    !bootstrap_x86_64_codegen_literal(
                        context,
                        "(%r11)\n"
                    )) {
                    return false;
                }
            }
            index += 1;
        }
        return true;
    }
    if (parameter.location ==
        BootstrapX8664AbiLocationKind.vector_register) {
        let source: *const u8 =
            bootstrap_x86_64_codegen_vector_register(
                parameter.register_index
            );
        return source != null &&
            bootstrap_x86_64_codegen_literal(context, "    ") &&
            bootstrap_x86_64_codegen_literal(
                context,
                bootstrap_x86_64_codegen_float_move(record)
            ) &&
            bootstrap_x86_64_codegen_literal(context, " ") &&
            bootstrap_x86_64_codegen_literal(context, source) &&
            bootstrap_x86_64_codegen_literal(context, ", ") &&
            bootstrap_x86_64_codegen_append_slot(
                context,
                ir_parameter.slot_id
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    let source: *const u8 =
        width <= 32 ?
            bootstrap_x86_64_codegen_general_register_32(
                parameter.register_index
            ) :
            bootstrap_x86_64_codegen_general_register_64(
                parameter.register_index
            );
    return source != null &&
        bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ?
                "    movl " : "    movq "
        ) &&
        bootstrap_x86_64_codegen_literal(context, source) &&
        bootstrap_x86_64_codegen_literal(context, ", ") &&
        bootstrap_x86_64_codegen_append_slot(
            context,
            ir_parameter.slot_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_parameter_stack(
    context: *BootstrapX8664CodegenContext,
    parameter: BootstrapX8664AbiParameter,
    ir_parameter: BootstrapIrParameter
) -> bool {
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            parameter.type_id
        );
    let source_offset: usize =
        parameter.stack_offset_bytes + 16;
    if (record == null) {
        return false;
    }
    if (parameter.aggregate) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    leaq "
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                source_offset
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%rbp), %rsi\n    leaq "
            ) &&
            bootstrap_x86_64_codegen_append_slot(
                context,
                ir_parameter.slot_id
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                ", %rdi\n    movq $"
            ) &&
            bootstrap_x86_64_codegen_usize(
                context,
                parameter.size_bytes
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                ", %rcx\n    cld\n    rep movsb\n"
            );
    }
    if (bootstrap_type_is_float(record->kind)) {
        return bootstrap_x86_64_codegen_literal(context, "    ") &&
            bootstrap_x86_64_codegen_literal(
                context,
                bootstrap_x86_64_codegen_float_move(record)
            ) &&
            bootstrap_x86_64_codegen_literal(context, " ") &&
            bootstrap_x86_64_codegen_usize(
                context,
                source_offset
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "(%rbp), %xmm15\n    "
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                bootstrap_x86_64_codegen_float_move(record)
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                " %xmm15, "
            ) &&
            bootstrap_x86_64_codegen_append_slot(
                context,
                ir_parameter.slot_id
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    let width: usize =
        bootstrap_x86_64_codegen_bit_width(record);
    return bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ? "    movl " : "    movq "
        ) &&
        bootstrap_x86_64_codegen_usize(
            context,
            source_offset
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            width <= 32 ?
                "(%rbp), %eax\n    movl %eax, " :
                "(%rbp), %rax\n    movq %rax, "
        ) &&
        bootstrap_x86_64_codegen_append_slot(
            context,
            ir_parameter.slot_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_parameters(
    context: *BootstrapX8664CodegenContext,
    function: BootstrapIrFunction,
    function_abi: BootstrapX8664AbiFunction
) -> bool {
    let parameters: *const BootstrapX8664AbiParameter =
        context->abi.parameters.data as
            *const BootstrapX8664AbiParameter;
    let ir_parameters: *const BootstrapIrParameter =
        context->ir.parameters.data as
            *const BootstrapIrParameter;
    if (function_abi.hidden_return_pointer) {
        let storage: BootstrapX8664Storage =
            bootstrap_x86_64_codegen_storage(
                context,
                BootstrapX8664StorageKind.hidden_return_pointer,
                context->current_function
            );
        if (context->error != RuntimeError.none ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    movq %rdi, "
            ) ||
            !bootstrap_x86_64_codegen_append_stack(
                context,
                storage
            ) ||
            !bootstrap_x86_64_codegen_literal(context, "\n")) {
            return false;
        }
    }
    var phase: usize = 0;
    while (phase < 2) {
        var index: usize = 0;
        while (index < function.parameter_count) {
            let parameter: BootstrapX8664AbiParameter =
                parameters[function_abi.first_parameter + index];
            let is_stack: bool =
                parameter.location ==
                    BootstrapX8664AbiLocationKind.stack;
            if ((phase == 0 && !is_stack) ||
                (phase == 1 && is_stack)) {
                let ir_parameter: BootstrapIrParameter =
                    ir_parameters[
                        function.first_parameter + index
                    ];
                let emitted: bool = is_stack ?
                    bootstrap_x86_64_codegen_emit_parameter_stack(
                        context,
                        parameter,
                        ir_parameter
                    ) :
                    bootstrap_x86_64_codegen_emit_parameter_register(
                        context,
                        parameter,
                        ir_parameter
                    );
                if (!emitted) {
                    return false;
                }
            }
            index += 1;
        }
        phase += 1;
    }
    return true;
}

fn bootstrap_x86_64_codegen_emit_return(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    let functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    let abi_functions: *const BootstrapX8664AbiFunction =
        context->abi.functions.data as
            *const BootstrapX8664AbiFunction;
    let function: BootstrapIrFunction =
        functions[context->current_function];
    let function_abi: BootstrapX8664AbiFunction =
        abi_functions[context->current_function];
    let record: *const BootstrapTypeRecord =
        bootstrap_x86_64_codegen_type(
            context,
            function.return_type
        );
    if (record == null) {
        return false;
    }
    if (instruction.opcode ==
            BootstrapIrOpcode.return_value &&
        function_abi.return_aggregate) {
        if (!bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    movq %rax, %r11\n"
            )) {
            return false;
        }
        if (function_abi.hidden_return_pointer) {
            let hidden: BootstrapX8664Storage =
                bootstrap_x86_64_codegen_storage(
                    context,
                    BootstrapX8664StorageKind.hidden_return_pointer,
                    context->current_function
                );
            if (context->error != RuntimeError.none ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    "    movq "
                ) ||
                !bootstrap_x86_64_codegen_append_stack(
                    context,
                    hidden
                ) ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    ", %rdi\n    movq %rdi, %rax\n    movq %r11, %rsi\n    movq $"
                ) ||
                !bootstrap_x86_64_codegen_usize(
                    context,
                    function_abi.return_size_bytes
                ) ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    ", %rcx\n    cld\n    rep movsb\n"
                )) {
                return false;
            }
        } else {
            let pieces: *const BootstrapX8664AbiPiece =
                context->abi.pieces.data as
                    *const BootstrapX8664AbiPiece;
            var reverse: usize =
                function_abi.return_piece_count;
            while (reverse != 0) {
                reverse -= 1;
                let piece: BootstrapX8664AbiPiece =
                    pieces[
                        function_abi.first_return_piece + reverse
                    ];
                if (piece.abi_class ==
                    BootstrapX8664AbiClass.integer) {
                    let destination: *const u8 =
                        bootstrap_x86_64_codegen_return_general_register(
                            piece.register_index
                        );
                    if (destination == null ||
                        !bootstrap_x86_64_codegen_emit_load_piece(
                            context,
                            piece,
                            destination
                        )) {
                        return false;
                    }
                } else {
                    let destination: *const u8 =
                        bootstrap_x86_64_codegen_vector_register(
                            piece.register_index
                        );
                    if (destination == null ||
                        (piece.size_bytes != 4 &&
                            piece.size_bytes != 8) ||
                        !bootstrap_x86_64_codegen_literal(
                            context,
                            piece.size_bytes == 4 ?
                                "    movss " : "    movq "
                        ) ||
                        !bootstrap_x86_64_codegen_usize(
                            context,
                            piece.value_offset_bytes
                        ) ||
                        !bootstrap_x86_64_codegen_literal(
                            context,
                            "(%r11), "
                        ) ||
                        !bootstrap_x86_64_codegen_literal(
                            context,
                            destination
                        ) ||
                        !bootstrap_x86_64_codegen_literal(
                            context,
                            "\n"
                        )) {
                        return false;
                    }
                }
            }
        }
    } else if (instruction.opcode ==
        BootstrapIrOpcode.return_value) {
        if (bootstrap_type_is_float(record->kind)) {
            if (!bootstrap_x86_64_codegen_load_xmm(
                    context,
                    instruction.left,
                    record,
                    "%xmm0"
                )) {
                return false;
            }
        } else if (!bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            )) {
            return false;
        }
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            "    jmp "
        ) &&
        bootstrap_x86_64_codegen_return_label(context) &&
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_control(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction
) -> bool {
    if (instruction.opcode == BootstrapIrOpcode.jump) {
        return bootstrap_x86_64_codegen_literal(
                context,
                "    jmp "
            ) &&
            bootstrap_x86_64_codegen_block_label(
                context,
                instruction.auxiliary
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    if (instruction.opcode == BootstrapIrOpcode.branch) {
        let values: *const BootstrapIrValue =
            context->ir.values.data as *const BootstrapIrValue;
        let record: *const BootstrapTypeRecord =
            bootstrap_x86_64_codegen_type(
                context,
                values[instruction.left].type_id
            );
        return record != null &&
            bootstrap_x86_64_codegen_load_rax(
                context,
                instruction.left,
                record
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "    testl %eax, %eax\n    jne "
            ) &&
            bootstrap_x86_64_codegen_block_label(
                context,
                instruction.auxiliary
            ) &&
            bootstrap_x86_64_codegen_literal(
                context,
                "\n    jmp "
            ) &&
            bootstrap_x86_64_codegen_block_label(
                context,
                instruction.third
            ) &&
            bootstrap_x86_64_codegen_literal(context, "\n");
    }
    return bootstrap_x86_64_codegen_emit_return(
        context,
        instruction
    );
}

fn bootstrap_x86_64_codegen_emit_instruction(
    context: *BootstrapX8664CodegenContext,
    instruction: BootstrapIrInstruction,
    instruction_id: usize
) -> bool {
    if (instruction.opcode ==
            BootstrapIrOpcode.constant_integer ||
        instruction.opcode ==
            BootstrapIrOpcode.constant_float ||
        instruction.opcode ==
            BootstrapIrOpcode.constant_boolean ||
        instruction.opcode ==
            BootstrapIrOpcode.constant_null) {
        return bootstrap_x86_64_codegen_emit_constant(
            context,
            instruction
        );
    }
    if (instruction.opcode ==
            BootstrapIrOpcode.address_of_slot ||
        instruction.opcode ==
            BootstrapIrOpcode.member_address ||
        instruction.opcode ==
            BootstrapIrOpcode.global_address ||
        instruction.opcode ==
            BootstrapIrOpcode.pointer_offset) {
        return bootstrap_x86_64_codegen_emit_address(
            context,
            instruction
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.zero_slot) {
        return bootstrap_x86_64_codegen_emit_zero(
            context,
            instruction
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.memory_copy) {
        return bootstrap_x86_64_codegen_emit_memory_copy(
            context,
            instruction,
            instruction_id
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.load ||
        instruction.opcode == BootstrapIrOpcode.store) {
        return bootstrap_x86_64_codegen_emit_slot_access(
            context,
            instruction
        );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.load_indirect) {
        return bootstrap_x86_64_codegen_emit_load_indirect(
            context,
            instruction
        );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.store_indirect) {
        return bootstrap_x86_64_codegen_emit_store_indirect(
            context,
            instruction
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.null_check ||
        instruction.opcode == BootstrapIrOpcode.bounds_check) {
        return bootstrap_x86_64_codegen_emit_check(
            context,
            instruction,
            instruction_id
        );
    }
    if (instruction.opcode ==
            BootstrapIrOpcode.unary_integer ||
        instruction.opcode ==
            BootstrapIrOpcode.unary_float ||
        instruction.opcode ==
            BootstrapIrOpcode.boolean_not) {
        return bootstrap_x86_64_codegen_emit_unary(
            context,
            instruction
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.convert) {
        return bootstrap_x86_64_codegen_emit_convert(
            context,
            instruction,
            instruction_id
        );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.binary_integer) {
        return bootstrap_x86_64_codegen_emit_binary_integer(
            context,
            instruction,
            instruction_id
        );
    }
    if (instruction.opcode ==
        BootstrapIrOpcode.binary_float) {
        return bootstrap_x86_64_codegen_emit_binary_float(
            context,
            instruction
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.compare) {
        return bootstrap_x86_64_codegen_emit_compare(
            context,
            instruction
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.call) {
        return bootstrap_x86_64_codegen_emit_call(
            context,
            instruction,
            instruction_id
        );
    }
    if (instruction.opcode == BootstrapIrOpcode.jump ||
        instruction.opcode == BootstrapIrOpcode.branch ||
        instruction.opcode ==
            BootstrapIrOpcode.return_value ||
        instruction.opcode ==
            BootstrapIrOpcode.return_void) {
        return bootstrap_x86_64_codegen_emit_control(
            context,
            instruction
        );
    }
    return bootstrap_x86_64_codegen_fail(
        context,
        RuntimeError.invalid_argument
    );
}

fn bootstrap_x86_64_codegen_emit_globals(
    context: *BootstrapX8664CodegenContext
) -> bool {
    let globals: *const BootstrapIrGlobal =
        context->ir.globals.data as *const BootstrapIrGlobal;
    var global_id: usize = 0;
    while (global_id < context->ir.global_count) {
        let global: BootstrapIrGlobal = globals[global_id];
        if (!bootstrap_x86_64_codegen_literal(
                context,
                global.read_only ?
                    "    .section .rodata,\"a\",@progbits\n" :
                    "    .data\n"
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "    .balign "
            ) ||
            !bootstrap_x86_64_codegen_usize(
                context,
                global.alignment_bytes
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "\n    .type "
            ) ||
            !bootstrap_x86_64_codegen_append_global_label(
                context,
                global_id
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", @object\n"
            ) ||
            !bootstrap_x86_64_codegen_append_global_label(
                context,
                global_id
            ) ||
            !bootstrap_x86_64_codegen_literal(context, ":\n")) {
            return false;
        }
        var byte_index: usize = 0;
        while (byte_index < global.byte_count) {
            if (!bootstrap_x86_64_codegen_literal(
                    context,
                    "    .byte 0x"
                ) ||
                !bootstrap_x86_64_codegen_hex(
                    context,
                    context->ir.global_bytes.data[
                        global.byte_offset + byte_index
                    ] as u64,
                    2
                ) ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    "\n"
                )) {
                return false;
            }
            byte_index += 1;
        }
        if (!bootstrap_x86_64_codegen_literal(
                context,
                "    .size "
            ) ||
            !bootstrap_x86_64_codegen_append_global_label(
                context,
                global_id
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                ", .-"
            ) ||
            !bootstrap_x86_64_codegen_append_global_label(
                context,
                global_id
            ) ||
            !bootstrap_x86_64_codegen_literal(
                context,
                "\n\n"
            )) {
            return false;
        }
        global_id += 1;
    }
    return true;
}

fn bootstrap_x86_64_codegen_emit_declarations(
    context: *BootstrapX8664CodegenContext
) -> bool {
    let functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    var function_id: usize = 0;
    var emitted: bool = false;
    while (function_id < context->ir.function_count) {
        let function: BootstrapIrFunction =
            functions[function_id];
        if (!function.has_body) {
            if (!bootstrap_x86_64_codegen_literal(
                    context,
                    "    .extern "
                ) ||
                !bootstrap_x86_64_codegen_append_function_symbol(
                    context,
                    function_id
                ) ||
                !bootstrap_x86_64_codegen_literal(
                    context,
                    "\n"
                )) {
                return false;
            }
            emitted = true;
        }
        function_id += 1;
    }
    return !emitted ||
        bootstrap_x86_64_codegen_literal(context, "\n");
}

fn bootstrap_x86_64_codegen_emit_entry(
    context: *BootstrapX8664CodegenContext
) -> bool {
    if (context->ir.entry_function == bootstrap_ir_no_id()) {
        return true;
    }
    return bootstrap_x86_64_codegen_literal(
            context,
            "    .globl _start\n    .type _start, @function\n_start:\n    xorl %ebp, %ebp\n    andq $-16, %rsp\n    subq $16, %rsp\n    movl $0x1f80, (%rsp)\n    ldmxcsr (%rsp)\n    addq $16, %rsp\n    call "
        ) &&
        bootstrap_x86_64_codegen_append_function_symbol(
            context,
            context->ir.entry_function
        ) &&
        bootstrap_x86_64_codegen_literal(
            context,
            "\n    movl %eax, %edi\n    movl $60, %eax\n    syscall\n    .size _start, .-_start\n\n"
        );
}

fn bootstrap_x86_64_codegen_emit_function(
    context: *BootstrapX8664CodegenContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    let blocks: *const BootstrapIrBlock =
        context->ir.blocks.data as *const BootstrapIrBlock;
    let instructions: *const BootstrapIrInstruction =
        context->ir.instructions.data as
            *const BootstrapIrInstruction;
    let abi_functions: *const BootstrapX8664AbiFunction =
        context->abi.functions.data as
            *const BootstrapX8664AbiFunction;
    let frames: *const BootstrapX8664Frame =
        context->frames.frames.data as
            *const BootstrapX8664Frame;
    let function: BootstrapIrFunction =
        functions[function_id];
    if (!function.has_body) {
        return true;
    }
    context->current_function = function_id;
    if (function.linkage == BootstrapIrLinkage.module_export &&
        (!bootstrap_x86_64_codegen_literal(
            context,
            "    .globl "
        ) ||
        !bootstrap_x86_64_codegen_append_function_symbol(
            context,
            function_id
        ) ||
        !bootstrap_x86_64_codegen_literal(context, "\n"))) {
        return false;
    }
    if (!bootstrap_x86_64_codegen_literal(
            context,
            "    .p2align 4\n    .type "
        ) ||
        !bootstrap_x86_64_codegen_append_function_symbol(
            context,
            function_id
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", @function\n"
        ) ||
        !bootstrap_x86_64_codegen_append_function_symbol(
            context,
            function_id
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ":\n    pushq %rbp\n    movq %rsp, %rbp\n"
        )) {
        return false;
    }
    if (frames[function_id].frame_size_bytes != 0 &&
        (!bootstrap_x86_64_codegen_literal(
            context,
            "    subq $"
        ) ||
        !bootstrap_x86_64_codegen_usize(
            context,
            frames[function_id].frame_size_bytes
        ) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            ", %rsp\n"
        ))) {
        return false;
    }
    if (!bootstrap_x86_64_codegen_emit_parameters(
            context,
            function,
            abi_functions[function_id]
        )) {
        return false;
    }
    var block_index: usize = 0;
    while (block_index < function.block_count) {
        let block_id: usize =
            function.first_block + block_index;
        let block: BootstrapIrBlock = blocks[block_id];
        if (!bootstrap_x86_64_codegen_block_label(
                context,
                block_id
            ) ||
            !bootstrap_x86_64_codegen_literal(context, ":\n")) {
            return false;
        }
        var instruction_id: usize =
            block.first_instruction;
        var instruction_index: usize = 0;
        while (instruction_index < block.instruction_count) {
            if (instruction_id >= context->ir.instruction_count ||
                !bootstrap_x86_64_codegen_emit_instruction(
                    context,
                    instructions[instruction_id],
                    instruction_id
                )) {
                return bootstrap_x86_64_codegen_fail(
                    context,
                    RuntimeError.invalid_argument
                );
            }
            instruction_id =
                instructions[instruction_id].next_instruction;
            instruction_index += 1;
        }
        block_index += 1;
    }
    return bootstrap_x86_64_codegen_return_label(context) &&
        bootstrap_x86_64_codegen_literal(
            context,
            ":\n    leave\n    ret\n    .size "
        ) &&
        bootstrap_x86_64_codegen_append_function_symbol(
            context,
            function_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, ", .-") &&
        bootstrap_x86_64_codegen_append_function_symbol(
            context,
            function_id
        ) &&
        bootstrap_x86_64_codegen_literal(context, "\n\n");
}

fn bootstrap_x86_64_codegen_emit_module(
    context: *BootstrapX8664CodegenContext
) -> bool {
    if (!bootstrap_x86_64_codegen_emit_globals(context) ||
        !bootstrap_x86_64_codegen_emit_declarations(context) ||
        !bootstrap_x86_64_codegen_literal(
            context,
            "    .text\n"
        ) ||
        !bootstrap_x86_64_codegen_emit_entry(context)) {
        return false;
    }
    var function_id: usize = 0;
    while (function_id < context->ir.function_count) {
        if (!bootstrap_x86_64_codegen_emit_function(
                context,
                function_id
            )) {
            return false;
        }
        function_id += 1;
    }
    return bootstrap_x86_64_codegen_literal(
        context,
        "    .section .note.GNU-stack,\"\",@progbits\n"
    );
}

fn bootstrap_x86_64_backend_is_success(
    result: BootstrapX8664BackendResult,
    semantic_input: BootstrapSemanticInput,
    ir: BootstrapTypedIr,
    types: BootstrapTypeTable
) -> bool {
    return result.error == RuntimeError.none &&
        result.assembly.length != 0 &&
        std_byte_buffer_is_valid(result.assembly) &&
        bootstrap_semantic_input_is_valid(semantic_input) &&
        bootstrap_ir_is_valid(ir, types) &&
        bootstrap_x86_64_abi_is_valid(
            result.abi,
            ir,
            types
        ) &&
        bootstrap_x86_64_frame_plan_is_valid(
            result.frames,
            ir,
            types,
            result.abi
        );
}

fn bootstrap_x86_64_emit_assembly(
    semantic_input: BootstrapSemanticInput,
    ir: BootstrapTypedIr,
    types: BootstrapTypeTable
) -> BootstrapX8664BackendResult {
    var result: BootstrapX8664BackendResult =
        bootstrap_x86_64_backend_empty();
    if (!bootstrap_semantic_input_is_valid(semantic_input) ||
        !bootstrap_ir_is_valid(ir, types)) {
        result.error = RuntimeError.invalid_argument;
        return result;
    }
    let abi_result: BootstrapX8664AbiResult =
        bootstrap_x86_64_abi_analyze(ir, types);
    if (abi_result.error != RuntimeError.none) {
        result.error = abi_result.error;
        return result;
    }
    result.abi = abi_result.abi;
    let frame_result: BootstrapX8664FramePlanResult =
        bootstrap_x86_64_frame_plan_build(
            ir,
            types,
            result.abi
        );
    if (frame_result.error != RuntimeError.none) {
        bootstrap_x86_64_abi_release(result.abi);
        result.abi = bootstrap_x86_64_abi_empty();
        result.error = frame_result.error;
        return result;
    }
    result.frames = frame_result.plan;
    var context: BootstrapX8664CodegenContext = {
        semantic_input = semantic_input,
        ir = ir,
        types = types,
        abi = result.abi,
        frames = result.frames,
        text = bootstrap_x86_64_text_empty(),
        current_function = bootstrap_x86_64_codegen_no_id(),
        error = RuntimeError.none,
    };
    if (!bootstrap_x86_64_codegen_emit_module(&context)) {
        let error: RuntimeError =
            context.error == RuntimeError.none ?
                RuntimeError.invalid_argument : context.error;
        bootstrap_x86_64_text_release(context.text);
        bootstrap_x86_64_frame_plan_release(result.frames);
        bootstrap_x86_64_abi_release(result.abi);
        result = bootstrap_x86_64_backend_empty();
        result.error = error;
        return result;
    }
    let assembly: StdByteBufferResult =
        bootstrap_x86_64_text_take(&context.text);
    if (assembly.error != RuntimeError.none) {
        bootstrap_x86_64_text_release(context.text);
        bootstrap_x86_64_frame_plan_release(result.frames);
        bootstrap_x86_64_abi_release(result.abi);
        result = bootstrap_x86_64_backend_empty();
        result.error = assembly.error;
        return result;
    }
    result.assembly = assembly.buffer;
    return result;
}

fn bootstrap_x86_64_backend_release(
    result: BootstrapX8664BackendResult
) -> RuntimeError {
    if (!std_byte_buffer_is_valid(result.assembly) ||
        !bootstrap_x86_64_abi_storage_is_valid(result.abi) ||
        !bootstrap_x86_64_frame_plan_storage_is_valid(
            result.frames
        )) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError =
        std_byte_buffer_release(result.assembly);
    let frame_error: RuntimeError =
        bootstrap_x86_64_frame_plan_release(result.frames);
    if (error == RuntimeError.none) {
        error = frame_error;
    }
    let abi_error: RuntimeError =
        bootstrap_x86_64_abi_release(result.abi);
    if (error == RuntimeError.none) {
        error = abi_error;
    }
    return error;
}
