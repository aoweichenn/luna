module luna.bootstrap.backend.x86_64.text;

fn bootstrap_x86_64_text_empty() -> BootstrapX8664Text {
    return {
        buffer = std_byte_buffer_empty(),
        error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_text_is_valid(
    text: BootstrapX8664Text
) -> bool {
    return std_byte_buffer_is_valid(text.buffer);
}

fn bootstrap_x86_64_text_append(
    text: *BootstrapX8664Text,
    data: *const u8,
    length: usize
) -> bool {
    if (text == null || text->error != RuntimeError.none ||
        !bootstrap_x86_64_text_is_valid(*text) ||
        (length != 0 && data == null)) {
        if (text != null && text->error == RuntimeError.none) {
            text->error = RuntimeError.invalid_argument;
        }
        return false;
    }
    if (length == 0) {
        return true;
    }
    let appended: StdByteBufferResult =
        std_byte_buffer_append(
            text->buffer,
            data,
            length
        );
    text->buffer = appended.buffer;
    text->error = appended.error;
    return appended.error == RuntimeError.none;
}

fn bootstrap_x86_64_text_append_c_string(
    text: *BootstrapX8664Text,
    data: *const u8,
    maximum_length: usize
) -> bool {
    if (text == null || data == null || maximum_length == 0) {
        if (text != null && text->error == RuntimeError.none) {
            text->error = RuntimeError.invalid_argument;
        }
        return false;
    }
    let view: StdTextViewResult =
        std_text_from_c_string(data, maximum_length);
    if (view.error != RuntimeError.none) {
        text->error = view.error;
        return false;
    }
    return bootstrap_x86_64_text_append(
        text,
        view.view.data,
        view.view.length
    );
}

fn bootstrap_x86_64_text_push(
    text: *BootstrapX8664Text,
    byte: u8
) -> bool {
    if (text == null || text->error != RuntimeError.none) {
        return false;
    }
    let appended: StdByteBufferResult =
        std_byte_buffer_push(text->buffer, byte);
    text->buffer = appended.buffer;
    text->error = appended.error;
    return appended.error == RuntimeError.none;
}

fn bootstrap_x86_64_text_append_u64(
    text: *BootstrapX8664Text,
    value: u64
) -> bool {
    var digits: [20]u8 = {};
    var remaining: u64 = value;
    var count: usize = 0;
    do {
        digits[count] =
            48 + (remaining % 10) as u8;
        remaining /= 10;
        count += 1;
    } while (remaining != 0);
    while (count != 0) {
        count -= 1;
        if (!bootstrap_x86_64_text_push(
                text,
                digits[count]
            )) {
            return false;
        }
    }
    return true;
}

fn bootstrap_x86_64_text_append_usize(
    text: *BootstrapX8664Text,
    value: usize
) -> bool {
    return bootstrap_x86_64_text_append_u64(
        text,
        value as u64
    );
}

fn bootstrap_x86_64_text_hex_digit(value: u8) -> u8 {
    return value < 10 ? 48 + value : 87 + value;
}

fn bootstrap_x86_64_text_append_hex(
    text: *BootstrapX8664Text,
    value: u64,
    digit_count: usize
) -> bool {
    if (digit_count == 0 || digit_count > 16) {
        if (text != null && text->error == RuntimeError.none) {
            text->error = RuntimeError.invalid_argument;
        }
        return false;
    }
    var index: usize = digit_count;
    while (index != 0) {
        index -= 1;
        let shift: u64 = (index * 4) as u64;
        if (!bootstrap_x86_64_text_push(
                text,
                bootstrap_x86_64_text_hex_digit(
                    ((value >> shift) & 15) as u8
                )
            )) {
            return false;
        }
    }
    return true;
}

fn bootstrap_x86_64_text_append_hex_bytes(
    text: *BootstrapX8664Text,
    data: *const u8,
    length: usize
) -> bool {
    if (length != 0 && data == null) {
        if (text != null && text->error == RuntimeError.none) {
            text->error = RuntimeError.invalid_argument;
        }
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (!bootstrap_x86_64_text_append_hex(
                text,
                data[index] as u64,
                2
            )) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_x86_64_text_take(
    text: *BootstrapX8664Text
) -> StdByteBufferResult {
    if (text == null ||
        !bootstrap_x86_64_text_is_valid(*text) ||
        text->error != RuntimeError.none) {
        return {
            buffer = std_byte_buffer_empty(),
            error = RuntimeError.invalid_argument,
        };
    }
    let result: StdByteBuffer = text->buffer;
    text->buffer = std_byte_buffer_empty();
    return {
        buffer = result,
        error = RuntimeError.none,
    };
}

fn bootstrap_x86_64_text_release(
    text: BootstrapX8664Text
) -> RuntimeError {
    if (!bootstrap_x86_64_text_is_valid(text)) {
        return RuntimeError.invalid_argument;
    }
    return std_byte_buffer_release(text.buffer);
}
