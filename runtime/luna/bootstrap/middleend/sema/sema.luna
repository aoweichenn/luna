module luna.bootstrap.middleend.sema;

enum BootstrapSemanticLimit: usize {
    maximum_size = 18446744073709551615,
    maximum_modules = 1024,
    maximum_module_depth = 256,
    maximum_diagnostics = 4096,
    maximum_scope_depth = 256,
    maximum_type_depth = 256,
    target_maximum_alignment = 8,
    target_maximum_object_size = 2147483647,
    maximum_floating_digits = 1200,
    maximum_floating_limbs = 128,
    floating_exponent_margin = 2048,
}

enum BootstrapSemanticSymbolKind: usize {
    named_type,
    function,
    enum_member,
}

enum BootstrapSemanticSymbolFlag: usize {
    none = 0,
    exported = 1,
    external = 2,
    interface_declaration = 4,
}

enum BootstrapSemanticLiteralFamily: usize {
    none,
    integer,
    floating,
    null_pointer,
}

struct BootstrapSemanticModule {
    interface_unit: usize;
    implementation_unit: usize;
    name_unit: usize;
    name_node: usize;
    first_import: usize;
    import_count: usize;
    visit_state: usize;
    reachable: bool;
}

struct BootstrapSemanticUnitInfo {
    module_id: usize;
    interface_unit: usize;
}

struct BootstrapSemanticImport {
    owner_module: usize;
    source_unit: usize;
    declaration_node: usize;
    target_module: usize;
    interface_import: bool;
}

struct BootstrapSemanticSymbol {
    kind: BootstrapSemanticSymbolKind;
    module_id: usize;
    declaration_unit: usize;
    declaration_node: usize;
    name_token: usize;
    type_id: usize;
    function_id: usize;
    integer_value: u64;
    flags: usize;
}

struct BootstrapSemanticFunction {
    symbol_id: usize;
    interface_unit: usize;
    interface_node: usize;
    implementation_unit: usize;
    implementation_node: usize;
    return_type: usize;
    first_parameter: usize;
    parameter_count: usize;
    ir_function: usize;
    flags: usize;
}

struct BootstrapSemanticParameter {
    function_id: usize;
    type_id: usize;
    unit_index: usize;
    declaration_node: usize;
    name_token: usize;
}

struct BootstrapSemanticLocal {
    function_id: usize;
    type_id: usize;
    slot_id: usize;
    unit_index: usize;
    declaration_node: usize;
    name_token: usize;
    scope_depth: usize;
    mutable_binding: bool;
}

struct BootstrapSemanticExpression {
    type_id: usize;
    value_id: usize;
    address_id: usize;
    constant_value: u64;
    has_constant: bool;
    lvalue: bool;
    mutable_lvalue: bool;
    valid: bool;
}

struct BootstrapSemanticBigUnsigned {
    limbs: [128]u64;
    count: usize;
}

struct BootstrapSemanticSignedMagnitude {
    magnitude: usize;
    negative: bool;
}

struct BootstrapSemanticDecimalFloating {
    coefficient: BootstrapSemanticBigUnsigned;
    five_power: BootstrapSemanticBigUnsigned;
    decimal_exponent: isize;
    truncated_nonzero: bool;
}

struct BootstrapSemanticContext {
    input: BootstrapSemanticInput;
    units: StdByteBuffer;
    unit_count: usize;
    modules: StdByteBuffer;
    module_count: usize;
    imports: StdByteBuffer;
    import_count: usize;
    symbols: StdByteBuffer;
    symbol_count: usize;
    functions: StdByteBuffer;
    function_count: usize;
    parameters: StdByteBuffer;
    parameter_count: usize;
    locals: StdByteBuffer;
    local_count: usize;
    types: BootstrapTypeTable;
    ir: BootstrapTypedIr;
    diagnostics: BootstrapSemanticDiagnosticBuffer;
    error: RuntimeError;
    current_function: usize;
    current_unit: usize;
    current_block: usize;
    scope_depth: usize;
    type_depth: usize;
    break_block: usize;
    continue_block: usize;
}

fn bootstrap_semantic_no_id() -> usize {
    return BootstrapSemanticLimit.maximum_size as usize;
}

fn bootstrap_semantic_empty_span() -> BootstrapSourceSpan {
    return {
        offset = 0,
        length = 0,
        line = 0,
        column = 0,
    };
}

fn bootstrap_semantic_invalid_diagnostic()
    -> BootstrapSemanticDiagnostic {
    let none: usize = bootstrap_semantic_no_id();
    return {
        kind = BootstrapSemanticDiagnosticKind.invalid_input,
        unit_index = none,
        span = bootstrap_semantic_empty_span(),
        related_unit = none,
        related_span = bootstrap_semantic_empty_span(),
        detail = 0,
    };
}

fn bootstrap_semantic_input_empty(
    executable: bool
) -> BootstrapSemanticInput {
    return {
        units = std_byte_buffer_empty(),
        unit_count = 0,
        executable = executable,
    };
}

fn bootstrap_semantic_input_storage_is_valid(
    input: BootstrapSemanticInput
) -> bool {
    return std_byte_buffer_is_valid(input.units) &&
        input.units.length % sizeof(BootstrapSemanticUnit) == 0 &&
        input.unit_count <=
            BootstrapSemanticLimit.maximum_modules as usize * 2 &&
        input.unit_count ==
            input.units.length / sizeof(BootstrapSemanticUnit);
}

fn bootstrap_semantic_source_is_valid(
    source: StdTextView
) -> bool {
    if (!std_text_is_valid_utf8(source)) {
        return false;
    }
    var index: usize = 0;
    while (index < source.length) {
        if (source.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_unit_is_valid(
    unit: BootstrapSemanticUnit
) -> bool {
    return bootstrap_semantic_source_is_valid(unit.source) &&
        bootstrap_token_buffer_is_valid(unit.tokens) &&
        bootstrap_syntax_tree_is_valid(unit.tree) &&
        unit.tokens.count == unit.tree.token_count;
}

fn bootstrap_semantic_input_is_valid(
    input: BootstrapSemanticInput
) -> bool {
    if (!bootstrap_semantic_input_storage_is_valid(input) ||
        input.unit_count == 0 ||
        input.unit_count >
            BootstrapSemanticLimit.maximum_modules as usize * 2) {
        return false;
    }
    let units: *const BootstrapSemanticUnit =
        input.units.data as *const BootstrapSemanticUnit;
    var index: usize = 0;
    while (index < input.unit_count) {
        if (!bootstrap_semantic_unit_is_valid(units[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_input_add(
    input: *BootstrapSemanticInput,
    unit: BootstrapSemanticUnit
) -> bool {
    if (input == null ||
        !bootstrap_semantic_input_storage_is_valid(*input) ||
        !bootstrap_semantic_unit_is_valid(unit) ||
        input->unit_count >=
            BootstrapSemanticLimit.maximum_modules as usize * 2) {
        return false;
    }
    let appended: StdByteBufferResult = std_byte_buffer_append(
        input->units,
        (&unit) as *const BootstrapSemanticUnit as *const u8,
        sizeof(BootstrapSemanticUnit)
    );
    input->units = appended.buffer;
    if (appended.error != RuntimeError.none) {
        return false;
    }
    input->unit_count += 1;
    return true;
}

fn bootstrap_semantic_input_release(
    input: BootstrapSemanticInput
) -> RuntimeError {
    if (!bootstrap_semantic_input_storage_is_valid(input)) {
        return RuntimeError.invalid_argument;
    }
    return std_byte_buffer_release(input.units);
}

fn bootstrap_semantic_diagnostics_empty()
    -> BootstrapSemanticDiagnosticBuffer {
    return {
        storage = std_byte_buffer_empty(),
        count = 0,
    };
}

fn bootstrap_semantic_diagnostics_storage_is_valid(
    diagnostics: BootstrapSemanticDiagnosticBuffer
) -> bool {
    return std_byte_buffer_is_valid(diagnostics.storage) &&
        diagnostics.storage.length %
            sizeof(BootstrapSemanticDiagnostic) == 0 &&
        diagnostics.count <=
            BootstrapSemanticLimit.maximum_diagnostics as usize &&
        diagnostics.count ==
            diagnostics.storage.length /
                sizeof(BootstrapSemanticDiagnostic);
}

fn bootstrap_semantic_diagnostic_get(
    diagnostics: BootstrapSemanticDiagnosticBuffer,
    index: usize
) -> BootstrapSemanticDiagnosticResult {
    if (!bootstrap_semantic_diagnostics_storage_is_valid(
            diagnostics
        ) || index >= diagnostics.count) {
        return {
            diagnostic = bootstrap_semantic_invalid_diagnostic(),
            error = RuntimeError.invalid_argument,
        };
    }
    let records: *const BootstrapSemanticDiagnostic =
        diagnostics.storage.data as
            *const BootstrapSemanticDiagnostic;
    return {
        diagnostic = records[index],
        error = RuntimeError.none,
    };
}

fn bootstrap_semantic_add_diagnostic(
    context: *BootstrapSemanticContext,
    kind: BootstrapSemanticDiagnosticKind,
    unit_index: usize,
    span: BootstrapSourceSpan,
    related_unit: usize,
    related_span: BootstrapSourceSpan,
    detail: usize
) -> bool {
    if (context->error != RuntimeError.none) {
        return false;
    }
    if (context->diagnostics.count >=
        BootstrapSemanticLimit.maximum_diagnostics as usize) {
        context->error = RuntimeError.out_of_memory;
        return false;
    }
    let diagnostic: BootstrapSemanticDiagnostic = {
        kind = kind,
        unit_index = unit_index,
        span = span,
        related_unit = related_unit,
        related_span = related_span,
        detail = detail,
    };
    let appended: StdByteBufferResult = std_byte_buffer_append(
        context->diagnostics.storage,
        (&diagnostic) as
            *const BootstrapSemanticDiagnostic as *const u8,
        sizeof(BootstrapSemanticDiagnostic)
    );
    context->diagnostics.storage = appended.buffer;
    context->error = appended.error;
    if (appended.error == RuntimeError.none) {
        context->diagnostics.count += 1;
        return true;
    }
    return false;
}

fn bootstrap_semantic_result_is_success(
    result: BootstrapSemanticResult
) -> bool {
    return result.error == RuntimeError.none &&
        result.diagnostics.count == 0 &&
        bootstrap_type_table_is_valid(result.types, true) &&
        bootstrap_ir_is_valid(result.ir, result.types);
}

fn bootstrap_semantic_release_error(
    current: RuntimeError,
    next: RuntimeError
) -> RuntimeError {
    return current == RuntimeError.none ? next : current;
}

fn bootstrap_semantic_result_release(
    result: BootstrapSemanticResult
) -> RuntimeError {
    if (!bootstrap_semantic_diagnostics_storage_is_valid(
            result.diagnostics
        ) ||
        !bootstrap_type_table_storage_is_valid(result.types) ||
        !bootstrap_ir_storage_is_valid(result.ir)) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError =
        bootstrap_type_table_release(result.types);
    error = bootstrap_semantic_release_error(
        error,
        bootstrap_ir_release(result.ir)
    );
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(result.diagnostics.storage)
    );
    return error;
}

fn bootstrap_semantic_context_storage_is_valid(
    context: *BootstrapSemanticContext
) -> bool {
    return context != null &&
        std_byte_buffer_is_valid(context->units) &&
        context->units.length %
            sizeof(BootstrapSemanticUnitInfo) == 0 &&
        context->unit_count ==
            context->units.length /
                sizeof(BootstrapSemanticUnitInfo) &&
        std_byte_buffer_is_valid(context->modules) &&
        context->modules.length %
            sizeof(BootstrapSemanticModule) == 0 &&
        context->module_count ==
            context->modules.length /
                sizeof(BootstrapSemanticModule) &&
        std_byte_buffer_is_valid(context->imports) &&
        context->imports.length %
            sizeof(BootstrapSemanticImport) == 0 &&
        context->import_count ==
            context->imports.length /
                sizeof(BootstrapSemanticImport) &&
        std_byte_buffer_is_valid(context->symbols) &&
        context->symbols.length %
            sizeof(BootstrapSemanticSymbol) == 0 &&
        context->symbol_count ==
            context->symbols.length /
                sizeof(BootstrapSemanticSymbol) &&
        std_byte_buffer_is_valid(context->functions) &&
        context->functions.length %
            sizeof(BootstrapSemanticFunction) == 0 &&
        context->function_count ==
            context->functions.length /
                sizeof(BootstrapSemanticFunction) &&
        std_byte_buffer_is_valid(context->parameters) &&
        context->parameters.length %
            sizeof(BootstrapSemanticParameter) == 0 &&
        context->parameter_count ==
            context->parameters.length /
                sizeof(BootstrapSemanticParameter) &&
        std_byte_buffer_is_valid(context->locals) &&
        context->locals.length %
            sizeof(BootstrapSemanticLocal) == 0 &&
        context->local_count ==
            context->locals.length /
                sizeof(BootstrapSemanticLocal) &&
        context->scope_depth <=
            BootstrapSemanticLimit.maximum_scope_depth as usize &&
        context->type_depth <=
            BootstrapSemanticLimit.maximum_type_depth as usize &&
        bootstrap_semantic_diagnostics_storage_is_valid(
            context->diagnostics
        ) &&
        bootstrap_type_table_storage_is_valid(context->types) &&
        bootstrap_ir_storage_is_valid(context->ir);
}

fn bootstrap_semantic_context_init(
    input: BootstrapSemanticInput
) -> BootstrapSemanticContext {
    return {
        input = input,
        units = std_byte_buffer_empty(),
        unit_count = 0,
        modules = std_byte_buffer_empty(),
        module_count = 0,
        imports = std_byte_buffer_empty(),
        import_count = 0,
        symbols = std_byte_buffer_empty(),
        symbol_count = 0,
        functions = std_byte_buffer_empty(),
        function_count = 0,
        parameters = std_byte_buffer_empty(),
        parameter_count = 0,
        locals = std_byte_buffer_empty(),
        local_count = 0,
        types = bootstrap_type_table_empty(),
        ir = bootstrap_ir_empty(),
        diagnostics = bootstrap_semantic_diagnostics_empty(),
        error = RuntimeError.none,
        current_function = bootstrap_semantic_no_id(),
        current_unit = bootstrap_semantic_no_id(),
        current_block = bootstrap_semantic_no_id(),
        scope_depth = 0,
        type_depth = 0,
        break_block = bootstrap_semantic_no_id(),
        continue_block = bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_context_release_work(
    context: *BootstrapSemanticContext
) -> RuntimeError {
    if (!bootstrap_semantic_context_storage_is_valid(context)) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError =
        std_byte_buffer_release(context->units);
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(context->modules)
    );
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(context->imports)
    );
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(context->symbols)
    );
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(context->functions)
    );
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(context->parameters)
    );
    error = bootstrap_semantic_release_error(
        error,
        std_byte_buffer_release(context->locals)
    );
    return error;
}

fn bootstrap_semantic_input_unit(
    context: *BootstrapSemanticContext,
    unit_index: usize
) -> *const BootstrapSemanticUnit {
    if (context == null ||
        unit_index >= context->input.unit_count) {
        return null;
    }
    let units: *const BootstrapSemanticUnit =
        context->input.units.data as
            *const BootstrapSemanticUnit;
    return &units[unit_index];
}

fn bootstrap_semantic_node(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> BootstrapSyntaxNode {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    if (unit == null) {
        return {
            kind = BootstrapSyntaxKind.invalid,
            span = bootstrap_semantic_empty_span(),
            token_index = bootstrap_semantic_no_id(),
            parent = bootstrap_semantic_no_id(),
            first_child = bootstrap_semantic_no_id(),
            last_child = bootstrap_semantic_no_id(),
            next_sibling = bootstrap_semantic_no_id(),
            child_count = 0,
            flags = 0,
        };
    }
    let result: BootstrapSyntaxNodeResult =
        bootstrap_syntax_tree_get(unit->tree, node_index);
    if (result.error != RuntimeError.none) {
        context->error = result.error;
    }
    return result.node;
}

fn bootstrap_semantic_token(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize
) -> BootstrapToken {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    if (unit == null) {
        return {
            kind = BootstrapTokenKind.invalid,
            span = bootstrap_semantic_empty_span(),
        };
    }
    let result: BootstrapTokenResult =
        bootstrap_token_buffer_get(unit->tokens, token_index);
    if (result.error != RuntimeError.none) {
        context->error = result.error;
    }
    return result.token;
}

fn bootstrap_semantic_text_equal(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_span: BootstrapSourceSpan,
    right_unit: usize,
    right_span: BootstrapSourceSpan
) -> bool {
    if (left_span.length != right_span.length) {
        return false;
    }
    let left: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, left_unit);
    let right: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, right_unit);
    if (left == null || right == null ||
        left_span.offset > left->source.length ||
        left_span.length >
            left->source.length - left_span.offset ||
        right_span.offset > right->source.length ||
        right_span.length >
            right->source.length - right_span.offset) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    var index: usize = 0;
    while (index < left_span.length) {
        if (left->source.data[left_span.offset + index] !=
            right->source.data[right_span.offset + index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_tokens_equal(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_token: usize,
    right_unit: usize,
    right_token: usize
) -> bool {
    return bootstrap_semantic_text_equal(
        context,
        left_unit,
        bootstrap_semantic_token(
            context,
            left_unit,
            left_token
        ).span,
        right_unit,
        bootstrap_semantic_token(
            context,
            right_unit,
            right_token
        ).span
    );
}

fn bootstrap_semantic_module_names_equal(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_node: usize,
    right_unit: usize,
    right_node: usize
) -> bool {
    let left: BootstrapSyntaxNode =
        bootstrap_semantic_node(context, left_unit, left_node);
    let right: BootstrapSyntaxNode =
        bootstrap_semantic_node(context, right_unit, right_node);
    if (left.child_count != right.child_count ||
        left.child_count == 0) {
        return false;
    }
    var left_child: usize = left.first_child;
    var right_child: usize = right.first_child;
    var index: usize = 0;
    while (index < left.child_count) {
        let left_name: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                left_unit,
                left_child
            );
        let right_name: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                right_unit,
                right_child
            );
        if (!bootstrap_semantic_tokens_equal(
                context,
                left_unit,
                left_name.token_index,
                right_unit,
                right_name.token_index
            )) {
            return false;
        }
        left_child = left_name.next_sibling;
        right_child = right_name.next_sibling;
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_append_record(
    context: *BootstrapSemanticContext,
    destination: *StdByteBuffer,
    data: *const u8,
    length: usize
) -> bool {
    if (context->error != RuntimeError.none ||
        destination == null || data == null || length == 0) {
        return false;
    }
    let appended: StdByteBufferResult =
        std_byte_buffer_append(*destination, data, length);
    *destination = appended.buffer;
    context->error = appended.error;
    return appended.error == RuntimeError.none;
}

fn bootstrap_semantic_append_unit_info(
    context: *BootstrapSemanticContext,
    info: BootstrapSemanticUnitInfo
) -> bool {
    if (!bootstrap_semantic_append_record(
            context,
            &context->units,
            (&info) as
                *const BootstrapSemanticUnitInfo as *const u8,
            sizeof(BootstrapSemanticUnitInfo)
        )) {
        return false;
    }
    context->unit_count += 1;
    return true;
}

fn bootstrap_semantic_append_module(
    context: *BootstrapSemanticContext,
    module_record: BootstrapSemanticModule
) -> usize {
    let result: usize = context->module_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->modules,
            (&module_record) as
                *const BootstrapSemanticModule as *const u8,
            sizeof(BootstrapSemanticModule)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->module_count += 1;
    return result;
}

fn bootstrap_semantic_find_module_by_name(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_node: usize
) -> usize {
    let modules: *const BootstrapSemanticModule =
        context->modules.data as
            *const BootstrapSemanticModule;
    var index: usize = 0;
    while (index < context->module_count) {
        if (bootstrap_semantic_module_names_equal(
                context,
                unit_index,
                name_node,
                modules[index].name_unit,
                modules[index].name_node
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_program_module_node(
    context: *BootstrapSemanticContext,
    unit_index: usize
) -> usize {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    let root: BootstrapSyntaxNode = bootstrap_semantic_node(
        context,
        unit_index,
        unit->tree.root
    );
    if (root.kind != BootstrapSyntaxKind.program ||
        root.child_count == 0) {
        context->error = RuntimeError.invalid_argument;
        return bootstrap_semantic_no_id();
    }
    let module_declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            unit_index,
            root.first_child
        );
    if (module_declaration.kind !=
        BootstrapSyntaxKind.module_declaration) {
        context->error = RuntimeError.invalid_argument;
        return bootstrap_semantic_no_id();
    }
    return root.first_child;
}

fn bootstrap_semantic_collect_modules(
    context: *BootstrapSemanticContext
) -> bool {
    var unit_index: usize = 0;
    while (unit_index < context->input.unit_count &&
        context->error == RuntimeError.none) {
        let unit: *const BootstrapSemanticUnit =
            bootstrap_semantic_input_unit(context, unit_index);
        let root: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                unit->tree.root
            );
        let interface_unit: bool =
            (root.flags &
                (BootstrapSyntaxFlag.interface_unit as usize)) != 0;
        let name_node: usize =
            bootstrap_semantic_program_module_node(
                context,
                unit_index
            );
        var module_id: usize =
            bootstrap_semantic_find_module_by_name(
                context,
                unit_index,
                name_node
            );
        if (module_id == bootstrap_semantic_no_id()) {
            module_id = bootstrap_semantic_append_module(
                context,
                {
                    interface_unit = bootstrap_semantic_no_id(),
                    implementation_unit =
                        bootstrap_semantic_no_id(),
                    name_unit = unit_index,
                    name_node = name_node,
                    first_import = bootstrap_semantic_no_id(),
                    import_count = 0,
                    visit_state = 0,
                    reachable = false,
                }
            );
        }
        if (module_id == bootstrap_semantic_no_id()) {
            return false;
        }
        let modules: *BootstrapSemanticModule =
            context->modules.data as *BootstrapSemanticModule;
        let previous: usize = interface_unit ?
            modules[module_id].interface_unit :
            modules[module_id].implementation_unit;
        if (previous != bootstrap_semantic_no_id()) {
            let previous_node: usize =
                bootstrap_semantic_program_module_node(
                    context,
                    previous
                );
            bootstrap_semantic_add_diagnostic(
                context,
                interface_unit ?
                    BootstrapSemanticDiagnosticKind
                        .duplicate_interface :
                    BootstrapSemanticDiagnosticKind
                        .duplicate_implementation,
                unit_index,
                bootstrap_semantic_node(
                    context,
                    unit_index,
                    name_node
                ).span,
                previous,
                bootstrap_semantic_node(
                    context,
                    previous,
                    previous_node
                ).span,
                module_id
            );
        } else if (interface_unit) {
            modules[module_id].interface_unit = unit_index;
        } else {
            modules[module_id].implementation_unit = unit_index;
        }
        if (!bootstrap_semantic_append_unit_info(
                context,
                {
                    module_id = module_id,
                    interface_unit = interface_unit ? 1 : 0,
                }
            )) {
            return false;
        }
        unit_index += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_append_import(
    context: *BootstrapSemanticContext,
    record: BootstrapSemanticImport
) -> usize {
    let result: usize = context->import_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->imports,
            (&record) as
                *const BootstrapSemanticImport as *const u8,
            sizeof(BootstrapSemanticImport)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->import_count += 1;
    return result;
}

fn bootstrap_semantic_collect_unit_imports(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    interface_import: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return true;
    }
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    let root: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            unit_index,
            unit->tree.root
        );
    var child: usize = bootstrap_semantic_node(
        context,
        unit_index,
        root.first_child
    ).next_sibling;
    while (child != none) {
        let declaration: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        if (declaration.kind !=
            BootstrapSyntaxKind.import_declaration) {
            break;
        }
        let target: usize =
            bootstrap_semantic_find_module_by_name(
                context,
                unit_index,
                child
            );
        if (target == none) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.unknown_import,
                unit_index,
                declaration.span,
                none,
                bootstrap_semantic_empty_span(),
                0
            );
        } else if (target == module_id) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.self_import,
                unit_index,
                declaration.span,
                none,
                bootstrap_semantic_empty_span(),
                module_id
            );
        } else {
            let modules: *BootstrapSemanticModule =
                context->modules.data as
                    *BootstrapSemanticModule;
            let imports: *const BootstrapSemanticImport =
                context->imports.data as
                    *const BootstrapSemanticImport;
            var duplicate: usize = none;
            var index: usize = 0;
            while (index < modules[module_id].import_count) {
                let import_id: usize =
                    modules[module_id].first_import + index;
                if (imports[import_id].target_module == target) {
                    duplicate = import_id;
                    break;
                }
                index += 1;
            }
            if (duplicate != none) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .duplicate_import,
                    unit_index,
                    declaration.span,
                    imports[duplicate].source_unit,
                    bootstrap_semantic_node(
                        context,
                        imports[duplicate].source_unit,
                        imports[duplicate].declaration_node
                    ).span,
                    target
                );
            } else {
                let import_id: usize =
                    bootstrap_semantic_append_import(
                        context,
                        {
                            owner_module = module_id,
                            source_unit = unit_index,
                            declaration_node = child,
                            target_module = target,
                            interface_import = interface_import,
                        }
                    );
                if (import_id == none) {
                    return false;
                }
                let result_modules: *BootstrapSemanticModule =
                    context->modules.data as
                        *BootstrapSemanticModule;
                if (result_modules[module_id].import_count == 0) {
                    result_modules[module_id].first_import =
                        import_id;
                }
                result_modules[module_id].import_count += 1;
            }
        }
        child = declaration.next_sibling;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_collect_imports(
    context: *BootstrapSemanticContext
) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count &&
        context->error == RuntimeError.none) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as
                *const BootstrapSemanticModule;
        let interface_unit: usize =
            modules[module_id].interface_unit;
        let implementation_unit: usize =
            modules[module_id].implementation_unit;
        if (!bootstrap_semantic_collect_unit_imports(
                context,
                module_id,
                interface_unit,
                true
            ) ||
            !bootstrap_semantic_collect_unit_imports(
                context,
                module_id,
                implementation_unit,
                false
            )) {
            return false;
        }
        module_id += 1;
    }
    return true;
}

fn bootstrap_semantic_visit_imports(
    context: *BootstrapSemanticContext,
    module_id: usize,
    depth: usize
) -> bool {
    var modules: *BootstrapSemanticModule =
        context->modules.data as *BootstrapSemanticModule;
    if (modules[module_id].visit_state == 2) {
        return true;
    }
    if (modules[module_id].visit_state == 1) {
        return false;
    }
    if (depth >=
        BootstrapSemanticLimit.maximum_module_depth as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.resource_limit,
            modules[module_id].name_unit,
            bootstrap_semantic_node(
                context,
                modules[module_id].name_unit,
                modules[module_id].name_node
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            depth
        );
        return false;
    }
    modules[module_id].visit_state = 1;
    let first_import: usize = modules[module_id].first_import;
    let import_count: usize = modules[module_id].import_count;
    var index: usize = 0;
    while (index < import_count) {
        let imports: *const BootstrapSemanticImport =
            context->imports.data as
                *const BootstrapSemanticImport;
        let record: BootstrapSemanticImport =
            imports[first_import + index];
        let diagnostic_count: usize =
            context->diagnostics.count;
        if (!bootstrap_semantic_visit_imports(
                context,
                record.target_module,
                depth + 1
            )) {
            if (context->error != RuntimeError.none ||
                context->diagnostics.count != diagnostic_count) {
                return false;
            }
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.import_cycle,
                record.source_unit,
                bootstrap_semantic_node(
                    context,
                    record.source_unit,
                    record.declaration_node
                ).span,
                modules[record.target_module].name_unit,
                bootstrap_semantic_node(
                    context,
                    modules[record.target_module].name_unit,
                    modules[record.target_module].name_node
                ).span,
                record.target_module
            );
            return false;
        }
        index += 1;
    }
    modules = context->modules.data as
        *BootstrapSemanticModule;
    modules[module_id].visit_state = 2;
    return true;
}

fn bootstrap_semantic_validate_import_graph(
    context: *BootstrapSemanticContext
) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as
                *const BootstrapSemanticModule;
        if (modules[module_id].visit_state == 0) {
            bootstrap_semantic_visit_imports(
                context,
                module_id,
                0
            );
        }
        module_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_append_symbol(
    context: *BootstrapSemanticContext,
    symbol: BootstrapSemanticSymbol
) -> usize {
    let result: usize = context->symbol_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->symbols,
            (&symbol) as
                *const BootstrapSemanticSymbol as *const u8,
            sizeof(BootstrapSemanticSymbol)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->symbol_count += 1;
    return result;
}

fn bootstrap_semantic_find_local_symbol(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    name_token: usize,
    kind: BootstrapSemanticSymbolKind,
    interface_scope: bool
) -> usize {
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        let symbol: BootstrapSemanticSymbol = symbols[index];
        if (symbol.module_id == module_id &&
            symbol.kind == kind &&
            (!interface_scope ||
                (symbol.flags &
                    (BootstrapSemanticSymbolFlag
                        .interface_declaration as usize)) != 0) &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_find_any_local_symbol(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        let symbol: BootstrapSemanticSymbol = symbols[index];
        if (symbol.module_id == module_id &&
            symbol.kind !=
                BootstrapSemanticSymbolKind.enum_member &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_unit_module(
    context: *BootstrapSemanticContext,
    unit_index: usize
) -> usize {
    if (unit_index >= context->unit_count) {
        context->error = RuntimeError.invalid_argument;
        return bootstrap_semantic_no_id();
    }
    let units: *const BootstrapSemanticUnitInfo =
        context->units.data as
            *const BootstrapSemanticUnitInfo;
    return units[unit_index].module_id;
}

fn bootstrap_semantic_unit_is_interface(
    context: *BootstrapSemanticContext,
    unit_index: usize
) -> bool {
    if (unit_index >= context->unit_count) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let units: *const BootstrapSemanticUnitInfo =
        context->units.data as
            *const BootstrapSemanticUnitInfo;
    return units[unit_index].interface_unit != 0;
}

fn bootstrap_semantic_find_imported_symbol(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_token: usize,
    kind: BootstrapSemanticSymbolKind
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    let module_id: usize = bootstrap_semantic_unit_module(
        context,
        unit_index
    );
    let interface_scope: bool =
        bootstrap_semantic_unit_is_interface(
            context,
            unit_index
        );
    let modules: *const BootstrapSemanticModule =
        context->modules.data as
            *const BootstrapSemanticModule;
    let imports: *const BootstrapSemanticImport =
        context->imports.data as
            *const BootstrapSemanticImport;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var found: usize = none;
    var import_index: usize = 0;
    while (import_index < modules[module_id].import_count) {
        let import_record: BootstrapSemanticImport =
            imports[modules[module_id].first_import + import_index];
        if (!interface_scope ||
            import_record.interface_import) {
            var symbol_index: usize = 0;
            while (symbol_index < context->symbol_count) {
                let symbol: BootstrapSemanticSymbol =
                    symbols[symbol_index];
                if (symbol.module_id ==
                        import_record.target_module &&
                    symbol.kind == kind &&
                    (symbol.flags &
                        (BootstrapSemanticSymbolFlag
                            .exported as usize)) != 0 &&
                    bootstrap_semantic_tokens_equal(
                        context,
                        unit_index,
                        name_token,
                        symbol.declaration_unit,
                        symbol.name_token
                    )) {
                    if (found != none && found != symbol_index) {
                        bootstrap_semantic_add_diagnostic(
                            context,
                            BootstrapSemanticDiagnosticKind
                                .ambiguous_import,
                            unit_index,
                            bootstrap_semantic_token(
                                context,
                                unit_index,
                                name_token
                            ).span,
                            symbols[found].declaration_unit,
                            bootstrap_semantic_token(
                                context,
                                symbols[found].declaration_unit,
                                symbols[found].name_token
                            ).span,
                            symbol_index
                        );
                        return none;
                    }
                    found = symbol_index;
                }
                symbol_index += 1;
            }
        }
        import_index += 1;
    }
    return found;
}

fn bootstrap_semantic_lookup_symbol(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_token: usize,
    kind: BootstrapSemanticSymbolKind
) -> usize {
    let module_id: usize = bootstrap_semantic_unit_module(
        context,
        unit_index
    );
    let local: usize = bootstrap_semantic_find_local_symbol(
        context,
        module_id,
        unit_index,
        name_token,
        kind,
        bootstrap_semantic_unit_is_interface(
            context,
            unit_index
        )
    );
    if (local != bootstrap_semantic_no_id()) {
        return local;
    }
    return bootstrap_semantic_find_imported_symbol(
        context,
        unit_index,
        name_token,
        kind
    );
}

fn bootstrap_semantic_first_declaration(
    context: *BootstrapSemanticContext,
    unit_index: usize
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return none;
    }
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    let root: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            unit_index,
            unit->tree.root
        );
    var child: usize = root.first_child;
    while (child != none) {
        let node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        if (node.kind !=
                BootstrapSyntaxKind.module_declaration &&
            node.kind !=
                BootstrapSyntaxKind.import_declaration) {
            return child;
        }
        child = node.next_sibling;
    }
    return none;
}

fn bootstrap_semantic_declaration_type_kind(
    kind: BootstrapSyntaxKind
) -> BootstrapTypeKind {
    if (kind == BootstrapSyntaxKind.structure_declaration) {
        return BootstrapTypeKind.structure;
    }
    if (kind == BootstrapSyntaxKind.union_declaration) {
        return BootstrapTypeKind.record_union;
    }
    if (kind == BootstrapSyntaxKind.enum_declaration) {
        return BootstrapTypeKind.enumeration;
    }
    return BootstrapTypeKind.invalid;
}

fn bootstrap_semantic_collect_types_in_unit(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return true;
    }
    let interface_unit: bool =
        bootstrap_semantic_unit_is_interface(
            context,
            unit_index
        );
    var declaration_id: usize =
        bootstrap_semantic_first_declaration(
            context,
            unit_index
        );
    while (declaration_id != none &&
        context->error == RuntimeError.none) {
        let declaration: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                declaration_id
            );
        let type_kind: BootstrapTypeKind =
            bootstrap_semantic_declaration_type_kind(
                declaration.kind
            );
        if (type_kind != BootstrapTypeKind.invalid) {
            let exported: bool =
                (declaration.flags &
                    (BootstrapSyntaxFlag.exported as usize)) != 0;
            if (!interface_unit && exported) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .invalid_export,
                    unit_index,
                    declaration.span,
                    none,
                    bootstrap_semantic_empty_span(),
                    0
                );
            }
            let duplicate: usize =
                bootstrap_semantic_find_any_local_symbol(
                    context,
                    module_id,
                    unit_index,
                    declaration.token_index
                );
            if (duplicate != none) {
                let symbols: *const BootstrapSemanticSymbol =
                    context->symbols.data as
                        *const BootstrapSemanticSymbol;
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .duplicate_name,
                    unit_index,
                    bootstrap_semantic_token(
                        context,
                        unit_index,
                        declaration.token_index
                    ).span,
                    symbols[duplicate].declaration_unit,
                    bootstrap_semantic_token(
                        context,
                        symbols[duplicate].declaration_unit,
                        symbols[duplicate].name_token
                    ).span,
                    duplicate
                );
            } else {
                let type_id: usize =
                    context->types.type_count;
                let added: BootstrapTypeTableResult =
                    bootstrap_type_table_add_named(
                        context->types,
                        type_kind,
                        unit_index,
                        declaration_id,
                        declaration.token_index,
                        exported
                    );
                context->types = added.table;
                context->error = added.error;
                if (added.error == RuntimeError.none) {
                    var flags: usize =
                        BootstrapSemanticSymbolFlag.none as usize;
                    if (exported) {
                        flags |= BootstrapSemanticSymbolFlag
                            .exported as usize;
                    }
                    if (interface_unit) {
                        flags |= BootstrapSemanticSymbolFlag
                            .interface_declaration as usize;
                    }
                    bootstrap_semantic_append_symbol(
                        context,
                        {
                            kind = BootstrapSemanticSymbolKind
                                .named_type,
                            module_id = module_id,
                            declaration_unit = unit_index,
                            declaration_node = declaration_id,
                            name_token = declaration.token_index,
                            type_id = type_id,
                            function_id = none,
                            integer_value = 0,
                            flags = flags,
                        }
                    );
                }
            }
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_collect_named_types(
    context: *BootstrapSemanticContext
) -> bool {
    let created: BootstrapTypeTableResult =
        bootstrap_type_table_create();
    context->types = created.table;
    context->error = created.error;
    var module_id: usize = 0;
    while (module_id < context->module_count &&
        context->error == RuntimeError.none) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as
                *const BootstrapSemanticModule;
        if (!bootstrap_semantic_collect_types_in_unit(
                context,
                module_id,
                modules[module_id].interface_unit
            ) ||
            !bootstrap_semantic_collect_types_in_unit(
                context,
                module_id,
                modules[module_id].implementation_unit
            )) {
            return false;
        }
        module_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_builtin_type(
    kind: BootstrapTokenKind
) -> usize {
    if (kind == BootstrapTokenKind.keyword_void) {
        return BootstrapBuiltinType.type_void as usize;
    }
    if (kind == BootstrapTokenKind.keyword_bool) {
        return BootstrapBuiltinType.boolean as usize;
    }
    if (kind == BootstrapTokenKind.keyword_i8) {
        return BootstrapBuiltinType.signed_8 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_i16) {
        return BootstrapBuiltinType.signed_16 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_i32) {
        return BootstrapBuiltinType.signed_32 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_i64) {
        return BootstrapBuiltinType.signed_64 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_isize) {
        return BootstrapBuiltinType.signed_size as usize;
    }
    if (kind == BootstrapTokenKind.keyword_u8) {
        return BootstrapBuiltinType.unsigned_8 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_u16) {
        return BootstrapBuiltinType.unsigned_16 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_u32) {
        return BootstrapBuiltinType.unsigned_32 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_u64) {
        return BootstrapBuiltinType.unsigned_64 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_usize) {
        return BootstrapBuiltinType.unsigned_size as usize;
    }
    if (kind == BootstrapTokenKind.keyword_f32) {
        return BootstrapBuiltinType.float_32 as usize;
    }
    if (kind == BootstrapTokenKind.keyword_f64) {
        return BootstrapBuiltinType.float_64 as usize;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_parse_unsigned(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize,
    value: *u64
) -> bool {
    let token: BootstrapToken = bootstrap_semantic_token(
        context,
        unit_index,
        token_index
    );
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    if (token.kind != BootstrapTokenKind.integer ||
        value == null || token.span.length == 0) {
        return false;
    }
    var base: u64 = 10;
    var index: usize = 0;
    if (token.span.length >= 2 &&
        unit->source.data[token.span.offset] == 48) {
        let prefix: u8 =
            unit->source.data[token.span.offset + 1];
        if (prefix == 98 || prefix == 66) {
            base = 2;
            index = 2;
        } else if (prefix == 111 || prefix == 79) {
            base = 8;
            index = 2;
        } else if (prefix == 120 || prefix == 88) {
            base = 16;
            index = 2;
        }
    }
    var result: u64 = 0;
    while (index < token.span.length) {
        let byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte == 95) {
            index += 1;
            continue;
        }
        var digit: u64 = 0;
        if (byte >= 48 && byte <= 57) {
            digit = (byte - 48) as u64;
        } else if (byte >= 65 && byte <= 70) {
            digit = (byte - 65 + 10) as u64;
        } else if (byte >= 97 && byte <= 102) {
            digit = (byte - 97 + 10) as u64;
        } else {
            return false;
        }
        if (digit >= base ||
            result > (18446744073709551615 - digit) / base) {
            return false;
        }
        result = result * base + digit;
        index += 1;
    }
    *value = result;
    return true;
}

fn bootstrap_semantic_resolve_type_node(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    node_index: usize
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    let node: BootstrapSyntaxNode = bootstrap_semantic_node(
        context,
        unit_index,
        node_index
    );
    if (node.kind == BootstrapSyntaxKind.type_builtin) {
        let type_id: usize = bootstrap_semantic_builtin_type(
            bootstrap_semantic_token(
                context,
                unit_index,
                node.token_index
            ).kind
        );
        if (type_id != none) {
            return type_id;
        }
    } else if (node.kind == BootstrapSyntaxKind.type_named) {
        let symbol_id: usize = bootstrap_semantic_lookup_symbol(
            context,
            unit_index,
            node.token_index,
            BootstrapSemanticSymbolKind.named_type
        );
        if (symbol_id != none) {
            let symbols: *const BootstrapSemanticSymbol =
                context->symbols.data as
                    *const BootstrapSemanticSymbol;
            return symbols[symbol_id].type_id;
        }
    } else if (node.kind ==
        BootstrapSyntaxKind.type_pointer) {
        if (node.child_count == 1) {
            let element_type: usize =
                bootstrap_semantic_resolve_type_node(
                    context,
                    unit_index,
                    node.first_child
                );
            if (element_type != none) {
                let result: BootstrapTypeIdResult =
                    bootstrap_type_table_pointer(
                        &context->types,
                        element_type,
                        (node.flags &
                            (BootstrapSyntaxFlag
                                .read_only as usize)) != 0
                    );
                context->error = result.error;
                return result.type_id;
            }
        }
    } else if (node.kind == BootstrapSyntaxKind.type_array) {
        if (node.child_count == 2) {
            let count_node: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context,
                    unit_index,
                    node.first_child
                );
            let element_node: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context,
                    unit_index,
                    count_node.next_sibling
                );
            var element_count: u64 = 0;
            let element_type: usize =
                bootstrap_semantic_resolve_type_node(
                    context,
                    unit_index,
                    count_node.next_sibling
                );
            if (element_node.kind !=
                    BootstrapSyntaxKind.invalid &&
                element_type != none &&
                bootstrap_semantic_require_complete_type(
                    context,
                    element_type
                ) &&
                bootstrap_semantic_parse_unsigned(
                    context,
                    unit_index,
                    count_node.token_index,
                    &element_count
                ) &&
                element_count != 0 &&
                element_count <=
                    BootstrapSemanticLimit.maximum_size
                        as usize as u64) {
                let element_record: BootstrapTypeRecord =
                    bootstrap_semantic_type_record(
                        context,
                        element_type
                    );
                if (element_record.size_bytes == 0 ||
                    element_count >
                        (BootstrapSemanticLimit
                            .target_maximum_object_size as
                                usize as u64) /
                            (element_record.size_bytes as u64)) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .object_too_large,
                        unit_index,
                        node.span,
                        none,
                        bootstrap_semantic_empty_span(),
                        element_type
                    );
                    return none;
                }
                let result: BootstrapTypeIdResult =
                    bootstrap_type_table_array(
                        &context->types,
                        element_type,
                        element_count as usize
                    );
                context->error = result.error;
                if (result.error == RuntimeError.none) {
                    return result.type_id;
                }
            }
        }
    }
    bootstrap_semantic_add_diagnostic(
        context,
        BootstrapSemanticDiagnosticKind.unknown_type,
        unit_index,
        node.span,
        none,
        bootstrap_semantic_empty_span(),
        node_index
    );
    return none;
}

fn bootstrap_semantic_align_up(
    value: usize,
    alignment: usize,
    result: *usize
) -> bool {
    if (alignment == 0 ||
        (alignment & (alignment - 1)) != 0 ||
        result == null) {
        return false;
    }
    let mask: usize = alignment - 1;
    if (value >
        (BootstrapSemanticLimit.maximum_size as usize) - mask) {
        return false;
    }
    *result = (value + mask) & ~mask;
    return true;
}

fn bootstrap_semantic_find_type_symbol(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> usize {
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        if (symbols[index].kind ==
                BootstrapSemanticSymbolKind.named_type &&
            symbols[index].type_id == type_id) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_report_type_declaration(
    context: *BootstrapSemanticContext,
    kind: BootstrapSemanticDiagnosticKind,
    type_id: usize,
    detail: usize
) -> bool {
    let symbol_id: usize =
        bootstrap_semantic_find_type_symbol(context, type_id);
    if (symbol_id == bootstrap_semantic_no_id()) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let symbol: BootstrapSemanticSymbol = symbols[symbol_id];
    return bootstrap_semantic_add_diagnostic(
        context,
        kind,
        symbol.declaration_unit,
        bootstrap_semantic_node(
            context,
            symbol.declaration_unit,
            symbol.declaration_node
        ).span,
        bootstrap_semantic_no_id(),
        bootstrap_semantic_empty_span(),
        detail
    );
}

fn bootstrap_semantic_require_complete_type(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> bool {
    if (type_id >= context->types.type_count) {
        return false;
    }
    let record: BootstrapTypeRecordResult =
        bootstrap_type_table_get(context->types, type_id);
    if (record.error != RuntimeError.none) {
        context->error = record.error;
        return false;
    }
    if ((record.record.flags &
            (BootstrapTypeFlag.complete as usize)) != 0) {
        return true;
    }
    return bootstrap_semantic_resolve_layout(
        context,
        type_id
    );
}

fn bootstrap_semantic_field_name_exists(
    context: *BootstrapSemanticContext,
    owner_type: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let fields: *const BootstrapTypeField =
        context->types.fields.data as
            *const BootstrapTypeField;
    var index: usize = 0;
    while (index < context->types.field_count) {
        if (fields[index].owner_type == owner_type &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                fields[index].declaration_unit,
                fields[index].name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_resolve_record_field_types(
    context: *BootstrapSemanticContext,
    record: BootstrapTypeRecord
) -> bool {
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            record.declaration_unit,
            record.declaration_node
        );
    var field_node: usize = declaration.first_child;
    while (field_node != bootstrap_semantic_no_id() &&
        context->error == RuntimeError.none) {
        let field_declaration: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                record.declaration_unit,
                field_node
            );
        if (field_declaration.kind !=
                BootstrapSyntaxKind.field_declaration ||
            field_declaration.child_count != 1) {
            context->error = RuntimeError.invalid_argument;
            return false;
        }
        let field_type: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                record.declaration_unit,
                field_declaration.first_child
            );
        if (field_type != bootstrap_semantic_no_id()) {
            bootstrap_semantic_require_complete_type(
                context,
                field_type
            );
        }
        field_node = field_declaration.next_sibling;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_resolve_record_layout(
    context: *BootstrapSemanticContext,
    type_id: usize,
    record: BootstrapTypeRecord
) -> bool {
    if (!bootstrap_semantic_resolve_record_field_types(
            context,
            record
        )) {
        return false;
    }
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            record.declaration_unit,
            record.declaration_node
        );
    let is_union: bool =
        record.kind == BootstrapTypeKind.record_union;
    var size_bytes: usize = 0;
    var alignment_bytes: usize = 1;
    var field_node: usize = declaration.first_child;
    while (field_node != bootstrap_semantic_no_id()) {
        let field_declaration: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                record.declaration_unit,
                field_node
            );
        if (field_declaration.kind !=
                BootstrapSyntaxKind.field_declaration ||
            field_declaration.child_count != 1) {
            context->error = RuntimeError.invalid_argument;
            return false;
        }
        let duplicate: usize =
            bootstrap_semantic_field_name_exists(
                context,
                type_id,
                record.declaration_unit,
                field_declaration.token_index
            );
        if (duplicate != bootstrap_semantic_no_id()) {
            let fields: *const BootstrapTypeField =
                context->types.fields.data as
                    *const BootstrapTypeField;
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.duplicate_field,
                record.declaration_unit,
                bootstrap_semantic_token(
                    context,
                    record.declaration_unit,
                    field_declaration.token_index
                ).span,
                fields[duplicate].declaration_unit,
                bootstrap_semantic_token(
                    context,
                    fields[duplicate].declaration_unit,
                    fields[duplicate].name_token
                ).span,
                duplicate
            );
            field_node = field_declaration.next_sibling;
            continue;
        }
        let field_type: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                record.declaration_unit,
                field_declaration.first_child
            );
        if (field_type == bootstrap_semantic_no_id() ||
            !bootstrap_semantic_require_complete_type(
                context,
                field_type
            )) {
            field_node = field_declaration.next_sibling;
            continue;
        }
        let field_record: BootstrapTypeRecordResult =
            bootstrap_type_table_get(
                context->types,
                field_type
            );
        if (field_record.error != RuntimeError.none) {
            context->error = field_record.error;
            return false;
        }
        if (field_record.record.kind ==
                BootstrapTypeKind.type_void ||
            field_record.record.size_bytes == 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.incomplete_type,
                record.declaration_unit,
                field_declaration.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                field_type
            );
            field_node = field_declaration.next_sibling;
            continue;
        }
        var field_offset: usize = 0;
        if (is_union) {
            if (field_record.record.size_bytes > size_bytes) {
                size_bytes = field_record.record.size_bytes;
            }
        } else {
            if (!bootstrap_semantic_align_up(
                    size_bytes,
                    field_record.record.alignment_bytes,
                    &field_offset
                ) ||
                field_offset >
                    BootstrapSemanticLimit
                        .target_maximum_object_size as usize ||
                field_record.record.size_bytes >
                    (BootstrapSemanticLimit
                        .target_maximum_object_size as usize) -
                        field_offset) {
                bootstrap_semantic_report_type_declaration(
                    context,
                    BootstrapSemanticDiagnosticKind.object_too_large,
                    type_id,
                    field_type
                );
                return false;
            }
            size_bytes =
                field_offset + field_record.record.size_bytes;
        }
        if (field_record.record.alignment_bytes >
            alignment_bytes) {
            alignment_bytes =
                field_record.record.alignment_bytes;
        }
        let added: BootstrapTypeTableResult =
            bootstrap_type_table_add_field(
                context->types,
                {
                    owner_type = type_id,
                    type_id = field_type,
                    declaration_unit = record.declaration_unit,
                    declaration_node = field_node,
                    name_token = field_declaration.token_index,
                    offset_bytes = field_offset,
                }
            );
        context->types = added.table;
        context->error = added.error;
        field_node = field_declaration.next_sibling;
    }
    if (size_bytes == 0) {
        size_bytes = 1;
    }
    var aligned_size: usize = 0;
    if (!bootstrap_semantic_align_up(
            size_bytes,
            alignment_bytes,
            &aligned_size
        ) ||
        aligned_size >
            BootstrapSemanticLimit
                .target_maximum_object_size as usize) {
        bootstrap_semantic_report_type_declaration(
            context,
            BootstrapSemanticDiagnosticKind.object_too_large,
            type_id,
            size_bytes
        );
        return false;
    }
    context->error = bootstrap_type_table_set_layout(
        context->types,
        type_id,
        aligned_size,
        alignment_bytes
    );
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_integer_fits_type(
    kind: BootstrapTypeKind,
    magnitude: u64,
    negative: bool
) -> bool {
    let bits: usize = bootstrap_type_bit_width(kind);
    if (bits == 0 || bits > 64) {
        return false;
    }
    if (!bootstrap_type_is_signed_integer(kind)) {
        return !negative &&
            (bits == 64 ||
                magnitude < (1 as u64) << (bits as u64));
    }
    if (bits == 64) {
        return negative ?
            magnitude <= 9223372036854775808 :
            magnitude <= 9223372036854775807;
    }
    let maximum: u64 =
        (1 as u64) << ((bits - 1) as u64);
    return negative ?
        magnitude <= maximum :
        magnitude < maximum;
}

fn bootstrap_semantic_enum_value(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    member: BootstrapSyntaxNode,
    underlying_kind: BootstrapTypeKind,
    implicit_value: u64,
    value: *u64
) -> bool {
    if (member.child_count == 0) {
        *value = implicit_value;
        return true;
    }
    let initializer: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            unit_index,
            member.first_child
        );
    var literal: BootstrapSyntaxNode = initializer;
    var negative: bool = false;
    if (initializer.kind ==
        BootstrapSyntaxKind.unary_expression) {
        let operation: BootstrapTokenKind =
            bootstrap_semantic_token(
                context,
                unit_index,
                initializer.token_index
            ).kind;
        if (initializer.child_count != 1 ||
            (operation != BootstrapTokenKind.plus &&
                operation != BootstrapTokenKind.minus)) {
            return false;
        }
        negative = operation == BootstrapTokenKind.minus;
        literal = bootstrap_semantic_node(
            context,
            unit_index,
            initializer.first_child
        );
    }
    var magnitude: u64 = 0;
    if (literal.kind !=
            BootstrapSyntaxKind.integer_expression ||
        !bootstrap_semantic_parse_unsigned(
            context,
            unit_index,
            literal.token_index,
            &magnitude
        ) ||
        !bootstrap_semantic_integer_fits_type(
            underlying_kind,
            magnitude,
            negative
        )) {
        return false;
    }
    *value = bootstrap_semantic_mask_integer(
        negative ? 0 - magnitude : magnitude,
        bootstrap_type_bit_width(underlying_kind)
    );
    return true;
}

fn bootstrap_semantic_enum_can_increment(
    kind: BootstrapTypeKind,
    value: u64
) -> bool {
    let bits: usize = bootstrap_type_bit_width(kind);
    if (bootstrap_type_is_signed_integer(kind)) {
        let maximum: u64 = bits == 64 ?
            9223372036854775807 :
            ((1 as u64) << ((bits - 1) as u64)) - 1;
        return value != maximum;
    }
    let maximum: u64 = bits == 64 ?
        18446744073709551615 :
        ((1 as u64) << (bits as u64)) - 1;
    return value != maximum;
}

fn bootstrap_semantic_resolve_enum_layout(
    context: *BootstrapSemanticContext,
    type_id: usize,
    record: BootstrapTypeRecord
) -> bool {
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            record.declaration_unit,
            record.declaration_node
        );
    if (declaration.child_count == 0) {
        return false;
    }
    let underlying_type: usize =
        bootstrap_semantic_resolve_type_node(
            context,
            record.declaration_unit,
            declaration.first_child
        );
    if (underlying_type == bootstrap_semantic_no_id()) {
        return false;
    }
    let underlying: BootstrapTypeRecordResult =
        bootstrap_type_table_get(
            context->types,
            underlying_type
        );
    if (underlying.error != RuntimeError.none) {
        context->error = underlying.error;
        return false;
    }
    if (!bootstrap_type_is_integer(underlying.record.kind)) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind
                .invalid_enum_underlying,
            record.declaration_unit,
            bootstrap_semantic_node(
                context,
                record.declaration_unit,
                declaration.first_child
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            underlying_type
        );
        return false;
    }
    context->error =
        bootstrap_type_table_set_enum_underlying(
            context->types,
            type_id,
            underlying_type
        );
    var member_id: usize = bootstrap_semantic_node(
        context,
        record.declaration_unit,
        declaration.first_child
    ).next_sibling;
    var next_value: u64 = 0;
    var next_value_valid: bool = true;
    while (member_id != bootstrap_semantic_no_id()) {
        let member: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                record.declaration_unit,
                member_id
            );
        let duplicate: usize =
            bootstrap_semantic_find_enum_member(
                context,
                type_id,
                record.declaration_unit,
                member.token_index
            );
        if (duplicate != bootstrap_semantic_no_id()) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .duplicate_enum_member,
                record.declaration_unit,
                member.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                duplicate
            );
        } else {
            var value: u64 = next_value;
            let implicit_overflow: bool =
                member.child_count == 0 &&
                !next_value_valid;
            if (implicit_overflow ||
                !bootstrap_semantic_enum_value(
                    context,
                    record.declaration_unit,
                    member,
                    underlying.record.kind,
                    next_value,
                    &value
                )) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    implicit_overflow ?
                        BootstrapSemanticDiagnosticKind
                            .enum_value_overflow :
                        BootstrapSemanticDiagnosticKind
                            .invalid_enum_value,
                    record.declaration_unit,
                    member.span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    type_id
                );
            } else {
                bootstrap_semantic_append_symbol(
                    context,
                    {
                        kind = BootstrapSemanticSymbolKind
                            .enum_member,
                        module_id = bootstrap_semantic_unit_module(
                            context,
                            record.declaration_unit
                        ),
                        declaration_unit =
                            record.declaration_unit,
                        declaration_node = member_id,
                        name_token = member.token_index,
                        type_id = type_id,
                        function_id = bootstrap_semantic_no_id(),
                        integer_value = value,
                        flags = BootstrapSemanticSymbolFlag
                            .none as usize,
                    }
                );
                next_value = bootstrap_semantic_mask_integer(
                    value + 1,
                    bootstrap_type_bit_width(
                        underlying.record.kind
                    )
                );
                next_value_valid =
                    bootstrap_semantic_enum_can_increment(
                        underlying.record.kind,
                        value
                    );
            }
        }
        member_id = member.next_sibling;
    }
    context->error = bootstrap_type_table_set_layout(
        context->types,
        type_id,
        underlying.record.size_bytes,
        underlying.record.alignment_bytes
    );
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_resolve_layout(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> bool {
    let result: BootstrapTypeRecordResult =
        bootstrap_type_table_get(context->types, type_id);
    if (result.error != RuntimeError.none) {
        context->error = result.error;
        return false;
    }
    let record: BootstrapTypeRecord = result.record;
    if ((record.flags &
            (BootstrapTypeFlag.complete as usize)) != 0) {
        return true;
    }
    if ((record.flags &
            (BootstrapTypeFlag.resolving as usize)) != 0) {
        bootstrap_semantic_report_type_declaration(
            context,
            BootstrapSemanticDiagnosticKind.recursive_type,
            type_id,
            type_id
        );
        return false;
    }
    if (context->type_depth >=
        BootstrapSemanticLimit.maximum_type_depth as usize) {
        bootstrap_semantic_report_type_declaration(
            context,
            BootstrapSemanticDiagnosticKind.resource_limit,
            type_id,
            context->type_depth
        );
        return false;
    }
    context->type_depth += 1;
    context->error = bootstrap_type_table_set_resolving(
        context->types,
        type_id,
        true
    );
    if (context->error != RuntimeError.none) {
        context->type_depth -= 1;
        return false;
    }
    var success: bool = false;
    if (record.kind == BootstrapTypeKind.enumeration) {
        success = bootstrap_semantic_resolve_enum_layout(
            context,
            type_id,
            record
        );
    } else {
        success = bootstrap_semantic_resolve_record_layout(
            context,
            type_id,
            record
        );
    }
    context->type_depth -= 1;
    return success;
}

fn bootstrap_semantic_resolve_all_types(
    context: *BootstrapSemanticContext
) -> bool {
    var type_id: usize =
        BootstrapBuiltinType.count as usize;
    while (type_id < context->types.type_count &&
        context->error == RuntimeError.none) {
        bootstrap_semantic_resolve_layout(context, type_id);
        type_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_append_function(
    context: *BootstrapSemanticContext,
    function: BootstrapSemanticFunction
) -> usize {
    let result: usize = context->function_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->functions,
            (&function) as
                *const BootstrapSemanticFunction as *const u8,
            sizeof(BootstrapSemanticFunction)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->function_count += 1;
    return result;
}

fn bootstrap_semantic_append_parameter(
    context: *BootstrapSemanticContext,
    parameter: BootstrapSemanticParameter
) -> usize {
    let result: usize = context->parameter_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->parameters,
            (&parameter) as
                *const BootstrapSemanticParameter as *const u8,
            sizeof(BootstrapSemanticParameter)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->parameter_count += 1;
    return result;
}

fn bootstrap_semantic_function_parts(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    declaration: BootstrapSyntaxNode,
    parameter_count: *usize,
    return_node: *usize,
    body_node: *usize
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (parameter_count == null ||
        return_node == null || body_node == null) {
        return false;
    }
    *parameter_count = 0;
    *return_node = none;
    *body_node = none;
    var child: usize = declaration.first_child;
    while (child != none) {
        let node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        if (node.kind == BootstrapSyntaxKind.parameter &&
            *return_node == none && *body_node == none) {
            *parameter_count += 1;
        } else if ((node.kind ==
                    BootstrapSyntaxKind.type_builtin ||
                node.kind == BootstrapSyntaxKind.type_named ||
                node.kind == BootstrapSyntaxKind.type_pointer ||
                node.kind == BootstrapSyntaxKind.type_array) &&
            *return_node == none && *body_node == none) {
            *return_node = child;
        } else if (node.kind ==
                BootstrapSyntaxKind.block_statement &&
            *body_node == none) {
            *body_node = child;
        } else {
            context->error = RuntimeError.invalid_argument;
            return false;
        }
        child = node.next_sibling;
    }
    return true;
}

fn bootstrap_semantic_parameter_name_exists(
    context: *BootstrapSemanticContext,
    function_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var index: usize = 0;
    while (index < context->parameter_count) {
        if (parameters[index].function_id == function_id &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                parameters[index].unit_index,
                parameters[index].name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_collect_function_parameters(
    context: *BootstrapSemanticContext,
    function_id: usize,
    unit_index: usize,
    declaration: BootstrapSyntaxNode,
    expected_parameter_count: usize
) -> bool {
    var functions: *BootstrapSemanticFunction =
        context->functions.data as
            *BootstrapSemanticFunction;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < expected_parameter_count) {
        let parameter_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        if (parameter_node.kind !=
                BootstrapSyntaxKind.parameter ||
            parameter_node.child_count != 1) {
            context->error = RuntimeError.invalid_argument;
            return false;
        }
        let duplicate: usize =
            bootstrap_semantic_parameter_name_exists(
                context,
                function_id,
                unit_index,
                parameter_node.token_index
            );
        if (duplicate != bootstrap_semantic_no_id()) {
            let parameters: *const BootstrapSemanticParameter =
                context->parameters.data as
                    *const BootstrapSemanticParameter;
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .duplicate_parameter,
                unit_index,
                bootstrap_semantic_token(
                    context,
                    unit_index,
                    parameter_node.token_index
                ).span,
                parameters[duplicate].unit_index,
                bootstrap_semantic_token(
                    context,
                    parameters[duplicate].unit_index,
                    parameters[duplicate].name_token
                ).span,
                duplicate
            );
        }
        let type_id: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                unit_index,
                parameter_node.first_child
            );
        if (type_id != bootstrap_semantic_no_id()) {
            let type_record: BootstrapTypeRecordResult =
                bootstrap_type_table_get(
                    context->types,
                    type_id
                );
            if (type_record.error != RuntimeError.none) {
                context->error = type_record.error;
                return false;
            }
            if (type_record.record.kind ==
                BootstrapTypeKind.type_void) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .incomplete_type,
                    unit_index,
                    parameter_node.span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    type_id
                );
            }
            if (functions[function_id].parameter_count == 0) {
                functions[function_id].first_parameter =
                    context->parameter_count;
            }
            bootstrap_semantic_append_parameter(
                context,
                {
                    function_id = function_id,
                    type_id = type_id,
                    unit_index = unit_index,
                    declaration_node = child,
                    name_token = parameter_node.token_index,
                }
            );
            functions = context->functions.data as
                *BootstrapSemanticFunction;
            functions[function_id].parameter_count += 1;
        }
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_external_name_is_reserved(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize
) -> bool {
    let token: BootstrapToken = bootstrap_semantic_token(
        context,
        unit_index,
        token_index
    );
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    return bootstrap_semantic_token_equals_bytes(
            context,
            unit_index,
            token_index,
            "_start",
            6
        ) ||
        (unit != null && token.span.length >= 2 &&
            unit->source.data[token.span.offset] == 95 &&
            unit->source.data[token.span.offset + 1] == 76);
}

fn bootstrap_semantic_validate_external_signature(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let symbol: BootstrapSemanticSymbol =
        symbols[function.symbol_id];
    if (bootstrap_semantic_external_name_is_reserved(
            context,
            symbol.declaration_unit,
            symbol.name_token
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_external,
            symbol.declaration_unit,
            bootstrap_semantic_token(
                context,
                symbol.declaration_unit,
                symbol.name_token
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            function_id
        );
    }
    if (function.return_type != bootstrap_semantic_no_id() &&
        bootstrap_semantic_type_record(
            context,
            function.return_type
        ).kind == BootstrapTypeKind.array) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_external,
            symbol.declaration_unit,
            bootstrap_semantic_node(
                context,
                symbol.declaration_unit,
                symbol.declaration_node
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            function.return_type
        );
    }
    var index: usize = 0;
    while (index < function.parameter_count) {
        let parameter: BootstrapSemanticParameter =
            parameters[function.first_parameter + index];
        let record: BootstrapTypeRecord =
            bootstrap_semantic_type_record(
                context,
                parameter.type_id
            );
        if (record.kind == BootstrapTypeKind.array) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .invalid_external,
                parameter.unit_index,
                bootstrap_semantic_node(
                    context,
                    parameter.unit_index,
                    parameter.declaration_node
                ).span,
                symbol.declaration_unit,
                bootstrap_semantic_node(
                    context,
                    symbol.declaration_unit,
                    symbol.declaration_node
                ).span,
                parameter.type_id
            );
        }
        index += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_find_module_function(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var index: usize = 0;
    while (index < context->function_count) {
        let symbol: BootstrapSemanticSymbol =
            symbols[functions[index].symbol_id];
        if (symbol.module_id == module_id &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                symbol.declaration_unit,
                symbol.name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_add_function_declaration(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    declaration_id: usize,
    declaration: BootstrapSyntaxNode,
    interface_unit: bool
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!bootstrap_semantic_function_parts(
            context,
            unit_index,
            declaration,
            &parameter_count,
            &return_node,
            &body_node
        )) {
        return none;
    }
    let external: bool =
        (declaration.flags &
            (BootstrapSyntaxFlag.external as usize)) != 0;
    let exported: bool =
        (declaration.flags &
            (BootstrapSyntaxFlag.exported as usize)) != 0;
    let bodyless: bool =
        (declaration.flags &
            (BootstrapSyntaxFlag.bodyless as usize)) != 0;
    if ((!interface_unit && exported) ||
        (external && !bodyless) ||
        (interface_unit && !bodyless)) {
        bootstrap_semantic_add_diagnostic(
            context,
            (!interface_unit && exported) ?
                BootstrapSemanticDiagnosticKind.invalid_export :
                BootstrapSemanticDiagnosticKind.invalid_external,
            unit_index,
            declaration.span,
            none,
            bootstrap_semantic_empty_span(),
            0
        );
    }
    var flags: usize =
        BootstrapSemanticSymbolFlag.none as usize;
    if (exported) {
        flags |= BootstrapSemanticSymbolFlag.exported as usize;
    }
    if (external) {
        flags |= BootstrapSemanticSymbolFlag.external as usize;
    }
    if (interface_unit) {
        flags |= BootstrapSemanticSymbolFlag
            .interface_declaration as usize;
    }
    let symbol_id: usize = bootstrap_semantic_append_symbol(
        context,
        {
            kind = BootstrapSemanticSymbolKind.function,
            module_id = module_id,
            declaration_unit = unit_index,
            declaration_node = declaration_id,
            name_token = declaration.token_index,
            type_id = none,
            function_id = context->function_count,
            integer_value = 0,
            flags = flags,
        }
    );
    if (symbol_id == none) {
        return none;
    }
    let function_id: usize = bootstrap_semantic_append_function(
        context,
        {
            symbol_id = symbol_id,
            interface_unit = interface_unit ?
                unit_index : none,
            interface_node = interface_unit ?
                declaration_id : none,
            implementation_unit = interface_unit ?
                none : unit_index,
            implementation_node = interface_unit ?
                none : declaration_id,
            return_type = BootstrapBuiltinType.type_void as usize,
            first_parameter = none,
            parameter_count = 0,
            ir_function = none,
            flags = flags,
        }
    );
    if (function_id == none) {
        return none;
    }
    if (return_node != none) {
        let return_type: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                unit_index,
                return_node
            );
        let functions: *BootstrapSemanticFunction =
            context->functions.data as
                *BootstrapSemanticFunction;
        functions[function_id].return_type = return_type;
    }
    bootstrap_semantic_collect_function_parameters(
        context,
        function_id,
        unit_index,
        declaration,
        parameter_count
    );
    if (external) {
        bootstrap_semantic_validate_external_signature(
            context,
            function_id
        );
    }
    return function_id;
}

fn bootstrap_semantic_function_signature_matches(
    context: *BootstrapSemanticContext,
    function_id: usize,
    unit_index: usize,
    declaration: BootstrapSyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    var parameter_count: usize = 0;
    var return_node: usize = none;
    var body_node: usize = none;
    if (!bootstrap_semantic_function_parts(
            context,
            unit_index,
            declaration,
            &parameter_count,
            &return_node,
            &body_node
        )) {
        return false;
    }
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    if (parameter_count != function.parameter_count) {
        return false;
    }
    let actual_return: usize = return_node == none ?
        BootstrapBuiltinType.type_void as usize :
        bootstrap_semantic_resolve_type_node(
            context,
            unit_index,
            return_node
        );
    if (actual_return != function.return_type) {
        return false;
    }
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < parameter_count) {
        let parameter_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                child
            );
        let actual_type: usize =
            bootstrap_semantic_resolve_type_node(
                context,
                unit_index,
                parameter_node.first_child
            );
        if (actual_type !=
            parameters[function.first_parameter + index].type_id) {
            return false;
        }
        child = parameter_node.next_sibling;
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_collect_functions_in_unit(
    context: *BootstrapSemanticContext,
    module_id: usize,
    unit_index: usize,
    interface_unit: bool
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (unit_index == none) {
        return true;
    }
    var declaration_id: usize =
        bootstrap_semantic_first_declaration(
            context,
            unit_index
        );
    while (declaration_id != none &&
        context->error == RuntimeError.none) {
        let declaration: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                unit_index,
                declaration_id
            );
        if (declaration.kind ==
            BootstrapSyntaxKind.function_declaration) {
            let duplicate_name: usize =
                bootstrap_semantic_find_any_local_symbol(
                    context,
                    module_id,
                    unit_index,
                    declaration.token_index
                );
            let existing_function: usize =
                bootstrap_semantic_find_module_function(
                    context,
                    module_id,
                    unit_index,
                    declaration.token_index
                );
            if (!interface_unit && existing_function != none) {
                if ((declaration.flags &
                        (BootstrapSyntaxFlag.exported as usize)) != 0) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind.invalid_export,
                        unit_index,
                        declaration.span,
                        none,
                        bootstrap_semantic_empty_span(),
                        existing_function
                    );
                }
                var functions: *BootstrapSemanticFunction =
                    context->functions.data as
                        *BootstrapSemanticFunction;
                let existing: BootstrapSemanticFunction =
                    functions[existing_function];
                if (existing.implementation_unit != none ||
                    (existing.flags &
                        (BootstrapSemanticSymbolFlag
                            .external as usize)) != 0) {
                    let symbols: *const BootstrapSemanticSymbol =
                        context->symbols.data as
                            *const BootstrapSemanticSymbol;
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .duplicate_function,
                        unit_index,
                        declaration.span,
                        symbols[existing.symbol_id].declaration_unit,
                        bootstrap_semantic_node(
                            context,
                            symbols[existing.symbol_id]
                                .declaration_unit,
                            symbols[existing.symbol_id]
                                .declaration_node
                        ).span,
                        existing_function
                    );
                } else if (!bootstrap_semantic_function_signature_matches(
                        context,
                        existing_function,
                        unit_index,
                        declaration
                    )) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .signature_mismatch,
                        unit_index,
                        declaration.span,
                        existing.interface_unit,
                        bootstrap_semantic_node(
                            context,
                            existing.interface_unit,
                            existing.interface_node
                        ).span,
                        existing_function
                    );
                } else {
                    functions =
                        context->functions.data as
                            *BootstrapSemanticFunction;
                    functions[existing_function]
                        .implementation_unit = unit_index;
                    functions[existing_function]
                        .implementation_node = declaration_id;
                }
            } else if (duplicate_name != none) {
                let symbols: *const BootstrapSemanticSymbol =
                    context->symbols.data as
                        *const BootstrapSemanticSymbol;
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.duplicate_name,
                    unit_index,
                    declaration.span,
                    symbols[duplicate_name].declaration_unit,
                    bootstrap_semantic_node(
                        context,
                        symbols[duplicate_name].declaration_unit,
                        symbols[duplicate_name].declaration_node
                    ).span,
                    duplicate_name
                );
            } else {
                bootstrap_semantic_add_function_declaration(
                    context,
                    module_id,
                    unit_index,
                    declaration_id,
                    declaration,
                    interface_unit
                );
            }
        }
        declaration_id = declaration.next_sibling;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_collect_functions(
    context: *BootstrapSemanticContext
) -> bool {
    var module_id: usize = 0;
    while (module_id < context->module_count &&
        context->error == RuntimeError.none) {
        let modules: *const BootstrapSemanticModule =
            context->modules.data as
                *const BootstrapSemanticModule;
        if (!bootstrap_semantic_collect_functions_in_unit(
                context,
                module_id,
                modules[module_id].interface_unit,
                true
            ) ||
            !bootstrap_semantic_collect_functions_in_unit(
                context,
                module_id,
                modules[module_id].implementation_unit,
                false
            )) {
            return false;
        }
        module_id += 1;
    }
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let root_module: usize =
        bootstrap_semantic_unit_module(context, 0);
    var function_id: usize = 0;
    while (function_id < context->function_count) {
        let function: BootstrapSemanticFunction =
            functions[function_id];
        let symbol: BootstrapSemanticSymbol =
            symbols[function.symbol_id];
        if (function.interface_unit !=
                bootstrap_semantic_no_id() &&
            function.implementation_unit ==
                bootstrap_semantic_no_id() &&
            symbol.module_id == root_module &&
            (function.flags &
                (BootstrapSemanticSymbolFlag.external as usize)) == 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.missing_definition,
                symbol.declaration_unit,
                bootstrap_semantic_node(
                    context,
                    symbol.declaration_unit,
                    symbol.declaration_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                function_id
            );
        }
        if (function.implementation_unit !=
                bootstrap_semantic_no_id() &&
            (function.flags &
                (BootstrapSemanticSymbolFlag.external as usize)) == 0) {
            let implementation: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context,
                    function.implementation_unit,
                    function.implementation_node
                );
            if ((implementation.flags &
                    (BootstrapSyntaxFlag.bodyless as usize)) != 0) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .missing_definition,
                    function.implementation_unit,
                    implementation.span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    function_id
                );
            }
        }
        function_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_symbols_have_same_name(
    context: *BootstrapSemanticContext,
    left: BootstrapSemanticSymbol,
    right: BootstrapSemanticSymbol
) -> bool {
    return left.kind !=
            BootstrapSemanticSymbolKind.enum_member &&
        right.kind !=
            BootstrapSemanticSymbolKind.enum_member &&
        bootstrap_semantic_tokens_equal(
            context,
            left.declaration_unit,
            left.name_token,
            right.declaration_unit,
            right.name_token
        );
}

fn bootstrap_semantic_validate_imported_names(
    context: *BootstrapSemanticContext
) -> bool {
    let modules: *const BootstrapSemanticModule =
        context->modules.data as
            *const BootstrapSemanticModule;
    let imports: *const BootstrapSemanticImport =
        context->imports.data as
            *const BootstrapSemanticImport;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var module_id: usize = 0;
    while (module_id < context->module_count) {
        let module_record: BootstrapSemanticModule =
            modules[module_id];
        var left_import_index: usize = 0;
        while (left_import_index <
            module_record.import_count) {
            let left_import: BootstrapSemanticImport =
                imports[
                    module_record.first_import +
                        left_import_index
                ];
            var right_import_index: usize =
                left_import_index + 1;
            while (right_import_index <
                module_record.import_count) {
                let right_import: BootstrapSemanticImport =
                    imports[
                        module_record.first_import +
                            right_import_index
                    ];
                var left_symbol_id: usize = 0;
                while (left_symbol_id <
                    context->symbol_count) {
                    let left_symbol: BootstrapSemanticSymbol =
                        symbols[left_symbol_id];
                    if (left_symbol.module_id ==
                            left_import.target_module &&
                        (left_symbol.flags &
                            (BootstrapSemanticSymbolFlag
                                .exported as usize)) != 0) {
                        var right_symbol_id: usize = 0;
                        while (right_symbol_id <
                            context->symbol_count) {
                            let right_symbol:
                                BootstrapSemanticSymbol =
                                symbols[right_symbol_id];
                            if (right_symbol.module_id ==
                                    right_import.target_module &&
                                (right_symbol.flags &
                                    (BootstrapSemanticSymbolFlag
                                        .exported as usize)) != 0 &&
                                bootstrap_semantic_symbols_have_same_name(
                                    context,
                                    left_symbol,
                                    right_symbol
                                )) {
                                bootstrap_semantic_add_diagnostic(
                                    context,
                                    BootstrapSemanticDiagnosticKind
                                        .ambiguous_import,
                                    right_import.source_unit,
                                    bootstrap_semantic_node(
                                        context,
                                        right_import.source_unit,
                                        right_import
                                            .declaration_node
                                    ).span,
                                    left_import.source_unit,
                                    bootstrap_semantic_node(
                                        context,
                                        left_import.source_unit,
                                        left_import
                                            .declaration_node
                                    ).span,
                                    right_symbol_id
                                );
                            }
                            right_symbol_id += 1;
                        }
                    }
                    left_symbol_id += 1;
                }
                right_import_index += 1;
            }
            left_import_index += 1;
        }

        var local_symbol_id: usize = 0;
        while (local_symbol_id < context->symbol_count) {
            let local_symbol: BootstrapSemanticSymbol =
                symbols[local_symbol_id];
            if (local_symbol.module_id == module_id &&
                local_symbol.kind !=
                    BootstrapSemanticSymbolKind.enum_member) {
                var import_index: usize = 0;
                while (import_index <
                    module_record.import_count) {
                    let import_record:
                        BootstrapSemanticImport =
                        imports[
                            module_record.first_import +
                                import_index
                        ];
                    var imported_symbol_id: usize = 0;
                    while (imported_symbol_id <
                        context->symbol_count) {
                        let imported_symbol:
                            BootstrapSemanticSymbol =
                            symbols[imported_symbol_id];
                        if (imported_symbol.module_id ==
                                import_record.target_module &&
                            (imported_symbol.flags &
                                (BootstrapSemanticSymbolFlag
                                    .exported as usize)) != 0 &&
                            bootstrap_semantic_symbols_have_same_name(
                                context,
                                local_symbol,
                                imported_symbol
                            )) {
                            bootstrap_semantic_add_diagnostic(
                                context,
                                BootstrapSemanticDiagnosticKind
                                    .duplicate_name,
                                local_symbol.declaration_unit,
                                bootstrap_semantic_token(
                                    context,
                                    local_symbol.declaration_unit,
                                    local_symbol.name_token
                                ).span,
                                imported_symbol.declaration_unit,
                                bootstrap_semantic_token(
                                    context,
                                    imported_symbol
                                        .declaration_unit,
                                    imported_symbol.name_token
                                ).span,
                                imported_symbol_id
                            );
                        }
                        imported_symbol_id += 1;
                    }
                    import_index += 1;
                }
            }
            local_symbol_id += 1;
        }
        module_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_ir_function_record(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> BootstrapIrFunction {
    let none: usize = bootstrap_semantic_no_id();
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let symbol: BootstrapSemanticSymbol =
        symbols[function.symbol_id];
    let external: bool =
        (function.flags &
            (BootstrapSemanticSymbolFlag.external as usize)) != 0;
    let exported: bool =
        (function.flags &
            (BootstrapSemanticSymbolFlag.exported as usize)) != 0;
    var has_body: bool = false;
    if (function.implementation_unit != none &&
        !external) {
        let implementation: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                function.implementation_unit,
                function.implementation_node
            );
        has_body =
            (implementation.flags &
                (BootstrapSyntaxFlag.bodyless as usize)) == 0;
    }
    return {
        declaration_unit = symbol.declaration_unit,
        declaration_node = symbol.declaration_node,
        name_token = symbol.name_token,
        linkage = external ?
            BootstrapIrLinkage.external_c :
            (exported ?
                BootstrapIrLinkage.module_export :
                BootstrapIrLinkage.internal),
        return_type = function.return_type,
        first_parameter = none,
        parameter_count = 0,
        first_slot = none,
        slot_count = 0,
        first_block = none,
        block_count = 0,
        first_value = none,
        value_count = 0,
        has_body = has_body,
    };
}

fn bootstrap_semantic_text_is_before(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_span: BootstrapSourceSpan,
    right_unit: usize,
    right_span: BootstrapSourceSpan
) -> bool {
    let left: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, left_unit);
    let right: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, right_unit);
    if (left == null || right == null ||
        left_span.offset > left->source.length ||
        left_span.length >
            left->source.length - left_span.offset ||
        right_span.offset > right->source.length ||
        right_span.length >
            right->source.length - right_span.offset) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let shared_length: usize =
        left_span.length < right_span.length ?
            left_span.length : right_span.length;
    var index: usize = 0;
    while (index < shared_length) {
        let left_byte: u8 =
            left->source.data[left_span.offset + index];
        let right_byte: u8 =
            right->source.data[right_span.offset + index];
        if (left_byte != right_byte) {
            return left_byte < right_byte;
        }
        index += 1;
    }
    return left_span.length < right_span.length;
}

fn bootstrap_semantic_token_is_before(
    context: *BootstrapSemanticContext,
    left_unit: usize,
    left_token: usize,
    right_unit: usize,
    right_token: usize
) -> bool {
    return bootstrap_semantic_text_is_before(
        context,
        left_unit,
        bootstrap_semantic_token(
            context,
            left_unit,
            left_token
        ).span,
        right_unit,
        bootstrap_semantic_token(
            context,
            right_unit,
            right_token
        ).span
    );
}

fn bootstrap_semantic_module_name_is_before(
    context: *BootstrapSemanticContext,
    left_module: usize,
    right_module: usize
) -> bool {
    let modules: *const BootstrapSemanticModule =
        context->modules.data as
            *const BootstrapSemanticModule;
    let left: BootstrapSemanticModule =
        modules[left_module];
    let right: BootstrapSemanticModule =
        modules[right_module];
    let left_name: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            left.name_unit,
            left.name_node
        );
    let right_name: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            right.name_unit,
            right.name_node
        );
    var left_child: usize = left_name.first_child;
    var right_child: usize = right_name.first_child;
    let shared_count: usize =
        left_name.child_count < right_name.child_count ?
            left_name.child_count : right_name.child_count;
    var index: usize = 0;
    while (index < shared_count) {
        let left_component: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                left.name_unit,
                left_child
            );
        let right_component: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                right.name_unit,
                right_child
            );
        if (!bootstrap_semantic_tokens_equal(
                context,
                left.name_unit,
                left_component.token_index,
                right.name_unit,
                right_component.token_index
            )) {
            return bootstrap_semantic_token_is_before(
                context,
                left.name_unit,
                left_component.token_index,
                right.name_unit,
                right_component.token_index
            );
        }
        left_child = left_component.next_sibling;
        right_child = right_component.next_sibling;
        index += 1;
    }
    return left_name.child_count < right_name.child_count;
}

fn bootstrap_semantic_function_is_before(
    context: *BootstrapSemanticContext,
    left_function: usize,
    right_function: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let left: BootstrapSemanticSymbol =
        symbols[functions[left_function].symbol_id];
    let right: BootstrapSemanticSymbol =
        symbols[functions[right_function].symbol_id];
    if (left.module_id != right.module_id) {
        return bootstrap_semantic_module_name_is_before(
            context,
            left.module_id,
            right.module_id
        );
    }
    return bootstrap_semantic_token_is_before(
        context,
        left.declaration_unit,
        left.name_token,
        right.declaration_unit,
        right.name_token
    );
}

fn bootstrap_semantic_function_order_sift_down(
    context: *BootstrapSemanticContext,
    ordered: *usize,
    start: usize,
    count: usize
) -> bool {
    if (ordered == null || start >= count) {
        return false;
    }
    var root: usize = start;
    while (root < count / 2 &&
        context->error == RuntimeError.none) {
        let left_child: usize = root * 2 + 1;
        var selected: usize = root;
        if (bootstrap_semantic_function_is_before(
                context,
                ordered[selected],
                ordered[left_child]
            )) {
            selected = left_child;
        }
        let right_child: usize = left_child + 1;
        if (right_child < count &&
            bootstrap_semantic_function_is_before(
                context,
                ordered[selected],
                ordered[right_child]
            )) {
            selected = right_child;
        }
        if (selected == root) {
            return true;
        }
        let saved: usize = ordered[root];
        ordered[root] = ordered[selected];
        ordered[selected] = saved;
        root = selected;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_function_order(
    context: *BootstrapSemanticContext
) -> StdByteBuffer {
    var order: StdByteBuffer =
        std_byte_buffer_empty();
    var function_id: usize = 0;
    while (function_id < context->function_count &&
        context->error == RuntimeError.none) {
        let appended: StdByteBufferResult =
            std_byte_buffer_append(
                order,
                (&function_id) as *const usize as *const u8,
                sizeof(usize)
            );
        order = appended.buffer;
        context->error = appended.error;
        function_id += 1;
    }
    let ordered: *usize =
        order.data as *usize;
    var heap_index: usize =
        context->function_count / 2;
    while (heap_index != 0 &&
        context->error == RuntimeError.none) {
        heap_index -= 1;
        bootstrap_semantic_function_order_sift_down(
            context,
            ordered,
            heap_index,
            context->function_count
        );
    }
    var remaining: usize = context->function_count;
    while (remaining > 1 &&
        context->error == RuntimeError.none) {
        remaining -= 1;
        let saved: usize = ordered[0];
        ordered[0] = ordered[remaining];
        ordered[remaining] = saved;
        bootstrap_semantic_function_order_sift_down(
            context,
            ordered,
            0,
            remaining
        );
    }
    return order;
}

fn bootstrap_semantic_create_ir_functions(
    context: *BootstrapSemanticContext
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    let order: StdByteBuffer =
        bootstrap_semantic_function_order(context);
    let ordered: *const usize =
        order.data as *const usize;
    var order_index: usize = 0;
    while (order_index < context->function_count &&
        context->error == RuntimeError.none) {
        let function_id: usize = ordered[order_index];
        let ir_function: usize = bootstrap_ir_add_function(
            &context->ir,
            bootstrap_semantic_ir_function_record(
                context,
                function_id
            )
        );
        if (ir_function == none) {
            context->error = context->ir.error;
            break;
        }
        let functions: *BootstrapSemanticFunction =
            context->functions.data as
                *BootstrapSemanticFunction;
        functions[function_id].ir_function = ir_function;
        order_index += 1;
    }

    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    order_index = 0;
    while (order_index < context->function_count &&
        context->error == RuntimeError.none) {
        let function_id: usize = ordered[order_index];
        let function: BootstrapSemanticFunction =
            functions[function_id];
        var index: usize = 0;
        while (index < function.parameter_count) {
            let parameter: BootstrapSemanticParameter =
                parameters[function.first_parameter + index];
            if (bootstrap_ir_add_parameter(
                    &context->ir,
                    function.ir_function,
                    parameter.type_id,
                    parameter.name_token
                ) == none) {
                context->error = context->ir.error;
                break;
            }
            index += 1;
        }
        order_index += 1;
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(order);
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_invalid_expression()
    -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    return {
        type_id = none,
        value_id = none,
        address_id = none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = false,
    };
}

fn bootstrap_semantic_type_record(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> BootstrapTypeRecord {
    let result: BootstrapTypeRecordResult =
        bootstrap_type_table_get(context->types, type_id);
    if (result.error != RuntimeError.none) {
        context->error = result.error;
    }
    return result.record;
}

fn bootstrap_semantic_current_ir_function(
    context: *BootstrapSemanticContext
) -> usize {
    if (context->current_function >=
        context->function_count) {
        context->error = RuntimeError.invalid_argument;
        return bootstrap_semantic_no_id();
    }
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    return functions[context->current_function].ir_function;
}

fn bootstrap_semantic_instruction(
    opcode: BootstrapIrOpcode,
    node: BootstrapSyntaxNode
) -> BootstrapIrInstruction {
    let none: usize = bootstrap_semantic_no_id();
    return {
        opcode = opcode,
        operation = BootstrapTokenKind.invalid,
        type_id = none,
        result = none,
        left = none,
        right = none,
        third = none,
        auxiliary = none,
        immediate = 0,
        floating = 0.0,
        block_id = none,
        next_instruction = none,
        span = node.span,
    };
}

fn bootstrap_semantic_emit_value(
    context: *BootstrapSemanticContext,
    instruction: BootstrapIrInstruction,
    type_id: usize
) -> usize {
    let none: usize = bootstrap_semantic_no_id();
    if (context->error != RuntimeError.none ||
        context->current_block == none ||
        type_id == none) {
        return none;
    }
    let value_id: usize = bootstrap_ir_add_value(
        &context->ir,
        bootstrap_semantic_current_ir_function(context),
        context->current_block,
        type_id
    );
    if (value_id == none) {
        context->error = context->ir.error;
        return none;
    }
    var record: BootstrapIrInstruction = instruction;
    record.type_id = type_id;
    record.result = value_id;
    record.block_id = context->current_block;
    if (bootstrap_ir_emit(&context->ir, record) == none) {
        context->error = context->ir.error;
        return none;
    }
    return value_id;
}

fn bootstrap_semantic_emit_void(
    context: *BootstrapSemanticContext,
    instruction: BootstrapIrInstruction
) -> usize {
    var record: BootstrapIrInstruction = instruction;
    record.block_id = context->current_block;
    let instruction_id: usize =
        bootstrap_ir_emit(&context->ir, record);
    if (instruction_id == bootstrap_semantic_no_id()) {
        context->error = context->ir.error;
    }
    return instruction_id;
}

fn bootstrap_semantic_emit_integer_constant(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    type_id: usize,
    value: u64
) -> BootstrapSemanticExpression {
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.constant_integer,
            node
        );
    instruction.immediate = value;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = value,
        has_constant = true,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_emit_boolean_constant(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    value: bool
) -> BootstrapSemanticExpression {
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.constant_boolean,
            node
        );
    instruction.immediate = value ? 1 : 0;
    let type_id: usize =
        BootstrapBuiltinType.boolean as usize;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = instruction.immediate,
        has_constant = true,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_append_local(
    context: *BootstrapSemanticContext,
    local: BootstrapSemanticLocal
) -> usize {
    let result: usize = context->local_count;
    if (!bootstrap_semantic_append_record(
            context,
            &context->locals,
            (&local) as
                *const BootstrapSemanticLocal as *const u8,
            sizeof(BootstrapSemanticLocal)
        )) {
        return bootstrap_semantic_no_id();
    }
    context->local_count += 1;
    return result;
}

fn bootstrap_semantic_find_local(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_token: usize
) -> usize {
    let locals: *const BootstrapSemanticLocal =
        context->locals.data as
            *const BootstrapSemanticLocal;
    var index: usize = context->local_count;
    while (index != 0) {
        index -= 1;
        if (locals[index].function_id ==
                context->current_function &&
            locals[index].scope_depth <= context->scope_depth &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                locals[index].unit_index,
                locals[index].name_token
            )) {
            return index;
        }
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_local_in_current_scope(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    name_token: usize
) -> usize {
    let locals: *const BootstrapSemanticLocal =
        context->locals.data as
            *const BootstrapSemanticLocal;
    var index: usize = context->local_count;
    while (index != 0) {
        index -= 1;
        if (locals[index].function_id !=
            context->current_function) {
            break;
        }
        if (locals[index].scope_depth < context->scope_depth) {
            break;
        }
        if (locals[index].scope_depth == context->scope_depth &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                locals[index].unit_index,
                locals[index].name_token
            )) {
            return index;
        }
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_address_of_slot(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    slot_id: usize,
    value_type: usize,
    read_only: bool
) -> usize {
    let pointer: BootstrapTypeIdResult =
        bootstrap_type_table_pointer(
            &context->types,
            value_type,
            read_only
        );
    if (pointer.error != RuntimeError.none) {
        context->error = pointer.error;
        return bootstrap_semantic_no_id();
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.address_of_slot,
            node
        );
    instruction.auxiliary = slot_id;
    return bootstrap_semantic_emit_value(
        context,
        instruction,
        pointer.type_id
    );
}

fn bootstrap_semantic_load_lvalue(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expression: BootstrapSemanticExpression
) -> BootstrapSemanticExpression {
    if (!expression.valid || !expression.lvalue) {
        return expression;
    }
    let type_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            expression.type_id
        );
    if (bootstrap_type_is_memory(type_record.kind)) {
        return expression;
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.load_indirect,
            node
        );
    instruction.left = expression.address_id;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        expression.type_id
    );
    var result: BootstrapSemanticExpression = expression;
    result.value_id = value_id;
    result.valid =
        value_id != bootstrap_semantic_no_id();
    return result;
}

fn bootstrap_semantic_type_for_integer_literal(
    context: *BootstrapSemanticContext,
    expected_type: usize
) -> usize {
    if (expected_type < context->types.type_count) {
        let record: BootstrapTypeRecord =
            bootstrap_semantic_type_record(
                context,
                expected_type
            );
        if (bootstrap_type_is_integer(record.kind)) {
            return expected_type;
        }
    }
    return BootstrapBuiltinType.signed_32 as usize;
}

fn bootstrap_semantic_mask_integer(
    value: u64,
    bits: usize
) -> u64 {
    if (bits >= 64) {
        return value;
    }
    return value & (((1 as u64) << (bits as u64)) - 1);
}

fn bootstrap_semantic_lower_integer_literal(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize
) -> BootstrapSemanticExpression {
    var value: u64 = 0;
    let type_id: usize =
        bootstrap_semantic_type_for_integer_literal(
            context,
            expected_type
        );
    let kind: BootstrapTypeKind =
        bootstrap_semantic_type_record(
            context,
            type_id
        ).kind;
    if (!bootstrap_semantic_parse_unsigned(
            context,
            context->current_unit,
            node.token_index,
            &value
        ) ||
        !bootstrap_semantic_integer_fits_type(
            kind,
            value,
            false
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.integer_overflow,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    return bootstrap_semantic_emit_integer_constant(
        context,
        node,
        type_id,
        bootstrap_semantic_mask_integer(
            value,
            bootstrap_type_bit_width(kind)
        )
    );
}

fn bootstrap_semantic_lower_negative_integer_literal(
    context: *BootstrapSemanticContext,
    unary_node: BootstrapSyntaxNode,
    literal_node: BootstrapSyntaxNode,
    expected_type: usize
) -> BootstrapSemanticExpression {
    var magnitude: u64 = 0;
    let type_id: usize =
        bootstrap_semantic_type_for_integer_literal(
            context,
            expected_type
        );
    let kind: BootstrapTypeKind =
        bootstrap_semantic_type_record(
            context,
            type_id
        ).kind;
    if (!bootstrap_semantic_parse_unsigned(
            context,
            context->current_unit,
            literal_node.token_index,
            &magnitude
        ) ||
        !bootstrap_semantic_integer_fits_type(
            kind,
            magnitude,
            true
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.integer_overflow,
            context->current_unit,
            unary_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    return bootstrap_semantic_emit_integer_constant(
        context,
        unary_node,
        type_id,
        bootstrap_semantic_mask_integer(
            0 - magnitude,
            bootstrap_type_bit_width(kind)
        )
    );
}

fn bootstrap_semantic_big_set(
    value: *BootstrapSemanticBigUnsigned,
    small: u64
) -> bool {
    if (value == null) {
        return false;
    }
    value->count = small == 0 ? 0 : 1;
    value->limbs[0] = small;
    return true;
}

fn bootstrap_semantic_big_copy(
    destination: *BootstrapSemanticBigUnsigned,
    source: *const BootstrapSemanticBigUnsigned
) -> bool {
    if (destination == null || source == null ||
        source->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
        return false;
    }
    destination->count = source->count;
    var index: usize = 0;
    while (index < source->count) {
        destination->limbs[index] = source->limbs[index];
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_big_multiply_small(
    value: *BootstrapSemanticBigUnsigned,
    factor: u64
) -> bool {
    if (value == null || factor > 10 ||
        value->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
        return false;
    }
    if (factor == 0) {
        value->count = 0;
        return true;
    }
    let half_mask: u64 = 4294967295;
    var carry: u64 = 0;
    var index: usize = 0;
    while (index < value->count) {
        let limb: u64 = value->limbs[index];
        let lower_product: u64 =
            (limb & half_mask) * factor + carry;
        let upper_product: u64 =
            (limb >> 32) * factor +
                (lower_product >> 32);
        value->limbs[index] =
            (upper_product << 32) |
                (lower_product & half_mask);
        carry = upper_product >> 32;
        index += 1;
    }
    if (carry != 0) {
        if (value->count >=
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn bootstrap_semantic_big_add_small(
    value: *BootstrapSemanticBigUnsigned,
    small: u64
) -> bool {
    if (value == null || small > 9 ||
        value->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
        return false;
    }
    var carry: u64 = small;
    var index: usize = 0;
    while (carry != 0 && index < value->count) {
        let original: u64 = value->limbs[index];
        let sum: u64 = original + carry;
        value->limbs[index] = sum;
        carry = sum < original ? 1 : 0;
        index += 1;
    }
    if (carry != 0) {
        if (value->count >=
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn bootstrap_semantic_big_add(
    value: *BootstrapSemanticBigUnsigned,
    added: *const BootstrapSemanticBigUnsigned
) -> bool {
    if (value == null || added == null ||
        value->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize ||
        added->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
        return false;
    }
    let maximum_count: usize =
        value->count > added->count ?
            value->count : added->count;
    var carry: u64 = 0;
    var index: usize = 0;
    while (index < maximum_count) {
        let left: u64 =
            index < value->count ? value->limbs[index] : 0;
        let right: u64 =
            index < added->count ? added->limbs[index] : 0;
        let partial: u64 = left + right;
        let partial_overflow: bool = partial < left;
        let sum: u64 = partial + carry;
        let carry_overflow: bool = sum < partial;
        value->limbs[index] = sum;
        carry =
            partial_overflow || carry_overflow ? 1 : 0;
        index += 1;
    }
    value->count = maximum_count;
    if (carry != 0) {
        if (value->count >=
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn bootstrap_semantic_big_shift_left_one(
    value: *BootstrapSemanticBigUnsigned
) -> bool {
    if (value == null ||
        value->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
        return false;
    }
    var carry: u64 = 0;
    var index: usize = 0;
    while (index < value->count) {
        let limb: u64 = value->limbs[index];
        value->limbs[index] = (limb << 1) | carry;
        carry = limb >> 63;
        index += 1;
    }
    if (carry != 0) {
        if (value->count >=
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
            return false;
        }
        value->limbs[value->count] = carry;
        value->count += 1;
    }
    return true;
}

fn bootstrap_semantic_big_multiply_u64(
    source: *const BootstrapSemanticBigUnsigned,
    multiplier: u64,
    result: *BootstrapSemanticBigUnsigned
) -> bool {
    if (source == null || result == null ||
        !bootstrap_semantic_big_set(result, 0)) {
        return false;
    }
    if (multiplier == 0 || source->count == 0) {
        return true;
    }
    var addend: BootstrapSemanticBigUnsigned = {};
    if (!bootstrap_semantic_big_copy(&addend, source)) {
        return false;
    }
    var remaining: u64 = multiplier;
    while (remaining != 0) {
        if ((remaining & 1) != 0 &&
            !bootstrap_semantic_big_add(
                result,
                (&addend) as
                    *const BootstrapSemanticBigUnsigned
            )) {
            return false;
        }
        remaining >>= 1;
        if (remaining != 0 &&
            !bootstrap_semantic_big_shift_left_one(&addend)) {
            return false;
        }
    }
    return true;
}

fn bootstrap_semantic_big_bit_length(
    value: *const BootstrapSemanticBigUnsigned
) -> usize {
    if (value == null || value->count == 0 ||
        value->count >
            BootstrapSemanticLimit.maximum_floating_limbs as usize) {
        return 0;
    }
    var highest: u64 = value->limbs[value->count - 1];
    var highest_bits: usize = 0;
    while (highest != 0) {
        highest >>= 1;
        highest_bits += 1;
    }
    return (value->count - 1) * 64 + highest_bits;
}

fn bootstrap_semantic_big_bit(
    value: *const BootstrapSemanticBigUnsigned,
    bit_index: usize
) -> bool {
    if (value == null ||
        bit_index / 64 >= value->count) {
        return false;
    }
    return ((value->limbs[bit_index / 64] >>
        ((bit_index % 64) as u64)) & 1) != 0;
}

fn bootstrap_semantic_big_compare_scaled(
    left: *const BootstrapSemanticBigUnsigned,
    left_exponent: isize,
    right: *const BootstrapSemanticBigUnsigned,
    right_exponent: isize
) -> i32 {
    let left_length: usize =
        bootstrap_semantic_big_bit_length(left);
    let right_length: usize =
        bootstrap_semantic_big_bit_length(right);
    if (left_length == 0 || right_length == 0) {
        if (left_length == right_length) {
            return 0;
        }
        return left_length == 0 ? -1 : 1;
    }
    let left_top: isize =
        (left_length - 1) as isize + left_exponent;
    let right_top: isize =
        (right_length - 1) as isize + right_exponent;
    if (left_top != right_top) {
        return left_top < right_top ? -1 : 1;
    }
    let minimum_position: isize =
        left_exponent < right_exponent ?
            left_exponent : right_exponent;
    var position: isize = left_top;
    while (position >= minimum_position) {
        var left_bit: bool = false;
        if (position >= left_exponent) {
            left_bit = bootstrap_semantic_big_bit(
                left,
                (position - left_exponent) as usize
            );
        }
        var right_bit: bool = false;
        if (position >= right_exponent) {
            right_bit = bootstrap_semantic_big_bit(
                right,
                (position - right_exponent) as usize
            );
        }
        if (left_bit != right_bit) {
            return left_bit ? 1 : -1;
        }
        if (position == minimum_position) {
            break;
        }
        position -= 1;
    }
    return 0;
}

fn bootstrap_semantic_signed_add(
    left: *const BootstrapSemanticSignedMagnitude,
    right: *const BootstrapSemanticSignedMagnitude,
    limit: usize,
    result: *BootstrapSemanticSignedMagnitude
) -> bool {
    if (left == null || right == null || result == null ||
        left->magnitude > limit ||
        right->magnitude > limit) {
        return false;
    }
    if (left->magnitude == 0) {
        *result = {
            magnitude = right->magnitude,
            negative =
                right->magnitude != 0 && right->negative,
        };
        return true;
    }
    if (right->magnitude == 0) {
        *result = *left;
        return true;
    }
    if (left->negative == right->negative) {
        let magnitude: usize =
            left->magnitude > limit - right->magnitude ?
                limit : left->magnitude + right->magnitude;
        *result = {
            magnitude = magnitude,
            negative = left->negative,
        };
        return true;
    }
    if (left->magnitude >= right->magnitude) {
        let magnitude: usize =
            left->magnitude - right->magnitude;
        *result = {
            magnitude = magnitude,
            negative = magnitude != 0 && left->negative,
        };
        return true;
    }
    *result = {
        magnitude = right->magnitude - left->magnitude,
        negative = right->negative,
    };
    return true;
}

fn bootstrap_semantic_float_components(
    bits: u64,
    single: bool,
    significand: *u64,
    binary_exponent: *isize
) -> bool {
    if (significand == null || binary_exponent == null) {
        return false;
    }
    if (single) {
        let fraction: u64 = bits & 8388607;
        let exponent_field: u64 = (bits >> 23) & 255;
        *significand =
            exponent_field == 0 ?
                fraction : 8388608 + fraction;
        *binary_exponent =
            exponent_field == 0 ?
                -149 : exponent_field as isize - 150;
        return true;
    }
    let fraction: u64 = bits & 4503599627370495;
    let exponent_field: u64 = (bits >> 52) & 2047;
    *significand =
        exponent_field == 0 ?
            fraction : 4503599627370496 + fraction;
    *binary_exponent =
        exponent_field == 0 ?
            -1074 : exponent_field as isize - 1075;
    return true;
}

fn bootstrap_semantic_compare_decimal_dyadic(
    decimal: *const BootstrapSemanticDecimalFloating,
    significand: u64,
    binary_exponent: isize,
    result: *i32
) -> bool {
    var candidate: BootstrapSemanticBigUnsigned = {};
    if (decimal == null || result == null) {
        return false;
    }
    var comparison: i32 = 0;
    if (decimal->decimal_exponent >= 0) {
        if (!bootstrap_semantic_big_set(
                &candidate,
                significand
            )) {
            return false;
        }
        comparison = bootstrap_semantic_big_compare_scaled(
            &decimal->coefficient,
            decimal->decimal_exponent,
            (&candidate) as
                *const BootstrapSemanticBigUnsigned,
            binary_exponent
        );
    } else {
        if (!bootstrap_semantic_big_multiply_u64(
                &decimal->five_power,
                significand,
                &candidate
            )) {
            return false;
        }
        comparison = bootstrap_semantic_big_compare_scaled(
            &decimal->coefficient,
            0,
            (&candidate) as
                *const BootstrapSemanticBigUnsigned,
            binary_exponent -
                decimal->decimal_exponent
        );
    }
    if (comparison == 0 && decimal->truncated_nonzero) {
        comparison = 1;
    }
    *result = comparison;
    return true;
}

fn bootstrap_semantic_compare_decimal_float(
    decimal: *const BootstrapSemanticDecimalFloating,
    bits: u64,
    single: bool,
    result: *i32
) -> bool {
    var significand: u64 = 0;
    var binary_exponent: isize = 0;
    if (!bootstrap_semantic_float_components(
            bits,
            single,
            &significand,
            &binary_exponent
        )) {
        return false;
    }
    return bootstrap_semantic_compare_decimal_dyadic(
        decimal,
        significand,
        binary_exponent,
        result
    );
}

fn bootstrap_semantic_prepare_decimal_floating(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    single: bool,
    decimal: *BootstrapSemanticDecimalFloating,
    zero: *bool
) -> bool {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(
            context,
            context->current_unit
        );
    let token: BootstrapToken = bootstrap_semantic_token(
        context,
        context->current_unit,
        node.token_index
    );
    if (decimal == null || zero == null ||
        token.kind != BootstrapTokenKind.floating) {
        return false;
    }
    let maximum: usize = bootstrap_semantic_no_id();
    var exponent_limit: usize = maximum;
    if (token.span.length <=
        maximum -
            (BootstrapSemanticLimit.floating_exponent_margin as usize)) {
        exponent_limit = token.span.length +
            (BootstrapSemanticLimit.floating_exponent_margin as usize);
    }
    var coefficient: BootstrapSemanticBigUnsigned = {};
    var significant_digits: usize = 0;
    var kept_digits: usize = 0;
    var fractional_digits: usize = 0;
    var exponent_magnitude: usize = 0;
    var exponent_negative: bool = false;
    var truncated_nonzero: bool = false;
    var seen_nonzero: bool = false;
    var after_decimal: bool = false;
    var in_exponent: bool = false;
    var index: usize = 0;
    while (index < token.span.length) {
        let byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte == 95) {
            index += 1;
            continue;
        }
        if (byte == 46) {
            after_decimal = true;
            index += 1;
            continue;
        }
        if (byte == 101 || byte == 69) {
            in_exponent = true;
            index += 1;
            if (index < token.span.length) {
                let sign: u8 =
                    unit->source.data[token.span.offset + index];
                if (sign == 43 || sign == 45) {
                    exponent_negative = sign == 45;
                    index += 1;
                }
            }
            continue;
        }
        if (byte < 48 || byte > 57) {
            return false;
        }
        let digit: usize = (byte - 48) as usize;
        if (in_exponent) {
            if (exponent_magnitude >
                (exponent_limit - digit) / 10) {
                exponent_magnitude = exponent_limit;
            } else {
                exponent_magnitude =
                    exponent_magnitude * 10 + digit;
            }
            index += 1;
            continue;
        }
        if (after_decimal) {
            if (fractional_digits == maximum) {
                return false;
            }
            fractional_digits += 1;
        }
        if (!seen_nonzero && digit == 0) {
            index += 1;
            continue;
        }
        seen_nonzero = true;
        if (significant_digits == maximum) {
            return false;
        }
        significant_digits += 1;
        if (kept_digits <
            BootstrapSemanticLimit.maximum_floating_digits as usize) {
            if (!bootstrap_semantic_big_multiply_small(
                    &coefficient,
                    10
                ) ||
                !bootstrap_semantic_big_add_small(
                    &coefficient,
                    digit as u64
                )) {
                return false;
            }
            kept_digits += 1;
        } else if (digit != 0) {
            truncated_nonzero = true;
        }
        index += 1;
    }
    if (!seen_nonzero) {
        *zero = true;
        return true;
    }
    if (fractional_digits == maximum) {
        return false;
    }
    let fractional_with_unit: usize =
        fractional_digits + 1;
    let digit_adjustment: BootstrapSemanticSignedMagnitude =
        significant_digits >= fractional_with_unit ?
            {
                magnitude =
                    significant_digits - fractional_with_unit,
                negative = false,
            } :
            {
                magnitude =
                    fractional_with_unit - significant_digits,
                negative = true,
            };
    let explicit_exponent: BootstrapSemanticSignedMagnitude = {
        magnitude = exponent_magnitude,
        negative =
            exponent_magnitude != 0 && exponent_negative,
    };
    var adjusted: BootstrapSemanticSignedMagnitude = {};
    if (!bootstrap_semantic_signed_add(
            (&explicit_exponent) as
                *const BootstrapSemanticSignedMagnitude,
            (&digit_adjustment) as
                *const BootstrapSemanticSignedMagnitude,
            exponent_limit,
            &adjusted
        )) {
        return false;
    }
    let maximum_adjusted: usize = single ? 38 : 308;
    let minimum_adjusted_magnitude: usize =
        single ? 46 : 324;
    if (!adjusted.negative &&
        adjusted.magnitude > maximum_adjusted) {
        return false;
    }
    if (adjusted.negative &&
        adjusted.magnitude >
            minimum_adjusted_magnitude) {
        *zero = true;
        return true;
    }
    let adjusted_exponent: isize =
        adjusted.negative ?
            0 - adjusted.magnitude as isize :
            adjusted.magnitude as isize;
    decimal->coefficient = coefficient;
    decimal->decimal_exponent =
        adjusted_exponent - kept_digits as isize + 1;
    decimal->truncated_nonzero = truncated_nonzero;
    bootstrap_semantic_big_set(&decimal->five_power, 1);
    if (decimal->decimal_exponent >= 0) {
        var power: isize = decimal->decimal_exponent;
        while (power > 0) {
            if (!bootstrap_semantic_big_multiply_small(
                    &decimal->coefficient,
                    5
                )) {
                return false;
            }
            power -= 1;
        }
    } else {
        var power: isize =
            0 - decimal->decimal_exponent;
        while (power > 0) {
            if (!bootstrap_semantic_big_multiply_small(
                    &decimal->five_power,
                    5
                )) {
                return false;
            }
            power -= 1;
        }
    }
    *zero = false;
    return true;
}

fn bootstrap_semantic_parse_floating_bits(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    single: bool,
    bits: *u64
) -> bool {
    if (bits == null) {
        return false;
    }
    var decimal: BootstrapSemanticDecimalFloating = {};
    var zero: bool = false;
    if (!bootstrap_semantic_prepare_decimal_floating(
            context,
            node,
            single,
            &decimal,
            &zero
        )) {
        return false;
    }
    if (zero) {
        *bits = 0;
        return true;
    }
    let maximum_bits: u64 =
        single ? 2139095039 : 9218868437227405311;
    var lower: u64 = 0;
    var upper: u64 = maximum_bits;
    while (lower < upper) {
        let middle: u64 =
            lower + (upper - lower) / 2 + 1;
        var comparison: i32 = 0;
        if (!bootstrap_semantic_compare_decimal_float(
                (&decimal) as
                    *const BootstrapSemanticDecimalFloating,
                middle,
                single,
                &comparison
            )) {
            return false;
        }
        if (comparison >= 0) {
            lower = middle;
        } else {
            upper = middle - 1;
        }
    }
    var lower_significand: u64 = 0;
    var lower_exponent: isize = 0;
    if (!bootstrap_semantic_float_components(
            lower,
            single,
            &lower_significand,
            &lower_exponent
        )) {
        return false;
    }
    let midpoint_significand: u64 =
        lower_significand * 2 + 1;
    var midpoint_comparison: i32 = 0;
    if (!bootstrap_semantic_compare_decimal_dyadic(
            (&decimal) as
                *const BootstrapSemanticDecimalFloating,
            midpoint_significand,
            lower_exponent - 1,
            &midpoint_comparison
        )) {
        return false;
    }
    if (lower == maximum_bits) {
        if (midpoint_comparison >= 0) {
            return false;
        }
        *bits = lower;
        return true;
    }
    if (midpoint_comparison < 0 ||
        (midpoint_comparison == 0 &&
            (lower & 1) == 0)) {
        *bits = lower;
    } else {
        *bits = lower + 1;
    }
    return true;
}

fn bootstrap_semantic_parse_floating(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    single: bool,
    value: *f64
) -> bool {
    var bits: u64 = 0;
    if (value == null ||
        !bootstrap_semantic_parse_floating_bits(
            context,
            node,
            single,
            &bits
        )) {
        return false;
    }
    if (single) {
        let single_bits: u32 = bits as u32;
        *value =
            (*((&single_bits) as *const u32 as *const f32))
                as f64;
    } else {
        *value =
            *((&bits) as *const u64 as *const f64);
    }
    return true;
}

fn bootstrap_semantic_lower_floating_literal(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize
) -> BootstrapSemanticExpression {
    var type_id: usize =
        BootstrapBuiltinType.float_64 as usize;
    if (expected_type ==
        BootstrapBuiltinType.float_32 as usize ||
        expected_type ==
        BootstrapBuiltinType.float_64 as usize) {
        type_id = expected_type;
    }
    var value: f64 = 0.0;
    let single: bool =
        type_id == BootstrapBuiltinType.float_32 as usize;
    if (!bootstrap_semantic_parse_floating(
            context,
            node,
            single,
            &value
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.floating_overflow,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.constant_float,
            node
        );
    instruction.floating = value;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        type_id
    );
    return {
        type_id = type_id,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_decode_hex(byte: u8) -> usize {
    if (byte >= 48 && byte <= 57) {
        return (byte - 48) as usize;
    }
    if (byte >= 65 && byte <= 70) {
        return (byte - 65 + 10) as usize;
    }
    if (byte >= 97 && byte <= 102) {
        return (byte - 97 + 10) as usize;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_lower_string_literal(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(
            context,
            context->current_unit
        );
    let token: BootstrapToken = bootstrap_semantic_token(
        context,
        context->current_unit,
        node.token_index
    );
    var decoded: StdByteBuffer = std_byte_buffer_empty();
    var index: usize = 1;
    while (index + 1 < token.span.length &&
        context->error == RuntimeError.none) {
        var byte: u8 =
            unit->source.data[token.span.offset + index];
        if (byte == 92) {
            index += 1;
            byte = unit->source.data[token.span.offset + index];
            if (byte == 110) {
                byte = 10;
            } else if (byte == 114) {
                byte = 13;
            } else if (byte == 116) {
                byte = 9;
            } else if (byte == 48) {
                byte = 0;
            } else if (byte == 120) {
                let high: usize = bootstrap_semantic_decode_hex(
                    unit->source.data[
                        token.span.offset + index + 1
                    ]
                );
                let low: usize = bootstrap_semantic_decode_hex(
                    unit->source.data[
                        token.span.offset + index + 2
                    ]
                );
                byte = (high * 16 + low) as u8;
                index += 2;
            }
        }
        let pushed: StdByteBufferResult =
            std_byte_buffer_push(decoded, byte);
        decoded = pushed.buffer;
        context->error = pushed.error;
        index += 1;
    }
    if (context->error == RuntimeError.none) {
        let terminated: StdByteBufferResult =
            std_byte_buffer_push(decoded, 0);
        decoded = terminated.buffer;
        context->error = terminated.error;
    }
    let global_id: usize = context->error == RuntimeError.none ?
        bootstrap_ir_add_global(
            &context->ir,
            decoded.data as *const u8,
            decoded.length,
            1,
            true
        ) : bootstrap_semantic_no_id();
    let release_error: RuntimeError =
        std_byte_buffer_release(decoded);
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    if (global_id == bootstrap_semantic_no_id()) {
        if (context->error == RuntimeError.none) {
            context->error = context->ir.error;
        }
        return bootstrap_semantic_invalid_expression();
    }
    let pointer: BootstrapTypeIdResult =
        bootstrap_type_table_pointer(
            &context->types,
            BootstrapBuiltinType.unsigned_8 as usize,
            true
        );
    context->error = pointer.error;
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.global_address,
            node
        );
    instruction.auxiliary = global_id;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        pointer.type_id
    );
    return {
        type_id = pointer.type_id,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_find_field(
    context: *BootstrapSemanticContext,
    type_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (record.field_count == 0) {
        return bootstrap_semantic_no_id();
    }
    let fields: *const BootstrapTypeField =
        context->types.fields.data as
            *const BootstrapTypeField;
    var index: usize = 0;
    while (index < record.field_count) {
        let field_id: usize = record.first_field + index;
        if (bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                fields[field_id].declaration_unit,
                fields[field_id].name_token
            )) {
            return field_id;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_find_enum_member(
    context: *BootstrapSemanticContext,
    type_id: usize,
    unit_index: usize,
    name_token: usize
) -> usize {
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var index: usize = 0;
    while (index < context->symbol_count) {
        if (symbols[index].kind ==
                BootstrapSemanticSymbolKind.enum_member &&
            symbols[index].type_id == type_id &&
            bootstrap_semantic_tokens_equal(
                context,
                unit_index,
                name_token,
                symbols[index].declaration_unit,
                symbols[index].name_token
            )) {
            return index;
        }
        index += 1;
    }
    return bootstrap_semantic_no_id();
}

fn bootstrap_semantic_store_to_address(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    destination: usize,
    type_id: usize,
    value: BootstrapSemanticExpression
) -> bool {
    if (!value.valid || value.type_id != type_id ||
        destination == bootstrap_semantic_no_id()) {
        return false;
    }
    let type_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            bootstrap_type_is_memory(type_record.kind) ?
                BootstrapIrOpcode.memory_copy :
                BootstrapIrOpcode.store_indirect,
            node
        );
    instruction.left = destination;
    instruction.right = bootstrap_type_is_memory(
        type_record.kind
    ) ? value.address_id : value.value_id;
    instruction.type_id = type_id;
    instruction.auxiliary = type_record.size_bytes;
    return bootstrap_semantic_emit_void(
        context,
        instruction
    ) != bootstrap_semantic_no_id();
}

fn bootstrap_semantic_zero_slot(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    slot_id: usize,
    type_id: usize
) -> bool {
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.zero_slot,
            node
        );
    instruction.type_id = type_id;
    instruction.auxiliary = slot_id;
    return bootstrap_semantic_emit_void(
        context,
        instruction
    ) != bootstrap_semantic_no_id();
}

fn bootstrap_semantic_lower_scalar_zero_initializer(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize,
    type_record: BootstrapTypeRecord
) -> BootstrapSemanticExpression {
    if (type_record.kind == BootstrapTypeKind.boolean) {
        return bootstrap_semantic_emit_boolean_constant(
            context,
            node,
            false
        );
    }
    if (bootstrap_type_is_integer(type_record.kind) ||
        type_record.kind == BootstrapTypeKind.enumeration) {
        return bootstrap_semantic_emit_integer_constant(
            context,
            node,
            expected_type,
            0
        );
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.invalid,
            node
        );
    if (bootstrap_type_is_float(type_record.kind)) {
        instruction.opcode =
            BootstrapIrOpcode.constant_float;
        instruction.floating = 0.0;
    } else if (type_record.kind ==
        BootstrapTypeKind.pointer) {
        instruction.opcode =
            BootstrapIrOpcode.constant_null;
    } else {
        return bootstrap_semantic_invalid_expression();
    }
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        expected_type
    );
    return {
        type_id = expected_type,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_validate_initializer_fields(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize,
    type_record: BootstrapTypeRecord
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    var seen_fields: StdByteBuffer =
        std_byte_buffer_empty();
    var child: usize = node.first_child;
    var initializer_count: usize = 0;
    var valid: bool = true;
    while (child != none &&
        context->error == RuntimeError.none) {
        let initializer: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                child
            );
        let field_id: usize = bootstrap_semantic_find_field(
            context,
            expected_type,
            context->current_unit,
            initializer.token_index
        );
        if (field_id == none) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.unknown_field,
                context->current_unit,
                initializer.span,
                none,
                bootstrap_semantic_empty_span(),
                expected_type
            );
            valid = false;
        } else {
            let seen: *const usize =
                seen_fields.data as *const usize;
            var duplicate: bool = false;
            var seen_index: usize = 0;
            while (seen_index <
                seen_fields.length / sizeof(usize)) {
                if (seen[seen_index] == field_id) {
                    duplicate = true;
                    break;
                }
                seen_index += 1;
            }
            if (duplicate ||
                (type_record.kind ==
                    BootstrapTypeKind.record_union &&
                    initializer_count != 0)) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .duplicate_initializer_field,
                    context->current_unit,
                    initializer.span,
                    none,
                    bootstrap_semantic_empty_span(),
                    field_id
                );
                valid = false;
            } else {
                let appended: StdByteBufferResult =
                    std_byte_buffer_append(
                        seen_fields,
                        (&field_id) as
                            *const usize as *const u8,
                        sizeof(usize)
                    );
                seen_fields = appended.buffer;
                context->error = appended.error;
                initializer_count += 1;
            }
        }
        child = initializer.next_sibling;
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(seen_fields);
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    return valid && context->error == RuntimeError.none;
}

fn bootstrap_semantic_lower_initializer(
    context: *BootstrapSemanticContext,
    node_id: usize,
    expected_type: usize
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let node: BootstrapSyntaxNode = bootstrap_semantic_node(
        context,
        context->current_unit,
        node_id
    );
    let type_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            expected_type
        );
    if (node.kind ==
            BootstrapSyntaxKind.aggregate_initializer &&
        type_record.kind != BootstrapTypeKind.structure &&
        type_record.kind !=
            BootstrapTypeKind.record_union) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_initializer,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            expected_type
        );
        return bootstrap_semantic_invalid_expression();
    }
    if (node.kind ==
            BootstrapSyntaxKind.aggregate_initializer &&
        !bootstrap_semantic_validate_initializer_fields(
            context,
            node,
            expected_type,
            type_record
        )) {
        return bootstrap_semantic_invalid_expression();
    }
    if (!bootstrap_type_is_memory(type_record.kind)) {
        if (node.kind ==
            BootstrapSyntaxKind.zero_initializer) {
            let zero: BootstrapSemanticExpression =
                bootstrap_semantic_lower_scalar_zero_initializer(
                    context,
                    node,
                    expected_type,
                    type_record
                );
            if (zero.valid) {
                return zero;
            }
        }
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_initializer,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            expected_type
        );
        return bootstrap_semantic_invalid_expression();
    }
    let slot_id: usize = bootstrap_ir_add_slot(
        &context->ir,
        bootstrap_semantic_current_ir_function(context),
        expected_type,
        true
    );
    let address_id: usize = bootstrap_semantic_address_of_slot(
        context,
        node,
        slot_id,
        expected_type,
        false
    );
    if (slot_id == none || address_id == none ||
        !bootstrap_semantic_zero_slot(
            context,
            node,
            slot_id,
            expected_type
        )) {
        return bootstrap_semantic_invalid_expression();
    }
    if (node.kind ==
        BootstrapSyntaxKind.aggregate_initializer) {
        let fields: *const BootstrapTypeField =
            context->types.fields.data as
                *const BootstrapTypeField;
        var seen_fields: StdByteBuffer =
            std_byte_buffer_empty();
        var child: usize = node.first_child;
        var initializer_count: usize = 0;
        while (child != none &&
            context->error == RuntimeError.none) {
            let initializer: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    child
                );
            let field_id: usize = bootstrap_semantic_find_field(
                context,
                expected_type,
                context->current_unit,
                initializer.token_index
            );
            if (field_id == none) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind.unknown_field,
                    context->current_unit,
                    initializer.span,
                    none,
                    bootstrap_semantic_empty_span(),
                    expected_type
                );
            } else {
                let seen: *const usize =
                    seen_fields.data as *const usize;
                var duplicate: bool = false;
                var seen_index: usize = 0;
                while (seen_index <
                    seen_fields.length / sizeof(usize)) {
                    if (seen[seen_index] == field_id) {
                        duplicate = true;
                        break;
                    }
                    seen_index += 1;
                }
                if (duplicate ||
                    (type_record.kind ==
                        BootstrapTypeKind.record_union &&
                        initializer_count != 0)) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .duplicate_initializer_field,
                        context->current_unit,
                        initializer.span,
                        none,
                        bootstrap_semantic_empty_span(),
                        field_id
                    );
                } else if (initializer.child_count == 1) {
                    let added: StdByteBufferResult =
                        std_byte_buffer_append(
                            seen_fields,
                            (&field_id) as
                                *const usize as *const u8,
                            sizeof(usize)
                        );
                    seen_fields = added.buffer;
                    context->error = added.error;
                    let field: BootstrapTypeField =
                        fields[field_id];
                    let pointer: BootstrapTypeIdResult =
                        bootstrap_type_table_pointer(
                            &context->types,
                            field.type_id,
                            false
                        );
                    context->error = pointer.error;
                    var member_instruction:
                        BootstrapIrInstruction =
                        bootstrap_semantic_instruction(
                            BootstrapIrOpcode.member_address,
                            initializer
                        );
                    member_instruction.left = address_id;
                    member_instruction.auxiliary =
                        field.offset_bytes;
                    let field_address: usize =
                        bootstrap_semantic_emit_value(
                            context,
                            member_instruction,
                            pointer.type_id
                        );
                    let value: BootstrapSemanticExpression =
                        bootstrap_semantic_lower_expression(
                            context,
                            initializer.first_child,
                            field.type_id
                        );
                    if (value.type_id != field.type_id) {
                        bootstrap_semantic_add_diagnostic(
                            context,
                            BootstrapSemanticDiagnosticKind
                                .type_mismatch,
                            context->current_unit,
                            initializer.span,
                            none,
                            bootstrap_semantic_empty_span(),
                            field.type_id
                        );
                    } else {
                        bootstrap_semantic_store_to_address(
                            context,
                            initializer,
                            field_address,
                            field.type_id,
                            value
                        );
                    }
                    initializer_count += 1;
                }
            }
            child = initializer.next_sibling;
        }
        let release_error: RuntimeError =
            std_byte_buffer_release(seen_fields);
        if (context->error == RuntimeError.none) {
            context->error = release_error;
        }
    }
    return {
        type_id = expected_type,
        value_id = none,
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = address_id != none,
    };
}

fn bootstrap_semantic_lower_name(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    let local_id: usize = bootstrap_semantic_find_local(
        context,
        context->current_unit,
        node.token_index
    );
    if (local_id == bootstrap_semantic_no_id()) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.unknown_name,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            node.token_index
        );
        return bootstrap_semantic_invalid_expression();
    }
    let locals: *const BootstrapSemanticLocal =
        context->locals.data as
            *const BootstrapSemanticLocal;
    let local: BootstrapSemanticLocal = locals[local_id];
    let address_id: usize = bootstrap_semantic_address_of_slot(
        context,
        node,
        local.slot_id,
        local.type_id,
        !local.mutable_binding
    );
    let expression: BootstrapSemanticExpression = {
        type_id = local.type_id,
        value_id = bootstrap_semantic_no_id(),
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = local.mutable_binding,
        valid = address_id != bootstrap_semantic_no_id(),
    };
    return bootstrap_semantic_load_lvalue(
        context,
        node,
        expression
    );
}

fn bootstrap_semantic_lower_enum_member(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    if (node.child_count != 2) {
        return bootstrap_semantic_invalid_expression();
    }
    let owner_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let member_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            owner_node.next_sibling
        );
    if (owner_node.kind !=
            BootstrapSyntaxKind.name_expression ||
        member_node.kind !=
            BootstrapSyntaxKind.name_expression) {
        return bootstrap_semantic_invalid_expression();
    }
    let type_symbol: usize =
        bootstrap_semantic_lookup_symbol(
            context,
            context->current_unit,
            owner_node.token_index,
            BootstrapSemanticSymbolKind.named_type
        );
    if (type_symbol == bootstrap_semantic_no_id()) {
        return bootstrap_semantic_invalid_expression();
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let type_id: usize = symbols[type_symbol].type_id;
    if (bootstrap_semantic_type_record(
            context,
            type_id
        ).kind != BootstrapTypeKind.enumeration) {
        return bootstrap_semantic_invalid_expression();
    }
    let member_symbol: usize =
        bootstrap_semantic_find_enum_member(
            context,
            type_id,
            context->current_unit,
            member_node.token_index
        );
    if (member_symbol == bootstrap_semantic_no_id()) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.unknown_field,
            context->current_unit,
            member_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    return bootstrap_semantic_emit_integer_constant(
        context,
        node,
        type_id,
        symbols[member_symbol].integer_value
    );
}

fn bootstrap_semantic_lower_member(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    let enum_member: BootstrapSemanticExpression =
        bootstrap_semantic_lower_enum_member(context, node);
    if (enum_member.valid) {
        return enum_member;
    }
    if (node.child_count != 2) {
        return bootstrap_semantic_invalid_expression();
    }
    let base_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let name_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            base_node.next_sibling
        );
    let operation: BootstrapTokenKind =
        bootstrap_semantic_token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    let base: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            bootstrap_semantic_no_id()
        );
    if (!base.valid) {
        return base;
    }
    var owner_type: usize = base.type_id;
    var owner_address: usize = base.address_id;
    var mutable_lvalue: bool = base.mutable_lvalue;
    if (operation == BootstrapTokenKind.arrow) {
        let pointer_record: BootstrapTypeRecord =
            bootstrap_semantic_type_record(
                context,
                base.type_id
            );
        if (pointer_record.kind !=
            BootstrapTypeKind.pointer) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_member,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                base.type_id
            );
            return bootstrap_semantic_invalid_expression();
        }
        owner_type = pointer_record.element_type;
        owner_address = base.value_id;
        mutable_lvalue =
            (pointer_record.flags &
                (BootstrapTypeFlag.read_only as usize)) == 0;
        var check: BootstrapIrInstruction =
            bootstrap_semantic_instruction(
                BootstrapIrOpcode.null_check,
                node
            );
        check.left = owner_address;
        bootstrap_semantic_emit_void(context, check);
    } else if (operation != BootstrapTokenKind.dot ||
        base.address_id == bootstrap_semantic_no_id()) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_member,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            base.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    let owner_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, owner_type);
    if (owner_record.kind != BootstrapTypeKind.structure &&
        owner_record.kind != BootstrapTypeKind.record_union) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_member,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            owner_type
        );
        return bootstrap_semantic_invalid_expression();
    }
    let field_id: usize = bootstrap_semantic_find_field(
        context,
        owner_type,
        context->current_unit,
        name_node.token_index
    );
    if (field_id == bootstrap_semantic_no_id()) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.unknown_field,
            context->current_unit,
            name_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            owner_type
        );
        return bootstrap_semantic_invalid_expression();
    }
    let fields: *const BootstrapTypeField =
        context->types.fields.data as
            *const BootstrapTypeField;
    let field: BootstrapTypeField = fields[field_id];
    let pointer: BootstrapTypeIdResult =
        bootstrap_type_table_pointer(
            &context->types,
            field.type_id,
            !mutable_lvalue
        );
    context->error = pointer.error;
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.member_address,
            node
        );
    instruction.left = owner_address;
    instruction.auxiliary = field.offset_bytes;
    let address_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        pointer.type_id
    );
    let result: BootstrapSemanticExpression = {
        type_id = field.type_id,
        value_id = bootstrap_semantic_no_id(),
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = mutable_lvalue,
        valid = address_id != bootstrap_semantic_no_id(),
    };
    return bootstrap_semantic_load_lvalue(
        context,
        node,
        result
    );
}

fn bootstrap_semantic_lower_index(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    if (node.child_count != 2) {
        return bootstrap_semantic_invalid_expression();
    }
    let base_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let index_node: usize = base_node.next_sibling;
    let base: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            bootstrap_semantic_no_id()
        );
    let index: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            index_node,
            BootstrapBuiltinType.unsigned_size as usize
        );
    if (!base.valid || !index.valid ||
        index.type_id !=
            BootstrapBuiltinType.unsigned_size as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_index,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            index.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    let base_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            base.type_id
        );
    var element_type: usize = bootstrap_semantic_no_id();
    var base_address: usize = bootstrap_semantic_no_id();
    var mutable_lvalue: bool = false;
    if (base_record.kind == BootstrapTypeKind.array &&
        base.address_id != bootstrap_semantic_no_id()) {
        element_type = base_record.element_type;
        base_address = base.address_id;
        mutable_lvalue =
            base.lvalue && base.mutable_lvalue;
        let bound: BootstrapSemanticExpression =
            bootstrap_semantic_emit_integer_constant(
                context,
                node,
                BootstrapBuiltinType.unsigned_size as usize,
                base_record.element_count as u64
            );
        var check: BootstrapIrInstruction =
            bootstrap_semantic_instruction(
                BootstrapIrOpcode.bounds_check,
                node
            );
        check.left = index.value_id;
        check.right = bound.value_id;
        bootstrap_semantic_emit_void(context, check);
    } else if (base_record.kind ==
        BootstrapTypeKind.pointer) {
        element_type = base_record.element_type;
        base_address = base.value_id;
        mutable_lvalue =
            (base_record.flags &
                (BootstrapTypeFlag.read_only as usize)) == 0;
        if (bootstrap_semantic_type_record(
                context,
                element_type
            ).kind == BootstrapTypeKind.type_void) {
            element_type = bootstrap_semantic_no_id();
        } else {
            var check: BootstrapIrInstruction =
                bootstrap_semantic_instruction(
                    BootstrapIrOpcode.null_check,
                    node
                );
            check.left = base_address;
            bootstrap_semantic_emit_void(context, check);
        }
    }
    if (element_type == bootstrap_semantic_no_id()) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_index,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            base.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    let element_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            element_type
        );
    let pointer: BootstrapTypeIdResult =
        bootstrap_type_table_pointer(
            &context->types,
            element_type,
            !mutable_lvalue
        );
    context->error = pointer.error;
    var offset: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.pointer_offset,
            node
        );
    offset.left = base_address;
    offset.right = index.value_id;
    offset.auxiliary = element_record.size_bytes;
    let address_id: usize = bootstrap_semantic_emit_value(
        context,
        offset,
        pointer.type_id
    );
    let result: BootstrapSemanticExpression = {
        type_id = element_type,
        value_id = bootstrap_semantic_no_id(),
        address_id = address_id,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = mutable_lvalue,
        valid = address_id != bootstrap_semantic_no_id(),
    };
    return bootstrap_semantic_load_lvalue(
        context,
        node,
        result
    );
}

fn bootstrap_semantic_lower_call(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let symbol_id: usize = bootstrap_semantic_lookup_symbol(
        context,
        context->current_unit,
        node.token_index,
        BootstrapSemanticSymbolKind.function
    );
    if (symbol_id == none) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_call,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            node.token_index
        );
        return bootstrap_semantic_invalid_expression();
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let function_id: usize = symbols[symbol_id].function_id;
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    if (node.child_count != function.parameter_count) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.argument_count,
            context->current_unit,
            node.span,
            symbols[symbol_id].declaration_unit,
            bootstrap_semantic_node(
                context,
                symbols[symbol_id].declaration_unit,
                symbols[symbol_id].declaration_node
            ).span,
            function.parameter_count
        );
        return bootstrap_semantic_invalid_expression();
    }
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var argument_values: StdByteBuffer =
        std_byte_buffer_empty();
    var child: usize = node.first_child;
    var index: usize = 0;
    while (index < function.parameter_count &&
        context->error == RuntimeError.none) {
        let parameter: BootstrapSemanticParameter =
            parameters[function.first_parameter + index];
        let argument: BootstrapSemanticExpression =
            bootstrap_semantic_lower_expression(
                context,
                child,
                parameter.type_id
            );
        if (!argument.valid ||
            argument.type_id != parameter.type_id) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.type_mismatch,
                context->current_unit,
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    child
                ).span,
                parameter.unit_index,
                bootstrap_semantic_node(
                    context,
                    parameter.unit_index,
                    parameter.declaration_node
                ).span,
                parameter.type_id
            );
        } else {
            let argument_type: BootstrapTypeRecord =
                bootstrap_semantic_type_record(
                    context,
                    argument.type_id
                );
            var argument_value: usize = argument.value_id;
            if (bootstrap_type_is_memory(argument_type.kind)) {
                let snapshot_slot: usize = bootstrap_ir_add_slot(
                    &context->ir,
                    bootstrap_semantic_current_ir_function(context),
                    argument.type_id,
                    true
                );
                let snapshot_address: usize =
                    bootstrap_semantic_address_of_slot(
                        context,
                        bootstrap_semantic_node(
                            context,
                            context->current_unit,
                            child
                        ),
                        snapshot_slot,
                        argument.type_id,
                        false
                    );
                if (snapshot_slot == none ||
                    snapshot_address == none ||
                    !bootstrap_semantic_store_to_address(
                        context,
                        bootstrap_semantic_node(
                            context,
                            context->current_unit,
                            child
                        ),
                        snapshot_address,
                        argument.type_id,
                        argument
                    )) {
                    context->error =
                        RuntimeError.invalid_argument;
                }
                argument_value = snapshot_address;
            }
            let appended: StdByteBufferResult =
                std_byte_buffer_append(
                    argument_values,
                    (&argument_value) as
                        *const usize as *const u8,
                    sizeof(usize)
                );
            argument_values = appended.buffer;
            context->error = appended.error;
        }
        child = bootstrap_semantic_node(
            context,
            context->current_unit,
            child
        ).next_sibling;
        index += 1;
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.call,
            node
        );
    instruction.auxiliary = function.ir_function;
    let return_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            function.return_type
        );
    let has_result: bool =
        return_record.kind != BootstrapTypeKind.type_void;
    var result_value: usize = none;
    var instruction_id: usize = none;
    if (has_result) {
        result_value = bootstrap_semantic_emit_value(
            context,
            instruction,
            function.return_type
        );
        if (result_value != none) {
            let values: *const BootstrapIrValue =
                context->ir.values.data as
                    *const BootstrapIrValue;
            instruction_id =
                values[result_value].definition;
        }
    } else {
        instruction.type_id = function.return_type;
        instruction_id =
            bootstrap_semantic_emit_void(
                context,
                instruction
            );
    }
    let arguments: *const usize =
        argument_values.data as *const usize;
    index = 0;
    while (index <
        argument_values.length / sizeof(usize)) {
        bootstrap_ir_add_argument(
            &context->ir,
            instruction_id,
            arguments[index]
        );
        index += 1;
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(argument_values);
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    return {
        type_id = function.return_type,
        value_id = bootstrap_type_is_memory(return_record.kind) ?
            none : result_value,
        address_id =
            bootstrap_type_is_memory(return_record.kind) ?
                result_value : none,
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = instruction_id != none,
    };
}

fn bootstrap_semantic_lower_unary(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize
) -> BootstrapSemanticExpression {
    if (node.child_count != 1) {
        return bootstrap_semantic_invalid_expression();
    }
    let operation: BootstrapTokenKind =
        bootstrap_semantic_token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    let operand_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let expected_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            bootstrap_semantic_type_for_integer_literal(
                context,
                expected_type
            )
        );
    if (operation == BootstrapTokenKind.minus &&
        operand_node.kind ==
            BootstrapSyntaxKind.integer_expression &&
        bootstrap_type_is_signed_integer(
            expected_record.kind
        )) {
        return bootstrap_semantic_lower_negative_integer_literal(
            context,
            node,
            operand_node,
            expected_type
        );
    }
    let operand: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            expected_type
        );
    if (!operand.valid) {
        return operand;
    }
    let operand_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            operand.type_id
        );
    if (operation == BootstrapTokenKind.ampersand) {
        if (!operand.lvalue) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_lvalue,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                operand.type_id
            );
            return bootstrap_semantic_invalid_expression();
        }
        let pointer: BootstrapTypeIdResult =
            bootstrap_type_table_pointer(
                &context->types,
                operand.type_id,
                !operand.mutable_lvalue
            );
        context->error = pointer.error;
        var result: BootstrapSemanticExpression = operand;
        result.type_id = pointer.type_id;
        result.value_id = operand.address_id;
        result.address_id = bootstrap_semantic_no_id();
        result.lvalue = false;
        result.mutable_lvalue = false;
        return result;
    }
    if (operation == BootstrapTokenKind.star) {
        if (operand_record.kind !=
                BootstrapTypeKind.pointer ||
            bootstrap_semantic_type_record(
                context,
                operand_record.element_type
            ).kind == BootstrapTypeKind.type_void) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_operator,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                operand.type_id
            );
            return bootstrap_semantic_invalid_expression();
        }
        var check: BootstrapIrInstruction =
            bootstrap_semantic_instruction(
                BootstrapIrOpcode.null_check,
                node
            );
        check.left = operand.value_id;
        bootstrap_semantic_emit_void(context, check);
        let result: BootstrapSemanticExpression = {
            type_id = operand_record.element_type,
            value_id = bootstrap_semantic_no_id(),
            address_id = operand.value_id,
            constant_value = 0,
            has_constant = false,
            lvalue = true,
            mutable_lvalue =
                (operand_record.flags &
                    (BootstrapTypeFlag.read_only as usize)) == 0,
            valid = true,
        };
        return bootstrap_semantic_load_lvalue(
            context,
            node,
            result
        );
    }
    if (operation == BootstrapTokenKind.plus) {
        if (!bootstrap_type_is_integer(operand_record.kind) &&
            !bootstrap_type_is_float(operand_record.kind)) {
            return bootstrap_semantic_invalid_expression();
        }
        return operand;
    }
    var opcode: BootstrapIrOpcode =
        BootstrapIrOpcode.invalid;
    if (operation == BootstrapTokenKind.minus &&
        bootstrap_type_is_integer(operand_record.kind)) {
        opcode = BootstrapIrOpcode.unary_integer;
    } else if (operation == BootstrapTokenKind.minus &&
        bootstrap_type_is_float(operand_record.kind)) {
        opcode = BootstrapIrOpcode.unary_float;
    } else if (operation == BootstrapTokenKind.tilde &&
        bootstrap_type_is_integer(operand_record.kind)) {
        opcode = BootstrapIrOpcode.unary_integer;
    } else if (operation == BootstrapTokenKind.bang &&
        operand_record.kind == BootstrapTypeKind.boolean) {
        opcode = BootstrapIrOpcode.boolean_not;
    }
    if (opcode == BootstrapIrOpcode.invalid) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_operator,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            operand.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(opcode, node);
    instruction.operation = operation;
    instruction.left = operand.value_id;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        operand.type_id
    );
    var constant_value: u64 = 0;
    var has_constant: bool = false;
    if (operand.has_constant) {
        if (operation == BootstrapTokenKind.minus &&
            bootstrap_type_is_integer(operand_record.kind)) {
            constant_value = bootstrap_semantic_mask_integer(
                0 - operand.constant_value,
                bootstrap_type_bit_width(operand_record.kind)
            );
            has_constant = true;
        } else if (operation == BootstrapTokenKind.tilde) {
            constant_value = bootstrap_semantic_mask_integer(
                ~operand.constant_value,
                bootstrap_type_bit_width(operand_record.kind)
            );
            has_constant = true;
        } else if (operation == BootstrapTokenKind.bang) {
            constant_value =
                operand.constant_value == 0 ? 1 : 0;
            has_constant = true;
        }
    }
    return {
        type_id = operand.type_id,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = constant_value,
        has_constant = has_constant,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_cast_is_valid(
    source: BootstrapTypeRecord,
    target: BootstrapTypeRecord,
    source_type: usize,
    target_type: usize
) -> bool {
    if (source_type == target_type) {
        return true;
    }
    if (bootstrap_type_is_integer(source.kind) &&
        bootstrap_type_is_integer(target.kind)) {
        return true;
    }
    if ((bootstrap_type_is_integer(source.kind) &&
            bootstrap_type_is_float(target.kind)) ||
        (bootstrap_type_is_float(source.kind) &&
            bootstrap_type_is_integer(target.kind)) ||
        (bootstrap_type_is_float(source.kind) &&
            bootstrap_type_is_float(target.kind))) {
        return true;
    }
    if (source.kind == BootstrapTypeKind.enumeration) {
        return source.element_type == target_type;
    }
    if (target.kind == BootstrapTypeKind.enumeration) {
        return target.element_type == source_type;
    }
    if (source.kind == BootstrapTypeKind.pointer &&
        target.kind == BootstrapTypeKind.pointer) {
        return (source.flags &
            (BootstrapTypeFlag.read_only as usize)) == 0 ||
            (target.flags &
                (BootstrapTypeFlag.read_only as usize)) != 0;
    }
    if (source.kind == BootstrapTypeKind.pointer) {
        return target.kind ==
            BootstrapTypeKind.unsigned_size;
    }
    if (target.kind == BootstrapTypeKind.pointer) {
        return source.kind ==
            BootstrapTypeKind.unsigned_size;
    }
    return false;
}

fn bootstrap_semantic_default_literal_family(
    context: *BootstrapSemanticContext,
    node_id: usize
) -> BootstrapSemanticLiteralFamily {
    let node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind ==
        BootstrapSyntaxKind.integer_expression) {
        return BootstrapSemanticLiteralFamily.integer;
    }
    if (node.kind ==
        BootstrapSyntaxKind.floating_expression) {
        return BootstrapSemanticLiteralFamily.floating;
    }
    if (node.kind == BootstrapSyntaxKind.null_expression) {
        return BootstrapSemanticLiteralFamily.null_pointer;
    }
    if (node.kind == BootstrapSyntaxKind.unary_expression &&
        node.child_count == 1) {
        let operation: BootstrapTokenKind =
            bootstrap_semantic_token(
                context,
                context->current_unit,
                node.token_index
            ).kind;
        if (operation == BootstrapTokenKind.plus ||
            operation == BootstrapTokenKind.minus) {
            return bootstrap_semantic_default_literal_family(
                context,
                node.first_child
            );
        }
        return BootstrapSemanticLiteralFamily.none;
    }
    if (node.kind == BootstrapSyntaxKind.binary_expression &&
        node.child_count == 2) {
        let left: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            );
        let left_family: BootstrapSemanticLiteralFamily =
            bootstrap_semantic_default_literal_family(
                context,
                node.first_child
            );
        let right_family: BootstrapSemanticLiteralFamily =
            bootstrap_semantic_default_literal_family(
                context,
                left.next_sibling
            );
        if (left_family ==
                BootstrapSemanticLiteralFamily.floating ||
            right_family ==
                BootstrapSemanticLiteralFamily.floating) {
            if ((left_family ==
                    BootstrapSemanticLiteralFamily.integer ||
                    left_family ==
                        BootstrapSemanticLiteralFamily.floating) &&
                (right_family ==
                    BootstrapSemanticLiteralFamily.integer ||
                    right_family ==
                        BootstrapSemanticLiteralFamily.floating)) {
                return BootstrapSemanticLiteralFamily.floating;
            }
            return BootstrapSemanticLiteralFamily.none;
        }
        return left_family ==
                BootstrapSemanticLiteralFamily.integer &&
            right_family ==
                BootstrapSemanticLiteralFamily.integer ?
            BootstrapSemanticLiteralFamily.integer :
            BootstrapSemanticLiteralFamily.none;
    }
    if (node.kind ==
            BootstrapSyntaxKind.conditional_expression &&
        node.child_count == 3) {
        let condition: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            );
        let then_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                condition.next_sibling
            );
        let then_family: BootstrapSemanticLiteralFamily =
            bootstrap_semantic_default_literal_family(
                context,
                condition.next_sibling
            );
        let else_family: BootstrapSemanticLiteralFamily =
            bootstrap_semantic_default_literal_family(
                context,
                then_node.next_sibling
            );
        return then_family == else_family ?
            then_family : BootstrapSemanticLiteralFamily.none;
    }
    return BootstrapSemanticLiteralFamily.none;
}

fn bootstrap_semantic_lower_cast(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    if (node.child_count != 2) {
        return bootstrap_semantic_invalid_expression();
    }
    let operand_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let target_node: usize = operand_node.next_sibling;
    let target_type: usize =
        bootstrap_semantic_resolve_type_node(
            context,
            context->current_unit,
            target_node
        );
    if (target_type == bootstrap_semantic_no_id()) {
        return bootstrap_semantic_invalid_expression();
    }
    let target_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            target_type
        );
    let target_storage: usize =
        target_record.kind ==
            BootstrapTypeKind.enumeration ?
            target_record.element_type : target_type;
    let target_storage_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            target_storage
        );
    let literal_family: BootstrapSemanticLiteralFamily =
        bootstrap_semantic_default_literal_family(
            context,
            node.first_child
        );
    var operand_expected: usize =
        bootstrap_semantic_no_id();
    if (literal_family ==
            BootstrapSemanticLiteralFamily.integer &&
        bootstrap_type_is_integer(
            target_storage_record.kind
        )) {
        operand_expected = target_storage;
    } else if (literal_family ==
            BootstrapSemanticLiteralFamily.floating &&
        bootstrap_type_is_float(target_record.kind)) {
        operand_expected = target_type;
    } else if (literal_family ==
            BootstrapSemanticLiteralFamily.null_pointer &&
        target_record.kind == BootstrapTypeKind.pointer) {
        operand_expected = target_type;
    }
    let operand: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            operand_expected
        );
    if (!operand.valid) {
        return bootstrap_semantic_invalid_expression();
    }
    let source_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            operand.type_id
        );
    if (!bootstrap_semantic_cast_is_valid(
            source_record,
            target_record,
            operand.type_id,
            target_type
        )) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_cast,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            target_type
        );
        return bootstrap_semantic_invalid_expression();
    }
    if (target_type == operand.type_id) {
        return operand;
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.convert,
            node
        );
    instruction.left = operand.value_id;
    instruction.auxiliary = operand.type_id;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        target_type
    );
    return {
        type_id = target_type,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_binary_is_comparison(
    operation: BootstrapTokenKind
) -> bool {
    return operation == BootstrapTokenKind.equal_equal ||
        operation == BootstrapTokenKind.bang_equal ||
        operation == BootstrapTokenKind.less ||
        operation == BootstrapTokenKind.less_equal ||
        operation == BootstrapTokenKind.greater ||
        operation == BootstrapTokenKind.greater_equal;
}

fn bootstrap_semantic_binary_is_arithmetic(
    operation: BootstrapTokenKind
) -> bool {
    return operation == BootstrapTokenKind.plus ||
        operation == BootstrapTokenKind.minus ||
        operation == BootstrapTokenKind.star ||
        operation == BootstrapTokenKind.slash ||
        operation == BootstrapTokenKind.percent;
}

fn bootstrap_semantic_binary_is_bitwise(
    operation: BootstrapTokenKind
) -> bool {
    return operation == BootstrapTokenKind.ampersand ||
        operation == BootstrapTokenKind.pipe ||
        operation == BootstrapTokenKind.caret ||
        operation == BootstrapTokenKind.shift_left ||
        operation == BootstrapTokenKind.shift_right;
}

fn bootstrap_semantic_emit_jump(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    target_block: usize
) -> bool {
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.jump,
            node
        );
    instruction.auxiliary = target_block;
    return bootstrap_semantic_emit_void(
        context,
        instruction
    ) != bootstrap_semantic_no_id();
}

fn bootstrap_semantic_emit_branch(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    condition: usize,
    true_block: usize,
    false_block: usize
) -> bool {
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            BootstrapIrOpcode.branch,
            node
        );
    instruction.left = condition;
    instruction.auxiliary = true_block;
    instruction.third = false_block;
    return bootstrap_semantic_emit_void(
        context,
        instruction
    ) != bootstrap_semantic_no_id();
}

fn bootstrap_semantic_add_current_block(
    context: *BootstrapSemanticContext
) -> usize {
    let block_id: usize = bootstrap_ir_add_block(
        &context->ir,
        bootstrap_semantic_current_ir_function(context)
    );
    if (block_id == bootstrap_semantic_no_id()) {
        context->error = context->ir.error;
    }
    return block_id;
}

fn bootstrap_semantic_lower_short_circuit(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    operation: BootstrapTokenKind
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    let left_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let left: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            BootstrapBuiltinType.boolean as usize
        );
    if (!left.valid ||
        left.type_id != BootstrapBuiltinType.boolean as usize) {
        return bootstrap_semantic_invalid_expression();
    }
    let slot_id: usize = bootstrap_ir_add_slot(
        &context->ir,
        bootstrap_semantic_current_ir_function(context),
        BootstrapBuiltinType.boolean as usize,
        true
    );
    let address: usize = bootstrap_semantic_address_of_slot(
        context,
        node,
        slot_id,
        BootstrapBuiltinType.boolean as usize,
        false
    );
    bootstrap_semantic_store_to_address(
        context,
        node,
        address,
        BootstrapBuiltinType.boolean as usize,
        left
    );
    let right_block: usize =
        bootstrap_semantic_add_current_block(context);
    let merge_block: usize =
        bootstrap_semantic_add_current_block(context);
    if (operation == BootstrapTokenKind.logical_and) {
        bootstrap_semantic_emit_branch(
            context,
            node,
            left.value_id,
            right_block,
            merge_block
        );
    } else {
        bootstrap_semantic_emit_branch(
            context,
            node,
            left.value_id,
            merge_block,
            right_block
        );
    }
    context->current_block = right_block;
    let right: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            left_node.next_sibling,
            BootstrapBuiltinType.boolean as usize
        );
    if (!right.valid ||
        right.type_id != BootstrapBuiltinType.boolean as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            BootstrapBuiltinType.boolean as usize
        );
        return bootstrap_semantic_invalid_expression();
    }
    bootstrap_semantic_store_to_address(
        context,
        node,
        address,
        BootstrapBuiltinType.boolean as usize,
        right
    );
    bootstrap_semantic_emit_jump(
        context,
        node,
        merge_block
    );
    context->current_block = merge_block;
    let source: BootstrapSemanticExpression = {
        type_id = BootstrapBuiltinType.boolean as usize,
        value_id = none,
        address_id = address,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = false,
        valid = true,
    };
    let result: BootstrapSemanticExpression =
        bootstrap_semantic_load_lvalue(
            context,
            node,
            source
        );
    var final_result: BootstrapSemanticExpression = result;
    final_result.lvalue = false;
    return final_result;
}

fn bootstrap_semantic_lower_binary(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize
) -> BootstrapSemanticExpression {
    if (node.child_count != 2) {
        return bootstrap_semantic_invalid_expression();
    }
    let left_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let operation: BootstrapTokenKind =
        bootstrap_semantic_token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    if (operation == BootstrapTokenKind.logical_and ||
        operation == BootstrapTokenKind.logical_or) {
        return bootstrap_semantic_lower_short_circuit(
            context,
            node,
            operation
        );
    }
    let operand_expected: usize =
        bootstrap_semantic_binary_is_comparison(operation) ?
            bootstrap_semantic_no_id() : expected_type;
    let left: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            operand_expected
        );
    let right: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            left_node.next_sibling,
            left.valid ? left.type_id : operand_expected
        );
    if (!left.valid || !right.valid ||
        left.type_id != right.type_id) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            left.valid ? left.type_id : right.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    let type_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            left.type_id
        );
    var opcode: BootstrapIrOpcode =
        BootstrapIrOpcode.invalid;
    var result_type: usize = left.type_id;
    if (bootstrap_semantic_binary_is_comparison(operation)) {
        let equality: bool =
            operation == BootstrapTokenKind.equal_equal ||
            operation == BootstrapTokenKind.bang_equal;
        if ((equality &&
                bootstrap_type_is_scalar(type_record.kind)) ||
            (!equality &&
                (bootstrap_type_is_integer(type_record.kind) ||
                    bootstrap_type_is_float(type_record.kind)))) {
            opcode = BootstrapIrOpcode.compare;
            result_type =
                BootstrapBuiltinType.boolean as usize;
        }
    } else if (bootstrap_semantic_binary_is_arithmetic(
            operation
        )) {
        if (bootstrap_type_is_integer(type_record.kind)) {
            opcode = BootstrapIrOpcode.binary_integer;
        } else if (bootstrap_type_is_float(type_record.kind) &&
            operation != BootstrapTokenKind.percent) {
            opcode = BootstrapIrOpcode.binary_float;
        }
    } else if (bootstrap_semantic_binary_is_bitwise(
            operation
        ) && bootstrap_type_is_integer(type_record.kind)) {
        opcode = BootstrapIrOpcode.binary_integer;
    }
    if (opcode == BootstrapIrOpcode.invalid) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_operator,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            left.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(opcode, node);
    instruction.operation = operation;
    instruction.left = left.value_id;
    instruction.right = right.value_id;
    let value_id: usize = bootstrap_semantic_emit_value(
        context,
        instruction,
        result_type
    );
    return {
        type_id = result_type,
        value_id = value_id,
        address_id = bootstrap_semantic_no_id(),
        constant_value = 0,
        has_constant = false,
        lvalue = false,
        mutable_lvalue = false,
        valid = value_id != bootstrap_semantic_no_id(),
    };
}

fn bootstrap_semantic_lower_conditional(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode,
    expected_type: usize
) -> BootstrapSemanticExpression {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count != 3) {
        return bootstrap_semantic_invalid_expression();
    }
    let condition_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let then_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            condition_node.next_sibling
        );
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            BootstrapBuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            BootstrapBuiltinType.boolean as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_condition,
            context->current_unit,
            condition_node.span,
            none,
            bootstrap_semantic_empty_span(),
            condition.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    let then_block: usize =
        bootstrap_semantic_add_current_block(context);
    let else_block: usize =
        bootstrap_semantic_add_current_block(context);
    let merge_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        then_block,
        else_block
    );
    context->current_block = then_block;
    let then_value: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            condition_node.next_sibling,
            expected_type
        );
    if (!then_value.valid) {
        return then_value;
    }
    let result_slot: usize = bootstrap_ir_add_slot(
        &context->ir,
        bootstrap_semantic_current_ir_function(context),
        then_value.type_id,
        true
    );
    let then_address: usize =
        bootstrap_semantic_address_of_slot(
            context,
            node,
            result_slot,
            then_value.type_id,
            false
        );
    bootstrap_semantic_store_to_address(
        context,
        node,
        then_address,
        then_value.type_id,
        then_value
    );
    bootstrap_semantic_emit_jump(
        context,
        node,
        merge_block
    );
    context->current_block = else_block;
    let else_value: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            then_node.next_sibling,
            then_value.type_id
        );
    if (!else_value.valid ||
        else_value.type_id != then_value.type_id) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            then_value.type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    let else_address: usize =
        bootstrap_semantic_address_of_slot(
            context,
            node,
            result_slot,
            then_value.type_id,
            false
        );
    bootstrap_semantic_store_to_address(
        context,
        node,
        else_address,
        then_value.type_id,
        else_value
    );
    bootstrap_semantic_emit_jump(
        context,
        node,
        merge_block
    );
    context->current_block = merge_block;
    let result_address: usize =
        bootstrap_semantic_address_of_slot(
            context,
            node,
            result_slot,
            then_value.type_id,
            false
        );
    let type_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            then_value.type_id
        );
    if (bootstrap_type_is_memory(type_record.kind)) {
        return {
            type_id = then_value.type_id,
            value_id = none,
            address_id = result_address,
            constant_value = 0,
            has_constant = false,
            lvalue = false,
            mutable_lvalue = false,
            valid = true,
        };
    }
    let source: BootstrapSemanticExpression = {
        type_id = then_value.type_id,
        value_id = none,
        address_id = result_address,
        constant_value = 0,
        has_constant = false,
        lvalue = true,
        mutable_lvalue = false,
        valid = true,
    };
    let result: BootstrapSemanticExpression =
        bootstrap_semantic_load_lvalue(
            context,
            node,
            source
        );
    var final_result: BootstrapSemanticExpression = result;
    final_result.lvalue = false;
    return final_result;
}

fn bootstrap_semantic_lower_layout_query(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> BootstrapSemanticExpression {
    if (node.child_count == 0) {
        return bootstrap_semantic_invalid_expression();
    }
    let type_id: usize =
        bootstrap_semantic_resolve_type_node(
            context,
            context->current_unit,
            node.first_child
        );
    if (type_id == bootstrap_semantic_no_id() ||
        !bootstrap_semantic_require_complete_type(
            context,
            type_id
        )) {
        return bootstrap_semantic_invalid_expression();
    }
    let record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (record.kind == BootstrapTypeKind.type_void ||
        record.size_bytes == 0 ||
        record.alignment_bytes == 0) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_layout_query,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            type_id
        );
        return bootstrap_semantic_invalid_expression();
    }
    var value: usize = 0;
    if (node.kind == BootstrapSyntaxKind.sizeof_expression) {
        value = record.size_bytes;
    } else if (node.kind ==
        BootstrapSyntaxKind.alignof_expression) {
        value = record.alignment_bytes;
    } else if (node.kind ==
        BootstrapSyntaxKind.offsetof_expression &&
        node.child_count == 2) {
        let type_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                node.first_child
            );
        let member: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                type_node.next_sibling
            );
        let field_id: usize = bootstrap_semantic_find_field(
            context,
            type_id,
            context->current_unit,
            member.token_index
        );
        if (field_id == bootstrap_semantic_no_id()) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .invalid_layout_query,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                type_id
            );
            return bootstrap_semantic_invalid_expression();
        }
        let fields: *const BootstrapTypeField =
            context->types.fields.data as
                *const BootstrapTypeField;
        value = fields[field_id].offset_bytes;
    } else {
        return bootstrap_semantic_invalid_expression();
    }
    return bootstrap_semantic_emit_integer_constant(
        context,
        node,
        BootstrapBuiltinType.unsigned_size as usize,
        value as u64
    );
}

fn bootstrap_semantic_lower_expression(
    context: *BootstrapSemanticContext,
    node_id: usize,
    expected_type: usize
) -> BootstrapSemanticExpression {
    let node: BootstrapSyntaxNode = bootstrap_semantic_node(
        context,
        context->current_unit,
        node_id
    );
    if (node.kind ==
        BootstrapSyntaxKind.integer_expression) {
        return bootstrap_semantic_lower_integer_literal(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.floating_expression) {
        return bootstrap_semantic_lower_floating_literal(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.boolean_expression) {
        return bootstrap_semantic_emit_boolean_constant(
            context,
            node,
            bootstrap_semantic_token(
                context,
                context->current_unit,
                node.token_index
            ).kind == BootstrapTokenKind.keyword_true
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.string_expression) {
        return bootstrap_semantic_lower_string_literal(
            context,
            node
        );
    }
    if (node.kind == BootstrapSyntaxKind.null_expression) {
        if (expected_type >= context->types.type_count ||
            bootstrap_semantic_type_record(
                context,
                expected_type
            ).kind != BootstrapTypeKind.pointer) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.type_mismatch,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                expected_type
            );
            return bootstrap_semantic_invalid_expression();
        }
        var instruction: BootstrapIrInstruction =
            bootstrap_semantic_instruction(
                BootstrapIrOpcode.constant_null,
                node
            );
        let value_id: usize = bootstrap_semantic_emit_value(
            context,
            instruction,
            expected_type
        );
        return {
            type_id = expected_type,
            value_id = value_id,
            address_id = bootstrap_semantic_no_id(),
            constant_value = 0,
            has_constant = true,
            lvalue = false,
            mutable_lvalue = false,
            valid = value_id != bootstrap_semantic_no_id(),
        };
    }
    if (node.kind == BootstrapSyntaxKind.name_expression) {
        return bootstrap_semantic_lower_name(context, node);
    }
    if (node.kind ==
        BootstrapSyntaxKind.parenthesized_expression) {
        if (node.child_count != 1) {
            return bootstrap_semantic_invalid_expression();
        }
        return bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            expected_type
        );
    }
    if (node.kind == BootstrapSyntaxKind.call_expression) {
        return bootstrap_semantic_lower_call(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.index_expression) {
        return bootstrap_semantic_lower_index(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.member_expression) {
        return bootstrap_semantic_lower_member(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.unary_expression) {
        return bootstrap_semantic_lower_unary(
            context,
            node,
            expected_type
        );
    }
    if (node.kind == BootstrapSyntaxKind.cast_expression) {
        return bootstrap_semantic_lower_cast(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.binary_expression) {
        return bootstrap_semantic_lower_binary(
            context,
            node,
            expected_type
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.conditional_expression) {
        return bootstrap_semantic_lower_conditional(
            context,
            node,
            expected_type
        );
    }
    if (node.kind == BootstrapSyntaxKind.zero_initializer ||
        node.kind ==
            BootstrapSyntaxKind.aggregate_initializer) {
        return bootstrap_semantic_lower_initializer(
            context,
            node_id,
            expected_type
        );
    }
    if (node.kind == BootstrapSyntaxKind.sizeof_expression ||
        node.kind == BootstrapSyntaxKind.alignof_expression ||
        node.kind == BootstrapSyntaxKind.offsetof_expression) {
        return bootstrap_semantic_lower_layout_query(
            context,
            node
        );
    }
    bootstrap_semantic_add_diagnostic(
        context,
        BootstrapSemanticDiagnosticKind.internal_invariant,
        context->current_unit,
        node.span,
        bootstrap_semantic_no_id(),
        bootstrap_semantic_empty_span(),
        node.kind as usize
    );
    return bootstrap_semantic_invalid_expression();
}

fn bootstrap_semantic_block_is_terminated(
    context: *BootstrapSemanticContext,
    block_id: usize
) -> bool {
    let result: BootstrapIrBlockResult =
        bootstrap_ir_get_block(context->ir, block_id);
    if (result.error != RuntimeError.none) {
        context->error = result.error;
        return true;
    }
    return result.block.terminated;
}

fn bootstrap_semantic_enqueue_reachable_block(
    context: *BootstrapSemanticContext,
    function: BootstrapIrFunction,
    block_id: usize,
    reached: *StdByteBuffer,
    pending: *StdByteBuffer
) -> bool {
    if (block_id < function.first_block ||
        block_id - function.first_block >=
            function.block_count) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let local_id: usize =
        block_id - function.first_block;
    if (reached->data[local_id] != 0) {
        return true;
    }
    reached->data[local_id] = 1;
    let appended: StdByteBufferResult =
        std_byte_buffer_append(
            *pending,
            (&block_id) as *const usize as *const u8,
            sizeof(usize)
        );
    *pending = appended.buffer;
    context->error = appended.error;
    return appended.error == RuntimeError.none;
}

fn bootstrap_semantic_block_is_reachable(
    context: *BootstrapSemanticContext,
    function: BootstrapIrFunction,
    target_block: usize
) -> bool {
    if (function.block_count == 0 ||
        target_block < function.first_block ||
        target_block - function.first_block >=
            function.block_count) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    var reached: StdByteBuffer =
        std_byte_buffer_empty();
    while (reached.length < function.block_count &&
        context->error == RuntimeError.none) {
        let pushed: StdByteBufferResult =
            std_byte_buffer_push(reached, 0);
        reached = pushed.buffer;
        context->error = pushed.error;
    }
    var pending: StdByteBuffer =
        std_byte_buffer_empty();
    if (context->error == RuntimeError.none) {
        bootstrap_semantic_enqueue_reachable_block(
            context,
            function,
            function.first_block,
            &reached,
            &pending
        );
    }
    var cursor: usize = 0;
    let blocks: *const BootstrapIrBlock =
        context->ir.blocks.data as
            *const BootstrapIrBlock;
    let instructions: *const BootstrapIrInstruction =
        context->ir.instructions.data as
            *const BootstrapIrInstruction;
    while (cursor < pending.length &&
        context->error == RuntimeError.none) {
        let pending_blocks: *const usize =
            pending.data as *const usize;
        let block_id: usize =
            pending_blocks[cursor / sizeof(usize)];
        cursor += sizeof(usize);
        let block: BootstrapIrBlock =
            blocks[block_id];
        if (block.terminated) {
            let instruction: BootstrapIrInstruction =
                instructions[block.last_instruction];
            if (instruction.opcode ==
                BootstrapIrOpcode.jump) {
                bootstrap_semantic_enqueue_reachable_block(
                    context,
                    function,
                    instruction.auxiliary,
                    &reached,
                    &pending
                );
            } else if (instruction.opcode ==
                BootstrapIrOpcode.branch) {
                bootstrap_semantic_enqueue_reachable_block(
                    context,
                    function,
                    instruction.auxiliary,
                    &reached,
                    &pending
                );
                bootstrap_semantic_enqueue_reachable_block(
                    context,
                    function,
                    instruction.third,
                    &reached,
                    &pending
                );
            }
        }
    }
    let reachable: bool =
        context->error == RuntimeError.none &&
        reached.data[
            target_block - function.first_block
        ] != 0;
    var release_error: RuntimeError =
        std_byte_buffer_release(reached);
    release_error = bootstrap_semantic_release_error(
        release_error,
        std_byte_buffer_release(pending)
    );
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    return reachable;
}

fn bootstrap_semantic_enter_scope(
    context: *BootstrapSemanticContext
) -> usize {
    let local_start: usize = context->local_count;
    if (context->scope_depth >=
        BootstrapSemanticLimit.maximum_scope_depth as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.resource_limit,
            context->current_unit,
            bootstrap_semantic_empty_span(),
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            context->scope_depth
        );
        return bootstrap_semantic_no_id();
    }
    context->scope_depth += 1;
    return local_start;
}

fn bootstrap_semantic_leave_scope(
    context: *BootstrapSemanticContext,
    local_start: usize
) -> bool {
    if (context->scope_depth == 0 ||
        local_start == bootstrap_semantic_no_id() ||
        local_start > context->local_count) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let truncated: StdByteBufferResult =
        std_byte_buffer_truncate(
            context->locals,
            local_start * sizeof(BootstrapSemanticLocal)
        );
    context->locals = truncated.buffer;
    context->error = truncated.error;
    context->local_count = local_start;
    context->scope_depth -= 1;
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_lower_variable(
    context: *BootstrapSemanticContext,
    node_id: usize,
    node: BootstrapSyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count != 2) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let duplicate: usize =
        bootstrap_semantic_local_in_current_scope(
            context,
            context->current_unit,
            node.token_index
        );
    if (duplicate != none) {
        let locals: *const BootstrapSemanticLocal =
            context->locals.data as
                *const BootstrapSemanticLocal;
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.duplicate_local,
            context->current_unit,
            node.span,
            locals[duplicate].unit_index,
            bootstrap_semantic_node(
                context,
                locals[duplicate].unit_index,
                locals[duplicate].declaration_node
            ).span,
            duplicate
        );
        return false;
    }
    let type_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let type_id: usize =
        bootstrap_semantic_resolve_type_node(
            context,
            context->current_unit,
            node.first_child
        );
    if (type_id == none) {
        return false;
    }
    let type_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, type_id);
    if (type_record.kind == BootstrapTypeKind.type_void) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.incomplete_type,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    let initializer_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            type_node.next_sibling
        );
    if (bootstrap_type_is_memory(type_record.kind) &&
        initializer_node.kind !=
            BootstrapSyntaxKind.zero_initializer &&
        initializer_node.kind !=
            BootstrapSyntaxKind.aggregate_initializer &&
        initializer_node.kind !=
            BootstrapSyntaxKind.name_expression &&
        initializer_node.kind !=
            BootstrapSyntaxKind.member_expression &&
        initializer_node.kind !=
            BootstrapSyntaxKind.index_expression &&
        initializer_node.kind !=
            BootstrapSyntaxKind.call_expression &&
        initializer_node.kind !=
            BootstrapSyntaxKind.conditional_expression &&
        initializer_node.kind !=
            BootstrapSyntaxKind.parenthesized_expression) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_initializer,
            context->current_unit,
            initializer_node.span,
            none,
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    let initializer: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            type_node.next_sibling,
            type_id
        );
    if (!initializer.valid ||
        initializer.type_id != type_id) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            type_id
        );
        return false;
    }
    let mutable_binding: bool =
        (node.flags &
            (BootstrapSyntaxFlag.mutable_binding as usize)) != 0;
    let slot_id: usize = bootstrap_ir_add_slot(
        &context->ir,
        bootstrap_semantic_current_ir_function(context),
        type_id,
        mutable_binding
    );
    let address: usize = bootstrap_semantic_address_of_slot(
        context,
        node,
        slot_id,
        type_id,
        false
    );
    if (!bootstrap_semantic_store_to_address(
            context,
            node,
            address,
            type_id,
            initializer
        )) {
        return false;
    }
    return bootstrap_semantic_append_local(
        context,
        {
            function_id = context->current_function,
            type_id = type_id,
            slot_id = slot_id,
            unit_index = context->current_unit,
            declaration_node = node_id,
            name_token = node.token_index,
            scope_depth = context->scope_depth,
            mutable_binding = mutable_binding,
        }
    ) != none;
}

fn bootstrap_semantic_assignment_operation(
    operation: BootstrapTokenKind
) -> BootstrapTokenKind {
    if (operation == BootstrapTokenKind.plus_equal) {
        return BootstrapTokenKind.plus;
    }
    if (operation == BootstrapTokenKind.minus_equal) {
        return BootstrapTokenKind.minus;
    }
    if (operation == BootstrapTokenKind.star_equal) {
        return BootstrapTokenKind.star;
    }
    if (operation == BootstrapTokenKind.slash_equal) {
        return BootstrapTokenKind.slash;
    }
    if (operation == BootstrapTokenKind.percent_equal) {
        return BootstrapTokenKind.percent;
    }
    if (operation == BootstrapTokenKind.ampersand_equal) {
        return BootstrapTokenKind.ampersand;
    }
    if (operation == BootstrapTokenKind.pipe_equal) {
        return BootstrapTokenKind.pipe;
    }
    if (operation == BootstrapTokenKind.caret_equal) {
        return BootstrapTokenKind.caret;
    }
    if (operation == BootstrapTokenKind.shift_left_equal) {
        return BootstrapTokenKind.shift_left;
    }
    if (operation == BootstrapTokenKind.shift_right_equal) {
        return BootstrapTokenKind.shift_right;
    }
    return BootstrapTokenKind.invalid;
}

fn bootstrap_semantic_lower_assignment(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    if (node.child_count != 2) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let target_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let target: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            bootstrap_semantic_no_id()
        );
    if (!target.valid || !target.lvalue ||
        !target.mutable_lvalue) {
        bootstrap_semantic_add_diagnostic(
            context,
            target.lvalue ?
                BootstrapSemanticDiagnosticKind
                    .immutable_assignment :
                BootstrapSemanticDiagnosticKind.invalid_lvalue,
            context->current_unit,
            target_node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            target.type_id
        );
        return false;
    }
    let value: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            target_node.next_sibling,
            target.type_id
        );
    if (!value.valid || value.type_id != target.type_id) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.type_mismatch,
            context->current_unit,
            node.span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            target.type_id
        );
        return false;
    }
    let assignment: BootstrapTokenKind =
        bootstrap_semantic_token(
            context,
            context->current_unit,
            node.token_index
        ).kind;
    var stored: BootstrapSemanticExpression = value;
    if (assignment != BootstrapTokenKind.equal) {
        let operation: BootstrapTokenKind =
            bootstrap_semantic_assignment_operation(assignment);
        let type_record: BootstrapTypeRecord =
            bootstrap_semantic_type_record(
                context,
                target.type_id
            );
        var opcode: BootstrapIrOpcode =
            BootstrapIrOpcode.invalid;
        if (bootstrap_type_is_integer(type_record.kind) &&
            (bootstrap_semantic_binary_is_arithmetic(operation) ||
                bootstrap_semantic_binary_is_bitwise(operation))) {
            opcode = BootstrapIrOpcode.binary_integer;
        } else if (bootstrap_type_is_float(type_record.kind) &&
            bootstrap_semantic_binary_is_arithmetic(operation) &&
            operation != BootstrapTokenKind.percent) {
            opcode = BootstrapIrOpcode.binary_float;
        }
        if (opcode == BootstrapIrOpcode.invalid) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.invalid_operator,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                target.type_id
            );
            return false;
        }
        var instruction: BootstrapIrInstruction =
            bootstrap_semantic_instruction(opcode, node);
        instruction.operation = operation;
        instruction.left = target.value_id;
        instruction.right = value.value_id;
        let result_value: usize =
            bootstrap_semantic_emit_value(
                context,
                instruction,
                target.type_id
            );
        stored.value_id = result_value;
        stored.valid =
            result_value != bootstrap_semantic_no_id();
    }
    return bootstrap_semantic_store_to_address(
        context,
        node,
        target.address_id,
        target.type_id,
        stored
    );
}

fn bootstrap_semantic_lower_if(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count < 2 || node.child_count > 3) {
        return false;
    }
    let condition_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            BootstrapBuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            BootstrapBuiltinType.boolean as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_condition,
            context->current_unit,
            condition_node.span,
            none,
            bootstrap_semantic_empty_span(),
            condition.type_id
        );
        return false;
    }
    let then_block: usize =
        bootstrap_semantic_add_current_block(context);
    let else_block: usize =
        bootstrap_semantic_add_current_block(context);
    let merge_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        then_block,
        else_block
    );
    context->current_block = then_block;
    bootstrap_semantic_lower_block(
        context,
        condition_node.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            merge_block
        );
    }
    context->current_block = else_block;
    if (node.child_count == 3) {
        let then_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                condition_node.next_sibling
            );
        let else_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                then_node.next_sibling
            );
        if (else_node.kind == BootstrapSyntaxKind.if_statement) {
            bootstrap_semantic_lower_if(context, else_node);
        } else {
            bootstrap_semantic_lower_block(
                context,
                then_node.next_sibling
            );
        }
    }
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            merge_block
        );
    }
    context->current_block = merge_block;
    return true;
}

fn bootstrap_semantic_lower_while(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    if (node.child_count != 2) {
        return false;
    }
    let condition_block: usize =
        bootstrap_semantic_add_current_block(context);
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(
        context,
        node,
        condition_block
    );
    context->current_block = condition_block;
    let condition_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            BootstrapBuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            BootstrapBuiltinType.boolean as usize) {
        return false;
    }
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        body_block,
        exit_block
    );
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = condition_block;
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        condition_node.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            condition_block
        );
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn bootstrap_semantic_lower_do(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    if (node.child_count != 2) {
        return false;
    }
    let body_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let condition_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(context, node, body_block);
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = condition_block;
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        node.first_child
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            condition_block
        );
    }
    context->current_block = condition_block;
    let condition: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            body_node.next_sibling,
            BootstrapBuiltinType.boolean as usize
        );
    if (!condition.valid ||
        condition.type_id !=
            BootstrapBuiltinType.boolean as usize) {
        return false;
    }
    bootstrap_semantic_emit_branch(
        context,
        node,
        condition.value_id,
        body_block,
        exit_block
    );
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    return true;
}

fn bootstrap_semantic_lower_for_clause(
    context: *BootstrapSemanticContext,
    wrapper_id: usize
) -> bool {
    let wrapper: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            wrapper_id
        );
    if (wrapper.child_count == 0) {
        return true;
    }
    if (wrapper.child_count != 1) {
        return false;
    }
    let child: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            wrapper.first_child
        );
    if (child.kind ==
        BootstrapSyntaxKind.variable_declaration) {
        return bootstrap_semantic_lower_variable(
            context,
            wrapper.first_child,
            child
        );
    }
    if (child.kind ==
        BootstrapSyntaxKind.assignment_statement) {
        return bootstrap_semantic_lower_assignment(
            context,
            child
        );
    }
    if (child.kind ==
            BootstrapSyntaxKind.expression_statement &&
        child.child_count == 1) {
        return bootstrap_semantic_lower_expression(
            context,
            child.first_child,
            bootstrap_semantic_no_id()
        ).valid;
    }
    return false;
}

fn bootstrap_semantic_lower_for(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    if (node.child_count != 4) {
        return false;
    }
    let local_start: usize =
        bootstrap_semantic_enter_scope(context);
    if (local_start == bootstrap_semantic_no_id()) {
        return false;
    }
    let initializer: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let condition_wrapper: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            initializer.next_sibling
        );
    let update_wrapper: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            condition_wrapper.next_sibling
        );
    bootstrap_semantic_lower_for_clause(
        context,
        node.first_child
    );
    let condition_block: usize =
        bootstrap_semantic_add_current_block(context);
    let body_block: usize =
        bootstrap_semantic_add_current_block(context);
    let update_block: usize =
        bootstrap_semantic_add_current_block(context);
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(
        context,
        node,
        condition_block
    );
    context->current_block = condition_block;
    if (condition_wrapper.child_count == 0) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            body_block
        );
    } else {
        let condition: BootstrapSemanticExpression =
            bootstrap_semantic_lower_expression(
                context,
                condition_wrapper.first_child,
                BootstrapBuiltinType.boolean as usize
            );
        if (!condition.valid ||
            condition.type_id !=
                BootstrapBuiltinType.boolean as usize) {
            bootstrap_semantic_leave_scope(
                context,
                local_start
            );
            return false;
        }
        bootstrap_semantic_emit_branch(
            context,
            node,
            condition.value_id,
            body_block,
            exit_block
        );
    }
    let saved_break: usize = context->break_block;
    let saved_continue: usize = context->continue_block;
    context->break_block = exit_block;
    context->continue_block = update_block;
    context->current_block = body_block;
    bootstrap_semantic_lower_block(
        context,
        update_wrapper.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            update_block
        );
    }
    context->current_block = update_block;
    bootstrap_semantic_lower_for_clause(
        context,
        condition_wrapper.next_sibling
    );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        )) {
        bootstrap_semantic_emit_jump(
            context,
            node,
            condition_block
        );
    }
    context->break_block = saved_break;
    context->continue_block = saved_continue;
    context->current_block = exit_block;
    bootstrap_semantic_leave_scope(context, local_start);
    return true;
}

fn bootstrap_semantic_switch_label(
    context: *BootstrapSemanticContext,
    node_id: usize,
    control_type: usize
) -> BootstrapSemanticExpression {
    let node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    let control_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            control_type
        );
    if (control_record.kind ==
        BootstrapTypeKind.enumeration) {
        let result: BootstrapSemanticExpression =
            bootstrap_semantic_lower_enum_member(context, node);
        if (result.type_id == control_type) {
            return result;
        }
        return bootstrap_semantic_invalid_expression();
    }
    if (node.kind ==
        BootstrapSyntaxKind.integer_expression) {
        return bootstrap_semantic_lower_integer_literal(
            context,
            node,
            control_type
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.unary_expression) {
        return bootstrap_semantic_lower_unary(
            context,
            node,
            control_type
        );
    }
    return bootstrap_semantic_invalid_expression();
}

fn bootstrap_semantic_lower_switch(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    let none: usize = bootstrap_semantic_no_id();
    if (node.child_count < 2) {
        return false;
    }
    let expression_node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node.first_child
        );
    let control: BootstrapSemanticExpression =
        bootstrap_semantic_lower_expression(
            context,
            node.first_child,
            none
        );
    if (!control.valid) {
        return false;
    }
    let control_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            control.type_id
        );
    if (!bootstrap_type_is_integer(control_record.kind) &&
        control_record.kind != BootstrapTypeKind.enumeration) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.invalid_switch,
            context->current_unit,
            node.span,
            none,
            bootstrap_semantic_empty_span(),
            control.type_id
        );
        return false;
    }
    var arm_blocks: StdByteBuffer =
        std_byte_buffer_empty();
    var arm_node: usize = expression_node.next_sibling;
    var default_block: usize = none;
    while (arm_node != none &&
        context->error == RuntimeError.none) {
        let arm: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                arm_node
            );
        let block_id: usize =
            bootstrap_semantic_add_current_block(context);
        let appended: StdByteBufferResult =
            std_byte_buffer_append(
                arm_blocks,
                (&block_id) as *const usize as *const u8,
                sizeof(usize)
            );
        arm_blocks = appended.buffer;
        context->error = appended.error;
        if ((arm.flags &
                (BootstrapSyntaxFlag.default_arm as usize)) != 0) {
            if (default_block != none) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .duplicate_default,
                    context->current_unit,
                    arm.span,
                    none,
                    bootstrap_semantic_empty_span(),
                    0
                );
            }
            default_block = block_id;
        }
        arm_node = arm.next_sibling;
    }
    var seen_values: StdByteBuffer =
        std_byte_buffer_empty();
    let blocks: *const usize =
        arm_blocks.data as *const usize;
    arm_node = expression_node.next_sibling;
    var arm_index: usize = 0;
    while (arm_node != none &&
        context->error == RuntimeError.none) {
        let arm: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                arm_node
            );
        let is_default: bool =
            (arm.flags &
                (BootstrapSyntaxFlag.default_arm as usize)) != 0;
        var child: usize = arm.first_child;
        let label_count: usize =
            is_default ? 0 : arm.child_count - 1;
        var label_index: usize = 0;
        while (label_index < label_count) {
            let label: BootstrapSemanticExpression =
                bootstrap_semantic_switch_label(
                    context,
                    child,
                    control.type_id
                );
            if (!label.valid ||
                label.type_id != control.type_id) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .invalid_switch,
                    context->current_unit,
                    bootstrap_semantic_node(
                        context,
                        context->current_unit,
                        child
                    ).span,
                    none,
                    bootstrap_semantic_empty_span(),
                    control.type_id
                );
            } else {
                let values: *const u64 =
                    seen_values.data as *const u64;
                var duplicate: bool = false;
                var value_index: usize = 0;
                while (value_index <
                    seen_values.length / sizeof(u64)) {
                    if (values[value_index] ==
                        label.constant_value) {
                        duplicate = true;
                        break;
                    }
                    value_index += 1;
                }
                if (duplicate) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .duplicate_case,
                        context->current_unit,
                        bootstrap_semantic_node(
                            context,
                            context->current_unit,
                            child
                        ).span,
                        none,
                        bootstrap_semantic_empty_span(),
                        value_index
                    );
                }
                let appended: StdByteBufferResult =
                    std_byte_buffer_append(
                        seen_values,
                        (&label.constant_value) as
                            *const u64 as *const u8,
                        sizeof(u64)
                    );
                seen_values = appended.buffer;
                context->error = appended.error;
                var comparison: BootstrapIrInstruction =
                    bootstrap_semantic_instruction(
                        BootstrapIrOpcode.compare,
                        arm
                    );
                comparison.operation =
                    BootstrapTokenKind.equal_equal;
                comparison.left = control.value_id;
                comparison.right = label.value_id;
                let comparison_value: usize =
                    bootstrap_semantic_emit_value(
                        context,
                        comparison,
                        BootstrapBuiltinType.boolean as usize
                    );
                let next_test: usize =
                    bootstrap_semantic_add_current_block(
                        context
                    );
                bootstrap_semantic_emit_branch(
                    context,
                    arm,
                    comparison_value,
                    blocks[arm_index],
                    next_test
                );
                context->current_block = next_test;
            }
            child = bootstrap_semantic_node(
                context,
                context->current_unit,
                child
            ).next_sibling;
            label_index += 1;
        }
        arm_node = arm.next_sibling;
        arm_index += 1;
    }
    let exit_block: usize =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_emit_jump(
        context,
        node,
        default_block != none ? default_block : exit_block
    );
    let saved_break: usize = context->break_block;
    context->break_block = exit_block;
    arm_node = expression_node.next_sibling;
    arm_index = 0;
    while (arm_node != none) {
        let arm: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                context->current_unit,
                arm_node
            );
        context->current_block = blocks[arm_index];
        bootstrap_semantic_lower_block(
            context,
            arm.last_child
        );
        if (!bootstrap_semantic_block_is_terminated(
                context,
                context->current_block
            )) {
            bootstrap_semantic_emit_jump(
                context,
                arm,
                exit_block
            );
        }
        arm_node = arm.next_sibling;
        arm_index += 1;
    }
    context->break_block = saved_break;
    context->current_block = exit_block;
    var release_error: RuntimeError =
        std_byte_buffer_release(arm_blocks);
    release_error = bootstrap_semantic_release_error(
        release_error,
        std_byte_buffer_release(seen_values)
    );
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    return true;
}

fn bootstrap_semantic_lower_return(
    context: *BootstrapSemanticContext,
    node: BootstrapSyntaxNode
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let return_type: usize =
        functions[context->current_function].return_type;
    let return_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            return_type
        );
    var instruction: BootstrapIrInstruction =
        bootstrap_semantic_instruction(
            return_record.kind == BootstrapTypeKind.type_void ?
                BootstrapIrOpcode.return_void :
                BootstrapIrOpcode.return_value,
            node
        );
    instruction.type_id = return_type;
    if (return_record.kind ==
        BootstrapTypeKind.type_void) {
        if (node.child_count != 0) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.return_type,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                return_type
            );
            return false;
        }
    } else {
        if (node.child_count != 1) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.return_type,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                return_type
            );
            return false;
        }
        let value: BootstrapSemanticExpression =
            bootstrap_semantic_lower_expression(
                context,
                node.first_child,
                return_type
            );
        if (!value.valid || value.type_id != return_type) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.return_type,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                return_type
            );
            return false;
        }
        instruction.left =
            bootstrap_type_is_memory(return_record.kind) ?
                value.address_id : value.value_id;
    }
    bootstrap_semantic_emit_void(context, instruction);
    context->current_block =
        bootstrap_semantic_add_current_block(context);
    return true;
}

fn bootstrap_semantic_lower_statement(
    context: *BootstrapSemanticContext,
    node_id: usize
) -> bool {
    let node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind ==
        BootstrapSyntaxKind.variable_declaration) {
        return bootstrap_semantic_lower_variable(
            context,
            node_id,
            node
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.assignment_statement) {
        return bootstrap_semantic_lower_assignment(
            context,
            node
        );
    }
    if (node.kind ==
        BootstrapSyntaxKind.expression_statement) {
        return node.child_count == 1 &&
            bootstrap_semantic_lower_expression(
                context,
                node.first_child,
                bootstrap_semantic_no_id()
            ).valid;
    }
    if (node.kind == BootstrapSyntaxKind.block_statement) {
        return bootstrap_semantic_lower_block(
            context,
            node_id
        );
    }
    if (node.kind == BootstrapSyntaxKind.if_statement) {
        return bootstrap_semantic_lower_if(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.while_statement) {
        return bootstrap_semantic_lower_while(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.do_statement) {
        return bootstrap_semantic_lower_do(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.for_statement) {
        return bootstrap_semantic_lower_for(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.switch_statement) {
        return bootstrap_semantic_lower_switch(context, node);
    }
    if (node.kind == BootstrapSyntaxKind.break_statement) {
        if (context->break_block ==
            bootstrap_semantic_no_id()) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .break_outside_control,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                0
            );
            return false;
        }
        bootstrap_semantic_emit_jump(
            context,
            node,
            context->break_block
        );
        context->current_block =
            bootstrap_semantic_add_current_block(context);
        return true;
    }
    if (node.kind ==
        BootstrapSyntaxKind.continue_statement) {
        if (context->continue_block ==
            bootstrap_semantic_no_id()) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .continue_outside_loop,
                context->current_unit,
                node.span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                0
            );
            return false;
        }
        bootstrap_semantic_emit_jump(
            context,
            node,
            context->continue_block
        );
        context->current_block =
            bootstrap_semantic_add_current_block(context);
        return true;
    }
    if (node.kind == BootstrapSyntaxKind.return_statement) {
        return bootstrap_semantic_lower_return(context, node);
    }
    bootstrap_semantic_add_diagnostic(
        context,
        BootstrapSemanticDiagnosticKind.internal_invariant,
        context->current_unit,
        node.span,
        bootstrap_semantic_no_id(),
        bootstrap_semantic_empty_span(),
        node.kind as usize
    );
    return false;
}

fn bootstrap_semantic_lower_block(
    context: *BootstrapSemanticContext,
    node_id: usize
) -> bool {
    let node: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            context->current_unit,
            node_id
        );
    if (node.kind != BootstrapSyntaxKind.block_statement) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let local_start: usize =
        bootstrap_semantic_enter_scope(context);
    if (local_start == bootstrap_semantic_no_id()) {
        return false;
    }
    var child: usize = node.first_child;
    while (child != bootstrap_semantic_no_id() &&
        context->error == RuntimeError.none) {
        bootstrap_semantic_lower_statement(context, child);
        child = bootstrap_semantic_node(
            context,
            context->current_unit,
            child
        ).next_sibling;
    }
    bootstrap_semantic_leave_scope(context, local_start);
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_function_body(
    context: *BootstrapSemanticContext,
    function: BootstrapSemanticFunction
) -> usize {
    if (function.implementation_unit ==
        bootstrap_semantic_no_id()) {
        return bootstrap_semantic_no_id();
    }
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            function.implementation_unit,
            function.implementation_node
        );
    var parameter_count: usize = 0;
    var return_node: usize = bootstrap_semantic_no_id();
    var body_node: usize = bootstrap_semantic_no_id();
    bootstrap_semantic_function_parts(
        context,
        function.implementation_unit,
        declaration,
        &parameter_count,
        &return_node,
        &body_node
    );
    return body_node;
}

fn bootstrap_semantic_add_parameter_locals(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let declaration: BootstrapSyntaxNode =
        bootstrap_semantic_node(
            context,
            function.implementation_unit,
            function.implementation_node
        );
    let ir_functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    let ir_function: BootstrapIrFunction =
        ir_functions[function.ir_function];
    let ir_parameters: *const BootstrapIrParameter =
        context->ir.parameters.data as
            *const BootstrapIrParameter;
    let semantic_parameters:
        *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    var child: usize = declaration.first_child;
    var index: usize = 0;
    while (index < function.parameter_count) {
        let parameter_node: BootstrapSyntaxNode =
            bootstrap_semantic_node(
                context,
                function.implementation_unit,
                child
            );
        let parameter: BootstrapSemanticParameter =
            semantic_parameters[
                function.first_parameter + index
            ];
        let ir_parameter: BootstrapIrParameter =
            ir_parameters[
                ir_function.first_parameter + index
            ];
        bootstrap_semantic_append_local(
            context,
            {
                function_id = function_id,
                type_id = parameter.type_id,
                slot_id = ir_parameter.slot_id,
                unit_index = function.implementation_unit,
                declaration_node = child,
                name_token = parameter_node.token_index,
                scope_depth = 0,
                mutable_binding = false,
            }
        );
        child = parameter_node.next_sibling;
        index += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_lower_function(
    context: *BootstrapSemanticContext,
    function_id: usize
) -> bool {
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let function: BootstrapSemanticFunction =
        functions[function_id];
    let body_node: usize =
        bootstrap_semantic_function_body(context, function);
    if (body_node == bootstrap_semantic_no_id()) {
        return true;
    }
    context->current_function = function_id;
    context->current_unit = function.implementation_unit;
    context->scope_depth = 0;
    context->local_count = 0;
    let cleared: StdByteBufferResult =
        std_byte_buffer_clear(context->locals);
    context->locals = cleared.buffer;
    context->error = cleared.error;
    context->break_block = bootstrap_semantic_no_id();
    context->continue_block = bootstrap_semantic_no_id();
    context->current_block =
        bootstrap_semantic_add_current_block(context);
    bootstrap_semantic_add_parameter_locals(
        context,
        function_id
    );
    bootstrap_semantic_lower_block(context, body_node);
    let return_record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(
            context,
            function.return_type
        );
    let ir_functions: *const BootstrapIrFunction =
        context->ir.functions.data as
            *const BootstrapIrFunction;
    let reachable: bool =
        bootstrap_semantic_block_is_reachable(
            context,
            ir_functions[function.ir_function],
            context->current_block
        );
    if (!bootstrap_semantic_block_is_terminated(
            context,
            context->current_block
        ) && reachable) {
        if (return_record.kind ==
            BootstrapTypeKind.type_void) {
            let body: BootstrapSyntaxNode =
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    body_node
                );
            var instruction: BootstrapIrInstruction =
                bootstrap_semantic_instruction(
                    BootstrapIrOpcode.return_void,
                    body
                );
            instruction.type_id = function.return_type;
            bootstrap_semantic_emit_void(
                context,
                instruction
            );
        } else {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind.missing_return,
                context->current_unit,
                bootstrap_semantic_node(
                    context,
                    context->current_unit,
                    body_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                function.return_type
            );
        }
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_lower_functions(
    context: *BootstrapSemanticContext
) -> bool {
    let order: StdByteBuffer =
        bootstrap_semantic_function_order(context);
    let ordered: *const usize =
        order.data as *const usize;
    var order_index: usize = 0;
    while (order_index < context->function_count &&
        context->error == RuntimeError.none) {
        bootstrap_semantic_lower_function(
            context,
            ordered[order_index]
        );
        order_index += 1;
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(order);
    if (context->error == RuntimeError.none) {
        context->error = release_error;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_token_equals_bytes(
    context: *BootstrapSemanticContext,
    unit_index: usize,
    token_index: usize,
    bytes: *const u8,
    length: usize
) -> bool {
    if (bytes == null) {
        return false;
    }
    let token: BootstrapToken = bootstrap_semantic_token(
        context,
        unit_index,
        token_index
    );
    let unit: *const BootstrapSemanticUnit =
        bootstrap_semantic_input_unit(context, unit_index);
    if (token.span.length != length) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (unit->source.data[token.span.offset + index] !=
            bytes[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_mark_reachable(
    context: *BootstrapSemanticContext,
    module_id: usize,
    depth: usize
) -> bool {
    if (module_id >= context->module_count) {
        context->error = RuntimeError.invalid_argument;
        return false;
    }
    let modules: *BootstrapSemanticModule =
        context->modules.data as *BootstrapSemanticModule;
    if (modules[module_id].reachable) {
        return true;
    }
    if (depth >=
        BootstrapSemanticLimit.maximum_module_depth as usize) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.resource_limit,
            modules[module_id].name_unit,
            bootstrap_semantic_node(
                context,
                modules[module_id].name_unit,
                modules[module_id].name_node
            ).span,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            depth
        );
        return false;
    }
    modules[module_id].reachable = true;
    let first_import: usize = modules[module_id].first_import;
    let import_count: usize = modules[module_id].import_count;
    var index: usize = 0;
    while (index < import_count) {
        let imports: *const BootstrapSemanticImport =
            context->imports.data as
                *const BootstrapSemanticImport;
        if (!bootstrap_semantic_mark_reachable(
            context,
            imports[first_import + index].target_module,
            depth + 1
        )) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn bootstrap_semantic_validate_reachability(
    context: *BootstrapSemanticContext,
    root_module: usize
) -> bool {
    if (root_module >= context->module_count) {
        return false;
    }
    if (!bootstrap_semantic_mark_reachable(
            context,
            root_module,
            0
        )) {
        return false;
    }
    let modules: *const BootstrapSemanticModule =
        context->modules.data as
            *const BootstrapSemanticModule;
    var module_id: usize = 0;
    while (module_id < context->module_count) {
        if (!modules[module_id].reachable) {
            bootstrap_semantic_add_diagnostic(
                context,
                BootstrapSemanticDiagnosticKind
                    .unreachable_module,
                modules[module_id].name_unit,
                bootstrap_semantic_node(
                    context,
                    modules[module_id].name_unit,
                    modules[module_id].name_node
                ).span,
                bootstrap_semantic_no_id(),
                bootstrap_semantic_empty_span(),
                module_id
            );
        }
        module_id += 1;
    }
    return true;
}

fn bootstrap_semantic_select_entry(
    context: *BootstrapSemanticContext
) -> bool {
    if (!context->input.executable) {
        return bootstrap_semantic_validate_reachability(
            context,
            bootstrap_semantic_unit_module(context, 0)
        );
    }
    let none: usize = bootstrap_semantic_no_id();
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    var entry: usize = none;
    var function_id: usize = 0;
    while (function_id < context->function_count) {
        let function: BootstrapSemanticFunction =
            functions[function_id];
        let symbol: BootstrapSemanticSymbol =
            symbols[function.symbol_id];
        if (function.implementation_unit != none &&
            bootstrap_semantic_token_equals_bytes(
                context,
                symbol.declaration_unit,
                symbol.name_token,
                "main",
                4
            )) {
            if (entry != none) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .duplicate_function,
                    symbol.declaration_unit,
                    bootstrap_semantic_token(
                        context,
                        symbol.declaration_unit,
                        symbol.name_token
                    ).span,
                    symbols[functions[entry].symbol_id]
                        .declaration_unit,
                    bootstrap_semantic_token(
                        context,
                        symbols[functions[entry].symbol_id]
                            .declaration_unit,
                        symbols[functions[entry].symbol_id]
                            .name_token
                    ).span,
                    function_id
                );
            }
            entry = function_id;
        }
        function_id += 1;
    }
    if (entry == none) {
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.missing_definition,
            0,
            bootstrap_semantic_empty_span(),
            none,
            bootstrap_semantic_empty_span(),
            0
        );
        return false;
    }
    let entry_function: BootstrapSemanticFunction =
        functions[entry];
    if (entry_function.parameter_count != 0 ||
        entry_function.return_type !=
            BootstrapBuiltinType.signed_32 as usize ||
        (entry_function.flags &
            (BootstrapSemanticSymbolFlag.external as usize)) != 0) {
        let symbol: BootstrapSemanticSymbol =
            symbols[entry_function.symbol_id];
        bootstrap_semantic_add_diagnostic(
            context,
            BootstrapSemanticDiagnosticKind.signature_mismatch,
            symbol.declaration_unit,
            bootstrap_semantic_node(
                context,
                symbol.declaration_unit,
                symbol.declaration_node
            ).span,
            none,
            bootstrap_semantic_empty_span(),
            entry
        );
        return false;
    }
    bootstrap_ir_set_entry(
        &context->ir,
        entry_function.ir_function
    );
    return bootstrap_semantic_validate_reachability(
        context,
        bootstrap_semantic_unit_module(
            context,
            entry_function.implementation_unit
        )
    );
}

fn bootstrap_semantic_public_type_is_valid(
    context: *BootstrapSemanticContext,
    type_id: usize
) -> bool {
    var current: usize = type_id;
    var record: BootstrapTypeRecord =
        bootstrap_semantic_type_record(context, current);
    while (record.kind == BootstrapTypeKind.pointer ||
        record.kind == BootstrapTypeKind.array) {
        current = record.element_type;
        record = bootstrap_semantic_type_record(
            context,
            current
        );
    }
    if (record.kind != BootstrapTypeKind.structure &&
        record.kind != BootstrapTypeKind.record_union &&
        record.kind != BootstrapTypeKind.enumeration) {
        return true;
    }
    let symbol_id: usize =
        bootstrap_semantic_find_type_symbol(context, current);
    if (symbol_id == bootstrap_semantic_no_id()) {
        return false;
    }
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    return (symbols[symbol_id].flags &
        (BootstrapSemanticSymbolFlag.exported as usize)) != 0;
}

fn bootstrap_semantic_validate_public_types(
    context: *BootstrapSemanticContext
) -> bool {
    let symbols: *const BootstrapSemanticSymbol =
        context->symbols.data as
            *const BootstrapSemanticSymbol;
    let functions: *const BootstrapSemanticFunction =
        context->functions.data as
            *const BootstrapSemanticFunction;
    let parameters: *const BootstrapSemanticParameter =
        context->parameters.data as
            *const BootstrapSemanticParameter;
    let fields: *const BootstrapTypeField =
        context->types.fields.data as
            *const BootstrapTypeField;
    var symbol_id: usize = 0;
    while (symbol_id < context->symbol_count) {
        let symbol: BootstrapSemanticSymbol =
            symbols[symbol_id];
        if ((symbol.flags &
                (BootstrapSemanticSymbolFlag.exported as usize)) != 0 &&
            symbol.kind ==
                BootstrapSemanticSymbolKind.named_type) {
            let record: BootstrapTypeRecord =
                bootstrap_semantic_type_record(
                    context,
                    symbol.type_id
                );
            var index: usize = 0;
            while (index < record.field_count) {
                let field: BootstrapTypeField =
                    fields[record.first_field + index];
                if (!bootstrap_semantic_public_type_is_valid(
                        context,
                        field.type_id
                    )) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .private_type_exposure,
                        field.declaration_unit,
                        bootstrap_semantic_node(
                            context,
                            field.declaration_unit,
                            field.declaration_node
                        ).span,
                        symbol.declaration_unit,
                        bootstrap_semantic_node(
                            context,
                            symbol.declaration_unit,
                            symbol.declaration_node
                        ).span,
                        field.type_id
                    );
                }
                index += 1;
            }
        } else if ((symbol.flags &
                (BootstrapSemanticSymbolFlag.exported as usize)) != 0 &&
            symbol.kind ==
                BootstrapSemanticSymbolKind.function) {
            let function: BootstrapSemanticFunction =
                functions[symbol.function_id];
            if (!bootstrap_semantic_public_type_is_valid(
                    context,
                    function.return_type
                )) {
                bootstrap_semantic_add_diagnostic(
                    context,
                    BootstrapSemanticDiagnosticKind
                        .private_type_exposure,
                    symbol.declaration_unit,
                    bootstrap_semantic_node(
                        context,
                        symbol.declaration_unit,
                        symbol.declaration_node
                    ).span,
                    bootstrap_semantic_no_id(),
                    bootstrap_semantic_empty_span(),
                    function.return_type
                );
            }
            var index: usize = 0;
            while (index < function.parameter_count) {
                let parameter: BootstrapSemanticParameter =
                    parameters[function.first_parameter + index];
                if (!bootstrap_semantic_public_type_is_valid(
                        context,
                        parameter.type_id
                    )) {
                    bootstrap_semantic_add_diagnostic(
                        context,
                        BootstrapSemanticDiagnosticKind
                            .private_type_exposure,
                        parameter.unit_index,
                        bootstrap_semantic_node(
                            context,
                            parameter.unit_index,
                            parameter.declaration_node
                        ).span,
                        symbol.declaration_unit,
                        bootstrap_semantic_node(
                            context,
                            symbol.declaration_unit,
                            symbol.declaration_node
                        ).span,
                        parameter.type_id
                    );
                }
                index += 1;
            }
        }
        symbol_id += 1;
    }
    return context->error == RuntimeError.none;
}

fn bootstrap_semantic_check(
    input: BootstrapSemanticInput
) -> BootstrapSemanticResult {
    var context: BootstrapSemanticContext =
        bootstrap_semantic_context_init(input);
    if (!bootstrap_semantic_input_is_valid(input)) {
        bootstrap_semantic_add_diagnostic(
            &context,
            BootstrapSemanticDiagnosticKind.invalid_input,
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            bootstrap_semantic_no_id(),
            bootstrap_semantic_empty_span(),
            0
        );
        return {
            types = context.types,
            ir = context.ir,
            diagnostics = context.diagnostics,
            error = context.error,
        };
    }

    bootstrap_semantic_collect_modules(&context);
    bootstrap_semantic_collect_imports(&context);
    bootstrap_semantic_validate_import_graph(&context);
    bootstrap_semantic_collect_named_types(&context);
    bootstrap_semantic_resolve_all_types(&context);
    bootstrap_semantic_collect_functions(&context);
    bootstrap_semantic_validate_imported_names(&context);
    bootstrap_semantic_validate_public_types(&context);
    bootstrap_semantic_create_ir_functions(&context);
    bootstrap_semantic_lower_functions(&context);
    bootstrap_semantic_select_entry(&context);

    let work_error: RuntimeError =
        bootstrap_semantic_context_release_work(&context);
    if (context.error == RuntimeError.none) {
        context.error = work_error;
    }
    return {
        types = context.types,
        ir = context.ir,
        diagnostics = context.diagnostics,
        error = context.error,
    };
}
