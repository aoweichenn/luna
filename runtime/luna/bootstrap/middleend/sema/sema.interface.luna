export module luna.bootstrap.middleend.sema;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.middleend.type;
import luna.bootstrap.middleend.ir;

export enum BootstrapSemanticDiagnosticKind: usize {
    invalid_input,
    duplicate_interface,
    duplicate_implementation,
    unknown_import,
    self_import,
    duplicate_import,
    import_cycle,
    unreachable_module,
    duplicate_name,
    ambiguous_import,
    invalid_export,
    private_type_exposure,
    unknown_type,
    duplicate_field,
    recursive_type,
    incomplete_type,
    object_too_large,
    invalid_enum_underlying,
    invalid_enum_value,
    enum_value_overflow,
    duplicate_enum_member,
    duplicate_function,
    missing_definition,
    signature_mismatch,
    invalid_external,
    duplicate_parameter,
    unknown_name,
    duplicate_local,
    immutable_assignment,
    type_mismatch,
    invalid_condition,
    invalid_operator,
    invalid_cast,
    invalid_lvalue,
    invalid_call,
    argument_count,
    invalid_initializer,
    duplicate_initializer_field,
    unknown_field,
    invalid_index,
    invalid_member,
    invalid_layout_query,
    break_outside_control,
    continue_outside_loop,
    return_type,
    missing_return,
    invalid_switch,
    duplicate_case,
    duplicate_default,
    integer_overflow,
    floating_overflow,
    resource_limit,
    internal_invariant,
}

export struct BootstrapSemanticUnit {
    source: StdTextView;
    tokens: BootstrapTokenBuffer;
    tree: BootstrapSyntaxTree;
}

export struct BootstrapSemanticInput {
    units: StdByteBuffer;
    unit_count: usize;
    executable: bool;
}

export struct BootstrapSemanticDiagnostic {
    kind: BootstrapSemanticDiagnosticKind;
    unit_index: usize;
    span: BootstrapSourceSpan;
    related_unit: usize;
    related_span: BootstrapSourceSpan;
    detail: usize;
}

export struct BootstrapSemanticDiagnosticBuffer {
    storage: StdByteBuffer;
    count: usize;
}

export struct BootstrapSemanticResult {
    types: BootstrapTypeTable;
    ir: BootstrapTypedIr;
    diagnostics: BootstrapSemanticDiagnosticBuffer;
    error: RuntimeError;
}

export struct BootstrapSemanticDiagnosticResult {
    diagnostic: BootstrapSemanticDiagnostic;
    error: RuntimeError;
}

export fn bootstrap_semantic_input_empty(
    executable: bool
) -> BootstrapSemanticInput;
export fn bootstrap_semantic_input_is_valid(
    input: BootstrapSemanticInput
) -> bool;
export fn bootstrap_semantic_input_add(
    input: *BootstrapSemanticInput,
    unit: BootstrapSemanticUnit
) -> bool;
export fn bootstrap_semantic_input_release(
    input: BootstrapSemanticInput
) -> RuntimeError;
export fn bootstrap_semantic_diagnostic_get(
    diagnostics: BootstrapSemanticDiagnosticBuffer,
    index: usize
) -> BootstrapSemanticDiagnosticResult;
export fn bootstrap_semantic_result_is_success(
    result: BootstrapSemanticResult
) -> bool;
export fn bootstrap_semantic_check(
    input: BootstrapSemanticInput
) -> BootstrapSemanticResult;
export fn bootstrap_semantic_result_release(
    result: BootstrapSemanticResult
) -> RuntimeError;
