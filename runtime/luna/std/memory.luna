module luna.std.memory;

fn std_memory_empty_allocation() -> StdAllocation {
    return {
        address = null,
        length = 0,
    };
}

fn std_memory_invalid_result(
    allocation: StdAllocation,
    error: RuntimeError
) -> StdAllocationResult {
    return {
        allocation = allocation,
        error = error,
    };
}

fn std_memory_allocation_is_valid(allocation: StdAllocation) -> bool {
    return (allocation.address == null && allocation.length == 0) ||
        (allocation.address != null && allocation.length != 0);
}

fn std_memory_allocate(length: usize) -> StdAllocationResult {
    if (length == 0) {
        return {
            allocation = std_memory_empty_allocation(),
            error = RuntimeError.none,
        };
    }

    let mapped: RuntimeMemoryResult = runtime_memory_map(length);
    if (mapped.error != RuntimeError.none) {
        return std_memory_invalid_result(
            std_memory_empty_allocation(),
            mapped.error
        );
    }
    return {
        allocation = {
            address = mapped.memory.address,
            length = mapped.memory.length,
        },
        error = RuntimeError.none,
    };
}

fn std_memory_resize(
    allocation: StdAllocation,
    new_length: usize
) -> StdAllocationResult {
    if (!std_memory_allocation_is_valid(allocation)) {
        return std_memory_invalid_result(
            allocation,
            RuntimeError.invalid_argument
        );
    }
    if (new_length == allocation.length) {
        return {
            allocation = allocation,
            error = RuntimeError.none,
        };
    }
    if (new_length == 0) {
        let release_error: RuntimeError = std_memory_release(allocation);
        if (release_error != RuntimeError.none) {
            return std_memory_invalid_result(allocation, release_error);
        }
        return {
            allocation = std_memory_empty_allocation(),
            error = RuntimeError.none,
        };
    }

    let replacement: StdAllocationResult =
        std_memory_allocate(new_length);
    if (replacement.error != RuntimeError.none) {
        return std_memory_invalid_result(
            allocation,
            replacement.error
        );
    }

    let copy_length: usize = allocation.length < new_length ?
        allocation.length : new_length;
    let move_error: RuntimeError = std_memory_move(
        replacement.allocation.address,
        allocation.address as *const u8,
        copy_length
    );
    if (move_error != RuntimeError.none) {
        std_memory_release(replacement.allocation);
        return std_memory_invalid_result(allocation, move_error);
    }

    let release_error: RuntimeError = std_memory_release(allocation);
    if (release_error != RuntimeError.none) {
        std_memory_release(replacement.allocation);
        return std_memory_invalid_result(allocation, release_error);
    }
    return replacement;
}

fn std_memory_release(allocation: StdAllocation) -> RuntimeError {
    if (!std_memory_allocation_is_valid(allocation)) {
        return RuntimeError.invalid_argument;
    }
    if (allocation.length == 0) {
        return RuntimeError.none;
    }
    return runtime_memory_unmap({
        address = allocation.address,
        length = allocation.length,
    });
}

fn std_memory_move(
    destination: *u8,
    source: *const u8,
    length: usize
) -> RuntimeError {
    if (length == 0) {
        return RuntimeError.none;
    }
    if (destination == null || source == null) {
        return RuntimeError.bad_address;
    }
    if (destination as usize == source as usize) {
        return RuntimeError.none;
    }

    if (destination as usize < source as usize) {
        var index: usize = 0;
        while (index < length) {
            destination[index] = source[index];
            index += 1;
        }
        return RuntimeError.none;
    }

    var remaining: usize = length;
    while (remaining != 0) {
        remaining -= 1;
        destination[remaining] = source[remaining];
    }
    return RuntimeError.none;
}

fn std_memory_fill(
    destination: *u8,
    value: u8,
    length: usize
) -> RuntimeError {
    if (length == 0) {
        return RuntimeError.none;
    }
    if (destination == null) {
        return RuntimeError.bad_address;
    }

    var index: usize = 0;
    while (index < length) {
        destination[index] = value;
        index += 1;
    }
    return RuntimeError.none;
}

fn std_memory_equal(
    left: *const u8,
    right: *const u8,
    length: usize
) -> bool {
    if (length == 0) {
        return true;
    }
    if (left == null || right == null) {
        return false;
    }

    var index: usize = 0;
    while (index < length) {
        if (left[index] != right[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}
