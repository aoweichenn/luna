module luna.runtime;

import luna.linux.syscall;

enum LinuxSystemCall: usize {
    read = 0,
    write = 1,
    close = 3,
    map_memory = 9,
    unmap_memory = 11,
    process_id = 39,
    exit_group = 231,
    open_at = 257,
}

enum LinuxDescriptor: isize {
    invalid = -1,
    standard_input = 0,
    standard_output = 1,
    standard_error = 2,
    current_directory = -100,
}

enum LinuxOpenFlags: usize {
    read_only_close_on_exec = 524288,
    create_write_truncate_close_on_exec = 524865,
}

enum LinuxFileMode: usize {
    readable_writable = 438,
}

enum LinuxMemoryProtection: usize {
    read_write = 3,
}

enum LinuxMemoryFlags: usize {
    private_anonymous = 34,
}

enum LinuxAbiLimit: isize {
    maximum_error = 4095,
    maximum_descriptor = 2147483647,
}

fn runtime_error_from_raw(result: isize) -> RuntimeError {
    if (result >= 0) {
        return RuntimeError.none;
    }
    if (result < -(LinuxAbiLimit.maximum_error as isize)) {
        return RuntimeError.io;
    }
    return (-result) as RuntimeError;
}

fn runtime_invalid_file() -> RuntimeFile {
    return { descriptor = LinuxDescriptor.invalid as isize, };
}

fn runtime_file_result_from_raw(result: isize) -> RuntimeFileResult {
    let error: RuntimeError = runtime_error_from_raw(result);
    if (error != RuntimeError.none) {
        return {
            file = runtime_invalid_file(),
            error = error,
        };
    }
    if (result > (LinuxAbiLimit.maximum_descriptor as isize)) {
        return {
            file = runtime_invalid_file(),
            error = RuntimeError.io,
        };
    }
    return {
        file = { descriptor = result, },
        error = RuntimeError.none,
    };
}

fn runtime_io_result_from_raw(
    result: isize,
    maximum: usize
) -> RuntimeIoResult {
    let error: RuntimeError = runtime_error_from_raw(result);
    if (error != RuntimeError.none) {
        return {
            count = 0,
            error = error,
        };
    }

    let count: usize = result as usize;
    if (count > maximum) {
        return {
            count = 0,
            error = RuntimeError.io,
        };
    }
    return {
        count = count,
        error = RuntimeError.none,
    };
}

fn runtime_invalid_memory_result(error: RuntimeError)
    -> RuntimeMemoryResult {
    return {
        memory = {
            address = null,
            length = 0,
        },
        error = error,
    };
}

fn runtime_error_is_none(error: RuntimeError) -> bool {
    return error == RuntimeError.none;
}

fn runtime_process_id() -> RuntimeProcessIdResult {
    let result: isize =
        luna_linux_syscall0(LinuxSystemCall.process_id as usize);
    let error: RuntimeError = runtime_error_from_raw(result);
    if (error != RuntimeError.none) {
        return {
            process_id = 0,
            error = error,
        };
    }
    if (result == 0) {
        return {
            process_id = 0,
            error = RuntimeError.io,
        };
    }
    return {
        process_id = result as usize,
        error = RuntimeError.none,
    };
}

fn runtime_process_exit(status: i32) -> void {
    luna_linux_syscall1(
        LinuxSystemCall.exit_group as usize,
        status as isize as usize
    );
    while (true) {
    }
}

fn runtime_standard_input() -> RuntimeFile {
    return {
        descriptor = LinuxDescriptor.standard_input as isize,
    };
}

fn runtime_standard_output() -> RuntimeFile {
    return {
        descriptor = LinuxDescriptor.standard_output as isize,
    };
}

fn runtime_standard_error() -> RuntimeFile {
    return {
        descriptor = LinuxDescriptor.standard_error as isize,
    };
}

fn runtime_file_open_read(path: *const u8) -> RuntimeFileResult {
    if (path == null) {
        return {
            file = runtime_invalid_file(),
            error = RuntimeError.bad_address,
        };
    }

    let result: isize = luna_linux_syscall4(
        LinuxSystemCall.open_at as usize,
        LinuxDescriptor.current_directory as isize as usize,
        path as usize,
        LinuxOpenFlags.read_only_close_on_exec as usize,
        0
    );
    return runtime_file_result_from_raw(result);
}

fn runtime_file_create(path: *const u8) -> RuntimeFileResult {
    if (path == null) {
        return {
            file = runtime_invalid_file(),
            error = RuntimeError.bad_address,
        };
    }

    let result: isize = luna_linux_syscall4(
        LinuxSystemCall.open_at as usize,
        LinuxDescriptor.current_directory as isize as usize,
        path as usize,
        LinuxOpenFlags.create_write_truncate_close_on_exec as usize,
        LinuxFileMode.readable_writable as usize
    );
    return runtime_file_result_from_raw(result);
}

fn runtime_file_close(file: RuntimeFile) -> RuntimeError {
    if (file.descriptor < 0) {
        return RuntimeError.bad_descriptor;
    }
    return runtime_error_from_raw(
        luna_linux_syscall1(
            LinuxSystemCall.close as usize,
            file.descriptor as usize
        )
    );
}

fn runtime_file_read(
    file: RuntimeFile,
    buffer: *u8,
    length: usize
) -> RuntimeIoResult {
    if (file.descriptor < 0) {
        return {
            count = 0,
            error = RuntimeError.bad_descriptor,
        };
    }
    if (length == 0) {
        return {
            count = 0,
            error = RuntimeError.none,
        };
    }
    if (buffer == null) {
        return {
            count = 0,
            error = RuntimeError.bad_address,
        };
    }

    return runtime_io_result_from_raw(
        luna_linux_syscall3(
            LinuxSystemCall.read as usize,
            file.descriptor as usize,
            buffer as usize,
            length
        ),
        length
    );
}

fn runtime_file_write(
    file: RuntimeFile,
    buffer: *const u8,
    length: usize
) -> RuntimeIoResult {
    if (file.descriptor < 0) {
        return {
            count = 0,
            error = RuntimeError.bad_descriptor,
        };
    }
    if (length == 0) {
        return {
            count = 0,
            error = RuntimeError.none,
        };
    }
    if (buffer == null) {
        return {
            count = 0,
            error = RuntimeError.bad_address,
        };
    }

    return runtime_io_result_from_raw(
        luna_linux_syscall3(
            LinuxSystemCall.write as usize,
            file.descriptor as usize,
            buffer as usize,
            length
        ),
        length
    );
}

fn runtime_memory_map(length: usize) -> RuntimeMemoryResult {
    if (length == 0) {
        return runtime_invalid_memory_result(RuntimeError.invalid_argument);
    }

    let result: isize = luna_linux_syscall6(
        LinuxSystemCall.map_memory as usize,
        0,
        length,
        LinuxMemoryProtection.read_write as usize,
        LinuxMemoryFlags.private_anonymous as usize,
        LinuxDescriptor.invalid as isize as usize,
        0
    );
    let error: RuntimeError = runtime_error_from_raw(result);
    if (error != RuntimeError.none) {
        return runtime_invalid_memory_result(error);
    }
    if (result == 0) {
        luna_linux_syscall2(
            LinuxSystemCall.unmap_memory as usize,
            0,
            length
        );
        return runtime_invalid_memory_result(RuntimeError.io);
    }
    return {
        memory = {
            address = result as usize as *u8,
            length = length,
        },
        error = RuntimeError.none,
    };
}

fn runtime_memory_unmap(memory: RuntimeMemory) -> RuntimeError {
    if (memory.address == null || memory.length == 0) {
        return RuntimeError.invalid_argument;
    }
    return runtime_error_from_raw(
        luna_linux_syscall2(
            LinuxSystemCall.unmap_memory as usize,
            memory.address as usize,
            memory.length
        )
    );
}
