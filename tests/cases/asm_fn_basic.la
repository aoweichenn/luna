module tests.asm_fn_basic;

// An asm fn is an ordinary System V function whose whole body is raw
// assembly: no prologue, epilogue or ret is emitted, so each body ends
// with its own ret. Calls (direct or through a pointer) need no
// caller-side support.

asm fn add_pair(left: i64, right: i64) -> i64 {
    "leaq (%rdi,%rsi), %rax\n"
    "ret\n"
}

asm fn pick_second(first: i64, second: i64) -> i64 {
    "movq %rsi, %rax\n"
    "ret\n"
}

// Multiple adjacent string parts concatenate into one body (m1.4).
asm fn add_three(first: i64, second: i64, third: i64) -> i64 {
    "leaq (%rdi,%rsi), %rax\n"
    "addq %rdx, %rax\n"
    "ret\n"
}

fn main() -> i32 {
    if (add_pair(19, 23) != 42) {
        return 1;
    }
    if (pick_second(1, 42) != 42) {
        return 2;
    }
    if (add_three(40, 1, 1) != 42) {
        return 3;
    }
    let indirect: fn(i64, i64) -> i64 = add_pair;
    if (indirect(21, 21) != 42) {
        return 4;
    }
    return 42;
}
