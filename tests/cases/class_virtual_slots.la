module tests.class_virtual_slots;

class Base {
    pub init();
    pub virtual fn first() const -> i32;
    pub virtual fn second(value: i32) const -> i32;
}

class Derived : Base {
    pub init();
    pub override fn second(value: i32) const -> i32;
    pub virtual fn third() -> i32;
}

class Leaf : Derived {
    pub init();
    pub override fn first() const -> i32;
    pub override fn third() -> i32;
}

impl Base {
    init() {
    }

    fn first() const -> i32 {
        return 1;
    }

    fn second(value: i32) const -> i32 {
        return value;
    }
}

impl Derived {
    init() {
        super.init();
    }

    fn second(value: i32) const -> i32 {
        return value + 1;
    }

    fn third() -> i32 {
        return 3;
    }
}

impl Leaf {
    init() {
        super.init();
    }

    fn first() const -> i32 {
        return 10;
    }

    fn third() -> i32 {
        return 11;
    }
}

fn first(value: *const Base) -> i32 {
    return value->first();
}

fn second(value: *const Base) -> i32 {
    return value->second(20);
}

fn third(value: *Derived) -> i32 {
    return value->third();
}

fn main() -> i32 {
    var value: Leaf = Leaf();
    let base: *const Base = (&value) as *const Base;
    let derived: *Derived = (&value) as *Derived;
    return first(base) + second(base) + third(derived);
}
