module tests.bitfields_basic;

struct Flags {
    raw: u32 @bits(ready: 1, error: 1, level: 6, reserved: 24);
}

struct SignedFields {
    word: i32 @bits(value: 6, rest: 26);
}

struct SmallFields {
    byte: u8 @bits(low: 3, high: 5);
}

struct MultiFields {
    first: u16 @bits(a: 4, b: 12);
    plain: u8;
    second: u16 @bits(c: 8, d: 8);
}

@packed struct PackedBits {
    tag: u8;
    raw: u32 @bits(x: 4, y: 28);
}

@align(8) struct AlignedFlags {
    raw: u32 @bits(p: 1, q: 31);
}

struct PrefixFields {
    @align(4) tag: u8;
    raw: u16 @bits(low: 8, high: 8);
}

fn main() -> i32 {
    var f: Flags = { raw = 0 };
    if (offsetof(Flags, raw) != 0 || sizeof(Flags) != 4 || alignof(Flags) != 4) {
        return 1;
    }
    f.ready = 1;
    if (f.raw != 1) {
        return 2;
    }
    f.error = 1;
    if (f.raw != 3) {
        return 3;
    }
    f.level = 42;
    if (f.raw != 171) {
        return 4;
    }
    if (f.ready != 1 || f.error != 1 || f.level != 42 || f.reserved != 0) {
        return 5;
    }
    f.level = 0;
    if (f.raw != 3 || f.ready != 1 || f.error != 1) {
        return 6;
    }
    f.reserved = 16777215;
    if (f.raw != 4294967043) {
        return 7;
    }
    f.level = 5;
    f.level += 3;
    if (f.level != 8) {
        return 8;
    }
    if (f.ready != 1 || f.error != 1 || f.raw != 4294967075) {
        return 9;
    }
    f.raw = 0;
    if (f.ready != 0 || f.error != 0 || f.level != 0 || f.reserved != 0) {
        return 10;
    }
    let p: *Flags = &f;
    p->level = 42;
    if (p->level != 42 || f.raw != 168) {
        return 11;
    }
    p->ready = 1;
    if (f.raw != 169 || p->ready != 1 || p->error != 0) {
        return 12;
    }
    var s: SignedFields = { word = 0 };
    s.value = -3;
    if (s.value != -3) {
        return 13;
    }
    if (s.word != 61) {
        return 14;
    }
    s.rest = -2;
    if (s.rest != -2 || s.value != -3) {
        return 15;
    }
    if (s.word != -67) {
        return 16;
    }
    s.value = 100;
    if (s.value != -28) {
        return 17;
    }
    var b: SmallFields = { byte = 0 };
    b.low = 5;
    b.high = 17;
    if (b.byte != 141) {
        return 18;
    }
    if (b.low != 5 || b.high != 17) {
        return 19;
    }
    var m: MultiFields = {};
    m.a = 7;
    m.b = 2748;
    m.c = 18;
    m.d = 254;
    if (m.first != 43975 || m.second != 65042) {
        return 20;
    }
    if (m.a != 7 || m.b != 2748 || m.c != 18 || m.d != 254) {
        return 21;
    }
    volatile var v: Flags = { raw = 0 };
    v.level = 9;
    if (v.raw != 36) {
        return 22;
    }
    v.ready = 1;
    if (v.raw != 37 || v.level != 9) {
        return 23;
    }
    let g: Flags = { raw = 5 };
    if (g.ready != 1 || g.error != 0 || g.level != 1) {
        return 24;
    }
    var pb: PackedBits = {};
    if (offsetof(PackedBits, raw) != 1 || sizeof(PackedBits) != 5 || alignof(PackedBits) != 1) {
        return 25;
    }
    pb.x = 3;
    pb.y = 19088743;
    if (pb.x != 3 || pb.y != 19088743) {
        return 26;
    }
    if (pb.raw != 305419891) {
        return 27;
    }
    if (alignof(AlignedFlags) != 8 || sizeof(AlignedFlags) != 8) {
        return 28;
    }
    var af: AlignedFlags = {};
    af.q = 2147483647;
    af.p = 1;
    if (af.raw != 4294967295 || af.p != 1 || af.q != 2147483647) {
        return 29;
    }
    var pf: PrefixFields = {};
    if (offsetof(PrefixFields, raw) != 2 || sizeof(PrefixFields) != 4 || alignof(PrefixFields) != 4) {
        return 30;
    }
    pf.low = 18;
    pf.high = 52;
    if (pf.raw != 13330 || pf.low != 18 || pf.high != 52) {
        return 31;
    }
    return 42;
}
