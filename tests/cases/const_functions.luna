module tests.const_functions;

const fn align_up(value: usize, alignment: usize) -> usize {
    return (value + alignment - 1) & ~(alignment - 1);
}

const fn clamp(value: i32, low: i32, high: i32) -> i32 {
    if (value < low) {
        return low;
    }
    return value > high ? high : value;
}

const fn twice(value: usize) -> usize {
    return value * 2;
}

const fn quad(value: usize) -> usize {
    return twice(twice(value));
}

const fn factorial(value: i64) -> i64 {
    if (value <= 1) {
        return 1;
    }
    return value * factorial(value - 1);
}

const fn combine(a: i32, b: i32) -> i32 {
    var result: i32 = a + b;
    result = result * 2;
    let doubled: i32 = result;
    const FOUR: i32 = 4;
    result = doubled + FOUR;
    return result;
}

const fn is_nonzero(value: i32) -> bool {
    return value != 0;
}

const LIMIT: usize = clamp(900, 0, 100);
const NEG: i32 = clamp(-15, -10, 10);
const PADDED: usize = align_up(4097, 64);

enum Levels: u8 { low = clamp(1, 0, 3) as u8, high }

assert(align_up(1, 64) == 64);
assert(LIMIT == 100);
assert(NEG == -10);
assert(PADDED == 4160);
assert(quad(3) == 12);
assert(factorial(10) == 3628800);
assert(combine(1, 2) == 10);
assert(is_nonzero(5));
assert(Levels.high as usize == 2);

fn main() -> i32 {
    var scratch: [align_up(4096, 64)]u8 = {};
    scratch[0] = 7;
    scratch[4095] = 9;
    if (scratch[0] != 7 || scratch[4095] != 9) {
        return 1;
    }
    if (sizeof([align_up(4096, 64)]u8) != 4096) {
        return 2;
    }
    if (LIMIT != 100 || NEG != -10 || PADDED != 4160) {
        return 3;
    }
    var levels: [Levels.high]u8 = {};
    levels[1] = 4;
    if (sizeof([Levels.high]u8) != 2 || levels[1] != 4) {
        return 4;
    }
    @align(align_up(3, 8)) var padded: [8]u8 = {};
    padded[0] = 1;
    let address: usize = (&padded) as usize;
    if (address % 8 != 0 || padded[0] != 1) {
        return 5;
    }
    const LOCAL_LIMIT: usize = factorial(5);
    if (LOCAL_LIMIT != 120) {
        return 6;
    }
    return 42;
}
