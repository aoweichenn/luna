module tests.move_construction;

import luna.std.utility as utility;

class Box {
    priv value: i32;
    priv destroyed: *i32;

    pub init(value: i32, destroyed: *i32);
    pub init(other: Box const&);
    pub init(other: Box&&);
    pub operator =(other: Box const&);
    pub operator =(other: Box&&);
    pub fn get() const -> i32;
    pub deinit();
}

impl Box {
    init(value: i32, destroyed: *i32) {
        this->value = value;
        this->destroyed = destroyed;
    }

    init(other: Box const&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
    }

    init(other: Box&&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
        other.value = -1;
    }

    operator =(other: Box const&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
    }

    operator =(other: Box&&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
        other.value = -1;
    }

    fn get() const -> i32 {
        return this->value;
    }

    deinit() {
        *this->destroyed += 1;
    }
}

fn exercise(destroyed: *i32) -> i32 {
    var source: Box = Box(42, destroyed);
    let copied: Box = source;
    let moved: Box = utility::move(source);
    var assigned: Box = Box(0, destroyed);
    assigned = copied;
    if (copied.get() != 42 || moved.get() != 42) {
        return 1;
    }
    source = utility::move(assigned);
    let move_state_is_valid: bool = source.get() == 42 && assigned.get() == -1;
    return move_state_is_valid ? 0 : 2;
}

fn main() -> i32 {
    var destroyed: i32 = 0;
    let status: i32 = exercise(&destroyed);
    return status == 0 && destroyed == 4 ? 0 : 1;
}
