module tests.trivial_relocation;

struct PlainRecord {
    first: u64;
    second: usize;
}

class Resource {
    priv value: i32;

    pub init(value: i32);
    pub init(other: Resource&&);
    pub fn get() const -> i32;
    pub deinit();
}

impl Resource {
    init(value: i32) {
        this->value = value;
    }

    init(other: Resource&&) {
        this->value = other.value;
        other.value = -1;
    }

    fn get() const -> i32 {
        return this->value;
    }

    deinit() {
    }
}

fn is_relocatable<Value>(value: Value const&) -> bool {
    return @is_trivially_relocatable(Value);
}

assert(@is_trivially_relocatable(PlainRecord));
assert(!@is_trivially_relocatable(Resource));

fn main() -> i32 {
    let record: PlainRecord = { first = 10, second = 20 };
    let resource: Resource = Resource(42);
    let record_is_valid: bool = is_relocatable(record);
    let resource_is_valid: bool = !is_relocatable(resource);
    return record_is_valid && resource_is_valid ? 0 : 1;
}
