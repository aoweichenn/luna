module tests.type_table_validation;

import luna.compiler.types as type_info;
import luna.runtime as runtime;
import luna.std.utility as utility;

fn main() -> i32 {
    var table: type_info::TypeTable = type_info::TypeTable();
    if (table.error() != runtime::Error.none) {
        return 1;
    }
    if (!table.is_valid()) {
        return 2;
    }

    let pointer: type_info::IdResult = table.pointer(type_info::BuiltinType.unsigned_8 as usize, true);
    let duplicate_pointer: type_info::IdResult = table.pointer(type_info::BuiltinType.unsigned_8 as usize, true);
    let pointer_was_reused: bool = pointer.type_id == duplicate_pointer.type_id;
    if (pointer.error != runtime::Error.none || !pointer_was_reused) {
        return 3;
    }

    let reference: type_info::IdResult =
        table.reference(type_info::BuiltinType.signed_32 as usize, false, true);
    if (reference.error != runtime::Error.none) {
        return 4;
    }
    let array: type_info::IdResult = table.array(type_info::BuiltinType.unsigned_16 as usize, 4);
    if (array.error != runtime::Error.none) {
        return 5;
    }

    let callable: type_info::IdResult = table.add_function_pointer(type_info::BuiltinType.signed_32 as usize);
    if (callable.error != runtime::Error.none) {
        return 6;
    }
    let callable_id: usize = callable.type_id;
    if (table.add_parameter(callable_id, type_info::BuiltinType.unsigned_64 as usize) != runtime::Error.none) {
        return 7;
    }
    if (table.set_layout(callable_id, 8, 8) != runtime::Error.none) {
        return 8;
    }
    if (!table.is_valid()) {
        return 9;
    }

    var moved: type_info::TypeTable = utility::move(table);
    let move_state_is_valid: bool = moved.is_valid() && table.storage_is_valid();
    if (!move_state_is_valid || table.size() != 0) {
        return 10;
    }

    let records: *type_info::Record = moved.record_data();
    let pointer_size: usize = records[pointer.type_id].size_bytes;
    records[pointer.type_id].size_bytes = pointer_size - 1;
    if (moved.is_valid()) {
        return 11;
    }
    records[pointer.type_id].size_bytes = pointer_size;

    let array_count: usize = records[array.type_id].element_count;
    records[array.type_id].element_count = array_count + 1;
    if (moved.is_valid()) {
        return 12;
    }
    records[array.type_id].element_count = array_count;

    records[reference.type_id].flags |= 2048;
    if (moved.is_valid()) {
        return 13;
    }
    records[reference.type_id].flags &= ~2048;

    return moved.is_valid() ? 0 : 14;
}
