module tests.overload_nested_once;

fn bump(counter: *i32) -> i32 {
    *counter += 1;
    return *counter;
}

fn select(value: i32) -> i32 {
    return value;
}

fn select(value: u32) -> i32 {
    return value as i32;
}

fn main() -> i32 {
    var counter: i32 = 0;
    let selected: i32 = select(bump(&counter));
    if (selected != 1 || counter != 1) {
        return 1;
    }
    return 42;
}
