module tests.goto_basic;

fn main() -> i32 {
    var total: i32 = 0;

    // Forward goto skips statements.
    total = 1;
    goto skip;
    total = 100;
skip:
    total += 1;
    if (total != 2) {
        return 1;
    }

    // Backward goto forming a loop.
    var count: i32 = 0;
again:
    count += 1;
    if (count < 6) {
        goto again;
    }
    if (count != 6) {
        return 2;
    }

    // The cleanup pattern.
    var stage: i32 = 0;
    stage = 1;
    if (stage == 1) {
        goto cleanup;
    }
    stage = 2;
cleanup:
    total += stage;
    if (total != 3) {
        return 3;
    }

    // Goto into a block where no initialization is bypassed: x is
    // declared before the goto and stays live at the label.
    var x: i32 = 5;
    goto inside;
    {
        x += 1;
inside:
        x += 10;
    }
    if (x != 15) {
        return 4;
    }

    // Label after declarations; jumping back re-runs the
    // initialization of y.
    var runs: i32 = 0;
restart:
    var y: i32 = 7;
    runs += 1;
    total += y;
    if (runs < 2) {
        goto restart;
    }
    if (total != 17) {
        return 5;
    }

    // Goto into a loop body from outside: allowed because the subset
    // rule holds (no live local is introduced between goto and
    // label); the loop keeps iterating normally afterwards.
    var hits: i32 = 0;
    var steps: i32 = 0;
    goto mid;
    while (steps < 3) {
        steps += 1;
mid:
        hits += 1;
    }
    if (hits != 4 || steps != 3) {
        return 6;
    }

    return 42;
}
