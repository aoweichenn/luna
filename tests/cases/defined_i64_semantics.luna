module tests.defined_i64_semantics;

fn main() -> i32 {
    let wrapped: i64 = 9223372036854775807 + 1;
    let multiplied: i64 = 9223372036854775807 * 2;
    let shifted_left: i64 = 1 << 64;
    let shifted_right: i64 = -1 >> 64;
    let negated_minimum: i64 = 0 - -9223372036854775808;

    if (wrapped == -9223372036854775808
        && multiplied == -2
        && shifted_left == 1
        && shifted_right == -1
        && negated_minimum == -9223372036854775808) {
        return 42;
    }
    return 1;
}
