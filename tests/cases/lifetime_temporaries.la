module tests.lifetime_temporaries;

class Tracker {
    priv value: i32;
    priv destroyed: *i32;

    pub init(value: i32, destroyed: *i32);
    pub init(other: Tracker const&);
    pub init(other: Tracker&&);
    pub fn get() const -> i32;
    pub deinit();
}

impl Tracker {
    init(value: i32, destroyed: *i32) {
        this->value = value;
        this->destroyed = destroyed;
    }

    init(other: Tracker const&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
    }

    init(other: Tracker&&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
        other.value = -1;
    }

    fn get() const -> i32 {
        return this->value;
    }

    deinit() {
        *this->destroyed += 1;
    }
}

fn make(value: i32, destroyed: *i32) -> Tracker {
    return Tracker(value, destroyed);
}

fn consume(value: Tracker) -> i32 {
    return value.get();
}

fn truth(value: Tracker const&) -> bool {
    return value.get() != 0;
}

fn exercise(destroyed: *i32) -> i32 {
    Tracker(1, destroyed);
    let view: Tracker const& = Tracker(2, destroyed);
    let returned: Tracker = make(3, destroyed);
    let skipped: bool = false && truth(Tracker(5, destroyed));
    let taken: bool = true && truth(Tracker(6, destroyed));
    let conditional: Tracker = true ? Tracker(7, destroyed) : Tracker(8, destroyed);
    if (view.get() != 2 || returned.get() != 3) {
        return 1;
    }
    if (skipped || !taken || conditional.get() != 7) {
        return 4;
    }
    if (consume(returned) != 3 || consume(Tracker(4, destroyed)) != 4) {
        return 2;
    }
    return *destroyed == 5 ? 0 : 3;
}

fn main() -> i32 {
    var destroyed: i32 = 0;
    let status: i32 = exercise(&destroyed);
    return status == 0 && destroyed == 8 ? 0 : 1;
}
