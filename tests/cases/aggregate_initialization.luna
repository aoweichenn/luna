module tests.aggregate_initialization;

enum Kind: u8 {
    empty,
    ready = 7,
}

struct Inner {
    tag: u8;
    value: i32;
}

union Number {
    integer: i64;
    real: f64;
    byte: u8;
}

struct State {
    kind: Kind;
    inner: Inner;
    number: Number;
    values: [2]i32;
    tail: u16;
}

fn next(counter: *i32) -> i32 {
    *counter += 1;
    return *counter;
}

fn main() -> i32 {
    var counter: i32 = 0;
    var ordered: Inner = {
        value = next(&counter),
        tag = next(&counter) as u8,
    };
    var values: [2]i32 = {};
    values[0] = 20;
    values[1] = 22;

    var first: State = {
        tail = 9,
        number = { byte = 99, },
        inner = { value = 40, },
        values = values,
        kind = Kind.ready,
    };
    var second: State = first;
    let pointer: *State = &second;
    pointer->inner = {
        value = true ? 42 : 0,
        tag = {},
    };
    second.values = {};
    second = {
        kind = second.kind,
        inner = { value = second.inner.value, },
    };

    if (ordered.value != 1 ||
        ordered.tag != 2 ||
        first.inner.tag != 0 ||
        first.inner.value != 40 ||
        first.number.integer != 99 ||
        first.values[0] + first.values[1] != 42 ||
        first.tail != 9 ||
        second.kind != Kind.ready ||
        second.inner.tag != 0 ||
        second.values[0] != 0 ||
        second.values[1] != 0) {
        return 1;
    }
    return pointer->inner.value;
}
