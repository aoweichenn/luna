module tests.class_value_semantics;

class Packet {
    pub tag: u8;
    priv value: i32;

    pub init(tag: u8, value: i32);
    pub fn read() const -> i32;
}

impl Packet {
    init(tag: u8, value: i32) {
        this->tag = tag;
        this->value = value;
    }

    fn read() const -> i32 {
        return this->value;
    }
}

fn pass(value: Packet) -> Packet {
    return value;
}

fn main() -> i32 {
    if (sizeof(Packet) != 8 || alignof(Packet) != 4) {
        return 1;
    }
    var original: Packet = Packet(1, 41);
    var copy: Packet = pass(original);
    copy = original;
    copy.tag = 2;
    if (original.tag != 1 || copy.tag != 2) {
        return 2;
    }
    return copy.read() + 1;
}
