module tests.fail_class_bound_mutable_receiver;

type Callback = method fn() -> i32;

class Value {
    pub init();
    pub fn mutate() -> i32;
}

impl Value {
    init() {
    }

    fn mutate() -> i32 {
        return 42;
    }
}

fn bind(value: *const Value) -> Callback {
    return value->mutate;
}

fn main() -> i32 {
    let value: Value = Value();
    return bind(&value)();
}
