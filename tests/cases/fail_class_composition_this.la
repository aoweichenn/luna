module tests.fail_class_composition_this;

class Child {
    pub init(value: i32);
}

class Parent {
    priv child: Child;

    pub init();
    pub fn seed() const -> i32;
}

impl Child {
    init(value: i32) {
    }
}

impl Parent {
    init() : child = Child(this->seed()) {
    }

    fn seed() const -> i32 {
        return 42;
    }
}

fn main() -> i32 {
    return 0;
}
