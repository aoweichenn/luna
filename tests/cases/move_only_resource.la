module tests.move_only_resource;

import luna.std.utility as utility;

class Resource {
    priv value: i32;
    priv destroyed: *i32;

    pub init(value: i32, destroyed: *i32);
    pub init(other: Resource&&);
    pub fn get() const -> i32;
    pub deinit();
}

impl Resource {
    init(value: i32, destroyed: *i32) {
        this->value = value;
        this->destroyed = destroyed;
    }

    init(other: Resource&&) {
        this->value = other.value;
        this->destroyed = other.destroyed;
        other.value = -1;
    }

    fn get() const -> i32 {
        return this->value;
    }

    deinit() {
        *this->destroyed += 1;
    }
}

fn exercise(destroyed: *i32) -> i32 {
    var source: Resource = Resource(42, destroyed);
    let target: Resource = utility::move(source);
    return source.get() == -1 && target.get() == 42 ? 0 : 1;
}

fn main() -> i32 {
    var destroyed: i32 = 0;
    let status: i32 = exercise(&destroyed);
    return status == 0 && destroyed == 2 ? 0 : 1;
}
