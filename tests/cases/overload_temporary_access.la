module tests.overload_temporary_access;

struct Box {
    value: i32;
}

fn make_box() -> Box {
    return {value = 20,};
}

fn make_values() -> [2]i32 {
    return {0, 22};
}

fn select(value: i32) -> i32 {
    return value;
}

fn select(value: u32) -> i32 {
    return value as i32;
}

fn main() -> i32 {
    return select(make_box().value) + select(make_values()[1]);
}
