module tests.generic_private_move;

import luna.std.utility as utility;
import tests.modules.generic_move_wrapper::{wrapper};

class Resource {
    priv value: i32;

    pub init(value: i32);
    pub init(other: Resource&&);
    pub fn get() const -> i32;
    pub deinit();
}

impl Resource {
    init(value: i32) {
        this->value = value;
    }

    init(other: Resource&&) {
        this->value = other.value;
        other.value = -1;
    }

    fn get() const -> i32 {
        return this->value;
    }

    deinit() {
    }
}

fn main() -> i32 {
    var resource: Resource = Resource(42);
    let wrapped: wrapper<Resource> = wrapper<Resource>(utility::move(resource));
    return 0;
}
