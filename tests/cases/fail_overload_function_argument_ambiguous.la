module tests.fail_overload_function_argument_ambiguous;

fn transform(value: i32) -> i32 {
    return value;
}

fn transform(value: u32) -> i32 {
    return value as i32;
}

fn choose(callback: fn(i32) -> i32) -> i32 {
    return callback(1);
}

fn choose(callback: fn(u32) -> i32) -> i32 {
    return callback(1 as u32);
}

fn main() -> i32 {
    return choose(transform);
}
