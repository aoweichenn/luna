module tests.labeled_loops;

fn main() -> i32 {
    var total: i32 = 0;

    // break outer from doubly-nested for loops.
    outer: for (var row: usize = 0; row < 10; row += 1) {
        for (var col: usize = 0; col < 10; col += 1) {
            if (row == 3) {
                break outer;
            }
            total += 1;
        }
    }
    if (total != 30) {
        return 1;
    }

    // continue outer skips the rest of the outer body for that row.
    total = 0;
    rows: for (var row: usize = 0; row < 5; row += 1) {
        for (var col: usize = 0; col < 5; col += 1) {
            if (col == 2) {
                continue rows;
            }
            total += 1;
        }
        total += 100;
    }
    if (total != 10) {
        return 2;
    }

    // Labeled while with a labeled continue.
    var count: i32 = 0;
    var n: i32 = 0;
    spin: while (n < 8) {
        n += 1;
        if (n % 2 == 0) {
            continue spin;
        }
        count += 1;
    }
    if (count != 4) {
        return 3;
    }

    // Labeled do-while with a labeled break.
    n = 0;
    dwell: do {
        n += 1;
        if (n == 5) {
            break dwell;
        }
    } while (n < 100);
    if (n != 5) {
        return 4;
    }

    // Labeled loop with break and continue from a nested while.
    total = 0;
    n = 0;
    forever: loop {
        n += 1;
        var inner: i32 = 0;
        while (inner < 3) {
            inner += 1;
            if (n >= 4) {
                break forever;
            }
            continue forever;
        }
        total += 1;
    }
    if (n != 4 || total != 0) {
        return 5;
    }

    // Unlabeled break still targets the innermost loop, not the
    // labeled outer one.
    total = 0;
    labeled: for (var i: usize = 0; i < 3; i += 1) {
        for (var j: usize = 0; j < 10; j += 1) {
            if (j == 2) {
                break;
            }
            total += 1;
        }
    }
    if (total != 6) {
        return 6;
    }

    // Labeled break from inside a switch nested in the loop.
    n = 0;
    picking: while (n < 10) {
        n += 1;
        switch (n) {
            case 3 {
                break picking;
            }
            default {
            }
        }
    }
    if (n != 3) {
        return 7;
    }

    return 42;
}
