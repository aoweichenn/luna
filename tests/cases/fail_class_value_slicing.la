module tests.fail_class_value_slicing;

class Base {
    pub init();
}

class Derived : Base {
    pub init();
}

impl Derived {
    init() {
        super.init();
    }
}

impl Base {
    init() {
    }
}

fn consume(value: Base) -> i32 {
    return 42;
}

fn main() -> i32 {
    let value: Derived = Derived();
    return consume(value);
}
