module tests.flexible_member;

struct InotifyEvent {
    wd: i32;
    mask: u32;
    cookie: u32;
    length: u32;
    name: [?]u8;
}

struct PaddedHeader {
    a: u64;
    b: u8;
    data: [?]u32;
}

assert(sizeof(InotifyEvent) == 16 && offsetof(InotifyEvent, name) == 16 && alignof(InotifyEvent) == 4);
assert(offsetof(PaddedHeader, data) == 12 && sizeof(PaddedHeader) == 16 && alignof(PaddedHeader) == 8);

fn main() -> i32 {
    if (sizeof(InotifyEvent) != 16 || offsetof(InotifyEvent, name) != 16 || alignof(InotifyEvent) != 4) {
        return 1;
    }
    if (offsetof(PaddedHeader, data) != 12 || sizeof(PaddedHeader) != 16 || alignof(PaddedHeader) != 8) {
        return 2;
    }
    var backing: [64]u8 = {};
    let event: *InotifyEvent = (&backing) as *InotifyEvent;
    event->wd = 7;
    event->mask = 305419896;
    event->cookie = 4242;
    event->length = 5;
    var index: usize = 0;
    while (index < 5) {
        event->name[index] = (index + 65) as u8;
        index += 1;
    }
    if (event->wd != 7 || event->mask != 305419896 || event->cookie != 4242 || event->length != 5) {
        return 3;
    }
    if (backing[0] != 7 || backing[16] != 65 || backing[17] != 66 || backing[20] != 69) {
        return 4;
    }
    if (event->name[0] != 65 || event->name[4] != 69) {
        return 5;
    }
    let start: *u8 = event->name;
    let last: *u8 = start + (4 as usize);
    if (last - start != 4 || *last != 69) {
        return 6;
    }
    var cursor: *u8 = start;
    cursor += 2;
    if (*cursor != 67 || *(cursor - (1 as usize)) != 66) {
        return 7;
    }
    let padded: *PaddedHeader = (&backing) as *PaddedHeader;
    padded->a = 18446744073709551615;
    padded->b = 9;
    padded->data[0] = 1122867;
    if (padded->a != 18446744073709551615 || padded->b != 9 || padded->data[0] != 1122867) {
        return 8;
    }
    if (backing[12] != 51) {
        return 9;
    }
    return 42;
}
