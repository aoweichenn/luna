module tests.class_direct_methods;

class Counter {
    priv value: i32;
    priv untouched: i32;
    priv next: *Counter;

    pub init(value: i32 = 40);
    pub fn get() const -> i32;
    pub fn add(delta: i32 = 2);
    pub static fn answer(value: i32 = 42) -> i32;
}

impl Counter {
    init(value: i32) {
        this->value = value;
    }

    fn get() const -> i32 {
        return this->secret();
    }

    fn add(delta: i32) {
        this->value += delta;
    }

    static fn answer(value: i32) -> i32 {
        return value;
    }

    priv fn secret() const -> i32 {
        return this->value + this->untouched;
    }
}

fn make(calls: *i32) -> Counter {
    *calls += 1;
    return Counter();
}

fn main() -> i32 {
    var counter: Counter = Counter();
    counter.add();
    let mutable_view: *Counter = &counter;
    mutable_view->add(0);
    let view: *const Counter = (&counter) as *const Counter;
    if (view->get() != 42) {
        return 1;
    }
    if (Counter.answer() != 42 || Counter.answer(7) != 7) {
        return 2;
    }
    var calls: i32 = 0;
    if (make(&calls).get() != 40 || calls != 1) {
        return 3;
    }
    return counter.get();
}
