module tests.break_continue;

fn main() -> i32 {
    var index: i32 = 0;
    var total: i32 = 0;

    while (index < 10) {
        index += 1;
        if (index == 3) {
            continue;
        }
        if (index == 8) {
            break;
        }
        total += index;
    }

    return total;
}
