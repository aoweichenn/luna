module tests.overload_calls;

fn choose(value: i32) -> i32 {
    return value + 10;
}

fn choose(value: u32) -> i32 {
    return value as i32 + 20;
}

fn choose(value: f32) -> i32 {
    return value as i32 + 12;
}

fn arity(value: i32) -> i32 {
    return value;
}

fn arity(left: i32, right: i32) -> i32 {
    return left + right;
}

fn main() -> i32 {
    var signed_value: i32 = 1;
    var unsigned_value: u32 = 2;
    if (choose(signed_value) != 11 || choose(unsigned_value) != 22) {
        return 1;
    }
    if (choose(30.0 as f32) != 42) {
        return 2;
    }
    return arity(20 as i32, 22 as i32);
}
