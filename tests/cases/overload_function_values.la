module tests.overload_function_values;

fn transform(value: i32) -> i64 {
    return value as i64 + 1;
}

fn transform(value: f32) -> f64 {
    return value as f64 + 2.0;
}

fn main() -> i32 {
    let integer: fn(i32) -> i64 = transform;
    let floating: fn(f32) -> f64 = &transform;
    if (integer(41) != 42 || floating(40.0 as f32) != 42.0) {
        return 1;
    }
    return 42;
}
