module tests.class_inheritance_import;

import tests.modules.inheritance_api as api;

class Derived : api::Base {
    pub init(value: i32);
    pub fn choose(value: u32) const -> i32;
    pub override fn dynamic_value() const -> i32;
}

impl Derived {
    init(value: i32) {
        super.init(value);
    }

    fn choose(value: u32) const -> i32 {
        return this->stored + value as i32 + 2;
    }

    fn dynamic_value() const -> i32 {
        return this->stored + 22;
    }
}

fn main() -> i32 {
    let value: Derived = Derived(20);
    if (value.choose(22 as i32) != 42 || value.choose(20 as u32) != 42) {
        return 1;
    }
    let base: *const api::Base = (&value) as *const api::Base;
    return base->dynamic_value();
}
