module tests.aggregate_types;

enum StateKind: u8 {
    empty,
    ready = 7,
    complete,
}

enum ByteCount: usize {
    zero,
}

struct Payload {
    small: u8;
    wide: u64;
}

union NumberBits {
    whole: u64;
    low: u8;
}

struct State {
    kind: StateKind;
    payload: Payload;
    bits: NumberBits;
    values: [2]u16;
    next: *State;
}

struct Forward {
    later: Later;
}

struct Later {
    value: u32;
    owner: *Forward;
}

fn main() -> i32 {
    let object_bytes: ByteCount =
        sizeof([2][3][4]Payload) as ByteCount;
    let empty_kind: StateKind = true ? {} : {};
    var state: State = {};
    var payloads: [2]Payload = {};
    var forward: Forward = {};
    state.kind = StateKind.ready;
    state.payload.small = 3;
    state.payload.wide = 29;
    state.bits.whole = 42;
    state.values[1] = 8;
    payloads[1].wide = 42;
    forward.later.value = 42;
    forward.later.owner = &forward;

    let pointer: *State = &state;
    pointer->next = pointer;
    pointer->payload.wide = pointer->payload.wide + 5;

    let raw_kind: u8 = state.kind as u8;
    let restored: StateKind = raw_kind as StateKind;
    if (sizeof(State) != 48 ||
        alignof(State) != 8 ||
        offsetof(State, kind) != 0 ||
        offsetof(State, payload) != 8 ||
        offsetof(State, bits) != 24 ||
        offsetof(State, values) != 32 ||
        offsetof(State, next) != 40 ||
        sizeof(*State) != 8 ||
        sizeof([3]u16) != 6 ||
        sizeof(StateKind) != 1 ||
        alignof(Payload) != 8 ||
        offsetof(NumberBits, low) != 0 ||
        (object_bytes as usize) != 384 ||
        empty_kind != StateKind.empty ||
        payloads[1].wide != 42 ||
        forward.later.owner->later.value != 42 ||
        state.bits.low != 42 ||
        pointer->payload.small + (pointer->payload.wide as u8) != 37 ||
        pointer->values[1] != 8 ||
        pointer->next->kind != StateKind.ready ||
        pointer[0].kind != StateKind.ready) {
        return 1;
    }

    switch (restored) {
        case StateKind.ready {
            return 42;
        }
        default {
            return 2;
        }
    }
}
