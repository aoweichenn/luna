module tests.class_composition_polymorphic;

class Base {
    pub init();
    pub virtual fn read() const -> i32;
}

class Derived : Base {
    pub init();
    pub override fn read() const -> i32;
}

class Holder {
    priv value: Derived;

    pub init();
    pub fn base() const -> *const Base;
}

impl Base {
    init() {
    }

    fn read() const -> i32 {
        return 1;
    }
}

impl Derived {
    init() {
        super.init();
    }

    fn read() const -> i32 {
        return 42;
    }
}

impl Holder {
    init() : value = Derived() {
    }

    fn base() const -> *const Base {
        return (&this->value) as *const Base;
    }
}

fn main() -> i32 {
    let holder: Holder = Holder();
    let value: *const Base = holder.base();
    return value->read();
}
