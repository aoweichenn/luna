module tests.generic_class;

class Cell<Value> {
    priv value: Value;

    pub init(value: Value);
    pub fn get() const -> Value;
    pub fn replace(value: Value) -> Value;
    pub static fn retain(value: Value) -> Value;
}

impl Cell {
    init(value: Value)
        : value = value {
    }

    fn get() const -> Value {
        return this->value;
    }

    fn replace(value: Value) -> Value {
        let previous: Value = this->value;
        this->value = value;
        return previous;
    }

    static fn retain(value: Value) -> Value {
        return value;
    }
}

class Holder<Value> {
    priv cell: Cell<Value>;

    pub init(value: Value);
    pub fn get() const -> Value;
}

impl Holder {
    init(value: Value)
        : cell = Cell<Value>(value) {
    }

    fn get() const -> Value {
        return this->cell.get();
    }
}

fn main() -> i32 {
    var integer: Cell<i32> = Cell<i32>(10);
    var boolean: Cell<bool> = Cell<bool>(false);
    let previous: i32 = integer.replace(42);
    boolean.replace(true);
    let holder: Holder<i32> = Holder<i32>(88);
    let callback: method fn() -> i32 = integer.get;
    let retained: i32 = Cell<i32>.retain(91);
    if (previous != 10 || integer.get() != 42) {
        return 1;
    }
    if (!boolean.get()) {
        return 2;
    }
    let methods_are_valid: bool = holder.get() == 88 && callback() == 42;
    return methods_are_valid && retained == 91 ? 0 : 3;
}
