module tests.volatile_basic;

fn main() -> i32 {
    volatile var status: u32 = 0;
    status = 10;
    status += 5;
    if (status != 15) {
        return 1;
    }

    var p: *volatile u32 = &status;
    *p = 20;
    if (status != 20) {
        return 2;
    }
    *p += 7;
    if (status != 27) {
        return 3;
    }

    var q: *const volatile u32 = p as *const volatile u32;
    if (*q != 27) {
        return 4;
    }

    var r: *volatile const u32 = q;
    if (*r != 27) {
        return 5;
    }

    volatile let config: u32 = 3;
    if (config != 3) {
        return 6;
    }

    var plain: u32 = status + config;
    if (plain != 30) {
        return 7;
    }

    return 42;
}
