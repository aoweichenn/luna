module tests.class_virtual_dispatch;

class Base {
    prot value: i32;

    pub init(value: i32);
    pub virtual fn read(delta: i32) const -> i32;
}

class Derived : Base {
    pub init(value: i32);
    pub override fn read(delta: i32) const -> i32;
    pub fn base_read(delta: i32) const -> i32;
}

class Leaf : Derived {
    pub init(value: i32);
    pub override fn read(delta: i32) const -> i32;
}

impl Base {
    init(value: i32) {
        this->value = value;
    }

    fn read(delta: i32) const -> i32 {
        return this->value + delta;
    }
}

impl Derived {
    init(value: i32) {
        super.init(value);
    }

    fn read(delta: i32) const -> i32 {
        return this->value + delta + 10;
    }

    fn base_read(delta: i32) const -> i32 {
        return super.read(delta);
    }
}

impl Leaf {
    init(value: i32) {
        super.init(value);
    }

    fn read(delta: i32) const -> i32 {
        return this->value + delta + 20;
    }
}

fn through_base(value: *const Base) -> i32 {
    return value->read(2);
}

fn through_derived(value: *const Derived) -> i32 {
    return value->read(2);
}

fn identity(value: Leaf) -> Leaf {
    return value;
}

fn main() -> i32 {
    let value: Leaf = Leaf(20);
    let copied: Leaf = identity(value);
    let base: *const Base = (&copied) as *const Base;
    let derived: *const Derived = (&copied) as *const Derived;
    if (through_base(base) != 42 || through_derived(derived) != 42) {
        return 1;
    }
    if (copied.read(2) != 42 || copied.base_read(20) != 40) {
        return 2;
    }
    return 42;
}
