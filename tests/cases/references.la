module tests.references;

fn increment(value: i32&) {
    value += 1;
}

fn read(value: i32 const&) -> i32 {
    return value;
}

fn expire<Value>(value: Value&) -> Value&& {
    return value as Value&&;
}

fn advance(value: *i32&) {
    value += 1;
}

fn select(value: i32&) -> i32 {
    return 1;
}

fn select(value: i32&&) -> i32 {
    return 2;
}

fn select(value: i32 const&) -> i32 {
    return 3;
}

fn select_const(value: i32 const&&) -> i32 {
    return value;
}

fn main() -> i32 {
    var value: i32 = 40;
    let alias: i32& = value;
    increment(alias);
    let fixed: i32 = 42;
    if (value != 41 || read(fixed) != 42) {
        return 1;
    }
    if (select(value) != 1 || select(fixed) != 3) {
        return 2;
    }
    var values: [2]i32 = {1, 2};
    var cursor: *i32 = &values[0];
    advance(cursor);
    if (*cursor != 2) {
        return 3;
    }
    if (select_const(fixed as i32 const&&) != 42) {
        return 4;
    }
    return select(expire(value)) == 2 ? 0 : 5;
}
