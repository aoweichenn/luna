module tests.class_composition_import;

import tests.modules.class_api as api;

class Holder {
    priv gauge: api::Gauge;

    pub init(value: i32);
    pub fn read() const -> i32;
}

impl Holder {
    init(value: i32) : gauge = api::Gauge(value) {
    }

    fn read() const -> i32 {
        return this->gauge.value();
    }
}

fn main() -> i32 {
    let holder: Holder = Holder(42);
    return holder.read();
}
