module tests.defined_i32_semantics;

fn main() -> i32 {
    let wrapped: i32 = 2147483647 + 1;
    let shifted_left: i32 = 1 << 32;
    let shifted_right: i32 = -1 >> 32;
    let negated_minimum: i32 = 0 - -2147483648;

    if (wrapped == -2147483648 &&
        shifted_left == 1 &&
        shifted_right == -1 &&
        negated_minimum == -2147483648) {
        return 42;
    }

    return 1;
}
