module tests.wide_strings;

fn main() -> i32 {
    // u16 literals are UTF-16 code units behind *const u16, zero-unit terminated.
    let wide: *const u16 = u16"Hello";
    if (wide[0] != 72 || wide[1] != 101 || wide[2] != 108 || wide[3] != 108 || wide[4] != 111) {
        return 1;
    }
    if (wide[5] != 0) {
        return 2;
    }

    // u32 literals hold one code unit per code point, including astral \u{...} escapes.
    let full: *const u32 = u32"Hi \u{1F600}";
    if (full[0] != 72 || full[1] != 105 || full[2] != 32) {
        return 3;
    }
    if (full[3] != 128512) {
        return 4;
    }
    if (full[4] != 0) {
        return 5;
    }

    // The same astral code point is a surrogate pair in UTF-16.
    let pair: *const u16 = u16"\u{1F600}";
    if (pair[0] != 55357 || pair[1] != 56832) {
        return 6;
    }
    if (pair[2] != 0) {
        return 7;
    }

    // \u{...} in a u8 literal encodes as UTF-8 (0x2764 -> E2 9D A4).
    let heart: *const u8 = "\u{2764}";
    if (heart[0] != 226 || heart[1] != 157 || heart[2] != 164) {
        return 8;
    }
    if (heart[3] != 0) {
        return 9;
    }

    // Adjacent literals of the same width concatenate at translation time.
    let greeting: *const u8 = "Hel" "lo";
    if (greeting[0] != 72 || greeting[1] != 101 || greeting[2] != 108 || greeting[3] != 108 ||
        greeting[4] != 111) {
        return 10;
    }
    if (greeting[5] != 0) {
        return 11;
    }

    // Concatenation spans newlines and works for wide literals.
    let wide_joined: *const u16 = u16"He"
        u16"llo";
    if (wide_joined[0] != 72 || wide_joined[1] != 101 || wide_joined[2] != 108 || wide_joined[3] != 108 ||
        wide_joined[4] != 111) {
        return 12;
    }
    if (wide_joined[5] != 0) {
        return 13;
    }

    // \xHH in a wide literal is a single code unit 0x00HH.
    let escaped: *const u16 = u16"\x41\x42";
    if (escaped[0] != 65 || escaped[1] != 66 || escaped[2] != 0) {
        return 14;
    }

    // Escapes and raw text mix freely in a u32 literal.
    let mixed: *const u32 = u32"A\n\x42";
    if (mixed[0] != 65 || mixed[1] != 10 || mixed[2] != 66 || mixed[3] != 0) {
        return 15;
    }
    return 42;
}
