module tests.fail_class_bound_ambiguous;

type Callback = method fn(i32) -> i32;

class Value {
    pub init();
    pub fn run(value: i32) -> i32;
    pub fn run(value: i32) const -> i32;
}

impl Value {
    init() {
    }

    fn run(value: i32) -> i32 {
        return value;
    }

    fn run(value: i32) const -> i32 {
        return value;
    }
}

fn main() -> i32 {
    var value: Value = Value();
    let callback: Callback = value.run;
    return callback(42);
}
