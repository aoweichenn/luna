module tests.static_assert;

enum PacketKind: u8 {
    control,
    data,
}

struct Packet {
    kind: PacketKind;
    flags: u8;
    sequence: u16;
    payload: [56]u8;
    checksum: u32;
}

assert(sizeof(Packet) == 64);
assert(alignof(Packet) == 4);
assert(offsetof(Packet, checksum) == 60);

fn main() -> i32 {
    assert(1 + 2 == 3);
    assert(true);
    assert(PacketKind.data == 1);
    assert(PacketKind.control < PacketKind.data);
    assert(sizeof(Packet) == 64 && alignof(Packet) == 4);
    assert(sizeof(Packet) == 1 || alignof(Packet) == 4);
    assert((sizeof(Packet) == 64 ? 7 : 8) == 7);
    assert(!(1 == 2));
    assert(~0 == -1);
    assert(-1 < 1);
    assert(7 % 3 == 1 && 7 / 3 == 2);
    assert((1 << 4) == 16);
    assert((255 as u8) == 255);
    assert((255 as i8) == -1);
    assert(offsetof(Packet, payload) == 4);
    return 42;
}
