module tests.class_composition;

class Point {
    priv x: i32;
    priv y: i32;

    pub init(x: i32, y: i32);
    pub fn sum() const -> i32;
}

class Segment {
    priv start: Point;
    priv bias: i32;
    priv finish: Point;

    pub init(first: i32, second: i32, bias: i32, third: i32, fourth: i32);
    pub fn total() const -> i32;
}

impl Point {
    init(x: i32, y: i32) {
        this->x = x;
        this->y = y;
    }

    fn sum() const -> i32 {
        return this->x + this->y;
    }
}

impl Segment {
    init(first: i32, second: i32, bias: i32, third: i32, fourth: i32)
        : start = Point(first, second), bias = bias, finish = Point(third, fourth) {
    }

    fn total() const -> i32 {
        return this->start.sum() + this->bias + this->finish.sum();
    }
}

fn relay(value: Segment) -> Segment {
    return value;
}

fn main() -> i32 {
    let segment: Segment = relay(Segment(10, 11, 1, 9, 11));
    if (sizeof(Segment) != 20 || alignof(Segment) != 4) {
        return 1;
    }
    var assigned: Segment = Segment(0, 0, 0, 0, 0);
    assigned = segment;
    return assigned.total();
}
