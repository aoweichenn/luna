module tests.packed_basic;

@packed struct WireHeader {
    kind: u8;
    length: u32;
}

struct Envelope {
    tag: u8;
    header: WireHeader;
    tail: u16;
}

fn main() -> i32 {
    if (offsetof(WireHeader, kind) != 0 || offsetof(WireHeader, length) != 1 ||
        sizeof(WireHeader) != 5 || alignof(WireHeader) != 1) {
        return 1;
    }
    if (sizeof([4]WireHeader) != 20 || alignof([4]WireHeader) != 1) {
        return 2;
    }
    if (offsetof(Envelope, header) != 1 || offsetof(Envelope, tail) != 6 ||
        sizeof(Envelope) != 8 || alignof(Envelope) != 2) {
        return 3;
    }
    var backing: [8]u8 = {};
    let p: *WireHeader = (&backing) as *WireHeader;
    p->kind = 42;
    p->length = 1234567;
    if (p->kind != 42 || p->length != 1234567) {
        return 4;
    }
    if (backing[0] != 42 || backing[1] != 135 || backing[2] != 214 ||
        backing[3] != 18 || backing[4] != 0) {
        return 5;
    }
    var headers: [3]WireHeader = {};
    headers[1].length = 70000;
    headers[2].kind = 9;
    if (headers[1].length != 70000 || headers[2].kind != 9) {
        return 6;
    }
    let first: usize = (&headers[0]) as usize;
    let second: usize = (&headers[1]) as usize;
    if (second - first != 5) {
        return 7;
    }
    var envelope: Envelope = {};
    envelope.header.length = 300;
    let hp: *WireHeader = &envelope.header;
    if (hp->length != 300) {
        return 8;
    }
    return 42;
}
