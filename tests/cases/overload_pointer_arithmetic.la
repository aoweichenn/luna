module tests.overload_pointer_arithmetic;

fn select(value: *i32) -> i32 {
    return *value;
}

fn select(value: usize) -> i32 {
    return value as i32;
}

fn main() -> i32 {
    var values: [2]i32 = {0, 42};
    let first: *i32 = &values[0];
    let offset: usize = 1;
    return select(first + offset);
}
