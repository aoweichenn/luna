module tests.fail_class_rtti_nonroot;

class Base {
    pub init();
    pub virtual fn read() const -> i32;
}

@rtti class Derived : Base {
    pub init();
    pub override fn read() const -> i32;
}

impl Base {
    init() {
    }

    fn read() const -> i32 {
        return 0;
    }
}

impl Derived {
    init() {
        super.init();
    }

    fn read() const -> i32 {
        return 0;
    }
}

fn main() -> i32 {
    return 0;
}
