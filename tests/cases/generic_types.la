module tests.generic_types;

struct Pair<First, Second> {
    first: First;
    second: Second;
}

union Storage<Value> {
    value: Value;
    bytes: [16]u8;
}

type Tagged<Value> = Pair<Value, bool>;

struct Node<Value> {
    value: Value;
    next: *Node<Value>;
}

fn pass(value: Pair<i32, bool>) -> Pair<i32, bool> {
    return value;
}

fn first<First>(value: Pair<First, bool>) -> First {
    return value.first;
}

fn array_first<Value>(values: [2]Value) -> Value {
    return values[0];
}

fn exact<Value>(value: Value) -> Value {
    return value;
}

fn main() -> i32 {
    let source: Pair<i32, bool> = {first = 42, second = true};
    let copied: Pair<i32, bool> = pass(source);
    let tagged: Tagged<u64> = {first = 77, second = true};
    let storage: Storage<u64> = {value = 99};
    let values: [2]i32 = {11, 12};
    let node: Node<i32> = {value = 7, next = null};
    let explicit_pair: Pair<i32, bool> = exact<Pair<i32, bool>>(source);
    if (copied.first != 42 || !copied.second) {
        return 1;
    }
    if (tagged.first != 77 || !tagged.second) {
        return 2;
    }
    if (storage.value != 99 || sizeof(Pair<i32, bool>) == sizeof(Pair<i64, bool>)) {
        return 3;
    }
    let generic_values_are_valid: bool = first(source) == 42 && array_first(values) == 11;
    let explicit_value_is_valid: bool = explicit_pair.first == 42 && explicit_pair.second;
    let nested_values_are_valid: bool = node.value == 7 && explicit_value_is_valid;
    return generic_values_are_valid && nested_values_are_valid ? 0 : 4;
}
