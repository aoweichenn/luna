module tests.class_inheritance_chain;

class Root {
    prot first: u8;
    pub init(first: u8);
}

class Middle : Root {
    prot second: i32;
    pub init(first: u8, second: i32);
}

class Leaf : Middle {
    priv third: u16;
    pub init(first: u8, second: i32, third: u16);
    pub fn sum() const -> i32;
}

impl Root {
    init(first: u8) {
        this->first = first;
    }
}

impl Middle {
    init(first: u8, second: i32) {
        super.init(first);
        this->second = second;
    }
}

impl Leaf {
    init(first: u8, second: i32, third: u16) {
        super.init(first, second);
        this->third = third;
    }

    fn sum() const -> i32 {
        return this->first as i32 + this->second + this->third as i32;
    }
}

fn main() -> i32 {
    if (sizeof(Root) != 1 || sizeof(Middle) != 8) {
        return 1;
    }
    if (sizeof(Leaf) != 12) {
        return 2;
    }
    let value: Leaf = Leaf(10, 11, 21);
    return value.sum();
}
