module tests.anonymous_members;

union Value {
    struct {
        low: u8;
        high: u8;
    }
    whole: u16;
}

struct Outer {
    tag: u8;
    union {
        word: u32;
        bytes: [4]u8;
    }
}

struct Nested {
    union {
        struct {
            a: u8;
            b: u8;
        }
        half: u16;
    }
    tail: u8;
}

struct Shadow {
    struct {
        item: u32;
    }
    item: u16;
}

struct InnerPair {
    x: u8;
    y: u8;
}

struct Holder {
    union {
        pair: InnerPair;
        raw: u16;
    }
}

@packed struct PackedOuter {
    tag: u8;
    struct {
        low: u8;
        high: u8;
    }
    trailing: u32;
}

assert(sizeof(Value) == 2);
assert(offsetof(Outer, word) == 4);
assert(offsetof(Outer, bytes) == 4);
assert(sizeof(Outer) == 8 && alignof(Outer) == 4);
assert(offsetof(Nested, a) == 0 && offsetof(Nested, half) == 0);
assert(offsetof(Nested, tail) == 2 && sizeof(Nested) == 4);
assert(offsetof(Shadow, item) == 4 && sizeof(Shadow) == 8);
assert(offsetof(PackedOuter, low) == 1 && offsetof(PackedOuter, trailing) == 3);
assert(sizeof(PackedOuter) == 7 && alignof(PackedOuter) == 1);

fn main() -> i32 {
    var v: Value = {};
    v.whole = 4660;
    if (v.low != 52 || v.high != 18) {
        return 1;
    }
    v.low = 170;
    if (v.whole != 4778) {
        return 2;
    }

    var w: Value = { low = 5, };
    if (w.low != 5 || w.high != 0 || w.whole != 5) {
        return 3;
    }
    var w2: Value = { whole = 255, };
    if (w2.low != 255 || w2.high != 0) {
        return 4;
    }

    var o: Outer = {};
    o.tag = 9;
    o.word = 287454020;
    if (o.bytes[0] != 68 || o.bytes[1] != 51 || o.bytes[2] != 34 ||
        o.bytes[3] != 17) {
        return 5;
    }
    if (offsetof(Outer, tag) != 0 || offsetof(Outer, word) != 4) {
        return 6;
    }
    let op: *Outer = &o;
    if (op->word != 287454020 || op->bytes[1] != 51 || op->tag != 9) {
        return 7;
    }
    op->bytes[2] = 0;
    if (o.word != 0x11003344) {
        return 8;
    }

    var n: Nested = {};
    n.half = 2055;
    if (n.a != 7 || n.b != 8) {
        return 9;
    }
    n.b = 9;
    if (n.half != 2311) {
        return 10;
    }
    n.tail = 3;
    if (n.half != 2311 || n.tail != 3) {
        return 11;
    }

    var s: Shadow = {};
    s.item = 258;
    if (s.item != 258) {
        return 12;
    }
    let sp: *u16 = &s.item;
    if (*sp != 258) {
        return 13;
    }

    var h: Holder = {};
    h.pair.x = 1;
    h.pair.y = 2;
    if (h.raw != 513 || offsetof(Holder, pair) != 0) {
        return 14;
    }
    var h2: Holder = { pair = { x = 7, y = 8, }, };
    if (h2.raw != 2055 || h2.pair.x != 7 || h2.pair.y != 8) {
        return 15;
    }

    var pk: PackedOuter = {};
    pk.tag = 1;
    pk.low = 17;
    pk.high = 34;
    pk.trailing = 2864434397;
    if (pk.tag != 1 || pk.low != 17 || pk.high != 34 ||
        pk.trailing != 2864434397) {
        return 16;
    }
    return 42;
}
