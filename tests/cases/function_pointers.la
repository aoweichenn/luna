module tests.function_pointers;

fn add(left: i32, right: i32) -> i32 {
    return left + right;
}

fn mul(left: i32, right: i32) -> i32 {
    return left * right;
}

fn forty_two() -> i32 {
    return 42;
}

fn zero() -> i32 {
    return 0;
}

type Binary = fn(i32, i32) -> i32;

struct Handler {
    tag: u8;
    op: Binary;
}

fn apply(op: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    return op(a, b);
}

fn select(flag: bool) -> fn() -> i32 {
    return flag ? forty_two : zero;
}

fn main() -> i32 {
    var op: Binary = add;
    if (op(2, 3) != 5) {
        return 1;
    }
    let referenced: Binary = &mul;
    if (referenced(6, 7) != 42) {
        return 2;
    }
    op = mul;
    if (op == add) {
        return 3;
    }
    if (!(op != null)) {
        return 4;
    }
    var empty: Binary = null;
    if (empty != null || empty == mul) {
        return 5;
    }
    if (apply(add, 20, 22) != 42 || apply(mul, 6, 7) != 42) {
        return 6;
    }

    var handlers: [2]Handler = {};
    handlers[0].tag = 1;
    handlers[0].op = add;
    handlers[1].tag = 2;
    handlers[1].op = mul;
    if (handlers[0].op(10, 5) != 15 ||
        handlers[1].op(10, 5) != 50 ||
        handlers[0].tag != 1) {
        return 7;
    }

    var table: [2]Binary = {};
    table[0] = add;
    table[1] = mul;
    var index: usize = 0;
    var total: i32 = 0;
    while (index < 2) {
        total += table[index](3, 4);
        index += 1;
    }
    if (total != 19) {
        return 8;
    }

    let chosen: fn() -> i32 = select(true);
    let skipped: fn() -> i32 = select(false);
    if (chosen() != 42 || skipped() != 0) {
        return 9;
    }

    let raw: usize = forty_two as usize;
    let restored: fn() -> i32 = raw as fn() -> i32;
    if (restored() != 42 || (zero as usize) == raw) {
        return 10;
    }

    if (handlers[1].op == handlers[0].op) {
        return 11;
    }
    return chosen();
}
