module tests.class_constructor_virtual;

class Base {
    prot observed: i32;

    pub init();
    pub virtual fn value() const -> i32;
    pub fn result() const -> i32;
}

class Derived : Base {
    pub init();
    pub override fn value() const -> i32;
}

impl Base {
    init() {
        this->observed = this->value();
    }

    fn value() const -> i32 {
        return 1;
    }

    fn result() const -> i32 {
        return this->observed;
    }
}

impl Derived {
    init() {
        super.init();
    }

    fn value() const -> i32 {
        return 42;
    }
}

fn main() -> i32 {
    let value: Derived = Derived();
    return value.result();
}
