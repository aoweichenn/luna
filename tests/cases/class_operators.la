module tests.class_operators;

class Number {
    priv value: i32;

    pub init(value: i32);
    pub fn get() const -> i32;
    pub operator -() const -> Number;
    pub operator -(right: Number) const -> Number;
    pub operator +(right: Number) const -> Number;
    pub operator *(right: i32) const -> Number;
    pub operator !() const -> bool;
    pub operator ==(right: Number) const -> bool;
}

impl Number {
    init(value: i32) {
        this->value = value;
    }

    fn get() const -> i32 {
        return this->value;
    }

    operator -() const -> Number {
        return Number(0 - this->value);
    }

    operator -(right: Number) const -> Number {
        return Number(this->value - right.value);
    }

    operator +(right: Number) const -> Number {
        return Number(this->value + right.value);
    }

    operator *(right: i32) const -> Number {
        return Number(this->value * right);
    }

    operator !() const -> bool {
        return this->value == 0;
    }

    operator ==(right: Number) const -> bool {
        return this->value == right.value;
    }
}

fn main() -> i32 {
    let twenty: Number = Number(20);
    let twenty_two: Number = Number(22);
    let sum: Number = twenty + twenty_two;
    if (sum.get() != 42 || !(sum == Number(42))) {
        return 1;
    }
    let difference: Number = twenty_two - twenty;
    let product: Number = difference * 21;
    if (product.get() != 42 || !(!Number(0))) {
        return 2;
    }
    let negated: Number = -Number(-42);
    return negated.get();
}
