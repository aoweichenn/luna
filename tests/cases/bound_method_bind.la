module tests.bound_method_bind;

type Callback = method fn(i32) -> i32;

class Value {
    pub init();
    pub fn read(input: i32) const -> i32;
}

impl Value {
    init() {
    }

    fn read(input: i32) const -> i32 {
        return input;
    }
}

fn apply(callback: Callback, input: i32) -> i32 {
    return callback(input);
}

fn main() -> i32 {
    let value: Value = Value();
    let callback: Callback = value.read;
    return apply(callback, 42);
}
