module tests.i64_operations;

fn transform(left: i64, right: i64) -> i64 {
    var value: i64 = left + right;
    value *= 3;
    value -= 6;
    value /= 3;
    value %= 10000000000;
    value ^= 255;
    value |= 16;
    value &= 8589934591;
    value <<= 2;
    value >>= 1;
    return ~(-value);
}

fn main() -> i32 {
    let result: i64 = transform(4294967296, 7);
    if (result == 8589935091) {
        return 42;
    }
    return 1;
}
