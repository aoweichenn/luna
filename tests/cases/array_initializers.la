module tests.array_initializers;

enum Kind: u8 {
    empty,
    ready = 7,
}

fn main() -> i32 {
    var fib: [4]u32 = {1, 1, 2, 3};
    if (fib[0] != 1 || fib[1] != 1 || fib[2] != 2 || fib[3] != 3) {
        return 1;
    }
    var partial: [4]u32 = {5, 6};
    if (partial[0] != 5 || partial[1] != 6 || partial[2] != 0 || partial[3] != 0) {
        return 2;
    }
    var zeros: [3]u32 = {};
    if (zeros[0] != 0 || zeros[1] != 0 || zeros[2] != 0) {
        return 3;
    }
    var sparse: [8]u32 = {[3] = 7, [6] = 9};
    if (sparse[0] != 0 || sparse[2] != 0 || sparse[3] != 7 || sparse[5] != 0 || sparse[6] != 9 || sparse[7] != 0) {
        return 4;
    }
    var table: [3]i32 = {[2] = -1, [0] = 5};
    if (table[0] != 5 || table[1] != 0 || table[2] != -1) {
        return 5;
    }
    var mixed: [5]u32 = {1, [3] = 10, 2};
    if (mixed[0] != 1 || mixed[1] != 0 || mixed[2] != 0 || mixed[3] != 10 || mixed[4] != 2) {
        return 6;
    }
    var sized: [4]u32 = {[sizeof(u32) - 1] = 8, [0] = 1};
    if (sized[0] != 1 || sized[1] != 0 || sized[2] != 0 || sized[3] != 8) {
        return 7;
    }
    var first: i32 = 11;
    var second: i32 = 22;
    var pointers: [2]*i32 = {&first, &second};
    if (*pointers[0] != 11 || *pointers[1] != 22) {
        return 8;
    }
    var flags: [3]bool = {true, [2] = true};
    if (!flags[0] || flags[1] || !flags[2]) {
        return 9;
    }
    var reals: [2]f64 = {1.5, 2.5};
    if (reals[0] + reals[1] != 4.0) {
        return 10;
    }
    var kinds: [2]Kind = {Kind.ready};
    if (kinds[0] != Kind.ready || kinds[1] != Kind.empty) {
        return 11;
    }
    return 42;
}
