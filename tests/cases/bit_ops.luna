module tests.bit_ops;

fn main() -> i32 {
    let zero8: u8 = 0;
    let top8: u8 = 0x80;
    let pattern8: u8 = 0xA5;
    if (@clz(zero8) != 8) {
        return 1;
    }
    if (@clz(top8) != 0) {
        return 2;
    }
    if (@ctz(zero8) != 8) {
        return 3;
    }
    if (@ctz(top8) != 7) {
        return 4;
    }
    if (@popcount(zero8) != 0) {
        return 5;
    }
    if (@popcount(pattern8) != 4) {
        return 6;
    }

    let neg16: i16 = -1;
    let nibble16: i16 = 0x0F00;
    let low16: i16 = -4096;
    if (@clz(neg16) != 0) {
        return 7;
    }
    if (@clz(nibble16) != 4) {
        return 8;
    }
    if (@ctz(low16) != 12) {
        return 9;
    }
    if (@popcount(neg16) != 16) {
        return 10;
    }

    let zero32: u32 = 0;
    let flags32: u32 = 0x00F00000;
    let ones32: u32 = 0xFFFFFFFF;
    if (@clz(zero32) != 32) {
        return 11;
    }
    if (@clz(flags32) != 8) {
        return 12;
    }
    if (@ctz(zero32) != 32) {
        return 13;
    }
    if (@ctz(flags32) != 20) {
        return 14;
    }
    if (@popcount(ones32) != 32) {
        return 15;
    }

    let zero64: u64 = 0;
    let one64: u64 = 1;
    let ones64: u64 = 0xFFFFFFFFFFFFFFFF;
    if (@clz(zero64) != 64) {
        return 16;
    }
    if (@clz(one64) != 63) {
        return 17;
    }
    if (@ctz(zero64) != 64) {
        return 18;
    }
    if (@popcount(ones64) != 64) {
        return 19;
    }

    let one_size: usize = 1;
    let eight_size: usize = 8;
    if (@clz(one_size) != 63) {
        return 20;
    }
    if (@ctz(eight_size) != 3) {
        return 21;
    }
    if (@popcount(one_size) != 1) {
        return 22;
    }

    let byte8: u8 = 0x01;
    if (@rotate_left(byte8, 1) != 0x02) {
        return 23;
    }
    if (@rotate_left(top8, 1) != 0x01) {
        return 24;
    }
    if (@rotate_left(byte8, 0) != byte8) {
        return 25;
    }
    if (@rotate_left(byte8, 11) != 0x08) {
        return 26;
    }
    if (@rotate_right(byte8, 1) != 0x80) {
        return 27;
    }
    if (@rotate_right(top8, 0) != top8) {
        return 28;
    }
    if (@rotate_right(byte8, 11) != 0x20) {
        return 29;
    }

    let word32: u32 = 0x12345678;
    if (@rotate_left(word32, 8) != 0x34567812) {
        return 30;
    }
    if (@rotate_right(word32, 8) != 0x78123456) {
        return 31;
    }
    if (@rotate_left(word32, 32) != word32) {
        return 32;
    }

    let one16: i16 = 1;
    if (@rotate_left(one16, 15) != -32768) {
        return 33;
    }
    if (@rotate_right(one16, 1) != -32768) {
        return 34;
    }
    if (@rotate_left(one64, 63) != 0x8000000000000000) {
        return 35;
    }
    if (@rotate_right(0x8000000000000000 as u64, 63) != 1) {
        return 36;
    }
    if (@rotate_left(one_size, 63) != 0x8000000000000000) {
        return 37;
    }

    let half16: u16 = 0x1234;
    let signed_half: i16 = 0x1234;
    let raw64: u64 = 0x0123456789ABCDEF;
    let raw_size: usize = 0x0123456789ABCDEF;
    if (@byte_swap(half16) != 0x3412) {
        return 38;
    }
    if (@byte_swap(signed_half) != 0x3412) {
        return 39;
    }
    if (@byte_swap(word32) != 0x78563412) {
        return 40;
    }
    if (@byte_swap(zero32) != 0) {
        return 41;
    }
    if (@byte_swap(raw64) != 0xEFCDAB8967452301) {
        return 43;
    }
    if (@byte_swap(raw_size) != 0xEFCDAB8967452301) {
        return 44;
    }
    return 42;
}
