module tests.std_text_utf8;

import luna.std.text as text;

struct Utf8Case {
    offset: usize;
    length: usize;
    valid: bool;
}

fn utf8_case(index: usize) -> Utf8Case {
    var cases: [17]Utf8Case = {};
    cases[0] = { offset = 0, length = 1, valid = true };
    cases[1] = { offset = 1, length = 2, valid = true };
    cases[2] = { offset = 3, length = 2, valid = true };
    cases[3] = { offset = 5, length = 3, valid = true };
    cases[4] = { offset = 8, length = 3, valid = true };
    cases[5] = { offset = 11, length = 3, valid = true };
    cases[6] = { offset = 14, length = 4, valid = true };
    cases[7] = { offset = 18, length = 4, valid = true };
    cases[8] = { offset = 22, length = 2, valid = false };
    cases[9] = { offset = 24, length = 2, valid = false };
    cases[10] = { offset = 26, length = 1, valid = false };
    cases[11] = { offset = 27, length = 2, valid = false };
    cases[12] = { offset = 29, length = 3, valid = false };
    cases[13] = { offset = 32, length = 3, valid = false };
    cases[14] = { offset = 35, length = 4, valid = false };
    cases[15] = { offset = 39, length = 4, valid = false };
    cases[16] = { offset = 43, length = 4, valid = false };
    return cases[index];
}

fn main() -> i32 {
    var bytes: [47]u8 = {
        'A', 194, 128, 223, 191, 224, 160, 128, 237, 159, 191, 238, 128, 128, 240, 144, 128, 128,
        244, 143, 191, 191, 192, 128, 193, 191, 128, 226, 130, 224, 159, 128, 237, 160, 128, 240,
        143, 191, 191, 244, 144, 128, 128, 245, 128, 128, 128,
    };
    if (!text::is_valid_utf8({ data = null, length = 0 })) {
        return 18;
    }
    if (text::is_valid_utf8({ data = null, length = 1 })) {
        return 19;
    }
    for (var index: usize = 0; index < 17; index += 1) {
        let test: Utf8Case = utf8_case(index);
        let view: text::View = { data = &bytes[test.offset] as *const u8, length = test.length };
        if (text::is_valid_utf8(view) != test.valid) {
            return (index + 1) as i32;
        }
    }
    return 0;
}
