module tests.class_friend;

class Vault {
    friend class Inspector;

    priv value: i32;
    pub init(value: i32);
}

class Inspector {
    pub init();
    pub fn read(value: *const Vault) const -> i32;
}

impl Vault {
    init(value: i32) {
        this->value = value;
    }
}

impl Inspector {
    init() {
    }

    fn read(value: *const Vault) const -> i32 {
        return value->value;
    }
}

fn main() -> i32 {
    let vault: Vault = Vault(42);
    let inspector: Inspector = Inspector();
    return inspector.read(&vault);
}
