module tests.file_line;

fn report(f: *const u8, l: usize) -> usize {
    if (f[0] == 0) {
        return 0;
    }
    return l;
}

fn line_in_return() -> usize {
    return @line();
}

fn main() -> i32 {
    assert(@line() > 1);
    let a: usize = @line();
    let b: usize = @line();
    if (b != a + 1) {
        return 1;
    }
    if (a != 16) {
        return 2;
    }
    if (line_in_return() != 11) {
        return 3;
    }
    let path: *const u8 = @file();
    var length: usize = 0;
    while (path[length] != 0) {
        length += 1;
    }
    if (length < 6) {
        return 4;
    }
    if (path[length - 5] != 46 || path[length - 4] != 108 || path[length - 3] != 117 ||
        path[length - 2] != 110 || path[length - 1] != 97) {
        return 5;
    }
    if (report(@file(), @line()) != 39) {
        return 6;
    }
    var slots: [64]usize = {};
    slots[@line()] = 7;
    if (slots[43] != 7) {
        return 7;
    }
    return 42;
}
