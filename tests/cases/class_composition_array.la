module tests.class_composition_array;

class Point {
    priv value: i32;

    pub init(value: i32);
    pub fn read() const -> i32;
}

class PairGrid {
    priv values: [2]Point;

    pub init(first: i32, second: i32);
    pub fn total() const -> i32;
}

impl Point {
    init(value: i32) {
        this->value = value;
    }

    fn read() const -> i32 {
        return this->value;
    }
}

impl PairGrid {
    init(first: i32, second: i32) : values = {Point(first), Point(second)} {
    }

    fn total() const -> i32 {
        return this->values[0].read() + this->values[1].read();
    }
}

fn main() -> i32 {
    let grid: PairGrid = PairGrid(20, 22);
    return grid.total();
}
