module tests.class_abstract_override;

class AbstractValue {
    pub init();
    pub abstract fn read() const -> i32;
}

class ConcreteValue : AbstractValue {
    pub init();
    pub override fn read() const -> i32;
}

impl AbstractValue {
    init() {
    }
}

impl ConcreteValue {
    init() {
        super.init();
    }

    fn read() const -> i32 {
        return 42;
    }
}

fn invoke(value: *const AbstractValue) -> i32 {
    return value->read();
}

fn main() -> i32 {
    let value: ConcreteValue = ConcreteValue();
    let abstract_value: *const AbstractValue = (&value) as *const AbstractValue;
    return invoke(abstract_value);
}
