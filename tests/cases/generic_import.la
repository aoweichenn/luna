module tests.generic_import;

import tests.generic_api as api;

fn main() -> i32 {
    let pair: api::Pair<i32, bool> = {first = 42, second = true};
    let value: i32 = api::identity(pair.first);
    let box: api::Box<u64> = api::Box<u64>(77);
    var exchanged: i32 = 10;
    let previous: i32 = api::exchange(&exchanged, 20);
    if (value != 42 || !pair.second) {
        return 1;
    }
    let exchange_is_valid: bool = previous == 10 && exchanged == 20;
    return box.get() == 77 && exchange_is_valid ? 0 : 2;
}
