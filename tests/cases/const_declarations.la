module tests.const_declarations;

const BUFFER_SIZE: usize = 4096;
const NEGATIVE_LIMIT: i32 = -4;
const FLAG: bool = true;
const DERIVED: usize = BUFFER_SIZE / 1024;
const FORWARD: i32 = ALSO_LATER + 1;
const ALSO_LATER: i32 = 6;

assert(BUFFER_SIZE == 4096);
assert(DERIVED == 4);
assert(NEGATIVE_LIMIT == -4);
assert(NEGATIVE_LIMIT < 0);
assert(FLAG);
assert(FORWARD == 7);

fn main() -> i32 {
    const LOCAL_LIMIT: i32 = 3;
    var total: i32 = 0;
    var index: usize = 0;
    while (index < DERIVED) {
        total += LOCAL_LIMIT;
        index += 1;
    }
    if (total != 12) {
        return 1;
    }
    if (BUFFER_SIZE != 4096) {
        return 2;
    }
    if (!FLAG) {
        return 3;
    }
    if (NEGATIVE_LIMIT >= 0) {
        return 4;
    }
    if (NEGATIVE_LIMIT + 4 != 0) {
        return 5;
    }
    var sparse: [4]u32 = {[LOCAL_LIMIT - 1] = 7};
    if (sparse[0] != 0 || sparse[1] != 0 || sparse[2] != 7 || sparse[3] != 0) {
        return 6;
    }
    var input: i32 = 3;
    var picked: i32 = 0;
    switch (input) {
        case LOCAL_LIMIT {
            picked = 9;
        }
        case NEGATIVE_LIMIT {
            picked = 1;
        }
        default {
            picked = 2;
        }
    }
    if (picked != 9) {
        return 7;
    }
    var small: i32 = -4;
    var sign: i32 = 0;
    switch (small) {
        case NEGATIVE_LIMIT {
            sign = 1;
        }
        default {
            sign = 2;
        }
    }
    if (sign != 1) {
        return 8;
    }
    if (FORWARD != 7) {
        return 9;
    }
    return 42;
}
