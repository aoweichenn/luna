module tests.memory_copy_overlap;

struct Pair {
    first: u32;
    second: u32;
}

fn main() -> i32 {
    var bytes: [16]u8 = {};
    let source: *Pair = (&bytes[0]) as *Pair;
    source->first = 0x11223344;
    source->second = 0x55667788;

    let shifted: *Pair = (&bytes[4]) as *Pair;
    *shifted = *source;

    if (shifted->first != 0x11223344 ||
        shifted->second != 0x55667788) {
        return 1;
    }

    *source = *shifted;
    if (source->first != 0x11223344 ||
        source->second != 0x55667788) {
        return 2;
    }
    *source = *source;
    if (source->first != 0x11223344 ||
        source->second != 0x55667788) {
        return 3;
    }
    return 42;
}
