module test.narrow_integer_operations;

fn pass_i8(value: i8) -> i8 {
    return value;
}

fn pass_i16(value: i16) -> i16 {
    return value;
}

fn pass_u8(value: u8) -> u8 {
    return value;
}

fn pass_u16(value: u16) -> u16 {
    return value;
}

fn check_i8(input: i8, count: i8) -> bool {
    let wrapped_add: i8 = 120 + 10;
    let wrapped_sub: i8 = -120 - 20;
    let wrapped_mul: i8 = 50 * 6;
    let negated_minimum: i8 = -(-128);
    let inverted: i8 = ~0;
    let quotient: i8 = input / 10;
    let remainder: i8 = input % 10;
    let shifted_left: i8 = 3 << count;
    let shifted_right: i8 = -64 >> count;

    return wrapped_add == -126 &&
           wrapped_sub == 116 &&
           wrapped_mul == 44 &&
           negated_minimum == -128 &&
           inverted == -1 &&
           quotient == -10 &&
           remainder == -1 &&
           shifted_left == 6 &&
           shifted_right == -32 &&
           -1 < 1;
}

fn check_i16(input: i16, count: i16) -> bool {
    let wrapped_add: i16 = 30000 + 3000;
    let wrapped_sub: i16 = -30000 - 5000;
    let wrapped_mul: i16 = 10000 * 7;
    let negated_minimum: i16 = -(-32768);
    let inverted: i16 = ~0;
    let quotient: i16 = input / 100;
    let remainder: i16 = input % 100;
    let shifted_left: i16 = 3 << count;
    let shifted_right: i16 = -16384 >> count;

    return wrapped_add == -32536 &&
           wrapped_sub == 30536 &&
           wrapped_mul == 4464 &&
           negated_minimum == -32768 &&
           inverted == -1 &&
           quotient == -300 &&
           remainder == -1 &&
           shifted_left == 6 &&
           shifted_right == -8192 &&
           -1 < 1;
}

fn check_u8(input: u8, count: u8) -> bool {
    let wrapped_add: u8 = 250 + 10;
    let wrapped_sub: u8 = 2 - 3;
    let wrapped_mul: u8 = 50 * 6;
    let negated: u8 = -1;
    let inverted: u8 = ~0;
    let quotient: u8 = input / 10;
    let remainder: u8 = input % 10;
    let shifted_left: u8 = 3 << count;
    let shifted_right: u8 = 128 >> count;

    return wrapped_add == 4 &&
           wrapped_sub == 255 &&
           wrapped_mul == 44 &&
           negated == 255 &&
           inverted == 255 &&
           quotient == 25 &&
           remainder == 1 &&
           shifted_left == 6 &&
           shifted_right == 64 &&
           255 > 1;
}

fn check_u16(input: u16, count: u16) -> bool {
    let wrapped_add: u16 = 65000 + 1000;
    let wrapped_sub: u16 = 2 - 3;
    let wrapped_mul: u16 = 10000 * 7;
    let negated: u16 = -1;
    let inverted: u16 = ~0;
    let quotient: u16 = input / 100;
    let remainder: u16 = input % 100;
    let shifted_left: u16 = 3 << count;
    let shifted_right: u16 = 32768 >> count;

    return wrapped_add == 464 &&
           wrapped_sub == 65535 &&
           wrapped_mul == 4464 &&
           negated == 65535 &&
           inverted == 65535 &&
           quotient == 650 &&
           remainder == 1 &&
           shifted_left == 6 &&
           shifted_right == 16384 &&
           65535 > 1;
}

fn main() -> i32 {
    if (check_i8(pass_i8(-101), 9) &&
        check_i16(pass_i16(-30001), 17) &&
        check_u8(pass_u8(251), 9) &&
        check_u16(pass_u16(65001), 17)) {
        return 42;
    }
    return 1;
}
