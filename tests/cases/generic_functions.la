module tests.generic_functions;

fn identity<T>(value: T) -> T {
    return value;
}

fn choose(value: i32) -> i32 {
    return value + 1;
}

fn choose<T>(value: T) -> T {
    return value;
}

fn pointed_or<T>(value: *const T, fallback: T) -> T {
    return value == null ? fallback : *value;
}

fn keep<Value>(value: Value, fallback: Value = 0) -> Value {
    return value;
}

fn increment(value: i32) -> i32 {
    return value + 1;
}

fn invoke<Value>(operation: fn(Value) -> Value, value: Value) -> Value {
    return operation(value);
}

fn main() -> i32 {
    let inferred: i32 = identity(41);
    let explicit: i64 = identity<i64>(42);
    let selected_ordinary: i32 = choose(9);
    let selected_generic: bool = choose(true);
    let callback: fn(i32) -> i32 = &identity;
    var stored: u64 = 77;
    let pointed: u64 = pointed_or(&stored as *const u64, 0 as u64);
    let fallback: u64 = pointed_or<u64>(null, 88);
    let defaulted: i32 = keep(44);
    let invoked: i32 = invoke(increment, 44);
    if (inferred != 41 || explicit != 42) {
        return 1;
    }
    if (selected_ordinary != 10 || !selected_generic) {
        return 2;
    }
    if (callback(43) != 43) {
        return 3;
    }
    if (defaulted != 44) {
        return 4;
    }
    let pointer_results_are_valid: bool = pointed == 77 && fallback == 88;
    return pointer_results_are_valid && invoked == 45 ? 0 : 5;
}
