module tests.class_vptr_layout;

class Prefix {
    pub prefix: u8;
    pub init(prefix: u8);
}

class Polymorphic : Prefix {
    pub tail: u8;
    pub init(prefix: u8, tail: u8);
    pub virtual fn read() const -> i32;
}

class Leaf : Polymorphic {
    pub end: i32;
    pub init(prefix: u8, tail: u8, end: i32);
    pub override fn read() const -> i32;
}

impl Prefix {
    init(prefix: u8) {
        this->prefix = prefix;
    }
}

impl Polymorphic {
    init(prefix: u8, tail: u8) {
        super.init(prefix);
        this->tail = tail;
    }

    fn read() const -> i32 {
        return this->prefix as i32 + this->tail as i32;
    }
}

impl Leaf {
    init(prefix: u8, tail: u8, end: i32) {
        super.init(prefix, tail);
        this->end = end;
    }

    fn read() const -> i32 {
        return this->prefix as i32 + this->tail as i32 + this->end;
    }
}

fn main() -> i32 {
    if (sizeof(Prefix) != 1 || alignof(Prefix) != 1) {
        return 1;
    }
    let polymorphic_position_is_valid: bool = offsetof(Polymorphic, tail) == 16;
    let polymorphic_shape_is_valid: bool = sizeof(Polymorphic) == 24 && alignof(Polymorphic) == 8;
    if (!polymorphic_position_is_valid || !polymorphic_shape_is_valid) {
        return 2;
    }
    let leaf_position_is_valid: bool = offsetof(Leaf, end) == 24;
    let leaf_shape_is_valid: bool = sizeof(Leaf) == 32 && alignof(Leaf) == 8;
    if (!leaf_position_is_valid || !leaf_shape_is_valid) {
        return 3;
    }
    let value: Leaf = Leaf(10, 11, 21);
    let base: *const Polymorphic = (&value) as *const Polymorphic;
    return base->read();
}
