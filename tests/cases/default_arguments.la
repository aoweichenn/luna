module tests.default_arguments;

enum Choice: u8 { zero, answer }

const BASE: i32 = 21;

const fn twice(value: i32) -> i32 {
    return value * 2;
}

fn calculate(value: i32, increment: i32 = twice(1), enabled: bool = true) -> i32 {
    return enabled ? value + increment : 0;
}

fn enum_value(choice: Choice = Choice.answer) -> i32 {
    return choice == Choice.answer ? 42 : 0;
}

fn pointer_value(value: *const i32 = null) -> i32 {
    return value == null ? 42 : *value;
}

fn signed_value(value: i32 = -2) -> i32 {
    return value + 44;
}

fn folded_constant(value: i32 = twice(BASE)) -> i32 {
    return value;
}

fn layout_value(value: usize = sizeof(i32)) -> i32 {
    return value as i32 + 38;
}

fn main() -> i32 {
    if (calculate(40) != 42 || calculate(40, 2, false) != 0) {
        return 1;
    }
    if (enum_value() != 42 || pointer_value() != 42) {
        return 2;
    }
    if (signed_value() != 42 || calculate(BASE * 2) != 44) {
        return 3;
    }
    if (folded_constant() != 42 || layout_value() != 42) {
        return 4;
    }
    return 42;
}
