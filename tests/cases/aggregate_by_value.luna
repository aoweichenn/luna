module tests.aggregate_by_value;

struct Pair {
    left: i32;
    right: i32;
}

struct Mixed {
    weight: f64;
    tag: i32;
}

struct Big {
    first: i64;
    second: i64;
    third: i64;
}

union Bits {
    integer: u64;
    real: f64;
}

fn sum_pair(value: Pair) -> i32 {
    return value.left + value.right;
}

fn make_pair() -> Pair {
    return {
        left = 20,
        right = 22,
    };
}

fn adjust_mixed(value: Mixed) -> Mixed {
    var result: Mixed = value;
    result.weight += 1.5;
    result.tag += 2;
    return result;
}

fn make_values() -> [3]i32 {
    var values: [3]i32 = {};
    values[0] = 10;
    values[1] = 11;
    values[2] = 21;
    return values;
}

fn sum_values(values: [3]i32) -> i32 {
    return values[0] + values[1] + values[2];
}

fn echo_big(value: Big) -> Big {
    return value;
}

fn echo_bits(value: Bits) -> Bits {
    return value;
}

fn overwrite_pair(value: *Pair) -> *Pair {
    value->left = 0;
    value->right = 0;
    return value;
}

fn observe_snapshot(value: Pair, ignored: *Pair) -> i32 {
    return value.left + value.right;
}

fn force_rollback(
    first: i32,
    second: i32,
    third: i32,
    fourth: i32,
    fifth: i32,
    sixth: i32,
    value: Pair
) -> i32 {
    return first + second + third + fourth + fifth + sixth +
           value.left + value.right;
}

fn main() -> i32 {
    if (sum_pair({ left = 20, right = 22, }) != 42) {
        return 1;
    }

    let pair: Pair = make_pair();
    if (pair.left != 20 || pair.right != 22) {
        return 2;
    }

    var mixed: Mixed = {
        weight = 0.5,
        tag = 40,
    };
    let adjusted: Mixed = adjust_mixed(mixed);
    if (adjusted.weight != 2.0 || adjusted.tag != 42 ||
        mixed.weight != 0.5 || mixed.tag != 40) {
        return 3;
    }

    let values: [3]i32 = make_values();
    if (values[0] != 10 || values[1] != 11 || values[2] != 21 ||
        sum_values(values) != 42) {
        return 4;
    }

    var big: Big = {
        first = 10,
        second = 11,
        third = 21,
    };
    let returned_big: Big = echo_big(big);
    if (returned_big.first != 10 || returned_big.second != 11 ||
        returned_big.third != 21) {
        return 5;
    }

    var bits: Bits = {
        integer = 42,
    };
    let returned_bits: Bits = echo_bits(bits);
    if (returned_bits.integer != 42) {
        return 6;
    }

    if (force_rollback(1, 2, 3, 4, 5, 6,
                       { left = 10, right = 11, }) != 42) {
        return 7;
    }

    var aliased: Pair = {
        left = 20,
        right = 22,
    };
    if (observe_snapshot(aliased, overwrite_pair(&aliased)) != 42 ||
        aliased.left != 0 || aliased.right != 0) {
        return 8;
    }

    if (make_pair().right != 22 || make_values()[2] != 21) {
        return 9;
    }

    let selected: Pair = false
        ? make_pair()
        : { left = 20, right = 22, };
    if (sum_pair(selected) != 42 ||
        sum_pair(true
            ? { left = 20, right = 22, }
            : { left = 0, right = 0, }) != 42) {
        return 10;
    }
    return 42;
}
