module tests.fail_generic_friend;

class Inspector {
    pub init();
}

impl Inspector {
    init() {
    }
}

class Box<Value> {
    friend class Inspector;
    priv value: Value;

    pub init(value: Value);
}

impl Box {
    init(value: Value)
        : value = value {
    }
}

fn main() -> i32 {
    let value: Box<i32> = Box<i32>(42);
    return 0;
}
