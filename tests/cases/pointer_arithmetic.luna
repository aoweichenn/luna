module tests.pointer_arithmetic;

fn sum_range(start: *i32, end: *i32) -> i32 {
    var total: i32 = 0;
    var cursor: *i32 = start;
    while (cursor < end) {
        total += *cursor;
        cursor += 1;
    }
    return total;
}

struct Record {
    tag: u8;
    value: u64;
}

fn main() -> i32 {
    var values: [5]i32 = {};
    values[0] = 10;
    values[1] = 20;
    values[2] = 30;
    values[3] = 40;
    values[4] = 50;

    let begin: *i32 = &values[0];
    let finish: *i32 = begin + (4 as usize);
    let one_past: *i32 = (5 as usize) + begin;

    if ((finish - begin) != 4 || (one_past - finish) != 1) {
        return 1;
    }
    if (!(begin < finish) || !(one_past > finish) ||
        begin >= one_past || finish <= begin) {
        return 2;
    }
    if (*finish != 50 || *(begin + (2 as usize)) != 30) {
        return 3;
    }

    if (sum_range(begin, one_past) != 150) {
        return 4;
    }

    var cursor: *i32 = &values[4];
    cursor -= 2;
    if (*cursor != 30) {
        return 5;
    }
    cursor += 1;
    if (*(cursor - (3 as usize)) != 10) {
        return 6;
    }

    var records: [3]Record = {};
    records[0].value = 7;
    records[2].value = 9;
    let base: *Record = &records[0];
    let last: *Record = base + (2 as usize);
    if (last->value != 9 ||
        (last - base) != 2 ||
        sizeof(Record) != 16) {
        return 7;
    }
    last->tag = 3;
    if (base[2].tag != 3) {
        return 8;
    }

    return 42;
}
