module tests.generic_class_value_field;

import tests.generic_api::{Box};

class Holder {
    priv box: Box<i32>;

    pub init(value: i32);
    pub fn get() const -> i32;
}

impl Holder {
    init(value: i32): box = Box<i32>(value) {
    }

    fn get() const -> i32 {
        return this->box.get();
    }
}

fn main() -> i32 {
    let holder: Holder = Holder(42);
    return holder.get() == 42 ? 0 : 1;
}
