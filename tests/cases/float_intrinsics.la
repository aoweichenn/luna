module tests.float_intrinsics;

// @min/@max lower with the first argument as the destination operand and the second as the source operand,
// so the hardware minsd/maxsd (and minss/maxss) NaN rule applies verbatim: whenever either operand is NaN
// the SECOND argument is the result.
fn main() -> i32 {
    // @sqrt: exact squares, an inexact value bracketed to within a few ulp, and NaN for a negative input.
    if (@sqrt(16.0) != 4.0) {
        return 1;
    }
    if (@sqrt(0.25) != 0.5) {
        return 2;
    }
    let root_two: f64 = @sqrt(2.0);
    if (root_two < 1.4142135 || root_two > 1.4142136) {
        return 3;
    }
    let root_negative: f64 = @sqrt(-1.0);
    if (root_negative == root_negative) {
        return 4;
    }

    // @floor / @ceil / @trunc / @round on fractional values; @round ties to even.
    if (@floor(2.5) != 2.0 || @floor(-2.5) != -3.0 || @floor(2.4) != 2.0 || @floor(-2.6) != -3.0 ||
        @floor(0.5) != 0.0 || @floor(-0.5) != -1.0) {
        return 5;
    }
    if (@ceil(2.5) != 3.0 || @ceil(-2.5) != -2.0 || @ceil(2.4) != 3.0 || @ceil(-2.6) != -2.0 ||
        @ceil(0.5) != 1.0 || @ceil(-0.5) != 0.0) {
        return 6;
    }
    if (@trunc(2.5) != 2.0 || @trunc(-2.5) != -2.0 || @trunc(2.4) != 2.0 || @trunc(-2.6) != -2.0 ||
        @trunc(0.5) != 0.0 || @trunc(-0.5) != 0.0) {
        return 7;
    }
    if (@round(2.5) != 2.0 || @round(-2.5) != -2.0 || @round(2.4) != 2.0 || @round(-2.6) != -3.0 ||
        @round(0.5) != 0.0 || @round(-0.5) != 0.0 || @round(3.5) != 4.0 || @round(-3.5) != -4.0) {
        return 8;
    }

    // Magnitudes at or above 2^52 are already integral, so every rounding intrinsic is the identity.
    let big: f64 = 1152921504606846976.0; // 2^60
    if (@floor(big) != big || @ceil(big) != big || @trunc(big) != big || @round(big) != big ||
        @floor(-big) != -big || @round(-big) != -big) {
        return 9;
    }

    // NaN propagates through the guard without trapping (a NaN never equals itself).
    let nan: f64 = 0.0 / 0.0;
    if (@floor(nan) == @floor(nan)) {
        return 10;
    }
    if (@ceil(nan) == @ceil(nan)) {
        return 11;
    }
    if (@trunc(nan) == @trunc(nan)) {
        return 12;
    }
    if (@round(nan) == @round(nan)) {
        return 13;
    }

    // @min / @max on ordered values, then the second-operand-wins NaN rule.
    if (@min(2.5, 1.5) != 1.5 || @max(2.5, 1.5) != 2.5 || @min(-2.0, 3.0) != -2.0 ||
        @max(-2.0, 3.0) != 3.0) {
        return 14;
    }
    if (@min(nan, 1.0) != 1.0 || @max(nan, 1.0) != 1.0) {
        return 15;
    }
    let min_nan: f64 = @min(1.0, nan);
    let max_nan: f64 = @max(1.0, nan);
    if (min_nan == min_nan || max_nan == max_nan) {
        return 16;
    }

    // @abs clears the sign bit, including for -0.0 (checked via the sign of the reciprocal) and NaN.
    if (@abs(-2.5) != 2.5 || @abs(2.5) != 2.5) {
        return 17;
    }
    if (1.0 / @abs(-0.0) < 0.0 || 1.0 / @abs(0.0) < 0.0) {
        return 18;
    }
    if (@abs(nan) == @abs(nan)) {
        return 19;
    }

    // f32 variants of all of the above.
    let wide32: f32 = 16.0;
    if (@sqrt(wide32) != 4.0) {
        return 20;
    }
    let two32: f32 = 2.0;
    let root_two32: f32 = @sqrt(two32);
    if (root_two32 < 1.4142135 || root_two32 > 1.4142136) {
        return 21;
    }
    let value32: f32 = 2.5;
    let below32: f32 = -2.5;
    if (@floor(value32) != 2.0 || @floor(below32) != -3.0 || @ceil(value32) != 3.0 ||
        @ceil(below32) != -2.0 || @trunc(below32) != -2.0) {
        return 22;
    }
    if (@round(value32) != 2.0 || @round(below32) != -2.0) {
        return 23;
    }
    let big32: f32 = 1152921504606846976.0; // 2^60, above the 2^23 f32 guard limit
    if (@floor(big32) != big32 || @ceil(big32) != big32 || @trunc(big32) != big32 ||
        @round(big32) != big32) {
        return 24;
    }
    let zero32: f32 = 0.0;
    let nan32: f32 = zero32 / zero32;
    if (@floor(nan32) == @floor(nan32) || @round(nan32) == @round(nan32)) {
        return 25;
    }
    let right32: f32 = 1.5;
    if (@min(value32, right32) != 1.5 || @max(value32, right32) != 2.5) {
        return 26;
    }
    if (@min(nan32, right32) != 1.5 || @max(nan32, right32) != 1.5) {
        return 27;
    }
    let min_nan32: f32 = @min(right32, nan32);
    if (min_nan32 == min_nan32) {
        return 28;
    }
    if (@abs(below32) != 2.5 || @abs(value32) != 2.5) {
        return 29;
    }
    let negative_zero32: f32 = -0.0;
    let one32: f32 = 1.0;
    if (one32 / @abs(negative_zero32) < 0.0) {
        return 30;
    }
    return 42;
}
