module tests.selective_basic;

import tests.modules.mathx::{triple, answer};

fn main() -> i32 {
    if (triple(14) != 42) {
        return 1;
    }
    if (answer != 42) {
        return 2;
    }
    let point: mathx::Point = { x = 40, y = 2, };
    if (point.x + point.y != 42) {
        return 3;
    }
    let shade: mathx::Color = mathx::Color.red;
    if (shade != mathx::Color.red) {
        return 4;
    }
    return 42;
}
