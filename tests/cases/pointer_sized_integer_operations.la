module test.pointer_sized_integer_operations;

fn signed_math(value: isize, count: isize) -> isize {
    var result: isize = value + count;
    result *= 3;
    result >>= 65;
    return result;
}

fn unsigned_math(value: usize, count: usize) -> usize {
    return ((value * 3) + 1) >> count;
}

fn combine_six(
    first: usize,
    second: usize,
    third: usize,
    fourth: usize,
    fifth: usize,
    sixth: usize
) -> usize {
    return first + second + third + fourth + fifth + sixth;
}

fn main() -> i32 {
    let signed: isize = signed_math(-10, 2);
    let unsigned: usize = unsigned_math(7, 1);
    let minimum: isize = -9223372036854775808;
    let maximum: usize = 18446744073709551615;
    let minimum_bits: usize = minimum as usize;
    let maximum_bits: isize = maximum as isize;
    let signed_wrap: isize = 9223372036854775807 + 1;
    let unsigned_wrap: usize = maximum + 1;
    let negated_minimum: isize = -minimum;

    if (
        signed == -12 &&
        unsigned == 11 &&
        combine_six(1, 2, 3, 4, 5, 6) == 21 &&
        minimum_bits == 9223372036854775808 &&
        maximum_bits == -1 &&
        signed_wrap == minimum &&
        unsigned_wrap == 0 &&
        negated_minimum == minimum &&
        ((4294967296 as usize) as u64) == 4294967296
    ) {
        return 42;
    }
    return 1;
}
