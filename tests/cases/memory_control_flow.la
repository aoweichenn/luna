module test.memory_control_flow;

fn combine(first: i32, second: i32) -> i32 {
    return first + second;
}

fn main() -> i32 {
    var values: [2]i32 = {};
    values[true ? 0 : 1] = 10 + (false ? 32 : 31);

    let pointer: *i32 = &values[0];
    pointer[false ? 1 : 0] += true ? 1 : 2;

    let computed: i32 = 1 + (true ? 2 : 3);
    let called: i32 = combine(4 + computed, false ? 5 : 6);
    if (called != 13) {
        return 1;
    }
    return values[0];
}
