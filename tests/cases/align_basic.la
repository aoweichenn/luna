module tests.align_basic;

@align(16) struct Vector {
    x: f64;
    y: f64;
}

@align(32) struct Wide {
    x: f64;
    y: f64;
}

struct Packet {
    tag: u32;
    @align(8) kind: u32;
}

struct Wrapper {
    inner: Vector;
    tail: u8;
}

fn add_wide(value: Wide) -> f64 {
    return value.x + value.y;
}

fn make_wide(x: f64, y: f64) -> Wide {
    var result: Wide = {};
    result.x = x;
    result.y = y;
    return result;
}

fn main() -> i32 {
    @align(64) var line_buffer: [64]u8 = {};
    line_buffer[0] = 7;
    let address: usize = (&line_buffer) as usize;
    if (address % 64 != 0 || line_buffer[0] != 7) {
        return 1;
    }
    if (offsetof(Packet, tag) != 0 || offsetof(Packet, kind) != 8 ||
        sizeof(Packet) != 16 || alignof(Packet) != 8) {
        return 2;
    }
    if (alignof(Vector) != 16 || sizeof(Vector) != 16) {
        return 3;
    }
    if (alignof(Wrapper) != 16 || offsetof(Wrapper, tail) != 16 ||
        sizeof(Wrapper) != 32) {
        return 4;
    }
    if (sizeof([3]Vector) != 48) {
        return 5;
    }
    if (alignof(Wide) != 32 || sizeof(Wide) != 32 ||
        sizeof([2]Wide) != 64) {
        return 6;
    }
    let wide: Wide = make_wide(40.0, 2.0);
    if (add_wide(wide) != 42.0) {
        return 7;
    }
    return 42;
}
