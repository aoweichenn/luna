module tests.overload_function_arguments;

fn transform(value: i32) -> i32 {
    return value + 1;
}

fn transform(value: u32) -> i32 {
    return value as i32 + 2;
}

fn apply(callback: fn(i32) -> i32) -> i32 {
    return callback(41);
}

fn choose(callback: fn(i32) -> i32) -> i32 {
    return callback(41);
}

fn choose(callback: fn(u32) -> i32) -> i32 {
    return callback(40 as u32);
}

fn main() -> i32 {
    let callback: fn(i32) -> i32 = transform;
    if (apply(transform) != 42) {
        return 1;
    }
    return choose(callback);
}
