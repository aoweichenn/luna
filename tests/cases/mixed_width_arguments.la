module tests.mixed_width_arguments;

fn check(a: i64, b: i32, c: i64, d: bool, e: i32, f: i64) -> bool {
    return a == 4294967296
        && b == -7
        && c == -9223372036854775808
        && d
        && e == 42
        && f == 9223372036854775807;
}

fn main() -> i32 {
    if (check(4294967296, -7, -9223372036854775808,
              true, 42, 9223372036854775807)) {
        return 42;
    }
    return 1;
}
