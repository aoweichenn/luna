module tests.type_aliases;

type Width = u32;
type Handle = i64;
type Chain = Width;
type Pixels = [4]Width;
type Cursor = *Width;

struct Box {
    width: Width;
    handle: Handle;
}

fn widen(value: Width) -> Chain {
    return value + 1;
}

fn main() -> i32 {
    var width: Width = 10;
    let chained: Chain = width;
    let grown: Chain = widen(chained);
    var pixels: Pixels = {};
    pixels[2] = 30;
    var cursor: Cursor = &pixels[0];
    let handle: Handle = -7;

    if (sizeof(Width) != 4 ||
        alignof(Handle) != 8 ||
        sizeof(Pixels) != 16 ||
        sizeof(Box) != 16 ||
        offsetof(Box, handle) != 8 ||
        sizeof(Cursor) != 8) {
        return 1;
    }
    if (grown != 11 || chained != 10) {
        return 2;
    }
    pixels[2] = 30;
    if (*cursor != 0 || *(&pixels[2]) != 30) {
        return 3;
    }
    width = 20;
    if (width != 20 || *(&pixels[0]) != 0) {
        return 4;
    }
    if (handle >= 0) {
        return 5;
    }

    switch (grown as Width) {
        case 11 {
            return 42;
        }
        default {
            return 6;
        }
    }
}
