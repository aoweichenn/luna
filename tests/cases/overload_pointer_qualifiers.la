module tests.overload_pointer_qualifiers;

fn select(value: *u8) -> i32 {
    return *value as i32 + 20;
}

fn select(value: *const u8) -> i32 {
    return *value as i32 + 21;
}

fn main() -> i32 {
    var value: u8 = 1;
    var mutable_pointer: *u8 = &value;
    let readonly_pointer: *const u8 = mutable_pointer as *const u8;
    if (select(mutable_pointer) != 21 || select(readonly_pointer) != 22) {
        return 1;
    }
    return 42;
}
