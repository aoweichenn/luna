module tests.fail_class_inherited_private_field;

class Base {
    priv value: i32;
    pub init(value: i32);
}

class Derived : Base {
    pub init(value: i32);
    pub fn read() const -> i32;
}

impl Base {
    init(value: i32) {
        this->value = value;
    }
}

impl Derived {
    init(value: i32) {
        super.init(value);
    }

    fn read() const -> i32 {
        return this->value;
    }
}

fn main() -> i32 {
    return 42;
}
