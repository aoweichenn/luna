module tests.class_composition_nested_array;

class Value {
    priv stored: i32;

    pub init(stored: i32);
    pub fn read() const -> i32;
}

class Matrix {
    priv values: [2][2]Value;

    pub init();
    pub fn answer() const -> i32;
}

impl Value {
    init(stored: i32) {
        this->stored = stored;
    }

    fn read() const -> i32 {
        return this->stored;
    }
}

impl Matrix {
    init() : values = {{Value(10), Value(11)}, {Value(20), Value(22)}} {
    }

    fn answer() const -> i32 {
        return this->values[1][0].read() + this->values[1][1].read();
    }
}

fn main() -> i32 {
    let matrix: Matrix = Matrix();
    return matrix.answer();
}
