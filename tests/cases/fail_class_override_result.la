module tests.fail_class_override_result;

class Base {
    pub virtual fn read() const -> i32;
}

class Derived : Base {
    pub override fn read() const -> u32;
}

impl Base {
    fn read() const -> i32 {
        return 1;
    }
}

impl Derived {
    fn read() const -> u32 {
        return 2;
    }
}

fn main() -> i32 {
    return 42;
}
