module tests.class_bound_methods;

type Callback = method fn(i32) -> i32;

class Base {
    prot value: i32;
    pub init(value: i32);
    pub virtual fn transform(input: i32) const -> i32;
}

class Derived : Base {
    pub init(value: i32);
    pub override fn transform(input: i32) const -> i32;
    pub fn adjust(input: i32) const -> i32;
    pub fn adjust(input: u32) const -> i32;
}

impl Base {
    init(value: i32) {
        this->value = value;
    }

    fn transform(input: i32) const -> i32 {
        return this->value + input;
    }
}

impl Derived {
    init(value: i32) {
        super.init(value);
    }

    fn transform(input: i32) const -> i32 {
        return this->value + input + 10;
    }

    fn adjust(input: i32) const -> i32 {
        return this->value + input;
    }

    fn adjust(input: u32) const -> i32 {
        return this->value + input as i32 + 100;
    }
}

fn apply(callback: Callback, input: i32) -> i32 {
    return callback(input);
}

fn bind(value: *const Base) -> Callback {
    return value->transform;
}

fn main() -> i32 {
    if (sizeof(Callback) != 16 || alignof(Callback) != 8) {
        return 1;
    }
    let value: Derived = Derived(20);
    let base: *const Base = (&value) as *const Base;
    let virtual_callback: Callback = bind(base);
    let copied: Callback = virtual_callback;
    if (apply(copied, 12) != 42) {
        return 2;
    }
    let overloaded: Callback = value.adjust;
    return overloaded(22);
}
