module tests.class_rtti;

@rtti class Shape {
    pub init();
    pub abstract fn value() const -> i32;
}

class Circle : Shape {
    pub init(value: i32);
    pub override fn value() const -> i32;
}

class Square : Shape {
    pub init();
    pub override fn value() const -> i32;
}

impl Shape {
    init() {
    }
}

impl Circle {
    init(value: i32) {
        super.init();
    }

    fn value() const -> i32 {
        return 42;
    }
}

impl Square {
    init() {
        super.init();
    }

    fn value() const -> i32 {
        return 7;
    }
}

fn inspect(shape: *const Shape) -> i32 {
    if (!@type_is(shape, Circle)) {
        return 1;
    }
    let circle: *const Circle = @type_cast(shape, Circle);
    if (circle == null || circle->value() != 42) {
        return 2;
    }
    let base: *const Shape = @type_cast(circle, Shape);
    if (base != shape) {
        return 3;
    }
    let qualified_shape: *const volatile Shape = shape as *const volatile Shape;
    let qualified_circle: *const volatile Circle = @type_cast(qualified_shape, Circle);
    return qualified_circle == null ? 4 : 42;
}

fn main() -> i32 {
    let circle: Circle = Circle(42);
    let shape: *const Shape = (&circle) as *const Shape;
    if (inspect(shape) != 42) {
        return 5;
    }
    let square: Square = Square();
    let other: *const Shape = (&square) as *const Shape;
    if (@type_is(other, Circle) || @type_cast(other, Circle) != null) {
        return 6;
    }
    let empty: *const Shape = null;
    if (@type_is(empty, Circle) || @type_cast(empty, Circle) != null) {
        return 7;
    }
    return 42;
}
