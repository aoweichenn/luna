module tests.fail_overload_nested_ambiguous;

fn inner(value: i32) -> i32 {
    return value;
}

fn inner(value: i64) -> i32 {
    return value as i32;
}

fn outer(value: i32) -> i32 {
    return value;
}

fn outer(value: u32) -> i32 {
    return value as i32;
}

fn main() -> i32 {
    return outer(inner(1) + (0 as i32));
}
