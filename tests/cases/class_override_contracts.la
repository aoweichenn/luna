module tests.class_override_contracts;

class Base {
    prot stored: i32;

    pub init(value: i32);
    pub virtual fn compute(delta: i32) const -> i32;
}

class Derived : Base {
    pub init(value: i32);
    pub override final fn compute(delta: i32) const -> i32;
    pub fn base_compute(delta: i32) const -> i32;
}

impl Base {
    init(value: i32) {
        this->stored = value;
    }

    fn compute(delta: i32) const -> i32 {
        return this->stored + delta;
    }
}

impl Derived {
    init(value: i32) {
        super.init(value);
    }

    fn compute(delta: i32) const -> i32 {
        return this->stored + delta + 1;
    }

    fn base_compute(delta: i32) const -> i32 {
        return super.compute(delta);
    }
}

fn main() -> i32 {
    let value: Derived = Derived(20);
    if (value.compute(21) != 42) {
        return 1;
    }
    return value.base_compute(22);
}
