module tests.fail_class_friend_reverse;

class Owner {
    friend class Inspector;
    priv value: i32;
}

class Inspector {
    priv value: i32;
    pub fn reverse(owner: *const Owner) const -> i32;
}

impl Inspector {
    fn reverse(owner: *const Owner) const -> i32 {
        return owner->value + this->value;
    }
}

impl Owner {
    priv fn invalid(inspector: *const Inspector) const -> i32 {
        return inspector->value;
    }
}

fn main() -> i32 {
    return 42;
}
