module tests.class_overloads;

class Number {
    priv value: i32;

    pub init(value: i32);
    pub init(value: u32);
    pub fn add(value: i32, bias: i32 = 1) const -> i32;
    pub fn add(value: u32) const -> i32;
    pub static fn add(value: i32) -> i32;
}

impl Number {
    init(value: i32) {
        this->value = value;
    }

    init(value: u32) {
        this->value = value as i32 + 10;
    }

    fn add(value: i32, bias: i32) const -> i32 {
        return this->value + value + bias;
    }

    fn add(value: u32) const -> i32 {
        return this->value + value as i32 + 2;
    }

    static fn add(value: i32) -> i32 {
        return value;
    }
}

fn main() -> i32 {
    let signed: Number = Number(20 as i32);
    let unsigned: Number = Number(20 as u32);
    if (signed.add(21 as i32) != 42 || signed.add(20 as u32) != 42) {
        return 1;
    }
    if (unsigned.add(11 as i32) != 42) {
        return 2;
    }
    if (Number(20 as i32).add(21 as i32) != 42) {
        return 3;
    }
    return Number.add(42);
}
