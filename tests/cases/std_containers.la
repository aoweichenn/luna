module tests.std_containers;

import luna.internal.pool::{pool_allocation, slot_pool};
import luna.internal.tree::{ordered_tree, tree_erase_result, tree_insert_result};
import luna.runtime as runtime;
import luna.std.deque::{deque};
import luna.std.list::{list};
import luna.std.map::{map, map_erase_result, map_insert_result};
import luna.std.queue::{queue};
import luna.std.utility as utility;

fn test_pool() -> bool {
    var values: slot_pool<i32> = slot_pool<i32>();
    var addresses: [70]*i32 = {};
    for (var index: usize = 0; index < 70; index += 1) {
        let created: pool_allocation<i32> = values.allocate();
        if (created.error != runtime::Error.none || created.address == null) {
            return false;
        }
        addresses[index] = created.address;
        *created.address = index as i32;
    }
    if (values.size() != 70 || !values.is_valid()) {
        return false;
    }
    for (var index: usize = 0; index < 70; index += 2) {
        if (values.deallocate(addresses[index]) != runtime::Error.none) {
            return false;
        }
        if (values.deallocate(addresses[index]) != runtime::Error.invalid_argument) {
            return false;
        }
    }
    var moved: slot_pool<i32> = utility::move(values);
    let move_is_valid: bool = values.size() == 0 && moved.size() == 35;
    return move_is_valid && moved.is_valid();
}

fn test_deque() -> bool {
    var values: deque<i32> = deque<i32>();
    for (var value: i32 = 0; value < 96; value += 1) {
        if (values.push_back(value) != runtime::Error.none) {
            return false;
        }
    }
    for (var index: usize = 0; index < 37; index += 1) {
        if (values.pop_front() != runtime::Error.none) {
            return false;
        }
    }
    for (var value: i32 = 1; value <= 31; value += 1) {
        if (values.push_front(-value) != runtime::Error.none) {
            return false;
        }
    }
    let shape_is_valid: bool = values.size() == 90 && values.front() == -31;
    let content_is_valid: bool = values.get(31) == 37 && values.back() == 95;
    let deque_is_valid: bool = shape_is_valid && content_is_valid;
    if (!deque_is_valid || !values.is_valid()) {
        return false;
    }
    values.get(31) = 42;
    var moved: deque<i32> = utility::move(values);
    let move_is_valid: bool = values.empty() && moved.get(31) == 42;
    return move_is_valid && moved.is_valid();
}

fn test_list() -> bool {
    var values: list<i32> = list<i32>();
    if (values.push_back(20) != runtime::Error.none || values.push_front(10) != runtime::Error.none) {
        return false;
    }
    let stable: *i32 = &values.front();
    for (var value: i32 = 30; value <= 90; value += 10) {
        if (values.push_back(value) != runtime::Error.none) {
            return false;
        }
    }
    let front_is_stable: bool = &values.front() == stable && *stable == 10;
    if (!front_is_stable || values.back() != 90) {
        return false;
    }
    if (values.pop_front() != runtime::Error.none || values.pop_back() != runtime::Error.none) {
        return false;
    }
    var moved: list<i32> = utility::move(values);
    let endpoints_are_valid: bool = moved.front() == 20 && moved.back() == 80;
    let move_is_valid: bool = values.empty() && endpoints_are_valid;
    return move_is_valid && moved.is_valid();
}

fn test_tree() -> bool {
    var values: ordered_tree<i32, i32> = ordered_tree<i32, i32>();
    let keys: [15]i32 = { 8, 4, 12, 2, 6, 10, 14, 1, 3, 5, 7, 9, 11, 13, 15 };
    for (var index: usize = 0; index < 15; index += 1) {
        let key: i32 = keys[index];
        let inserted: tree_insert_result<i32> = values.insert(key, key * 10);
        if (inserted.error != runtime::Error.none || !inserted.inserted) {
            return false;
        }
        if (!values.is_valid()) {
            return false;
        }
    }
    let duplicate: tree_insert_result<i32> = values.insert(8, 999);
    let duplicate_is_valid: bool = duplicate.error == runtime::Error.none && !duplicate.inserted;
    if (!duplicate_is_valid || *duplicate.value != 80) {
        return false;
    }
    let removals: [15]i32 = { 1, 14, 8, 6, 12, 3, 10, 4, 15, 2, 9, 5, 11, 7, 13 };
    for (var index: usize = 0; index < 15; index += 1) {
        let removed: tree_erase_result = values.erase(removals[index]);
        if (removed.error != runtime::Error.none || !removed.erased) {
            return false;
        }
        if (!values.is_valid()) {
            return false;
        }
    }
    return values.empty();
}

fn test_map() -> bool {
    var values: map<i32, i32> = map<i32, i32>();
    for (var key: i32 = 0; key < 127; key += 1) {
        let permuted: i32 = (key * 37) % 127;
        let inserted: map_insert_result<i32> = values.insert(permuted, permuted + 1000);
        if (inserted.error != runtime::Error.none || !inserted.inserted) {
            return false;
        }
    }
    let key: i32 = 42;
    let found: *i32 = values.find(key);
    let lookup_is_valid: bool = found != null && *found == 1042;
    if (!lookup_is_valid || !values.contains(key)) {
        return false;
    }
    let assigned: map_insert_result<i32> = values.insert_or_assign(key, 7);
    let assignment_is_valid: bool = assigned.error == runtime::Error.none && !assigned.inserted;
    if (!assignment_is_valid || *assigned.value != 7) {
        return false;
    }
    for (var removed_key: i32 = 0; removed_key < 127; removed_key += 3) {
        let removed: map_erase_result = values.erase(removed_key);
        if (removed.error != runtime::Error.none || !removed.erased) {
            return false;
        }
    }
    return values.size() == 84 && values.is_valid();
}

fn test_queue() -> bool {
    var values: queue<i32> = queue<i32>();
    for (var value: i32 = 1; value <= 80; value += 1) {
        if (values.push(value) != runtime::Error.none) {
            return false;
        }
    }
    for (var expected: i32 = 1; expected <= 50; expected += 1) {
        if (values.front() != expected || values.pop() != runtime::Error.none) {
            return false;
        }
    }
    var moved: queue<i32> = utility::move(values);
    let endpoints_are_valid: bool = moved.front() == 51 && moved.back() == 80;
    let move_is_valid: bool = values.empty() && endpoints_are_valid;
    return move_is_valid && moved.is_valid();
}

fn main() -> i32 {
    if (!test_pool()) {
        return 1;
    }
    if (!test_deque()) {
        return 2;
    }
    if (!test_list()) {
        return 3;
    }
    if (!test_tree()) {
        return 4;
    }
    if (!test_map()) {
        return 5;
    }
    return test_queue() ? 0 : 6;
}
