module tests.let_inference;

struct Point {
    x: i32;
    y: i32;
}

fn compute(a: i32, b: i32) -> i32 {
    return a * 2 + b;
}

fn head(first: *u32) -> *u32 {
    return first;
}

fn main() -> i32 {
    let literal = 7;
    let call = compute(literal, 4);
    let expression = call - literal + 1;
    var total = compute(expression, 0);
    total += 18;
    var values: [3]u32 = {10, 20, 12};
    let cursor = head(&values[0]);
    if (*cursor != 10) {
        return 1;
    }
    let operation = compute;
    if (operation(1, 0) != 2) {
        return 2;
    }
    let point: Point = {x = 30, y = 12};
    let copy = point;
    if (copy.x != 30 || copy.y != 12) {
        return 3;
    }
    if (literal != 7 || call != 18 || expression != 12) {
        return 4;
    }
    return total;
}
