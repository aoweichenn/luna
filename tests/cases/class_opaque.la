module tests.class_opaque;

import tests.modules.opaque_counter as counters;

fn main() -> i32 {
    let value: *const counters::Counter = null;
    if (!counters::is_null(value)) {
        return 1;
    }
    let mutable_value: *counters::Counter = null;
    if (counters::identity(mutable_value) != null) {
        return 2;
    }
    return counters::answer();
}
