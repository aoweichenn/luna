module tests.fail_class_rtti_unrelated;

@rtti class Left {
    pub init();
    pub virtual fn read() const -> i32;
}

@rtti class Right {
    pub init();
    pub virtual fn read() const -> i32;
}

impl Left {
    init() {
    }

    fn read() const -> i32 {
        return 0;
    }
}

impl Right {
    init() {
    }

    fn read() const -> i32 {
        return 0;
    }
}

fn main() -> i32 {
    let value: Left = Left();
    return @type_is(&value, Right) ? 1 : 0;
}
