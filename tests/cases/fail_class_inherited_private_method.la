module tests.fail_class_inherited_private_method;

class Base {
}

class Derived : Base {
    pub fn expose() const -> i32;
}

impl Base {
    priv fn hidden() const -> i32 {
        return 42;
    }
}

impl Derived {
    fn expose() const -> i32 {
        return this->hidden();
    }
}

fn main() -> i32 {
    return 42;
}
