module tests.class_composition_inheritance;

class Value {
    priv stored: i32;

    pub init(stored: i32);
    pub fn read() const -> i32;
}

class Base {
    priv base_value: Value;

    pub init(value: i32);
    pub fn base_read() const -> i32;
}

class Derived : Base {
    priv derived_value: Value;

    pub init(first: i32, second: i32);
    pub fn total() const -> i32;
}

impl Value {
    init(stored: i32) {
        this->stored = stored;
    }

    fn read() const -> i32 {
        return this->stored;
    }
}

impl Base {
    init(value: i32) : base_value = Value(value) {
    }

    fn base_read() const -> i32 {
        return this->base_value.read();
    }
}

impl Derived {
    init(first: i32, second: i32) : derived_value = Value(second) {
        super.init(first);
    }

    fn total() const -> i32 {
        return this->base_read() + this->derived_value.read();
    }
}

fn main() -> i32 {
    let value: Derived = Derived(20, 22);
    return value.total();
}
