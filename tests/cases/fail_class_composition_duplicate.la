module tests.fail_class_composition_duplicate;

class Child {
    pub init(value: i32);
}

class Parent {
    priv first: Child;
    priv second: Child;

    pub init();
}

impl Child {
    init(value: i32) {
    }
}

impl Parent {
    init() : first = Child(1), first = Child(2), second = Child(3) {
    }
}

fn main() -> i32 {
    return 0;
}
