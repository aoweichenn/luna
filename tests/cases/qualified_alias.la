module tests.qualified_alias;

import tests.modules.mathx as mx;

fn main() -> i32 {
    if (mx::triple(14) != 42) {
        return 1;
    }
    if (mx::answer != 42) {
        return 2;
    }
    let point: mx::Point = { x = 41, y = 1, };
    if (point.x + point.y != 42) {
        return 3;
    }
    let shade: mx::Color = mx::Color.blue;
    if (shade != mx::Color.blue) {
        return 4;
    }
    return 42;
}
