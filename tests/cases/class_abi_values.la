module tests.class_abi_values;

class Mixed {
    pub real: f64;
    pub integer: i32;

    pub init(real: f64, integer: i32);
    pub fn sum() const -> i32;
}

class Wide {
    pub first: i64;
    pub second: i64;
    pub third: i64;

    pub init(first: i64, second: i64, third: i64);
    pub fn sum() const -> i32;
}

impl Mixed {
    init(real: f64, integer: i32) {
        this->real = real;
        this->integer = integer;
    }

    fn sum() const -> i32 {
        return this->real as i32 + this->integer;
    }
}

impl Wide {
    init(first: i64, second: i64, third: i64) {
        this->first = first;
        this->second = second;
        this->third = third;
    }

    fn sum() const -> i32 {
        return (this->first + this->second + this->third) as i32;
    }
}

fn relay_mixed(value: Mixed) -> Mixed {
    return value;
}

fn relay_wide(value: Wide) -> Wide {
    return value;
}

fn main() -> i32 {
    let mixed: Mixed = relay_mixed(Mixed(20.0, 22));
    let wide: Wide = relay_wide(Wide(10, 11, 21));
    if (mixed.sum() != 42) {
        return 1;
    }
    return wide.sum();
}
