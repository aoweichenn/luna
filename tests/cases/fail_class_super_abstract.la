module tests.fail_class_super_abstract;

class AbstractBase {
    pub abstract fn read() const -> i32;
}

class Concrete : AbstractBase {
    pub override fn read() const -> i32;
    pub fn base_read() const -> i32;
}

impl Concrete {
    fn read() const -> i32 {
        return 42;
    }

    fn base_read() const -> i32 {
        return super.read();
    }
}

fn main() -> i32 {
    return 42;
}
