module tests.overflow_intrinsics;

fn main() -> i32 {
    var r_u8: u8 = 0;
    let a_u8: u8 = 200;
    let b_u8: u8 = 100;
    if (!@add_overflow(a_u8, b_u8, &r_u8) || r_u8 != 44) {
        return 1;
    }
    if (@add_overflow(40 as u8, 2, &r_u8) || r_u8 != 42) {
        return 2;
    }
    if (@sub_overflow(b_u8, 58, &r_u8) || r_u8 != 42) {
        return 3;
    }
    if (!@sub_overflow(0 as u8, 1, &r_u8) || r_u8 != 255) {
        return 4;
    }

    var r_i8: i8 = 0;
    let max_i8: i8 = 127;
    let min_i8: i8 = -128;
    if (!@add_overflow(max_i8, 1, &r_i8) || r_i8 != min_i8) {
        return 5;
    }
    if (!@sub_overflow(min_i8, 1, &r_i8) || r_i8 != 127) {
        return 6;
    }
    if (!@mul_overflow(100 as i8, 2, &r_i8) || r_i8 != -56) {
        return 7;
    }
    if (@mul_overflow(10 as i8, 4, &r_i8) || r_i8 != 40) {
        return 8;
    }

    var r_u16: u16 = 0;
    let max_u16: u16 = 65535;
    if (!@add_overflow(max_u16, 1, &r_u16) || r_u16 != 0) {
        return 9;
    }
    if (@add_overflow(1000 as u16, 2, &r_u16) || r_u16 != 1002) {
        return 10;
    }

    var r_i16: i16 = 0;
    let max_i16: i16 = 32767;
    let min_i16: i16 = -32768;
    if (!@add_overflow(max_i16, 1, &r_i16) || r_i16 != min_i16) {
        return 11;
    }
    if (!@sub_overflow(min_i16, 1, &r_i16) || r_i16 != 32767) {
        return 12;
    }

    var r_u32: u32 = 0;
    let max_u32: u32 = 0xFFFFFFFF;
    if (!@add_overflow(max_u32, 1, &r_u32) || r_u32 != 0) {
        return 13;
    }
    if (!@mul_overflow(65536 as u32, 65536, &r_u32) || r_u32 != 0) {
        return 14;
    }
    if (@mul_overflow(1000 as u32, 1000, &r_u32) || r_u32 != 1000000) {
        return 15;
    }

    var r_i32: i32 = 0;
    let max_i32: i32 = 2147483647;
    let min_i32: i32 = -2147483648;
    if (!@add_overflow(max_i32, 1, &r_i32) || r_i32 != min_i32) {
        return 16;
    }
    if (!@sub_overflow(min_i32, 1, &r_i32) || r_i32 != 2147483647) {
        return 17;
    }
    if (!@mul_overflow(100000 as i32, 100000, &r_i32) || r_i32 != 1410065408) {
        return 18;
    }

    var r_u64: u64 = 0;
    let max_u64: u64 = 0xFFFFFFFFFFFFFFFF;
    if (!@add_overflow(max_u64, 1, &r_u64) || r_u64 != 0) {
        return 19;
    }
    if (!@mul_overflow(max_u64, 2, &r_u64) || r_u64 != 0xFFFFFFFFFFFFFFFE) {
        return 20;
    }
    if (@sub_overflow(100 as u64, 58, &r_u64) || r_u64 != 42) {
        return 21;
    }

    var r_i64: i64 = 0;
    let max_i64: i64 = 9223372036854775807;
    let min_i64: i64 = -9223372036854775808;
    let neg_i64: i64 = -5;
    if (!@add_overflow(max_i64, 1, &r_i64) || r_i64 != min_i64) {
        return 22;
    }
    if (!@sub_overflow(min_i64, 1, &r_i64) || r_i64 != max_i64) {
        return 23;
    }
    if (@mul_overflow(neg_i64, 3, &r_i64) || r_i64 != -15) {
        return 24;
    }

    var r_usize: usize = 0;
    let max_usize: usize = 0xFFFFFFFFFFFFFFFF;
    if (!@add_overflow(max_usize, 1, &r_usize) || r_usize != 0) {
        return 25;
    }

    var r_isize: isize = 0;
    let min_isize: isize = -9223372036854775808;
    if (!@sub_overflow(min_isize, 1, &r_isize) || r_isize != 9223372036854775807) {
        return 26;
    }

    // u64 mul: 2^63 * 2 wraps to 0; the stored zero must not read as a clean product.
    let high_u64: u64 = 0x8000000000000000;
    if (!@mul_overflow(high_u64, 2, &r_u64) || r_u64 != 0) {
        return 27;
    }
    // u64 mul: 2^32 * 2^16 = 2^48 fits, so no overflow and the exact product is stored.
    if (@mul_overflow(0x100000000 as u64, 0x10000, &r_u64) || r_u64 != 0x1000000000000) {
        return 28;
    }
    return 42;
}
