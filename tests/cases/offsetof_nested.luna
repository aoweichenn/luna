module tests.offsetof_nested;

struct Header {
    tag: u8;
    length: u16;
}

union Payload {
    raw: u32;
    bytes: [4]u8;
}

struct Packet {
    kind: u8;
    header: Header;
    payload: Payload;
}

struct Inner {
    a: u8;
    b: u8;
}

struct Middle {
    struct {
        inner: Inner;
    }
    last: u8;
}

struct Outer {
    tag: u8;
    struct {
        x: u16;
        y: u8;
    }
    tail: u32;
}

union Word {
    whole: u32;
    parts: Inner;
}

struct Frame {
    id: u8;
    word: Word;
}

assert(offsetof(Packet, header.tag) == 2);
assert(offsetof(Packet, header.length) == 4);
assert(offsetof(Packet, payload.raw) == 8);
assert(offsetof(Packet, payload.bytes) == 8);
assert(offsetof(Middle, inner.a) == 0);
assert(offsetof(Middle, inner.b) == 1);
assert(offsetof(Middle, last) == 2);
assert(offsetof(Outer, x) == 2 && offsetof(Outer, y) == 4);
assert(offsetof(Outer, tail) == 8);
assert(offsetof(Frame, word.whole) == 4);
assert(offsetof(Frame, word.parts.a) == 4);
assert(offsetof(Frame, word.parts.b) == 5);

fn main() -> i32 {
    let tag_offset = offsetof(Packet, header.tag);
    if (tag_offset != 2 || offsetof(Packet, header.length) != 4 ||
        offsetof(Packet, payload.raw) != 8 || offsetof(Packet, payload.bytes) != 8 ||
        offsetof(Middle, inner.a) != 0 || offsetof(Middle, inner.b) != 1 ||
        offsetof(Outer, x) != 2 || offsetof(Outer, y) != 4 || offsetof(Outer, tail) != 8 ||
        offsetof(Frame, word.whole) != 4 || offsetof(Frame, word.parts.a) != 4 ||
        offsetof(Frame, word.parts.b) != 5) {
        return 1;
    }
    var packet: Packet = {};
    let base: *u8 = (&packet) as *u8;
    let length_pointer: *u16 = (base + offsetof(Packet, header.length)) as *u16;
    *length_pointer = 42;
    if (packet.header.length != 42 || packet.header.tag != 0) {
        return 2;
    }
    return 42;
}
