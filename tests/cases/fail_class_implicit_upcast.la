module tests.fail_class_implicit_upcast;

class Base {
    pub init();
}

class Derived : Base {
    pub init();
}

impl Base {
    init() {
    }
}

impl Derived {
    init() {
        super.init();
    }
}

fn main() -> i32 {
    var value: Derived = Derived();
    let base: *Base = &value;
    return 42;
}
