module tests.literals_extended;

assert('a' == 97);
assert('\n' == 10);
assert(0b101010 == 42);

fn main() -> i32 {
    // Character literals take the integer type required by context, i32 by default.
    if ('a' as i32 != 97) {
        return 1;
    }
    let c: u8 = 'A';
    if (c != 65) {
        return 2;
    }
    if ('\n' != 10) {
        return 3;
    }
    if ('\x41' != 65) {
        return 4;
    }
    if ('\r' != 13 || '\t' != 9 || '\0' != 0) {
        return 5;
    }
    if ('\\' != 92 || '\'' != 39 || '\"' != 34) {
        return 6;
    }
    if ('a' + 1 != 98) {
        return 7;
    }
    let wide: u64 = '\xff';
    if (wide != 255) {
        return 8;
    }

    // Binary integer literals, with separators, across widths.
    if (0b1010 != 10) {
        return 9;
    }
    if (0b1010_0110 != 166) {
        return 10;
    }
    let byte_max: u8 = 0b11111111;
    if (byte_max != 255) {
        return 11;
    }
    let word_max: u16 = 0b11111111_11111111;
    if (word_max != 65535) {
        return 12;
    }
    let all_ones: u64 = 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111;
    if (all_ones != 18446744073709551615) {
        return 13;
    }
    if (0b1_0 as i8 != 2) {
        return 14;
    }

    // Hexadecimal floating literals: exact binary fractions with a mandatory p exponent.
    if (0x1.8p3 != 12.0) {
        return 15;
    }
    if (0x1.fp-2 != 0.484375) {
        return 16;
    }
    let single: f32 = 0x1.8p3;
    if (single != 12.0) {
        return 17;
    }
    if (0x1_0.0p0 != 16.0 || 0x1.8p1_0 != 1536.0) {
        return 18;
    }
    if (0x.8p1 != 1.0) {
        return 19;
    }
    let tiny_single: f32 = 0x1p-149;
    if (tiny_single <= 0.0) {
        return 20;
    }
    let pi: f64 = 0x1.921fb54442d18p+1;
    if (pi < 3.14159265 || pi > 3.14159266) {
        return 21;
    }

    // Mixed contextual typing: character and binary literals share the integer family.
    if ('a' + 0b1 != 98) {
        return 22;
    }
    let shifted: u8 = 0b1 << 3;
    if (shifted != 8) {
        return 23;
    }
    return 42;
}
