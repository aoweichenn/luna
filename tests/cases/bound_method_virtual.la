module tests.bound_method_virtual;

type Callback = method fn(i32) -> i32;

class Base {
    pub init();
    pub virtual fn read(input: i32) const -> i32;
}

class Derived : Base {
    pub init();
    pub override fn read(input: i32) const -> i32;
}

impl Base {
    init() {
    }

    fn read(input: i32) const -> i32 {
        return input;
    }
}

impl Derived {
    init() {
        super.init();
    }

    fn read(input: i32) const -> i32 {
        return input;
    }
}

fn main() -> i32 {
    let value: Derived = Derived();
    let base: *const Base = (&value) as *const Base;
    let callback: Callback = base->read;
    return callback(42);
}
