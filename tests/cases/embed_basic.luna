module tests.embed_basic;

fn main() -> i32 {
    var data: [16]u8 = @embed("embed_blob.bin");
    var index: usize = 0;
    while (index < 16) {
        if (data[index] != index as u8) {
            return 1;
        }
        index += 1;
    }
    if (sizeof(@embed("embed_blob.bin")) != 16) {
        return 2;
    }
    let first: *const u8 = &@embed("embed_blob.bin")[0];
    var offset: usize = 0;
    while (offset < 16) {
        if (first[offset] != offset as u8) {
            return 3;
        }
        offset += 1;
    }
    // Adjacent literal concatenation decodes like any string literal.
    var copy: [16]u8 = @embed("embed_" "blob.bin");
    if (copy[0] != 0 || copy[15] != 15) {
        return 4;
    }
    // Mutating the local copy must not touch the embedded global: a second embed reads it back.
    data[0] = 255;
    if (data[0] != 255) {
        return 5;
    }
    let again: *const u8 = &@embed("embed_blob.bin")[0];
    if (again[0] != 0) {
        return 6;
    }
    return 42;
}
