module tests.class_inheritance_basic;

class Base {
    prot value: i32;

    pub init(value: i32);
    pub fn read() const -> i32;
    pub fn add(delta: i32);
    pub static fn answer() -> i32;
}

class Derived : Base {
    priv extra: i32;

    pub init(value: i32, extra: i32);
    pub fn total() const -> i32;
}

impl Base {
    init(value: i32) {
        this->value = value;
    }

    fn read() const -> i32 {
        return this->value;
    }

    fn add(delta: i32) {
        this->value += delta;
    }

    static fn answer() -> i32 {
        return 42;
    }
}

impl Derived {
    init(value: i32, extra: i32) {
        super.init(value);
        this->extra = extra;
    }

    fn total() const -> i32 {
        return this->value + this->extra;
    }
}

fn main() -> i32 {
    if (sizeof(Base) != 4 || sizeof(Derived) != 8) {
        return 1;
    }
    if (alignof(Derived) != 4) {
        return 4;
    }
    var value: Derived = Derived(20, 20);
    value.add(2);
    if (value.read() != 22 || value.total() != 42) {
        return 2;
    }
    if (Derived.answer() != 42) {
        return 3;
    }
    let base: *Base = (&value) as *Base;
    return base->read() + 20;
}
