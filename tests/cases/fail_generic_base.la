module tests.fail_generic_base;

class Root {
    pub init();
}

impl Root {
    init() {
    }
}

class Derived<Value> : Root {
    priv value: Value;

    pub init(value: Value);
}

impl Derived {
    init(value: Value)
        : value = value {
        super.init();
    }
}

fn main() -> i32 {
    let value: Derived<i32> = Derived<i32>(1);
    return 0;
}
