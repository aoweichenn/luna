module tests.attr_noreturn;

extern fn luna_linux_syscall1(number: usize, argument0: usize) -> isize;

@noreturn fn spin() {
    loop {
    }
}

@noreturn fn fail() {
    luna_linux_syscall1(60, 42);
    loop {
    }
}

@noreturn fn boom() -> i32 {
    loop {
    }
}

fn identity(value: i32) -> i32 {
    return value;
}

fn nested_noreturn_argument() -> i32 {
    return identity(boom());
}

fn dead_statements(value: i32) -> i32 {
    var local: i32 = value;
    if (local == 0) {
        fail();
        local = 1;
        local += 2;
    }
    return local;
}

fn main() -> i32 {
    if (dead_statements(1) != 1) {
        spin();
    }
    fail();
}
