module tests.fail_class_composition_order;

class Child {
    pub init(value: i32);
}

class Parent {
    priv first: Child;
    priv second: Child;

    pub init();
}

impl Child {
    init(value: i32) {
    }
}

impl Parent {
    init() : second = Child(2), first = Child(1) {
    }
}

fn main() -> i32 {
    return 0;
}
