module tests.class_devirtualization;

final class FinalValue {
    pub init();
    pub virtual fn read() const -> i32;
}

class Base {
    pub init();
    pub virtual fn read() const -> i32;
}

class Derived : Base {
    pub init();
    pub override fn read() const -> i32;
}

impl FinalValue {
    init() {
    }

    fn read() const -> i32 {
        return 20;
    }
}

impl Base {
    init() {
    }

    fn read() const -> i32 {
        return 1;
    }
}

impl Derived {
    init() {
        super.init();
    }

    fn read() const -> i32 {
        return 22;
    }
}

fn final_pointer(value: *const FinalValue) -> i32 {
    return value->read();
}

fn dynamic_pointer(value: *const Base) -> i32 {
    return value->read();
}

fn main() -> i32 {
    let final_value: FinalValue = FinalValue();
    let derived: Derived = Derived();
    let base: *const Base = (&derived) as *const Base;
    return final_pointer(&final_value) + dynamic_pointer(base);
}
