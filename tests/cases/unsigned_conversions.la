module test.unsigned_conversions;

fn main() -> i32 {
    let signed_wide: u64 = (-1 as i32) as u64;
    let unsigned_wide: i64 = (4294967295 as u32) as i64;
    let narrow_signed: i32 = (18446744073709551615 as u64) as i32;
    let same32: u32 = (-1 as i32) as u32;
    let same64: i64 = (18446744073709551615 as u64) as i64;
    let narrowed: u32 = (4294967296 as u64) as u32;

    if (signed_wide == 18446744073709551615 &&
        unsigned_wide == 4294967295 &&
        narrow_signed == -1 &&
        same32 == 4294967295 &&
        same64 == -1 &&
        narrowed == 0) {
        return 42;
    }
    return 1;
}
