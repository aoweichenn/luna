module tests.raii_destructors;

class Guard {
    priv target: *i32;
    priv digit: i32;

    pub init(target: *i32, digit: i32);
    pub deinit();
}

impl Guard {
    init(target: *i32, digit: i32) {
        this->target = target;
        this->digit = digit;
    }

    deinit() {
        *this->target = *this->target * 10 + this->digit;
    }
}

class Pair {
    priv first: Guard;
    priv second: Guard;
    priv target: *i32;

    pub init(target: *i32);
    pub deinit();
}

class BaseGuard {
    prot target: *i32;

    pub init(target: *i32);
    pub deinit();
}

class DerivedGuard : BaseGuard {
    priv member: Guard;

    pub init(target: *i32);
    pub deinit();
}

impl Pair {
    init(target: *i32)
        : first = Guard(target, 1), second = Guard(target, 2) {
        this->target = target;
    }

    deinit() {
        *this->target = *this->target * 10 + 9;
    }
}

impl BaseGuard {
    init(target: *i32) {
        this->target = target;
    }

    deinit() {
        *this->target = *this->target * 10 + 4;
    }
}

impl DerivedGuard {
    init(target: *i32) : member = Guard(target, 5) {
        super.init(target);
    }

    deinit() {
        *this->target = *this->target * 10 + 9;
    }
}

fn nested(target: *i32) -> i32 {
    let first: Guard = Guard(target, 1);
    {
        let second: Guard = Guard(target, 2);
    }
    return *target;
}

fn loop_exit(target: *i32) {
    loop {
        let guard: Guard = Guard(target, 3);
        break;
    }
}

fn composition(target: *i32) {
    let pair: Pair = Pair(target);
}

fn array_cleanup(target: *i32) {
    let guards: [2]Guard = {Guard(target, 1), Guard(target, 2)};
}

fn inheritance_cleanup(target: *i32) {
    let guard: DerivedGuard = DerivedGuard(target);
}

fn main() -> i32 {
    var value: i32 = 0;
    let observed: i32 = nested(&value);
    if (observed != 2 || value != 21) {
        return 1;
    }
    value = 0;
    loop_exit(&value);
    if (value != 3) {
        return 2;
    }
    value = 0;
    composition(&value);
    if (value != 921) {
        return 3;
    }
    value = 0;
    array_cleanup(&value);
    if (value != 21) {
        return 4;
    }
    value = 0;
    inheritance_cleanup(&value);
    return value == 954 ? 0 : 5;
}
