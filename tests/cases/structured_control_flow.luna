module tests.structured_control_flow;

fn absolute(value: i32) -> i32 {
    return value >= 0 ? value : -value;
}

fn classify(value: u8) -> i32 {
    switch (value) {
        case -1 {
            return 7;
        }

        case 0, 1 {
            return 1;
        }

        default {
            return 0;
        }
    }
}

fn count_with_empty_for() -> i32 {
    var count: i32 = 0;
    for (;;) {
        count += 1;
        if (count == 3) {
            break;
        }
    }
    return count;
}

fn classify_without_default(value: i32) -> i32 {
    switch (value) {
        case +1 {
            return 1;
        }
    }
    return 2;
}

fn classify_with_default_first(value: i32) -> i32 {
    switch (value) {
        default {
            return 2;
        }

        case 1 {
            return 1;
        }
    }
}

fn noop() {
}

fn use_simple_for_clauses() -> i32 {
    var index: i32 = 9;
    for (index = 0; index < 1; noop()) {
        break;
    }
    return index;
}

fn main() -> i32 {
    var total: i32 = 0;
    var iteration: i32 = 0;

    do {
        iteration += 1;
        if (iteration < 3) {
            continue;
        }
        total += iteration;
    } while (iteration < 3);

    for (var index: i32 = 0; index < 8; index += 1) {
        switch (index) {
            case 0, 2, 4, 6 {
                continue;
            }

            case 5 {
                break;
            }

            default {
                total += 1;
            }
        }
        total += index;
    }

    let selected: i32 = true ? total + absolute(-20) : 1 / 0;
    let reverse_selected: i32 = false ? 1 / 0 : 5;
    let nested: i32 = false ? 1 : true ? 7 : 1 / 0;
    if (selected == 42 && nested == 7 && classify(255) == 7 &&
        reverse_selected == 5 &&
        count_with_empty_for() == 3 &&
        classify_without_default(9) == 2 &&
        classify_with_default_first(1) == 1 &&
        classify_with_default_first(9) == 2 &&
        use_simple_for_clauses() == 0) {
        return 42;
    }
    return 1;
}
