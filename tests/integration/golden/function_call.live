x86-64-liveness
target-triple "x86_64-unknown-linux-gnu"

define @f0 tests.function_call::add values=3 iterations=1
  bb0 use={} def={%v0, %v1, %v2} live-in={} live-out={}
    i0 before={} after={%v0}
    i1 before={%v0} after={%v0, %v1}
    i2 before={%v0, %v1} after={%v2}
    i3 before={%v2} after={}

define @f1 tests.function_call::main values=3 iterations=1
  bb0 use={} def={%v0, %v1, %v2} live-in={} live-out={}
    i0 before={} after={%v0}
    i1 before={%v0} after={%v0, %v1}
    i2 before={%v0, %v1} after={%v2}
    i3 before={%v2} after={}
