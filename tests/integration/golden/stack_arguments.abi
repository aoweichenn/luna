x86-64-system-v-abi
target-triple "x86_64-unknown-linux-gnu"

define @f0 tests.stack_arguments::integer_stack parameters=8 gp=6 sse=0 stack-bytes=16 call-frame=16
  p0 type=i8 class=integer location=%rdi
  p1 type=i16 class=integer location=%rsi
  p2 type=i32 class=integer location=%rdx
  p3 type=i64 class=integer location=%rcx
