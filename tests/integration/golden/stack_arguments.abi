  p5 type=u64 class=integer location=%r9
  p6 type=i8 class=integer location=stack[0]
  p7 type=u64 class=integer location=stack[8]

define @f1 tests.stack_arguments::float_stack parameters=10 gp=0 sse=8 stack-bytes=16 call-frame=16
