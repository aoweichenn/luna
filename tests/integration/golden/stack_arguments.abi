  p12 type=i32 class=integer location=stack[0]
  p13 type=f32 class=sse location=%xmm6
  p14 type=f64 class=sse location=%xmm7
  p15 type=f32 class=sse location=stack[8]

define @f3 tests.stack_arguments::main parameters=0 gp=0 sse=0 stack-bytes=0 call-frame=0
