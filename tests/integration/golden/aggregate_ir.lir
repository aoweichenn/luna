ir luna.v0
target "x86_64-unknown-linux-gnu"

fn @main() -> i32 {
bb0:
  zero $0
  %0 = address $0
  %1 = member_address 4, %0
  %2 = const.i32 42
  store_indirect.i32 %1, %2
  %3 = address $0
  store $1, %3
  %4 = load.ptr $1
  null_check %4
  %5 = member_address 4, %4
