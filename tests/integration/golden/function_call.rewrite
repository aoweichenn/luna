x86-64-instruction-rewrite
target-triple "x86_64-unknown-linux-gnu"
reserved={%rax, %rcx, %rdx, %rsi, %rdi, %r8, %r9, %r10, %r11, %xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %xmm5, %xmm6, %xmm7, %xmm15}

define @f0 tests.function_call::add values=3 instructions=4 spills=0 used={%rbx, %r12, %r13} callee-saved={%rbx, %r12, %r13}
  @0 load.slot uses=[] result=%rbx fixed-in={} fixed-out={} clobbers={%rax, %rcx, %xmm0} parallel-moves=0 destinations={}
  @1 load.slot uses=[] result=%r12 fixed-in={} fixed-out={} clobbers={%rax, %rcx, %xmm0} parallel-moves=0 destinations={}
  @2 add.integer uses=[%rbx, %r12] result=%r13 fixed-in={} fixed-out={} clobbers={%rax, %rcx, %xmm0} parallel-moves=0 destinations={}
  @3 return uses=[%r13] result=none fixed-in={%rax, %rdx, %r11, %xmm0, %xmm1} fixed-out={%rax, %rdx, %xmm0, %xmm1} clobbers={%rax, %rcx, %rdx, %rsi, %rdi, %r10, %r11, %xmm0, %xmm1, %xmm15} parallel-moves=0 destinations={}

define @f1 tests.function_call::main values=3 instructions=4 spills=0 used={%rbx, %r12, %r13} callee-saved={%rbx, %r12, %r13}
  @0 const.integer uses=[] result=%rbx fixed-in={} fixed-out={} clobbers={} parallel-moves=0 destinations={}
  @1 const.integer uses=[] result=%r12 fixed-in={} fixed-out={} clobbers={} parallel-moves=0 destinations={}
  @2 call uses=[%rbx, %r12] result=%r13 fixed-in={%rsi, %rdi} fixed-out={%rax} clobbers={%rax, %rcx, %rdx, %rsi, %rdi, %r8, %r9, %r10, %r11, %xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %xmm5, %xmm6, %xmm7, %xmm8, %xmm9, %xmm10, %xmm11, %xmm12, %xmm13, %xmm14, %xmm15} parallel-moves=2 destinations={%rsi, %rdi}
  @3 return uses=[%r13] result=none fixed-in={%rax, %rdx, %r11, %xmm0, %xmm1} fixed-out={%rax, %rdx, %xmm0, %xmm1} clobbers={%rax, %rcx, %rdx, %rsi, %rdi, %r10, %r11, %xmm0, %xmm1, %xmm15} parallel-moves=0 destinations={}
