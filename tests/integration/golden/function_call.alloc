x86-64-register-allocation
target-triple "x86_64-unknown-linux-gnu"

define @f0 tests.function_call::add values=3 instructions=4 spills=0 used={%rbx, %r12, %r13} callee-saved={%rbx, %r12, %r13}
  %v0 type=i32 class=gpr interval=[0, 2] crosses-call=no location=%rbx
  %v1 type=i32 class=gpr interval=[1, 2] crosses-call=no location=%r12
  %v2 type=i32 class=gpr interval=[2, 3] crosses-call=no location=%r13

define @f1 tests.function_call::main values=3 instructions=4 spills=0 used={%rbx, %r12, %r13} callee-saved={%rbx, %r12, %r13}
  %v0 type=i32 class=gpr interval=[0, 2] crosses-call=no location=%rbx
  %v1 type=i32 class=gpr interval=[1, 2] crosses-call=no location=%r12
  %v2 type=i32 class=gpr interval=[2, 3] crosses-call=no location=%r13
