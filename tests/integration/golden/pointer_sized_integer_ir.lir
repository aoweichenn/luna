ir luna.v0
target "x86_64-unknown-linux-gnu"

fn @widen($0: i32) -> isize {
bb0:
  %0 = load.i32 $0
  %1 = sext.i32.isize %0
  return %1
}

fn @reinterpret($0: isize) -> usize {
bb0:
  %0 = load.isize $0
  %1 = bitcast.isize.usize %0
  return %1
}

fn @truncate($0: usize) -> u16 {
bb0:
  %0 = load.usize $0
  %1 = trunc.usize.u16 %0
  return %1
}

fn @main() -> i32 {
bb0:
  %0 = const.i32 1
  %1 = neg.i32 %0
  %2 = call @widen(%1)
  store $0, %2
  %3 = load.isize $0
  %4 = call @reinterpret(%3)
  store $1, %4
  %5 = load.usize $1
  %6 = call @truncate(%5)
  %7 = zext.u16.i32 %6
  return %7
}
