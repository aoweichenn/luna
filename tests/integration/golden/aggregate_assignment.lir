ir luna.v0
target "x86_64-unknown-linux-gnu"

fn @main() -> i32 {
bb0:
  zero $0
  %0 = const.i32 1
  %1 = address $0
  %2 = member_address 0, %1
  store_indirect.i32 %2, %0
  zero $1
  %3 = const.i32 42
  %4 = address $1
  %5 = member_address 0, %4
  store_indirect.i32 %5, %3
  %6 = address $0
  %7 = address $1
  memory_copy 4, %6, %7
  %8 = address $0
  %9 = member_address 0, %8
  %10 = load_indirect.i32 %9
  return %10
}
