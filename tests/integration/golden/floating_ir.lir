ir luna.v0
target "x86_64-unknown-linux-gnu"

fn @combine($0: f32, $1: f32) -> f32 {
bb0:
  %0 = load.f32 $0
  %1 = neg.f32 %0
  store $2, %1
  %2 = load.f32 $2
  %3 = load.f32 $1
  %4 = add.f32 %2, %3
  %5 = const.f32 0x40000000
  %6 = mul.f32 %4, %5
  %7 = const.f32 0x40800000
  %8 = div.f32 %6, %7
  return %8
}

fn @less($0: f64, $1: f64) -> bool {
bb0:
  %0 = load.f64 $0
  %1 = load.f64 $1
  %2 = lt.f64 %0, %1
  return %2
}

fn @main() -> i32 {
bb0:
  %0 = const.f32 0x40000000
  %1 = const.f32 0x40c00000
  %2 = call @combine(%0, %1)
  %3 = const.f32 0x40000000
  %4 = eq %2, %3
  branch %4, bb1, bb2
bb1:
  %6 = const.f64 0x3ff8000000000000
  %7 = const.f64 0x4004000000000000
  %8 = call @less(%6, %7)
  store $0, %8
  jump bb3
bb2:
  %5 = const.bool false
  store $0, %5
  jump bb3
bb3:
  %9 = load.bool $0
  branch %9, bb4, bb5
bb4:
  %10 = const.i32 42
  return %10
bb5:
  jump bb6
bb6:
  %11 = const.i32 1
  return %11
}
