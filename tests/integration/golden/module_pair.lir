ir luna.v0
target "x86_64-unknown-linux-gnu"

extern fn @c_i32_identity(i32) -> i32

fn @combine($0: ptr, $1: i32) -> i32 {
bb0:
  %0 = load.ptr $0
  null_check %0
  %1 = member_address 0, %0
  %2 = load_indirect.i32 %1
  %3 = load.ptr $0
  null_check %3
  %4 = member_address 4, %3
  %5 = load_indirect.i32 %4
  %6 = add.i32 %2, %5
  %7 = load.i32 $1
  %8 = add.i32 %6, %7
  %9 = call @c_i32_identity(%8)
  return %9
}

fn @main() -> i32 {
bb0:
  zero $0
  %0 = const.i32 10
  %1 = address $0
  %2 = member_address 0, %1
  store_indirect.i32 %2, %0
  %3 = const.i32 20
  %4 = address $0
  %5 = member_address 4, %4
  store_indirect.i32 %5, %3
  %6 = address $0
