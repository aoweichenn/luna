target-machine x86_64
target-triple "x86_64-unknown-linux-gnu"
module-kind executable

define @f0 tests.function_call::add linkage=internal (i32:gpr, i32:gpr) -> i32 {
  stack $s0 type=i32 size=8 align=8 class=scalar
  stack $s1 type=i32 size=8 align=8 class=scalar
  vreg %v0 type=i32 class=gpr
  vreg %v1 type=i32 class=gpr
  vreg %v2 type=i32 class=gpr

  bb0 predecessors=0:
    %v0 = load.slot type=i32 slot=$s0
    %v1 = load.slot type=i32 slot=$s1
    %v2 = add.integer type=i32 uses=[%v0, %v1]
    return type=void uses=[%v2]
}

define @f1 tests.function_call::main linkage=internal () -> i32 {
  vreg %v0 type=i32 class=gpr
  vreg %v1 type=i32 class=gpr
  vreg %v2 type=i32 class=gpr

  bb0 predecessors=0:
    %v0 = const.integer type=i32 imm=0x0000000000000014
    %v1 = const.integer type=i32 imm=0x0000000000000016
    %v2 = call type=i32 uses=[%v0, %v1] callee=@f0
    return type=void uses=[%v2]
}
