module test.unsigned_operations;

fn calculate32(value: u32) -> u32 {
    return (value / 3) + (value % 5) + (value >> 31);
}

fn calculate64(value: u64) -> u64 {
    return (value / 7) + (value % 11) + (value >> 63);
}

fn main() -> i32 {
    let narrow: u32 = calculate32(4294967295);
    let wide: u64 = calculate64(18446744073709551615);
    let wrapped: u32 = 4294967295 + 1;
    let negated: u32 = -1;

    if (narrow == 1431655766 &&
        wide == 2635249153387078807 &&
        wrapped == 0 &&
        negated == 4294967295 &&
        (4294967295 as u32) > 1 &&
        (18446744073709551615 as u64) >= 4294967295) {
        return 42;
    }
    return 1;
}
