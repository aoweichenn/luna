module test.memory_operations;

fn bump(value: *i32) -> i32 {
    *value += 5;
    return *value;
}

fn select(flag: bool, left: *i32, right: *i32) -> *i32 {
    return flag ? left : right;
}

fn read_byte(text: *const u8, index: usize) -> u8 {
    return text[index];
}

fn main() -> i32 {
    var values: [4]i32 = {};
    values[0] = 10;
    values[1] = 20;
    values[2] = 30;
    values[3] = 40;

    if (bump(&values[1]) != 25) {
        return 1;
    }

    let selected: *i32 = select(false, &values[0], &values[2]);
    *selected = 31;
    let base: *i32 = &values[0];
    base[3] += 2;
    if (values[2] != 31 || values[3] != 42) {
        return 2;
    }

    var matrix: [2][3]i16 = {};
    matrix[1][2] = -1234;
    let element: *i16 = &matrix[1][2];
    let read_only: *const i16 = element as *const i16;
    if (*read_only != -1234) {
        return 3;
    }

    let address: usize = element as usize;
    let round_trip: *i16 = address as *i16;
    let chosen: *i16 = false ? null : round_trip;
    if (chosen != round_trip || chosen == null) {
        return 4;
    }

    var flags: [2]bool = {};
    flags[1] = true;
    var singles: [2]f32 = {};
    singles[1] = 1.5;
    var doubles: [2]f64 = {};
    doubles[1] = 2.25;
    if (!flags[1] || singles[1] != 1.5 || doubles[1] != 2.25) {
        return 5;
    }

    let text: *const u8 = "A\n\x42\0";
    if (read_byte(text, 0) != 65 || read_byte(text, 1) != 10 ||
        read_byte(text, 2) != 66 || read_byte(text, 3) != 0 ||
        read_byte(text, 4) != 0) {
        return 6;
    }

    let escapes: *const u8 = "\\\"\r\t";
    let empty: *const u8 = "";
    if (read_byte(escapes, 0) != 92 || read_byte(escapes, 1) != 34 ||
        read_byte(escapes, 2) != 13 || read_byte(escapes, 3) != 9 ||
        read_byte(escapes, 4) != 0 || read_byte(empty, 0) != 0) {
        return 7;
    }

    return 42;
}
