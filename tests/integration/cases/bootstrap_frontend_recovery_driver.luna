module tests.bootstrap_frontend_recovery_driver;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.std.path;
import luna.std.io;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;

fn main() -> i32 {
    let path: StdPathResult =
        std_path_from_c_string("bootstrap-input.luna", 21);
    if (path.error != RuntimeError.none) {
        return 1;
    }

    let source: StdByteBufferResult = std_io_read_file(path.path);
    let path_error: RuntimeError = std_path_release(path.path);
    if (source.error != RuntimeError.none ||
        path_error != RuntimeError.none) {
        return 2;
    }

    let view: StdTextViewResult = std_text_view(
        source.buffer.data as *const u8,
        source.buffer.length
    );
    if (view.error != RuntimeError.none) {
        std_byte_buffer_release(source.buffer);
        return 3;
    }

    let result: BootstrapFrontendResult =
        bootstrap_frontend_parse(view.view);
    var status: i32 = 42;
    if (result.error != RuntimeError.none) {
        status = 10 + result.error as isize as i32;
    } else if (result.lex.diagnostics.count == 0 &&
        result.parse.diagnostics.count == 0) {
        status = 5;
    } else if (!bootstrap_syntax_tree_is_valid(result.parse.tree)) {
        status = 6;
    }
    let frontend_error: RuntimeError =
        bootstrap_frontend_result_release(result);
    let source_error: RuntimeError =
        std_byte_buffer_release(source.buffer);
    if (frontend_error != RuntimeError.none ||
        source_error != RuntimeError.none) {
        return 4;
    }
    return status;
}
