module tests.module_pair;

fn combine(data: *const Input, amount: i32) -> i32 {
    return c_i32_identity(data->value + (data->bias as i32) + amount);
}

fn main() -> i32 {
    var input: Input = {
        value = 10,
        bias = Bias.answer,
    };
    return combine((&input) as *const Input, 12);
}
