module tests.structured_control_flow_ir;

fn choose(condition: bool) -> i32 {
    return condition ? 1 : 2;
}

fn classify(value: i32) -> i32 {
    switch (value) {
        case 0, 1 {
            return 3;
        }

        default {
            return 4;
        }
    }
}

fn count() -> i32 {
    var value: i32 = 0;
    do {
        value += 1;
    } while (false);

    for (; value < 2; value += 1) {
    }
    return value;
}

fn main() -> i32 {
    return 0;
}
