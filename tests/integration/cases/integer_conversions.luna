module tests.integer_conversions;

fn widen(value: i32) -> i64 {
    return value as i64;
}

fn narrow(value: i64) -> i32 {
    return value as i32;
}

fn round_trip(value: i64) -> i64 {
    return (value as i32) as i64;
}

fn main() -> i32 {
    if (widen(-2147483648) == -2147483648
        && widen(2147483647) == 2147483647
        && narrow(4294967295) == -1
        && narrow(4294967296) == 0
        && round_trip(4294967295) == -1
        && (1 as i64) + 4294967296 == 4294967297) {
        return 42;
    }
    return 1;
}
