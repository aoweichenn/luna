module integration.bootstrap_toolchain_unit_driver;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.bootstrap.backend.x86_64.object;
import luna.bootstrap.backend.x86_64.assembler;
import luna.bootstrap.backend.x86_64.linker;

fn bootstrap_toolchain_view(
    text: *const u8,
    maximum_length: usize
) -> StdTextViewResult {
    return std_text_from_c_string(text, maximum_length);
}

fn bootstrap_toolchain_release_assembler(
    result: BootstrapAssemblerResult
) -> RuntimeError {
    if (result.error != RuntimeError.none) {
        return RuntimeError.none;
    }
    return bootstrap_object_release(result.object);
}

fn main() -> i32 {
    let root_text: StdTextViewResult = bootstrap_toolchain_view(
        "    .text\n    .globl _start\n    .type _start, @function\n_start:\n    call helper\n    movl $42, %edi\n    movl $60, %eax\n    syscall\n    .size _start, .-_start\n    .extern helper\n",
        512
    );
    let library_text: StdTextViewResult = bootstrap_toolchain_view(
        "    .text\n    .globl helper\n    .type helper, @function\nhelper:\n    ret\n    .size helper, .-helper\n",
        256
    );
    let invalid_text: StdTextViewResult = bootstrap_toolchain_view(
        "    .text\n    impossible %rax\n",
        64
    );
    if (root_text.error != RuntimeError.none ||
        library_text.error != RuntimeError.none ||
        invalid_text.error != RuntimeError.none) {
        return 1;
    }

    let root: BootstrapAssemblerResult =
        bootstrap_x86_64_assemble(root_text.view);
    let library: BootstrapAssemblerResult =
        bootstrap_x86_64_assemble(library_text.view);
    let invalid: BootstrapAssemblerResult =
        bootstrap_x86_64_assemble(invalid_text.view);
    if (root.error != RuntimeError.none ||
        library.error != RuntimeError.none ||
        invalid.error == RuntimeError.none) {
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        bootstrap_toolchain_release_assembler(invalid);
        return 2;
    }

    let serialized: StdByteBufferResult =
        bootstrap_object_serialize(root.object);
    if (serialized.error != RuntimeError.none ||
        serialized.buffer.length < 112) {
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 3;
    }
    let parsed: BootstrapObjectResult =
        bootstrap_object_deserialize(
            serialized.buffer.data as *const u8,
            serialized.buffer.length
        );
    if (parsed.error != RuntimeError.none) {
        std_byte_buffer_release(serialized.buffer);
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 4;
    }
    let serialized_again: StdByteBufferResult =
        bootstrap_object_serialize(parsed.object);
    if (serialized_again.error != RuntimeError.none ||
        !std_byte_buffer_equal(
            serialized_again.buffer,
            serialized.buffer.data as *const u8,
            serialized.buffer.length
        )) {
        if (serialized_again.error == RuntimeError.none) {
            std_byte_buffer_release(serialized_again.buffer);
        }
        bootstrap_object_release(parsed.object);
        std_byte_buffer_release(serialized.buffer);
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 5;
    }
    std_byte_buffer_release(serialized_again.buffer);
    bootstrap_object_release(parsed.object);

    let saved_magic: u8 = serialized.buffer.data[0];
    serialized.buffer.data[0] = 0;
    let malformed: BootstrapObjectResult =
        bootstrap_object_deserialize(
            serialized.buffer.data as *const u8,
            serialized.buffer.length
        );
    serialized.buffer.data[0] = saved_magic;
    if (malformed.error == RuntimeError.none) {
        bootstrap_object_release(malformed.object);
        std_byte_buffer_release(serialized.buffer);
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 6;
    }
    std_byte_buffer_release(serialized.buffer);

    var objects: [2]BootstrapObject = {};
    objects[0] = root.object;
    objects[1] = library.object;
    let linked: BootstrapLinkerResult = bootstrap_x86_64_link(
        &objects[0] as *const BootstrapObject,
        2
    );
    if (linked.error != RuntimeError.none ||
        linked.executable.length <= 4096 ||
        linked.executable.data[0] != 127 ||
        linked.executable.data[1] != 69 ||
        linked.executable.data[2] != 76 ||
        linked.executable.data[3] != 70) {
        if (linked.error == RuntimeError.none) {
            std_byte_buffer_release(linked.executable);
        }
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 7;
    }
    std_byte_buffer_release(linked.executable);

    let unresolved: BootstrapLinkerResult = bootstrap_x86_64_link(
        &objects[0] as *const BootstrapObject,
        1
    );
    if (unresolved.error != RuntimeError.not_found) {
        if (unresolved.error == RuntimeError.none) {
            std_byte_buffer_release(unresolved.executable);
        }
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 8;
    }

    var duplicates: [3]BootstrapObject = {};
    duplicates[0] = root.object;
    duplicates[1] = library.object;
    duplicates[2] = library.object;
    let duplicate: BootstrapLinkerResult = bootstrap_x86_64_link(
        &duplicates[0] as *const BootstrapObject,
        3
    );
    if (duplicate.error != RuntimeError.exists) {
        if (duplicate.error == RuntimeError.none) {
            std_byte_buffer_release(duplicate.executable);
        }
        bootstrap_toolchain_release_assembler(root);
        bootstrap_toolchain_release_assembler(library);
        return 9;
    }

    let root_error: RuntimeError =
        bootstrap_toolchain_release_assembler(root);
    let library_error: RuntimeError =
        bootstrap_toolchain_release_assembler(library);
    if (root_error != RuntimeError.none ||
        library_error != RuntimeError.none) {
        return 10;
    }
    return 42;
}
