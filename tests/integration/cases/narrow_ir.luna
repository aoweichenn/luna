module test.narrow_ir;

fn minimum_i8() -> i8 {
    return -128;
}

fn minimum_i16() -> i16 {
    return -32768;
}

fn maximum_u8() -> u8 {
    return 255;
}

fn maximum_u16() -> u16 {
    return 65535;
}

fn sign_extend(value: i8) -> i64 {
    return value as i64;
}

fn zero_extend(value: u8) -> u64 {
    return value as u64;
}

fn truncate(value: u64) -> u16 {
    return value as u16;
}

fn preserve_bits(value: i16) -> u16 {
    return value as u16;
}

fn main() -> i32 {
    return 0;
}
