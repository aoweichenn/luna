module test.fixed_width_arguments;

fn check(a: i8, b: u8, c: i16, d: u16, e: i32, f: u64) -> bool {
    return a == -128 &&
           b == 255 &&
           c == -32768 &&
           d == 65535 &&
           e == -2147483648 &&
           f == 18446744073709551615;
}

fn main() -> i32 {
    if (check(-128, 255, -32768, 65535, -2147483648,
              18446744073709551615)) {
        return 42;
    }
    return 1;
}
