module tests.floating_operations;

fn adjust_single(value: f32, delta: f32) -> f32 {
    var result: f32 = value;
    result += delta;
    result *= 2.0;
    result -= 1.0;
    result /= 2.0;
    return -(-result);
}

fn adjust_double(value: f64, delta: f64) -> f64 {
    var result: f64 = value;
    result -= delta;
    result /= 2.0;
    result += 0.5;
    result *= 2.0;
    return result;
}

fn check_mixed(
    i0: i8,
    f0: f32,
    i1: i16,
    f1: f64,
    i2: i32,
    f2: f32,
    i3: i64,
    f3: f64,
    i4: isize,
    f4: f32,
    i5: usize,
    f5: f64,
    f6: f32,
    f7: f64
) -> bool {
    return i0 == 1 &&
           f0 == 1.25 &&
           i1 == 2 &&
           f1 == 2.5 &&
           i2 == 3 &&
           f2 == 3.75 &&
           i3 == 4 &&
           f3 == 4.5 &&
           i4 == 5 &&
           f4 == 5.25 &&
           i5 == 6 &&
           f5 == 6.5 &&
           f6 == 7.75 &&
           f7 == 8.5;
}

fn main() -> i32 {
    let single: f32 = adjust_single(1.5, 2.25);
    let double: f64 = adjust_double(10.0, 6.0);
    let positive_infinity: f64 = 1.0 / 0.0;
    let negative_infinity: f64 = -1.0 / 0.0;
    let not_a_number: f64 = 0.0 / 0.0;
    let negative_zero: f64 = -0.0;
    let negative_zero_reciprocal: f64 = 1.0 / negative_zero;

    if (single == 3.25 &&
        double == 5.0 &&
        positive_infinity > 1.0 &&
        negative_infinity < -1.0 &&
        negative_zero == 0.0 &&
        negative_zero_reciprocal == negative_infinity &&
        not_a_number != not_a_number &&
        !(not_a_number == not_a_number) &&
        !(not_a_number < 0.0) &&
        !(not_a_number <= 0.0) &&
        !(not_a_number > 0.0) &&
        !(not_a_number >= 0.0) &&
        check_mixed(
            1,
            1.25,
            2,
            2.5,
            3,
            3.75,
            4,
            4.5,
            5,
            5.25,
            6,
            6.5,
            7.75,
            8.5
        )) {
        return 42;
    }
    return 1;
}
