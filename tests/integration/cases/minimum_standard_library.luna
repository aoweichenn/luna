module tests.minimum_standard_library;

import luna.runtime;
import luna.std.memory;
import luna.std.bytes;
import luna.std.text;
import luna.std.path;
import luna.std.io;

fn test_memory() -> i32 {
    let allocated: StdAllocationResult = std_memory_allocate(8);
    if (allocated.error != RuntimeError.none ||
        allocated.allocation.address == null ||
        allocated.allocation.length != 8) {
        return 1;
    }
    if (std_memory_fill(allocated.allocation.address, 0, 8) !=
        RuntimeError.none) {
        return 2;
    }
    var index: usize = 0;
    while (index < 6) {
        allocated.allocation.address[index] = index as u8;
        index += 1;
    }
    if (std_memory_move(
            &allocated.allocation.address[2],
            allocated.allocation.address as *const u8,
            6
        ) != RuntimeError.none) {
        return 3;
    }
    if (allocated.allocation.address[0] != 0 ||
        allocated.allocation.address[1] != 1 ||
        allocated.allocation.address[2] != 0 ||
        allocated.allocation.address[3] != 1 ||
        allocated.allocation.address[4] != 2 ||
        allocated.allocation.address[5] != 3 ||
        allocated.allocation.address[6] != 4 ||
        allocated.allocation.address[7] != 5) {
        return 4;
    }

    let resized: StdAllocationResult =
        std_memory_resize(allocated.allocation, 16);
    if (resized.error != RuntimeError.none ||
        resized.allocation.length != 16 ||
        resized.allocation.address[6] != 4) {
        return 5;
    }
    if (std_memory_release(resized.allocation) != RuntimeError.none) {
        return 6;
    }
    if (std_memory_release({ address = null, length = 0, }) !=
        RuntimeError.none) {
        return 7;
    }
    if (std_memory_release({ address = null, length = 1, }) !=
        RuntimeError.invalid_argument) {
        return 8;
    }
    return 0;
}

fn test_bytes() -> i32 {
    let created: StdByteBufferResult =
        std_byte_buffer_from("abc", 3);
    if (created.error != RuntimeError.none) {
        return 10;
    }
    let self_appended: StdByteBufferResult = std_byte_buffer_append(
        created.buffer,
        created.buffer.data as *const u8,
        created.buffer.length
    );
    if (self_appended.error != RuntimeError.none ||
        !std_byte_buffer_equal(self_appended.buffer, "abcabc", 6)) {
        return 11;
    }
    let pushed: StdByteBufferResult =
        std_byte_buffer_push(self_appended.buffer, 33);
    if (pushed.error != RuntimeError.none ||
        !std_byte_buffer_equal(pushed.buffer, "abcabc!", 7)) {
        return 12;
    }
    let truncated: StdByteBufferResult =
        std_byte_buffer_truncate(pushed.buffer, 4);
    if (truncated.error != RuntimeError.none ||
        !std_byte_buffer_equal(truncated.buffer, "abca", 4)) {
        return 13;
    }
    let spare_alias: StdByteBufferResult = std_byte_buffer_append(
        truncated.buffer,
        &truncated.buffer.data[10] as *const u8,
        1
    );
    if (spare_alias.error != RuntimeError.invalid_argument) {
        return 14;
    }
    let cleared: StdByteBufferResult =
        std_byte_buffer_clear(spare_alias.buffer);
    if (cleared.error != RuntimeError.none ||
        cleared.buffer.length != 0 ||
        cleared.buffer.capacity == 0) {
        return 15;
    }
    if (std_byte_buffer_release(cleared.buffer) != RuntimeError.none) {
        return 16;
    }
    return 0;
}

fn test_text() -> i32 {
    let unicode: StdTextViewResult = std_text_view(
        "\xC2\xA2\xE2\x82\xAC\xF0\x90\x8D\x88",
        9
    );
    if (unicode.error != RuntimeError.none ||
        !std_text_is_valid_utf8(unicode.view)) {
        return 20;
    }
    let invalid: StdTextViewResult =
        std_text_view("\xED\xA0\x80", 3);
    if (invalid.error != RuntimeError.invalid_argument) {
        return 21;
    }
    if (std_text_view("\xC0\xAF", 2).error !=
            RuntimeError.invalid_argument ||
        std_text_view("\x80", 1).error !=
            RuntimeError.invalid_argument ||
        std_text_view("\xF4\x90\x80\x80", 4).error !=
            RuntimeError.invalid_argument ||
        std_text_view("\xE2\x82", 2).error !=
            RuntimeError.invalid_argument ||
        std_text_slice(unicode.view, 1, 1).error !=
            RuntimeError.invalid_argument ||
        std_text_from_c_string("hello", 5).error !=
            RuntimeError.name_too_long) {
        return 22;
    }

    let hello: StdTextViewResult =
        std_text_from_c_string("hello", 6);
    let suffix: StdTextViewResult =
        std_text_from_c_string(" world", 7);
    if (hello.error != RuntimeError.none ||
        suffix.error != RuntimeError.none) {
        return 23;
    }
    let copied: StdOwnedTextResult = std_text_copy(hello.view);
    let appended: StdOwnedTextResult =
        std_owned_text_append(copied.text, suffix.view);
    if (appended.error != RuntimeError.none) {
        return 24;
    }
    let complete: StdTextViewResult =
        std_owned_text_view(appended.text);
    let expected: StdTextViewResult =
        std_text_from_c_string("hello world", 12);
    if (complete.error != RuntimeError.none ||
        expected.error != RuntimeError.none ||
        !std_text_equal(complete.view, expected.view)) {
        return 25;
    }
    let slice: StdTextViewResult =
        std_text_slice(complete.view, 6, 5);
    let world: StdTextViewResult =
        std_text_from_c_string("world", 6);
    if (slice.error != RuntimeError.none ||
        world.error != RuntimeError.none ||
        !std_text_equal(slice.view, world.view)) {
        return 26;
    }
    if (std_owned_text_release(appended.text) != RuntimeError.none) {
        return 27;
    }
    return 0;
}

fn test_path_and_io() -> i32 {
    let path: StdPathResult =
        std_path_from_c_string("stdlib-created.bin", 19);
    if (path.error != RuntimeError.none ||
        !std_path_is_valid(path.path) ||
        std_path_as_c_string(path.path) == null) {
        return 30;
    }

    let nul_text: StdTextViewResult =
        std_text_view("a\0b", 3);
    let rejected: StdPathResult =
        std_path_from_text(nul_text.view);
    if (nul_text.error != RuntimeError.none ||
        rejected.error != RuntimeError.invalid_argument) {
        return 31;
    }

    if (std_io_write_file(path.path, "stdlib file\n", 12) !=
        RuntimeError.none) {
        return 32;
    }
    let read: StdByteBufferResult = std_io_read_file(path.path);
    if (read.error != RuntimeError.none ||
        !std_byte_buffer_equal(read.buffer, "stdlib file\n", 12)) {
        return 33;
    }
    if (std_byte_buffer_release(read.buffer) != RuntimeError.none) {
        return 34;
    }

    let invalid_path: StdPathResult =
        std_path_from_c_string("stdlib-invalid.bin", 19);
    if (invalid_path.error != RuntimeError.none ||
        std_io_write_file(invalid_path.path, null, 1) !=
            RuntimeError.bad_address ||
        std_path_release(invalid_path.path) != RuntimeError.none) {
        return 35;
    }

    let output: StdTextViewResult =
        std_text_from_c_string("luna stdlib\n", 13);
    if (output.error != RuntimeError.none ||
        std_io_print(output.view) != RuntimeError.none) {
        return 36;
    }
    if (std_path_release(path.path) != RuntimeError.none) {
        return 37;
    }
    return 0;
}

fn main() -> i32 {
    let memory_status: i32 = test_memory();
    if (memory_status != 0) {
        return memory_status;
    }
    let bytes_status: i32 = test_bytes();
    if (bytes_status != 0) {
        return bytes_status;
    }
    let text_status: i32 = test_text();
    if (text_status != 0) {
        return text_status;
    }
    let io_status: i32 = test_path_and_io();
    if (io_status != 0) {
        return io_status;
    }
    return 42;
}
