module tests.aggregate_c_abi;

enum StateKind: u8 {
    empty,
    ready = 7,
}

struct Payload {
    small: u8;
    wide: u64;
}

union NumberBits {
    whole: u64;
    low: u8;
}

struct State {
    kind: StateKind;
    payload: Payload;
    bits: NumberBits;
    values: [2]u16;
    next: *State;
}

extern fn c_validate_aggregate_layout(state: *const State) -> bool;

fn main() -> i32 {
    var state: State = {};
    state.kind = StateKind.ready;
    state.payload.small = 3;
    state.payload.wide = 34;
    state.bits.whole = 42;
    state.values[1] = 8;
    state.next = &state;

    let read_only: *const State = (&state) as *const State;
    if (!c_validate_aggregate_layout(read_only)) {
        return 1;
    }
    return 42;
}
