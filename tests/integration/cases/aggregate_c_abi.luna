module tests.aggregate_c_abi;

enum StateKind: u8 {
    empty,
    ready = 7,
}

struct Payload {
    small: u8;
    wide: u64;
}

union NumberBits {
    whole: u64;
    low: u8;
}

struct State {
    kind: StateKind;
    payload: Payload;
    bits: NumberBits;
    values: [2]u16;
    next: *State;
}

extern fn c_validate_aggregate_layout(state: *const State) -> bool;

fn main() -> i32 {
    var values: [2]u16 = {};
    values[1] = 8;
    var original: State = {
        kind = StateKind.ready,
        payload = { small = 3, wide = 34, },
        bits = { whole = 42, },
        values = values,
    };
    var state: State = original;
    state.next = &state;

    let read_only: *const State = (&state) as *const State;
    if (!c_validate_aggregate_layout(read_only)) {
        return 1;
    }
    return 42;
}
