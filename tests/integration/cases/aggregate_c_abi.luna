module tests.aggregate_c_abi;

enum StateKind: u8 {
    empty,
    ready = 7,
}

struct Payload {
    small: u8;
    wide: u64;
}

struct Pair {
    left: i32;
    right: i32;
}

struct Mixed {
    weight: f64;
    tag: i32;
}

struct FloatPair {
    first: f64;
    second: f64;
}

struct TaggedWeight {
    tag: i32;
    weight: f64;
}

struct Triple {
    first: i32;
    second: i32;
    third: i32;
}

struct Big {
    first: i64;
    second: i64;
    third: i64;
}

union NumberBits {
    whole: u64;
    low: u8;
}

struct State {
    kind: StateKind;
    payload: Payload;
    bits: NumberBits;
    values: [2]u16;
    next: *State;
}

extern fn c_validate_aggregate_layout(state: *const State) -> bool;
extern fn c_sum_pair(value: Pair) -> i32;
extern fn c_make_pair(left: i32, right: i32) -> Pair;
extern fn c_adjust_mixed(value: Mixed) -> Mixed;
extern fn c_echo_float_pair(value: FloatPair) -> FloatPair;
extern fn c_echo_tagged_weight(value: TaggedWeight) -> TaggedWeight;
extern fn c_echo_triple(value: Triple) -> Triple;
extern fn c_echo_number_bits(value: NumberBits) -> NumberBits;
extern fn c_echo_big(value: Big) -> Big;
extern fn c_make_big(first: i64, second: i64, third: i64) -> Big;
extern fn c_rollback_pair(first: i32, second: i32, third: i32,
                          fourth: i32, fifth: i32, sixth: i32,
                          value: Pair) -> i32;

fn main() -> i32 {
    var values: [2]u16 = {};
    values[1] = 8;
    var original: State = {
        kind = StateKind.ready,
        payload = { small = 3, wide = 34, },
        bits = { whole = 42, },
        values = values,
    };
    var state: State = original;
    state.next = &state;

    let read_only: *const State = (&state) as *const State;
    if (!c_validate_aggregate_layout(read_only)) {
        return 1;
    }

    let pair: Pair = c_make_pair(20, 22);
    if (c_sum_pair(pair) != 42) {
        return 2;
    }

    var mixed: Mixed = {
        weight = 0.5,
        tag = 40,
    };
    let adjusted: Mixed = c_adjust_mixed(mixed);
    if (adjusted.weight != 2.0 || adjusted.tag != 42) {
        return 3;
    }

    let float_pair: FloatPair = c_echo_float_pair({
        first = 1.25,
        second = 40.75,
    });
    if (float_pair.first != 1.25 || float_pair.second != 40.75) {
        return 4;
    }

    let tagged_weight: TaggedWeight = c_echo_tagged_weight({
        tag = 40,
        weight = 2.0,
    });
    if (tagged_weight.tag != 40 || tagged_weight.weight != 2.0) {
        return 5;
    }

    let triple: Triple = c_echo_triple({
        first = 10,
        second = 11,
        third = 21,
    });
    if (triple.first != 10 || triple.second != 11 || triple.third != 21) {
        return 6;
    }

    let number_bits: NumberBits = c_echo_number_bits({ whole = 42, });
    if (number_bits.whole != 42 || number_bits.low != 42) {
        return 7;
    }

    var big: Big = {
        first = 10,
        second = 11,
        third = 21,
    };
    let returned_big: Big = c_echo_big(big);
    if (returned_big.first != 10 || returned_big.second != 11 ||
        returned_big.third != 21) {
        return 8;
    }

    let made_big: Big = c_make_big(10, 11, 21);
    if (made_big.first != 10 || made_big.second != 11 ||
        made_big.third != 21) {
        return 9;
    }

    if (c_rollback_pair(1, 2, 3, 4, 5, 6,
                        { left = 10, right = 11, }) != 42) {
        return 10;
    }
    return 42;
}
