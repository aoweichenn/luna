module tests.floating_ir;

fn combine(left: f32, right: f32) -> f32 {
    let negative: f32 = -left;
    return (negative + right) * 2.0 / 4.0;
}

fn less(left: f64, right: f64) -> bool {
    return left < right;
}

fn main() -> i32 {
    if (combine(2.0, 6.0) == 2.0 && less(1.5, 2.5)) {
        return 42;
    }
    return 1;
}
