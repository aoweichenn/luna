module test.memory_scalar_matrix;

fn main() -> i32 {
    var booleans: [1]bool = {};
    var signed8: [1]i8 = {};
    var signed16: [1]i16 = {};
    var signed32: [1]i32 = {};
    var signed64: [1]i64 = {};
    var signed_size: [1]isize = {};
    var unsigned8: [1]u8 = {};
    var unsigned16: [1]u16 = {};
    var unsigned32: [1]u32 = {};
    var unsigned64: [1]u64 = {};
    var unsigned_size: [1]usize = {};
    var singles: [1]f32 = {};
    var doubles: [1]f64 = {};

    booleans[0] = true;
    signed8[0] = -8;
    signed16[0] = -1600;
    signed32[0] = -320000;
    signed64[0] = -6400000000;
    signed_size[0] = -123456;
    unsigned8[0] = 208;
    unsigned16[0] = 60000;
    unsigned32[0] = 4000000000;
    unsigned64[0] = 16000000000000000000;
    unsigned_size[0] = 123456;
    singles[0] = 1.25;
    doubles[0] = 2.5;

    if (
        !*&booleans[0] ||
        *&signed8[0] != -8 ||
        *&signed16[0] != -1600 ||
        *&signed32[0] != -320000 ||
        *&signed64[0] != -6400000000 ||
        *&signed_size[0] != -123456 ||
        *&unsigned8[0] != 208 ||
        *&unsigned16[0] != 60000 ||
        *&unsigned32[0] != 4000000000 ||
        *&unsigned64[0] != 16000000000000000000 ||
        *&unsigned_size[0] != 123456 ||
        *&singles[0] != 1.25 ||
        *&doubles[0] != 2.5
    ) {
        return 1;
    }

    var value: i32 = 42;
    var pointers: [2]*i32 = {};
    if (pointers[0] != null) {
        return 2;
    }
    pointers[1] = &value;
    let pointer_slot: **i32 = &pointers[1];
    if (**pointer_slot != 42) {
        return 3;
    }

    var raw_boolean: [1]u8 = {};
    raw_boolean[0] = 2;
    let reinterpreted_boolean: *bool = (&raw_boolean[0]) as *bool;
    if (!*reinterpreted_boolean || *reinterpreted_boolean != true) {
        return 4;
    }

    var aliased_boolean: bool = false;
    let boolean_bytes: *u8 = (&aliased_boolean) as *u8;
    *boolean_bytes = 255;
    if (!aliased_boolean || aliased_boolean != true) {
        return 5;
    }

    return 42;
}
