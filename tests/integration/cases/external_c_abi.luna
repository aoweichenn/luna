module test.external_c_abi;

extern fn c_bool_flip(value: bool) -> bool;
extern fn c_i8_identity(value: i8) -> i8;
extern fn c_i16_identity(value: i16) -> i16;
extern fn c_i32_identity(value: i32) -> i32;
extern fn c_i64_identity(value: i64) -> i64;
extern fn c_isize_identity(value: isize) -> isize;
extern fn c_u8_identity(value: u8) -> u8;
extern fn c_u16_identity(value: u16) -> u16;
extern fn c_u32_identity(value: u32) -> u32;
extern fn c_u64_identity(value: u64) -> u64;
extern fn c_usize_identity(value: usize) -> usize;
extern fn c_f32_identity(value: f32) -> f32;
extern fn c_f64_identity(value: f64) -> f64;
extern fn c_promote_i8(value: i8) -> i64;
extern fn c_promote_i16(value: i16) -> i64;
extern fn c_pointer_identity(value: *i32) -> *i32;
extern fn c_void_pointer_identity(value: *void) -> *void;
extern fn c_store_i32(pointer: *i32, value: i32);
extern fn c_mixed_register_banks(first: i8, second: u16, third: i32,
                                 fourth: u64, fifth: *void, sixth: isize,
                                 seventh: f32, eighth: f64) -> bool;

fn main() -> i32 {
    if (c_bool_flip(false) != true) { return 1; }
    if (c_i8_identity(-101) != -101) { return 2; }
    if (c_i16_identity(-30001) != -30001) { return 3; }
    if (c_i32_identity(-2000000000) != -2000000000) { return 4; }
    if (c_i64_identity(-9000000000000000000) != -9000000000000000000) {
        return 5;
    }
    if (c_isize_identity(-5000000000) != -5000000000) { return 6; }
    if (c_u8_identity(251) != 251) { return 7; }
    if (c_u16_identity(60001) != 60001) { return 8; }
    if (c_u32_identity(4000000000) != 4000000000) { return 9; }
    if (c_u64_identity(18000000000000000000) != 18000000000000000000) {
        return 10;
    }
    if (c_usize_identity(9000000000) != 9000000000) { return 11; }
    if (c_f32_identity(1.25) != 1.25) { return 12; }
    if (c_f64_identity(-2.5) != -2.5) { return 13; }
    if (c_promote_i8(-101) != -101) { return 14; }
    if (c_promote_i16(-30001) != -30001) { return 15; }

    var stored: i32 = 0;
    let pointer: *i32 = &stored;
    c_store_i32(pointer, 42);
    if (stored != 42) { return 16; }
    if (c_pointer_identity(pointer) != pointer) { return 17; }

    let opaque: *void = pointer as *void;
    if (c_void_pointer_identity(opaque) != opaque) { return 18; }
    if (!c_mixed_register_banks(-7, 60000, -1234567,
                                18000000000000000000, opaque, -4096,
                                1.25, -2.5)) {
        return 19;
    }
    return 42;
}
