module test.linux_syscall_abi;

import luna.linux.syscall;

fn main() -> i32 {
    let process_id: isize = luna_linux_syscall0(39);
    if (process_id <= 0) {
        return 1;
    }

    let invalid_descriptor: usize = 18446744073709551615;
    if (luna_linux_syscall1(3, invalid_descriptor) != -9) {
        return 2;
    }
    if (luna_linux_syscall2(62, process_id as usize, 0) != 0) {
        return 3;
    }

    let message: *const u8 = "luna syscall abi\n";
    if (luna_linux_syscall3(1, 1, message as usize, 17) != 17) {
        return 4;
    }

    if (luna_linux_syscall4(14, 0, 0, 0, 0) != -22) {
        return 5;
    }
    if (luna_linux_syscall4(14, 0, 0, 0, 8) != 0) {
        return 6;
    }

    let anonymous_mapping: isize = luna_linux_syscall6(
        9,
        0,
        4096,
        3,
        34,
        invalid_descriptor,
        0
    );
    if (anonymous_mapping < 0) {
        return 7;
    }
    let bytes: *u8 = anonymous_mapping as usize as *u8;
    bytes[0] = 42;
    bytes[4095] = 24;
    if (bytes[0] != 42 || bytes[4095] != 24) {
        return 8;
    }

    let root_path: *const u8 = "/";
    let current_directory: usize = 18446744073709551516;
    if (
        luna_linux_syscall5(
            332,
            current_directory,
            root_path as usize,
            0,
            4095,
            anonymous_mapping as usize
        ) != 0
    ) {
        return 9;
    }

    let zero_path: *const u8 = "/dev/zero";
    let zero_descriptor: isize = luna_linux_syscall4(
        257,
        current_directory,
        zero_path as usize,
        0,
        0
    );
    if (zero_descriptor < 0) {
        return 10;
    }
    if (
        luna_linux_syscall6(
            9,
            0,
            4096,
            1,
            2,
            zero_descriptor as usize,
            1
        ) != -22
    ) {
        return 11;
    }
    let file_mapping: isize = luna_linux_syscall6(
        9,
        0,
        4096,
        1,
        2,
        zero_descriptor as usize,
        0
    );
    if (file_mapping < 0) {
        return 12;
    }
    if (luna_linux_syscall2(11, file_mapping as usize, 4096) != 0) {
        return 13;
    }
    if (luna_linux_syscall1(3, zero_descriptor as usize) != 0) {
        return 14;
    }
    if (luna_linux_syscall2(11, anonymous_mapping as usize, 4096) != 0) {
        return 15;
    }

    if (luna_linux_syscall0(invalid_descriptor) != -38) {
        return 16;
    }
    return 42;
}
