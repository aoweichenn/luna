module tests.bootstrap_x86_64_text_resource;

import luna.runtime;
import luna.std.bytes;
import luna.bootstrap.backend.x86_64.text;

fn main() -> i32 {
    let allocated: StdByteBufferResult =
        std_byte_buffer_with_capacity(8388608);
    if (allocated.error != RuntimeError.none ||
        allocated.buffer.capacity < 8388608) {
        std_byte_buffer_release(allocated.buffer);
        return 1;
    }
    var source: StdByteBuffer = allocated.buffer;
    source.length = 8388608;

    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append(
            &text,
            source.data as *const u8,
            source.length
        ) ||
        text.buffer.length != 8388608 ||
        !bootstrap_x86_64_text_is_valid(text)) {
        bootstrap_x86_64_text_release(text);
        std_byte_buffer_release(source);
        return 2;
    }
    if (bootstrap_x86_64_text_append(&text, "x", 1) ||
        text.error != RuntimeError.out_of_memory ||
        text.buffer.length != 8388608 ||
        !bootstrap_x86_64_text_is_valid(text)) {
        bootstrap_x86_64_text_release(text);
        std_byte_buffer_release(source);
        return 3;
    }

    let text_error: RuntimeError =
        bootstrap_x86_64_text_release(text);
    let source_error: RuntimeError =
        std_byte_buffer_release(source);
    if (text_error != RuntimeError.none ||
        source_error != RuntimeError.none) {
        return 4;
    }
    return 42;
}
