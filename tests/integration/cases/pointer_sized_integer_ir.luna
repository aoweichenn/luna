module test.pointer_sized_integer_ir;

fn widen(value: i32) -> isize {
    return value as isize;
}

fn reinterpret(value: isize) -> usize {
    return value as usize;
}

fn truncate(value: usize) -> u16 {
    return value as u16;
}

fn main() -> i32 {
    let wide: isize = widen(-1);
    let bits: usize = reinterpret(wide);
    return truncate(bits) as i32;
}
