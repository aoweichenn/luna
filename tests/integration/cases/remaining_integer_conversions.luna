module test.remaining_integer_conversions;

fn main() -> i32 {
    let u32_to_i32: i32 = (4294967295 as u32) as i32;
    let u32_to_u64: u64 = (4294967295 as u32) as u64;
    let i64_to_u32: u32 = (-1 as i64) as u32;
    let i64_to_u64: u64 = (-1 as i64) as u64;

    if (u32_to_i32 == -1 &&
        u32_to_u64 == 4294967295 &&
        i64_to_u32 == 4294967295 &&
        i64_to_u64 == 18446744073709551615) {
        return 42;
    }
    return 1;
}
