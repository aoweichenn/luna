module tests.scalar_conversions;

fn check_float_widths() -> bool {
    let single: f32 = 16777217.0;
    let widened: f64 = single as f64;
    let double: f64 = 16777217.0;
    let narrowed: f32 = double as f32;
    let huge: f64 = 1.0e300;
    let overflow: f32 = huge as f32;
    let infinity: f32 = 1.0 / 0.0;
    return widened == 16777216.0 &&
           narrowed == 16777216.0 &&
           overflow == infinity;
}

fn check_integer_to_float() -> bool {
    let signed: i64 = 9007199254740993;
    let signed_float: f64 = signed as f64;
    let negative: i64 = -9223372036854775808;
    let negative_float: f64 = negative as f64;
    let unsigned: u64 = 18446744073709551615;
    let unsigned_float: f64 = unsigned as f64;
    let word: u32 = 4294967295;
    let word_float: f32 = word as f32;
    return signed_float == 9007199254740992.0 &&
           negative_float == -9223372036854775808.0 &&
           unsigned_float == 18446744073709551616.0 &&
           word_float == 4294967296.0;
}

fn check_float_to_integer() -> bool {
    let positive: f64 = 42.875;
    let negative: f64 = -42.875;
    let byte: f32 = 254.75;
    let word: f64 = 4294967295.0;
    let wide: f64 = 18446744073709549568.0;
    let minimum: f64 = -9223372036854775808.0;
    let signed_maximum_float: f64 = 9223372036854774784.0;
    let wide_single: f32 = 9223372036854775808.0;
    let negative_zero: f64 = -0.0;
    return positive as i32 == 42 &&
           negative as i64 == -42 &&
           byte as u8 == 254 &&
           word as u32 == 4294967295 &&
           wide as u64 == 18446744073709549568 &&
           minimum as i64 == -9223372036854775808 &&
           signed_maximum_float as i64 == 9223372036854774784 &&
           wide_single as u64 == 9223372036854775808 &&
           negative_zero as usize == 0;
}

fn check_target_sized() -> bool {
    let signed: isize = -4096;
    let unsigned: usize = 8192;
    let signed_float: f32 = signed as f32;
    let unsigned_float: f64 = unsigned as f64;
    return signed_float as isize == -4096 &&
           unsigned_float as usize == 8192;
}

fn main() -> i32 {
    if (check_float_widths() &&
        check_integer_to_float() &&
        check_float_to_integer() &&
        check_target_sized()) {
        return 42;
    }
    return 1;
}
