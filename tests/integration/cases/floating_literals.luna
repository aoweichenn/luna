module tests.floating_literals;

fn default_literal_is_f64() -> bool {
    return 1.25 == 1.25;
}

fn main() -> i32 {
    let separated: f64 = 1_2.5_0e+1;
    let rounded_single: f32 = 16_777_217.0;
    let rounded_double: f64 = 9_007_199_254_740_993.0;
    let maximum_single: f32 = 3.4028235e38;
    let maximum_double: f64 = 1.7976931348623157e308;
    let smallest_single: f32 = 1.40129846e-45;
    let smallest_double: f64 = 4.9406564584124654e-324;
    let underflow: f64 = 1e-9999;
    let rounded_operation_single: f32 = 16_777_216.0 + 1.0;
    let rounded_operation_double: f64 = 9_007_199_254_740_992.0 + 1.0;

    if (separated == 125.0 &&
        rounded_single == 16_777_216.0 &&
        rounded_double == 9_007_199_254_740_992.0 &&
        rounded_operation_single == 16_777_216.0 &&
        rounded_operation_double == 9_007_199_254_740_992.0 &&
        maximum_single > 3.0e38 &&
        maximum_double > 1.0e308 &&
        smallest_single > 0.0 &&
        smallest_double > 0.0 &&
        underflow == 0.0 &&
        default_literal_is_f64()) {
        return 42;
    }
    return 1;
}
