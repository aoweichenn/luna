module ci.s;

struct P {
    value: u8;
}

type Word = u32;

class Marker {
}

class Callable {
    priv value: i32;

    pub init(value: i32);
    pub fn inspect(value: u32) const -> i32;
    pub fn mutate() -> i32;
    pub static fn associated(value: i64) -> i32;
}

impl Callable {
    init(value: i32) {
        this->value = value;
    }

    fn inspect(value: u32) const -> i32 {
        return this->value + value as i32;
    }

    fn mutate() -> i32 {
        this->value += 1;
        return this->value;
    }

    static fn associated(value: i64) -> i32 {
        return value as i32;
    }
}

fn scalar(value: i32) -> i64 {
    return value as i64;
}

fn pointer(value: *const volatile u8) -> usize {
    return value as usize;
}

fn array(value: [3]u16) -> u16 {
    return value[0];
}

fn callback(value: fn(i32) -> i64) -> i64 {
    return value(0);
}

fn named(value: P) -> P {
    return value;
}

fn alias(value: Word) -> u32 {
    return value;
}

fn class_pointer(value: *Marker) -> usize {
    return value as usize;
}

@noreturn fn never() {
    loop {
    }
}

fn variadic(first: i32, ...) -> i32 {
    return first;
}
