module ci.s;

struct P {
    value: u8;
}

type Word = u32;

fn scalar(value: i32) -> i64 {
    return value as i64;
}

fn pointer(value: *const volatile u8) -> usize {
    return value as usize;
}

fn array(value: [3]u16) -> u16 {
    return value[0];
}

fn callback(value: fn(i32) -> i64) -> i64 {
    return value(0);
}

fn named(value: P) -> P {
    return value;
}

fn alias(value: Word) -> u32 {
    return value;
}

@noreturn fn never() {
    loop {
    }
}

fn variadic(first: i32, ...) -> i32 {
    return first;
}
