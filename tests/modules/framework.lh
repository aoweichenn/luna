export module tests.modules.framework;

export class TestSuite {
    priv first_failure: i32;

    pub init();
    pub fn EXPECT(condition: bool, case_id: usize);
    pub fn EXPECT_EQ(actual: i32, expected: i32, case_id: usize);
    pub fn EXPECT_EXIT(actual: i32, expected: i32, case_id: usize);
    pub fn ASSERT(condition: bool, case_id: usize) -> bool;
    pub fn ASSERT_EQ(actual: i32, expected: i32, case_id: usize) -> bool;
    pub fn result() const -> i32;
}
