module tests.modules.opaque_counter;

class Counter {
    priv stored: i32;

    pub init(value: i32);
    pub fn read() const -> i32;
}

impl Counter {
    init(value: i32) {
        this->stored = value;
    }

    fn read() const -> i32 {
        return this->stored;
    }
}

fn internal_answer() -> i32 {
    let counter: Counter = Counter(42);
    if (sizeof(Counter) != 4 || alignof(Counter) != 4) {
        return 1;
    }
    return counter.read();
}
