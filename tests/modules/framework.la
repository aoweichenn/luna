module tests.modules.framework;

impl TestSuite {
    init() {
        this->first_failure = 0;
    }

    fn EXPECT(condition: bool, case_id: usize) {
        if (!condition && this->first_failure == 0) {
            this->first_failure = case_id as i32;
        }
    }

    fn EXPECT_EQ(actual: i32, expected: i32, case_id: usize) {
        this->EXPECT(actual == expected, case_id);
    }

    fn EXPECT_EXIT(actual: i32, expected: i32, case_id: usize) {
        this->EXPECT_EQ((actual as u8) as i32, expected, case_id);
    }

    fn ASSERT(condition: bool, case_id: usize) -> bool {
        this->EXPECT(condition, case_id);
        return condition;
    }

    fn ASSERT_EQ(actual: i32, expected: i32, case_id: usize) -> bool {
        return this->ASSERT(actual == expected, case_id);
    }

    fn result() const -> i32 {
        return this->first_failure;
    }
}
