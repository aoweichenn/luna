export module tests.generic_api;

export struct Pair<First, Second> {
    first: First;
    second: Second;
}

export fn identity<Value>(value: Value) -> Value {
    return value;
}

export fn exchange<Value>(target: *Value, replacement: Value) -> Value {
    let previous: Value = *target;
    *target = replacement;
    return previous;
}

export class Box<Value> {
    priv value: Value;

    pub init(value: Value);
    pub fn get() const -> Value;
}

impl Box {
    init(value: Value)
        : value = value {
    }

    fn get() const -> Value {
        return this->value;
    }
}
