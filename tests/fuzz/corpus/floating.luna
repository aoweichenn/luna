module fuzz.floating;

fn average(left: f32, right: f32) -> f32 {
    return (left + right) / 2.0;
}

fn classify(value: f64) -> bool {
    let infinity: f64 = 1.0 / 0.0;
    let not_a_number: f64 = 0.0 / 0.0;
    return value < infinity && not_a_number != not_a_number;
}

fn main() -> i32 {
    var value: f32 = average(1.25, 2.75);
    value *= -2.0;
    if (value == -4.0 && classify(42.0)) {
        return 42;
    }
    return 1;
}
