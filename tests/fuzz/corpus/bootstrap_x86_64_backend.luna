module fuzz.bootstrap_x86_64_backend;

import luna.runtime;
import luna.bootstrap.backend.x86_64.codegen;

fn main() -> i32 {
    let result: BootstrapX8664BackendResult =
        bootstrap_x86_64_backend_empty();
    let error: RuntimeError =
        bootstrap_x86_64_backend_release(result);
    return error == RuntimeError.none ? 42 : 1;
}
