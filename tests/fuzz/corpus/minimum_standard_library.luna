export module fuzz.std.runtime;

export enum Error: isize {
    none = 0,
    out_of_memory = 12,
}

export fn allocate(length: usize) -> *u8;

===LUNA_SOURCE_UNIT===
module fuzz.std.runtime;

fn allocate(length: usize) -> *u8 {
    if (length == 0) {
        return null;
    }
    return length as *u8;
}

===LUNA_SOURCE_UNIT===
export module fuzz.std.bytes;

import fuzz.std.runtime;

export struct Buffer {
    data: *u8;
    length: usize;
    capacity: usize;
}

export struct BufferResult {
    buffer: Buffer;
    error: Error;
}

export fn with_capacity(capacity: usize) -> BufferResult;

===LUNA_SOURCE_UNIT===
module fuzz.std.bytes;

fn with_capacity(capacity: usize) -> BufferResult {
    if (capacity == 0) {
        return {
            buffer = {
                data = null,
                length = 0,
                capacity = 0,
            },
            error = Error.none,
        };
    }
    let data: *u8 = allocate(capacity);
    return {
        buffer = {
            data = data,
            length = 0,
            capacity = capacity,
        },
        error = data == null ? Error.out_of_memory : Error.none,
    };
}

===LUNA_SOURCE_UNIT===
module fuzz.std.application;

import fuzz.std.runtime;
import fuzz.std.bytes;

fn main() -> i32 {
    let result: BufferResult = with_capacity(64);
    return result.error == Error.none &&
        result.buffer.capacity == 64 ? 42 : 1;
}
