module fuzz.i64;

fn transform(value: i64, amount: i64) -> i64 {
    return ((value * amount) ^ 9223372036854775807) >> 7;
}

fn main() -> i32 {
    let result: i64 = transform(4294967296, 17);
    let narrowed: i32 = result as i32;
    if (result != 0 && (narrowed as i64) != 0) {
        return 42;
    }
    return 1;
}
