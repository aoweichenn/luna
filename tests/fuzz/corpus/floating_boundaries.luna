module fuzz.floating_boundaries;

fn minimum_single() -> f32 {
    return 1.401298464324817070923729583289916131280e-45;
}

fn maximum_single() -> f32 {
    return 3.40282346638528859811704183484516925440e38;
}

fn minimum_double() -> f64 {
    return 4.940656458412465441765687928682213723651e-324;
}

fn maximum_double() -> f64 {
    return 1.797693134862315708145274237317043567981e308;
}

fn direct_single_rounding() -> f32 {
    return 1.0000000596046447753906251;
}

fn main() -> i32 {
    if (minimum_single() > 0.0 &&
        maximum_single() > minimum_single() &&
        minimum_double() > 0.0 &&
        maximum_double() > minimum_double() &&
        direct_single_rounding() > 1.0) {
        return 42;
    }
    return 1;
}
