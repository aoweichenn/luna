module fuzz.aggregate;

enum Kind: i8 {
    minimum = -128,
    ready = 7,
    complete,
}

struct Inner {
    byte: u8;
    value: i32;
}

union Storage {
    inner: Inner;
    bits: u64;
}

struct State {
    kind: Kind;
    storage: Storage;
    next: *State;
}

fn main() -> i32 {
    var state: State = {
        storage = { inner = { value = 42, }, },
        kind = Kind.ready,
    };
    var copy: State = state;
    copy = state;
    let pointer: *State = &state;
    pointer->next = pointer;
    if (sizeof(State) != 24 ||
        alignof(State) != 8 ||
        offsetof(State, storage) != 8 ||
        offsetof(State, next) != 16 ||
        offsetof(Storage, inner) != 0) {
        return 2;
    }
    switch (pointer->kind) {
        case Kind.ready {
            return pointer->storage.inner.value;
        }
        default {
            return 1;
        }
    }
}
