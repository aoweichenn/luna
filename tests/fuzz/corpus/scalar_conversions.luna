module fuzz.scalar_conversions;

fn mix(signed: i64, unsigned: u64, single: f32, double: f64) -> i64 {
    let widened: f64 = single as f64;
    let narrowed: f32 = double as f32;
    let signed_float: f64 = signed as f64;
    let unsigned_float: f32 = unsigned as f32;
    let from_wide: i64 = widened as i64;
    let from_narrow: i32 = narrowed as i32;
    let from_signed: i64 = signed_float as i64;
    let from_unsigned: u64 = unsigned_float as u64;
    return from_wide + (from_narrow as i64) + from_signed +
           (from_unsigned as i64);
}

fn main() -> i32 {
    return mix(-42, 42, 1.5, 2.75) as i32;
}
