module fuzz.unsigned;

fn mix32(value: u32) -> u32 {
    return ((value / 3) + (value % 7)) >> 1;
}

fn mix64(value: u64) -> u64 {
    return ((value as i64) as u64) ^ (value >> 63);
}

fn main() -> i32 {
    if (mix32(4294967295) > 0 &&
        mix64(18446744073709551615) > 0) {
        return 42;
    }
    return 1;
}
