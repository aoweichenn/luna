===LUNA_IMPLEMENTATION===
module fuzz.module_pair;

fn calculate(data: *const Input, amount: i32) -> i32 {
    return data->value + amount;
}

fn main() -> i32 {
    var input: Input = { value = 20, };
    return calculate((&input) as *const Input, 22);
}
