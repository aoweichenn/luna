module fuzz.memory;

fn update(base: *i32, index: usize, value: i32) -> i32 {
    base[index] = value;
    return base[index];
}

fn main() -> i32 {
    var values: [4]i32 = {};
    let base: *i32 = &values[0];
    let result: i32 = update(base, 2, 42);
    let read_only: *const i32 = base as *const i32;
    let text: *const u8 = "fuzz\n";
    if (result == 42 && read_only[2] == 42 && text[4] == 10) {
        return 42;
    }
    return 1;
}
