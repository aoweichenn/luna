module fuzz.aggregate_by_value;

struct Pair {
    left: i32;
    right: i32;
}

struct Mixed {
    real: f64;
    tag: i32;
}

struct Big {
    first: i64;
    second: i64;
    third: i64;
}

fn choose(flag: bool, value: Pair) -> Pair {
    return flag ? value : { left = 1, right = 2, };
}

fn adjust(value: Mixed) -> Mixed {
    var result: Mixed = value;
    result.tag += 2;
    return result;
}

fn echo_big(value: Big) -> Big {
    return value;
}

fn rollback(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32,
            value: Pair) -> i32 {
    return a + b + c + d + e + f + value.left + value.right;
}

fn main() -> i32 {
    let pair: Pair = choose(true, { left = 20, right = 22, });
    let mixed: Mixed = adjust({ real = 1.0, tag = 40, });
    let big: Big = echo_big({ first = 10, second = 11, third = 21, });
    return rollback(0, 0, 0, 0, 0, 0, pair) + mixed.tag +
           (big.first as i32) - 52;
}
