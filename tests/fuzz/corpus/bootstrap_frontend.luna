module fuzz.bootstrap_frontend;

struct Pair {
    left: i32;
    right: i32;
}

enum Mode: u8 {
    add = 1,
    subtract,
}

fn evaluate(mode: Mode, pair: *const Pair) -> i32 {
    var result: i32 = 0;
    for (var index: i32 = 0; index < 4; index += 1) {
        if ((index & 1) == 0) {
            result += pair->left;
        } else {
            result -= pair->right;
        }
    }
    switch (mode) {
        case Mode.add {
            result += sizeof(Pair) as i32;
        }
        case Mode.subtract {
            result -= alignof(Pair) as i32;
        }
        default {
            result = result > 0 ? result : -result;
        }
    }
    return result;
}

fn main() -> i32 {
    let pair: Pair = {
        left = 7,
        right = 3,
    };
    return evaluate(Mode.add, &pair);
}
