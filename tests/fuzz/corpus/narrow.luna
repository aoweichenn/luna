module fuzz.narrow;

fn signed_mix(value: i8, count: i8) -> i16 {
    return ((value >> count) as u8) as i16;
}

fn unsigned_mix(value: u16, count: u16) -> u8 {
    return ((value / 3) >> count) as u8;
}

fn main() -> i32 {
    if (signed_mix(-64, 9) == 224 &&
        unsigned_mix(65535, 17) == 170) {
        return 42;
    }
    return 1;
}
