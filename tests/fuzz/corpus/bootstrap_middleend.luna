module fuzz.bootstrap_middleend;

struct Pair {
    left: i64;
    right: i64;
}

enum Operation: u8 {
    add,
    subtract,
}

fn apply(pair: Pair, operation: Operation) -> i64 {
    switch (operation) {
        case Operation.add {
            return pair.left + pair.right;
        }
        case Operation.subtract {
            return pair.left - pair.right;
        }
    }
    return 0;
}

fn main() -> i32 {
    var pair: Pair = {
        left = 40,
        right = 2,
    };
    var values: [2]i64 = {};
    values[0 as usize] = pair.left;
    values[1 as usize] = pair.right;
    let pointer: *i64 = &values[0 as usize];
    pair.left = *pointer;
    return apply(pair, Operation.add) as i32;
}
