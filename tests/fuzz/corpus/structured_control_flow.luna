module fuzz.structured_control_flow;

fn select(condition: bool, left: i32, right: i32) -> i32 {
    return condition ? left : right;
}

fn main() -> i32 {
    var value: i32 = 0;
    do {
        value += 1;
    } while (value < 2);

    for (var index: i32 = 0; index < 4; index += 1) {
        switch (index) {
            case 0, 2 {
                continue;
            }

            case 3 {
                break;
            }

            default {
                value += select(true, index, 0);
            }
        }
    }
    return value;
}
