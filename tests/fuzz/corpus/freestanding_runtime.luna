module fuzz.runtime.app;

import luna.runtime;

fn main() -> i32 {
    let mapping: RuntimeMemoryResult = runtime_memory_map(4096);
    if (mapping.error != RuntimeError.none) {
        return 1;
    }
    mapping.memory.address[0] = 42;
    let output: RuntimeIoResult = runtime_file_write(
        runtime_standard_output(),
        mapping.memory.address as *const u8,
        1
    );
    return output.count as i32;
}

===LUNA_SOURCE_UNIT===
export module luna.runtime;

export enum RuntimeError: isize {
    none = 0,
    invalid_argument = 22,
}

export struct RuntimeFile {
    descriptor: isize;
}

export struct RuntimeMemory {
    address: *u8;
    length: usize;
}

export struct RuntimeIoResult {
    count: usize;
    error: RuntimeError;
}

export struct RuntimeMemoryResult {
    memory: RuntimeMemory;
    error: RuntimeError;
}

export fn runtime_standard_output() -> RuntimeFile;
export fn runtime_file_write(
    file: RuntimeFile,
    buffer: *const u8,
    length: usize
) -> RuntimeIoResult;
export fn runtime_memory_map(length: usize) -> RuntimeMemoryResult;

===LUNA_SOURCE_UNIT===
module luna.runtime;

fn runtime_standard_output() -> RuntimeFile {
    return { descriptor = 1, };
}

fn runtime_file_write(
    file: RuntimeFile,
    buffer: *const u8,
    length: usize
) -> RuntimeIoResult {
    return {
        count = length,
        error = RuntimeError.none,
    };
}

fn runtime_memory_map(length: usize) -> RuntimeMemoryResult {
    return {
        memory = {
            address = null,
            length = 0,
        },
        error = RuntimeError.invalid_argument,
    };
}
