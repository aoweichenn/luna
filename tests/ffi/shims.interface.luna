export module tests.ffi.shims;

// Freestanding libc shim layer for the gcc FFI fixture (tests/ffi/fixture.c).
// Every definition in the implementation carries @export_name, so the emitted
// symbol is the verbatim C name the gcc-compiled object references.

export fn shim_memcpy(destination: *void, source: *const void, count: usize) -> *void;
export fn shim_memmove(destination: *void, source: *const void, count: usize) -> *void;
export fn shim_memset(destination: *void, value: i32, count: usize) -> *void;
export fn shim_memcmp(left: *const void, right: *const void, count: usize) -> i32;
export fn shim_strlen(text: *const u8) -> usize;
export fn shim_strcmp(left: *const u8, right: *const u8) -> i32;
export fn shim_strncmp(left: *const u8, right: *const u8, count: usize) -> i32;
export fn shim_malloc(size: usize) -> *void;
export fn shim_free(memory: *void) -> void;
export fn shim_calloc(count: usize, size: usize) -> *void;
export fn shim_abort() -> void;
