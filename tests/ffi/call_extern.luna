module tests.ffi.call_extern;

// Linked against tests/ffi/answer.o, a hand-encoded ELF64 ET_REL object
// (see generate_fixtures.py) that exports ffi_answer and ffi_answer_plus.

extern fn ffi_answer() -> i32;
extern fn ffi_answer_plus(value: i32) -> i32;

fn main() -> i32 {
    if (ffi_answer() != 42) {
        return 1;
    }
    return ffi_answer_plus(35);
}
