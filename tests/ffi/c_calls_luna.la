module tests.ffi.c_calls_luna;

// C-calls-Luna FFI: every definition carries @export_name, so assembling this
// module with luna-as --emit elf yields an ELF64 object whose symbols the
// host C main (cmain_c_calls_luna.c) links against directly. Exercises SysV
// integer arguments and returns at i32, u8 -> i32 and i64 widths.

@export_name("luna_answer") fn answer() -> i32 {
    return 40;
}

@export_name("luna_add3") fn add3(a: i32, b: i32, c: i32) -> i32 {
    return a + b + c;
}

@export_name("luna_widen") fn widen(x: u8) -> i32 {
    return x as i32;
}

@export_name("luna_add64") fn add64(a: i64, b: i64) -> i64 {
    return a + b;
}
