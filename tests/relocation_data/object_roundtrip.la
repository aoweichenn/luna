module tests.relocation_data.object_roundtrip;

import luna.compiler.x86.assembler as assembler;
import luna.compiler.x86.elf as elf;
import luna.compiler.x86.linker as linker;
import luna.compiler.x86.object as object;
import luna.runtime;
import luna.std.binary as binary;
import luna.std.bytes as bytes;
import luna.std.string_view as string_views;

enum ProbeLayout: usize {
    relocation_count = 2, second_address_offset = 16, byte_count = 24,
}

enum ExecutableLayout: usize {
    elf_type = 2, machine = 62, header_size = 64, program_header_size = 56,
    program_count = 3, load_segment = 1, page_size = 4096,
    text_flags = 5, rodata_flags = 4, data_flags = 6,
    type_offset = 16, machine_offset = 18, program_table_offset = 32, section_table_offset = 40,
    header_size_offset = 52, program_size_offset = 54, program_count_offset = 56,
    program_flags_offset = 4, program_alignment_offset = 48,
    magic_zero = 127, magic_one = 69, magic_two = 76, magic_three = 70,
}

fn relocation_table_is_valid(value: object::Object const&) -> bool {
    let view: object::ObjectView = value.view();
    if (!object::view_is_valid(view) || view.relocations.count != ProbeLayout.relocation_count as usize) {
        return false;
    }
    if (view.rodata.length != ProbeLayout.byte_count as usize) {
        return false;
    }
    let expected_name: string_views::string_view_result = string_views::from_c_string("dispatch_target", 32);
    if (expected_name.error != runtime::Error.none) {
        return false;
    }
    for (var index: usize = 0; index < ProbeLayout.relocation_count as usize; index += 1) {
        let found: object::RelocationResult = object::relocation_at(view, index);
        if (found.error != runtime::Error.none) {
            return false;
        }
        let relocation: object::Relocation = found.relocation;
        let expected_offset: usize = index * (ProbeLayout.second_address_offset as usize);
        let shape_is_valid: bool = relocation.section == object::Section.rodata &&
            relocation.kind == object::RelocationKind.absolute64;
        let value_is_valid: bool = relocation.offset == expected_offset && relocation.addend == 0;
        if (!shape_is_valid || !value_is_valid) {
            return false;
        }
        let symbol_result: object::SymbolResult = object::symbol_at(view, relocation.symbol_index);
        if (symbol_result.error != runtime::Error.none) {
            return false;
        }
        let name: string_views::string_view_result = object::symbol_name(view, symbol_result.symbol);
        if (name.error != runtime::Error.none || !string_views::equal(name.view, expected_name.view)) {
            return false;
        }
    }
    return true;
}

fn first_error(current: runtime::Error, next: runtime::Error) -> runtime::Error {
    return current == runtime::Error.none ? next : current;
}

fn load_is_rejected(data: *const u8, length: usize) -> bool {
    let loaded: object::Result = elf::load(data, length);
    return loaded.error != runtime::Error.none;
}

fn mutation_is_rejected(source: bytes::Buffer, offset: usize, value: u8) -> bool {
    if (offset >= source.length) {
        return false;
    }
    let copied: bytes::BufferResult = bytes::from(source.data as *const u8, source.length);
    if (copied.error != runtime::Error.none) {
        return false;
    }
    copied.buffer.data[offset] = value;
    let rejected: bool = load_is_rejected(copied.buffer.data as *const u8, copied.buffer.length);
    let release_error: runtime::Error = bytes::release(copied.buffer);
    return rejected && release_error == runtime::Error.none;
}

fn section_header(source: bytes::Buffer, expected_kind: u32) -> usize {
    var table_offset: u64 = 0;
    var section_count: u16 = 0;
    if (!binary::read_u64(source.data as *const u8, source.length, 40, &table_offset) ||
        !binary::read_u16(source.data as *const u8, source.length, 60, &section_count)) {
        return source.length;
    }
    for (var index: usize = 0; index < section_count as usize; index += 1) {
        let header: usize = table_offset as usize + index * 64;
        var kind: u32 = 0;
        if (!binary::read_u32(source.data as *const u8, source.length, header + 4, &kind)) {
            return source.length;
        }
        if (kind == expected_kind) {
            return header;
        }
    }
    return source.length;
}

fn malformed_elf_is_rejected(source: bytes::Buffer) -> bool {
    if (source.length < 64) {
        return false;
    }
    for (var length: usize = 0; length < 64; length += 1) {
        if (!load_is_rejected(source.data as *const u8, length)) {
            return false;
        }
    }
    if (!mutation_is_rejected(source, 0, 0) || !mutation_is_rejected(source, 47, 255)) {
        return false;
    }
    var section_offset: u64 = 0;
    if (!binary::read_u64(source.data as *const u8, source.length, 40, &section_offset)) {
        return false;
    }
    if (!mutation_is_rejected(source, section_offset as usize + 4, 1)) {
        return false;
    }
    let symtab_header: usize = section_header(source, 2);
    if (!mutation_is_rejected(source, symtab_header + 40, 0)) {
        return false;
    }
    let rela_header: usize = section_header(source, 4);
    var relocation_offset: u64 = 0;
    if (!binary::read_u64(source.data as *const u8, source.length, rela_header + 24, &relocation_offset)) {
        return false;
    }
    return mutation_is_rejected(source, relocation_offset as usize + 15, 255);
}

fn executable_layout_is_valid(executable: bytes::Buffer) -> bool {
    if (executable.length < 4 || executable.data == null) {
        return false;
    }
    var elf_type: u16 = 0;
    var machine: u16 = 0;
    var program_offset: u64 = 0;
    var section_offset: u64 = 0;
    var header_size: u16 = 0;
    var program_size: u16 = 0;
    var program_count: u16 = 0;
    let content: *const u8 = executable.data as *const u8;
    if (!binary::read_u16(content, executable.length, ExecutableLayout.type_offset as usize, &elf_type) ||
        !binary::read_u16(content, executable.length, ExecutableLayout.machine_offset as usize, &machine)) {
        return false;
    }
    if (!binary::read_u64(content, executable.length, ExecutableLayout.program_table_offset as usize,
            &program_offset) || !binary::read_u64(content, executable.length,
            ExecutableLayout.section_table_offset as usize, &section_offset)) {
        return false;
    }
    if (!binary::read_u16(content, executable.length, ExecutableLayout.header_size_offset as usize, &header_size) ||
        !binary::read_u16(content, executable.length, ExecutableLayout.program_size_offset as usize, &program_size)) {
        return false;
    }
    if (!binary::read_u16(
            content, executable.length, ExecutableLayout.program_count_offset as usize, &program_count)) {
        return false;
    }
    let identity_is_valid: bool = content[0] == (ExecutableLayout.magic_zero as usize) as u8;
    let suffix_is_valid: bool = content[1] == (ExecutableLayout.magic_one as usize) as u8 &&
        content[2] == (ExecutableLayout.magic_two as usize) as u8;
    if (!identity_is_valid || !suffix_is_valid) {
        return false;
    }
    if (content[3] != (ExecutableLayout.magic_three as usize) as u8 ||
        elf_type != (ExecutableLayout.elf_type as usize) as u16) {
        return false;
    }
    if (machine != (ExecutableLayout.machine as usize) as u16 || section_offset != 0) {
        return false;
    }
    let sizes_are_valid: bool = header_size == (ExecutableLayout.header_size as usize) as u16 &&
        program_size == (ExecutableLayout.program_header_size as usize) as u16;
    if (!sizes_are_valid || program_count != (ExecutableLayout.program_count as usize) as u16) {
        return false;
    }
    let expected_flags: [3]u32 = {
        ExecutableLayout.text_flags as usize as u32,
        ExecutableLayout.rodata_flags as usize as u32,
        ExecutableLayout.data_flags as usize as u32,
    };
    for (var index: usize = 0; index < ExecutableLayout.program_count as usize; index += 1) {
        let record: usize = program_offset as usize + index * (ExecutableLayout.program_header_size as usize);
        var kind: u32 = 0;
        var flags: u32 = 0;
        var alignment: u64 = 0;
        if (!binary::read_u32(content, executable.length, record, &kind) ||
            !binary::read_u32(
                content, executable.length, record + (ExecutableLayout.program_flags_offset as usize), &flags)) {
            return false;
        }
        if (!binary::read_u64(content, executable.length,
                record + (ExecutableLayout.program_alignment_offset as usize), &alignment)) {
            return false;
        }
        if (kind != (ExecutableLayout.load_segment as usize) as u32 || flags != expected_flags[index]) {
            return false;
        }
        if (alignment != (ExecutableLayout.page_size as usize) as u64) {
            return false;
        }
    }
    return true;
}

fn link_failure_is(
    assembly: *const u8, maximum_length: usize,
    expected_error: runtime::Error, expected_input: usize) -> bool {
    let source: string_views::string_view_result = string_views::from_c_string(assembly, maximum_length);
    if (source.error != runtime::Error.none) {
        return false;
    }
    let assembled: assembler::Result = assembler::assemble(source.view);
    if (assembled.error != runtime::Error.none) {
        return false;
    }
    var objects: object::ObjectSet = object::ObjectSet();
    if (!objects.add(assembled.object)) {
        return false;
    }
    let linked: linker::Result = linker::link(objects);
    let error_is_valid: bool = linked.error == expected_error && linked.input_index == expected_input;
    let output_is_empty: bool = linked.executable.length == 0 && linked.executable.data == null;
    let release_error: runtime::Error = bytes::release(linked.executable);
    if (!error_is_valid || !output_is_empty) {
        return false;
    }
    return release_error == runtime::Error.none;
}

fn linker_boundary_status() -> i32 {
    let source: string_views::string_view_result = string_views::from_c_string(
        ".section .rodata,\"a\",@progbits\n"
        ".byte 7\n"
        ".data\n"
        ".byte 9\n"
        ".text\n"
        ".globl _start\n"
        ".type _start, @function\n"
        "_start:\n"
        "movl $42, %edi\n"
        "movl $60, %eax\n"
        "syscall\n"
        ".size _start, .-_start\n", 512);
    if (source.error != runtime::Error.none) {
        return 20;
    }
    let assembled: assembler::Result = assembler::assemble(source.view);
    if (assembled.error != runtime::Error.none) {
        return 21;
    }
    var objects: object::ObjectSet = object::ObjectSet();
    if (!objects.add(assembled.object)) {
        return 21;
    }
    let first: linker::Result = linker::link(objects);
    let second: linker::Result = linker::link(objects);
    let output_is_valid: bool = first.error == runtime::Error.none && second.error == runtime::Error.none;
    let layout_is_valid: bool = output_is_valid && executable_layout_is_valid(first.executable);
    let output_is_stable: bool = layout_is_valid &&
        bytes::equal(first.executable, second.executable.data as *const u8, second.executable.length);

    var duplicate_inputs: object::ObjectSet = object::ObjectSet();
    let duplicate_is_ready: bool = duplicate_inputs.add(assembled.object) && duplicate_inputs.add(assembled.object);
    let duplicate: linker::Result = linker::link(duplicate_inputs);
    let duplicate_is_valid: bool = duplicate.error == runtime::Error.exists && duplicate.input_index == 1;
    var empty_inputs: object::ObjectSet = object::ObjectSet();
    let empty: linker::Result = linker::link(empty_inputs);
    let empty_is_valid: bool = empty.error == runtime::Error.invalid_argument && empty.input_index == 0;

    var release_error: runtime::Error = bytes::release(empty.executable);
    release_error = first_error(release_error, bytes::release(duplicate.executable));
    release_error = first_error(release_error, bytes::release(second.executable));
    release_error = first_error(release_error, bytes::release(first.executable));
    if (!output_is_stable) {
        return 22;
    }
    if (!duplicate_is_ready || !duplicate_is_valid) {
        return 23;
    }
    if (!empty_is_valid) {
        return 24;
    }
    if (release_error != runtime::Error.none) {
        return 25;
    }

    let missing_entry: bool = link_failure_is(
        ".text\n.type helper, @function\nhelper:\nret\n.size helper, .-helper\n",
        128, runtime::Error.not_found, 0);
    let invalid_entry: bool = link_failure_is(
        ".text\nret\n.data\n.globl _start\n.type _start, @object\n"
        "_start:\n.byte 0\n.size _start, .-_start\n",
        192, runtime::Error.invalid_argument, 0);
    let unresolved: bool = link_failure_is(
        ".extern missing\n.text\n.globl _start\n.type _start, @function\n"
        "_start:\ncall missing\nret\n.size _start, .-_start\n",
        192, runtime::Error.not_found, 0);
    if (!missing_entry) {
        return 26;
    }
    if (!invalid_entry) {
        return 27;
    }
    return unresolved ? 0 : 28;
}

fn numeric_labels_are_valid() -> bool {
    let source: string_views::string_view_result = string_views::from_c_string(
        ".text\n"
        "1:\n"
        "jmp 2f\n"
        "ud2\n"
        "2:\n"
        "jmp 1b\n"
        "ret\n", 64);
    if (source.error != runtime::Error.none) {
        return false;
    }
    let assembled: assembler::Result = assembler::assemble(source.view);
    if (assembled.error != runtime::Error.none) {
        return false;
    }
    let view: object::ObjectView = assembled.object.view();
    if (view.text.length != 13) {
        return false;
    }
    let bytes_are_valid: bool = view.text.data[0] == 233 && view.text.data[1] == 2;
    let backward_is_valid: bool = view.text.data[7] == 233 && view.text.data[8] == 244;
    let shape_is_valid: bool = view.relocations.count == 0 && object::view_is_valid(view);
    if (!bytes_are_valid || !backward_is_valid) {
        return false;
    }
    if (!shape_is_valid) {
        return false;
    }

    let unresolved_source: string_views::string_view_result =
        string_views::from_c_string(".text\njmp 9f\n", 32);
    if (unresolved_source.error != runtime::Error.none) {
        return false;
    }
    let unresolved: assembler::Result = assembler::assemble(unresolved_source.view);
    let unresolved_is_valid: bool = unresolved.error == runtime::Error.invalid_argument &&
        unresolved.object.is_valid();
    return unresolved_is_valid;
}

fn main() -> i32 {
    if (!numeric_labels_are_valid()) {
        return 10;
    }
    let linker_status: i32 = linker_boundary_status();
    if (linker_status != 0) {
        return linker_status;
    }
    let source: string_views::string_view_result = string_views::from_c_string(
        ".section .rodata,\"a\",@progbits\n"
        ".extern dispatch_target\n"
        ".balign 8\n"
        ".type dispatch_table, @object\n"
        "dispatch_table:\n"
        ".quad dispatch_target\n"
        ".balign 16\n"
        ".quad dispatch_target\n"
        ".size dispatch_table, .-dispatch_table\n"
        ".section .note.GNU-stack,\"\",@progbits\n", 512);
    if (source.error != runtime::Error.none) {
        return 1;
    }
    let assembled: assembler::Result = assembler::assemble(source.view);
    if (assembled.error != runtime::Error.none || !relocation_table_is_valid(assembled.object)) {
        return 2;
    }

    let serialized: bytes::BufferResult = object::serialize(assembled.object);
    if (serialized.error != runtime::Error.none) {
        return 3;
    }
    let restored: object::Result = object::deserialize(
        serialized.buffer.data as *const u8, serialized.buffer.length);
    if (restored.error != runtime::Error.none || !relocation_table_is_valid(restored.object)) {
        return 4;
    }
    let serialized_again: bytes::BufferResult = object::serialize(restored.object);
    if (serialized_again.error != runtime::Error.none || !bytes::equal(
            serialized.buffer, serialized_again.buffer.data as *const u8, serialized_again.buffer.length)) {
        return 5;
    }

    let elf_bytes: bytes::BufferResult = elf::save(assembled.object);
    if (elf_bytes.error != runtime::Error.none) {
        return 6;
    }
    if (!malformed_elf_is_rejected(elf_bytes.buffer)) {
        bytes::release(elf_bytes.buffer);
        return 11;
    }
    let elf_object: object::Result = elf::load(elf_bytes.buffer.data as *const u8, elf_bytes.buffer.length);
    if (elf_object.error != runtime::Error.none || !relocation_table_is_valid(elf_object.object)) {
        return 7;
    }
    let elf_bytes_again: bytes::BufferResult = elf::save(elf_object.object);
    if (elf_bytes_again.error != runtime::Error.none || !bytes::equal(
            elf_bytes.buffer, elf_bytes_again.buffer.data as *const u8, elf_bytes_again.buffer.length)) {
        return 8;
    }

    var release_error: runtime::Error = bytes::release(elf_bytes_again.buffer);
    release_error = first_error(release_error, bytes::release(elf_bytes.buffer));
    release_error = first_error(release_error, bytes::release(serialized_again.buffer));
    release_error = first_error(release_error, bytes::release(serialized.buffer));
    return release_error == runtime::Error.none ? 42 : 9;
}
