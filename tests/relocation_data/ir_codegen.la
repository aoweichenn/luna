module tests.relocation_data.ir_codegen;

import luna.compiler.x86.codegen as codegen;
import luna.compiler.parser as parser;
import luna.compiler.ir as ir;
import luna.bootstrap.middleend.sema as sema;
import luna.bootstrap.middleend.semantic.classes.model as class_model;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.semantic.generics.model as generic_model;
import luna.runtime;
import luna.compiler.sema.domain as domain;
import luna.std.bytes as bytes;
import luna.std.string_view as string_views;
import luna.std.utility as utility;

enum ProbeLayout: usize {
    address_bytes = 8, second_address_offset = 16, byte_count = 24,
}

enum ClassProbe: usize {
    virtual_slot = 0, type_id = 1, friend_type = 2, field_id = 7, function_id = 11,
    descriptor_global = 13, vtable_global = 17,
}

enum GenericProbe: usize {
    module_id = 3, unit_index = 4, node_index = 5, name_token = 6,
    binding_id = 9, type_argument = 17, type_result = 23, function_id = 29,
    additional_instances = 13, argument_base = 100,
}

fn pattern_count(data: *const u8, length: usize, pattern: *const u8, pattern_length: usize) -> usize {
    if (data == null || pattern == null) {
        return 0;
    }
    if (pattern_length == 0 || pattern_length > length) {
        return 0;
    }
    var count: usize = 0;
    for (var offset: usize = 0; offset <= length - pattern_length; offset += 1) {
        var matches: bool = true;
        for (var index: usize = 0; index < pattern_length && matches; index += 1) {
            matches = data[offset + index] == pattern[index];
        }
        if (matches) {
            count += 1;
        }
    }
    return count;
}

fn first_error(current: runtime::Error, next: runtime::Error) -> runtime::Error {
    return current == runtime::Error.none ? next : current;
}

fn class_table_failure_is_sticky() -> bool {
    var rejected: class_model::ClassTable = class_model::ClassTable();
    let rejected_error: runtime::Error = rejected.append_record(context::no_id(), domain::ClassFlag.none as usize);
    let rejection_is_visible: bool = rejected_error == runtime::Error.invalid_argument &&
        rejected.error() == runtime::Error.invalid_argument;
    if (!rejection_is_visible || rejected.record_count() != 0) {
        return false;
    }
    let next_error: runtime::Error = rejected.append_record(
        ClassProbe.type_id as usize, domain::ClassFlag.none as usize);
    return next_error == runtime::Error.invalid_argument && rejected.record_count() == 0;
}

fn class_table_move_is_valid() -> bool {
    let none: usize = context::no_id();
    var original: class_model::ClassTable = class_model::ClassTable();
    if (original.append_record(ClassProbe.type_id as usize, domain::ClassFlag.none as usize) !=
            runtime::Error.none) {
        return false;
    }
    let field: domain::ClassField = {
        field_id = ClassProbe.field_id as usize, access = domain::ClassAccess.public_access,
    };
    if (original.append_field(0, field) != runtime::Error.none) {
        return false;
    }
    let method_record: domain::ClassMethod = {
        function_id = ClassProbe.function_id as usize, access = domain::ClassAccess.protected_access,
        dispatch = domain::MethodDispatch.virtual_method, virtual_slot = none,
        flags = domain::MethodFlag.none as usize,
    };
    if (original.append_method(0, method_record) != runtime::Error.none) {
        return false;
    }
    let friend_record: domain::ClassFriend = {
        owner_type = ClassProbe.type_id as usize, friend_type = ClassProbe.friend_type as usize,
    };
    if (original.append_friend(0, friend_record) != runtime::Error.none) {
        return false;
    }
    if (original.mark_polymorphic(0) != runtime::Error.none ||
            original.assign_virtual_slot(0, ClassProbe.virtual_slot as usize) != runtime::Error.none) {
        return false;
    }
    if (original.enable_rtti(0) != runtime::Error.none ||
            original.publish_descriptor(0, ClassProbe.descriptor_global as usize) != runtime::Error.none) {
        return false;
    }
    if (original.publish_vtable(0, ClassProbe.vtable_global as usize) != runtime::Error.none) {
        return false;
    }

    var moved: class_model::ClassTable = utility::move(original);
    let moved_counts_are_valid: bool = moved.record_count() == 1 && moved.field_count() == 1;
    let moved_members_are_valid: bool = moved.method_count() == 1 && moved.friend_count() == 1;
    if (!moved_counts_are_valid || !moved_members_are_valid) {
        return false;
    }
    let source_counts_are_empty: bool = original.record_count() == 0 && original.field_count() == 0;
    let source_members_are_empty: bool = original.method_count() == 0 && original.friend_count() == 0;
    if (!source_counts_are_empty || !source_members_are_empty) {
        return false;
    }
    let storage_is_valid: bool = moved.storage_is_valid() && original.storage_is_valid();
    let errors_are_empty: bool = moved.error() == runtime::Error.none && original.error() == runtime::Error.none;
    if (!storage_is_valid || !errors_are_empty) {
        return false;
    }
    let moved_record: domain::ClassRecord = moved.record_data()[0];
    let field_slice_is_valid: bool = moved_record.first_field == 0 && moved_record.field_count == 1;
    let method_slice_is_valid: bool = moved_record.first_method == 0 && moved_record.method_count == 1;
    let friend_slice_is_valid: bool = moved_record.first_friend == 0 && moved_record.friend_count == 1;
    let member_slices_are_valid: bool = field_slice_is_valid && method_slice_is_valid;
    if (!member_slices_are_valid || !friend_slice_is_valid) {
        return false;
    }
    let field_value_is_valid: bool = moved.field_data()[0].field_id == ClassProbe.field_id as usize;
    let method_value_is_valid: bool = moved.method_data()[0].function_id == ClassProbe.function_id as usize;
    let friend_value_is_valid: bool = moved.friend_data()[0].friend_type == ClassProbe.friend_type as usize;
    let member_values_are_valid: bool = field_value_is_valid && method_value_is_valid;
    if (!member_values_are_valid || !friend_value_is_valid) {
        return false;
    }
    let metadata_flags: usize = (domain::ClassFlag.polymorphic as usize) | (domain::ClassFlag.rtti as usize);
    let metadata_is_valid: bool = moved_record.flags == metadata_flags &&
        moved_record.descriptor_global == ClassProbe.descriptor_global as usize;
    let dispatch_is_valid: bool = moved_record.vtable_global == ClassProbe.vtable_global as usize &&
        moved.method_data()[0].virtual_slot == ClassProbe.virtual_slot as usize;
    if (!metadata_is_valid || !dispatch_is_valid) {
        return false;
    }
    return class_table_failure_is_sticky();
}

fn generic_probe_declaration() -> domain::GenericDeclaration {
    let none: usize = generic_model::no_id();
    return {
        kind = domain::GenericDeclarationKind.function_declaration,
        module_id = GenericProbe.module_id as usize,
        unit_index = GenericProbe.unit_index as usize,
        node_index = GenericProbe.node_index as usize,
        name_token = GenericProbe.name_token as usize,
        first_parameter = none, parameter_count = 0,
        binding_id = none, flags = 0,
    };
}

fn generic_table_failure_is_sticky(declaration: domain::GenericDeclaration) -> bool {
    var rejected: generic_model::GenericTable = generic_model::GenericTable();
    var malformed: domain::GenericDeclaration = declaration;
    malformed.first_parameter = 0;
    let rejected_error: runtime::Error = rejected.append_declaration(malformed);
    let rejection_is_visible: bool = rejected_error == runtime::Error.invalid_argument &&
        rejected.error() == runtime::Error.invalid_argument;
    if (!rejection_is_visible || rejected.declaration_count() != 0) {
        return false;
    }
    let next_error: runtime::Error = rejected.append_declaration(declaration);
    return next_error == runtime::Error.invalid_argument && rejected.declaration_count() == 0;
}

fn generic_table_indexes_are_valid(table: *generic_model::GenericTable) -> bool {
    if (table == null) {
        return false;
    }
    for (var index: usize = 0; index < GenericProbe.additional_instances as usize; index += 1) {
        let argument: usize = GenericProbe.argument_base as usize + index;
        let created =
            table->append_instance(0, generic_model::no_id(), &argument, 1, 0);
        if (created.error != runtime::Error.none) {
            return false;
        }
        let found: usize = table->find_instance(0, generic_model::no_id(), &argument, 1);
        if (found != created.instance_id) {
            return false;
        }
    }
    return true;
}

fn generic_table_move_is_valid() -> bool {
    let none: usize = generic_model::no_id();
    let declaration: domain::GenericDeclaration = generic_probe_declaration();
    var original: generic_model::GenericTable = generic_model::GenericTable();
    if (original.append_declaration(declaration) != runtime::Error.none) {
        return false;
    }
    if (original.is_valid()) {
        return false;
    }
    let parameter: domain::GenericParameter = {
        declaration_id = 0,
        unit_index = GenericProbe.unit_index as usize,
        node_index = GenericProbe.node_index as usize,
        name_token = GenericProbe.name_token as usize,
        position = 0,
    };
    if (original.append_parameter(0, parameter) != runtime::Error.none) {
        return false;
    }
    if (original.set_declaration_binding(0, GenericProbe.binding_id as usize) != runtime::Error.none) {
        return false;
    }

    let argument: usize = GenericProbe.type_argument as usize;
    let created = original.append_instance(0, none, &argument, 1, 0);
    if (created.error != runtime::Error.none || created.instance_id != 0) {
        return false;
    }
    let duplicate = original.append_instance(0, none, &argument, 1, 0);
    if (duplicate.error != runtime::Error.none || duplicate.instance_id != created.instance_id) {
        return false;
    }
    if (!generic_table_indexes_are_valid(&original)) {
        return false;
    }
    let expected_instance_count: usize = 1 + GenericProbe.additional_instances as usize;
    if (original.instance_count() != expected_instance_count) {
        return false;
    }
    if (original.set_instance_result(
            created.instance_id, GenericProbe.type_result as usize,
            none, domain::GenericInstanceState.resolving) != runtime::Error.none) {
        return false;
    }
    if (original.instance_for_type(GenericProbe.type_result as usize) != created.instance_id) {
        return false;
    }
    if (original.map_function_instance(GenericProbe.function_id as usize, created.instance_id) !=
        runtime::Error.none) {
        return false;
    }
    if (original.instance_for_function(GenericProbe.function_id as usize) != created.instance_id) {
        return false;
    }

    let active: domain::GenericActiveBinding = {
        unit_index = GenericProbe.unit_index as usize,
        name_token = GenericProbe.name_token as usize,
        type_id = GenericProbe.type_argument as usize,
    };
    if (original.append_active_binding(active) != runtime::Error.none) {
        return false;
    }
    if (original.is_valid() || original.active_binding_count() != 1) {
        return false;
    }
    if (original.truncate_active_bindings(0) != runtime::Error.none) {
        return false;
    }
    if (!original.is_valid()) {
        return false;
    }

    var moved: generic_model::GenericTable = utility::move(original);
    let source_is_empty: bool = original.declaration_count() == 0 && original.instance_count() == 0;
    let source_is_valid: bool = original.storage_is_valid() && original.is_valid();
    if (!source_is_empty || !source_is_valid) {
        return false;
    }
    let counts_are_valid: bool = moved.declaration_count() == 1 && moved.parameter_count() == 1;
    let instances_are_valid: bool = moved.instance_count() == expected_instance_count &&
        moved.argument_count() == expected_instance_count;
    if (!counts_are_valid || !instances_are_valid) {
        return false;
    }
    let declaration_is_valid: bool =
        moved.declaration_data()[0].binding_id == GenericProbe.binding_id as usize;
    let parameter_is_valid: bool = moved.parameter_data()[0].declaration_id == 0;
    let argument_is_valid: bool = moved.argument_data()[0] == GenericProbe.type_argument as usize;
    let records_are_valid: bool = declaration_is_valid && parameter_is_valid;
    if (!records_are_valid || !argument_is_valid) {
        return false;
    }
    let maps_are_valid: bool = moved.instance_for_type(GenericProbe.type_result as usize) == created.instance_id &&
        moved.instance_for_function(GenericProbe.function_id as usize) == created.instance_id;
    let moved_state_is_valid: bool = moved.is_valid() && moved.error() == runtime::Error.none;
    if (!maps_are_valid || !moved_state_is_valid) {
        return false;
    }
    return generic_table_failure_is_sticky(declaration);
}

fn semantic_diagnostic_flow_is_valid() -> bool {
    let source: string_views::string_view_result = string_views::from_c_string(
        "module tests.semantic_diagnostic_probe;\n@align(3) struct Bad {\n    value: i32;\n}\n"
        "fn main() -> i32 {\n    return missing_fn();\n}\n", 256);
    let path: string_views::string_view_result = string_views::from_c_string("semantic-diagnostic-probe.la", 64);
    if (source.error != runtime::Error.none || path.error != runtime::Error.none) {
        return false;
    }
    let frontend: parser::FrontendResult = parser::frontend_parse(source.view);
    let frontend_view: parser::FrontendView = frontend.view();
    let frontend_has_diagnostics: bool = !frontend_view.lex.diagnostics.empty() ||
        !frontend_view.parse.diagnostics.empty();
    if (frontend_view.error != runtime::Error.none || frontend_has_diagnostics) {
        return false;
    }
    var input: context::Input = context::Input(true);
    let unit: context::Unit = {
        source = source.view, tokens = frontend_view.lex.tokens, tree = frontend_view.parse.tree,
        path_offset = 0, path_length = 0,
    };
    if (input.add(unit, path.view) != runtime::Error.none) {
        return false;
    }
    let semantic: context::SemanticResult = sema::check(input.view());
    if (semantic.error != runtime::Error.none || semantic.diagnostics.size() < 2) {
        return false;
    }
    let diagnostics: context::DiagnosticView = semantic.diagnostics.view();
    var alignment_was_reported: bool = false;
    var unknown_name_was_reported: bool = false;
    for (var index: usize = 0; index < diagnostics.size(); index += 1) {
        let result: context::DiagnosticResult = diagnostics.get(index);
        if (result.error != runtime::Error.none) {
            return false;
        }
        if (result.diagnostic.kind == context::DiagnosticKind.invalid_alignment) {
            alignment_was_reported = true;
        }
        if (result.diagnostic.kind == context::DiagnosticKind.unknown_name) {
            unknown_name_was_reported = true;
        }
    }
    return alignment_was_reported && unknown_name_was_reported;
}

fn main() -> i32 {
    if (!class_table_move_is_valid()) {
        return 32;
    }
    if (!generic_table_move_is_valid()) {
        return 33;
    }
    if (!semantic_diagnostic_flow_is_valid()) {
        return 34;
    }
    let source: string_views::string_view_result = string_views::from_c_string(
        "module tests.relocation_probe;\nextern fn dispatch_target() -> i32;\n", 96);
    let path: string_views::string_view_result = string_views::from_c_string("relocation-probe.la", 32);
    if (source.error != runtime::Error.none || path.error != runtime::Error.none) {
        return 1;
    }
    let frontend: parser::FrontendResult = parser::frontend_parse(source.view);
    let frontend_view: parser::FrontendView = frontend.view();
    let frontend_has_diagnostics: bool = !frontend_view.lex.diagnostics.empty() ||
        !frontend_view.parse.diagnostics.empty();
    if (frontend_view.error != runtime::Error.none || frontend_has_diagnostics) {
        return 2;
    }
    var prepared_input: context::Input = context::Input(false);
    let unit: context::Unit = {
        source = source.view, tokens = frontend_view.lex.tokens, tree = frontend_view.parse.tree,
        path_offset = 0, path_length = 0,
    };
    if (prepared_input.add(unit, path.view) != runtime::Error.none) {
        return 3;
    }
    var input: context::Input = utility::move(prepared_input);
    let input_move_is_valid: bool = input.is_valid() && prepared_input.storage_is_valid();
    if (!input_move_is_valid || prepared_input.size() != 0) {
        return 31;
    }
    let input_view: context::InputView = input.view();
    var semantic: context::SemanticResult = sema::check(input_view);
    if (!context::result_is_success(semantic)) {
        return 26;
    }
    if (semantic.ir.view().function_count != 1) {
        return 28;
    }

    var ir_builder: ir::Builder = ir::Builder(utility::move(semantic.ir));

    let placeholder: [24]u8 = {};
    let global_id: usize = ir_builder.add_global(
        &placeholder[0] as *const u8, ProbeLayout.byte_count as usize,
        ProbeLayout.address_bytes as usize, true);
    if (global_id == ir::no_id()) {
        return 5;
    }
    if (!ir_builder.add_global_function_reference(global_id, 0, 0)) {
        return 6;
    }
    if (!ir_builder.add_global_function_reference(global_id, ProbeLayout.second_address_offset as usize, 0)) {
        return 7;
    }
    let descriptor_placeholder: [ProbeLayout.address_bytes]u8 = {};
    let base_descriptor: usize = ir_builder.add_global(
        &descriptor_placeholder[0] as *const u8,
        ProbeLayout.address_bytes as usize, ProbeLayout.address_bytes as usize, true);
    let derived_descriptor: usize = ir_builder.add_global(
        &descriptor_placeholder[0] as *const u8,
        ProbeLayout.address_bytes as usize, ProbeLayout.address_bytes as usize, true);
    if (base_descriptor == ir::no_id() || derived_descriptor == ir::no_id()) {
        return 8;
    }
    if (!ir_builder.add_global_reference(derived_descriptor, 0, base_descriptor)) {
        return 9;
    }
    var built_ir: ir::Module = ir_builder.take_module();
    if (ir_builder.is_valid()) {
        return 23;
    }
    if (!built_ir.is_valid(semantic.types)) {
        return 10;
    }

    let references: *ir::GlobalReference = built_ir.global_reference_data();
    references[1].byte_offset = 4;
    if (built_ir.is_valid(semantic.types)) {
        return 11;
    }
    references[1].byte_offset = ProbeLayout.second_address_offset as usize;
    built_ir.global_bytes_data()[0] = 1;
    if (built_ir.is_valid(semantic.types)) {
        return 12;
    }
    built_ir.global_bytes_data()[0] = 0;
    references[0].target_id = ir::no_id();
    if (built_ir.is_valid(semantic.types)) {
        return 13;
    }
    references[0].target_id = 0;
    references[2].target_id = ir::no_id();
    if (built_ir.is_valid(semantic.types)) {
        return 14;
    }
    references[2].target_id = base_descriptor;

    let empty_backend: codegen::BackendResult = codegen::backend_empty();
    if (codegen::backend_is_success(empty_backend, input_view, built_ir, semantic.types)) {
        return 15;
    }
    if (codegen::backend_release(empty_backend) != runtime::Error.none) {
        return 16;
    }

    references[0].target_id = ir::no_id();
    let rejected_backend: codegen::BackendResult = codegen::emit_assembly(input_view, built_ir, semantic.types);
    let rejected_storage_is_valid: bool = bytes::is_valid(rejected_backend.assembly) &&
        rejected_backend.assembly.length == 0;
    let rejected_result_is_valid: bool = rejected_backend.error == runtime::Error.invalid_argument &&
        rejected_storage_is_valid;
    if (!rejected_result_is_valid ||
        codegen::backend_is_success(rejected_backend, input_view, built_ir, semantic.types)) {
        return 17;
    }
    if (codegen::backend_release(rejected_backend) != runtime::Error.none) {
        return 18;
    }
    references[0].target_id = 0;

    let first_backend: codegen::BackendResult = codegen::emit_assembly(input_view, built_ir, semantic.types);
    let second_backend: codegen::BackendResult = codegen::emit_assembly(input_view, built_ir, semantic.types);
    let first_is_valid: bool = codegen::backend_is_success(first_backend, input_view, built_ir, semantic.types);
    let second_is_valid: bool = codegen::backend_is_success(second_backend, input_view, built_ir, semantic.types);
    if (!first_is_valid || !second_is_valid) {
        return 19;
    }
    if (!bytes::equal(first_backend.assembly, second_backend.assembly.data as *const u8,
            second_backend.assembly.length)) {
        return 20;
    }
    if (pattern_count(first_backend.assembly.data as *const u8, first_backend.assembly.length,
            "    .quad dispatch_target\n", 26) != 2) {
        return 21;
    }

    var release_error: runtime::Error = codegen::backend_release(second_backend);
    release_error = first_error(release_error, codegen::backend_release(first_backend));
    return release_error == runtime::Error.none ? 42 : 22;
}
