export module luna.tools.cli;

import luna.runtime;

export enum Command: usize {
    invalid, help, version, compile, assemble, link,
}

export fn argument_equals(argument: *const u8, expected: *const u8, length: usize) -> bool;
export fn command(argument: *const u8) -> Command;
export fn first_error(current: runtime::Error, next: runtime::Error) -> runtime::Error;
export fn starts_with_dash(argument: *const u8) -> bool;
export fn print(file: runtime::File, data: *const u8) -> runtime::Error;
