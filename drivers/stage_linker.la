module luna.tools.bootstrap.stage_linker;

import luna.bootstrap.backend.x86_64.elf as elf;
import luna.bootstrap.backend.x86_64.linker as linker;
import luna.bootstrap.backend.x86_64.object as object;
import luna.bootstrap.backend.x86_64.text as asm_text;
import luna.runtime;
import luna.std.bytes;
import luna.std.io;
import luna.std.path as path;
import luna.std.text as text;

enum BootstrapStageLimit: usize {
    maximum_inputs = 64, maximum_path_bytes = 4096, maximum_object = 268435456,
}

enum BootstrapStageStatus: i32 {
    input_error = 1, object_error = 2, link_error = 3, output_error = 4, release_error = 5, success = 42,
    cli_usage_error = 125,
}

fn bootstrap_stage_driver_invalid_path(error: runtime::Error) -> path::PathResult {
    return {
        path = {
            storage = bytes::empty(), length = 0,
        }, error = error,
    };
}

fn bootstrap_stage_driver_input_path(index: usize) -> path::PathResult {
    var text: asm_text::Text = asm_text::empty();
    if (!asm_text::append_c_string(&text, "bootstrap-link-input-", 32) ||
        !asm_text::append_usize(&text, index) ||
        !asm_text::append_c_string(
            &text, ".lo", 8)) {
        let error: runtime::Error = text.error == runtime::Error.none ? runtime::Error.invalid_argument : text.error;
        asm_text::release(text);
        return bootstrap_stage_driver_invalid_path(error);
    }
    let bytes: bytes::BufferResult = asm_text::take(&text);
    if (bytes.error != runtime::Error.none) {
        asm_text::release(text);
        return bootstrap_stage_driver_invalid_path(bytes.error);
    }
    let view: text::ViewResult = text::view(bytes.buffer.data as *const u8, bytes.buffer.length);
    var result: path::PathResult = bootstrap_stage_driver_invalid_path(view.error);
    if (view.error == runtime::Error.none) {
        result = path::from_text(view.view);
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    if (result.error == runtime::Error.none && release_error != runtime::Error.none) {
        path::release(result.path);
        return bootstrap_stage_driver_invalid_path(release_error);
    }
    return result;
}

fn bootstrap_stage_driver_parse(data: *const u8, length: usize) -> object::Result {
    if (length >= 4 && data[0] == 127 && data[1] == 69 && data[2] == 76 && data[3] == 70) {
        return elf::load(data, length);
    }
    return object::deserialize(data, length);
}

fn bootstrap_stage_driver_release_objects(objects: *object::Object, count: usize) -> runtime::Error {
    var error: runtime::Error = runtime::Error.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: runtime::Error = object::release(objects[index]);
        if (error == runtime::Error.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_driver_run(
    fixed_protocol: bool, input_paths: *const path::Path, input_count: usize, output_path: path::Path) -> i32 {
    if ((!fixed_protocol && (input_paths == null || input_count == 0 || input_count > BootstrapStageLimit
                        .maximum_inputs as usize)) || !path::is_valid(output_path)) {
        return BootstrapStageStatus.input_error as i32;
    }
    var objects: [64]object::Object = {};
    var count: usize = 0;
    let expected_count: usize = fixed_protocol ? BootstrapStageLimit.maximum_inputs as usize : input_count;
    while (count < expected_count) {
        var path: path::PathResult = bootstrap_stage_driver_invalid_path(runtime::Error.none);
        if (fixed_protocol) {
            path = bootstrap_stage_driver_input_path(count);
            if (path.error != runtime::Error.none) {
                bootstrap_stage_driver_release_objects(&objects[0], count);
                return BootstrapStageStatus.input_error as i32;
            }
        }
        let input_path: path::Path = fixed_protocol ? path.path : input_paths[count];
        let bytes: bytes::BufferResult =
            io::read_file_limited(input_path, BootstrapStageLimit.maximum_object as usize);
        var path_error: runtime::Error = runtime::Error.none;
        if (fixed_protocol) {
            path_error = path::release(path.path);
        }
        if (fixed_protocol && bytes.error == runtime::Error.not_found) {
            if (path_error != runtime::Error.none) {
                bootstrap_stage_driver_release_objects(&objects[0], count);
                return BootstrapStageStatus.release_error as i32;
            }
            break;
        }
        if (bytes.error != runtime::Error.none || path_error != runtime::Error.none) {
            if (bytes.error == runtime::Error.none) {
                bytes::release(bytes.buffer);
            }
            bootstrap_stage_driver_release_objects(&objects[0], count);
            return BootstrapStageStatus.input_error as i32;
        }
        let parsed: object::Result =
            bootstrap_stage_driver_parse(bytes.buffer.data as *const u8, bytes.buffer.length);
        let bytes_error: runtime::Error = bytes::release(bytes.buffer);
        if (parsed.error != runtime::Error.none || bytes_error != runtime::Error.none) {
            if (parsed.error == runtime::Error.none) {
                object::release(parsed.object);
            }
            bootstrap_stage_driver_release_objects(&objects[0], count);
            return BootstrapStageStatus.object_error as i32;
        }
        objects[count] = parsed.object;
        count += 1;
    }
    if (fixed_protocol && count == BootstrapStageLimit.maximum_inputs as usize) {
        let excess_path: path::PathResult = bootstrap_stage_driver_input_path(count);
        if (excess_path.error != runtime::Error.none) {
            bootstrap_stage_driver_release_objects(&objects[0], count);
            return BootstrapStageStatus.input_error as i32;
        }
        let excess: bytes::BufferResult = io::read_file_limited(excess_path.path, 0);
        let excess_path_error: runtime::Error = path::release(excess_path.path);
        if (excess.error == runtime::Error.none) {
            bytes::release(excess.buffer);
        }
        if (excess.error != runtime::Error.not_found || excess_path_error != runtime::Error.none) {
            bootstrap_stage_driver_release_objects(&objects[0], count);
            return BootstrapStageStatus.input_error as i32;
        }
    }
    if (count == 0) {
        return BootstrapStageStatus.input_error as i32;
    }
    let linked: linker::Result = linker::link(&objects[0] as *const object::Object, count);
    if (linked.error != runtime::Error.none) {
        bootstrap_stage_driver_release_objects(&objects[0], count);
        return BootstrapStageStatus.link_error as i32;
    }
    let write_error: runtime::Error =
        io::write_executable_file_atomic(output_path, linked.executable.data as *const u8, linked.executable.length);
    let executable_error: runtime::Error = bytes::release(linked.executable);
    let objects_error: runtime::Error = bootstrap_stage_driver_release_objects(&objects[0], count);
    if (write_error != runtime::Error.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    if (executable_error != runtime::Error.none || objects_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return BootstrapStageStatus.success as i32;
}

fn bootstrap_stage_argument_equals(argument: *const u8, expected: *const u8, length: usize) -> bool {
    if (argument == null || expected == null) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (argument[index] != expected[index] || argument[index] == 0) {
            return false;
        }
        index += 1;
    }
    return argument[length] == 0;
}

fn bootstrap_stage_print(file: runtime::File, data: *const u8) -> runtime::Error {
    let text: text::ViewResult = text::from_c_string(data, 512);
    if (text.error != runtime::Error.none) {
        return text.error;
    }
    return io::write_all(file, text.view.data, text.view.length);
}

fn bootstrap_stage_usage() -> i32 {
    bootstrap_stage_print(runtime::standard_error(), "usage: luna-link -o <executable> <input.lo>...\n");
    return BootstrapStageStatus.cli_usage_error as i32;
}

fn bootstrap_stage_release_paths(paths: *path::Path, count: usize) -> runtime::Error {
    if (paths == null || count > BootstrapStageLimit.maximum_inputs as usize) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = runtime::Error.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: runtime::Error = path::release(paths[index]);
        if (error == runtime::Error.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_cli_main(argc: usize, argv: **const u8) -> i32 {
    if (argv == null || argc < 2) {
        return bootstrap_stage_usage();
    }
    if (argc == 2 &&
        bootstrap_stage_argument_equals(
            argv[1], "--help", 6)) {
        bootstrap_stage_print(runtime::standard_output(), "usage: luna-link -o <executable> <input.lo>...\n");
        return 0;
    }
    if (argc == 2 &&
        bootstrap_stage_argument_equals(
            argv[1], "--version", 9)) {
        bootstrap_stage_print(runtime::standard_output(), "luna-link (self-hosted Luna 1) 0.1.0\n");
        return 0;
    }

    var inputs: [64]path::Path = {};
    var input_count: usize = 0;
    var output: path::Path = {};
    var has_output: bool = false;
    var options_finished: bool = false;
    var valid: bool = true;
    var index: usize = 1;
    while (index < argc && valid) {
        let argument: *const u8 = argv[index];
        if (!options_finished &&
            bootstrap_stage_argument_equals(
                argument, "--", 2)) {
            options_finished = true;
        } else if (!options_finished &&
            bootstrap_stage_argument_equals(
                argument, "-o", 2)) {
            if (has_output || index + 1 >= argc) {
                valid = false;
            } else {
                index += 1;
                let path: path::PathResult =
                    path::from_c_string(argv[index], BootstrapStageLimit.maximum_path_bytes as usize);
                if (path.error != runtime::Error.none) {
                    valid = false;
                } else {
                    output = path.path;
                    has_output = true;
                }
            }
        } else if (!options_finished && argument != null && argument[0] == 45) {
            valid = false;
        } else if (input_count == BootstrapStageLimit.maximum_inputs as usize) {
            valid = false;
        } else {
            let path: path::PathResult =
                path::from_c_string(argument, BootstrapStageLimit.maximum_path_bytes as usize);
            if (path.error != runtime::Error.none) {
                valid = false;
            } else {
                inputs[input_count] = path.path;
                input_count += 1;
            }
        }
        index += 1;
    }
    if (!has_output || input_count == 0) {
        valid = false;
    }
    if (valid) {
        let output_text: text::ViewResult = path::text(output);
        index = 0;
        while (index < input_count && valid) {
            let input_text: text::ViewResult = path::text(inputs[index]);
            valid = output_text.error == runtime::Error.none && input_text.error == runtime::Error.none &&
                !text::equal(output_text.view, input_text.view);
            index += 1;
        }
    }

    var status: i32 = BootstrapStageStatus.cli_usage_error as i32;
    if (valid) {
        status = bootstrap_stage_driver_run(false, &inputs[0] as *const path::Path, input_count, output);
        if (status == BootstrapStageStatus.success as i32) {
            status = 0;
        }
    } else {
        bootstrap_stage_usage();
    }
    let input_error: runtime::Error = bootstrap_stage_release_paths(&inputs[0], input_count);
    var output_error: runtime::Error = runtime::Error.none;
    if (has_output) {
        output_error = path::release(output);
    }
    if (status == 0 && (input_error != runtime::Error.none || output_error != runtime::Error.none)) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}

fn main(argc: usize, argv: **const u8) -> i32 {
    if (argc != 1) {
        return bootstrap_stage_cli_main(argc, argv);
    }
    let output: path::PathResult = path::from_c_string("bootstrap-link-output", 22);
    if (output.error != runtime::Error.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    let status: i32 = bootstrap_stage_driver_run(true, null, 0, output.path);
    let release_error: runtime::Error = path::release(output.path);
    if (status == BootstrapStageStatus.success as i32 && release_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}

