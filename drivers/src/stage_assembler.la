module luna.tools.assemble;

import luna.compiler.x86.assembler as assembler;
import luna.compiler.x86.elf as elf;
import luna.compiler.x86.object as object;
import luna.runtime;
import luna.std.bytes;
import luna.std.io;
import luna.std.path as path;
import luna.std.text as text;
import luna.tools.cli as cli;

enum BootstrapStageLimit: usize {
    maximum_path_bytes = 4096, maximum_input = 67108864,
}

enum BootstrapStageStatus: i32 {
    input_error = 1, assembly_error = 2, serialization_error = 3, output_error = 4, release_error = 5, success = 42,
    cli_usage_error = 125,
}

fn bootstrap_stage_driver_report(line: usize) -> runtime::Error {
    var digits: [20]u8 = {};
    var cursor: usize = 20;
    var value: usize = line;
    if (value == 0) {
        cursor -= 1;
        digits[cursor] = 48;
    }
    for (; value != 0;) {
        cursor -= 1;
        digits[cursor] = ((48 as usize) + value % 10) as u8;
        value /= 10;
    }
    var error: runtime::Error = io::write_all(runtime::standard_error(), "assembler:", 10);
    if (error == runtime::Error.none) {
        error = io::write_all(runtime::standard_error(), &digits[cursor] as *const u8, 20 - cursor);
    }
    if (error == runtime::Error.none) {
        error = io::write_all(runtime::standard_error(), "\n", 1);
    }
    return error;
}

fn bootstrap_stage_driver_run(input_path: path::Path, output_path: path::Path, emit_elf: bool) -> i32 {
    if (!path::is_valid(input_path) || !path::is_valid(output_path)) {
        return BootstrapStageStatus.input_error as i32;
    }
    let input: bytes::BufferResult = io::read_file_limited(input_path, BootstrapStageLimit.maximum_input as usize);
    if (input.error != runtime::Error.none) {
        return BootstrapStageStatus.input_error as i32;
    }
    let view: text::ViewResult = text::view(input.buffer.data as *const u8, input.buffer.length);
    if (view.error != runtime::Error.none) {
        bytes::release(input.buffer);
        return BootstrapStageStatus.input_error as i32;
    }
    let assembled: assembler::Result = assembler::assemble(view.view);
    if (assembled.error != runtime::Error.none) {
        bootstrap_stage_driver_report(assembled.line);
        bytes::release(input.buffer);
        return BootstrapStageStatus.assembly_error as i32;
    }
    let serialized: bytes::BufferResult = emit_elf ? elf::save(assembled.object) : object::serialize(assembled.object);
    if (serialized.error != runtime::Error.none) {
        object::release(assembled.object);
        bytes::release(input.buffer);
        return BootstrapStageStatus.serialization_error as i32;
    }
    let write_error: runtime::Error = io::write_file_atomic(
        output_path, serialized.buffer.data as *const u8, serialized.buffer.length);
    let serialized_error: runtime::Error = bytes::release(serialized.buffer);
    let object_error: runtime::Error = object::release(assembled.object);
    let input_error: runtime::Error = bytes::release(input.buffer);
    if (write_error != runtime::Error.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    var release_error: runtime::Error = cli::first_error(serialized_error, object_error);
    release_error = cli::first_error(release_error, input_error);
    if (release_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return BootstrapStageStatus.success as i32;
}

fn bootstrap_stage_usage() -> i32 {
    cli::print(runtime::standard_error(), "usage: luna assemble [--emit elf|lunaobj] -o <output> <input.s>\n");
    return BootstrapStageStatus.cli_usage_error as i32;
}

fn bootstrap_stage_cli_main(argc: usize, argv: **const u8) -> i32 {
    if (argv == null || argc < 2) {
        return bootstrap_stage_usage();
    }
    if (argc == 2 &&
        cli::argument_equals(
            argv[1], "--help", 6)) {
        cli::print(runtime::standard_output(), "usage: luna assemble [--emit elf|lunaobj] -o <output> <input.s>\n");
        return 0;
    }
    if (argc == 2 &&
        cli::argument_equals(
            argv[1], "--version", 9)) {
        cli::print(runtime::standard_output(), "luna assemble (self-hosted Luna 1) 0.1.0\n");
        return 0;
    }

    var input: path::Path = {};
    var output: path::Path = {};
    var has_input: bool = false;
    var has_output: bool = false;
    var has_emit: bool = false;
    var emit_elf: bool = false;
    var options_finished: bool = false;
    var valid: bool = true;
    var index: usize = 1;
    for (; index < argc && valid; index += 1) {
        let argument: *const u8 = argv[index];
        if (!options_finished &&
            cli::argument_equals(
                argument, "--", 2)) {
            options_finished = true;
        } else if (!options_finished &&
            cli::argument_equals(
                argument, "--emit", 6)) {
            if (has_emit || index + 1 >= argc) {
                valid = false;
            } else {
                index += 1;
                if (cli::argument_equals(argv[index], "elf", 3)) {
                    emit_elf = true;
                    has_emit = true;
                } else if (cli::argument_equals(argv[index], "lunaobj", 7)) {
                    has_emit = true;
                } else {
                    valid = false;
                }
            }
        } else if (!options_finished &&
            cli::argument_equals(
                argument, "-o", 2)) {
            if (has_output || index + 1 >= argc) {
                valid = false;
            } else {
                index += 1;
                let path: path::PathResult =
                    path::from_c_string(argv[index], BootstrapStageLimit.maximum_path_bytes as usize);
                if (path.error != runtime::Error.none) {
                    valid = false;
                } else {
                    output = path.path;
                    has_output = true;
                }
            }
        } else if (!options_finished && cli::starts_with_dash(argument)) {
            valid = false;
        } else if (has_input) {
            valid = false;
        } else {
            let path: path::PathResult = path::from_c_string(argument, BootstrapStageLimit.maximum_path_bytes as usize);
            if (path.error != runtime::Error.none) {
                valid = false;
            } else {
                input = path.path;
                has_input = true;
            }
        }
    }
    if (!has_input || !has_output) {
        valid = false;
    }
    if (valid) {
        let input_text: text::ViewResult = path::text(input);
        let output_text: text::ViewResult = path::text(output);
        let paths_are_readable: bool = input_text.error == runtime::Error.none &&
            output_text.error == runtime::Error.none;
        valid = paths_are_readable && !text::equal(input_text.view, output_text.view);
    }

    var status: i32 = BootstrapStageStatus.cli_usage_error as i32;
    if (valid) {
        status = bootstrap_stage_driver_run(input, output, emit_elf);
        if (status == BootstrapStageStatus.success as i32) {
            status = 0;
        }
    } else {
        bootstrap_stage_usage();
    }
    var release_error: runtime::Error = runtime::Error.none;
    if (has_input) {
        release_error = path::release(input);
    }
    if (has_output) {
        let output_error: runtime::Error = path::release(output);
        if (release_error == runtime::Error.none) {
            release_error = output_error;
        }
    }
    if (status == 0 && release_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}

fn run(argc: usize, argv: **const u8) -> i32 {
    if (argc != 1) {
        return bootstrap_stage_cli_main(argc, argv);
    }
    let input: path::PathResult = path::from_c_string("bootstrap-assembly-input.s", 27);
    if (input.error != runtime::Error.none) {
        return BootstrapStageStatus.input_error as i32;
    }
    let output: path::PathResult = path::from_c_string("bootstrap-object-output.lo", 27);
    if (output.error != runtime::Error.none) {
        path::release(input.path);
        return BootstrapStageStatus.output_error as i32;
    }
    let status: i32 = bootstrap_stage_driver_run(input.path, output.path, false);
    let input_error: runtime::Error = path::release(input.path);
    let output_error: runtime::Error = path::release(output.path);
    let release_error: runtime::Error = cli::first_error(input_error, output_error);
    if (status == BootstrapStageStatus.success as i32 && release_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}
