module luna.tools;

import luna.runtime;
import luna.tools.assemble as assemble;
import luna.tools.cli as cli;
import luna.tools.compile as compile;
import luna.tools.link as link;

enum Status: i32 {
    cli_usage_error = 125,
}

fn usage(file: runtime::File) -> i32 {
    cli::print(file, "usage: luna <compile|assemble|link> [options]\n");
    return Status.cli_usage_error as i32;
}

fn help() -> i32 {
    cli::print(
        runtime::standard_output(), "usage: luna <command> [options]\n"
        "commands:\n"
        "  compile   lower Luna source to assembly\n"
        "  assemble  encode assembly into an object\n"
        "  link      link objects into an executable\n");
    return 0;
}

fn version() -> i32 {
    cli::print(runtime::standard_output(), "luna (self-hosted Luna 1) 0.1.0\n");
    return 0;
}

fn main(argc: usize, argv: **const u8) -> i32 {
    if (argv == null || argc < 2) {
        return usage(runtime::standard_error());
    }
    let command: cli::Command = cli::command(argv[1]);
    switch (command) {
    case cli::Command.help {
        return argc == 2 ? help() : usage(runtime::standard_error());
    }
    case cli::Command.version {
        return argc == 2 ? version() : usage(runtime::standard_error());
    }
    case cli::Command.compile {
        return compile::run(argc - 1, argv + (1 as usize));
    }
    case cli::Command.assemble {
        return assemble::run(argc - 1, argv + (1 as usize));
    }
    case cli::Command.link {
        return link::run(argc - 1, argv + (1 as usize));
    }
    default {
        return usage(runtime::standard_error());
    }
    }
}
