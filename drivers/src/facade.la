module luna.tools;

enum Status: i32 {
    cli_usage_error = 125,
}

class ToolDriver {
    priv arguments: CommandLine;

    pub init(argc: usize, argv: **const u8);
    pub fn execute() -> i32;
}

impl ToolDriver {
    init(argc: usize, argv: **const u8): arguments = CommandLine(argc, argv) {
    }

    priv fn usage(file: runtime::File) -> i32 {
        print(file, "usage: luna <compile|assemble|link> [options]\n");
        return Status.cli_usage_error as i32;
    }

    priv fn help() -> i32 {
        print(
            runtime::standard_output(), "usage: luna <command> [options]\n"
            "commands:\n"
            "  compile   lower Luna source to assembly\n"
            "  assemble  encode assembly into an object\n"
            "  link      link objects into an executable\n");
        return 0;
    }

    priv fn version() -> i32 {
        print(runtime::standard_output(), "luna (self-hosted Luna 1) 0.1.0\n");
        return 0;
    }

    fn execute() -> i32 {
        if (!this->arguments.is_valid() || this->arguments.count() < 2) {
            return this->usage(runtime::standard_error());
        }
        let selected: Command = command(this->arguments.current());
        let argc: usize = this->arguments.count();
        let argv: **const u8 = this->arguments.data();
        switch (selected) {
        case Command.help {
            return argc == 2 ? this->help() : this->usage(runtime::standard_error());
        }
        case Command.version {
            return argc == 2 ? this->version() : this->usage(runtime::standard_error());
        }
        case Command.compile {
            return run_compile(argc - 1, argv + (1 as usize));
        }
        case Command.assemble {
            return run_assemble(argc - 1, argv + (1 as usize));
        }
        case Command.link {
            return run_link(argc - 1, argv + (1 as usize));
        }
        default {
            return this->usage(runtime::standard_error());
        }
        }
    }
}

fn run(argc: usize, argv: **const u8) -> i32 {
    var driver: ToolDriver = ToolDriver(argc, argv);
    return driver.execute();
}
