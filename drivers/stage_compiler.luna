module luna.tools.bootstrap.stage_compiler;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;
import luna.std.path;
import luna.std.io;
import luna.bootstrap.frontend.lexer;
import luna.bootstrap.frontend.parser;
import luna.bootstrap.middleend.type;
import luna.bootstrap.middleend.ir;
import luna.bootstrap.middleend.sema;
import luna.bootstrap.backend.x86_64.text;
import luna.bootstrap.backend.x86_64.abi;
import luna.bootstrap.backend.x86_64.frame;
import luna.bootstrap.backend.x86_64.codegen;

enum BootstrapStageLimit: usize {
    maximum_units = 64,
    maximum_path_bytes = 4096,
    maximum_source_bytes = 8388608,
    maximum_total_source_bytes = 33554432,
    maximum_frontend_diagnostics = 4096,
    maximum_semantic_diagnostics = 4096,
}

enum BootstrapStageStatus: i32 {
    mode_error = 1,
    input_error = 2,
    unit_limit = 3,
    semantic_error = 4,
    backend_error = 5,
    output_error = 6,
    release_error = 7,
    resource_limit = 8,
    version_error = 9,
    semantic_diagnostic_base = 64,
    success = 42,
    cli_usage_error = 125,
}

fn bootstrap_stage_invalid_path_result(
    error: RuntimeError
) -> StdPathResult {
    return {
        path = {
            storage = std_byte_buffer_empty(),
            length = 0,
        },
        error = error,
    };
}

fn bootstrap_stage_unit_path(index: usize) -> StdPathResult {
    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(
            &text,
            "bootstrap-stage-unit-",
            32
        ) ||
        !bootstrap_x86_64_text_append_usize(&text, index) ||
        !bootstrap_x86_64_text_append_c_string(
            &text,
            ".luna",
            8
        )) {
        let error: RuntimeError =
            text.error == RuntimeError.none ?
                RuntimeError.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return bootstrap_stage_invalid_path_result(error);
    }
    let bytes: StdByteBufferResult =
        bootstrap_x86_64_text_take(&text);
    if (bytes.error != RuntimeError.none) {
        bootstrap_x86_64_text_release(text);
        return bootstrap_stage_invalid_path_result(bytes.error);
    }
    let view: StdTextViewResult = std_text_view(
        bytes.buffer.data as *const u8,
        bytes.buffer.length
    );
    var result: StdPathResult =
        bootstrap_stage_invalid_path_result(view.error);
    if (view.error == RuntimeError.none) {
        result = std_path_from_text(view.view);
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    if (result.error == RuntimeError.none &&
        release_error != RuntimeError.none) {
        std_path_release(result.path);
        return bootstrap_stage_invalid_path_result(release_error);
    }
    return result;
}

fn bootstrap_stage_read_mode(
    executable: *bool
) -> RuntimeError {
    if (executable == null) {
        return RuntimeError.invalid_argument;
    }
    let path: StdPathResult =
        std_path_from_c_string("bootstrap-stage-mode", 32);
    if (path.error != RuntimeError.none) {
        return path.error;
    }
    let bytes: StdByteBufferResult =
        std_io_read_file_limited(path.path, 2);
    let path_error: RuntimeError =
        std_path_release(path.path);
    if (bytes.error != RuntimeError.none) {
        return bytes.error;
    }
    var error: RuntimeError = path_error;
    if (error == RuntimeError.none) {
        if (bytes.buffer.length != 2 ||
            bytes.buffer.data[1] != 10) {
            error = RuntimeError.invalid_argument;
        } else if (bytes.buffer.data[0] == 69) {
            *executable = true;
        } else if (bytes.buffer.data[0] == 76) {
            *executable = false;
        } else {
            error = RuntimeError.invalid_argument;
        }
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    return error == RuntimeError.none ? release_error : error;
}

fn bootstrap_stage_read_version() -> RuntimeError {
    let path: StdPathResult =
        std_path_from_c_string("bootstrap-stage-version", 32);
    if (path.error != RuntimeError.none) {
        return path.error;
    }
    let bytes: StdByteBufferResult =
        std_io_read_file_limited(path.path, 20);
    let path_error: RuntimeError =
        std_path_release(path.path);
    if (bytes.error != RuntimeError.none) {
        return bytes.error;
    }
    var error: RuntimeError = path_error;
    if (error == RuntimeError.none &&
        !std_byte_buffer_equal(
            bytes.buffer,
            "LUNA-STAGE/1 LUNA/1\n",
            20
        )) {
        error = RuntimeError.invalid_argument;
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    return error == RuntimeError.none ? release_error : error;
}

fn bootstrap_stage_source_release(
    source: StdByteBuffer,
    frontend: BootstrapFrontendResult
) -> RuntimeError {
    var error: RuntimeError =
        bootstrap_frontend_result_release(frontend);
    let source_error: RuntimeError =
        std_byte_buffer_release(source);
    if (error == RuntimeError.none) {
        error = source_error;
    }
    return error;
}

fn bootstrap_stage_sources_release(
    sources: *StdByteBuffer,
    frontends: *BootstrapFrontendResult,
    count: usize
) -> RuntimeError {
    if (sources == null || frontends == null ||
        count > BootstrapStageLimit.maximum_units as usize) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError = RuntimeError.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: RuntimeError =
            bootstrap_stage_source_release(
                sources[index],
                frontends[index]
            );
        if (error == RuntimeError.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_source_load(
    path: StdPath,
    result_source: *StdByteBuffer,
    result_frontend: *BootstrapFrontendResult
) -> RuntimeError {
    if (!std_path_is_valid(path) ||
        result_source == null || result_frontend == null) {
        return RuntimeError.invalid_argument;
    }
    let source: StdByteBufferResult =
        std_io_read_file_limited(
            path,
            BootstrapStageLimit.maximum_source_bytes as usize
        );
    if (source.error != RuntimeError.none) {
        return source.error;
    }
    let view: StdTextViewResult = std_text_view(
        source.buffer.data as *const u8,
        source.buffer.length
    );
    if (view.error != RuntimeError.none) {
        std_byte_buffer_release(source.buffer);
        return view.error;
    }
    let frontend: BootstrapFrontendResult =
        bootstrap_frontend_parse(view.view);
    *result_source = source.buffer;
    *result_frontend = frontend;
    return RuntimeError.none;
}

fn bootstrap_stage_frontend_diagnostic(
    frontend: BootstrapFrontendResult,
    lexical: *bool
) -> BootstrapDiagnosticResult {
    if (lexical == null) {
        return {
            diagnostic = {},
            error = RuntimeError.invalid_argument,
        };
    }
    var index: usize = 0;
    while (index < frontend.lex.diagnostics.count) {
        let diagnostic: BootstrapDiagnosticResult =
            bootstrap_diagnostic_buffer_get(
                frontend.lex.diagnostics,
                index
            );
        if (diagnostic.error != RuntimeError.none ||
            diagnostic.diagnostic.kind ==
                BootstrapDiagnosticKind.nesting_limit ||
            diagnostic.diagnostic.kind ==
                BootstrapDiagnosticKind.resource_limit) {
            *lexical = true;
            return diagnostic;
        }
        index += 1;
    }
    index = 0;
    while (index < frontend.parse.diagnostics.count) {
        let diagnostic: BootstrapDiagnosticResult =
            bootstrap_diagnostic_buffer_get(
                frontend.parse.diagnostics,
                index
            );
        if (diagnostic.error != RuntimeError.none ||
            diagnostic.diagnostic.kind ==
                BootstrapDiagnosticKind.nesting_limit ||
            diagnostic.diagnostic.kind ==
                BootstrapDiagnosticKind.resource_limit) {
            *lexical = false;
            return diagnostic;
        }
        index += 1;
    }
    if (frontend.lex.diagnostics.count != 0) {
        *lexical = true;
        return bootstrap_diagnostic_buffer_get(
            frontend.lex.diagnostics,
            0
        );
    }
    if (frontend.parse.diagnostics.count != 0) {
        *lexical = false;
        return bootstrap_diagnostic_buffer_get(
            frontend.parse.diagnostics,
            0
        );
    }
    return {
        diagnostic = {},
        error = RuntimeError.not_found,
    };
}

fn bootstrap_stage_frontend_status(
    frontend: BootstrapFrontendResult
) -> i32 {
    if (frontend.error == RuntimeError.out_of_memory) {
        return BootstrapStageStatus.resource_limit as i32;
    }
    var lexical: bool = false;
    let result: BootstrapDiagnosticResult =
        bootstrap_stage_frontend_diagnostic(
            frontend,
            &lexical
        );
    if (result.error != RuntimeError.none) {
        return BootstrapStageStatus.input_error as i32;
    }
    if (result.diagnostic.kind ==
            BootstrapDiagnosticKind.nesting_limit ||
        result.diagnostic.kind ==
            BootstrapDiagnosticKind.resource_limit) {
        return BootstrapStageStatus.resource_limit as i32;
    }
    return BootstrapStageStatus.input_error as i32;
}

fn bootstrap_stage_print_text(
    text: *BootstrapX8664Text
) -> RuntimeError {
    if (text == null) {
        return RuntimeError.invalid_argument;
    }
    let bytes: StdByteBufferResult =
        bootstrap_x86_64_text_take(text);
    if (bytes.error != RuntimeError.none) {
        bootstrap_x86_64_text_release(*text);
        return bytes.error;
    }
    let view: StdTextViewResult = std_text_view(
        bytes.buffer.data as *const u8,
        bytes.buffer.length
    );
    var error: RuntimeError = view.error;
    if (error == RuntimeError.none) {
        error = std_io_print_error(view.view);
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    return error == RuntimeError.none ? release_error : error;
}

fn bootstrap_stage_report_frontend(
    frontend: BootstrapFrontendResult
) -> RuntimeError {
    var lexical: bool = false;
    let result: BootstrapDiagnosticResult =
        bootstrap_stage_frontend_diagnostic(
            frontend,
            &lexical
        );
    if (result.error == RuntimeError.not_found) {
        return RuntimeError.none;
    }
    if (result.error != RuntimeError.none) {
        return result.error;
    }
    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(
            &text,
            lexical ? "frontend:lex:" : "frontend:parse:",
            32
        ) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            result.diagnostic.kind as usize
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            result.diagnostic.span.offset
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            result.diagnostic.detail
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: RuntimeError =
            text.error == RuntimeError.none ?
                RuntimeError.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    return bootstrap_stage_print_text(&text);
}

fn bootstrap_stage_report_resource(
    label: *const u8,
    label_maximum_length: usize,
    unit_index: usize,
    limit: usize
) -> RuntimeError {
    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(
            &text,
            "resource:",
            16
        ) ||
        !bootstrap_x86_64_text_append_c_string(
            &text,
            label,
            label_maximum_length
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            unit_index
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, limit) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: RuntimeError =
            text.error == RuntimeError.none ?
                RuntimeError.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    return bootstrap_stage_print_text(&text);
}

fn bootstrap_stage_input_add(
    input: *BootstrapSemanticInput,
    source: StdByteBuffer,
    frontend: BootstrapFrontendResult
) -> bool {
    if (input == null) {
        return false;
    }
    let view: StdTextViewResult = std_text_view(
        source.data as *const u8,
        source.length
    );
    return view.error == RuntimeError.none &&
        bootstrap_semantic_input_add(
            input,
            {
                source = view.view,
                tokens = frontend.lex.tokens,
                tree = frontend.parse.tree,
            }
        );
}

fn bootstrap_stage_semantic_status(
    semantic: BootstrapSemanticResult
) -> i32 {
    if (semantic.error == RuntimeError.out_of_memory) {
        return BootstrapStageStatus.resource_limit as i32;
    }
    if (semantic.diagnostics.count == 0) {
        return BootstrapStageStatus.semantic_error as i32;
    }
    let diagnostic: BootstrapSemanticDiagnosticResult =
        bootstrap_semantic_diagnostic_get(
            semantic.diagnostics,
            0
        );
    if (diagnostic.error != RuntimeError.none) {
        return BootstrapStageStatus.semantic_error as i32;
    }
    return BootstrapStageStatus.semantic_diagnostic_base as i32 +
        diagnostic.diagnostic.kind as usize as i32;
}

fn bootstrap_stage_report_semantic(
    semantic: BootstrapSemanticResult
) -> RuntimeError {
    if (semantic.diagnostics.count == 0) {
        return RuntimeError.none;
    }
    let diagnostic: BootstrapSemanticDiagnosticResult =
        bootstrap_semantic_diagnostic_get(
            semantic.diagnostics,
            0
        );
    if (diagnostic.error != RuntimeError.none) {
        return diagnostic.error;
    }
    var text: BootstrapX8664Text =
        bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(
            &text,
            "semantic:",
            16
        ) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.kind as usize
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.unit_index
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.span.offset
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(
            &text,
            diagnostic.diagnostic.detail
        ) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: RuntimeError =
            text.error == RuntimeError.none ?
                RuntimeError.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    let bytes: StdByteBufferResult =
        bootstrap_x86_64_text_take(&text);
    if (bytes.error != RuntimeError.none) {
        bootstrap_x86_64_text_release(text);
        return bytes.error;
    }
    let view: StdTextViewResult = std_text_view(
        bytes.buffer.data as *const u8,
        bytes.buffer.length
    );
    var error: RuntimeError = view.error;
    if (error == RuntimeError.none) {
        error = std_io_print_error(view.view);
    }
    let release_error: RuntimeError =
        std_byte_buffer_release(bytes.buffer);
    return error == RuntimeError.none ? release_error : error;
}

fn bootstrap_stage_run(
    fixed_protocol: bool,
    input_paths: *const StdPath,
    input_count: usize,
    executable: bool,
    output_path: StdPath
) -> i32 {
    if ((!fixed_protocol &&
            (input_paths == null || input_count == 0 ||
                input_count >
                    BootstrapStageLimit.maximum_units as usize)) ||
        !std_path_is_valid(output_path)) {
        return BootstrapStageStatus.input_error as i32;
    }
    var sources: [64]StdByteBuffer = {};
    var frontends: [64]BootstrapFrontendResult = {};
    var source_count: usize = 0;
    var total_source_bytes: usize = 0;
    let expected_count: usize = fixed_protocol ?
        BootstrapStageLimit.maximum_units as usize : input_count;
    while (source_count < expected_count) {
        var path: StdPathResult =
            bootstrap_stage_invalid_path_result(RuntimeError.none);
        if (fixed_protocol) {
            path = bootstrap_stage_unit_path(source_count);
            if (path.error != RuntimeError.none) {
                bootstrap_stage_sources_release(
                    &sources[0],
                    &frontends[0],
                    source_count
                );
                return BootstrapStageStatus.input_error as i32;
            }
        }
        let source_path: StdPath = fixed_protocol ?
            path.path : input_paths[source_count];
        var error: RuntimeError =
            bootstrap_stage_source_load(
                source_path,
                &sources[source_count],
                &frontends[source_count]
            );
        let source_loaded: bool = error == RuntimeError.none;
        if (fixed_protocol) {
            let path_error: RuntimeError =
                std_path_release(path.path);
            if (source_loaded &&
                path_error != RuntimeError.none) {
                bootstrap_stage_source_release(
                    sources[source_count],
                    frontends[source_count]
                );
                error = path_error;
            }
        }
        if (fixed_protocol &&
            error == RuntimeError.not_found) {
            break;
        }
        if (error != RuntimeError.none) {
            bootstrap_stage_sources_release(
                &sources[0],
                &frontends[0],
                source_count
            );
            if (error == RuntimeError.out_of_memory) {
                bootstrap_stage_report_resource(
                    "source",
                    8,
                    source_count,
                    BootstrapStageLimit.maximum_source_bytes as usize
                );
                return BootstrapStageStatus.resource_limit as i32;
            }
            return BootstrapStageStatus.input_error as i32;
        }
        source_count += 1;
        let source_length: usize =
            sources[source_count - 1].length;
        if (source_length >
            (BootstrapStageLimit.maximum_total_source_bytes as usize) -
                total_source_bytes) {
            bootstrap_stage_report_resource(
                "total",
                8,
                source_count - 1,
                BootstrapStageLimit.maximum_total_source_bytes as usize
            );
            bootstrap_stage_sources_release(
                &sources[0],
                &frontends[0],
                source_count
            );
            return BootstrapStageStatus.resource_limit as i32;
        }
        total_source_bytes += source_length;
        let frontend: BootstrapFrontendResult =
            frontends[source_count - 1];
        if (frontend.error != RuntimeError.none ||
            frontend.lex.diagnostics.count != 0 ||
            frontend.parse.diagnostics.count != 0) {
            let status: i32 =
                bootstrap_stage_frontend_status(frontend);
            var lexical: bool = false;
            let diagnostic: BootstrapDiagnosticResult =
                bootstrap_stage_frontend_diagnostic(
                    frontend,
                    &lexical
                );
            let has_resource_diagnostic: bool =
                diagnostic.error == RuntimeError.none &&
                diagnostic.diagnostic.kind ==
                    BootstrapDiagnosticKind.resource_limit;
            if (frontend.error == RuntimeError.out_of_memory &&
                !has_resource_diagnostic) {
                bootstrap_stage_report_resource(
                    "frontend",
                    16,
                    source_count - 1,
                    BootstrapStageLimit
                        .maximum_frontend_diagnostics as usize
                );
            } else {
                bootstrap_stage_report_frontend(frontend);
            }
            bootstrap_stage_sources_release(
                &sources[0],
                &frontends[0],
                source_count
            );
            return status;
        }
    }
    if (source_count == 0) {
        return BootstrapStageStatus.input_error as i32;
    }
    if (fixed_protocol && source_count ==
        BootstrapStageLimit.maximum_units as usize) {
        var excess_source: StdByteBuffer =
            std_byte_buffer_empty();
        var excess_frontend: BootstrapFrontendResult = {};
        let excess_path: StdPathResult =
            bootstrap_stage_unit_path(source_count);
        var excess_error: RuntimeError = excess_path.error;
        var excess_present: bool = false;
        if (excess_path.error == RuntimeError.none) {
            excess_error = bootstrap_stage_source_load(
                    excess_path.path,
                    &excess_source,
                    &excess_frontend
                );
            excess_present = excess_error == RuntimeError.none;
            let path_error: RuntimeError =
                std_path_release(excess_path.path);
            if (excess_error == RuntimeError.none) {
                excess_error = path_error;
            }
        }
        if (excess_present) {
            let release_error: RuntimeError =
                bootstrap_stage_source_release(
                    excess_source,
                    excess_frontend
                );
            if (excess_error == RuntimeError.none) {
                excess_error = release_error;
            }
        }
        if (excess_present ||
            excess_error != RuntimeError.not_found) {
            bootstrap_stage_sources_release(
                &sources[0],
                &frontends[0],
                source_count
            );
            return BootstrapStageStatus.unit_limit as i32;
        }
    }

    var input: BootstrapSemanticInput =
        bootstrap_semantic_input_empty(executable);
    var added: bool = true;
    var index: usize = 0;
    while (index < source_count && added) {
        added = bootstrap_stage_input_add(
            &input,
            sources[index],
            frontends[index]
        );
        index += 1;
    }
    if (!added) {
        bootstrap_semantic_input_release(input);
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
        return BootstrapStageStatus.semantic_error as i32;
    }

    let semantic: BootstrapSemanticResult =
        bootstrap_semantic_check(input);
    if (!bootstrap_semantic_result_is_success(semantic)) {
        let status: i32 =
            bootstrap_stage_semantic_status(semantic);
        if (semantic.error == RuntimeError.out_of_memory) {
            bootstrap_stage_report_resource(
                "semantic",
                16,
                0,
                BootstrapStageLimit
                    .maximum_semantic_diagnostics as usize
            );
        } else {
            bootstrap_stage_report_semantic(semantic);
        }
        bootstrap_semantic_result_release(semantic);
        bootstrap_semantic_input_release(input);
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
        return status;
    }
    let backend: BootstrapX8664BackendResult =
        bootstrap_x86_64_emit_assembly(
            input,
            semantic.ir,
            semantic.types
        );
    if (!bootstrap_x86_64_backend_is_success(
            backend,
            input,
            semantic.ir,
            semantic.types
        )) {
        let backend_status: i32 =
            backend.error == RuntimeError.out_of_memory ?
                BootstrapStageStatus.resource_limit as i32 :
                BootstrapStageStatus.backend_error as i32;
        bootstrap_x86_64_backend_release(backend);
        bootstrap_semantic_result_release(semantic);
        bootstrap_semantic_input_release(input);
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
        return backend_status;
    }

    let write_error: RuntimeError = std_io_write_file_atomic(
        output_path,
        backend.assembly.data as *const u8,
        backend.assembly.length
    );

    let backend_error: RuntimeError =
        bootstrap_x86_64_backend_release(backend);
    let semantic_error: RuntimeError =
        bootstrap_semantic_result_release(semantic);
    let input_error: RuntimeError =
        bootstrap_semantic_input_release(input);
    let sources_error: RuntimeError =
        bootstrap_stage_sources_release(
            &sources[0],
            &frontends[0],
            source_count
        );
    if (write_error != RuntimeError.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    if (backend_error != RuntimeError.none ||
        semantic_error != RuntimeError.none ||
        input_error != RuntimeError.none ||
        sources_error != RuntimeError.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return BootstrapStageStatus.success as i32;
}

fn bootstrap_stage_argument_equals(
    argument: *const u8,
    expected: *const u8,
    length: usize
) -> bool {
    if (argument == null || expected == null) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (argument[index] != expected[index] ||
            argument[index] == 0) {
            return false;
        }
        index += 1;
    }
    return argument[length] == 0;
}

fn bootstrap_stage_print_c_string(
    file: RuntimeFile,
    data: *const u8
) -> RuntimeError {
    let text: StdTextViewResult =
        std_text_from_c_string(data, 1024);
    if (text.error != RuntimeError.none) {
        return text.error;
    }
    return std_io_write_all(
        file,
        text.view.data,
        text.view.length
    );
}

fn bootstrap_stage_cli_usage() -> i32 {
    bootstrap_stage_print_c_string(
        runtime_standard_error(),
        "usage: lunac [--executable|--library] -o <output.s> <input.luna>...\n"
    );
    return BootstrapStageStatus.cli_usage_error as i32;
}

fn bootstrap_stage_release_paths(
    paths: *StdPath,
    count: usize
) -> RuntimeError {
    if (paths == null ||
        count > BootstrapStageLimit.maximum_units as usize) {
        return RuntimeError.invalid_argument;
    }
    var error: RuntimeError = RuntimeError.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: RuntimeError =
            std_path_release(paths[index]);
        if (error == RuntimeError.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_cli_main(
    argc: usize,
    argv: **const u8
) -> i32 {
    if (argv == null || argc < 2) {
        return bootstrap_stage_cli_usage();
    }
    if (argc == 2 &&
        bootstrap_stage_argument_equals(
            argv[1],
            "--help",
            6
        )) {
        bootstrap_stage_print_c_string(
            runtime_standard_output(),
            "usage: lunac [--executable|--library] -o <output.s> <input.luna>...\n"
        );
        return 0;
    }
    if (argc == 2 &&
        bootstrap_stage_argument_equals(
            argv[1],
            "--version",
            9
        )) {
        bootstrap_stage_print_c_string(
            runtime_standard_output(),
            "lunac (self-hosted Luna 1) 0.1.0\n"
        );
        return 0;
    }

    var inputs: [64]StdPath = {};
    var input_count: usize = 0;
    var output: StdPath = {};
    var has_output: bool = false;
    var executable: bool = true;
    var has_mode: bool = false;
    var options_finished: bool = false;
    var valid: bool = true;
    var index: usize = 1;
    while (index < argc && valid) {
        let argument: *const u8 = argv[index];
        if (!options_finished &&
            bootstrap_stage_argument_equals(
                argument,
                "--",
                2
            )) {
            options_finished = true;
        } else if (!options_finished &&
            bootstrap_stage_argument_equals(
                argument,
                "-o",
                2
            )) {
            if (has_output || index + 1 >= argc) {
                valid = false;
            } else {
                index += 1;
                let path: StdPathResult =
                    std_path_from_c_string(
                        argv[index],
                        BootstrapStageLimit
                            .maximum_path_bytes as usize
                    );
                if (path.error != RuntimeError.none) {
                    valid = false;
                } else {
                    output = path.path;
                    has_output = true;
                }
            }
        } else if (!options_finished &&
            (bootstrap_stage_argument_equals(
                    argument,
                    "--library",
                    9
                ) ||
                bootstrap_stage_argument_equals(
                    argument,
                    "--executable",
                    12
                ))) {
            if (has_mode) {
                valid = false;
            } else {
                executable =
                    bootstrap_stage_argument_equals(
                        argument,
                        "--executable",
                        12
                    );
                has_mode = true;
            }
        } else if (!options_finished &&
            argument != null && argument[0] == 45) {
            valid = false;
        } else if (input_count ==
            BootstrapStageLimit.maximum_units as usize) {
            valid = false;
        } else {
            let path: StdPathResult =
                std_path_from_c_string(
                    argument,
                    BootstrapStageLimit
                        .maximum_path_bytes as usize
                );
            if (path.error != RuntimeError.none) {
                valid = false;
            } else {
                inputs[input_count] = path.path;
                input_count += 1;
            }
        }
        index += 1;
    }
    if (!has_output || input_count == 0) {
        valid = false;
    }
    if (valid) {
        let output_text: StdTextViewResult =
            std_path_text(output);
        index = 0;
        while (index < input_count && valid) {
            let input_text: StdTextViewResult =
                std_path_text(inputs[index]);
            valid = output_text.error == RuntimeError.none &&
                input_text.error == RuntimeError.none &&
                !std_text_equal(output_text.view, input_text.view);
            index += 1;
        }
    }

    var status: i32 =
        BootstrapStageStatus.cli_usage_error as i32;
    if (valid) {
        status = bootstrap_stage_run(
            false,
            &inputs[0] as *const StdPath,
            input_count,
            executable,
            output
        );
        if (status == BootstrapStageStatus.success as i32) {
            status = 0;
        }
    } else {
        bootstrap_stage_cli_usage();
    }
    let input_release_error: RuntimeError =
        bootstrap_stage_release_paths(&inputs[0], input_count);
    var output_release_error: RuntimeError = RuntimeError.none;
    if (has_output) {
        output_release_error = std_path_release(output);
    }
    if (status == 0 &&
        (input_release_error != RuntimeError.none ||
            output_release_error != RuntimeError.none)) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}

fn main(argc: usize, argv: **const u8) -> i32 {
    if (argc != 1) {
        return bootstrap_stage_cli_main(argc, argv);
    }
    if (bootstrap_stage_read_version() != RuntimeError.none) {
        return BootstrapStageStatus.version_error as i32;
    }
    var executable: bool = false;
    if (bootstrap_stage_read_mode(&executable) !=
        RuntimeError.none) {
        return BootstrapStageStatus.mode_error as i32;
    }
    let output: StdPathResult =
        std_path_from_c_string("bootstrap-stage-output.s", 32);
    if (output.error != RuntimeError.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    let status: i32 = bootstrap_stage_run(
        true,
        null,
        0,
        executable,
        output.path
    );
    let release_error: RuntimeError =
        std_path_release(output.path);
    if (status == BootstrapStageStatus.success as i32 &&
        release_error != RuntimeError.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}
