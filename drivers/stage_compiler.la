module luna.tools.bootstrap.stage_compiler;

import luna.bootstrap.backend.x86_64.abi;
import luna.bootstrap.backend.x86_64.codegen;
import luna.bootstrap.backend.x86_64.frame;
import luna.bootstrap.backend.x86_64.text;
import luna.bootstrap.frontend.lexer as lexer;
import luna.bootstrap.frontend.parser as parser;
import luna.bootstrap.middleend.ir as ir;
import luna.bootstrap.middleend.semantic.context as context;
import luna.bootstrap.middleend.sema as sema;
import luna.bootstrap.middleend.type as type_info;
import luna.runtime;
import luna.std.bytes;
import luna.std.io;
import luna.std.path as path;
import luna.std.text as std_text;

enum BootstrapStageLimit: usize {
    maximum_units = 64, maximum_path_bytes = 4096, maximum_source_bytes = 8388608,
    maximum_total_source_bytes = 33554432, maximum_frontend_diagnostics = 4096, maximum_semantic_diagnostics = 4096,
}

enum BootstrapStageStatus: i32 {
    mode_error = 1, input_error = 2, unit_limit = 3, semantic_error = 4, backend_error = 5, output_error = 6,
    release_error = 7, resource_limit = 8, version_error = 9, semantic_diagnostic_base = 64, success = 42,
    cli_usage_error = 125,
}

fn bootstrap_stage_invalid_path_result(error: runtime::Error) -> path::PathResult {
    return {
        path = {
            storage = bytes::empty(), length = 0,
        }, error = error,
    };
}

fn bootstrap_stage_unit_path(index: usize) -> path::PathResult {
    var text: BootstrapX8664Text = bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(&text, "bootstrap-stage-unit-", 32) ||
        !bootstrap_x86_64_text_append_usize(&text, index) ||
        !bootstrap_x86_64_text_append_c_string(
            &text, ".luna", 8)) {
        let error: runtime::Error = text.error == runtime::Error.none ? runtime::Error.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return bootstrap_stage_invalid_path_result(error);
    }
    let bytes: bytes::BufferResult = bootstrap_x86_64_text_take(&text);
    if (bytes.error != runtime::Error.none) {
        bootstrap_x86_64_text_release(text);
        return bootstrap_stage_invalid_path_result(bytes.error);
    }
    let view: std_text::ViewResult = std_text::view(bytes.buffer.data as *const u8, bytes.buffer.length);
    var result: path::PathResult = bootstrap_stage_invalid_path_result(view.error);
    if (view.error == runtime::Error.none) {
        result = path::from_text(view.view);
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    if (result.error == runtime::Error.none && release_error != runtime::Error.none) {
        path::release(result.path);
        return bootstrap_stage_invalid_path_result(release_error);
    }
    return result;
}

fn bootstrap_stage_read_mode(executable: *bool) -> runtime::Error {
    if (executable == null) {
        return runtime::Error.invalid_argument;
    }
    let path: path::PathResult = path::from_c_string("bootstrap-stage-mode", 32);
    if (path.error != runtime::Error.none) {
        return path.error;
    }
    let bytes: bytes::BufferResult = io::read_file_limited(path.path, 2);
    let path_error: runtime::Error = path::release(path.path);
    if (bytes.error != runtime::Error.none) {
        return bytes.error;
    }
    var error: runtime::Error = path_error;
    if (error == runtime::Error.none) {
        if (bytes.buffer.length != 2 || bytes.buffer.data[1] != 10) {
            error = runtime::Error.invalid_argument;
        } else if (bytes.buffer.data[0] == 69) {
            *executable = true;
        } else if (bytes.buffer.data[0] == 76) {
            *executable = false;
        } else {
            error = runtime::Error.invalid_argument;
        }
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    return error == runtime::Error.none ? release_error : error;
}

fn bootstrap_stage_read_version() -> runtime::Error {
    let path: path::PathResult = path::from_c_string("bootstrap-stage-version", 32);
    if (path.error != runtime::Error.none) {
        return path.error;
    }
    let bytes: bytes::BufferResult = io::read_file_limited(path.path, 20);
    let path_error: runtime::Error = path::release(path.path);
    if (bytes.error != runtime::Error.none) {
        return bytes.error;
    }
    var error: runtime::Error = path_error;
    if (error == runtime::Error.none &&
        !bytes::equal(
            bytes.buffer, "LUNA-STAGE/1 LUNA/1\n", 20)) {
        error = runtime::Error.invalid_argument;
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    return error == runtime::Error.none ? release_error : error;
}

fn bootstrap_stage_source_release(source: bytes::Buffer, frontend: parser::FrontendResult) -> runtime::Error {
    var error: runtime::Error = parser::frontend_result_release(frontend);
    let source_error: runtime::Error = bytes::release(source);
    if (error == runtime::Error.none) {
        error = source_error;
    }
    return error;
}

fn bootstrap_stage_sources_release(
    sources: *bytes::Buffer, frontends: *parser::FrontendResult, count: usize) -> runtime::Error {
    if (sources == null || frontends == null || count > BootstrapStageLimit.maximum_units as usize) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = runtime::Error.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: runtime::Error = bootstrap_stage_source_release(sources[index], frontends[index]);
        if (error == runtime::Error.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_source_load(
    path: path::Path, result_source: *bytes::Buffer, result_frontend: *parser::FrontendResult) -> runtime::Error {
    if (!path::is_valid(path) || result_source == null || result_frontend == null) {
        return runtime::Error.invalid_argument;
    }
    let source: bytes::BufferResult = io::read_file_limited(path, BootstrapStageLimit.maximum_source_bytes as usize);
    if (source.error != runtime::Error.none) {
        return source.error;
    }
    let view: std_text::ViewResult = std_text::view(source.buffer.data as *const u8, source.buffer.length);
    if (view.error != runtime::Error.none) {
        bytes::release(source.buffer);
        return view.error;
    }
    let frontend: parser::FrontendResult = parser::frontend_parse(view.view);
    *result_source = source.buffer;
    *result_frontend = frontend;
    return runtime::Error.none;
}

fn bootstrap_stage_frontend_diagnostic(frontend: parser::FrontendResult, lexical: *bool) -> lexer::DiagnosticResult {
    if (lexical == null) {
        return {
            diagnostic = {}, error = runtime::Error.invalid_argument,
        };
    }
    var index: usize = 0;
    while (index < frontend.lex.diagnostics.count) {
        let diagnostic: lexer::DiagnosticResult = lexer::diagnostic_buffer_get(frontend.lex.diagnostics, index);
        if (diagnostic.error != runtime::Error.none || diagnostic.diagnostic.kind ==
                lexer::DiagnosticKind.nesting_limit || diagnostic.diagnostic.kind ==
                lexer::DiagnosticKind.resource_limit) {
            *lexical = true;
            return diagnostic;
        }
        index += 1;
    }
    index = 0;
    while (index < frontend.parse.diagnostics.count) {
        let diagnostic: lexer::DiagnosticResult = lexer::diagnostic_buffer_get(frontend.parse.diagnostics, index);
        if (diagnostic.error != runtime::Error.none || diagnostic.diagnostic.kind ==
                lexer::DiagnosticKind.nesting_limit || diagnostic.diagnostic.kind ==
                lexer::DiagnosticKind.resource_limit) {
            *lexical = false;
            return diagnostic;
        }
        index += 1;
    }
    if (frontend.lex.diagnostics.count != 0) {
        *lexical = true;
        return lexer::diagnostic_buffer_get(frontend.lex.diagnostics, 0);
    }
    if (frontend.parse.diagnostics.count != 0) {
        *lexical = false;
        return lexer::diagnostic_buffer_get(frontend.parse.diagnostics, 0);
    }
    return {
        diagnostic = {}, error = runtime::Error.not_found,
    };
}

fn bootstrap_stage_frontend_status(frontend: parser::FrontendResult) -> i32 {
    if (frontend.error == runtime::Error.out_of_memory) {
        return BootstrapStageStatus.resource_limit as i32;
    }
    var lexical: bool = false;
    let result: lexer::DiagnosticResult = bootstrap_stage_frontend_diagnostic(frontend, &lexical);
    if (result.error != runtime::Error.none) {
        return BootstrapStageStatus.input_error as i32;
    }
    if (result.diagnostic.kind == lexer::DiagnosticKind.nesting_limit || result.diagnostic.kind ==
            lexer::DiagnosticKind.resource_limit) {
        return BootstrapStageStatus.resource_limit as i32;
    }
    return BootstrapStageStatus.input_error as i32;
}

fn bootstrap_stage_print_text(text: *BootstrapX8664Text) -> runtime::Error {
    if (text == null) {
        return runtime::Error.invalid_argument;
    }
    let bytes: bytes::BufferResult = bootstrap_x86_64_text_take(text);
    if (bytes.error != runtime::Error.none) {
        bootstrap_x86_64_text_release(*text);
        return bytes.error;
    }
    let view: std_text::ViewResult = std_text::view(bytes.buffer.data as *const u8, bytes.buffer.length);
    var error: runtime::Error = view.error;
    if (error == runtime::Error.none) {
        error = io::print_error(view.view);
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    return error == runtime::Error.none ? release_error : error;
}

fn bootstrap_stage_report_frontend(frontend: parser::FrontendResult) -> runtime::Error {
    var lexical: bool = false;
    let result: lexer::DiagnosticResult = bootstrap_stage_frontend_diagnostic(frontend, &lexical);
    if (result.error == runtime::Error.not_found) {
        return runtime::Error.none;
    }
    if (result.error != runtime::Error.none) {
        return result.error;
    }
    var text: BootstrapX8664Text = bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(&text, lexical ? "frontend:lex:" : "frontend:parse:", 32) ||
        !bootstrap_x86_64_text_append_usize(&text, result.diagnostic.kind as usize) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, result.diagnostic.span.offset) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, result.diagnostic.detail) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: runtime::Error = text.error == runtime::Error.none ? runtime::Error.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    return bootstrap_stage_print_text(&text);
}

fn bootstrap_stage_report_resource(
    label: *const u8, label_maximum_length: usize, unit_index: usize, limit: usize) -> runtime::Error {
    var text: BootstrapX8664Text = bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(&text, "resource:", 16) ||
        !bootstrap_x86_64_text_append_c_string(&text, label, label_maximum_length) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, unit_index) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) || !bootstrap_x86_64_text_append_usize(&text, limit) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: runtime::Error = text.error == runtime::Error.none ? runtime::Error.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    return bootstrap_stage_print_text(&text);
}

fn bootstrap_stage_input_add(
    input: *context::Input, source: bytes::Buffer, frontend: parser::FrontendResult,
    path: std_text::View) -> bool {
    if (input == null) {
        return false;
    }
    let view: std_text::ViewResult = std_text::view(source.data as *const u8, source.length);
    return view.error == runtime::Error.none &&
        context::input_add(
            input, {
                source = view.view, tokens = frontend.lex.tokens, tree = frontend.parse.tree,
                path_offset = 0, path_length = 0,
            }, path);
}

fn bootstrap_stage_semantic_status(semantic: context::Result) -> i32 {
    if (semantic.error == runtime::Error.out_of_memory) {
        return BootstrapStageStatus.resource_limit as i32;
    }
    if (semantic.diagnostics.count == 0) {
        return BootstrapStageStatus.semantic_error as i32;
    }
    let diagnostic: context::DiagnosticResult = context::diagnostic_get(semantic.diagnostics, 0);
    if (diagnostic.error != runtime::Error.none) {
        return BootstrapStageStatus.semantic_error as i32;
    }
    return BootstrapStageStatus.semantic_diagnostic_base as i32 + diagnostic.diagnostic.kind as usize as i32;
}

fn bootstrap_stage_report_semantic(semantic: context::Result) -> runtime::Error {
    if (semantic.diagnostics.count == 0) {
        return runtime::Error.none;
    }
    let diagnostic: context::DiagnosticResult = context::diagnostic_get(semantic.diagnostics, 0);
    if (diagnostic.error != runtime::Error.none) {
        return diagnostic.error;
    }
    var text: BootstrapX8664Text = bootstrap_x86_64_text_empty();
    if (!bootstrap_x86_64_text_append_c_string(&text, "semantic:", 16) ||
        !bootstrap_x86_64_text_append_usize(&text, diagnostic.diagnostic.kind as usize) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, diagnostic.diagnostic.unit_index) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, diagnostic.diagnostic.span.offset) ||
        !bootstrap_x86_64_text_append_c_string(&text, ":", 2) ||
        !bootstrap_x86_64_text_append_usize(&text, diagnostic.diagnostic.detail) ||
        !bootstrap_x86_64_text_append_c_string(&text, "\n", 2)) {
        let error: runtime::Error = text.error == runtime::Error.none ? runtime::Error.invalid_argument : text.error;
        bootstrap_x86_64_text_release(text);
        return error;
    }
    let bytes: bytes::BufferResult = bootstrap_x86_64_text_take(&text);
    if (bytes.error != runtime::Error.none) {
        bootstrap_x86_64_text_release(text);
        return bytes.error;
    }
    let view: std_text::ViewResult = std_text::view(bytes.buffer.data as *const u8, bytes.buffer.length);
    var error: runtime::Error = view.error;
    if (error == runtime::Error.none) {
        error = io::print_error(view.view);
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    return error == runtime::Error.none ? release_error : error;
}

fn bootstrap_stage_run(
    fixed_protocol: bool, input_paths: *const path::Path, input_count: usize, executable: bool, output_path: path::Path
) -> i32 {
    if ((!fixed_protocol && (input_paths == null || input_count == 0 || input_count >
                    BootstrapStageLimit.maximum_units as usize)) || !path::is_valid(output_path)) {
        return BootstrapStageStatus.input_error as i32;
    }
    var sources: [64]bytes::Buffer = {};
    var frontends: [64]parser::FrontendResult = {};
    var source_count: usize = 0;
    var total_source_bytes: usize = 0;
    let expected_count: usize = fixed_protocol ? BootstrapStageLimit.maximum_units as usize : input_count;
    while (source_count < expected_count) {
        var path: path::PathResult = bootstrap_stage_invalid_path_result(runtime::Error.none);
        if (fixed_protocol) {
            path = bootstrap_stage_unit_path(source_count);
            if (path.error != runtime::Error.none) {
                bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
                return BootstrapStageStatus.input_error as i32;
            }
        }
        let source_path: path::Path = fixed_protocol ? path.path : input_paths[source_count];
        var error: runtime::Error =
            bootstrap_stage_source_load(source_path, &sources[source_count], &frontends[source_count]);
        let source_loaded: bool = error == runtime::Error.none;
        if (fixed_protocol) {
            let path_error: runtime::Error = path::release(path.path);
            if (source_loaded && path_error != runtime::Error.none) {
                bootstrap_stage_source_release(sources[source_count], frontends[source_count]);
                error = path_error;
            }
        }
        if (fixed_protocol && error == runtime::Error.not_found) {
            break;
        }
        if (error != runtime::Error.none) {
            bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
            if (error == runtime::Error.out_of_memory) {
                bootstrap_stage_report_resource(
                    "source", 8, source_count, BootstrapStageLimit.maximum_source_bytes as usize);
                return BootstrapStageStatus.resource_limit as i32;
            }
            return BootstrapStageStatus.input_error as i32;
        }
        source_count += 1;
        let source_length: usize = sources[source_count - 1].length;
        if (source_length > (BootstrapStageLimit.maximum_total_source_bytes as usize) - total_source_bytes) {
            bootstrap_stage_report_resource(
                "total", 8, source_count - 1, BootstrapStageLimit.maximum_total_source_bytes as usize);
            bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
            return BootstrapStageStatus.resource_limit as i32;
        }
        total_source_bytes += source_length;
        let frontend: parser::FrontendResult = frontends[source_count - 1];
        if (frontend.error != runtime::Error.none || frontend.lex.diagnostics.count != 0 ||
            frontend.parse.diagnostics.count != 0) {
            let status: i32 = bootstrap_stage_frontend_status(frontend);
            var lexical: bool = false;
            let diagnostic: lexer::DiagnosticResult = bootstrap_stage_frontend_diagnostic(frontend, &lexical);
            let has_resource_diagnostic: bool = diagnostic.error == runtime::Error.none && diagnostic.diagnostic.kind ==
                    lexer::DiagnosticKind.resource_limit;
            if (frontend.error == runtime::Error.out_of_memory && !has_resource_diagnostic) {
                bootstrap_stage_report_resource(
                    "frontend", 16, source_count - 1, BootstrapStageLimit.maximum_frontend_diagnostics as usize);
            } else {
                bootstrap_stage_report_frontend(frontend);
            }
            bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
            return status;
        }
    }
    if (source_count == 0) {
        return BootstrapStageStatus.input_error as i32;
    }
    if (fixed_protocol && source_count == BootstrapStageLimit.maximum_units as usize) {
        var excess_source: bytes::Buffer = bytes::empty();
        var excess_frontend: parser::FrontendResult = {};
        let excess_path: path::PathResult = bootstrap_stage_unit_path(source_count);
        var excess_error: runtime::Error = excess_path.error;
        var excess_present: bool = false;
        if (excess_path.error == runtime::Error.none) {
            excess_error = bootstrap_stage_source_load(excess_path.path, &excess_source, &excess_frontend);
            excess_present = excess_error == runtime::Error.none;
            let path_error: runtime::Error = path::release(excess_path.path);
            if (excess_error == runtime::Error.none) {
                excess_error = path_error;
            }
        }
        if (excess_present) {
            let release_error: runtime::Error = bootstrap_stage_source_release(excess_source, excess_frontend);
            if (excess_error == runtime::Error.none) {
                excess_error = release_error;
            }
        }
        if (excess_present || excess_error != runtime::Error.not_found) {
            bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
            return BootstrapStageStatus.unit_limit as i32;
        }
    }

    var input: context::Input = context::input_empty(executable);
    var added: bool = true;
    var index: usize = 0;
    while (index < source_count && added) {
        if (fixed_protocol) {
            let path: path::PathResult = bootstrap_stage_unit_path(index);
            if (path.error != runtime::Error.none) {
                added = false;
            } else {
                let text: std_text::ViewResult = path::text(path.path);
                added = text.error == runtime::Error.none &&
                    bootstrap_stage_input_add(&input, sources[index], frontends[index], text.view);
                added = path::release(path.path) == runtime::Error.none && added;
            }
        } else {
            let text: std_text::ViewResult = path::text(input_paths[index]);
            added = text.error == runtime::Error.none &&
                bootstrap_stage_input_add(&input, sources[index], frontends[index], text.view);
        }
        index += 1;
    }
    if (!added) {
        context::input_release(input);
        bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
        return BootstrapStageStatus.semantic_error as i32;
    }

    let semantic: context::Result = sema::check(input);
    if (!context::result_is_success(semantic)) {
        let status: i32 = bootstrap_stage_semantic_status(semantic);
        if (semantic.error == runtime::Error.out_of_memory) {
            bootstrap_stage_report_resource(
                "semantic", 16, 0, BootstrapStageLimit.maximum_semantic_diagnostics as usize);
        } else {
            bootstrap_stage_report_semantic(semantic);
        }
        context::result_release(semantic);
        context::input_release(input);
        bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
        return status;
    }
    let backend: BootstrapX8664BackendResult = bootstrap_x86_64_emit_assembly(input, semantic.ir, semantic.types);
    if (!bootstrap_x86_64_backend_is_success(
            backend, input, semantic.ir, semantic.types)) {
        let backend_status: i32 = backend.error == runtime::Error.out_of_memory ?
                BootstrapStageStatus.resource_limit as i32 : BootstrapStageStatus.backend_error as i32;
        bootstrap_x86_64_backend_release(backend);
        context::result_release(semantic);
        context::input_release(input);
        bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
        return backend_status;
    }

    let write_error: runtime::Error = io::write_file_atomic(
        output_path, backend.assembly.data as *const u8, backend.assembly.length);

    let backend_error: runtime::Error = bootstrap_x86_64_backend_release(backend);
    let semantic_error: runtime::Error = context::result_release(semantic);
    let input_error: runtime::Error = context::input_release(input);
    let sources_error: runtime::Error = bootstrap_stage_sources_release(&sources[0], &frontends[0], source_count);
    if (write_error != runtime::Error.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    if (backend_error != runtime::Error.none || semantic_error != runtime::Error.none ||
        input_error != runtime::Error.none || sources_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return BootstrapStageStatus.success as i32;
}

fn bootstrap_stage_argument_equals(argument: *const u8, expected: *const u8, length: usize) -> bool {
    if (argument == null || expected == null) {
        return false;
    }
    var index: usize = 0;
    while (index < length) {
        if (argument[index] != expected[index] || argument[index] == 0) {
            return false;
        }
        index += 1;
    }
    return argument[length] == 0;
}

fn bootstrap_stage_print_c_string(file: runtime::File, data: *const u8) -> runtime::Error {
    let text: std_text::ViewResult = std_text::from_c_string(data, 1024);
    if (text.error != runtime::Error.none) {
        return text.error;
    }
    return io::write_all(file, text.view.data, text.view.length);
}

fn bootstrap_stage_cli_usage() -> i32 {
    bootstrap_stage_print_c_string(
        runtime::standard_error(), "usage: lunac [--executable|--library] -o <output.s> <input.la>...\n");
    return BootstrapStageStatus.cli_usage_error as i32;
}

fn bootstrap_stage_release_paths(paths: *path::Path, count: usize) -> runtime::Error {
    if (paths == null || count > BootstrapStageLimit.maximum_units as usize) {
        return runtime::Error.invalid_argument;
    }
    var error: runtime::Error = runtime::Error.none;
    var index: usize = count;
    while (index != 0) {
        index -= 1;
        let release_error: runtime::Error = path::release(paths[index]);
        if (error == runtime::Error.none) {
            error = release_error;
        }
    }
    return error;
}

fn bootstrap_stage_cli_main(argc: usize, argv: **const u8) -> i32 {
    if (argv == null || argc < 2) {
        return bootstrap_stage_cli_usage();
    }
    if (argc == 2 &&
        bootstrap_stage_argument_equals(
            argv[1], "--help", 6)) {
        bootstrap_stage_print_c_string(
            runtime::standard_output(), "usage: lunac [--executable|--library] -o <output.s> <input.la>...\n");
        return 0;
    }
    if (argc == 2 &&
        bootstrap_stage_argument_equals(
            argv[1], "--version", 9)) {
        bootstrap_stage_print_c_string(runtime::standard_output(), "lunac (self-hosted Luna 1) 0.1.0\n");
        return 0;
    }

    var inputs: [64]path::Path = {};
    var input_count: usize = 0;
    var output: path::Path = {};
    var has_output: bool = false;
    var executable: bool = true;
    var has_mode: bool = false;
    var options_finished: bool = false;
    var valid: bool = true;
    var index: usize = 1;
    while (index < argc && valid) {
        let argument: *const u8 = argv[index];
        if (!options_finished &&
            bootstrap_stage_argument_equals(
                argument, "--", 2)) {
            options_finished = true;
        } else if (!options_finished &&
            bootstrap_stage_argument_equals(
                argument, "-o", 2)) {
            if (has_output || index + 1 >= argc) {
                valid = false;
            } else {
                index += 1;
                let path: path::PathResult =
                    path::from_c_string(argv[index], BootstrapStageLimit.maximum_path_bytes as usize);
                if (path.error != runtime::Error.none) {
                    valid = false;
                } else {
                    output = path.path;
                    has_output = true;
                }
            }
        } else if (!options_finished && (bootstrap_stage_argument_equals(argument, "--library", 9) ||
                bootstrap_stage_argument_equals(
                    argument, "--executable", 12))) {
            if (has_mode) {
                valid = false;
            } else {
                executable = bootstrap_stage_argument_equals(argument, "--executable", 12);
                has_mode = true;
            }
        } else if (!options_finished && argument != null && argument[0] == 45) {
            valid = false;
        } else if (input_count == BootstrapStageLimit.maximum_units as usize) {
            valid = false;
        } else {
            let path: path::PathResult = path::from_c_string(argument, BootstrapStageLimit.maximum_path_bytes as usize);
            if (path.error != runtime::Error.none) {
                valid = false;
            } else {
                inputs[input_count] = path.path;
                input_count += 1;
            }
        }
        index += 1;
    }
    if (!has_output || input_count == 0) {
        valid = false;
    }
    if (valid) {
        let output_text: std_text::ViewResult = path::text(output);
        index = 0;
        while (index < input_count && valid) {
            let input_text: std_text::ViewResult = path::text(inputs[index]);
            valid = output_text.error == runtime::Error.none && input_text.error == runtime::Error.none &&
                !std_text::equal(output_text.view, input_text.view);
            index += 1;
        }
    }

    var status: i32 = BootstrapStageStatus.cli_usage_error as i32;
    if (valid) {
        status = bootstrap_stage_run(false, &inputs[0] as *const path::Path, input_count, executable, output);
        if (status == BootstrapStageStatus.success as i32) {
            status = 0;
        }
    } else {
        bootstrap_stage_cli_usage();
    }
    let input_release_error: runtime::Error = bootstrap_stage_release_paths(&inputs[0], input_count);
    var output_release_error: runtime::Error = runtime::Error.none;
    if (has_output) {
        output_release_error = path::release(output);
    }
    if (status == 0 && (input_release_error != runtime::Error.none || output_release_error != runtime::Error.none)) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}

fn main(argc: usize, argv: **const u8) -> i32 {
    if (argc != 1) {
        return bootstrap_stage_cli_main(argc, argv);
    }
    if (bootstrap_stage_read_version() != runtime::Error.none) {
        return BootstrapStageStatus.version_error as i32;
    }
    var executable: bool = false;
    if (bootstrap_stage_read_mode(&executable) != runtime::Error.none) {
        return BootstrapStageStatus.mode_error as i32;
    }
    let output: path::PathResult = path::from_c_string("bootstrap-stage-output.s", 32);
    if (output.error != runtime::Error.none) {
        return BootstrapStageStatus.output_error as i32;
    }
    let status: i32 = bootstrap_stage_run(true, null, 0, executable, output.path);
    let release_error: runtime::Error = path::release(output.path);
    if (status == BootstrapStageStatus.success as i32 && release_error != runtime::Error.none) {
        return BootstrapStageStatus.release_error as i32;
    }
    return status;
}

