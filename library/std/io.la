module luna.std.io;

enum Limit: usize {
    read_chunk = 4096, maximum_size = 18446744073709551615,
}

fn write_all(file: runtime::File, data: *const u8, length: usize) -> runtime::Error {
    if (length != 0 && data == null) {
        return runtime::Error.bad_address;
    }

    var written: usize = 0;
    while (written < length) {
        let result: runtime::IoResult = runtime::file_write(file, &data[written], length - written);
        if (result.error == runtime::Error.interrupted) {
            continue;
        }
        if (result.error != runtime::Error.none) {
            return result.error;
        }
        if (result.count == 0) {
            return runtime::Error.io;
        }
        written += result.count;
    }
    return runtime::Error.none;
}

fn read_to_end(file: runtime::File, buffer: bytes::Buffer) -> bytes::BufferResult {
    return read_to_end_limited(file, buffer, Limit.maximum_size as usize);
}

fn read_to_end_limited(file: runtime::File, buffer: bytes::Buffer, maximum_length: usize)
    -> bytes::BufferResult {
    if (!bytes::is_valid(buffer) || buffer.length > maximum_length) {
        return {
            buffer = buffer, error = runtime::Error.invalid_argument,
        };
    }

    var result_buffer: bytes::Buffer = buffer;
    while (true) {
        if (result_buffer.length == maximum_length) {
            var excess: u8 = 0;
            let read: runtime::IoResult = runtime::file_read(file, &excess, 1);
            if (read.error == runtime::Error.interrupted) {
                continue;
            }
            if (read.error != runtime::Error.none) {
                return {
                    buffer = result_buffer, error = read.error,
                };
            }
            return {
                buffer = result_buffer, error = read.count == 0 ? runtime::Error.none : runtime::Error.out_of_memory,
            };
        }
        if (result_buffer.capacity == result_buffer.length) {
            let remaining: usize = maximum_length - result_buffer.length;
            let growth: usize = remaining < Limit.read_chunk as usize ? remaining : Limit.read_chunk as usize;
            let reserved: bytes::BufferResult = bytes::reserve(result_buffer, result_buffer.length + growth);
            if (reserved.error != runtime::Error.none) {
                return reserved;
            }
            result_buffer = reserved.buffer;
        }

        let writable: usize = result_buffer.capacity - result_buffer.length;
        let remaining: usize = maximum_length - result_buffer.length;
        let read_length: usize = writable < remaining ? writable : remaining;
        let read: runtime::IoResult = runtime::file_read(file, &result_buffer.data[result_buffer.length], read_length);
        if (read.error == runtime::Error.interrupted) {
            continue;
        }
        if (read.error != runtime::Error.none) {
            return {
                buffer = result_buffer, error = read.error,
            };
        }
        if (read.count == 0) {
            return {
                buffer = result_buffer, error = runtime::Error.none,
            };
        }
        result_buffer.length += read.count;
    }
    return {
        buffer = result_buffer, error = runtime::Error.io,
    };
}

fn read_file(path: path::Path) -> bytes::BufferResult {
    return read_file_limited(path, Limit.maximum_size as usize);
}

fn read_file_limited(path: path::Path, maximum_length: usize) -> bytes::BufferResult {
    if (!path::is_valid(path)) {
        return {
            buffer = bytes::empty(), error = runtime::Error.invalid_argument,
        };
    }
    let opened: runtime::FileResult = runtime::file_open_read(path::as_c_string(path));
    if (opened.error != runtime::Error.none) {
        return {
            buffer = bytes::empty(), error = opened.error,
        };
    }

    let read: bytes::BufferResult = read_to_end_limited(opened.file, bytes::empty(), maximum_length);
    let close_error: runtime::Error = runtime::file_close(opened.file);
    if (read.error != runtime::Error.none) {
        bytes::release(read.buffer);
        return {
            buffer = bytes::empty(), error = read.error,
        };
    }
    if (close_error != runtime::Error.none) {
        bytes::release(read.buffer);
        return {
            buffer = bytes::empty(), error = close_error,
        };
    }
    return read;
}

fn write_file(path: path::Path, data: *const u8, length: usize) -> runtime::Error {
    if (!path::is_valid(path)) {
        return runtime::Error.invalid_argument;
    }
    if (length != 0 && data == null) {
        return runtime::Error.bad_address;
    }
    let opened: runtime::FileResult = runtime::file_create(path::as_c_string(path));
    if (opened.error != runtime::Error.none) {
        return opened.error;
    }

    let write_error: runtime::Error = write_all(opened.file, data, length);
    let close_error: runtime::Error = runtime::file_close(opened.file);
    if (write_error != runtime::Error.none) {
        return write_error;
    }
    return close_error;
}

fn write_executable_file(path: path::Path, data: *const u8, length: usize) -> runtime::Error {
    if (!path::is_valid(path)) {
        return runtime::Error.invalid_argument;
    }
    if (length != 0 && data == null) {
        return runtime::Error.bad_address;
    }
    let opened: runtime::FileResult = runtime::file_create_executable(path::as_c_string(path));
    if (opened.error != runtime::Error.none) {
        return opened.error;
    }
    let write_error: runtime::Error = write_all(opened.file, data, length);
    let close_error: runtime::Error = runtime::file_close(opened.file);
    if (write_error != runtime::Error.none) {
        return write_error;
    }
    return close_error;
}

fn invalid_path_result(error: runtime::Error) -> path::PathResult {
    return {
        path = {
            storage = bytes::empty(), length = 0,
        }, error = error,
    };
}

fn atomic_temporary_path(path: path::Path) -> path::PathResult {
    let path_text: text::ViewResult = path::text(path);
    if (path_text.error != runtime::Error.none) {
        return invalid_path_result(path_text.error);
    }
    let process: runtime::ProcessIdResult = runtime::process_id();
    if (process.error != runtime::Error.none) {
        return invalid_path_result(process.error);
    }
    var bytes: bytes::BufferResult = bytes::from(path_text.view.data, path_text.view.length);
    if (bytes.error != runtime::Error.none) {
        return invalid_path_result(bytes.error);
    }
    bytes = bytes::append(bytes.buffer, ".luna-tmp-", 10);
    if (bytes.error != runtime::Error.none) {
        bytes::release(bytes.buffer);
        return invalid_path_result(bytes.error);
    }
    var digits: [16]u8 = {};
    var index: usize = 16;
    var value: usize = process.process_id;
    while (index != 0) {
        index -= 1;
        let digit: usize = value & 15;
        if (digit < 10) {
            digits[index] = ((48 as usize) + digit) as u8;
        } else {
            digits[index] = ((87 as usize) + digit) as u8;
        }
        value >>= 4;
    }
    bytes = bytes::append(bytes.buffer, &digits[0] as *const u8, 16);
    if (bytes.error != runtime::Error.none) {
        bytes::release(bytes.buffer);
        return invalid_path_result(bytes.error);
    }
    let temporary_text: text::ViewResult = text::view(bytes.buffer.data as *const u8, bytes.buffer.length);
    var result: path::PathResult = invalid_path_result(temporary_text.error);
    if (temporary_text.error == runtime::Error.none) {
        result = path::from_text(temporary_text.view);
    }
    let release_error: runtime::Error = bytes::release(bytes.buffer);
    if (result.error == runtime::Error.none && release_error != runtime::Error.none) {
        path::release(result.path);
        return invalid_path_result(release_error);
    }
    return result;
}

fn write_file_atomic_implementation(
    path: path::Path, data: *const u8, length: usize, executable: bool) -> runtime::Error {
    if (!path::is_valid(path)) {
        return runtime::Error.invalid_argument;
    }
    if (length != 0 && data == null) {
        return runtime::Error.bad_address;
    }
    let temporary: path::PathResult = atomic_temporary_path(path);
    if (temporary.error != runtime::Error.none) {
        return temporary.error;
    }
    var opened: runtime::FileResult = runtime::file_create_exclusive(path::as_c_string(temporary.path));
    if (opened.error == runtime::Error.exists) {
        let remove_error: runtime::Error = runtime::path_remove(path::as_c_string(temporary.path));
        if (remove_error == runtime::Error.none || remove_error == runtime::Error.not_found) {
            opened = runtime::file_create_exclusive(path::as_c_string(temporary.path));
        }
    }
    if (opened.error != runtime::Error.none) {
        path::release(temporary.path);
        return opened.error;
    }

    var error: runtime::Error = write_all(opened.file, data, length);
    if (error == runtime::Error.none && executable) {
        error = runtime::file_make_executable(opened.file);
    }
    let close_error: runtime::Error = runtime::file_close(opened.file);
    if (error == runtime::Error.none) {
        error = close_error;
    }
    if (error == runtime::Error.none) {
        error = runtime::path_replace(path::as_c_string(temporary.path), path::as_c_string(path));
    }
    if (error != runtime::Error.none) {
        runtime::path_remove(path::as_c_string(temporary.path));
    }
    let release_error: runtime::Error = path::release(temporary.path);
    return error == runtime::Error.none ? release_error : error;
}

fn write_file_atomic(path: path::Path, data: *const u8, length: usize) -> runtime::Error {
    return write_file_atomic_implementation(path, data, length, false);
}

fn write_executable_file_atomic(path: path::Path, data: *const u8, length: usize) -> runtime::Error {
    return write_file_atomic_implementation(path, data, length, true);
}

fn print(text: text::View) -> runtime::Error {
    if (!text::is_valid_utf8(text)) {
        return runtime::Error.invalid_argument;
    }
    return write_all(runtime::standard_output(), text.data, text.length);
}

fn print_error(text: text::View) -> runtime::Error {
    if (!text::is_valid_utf8(text)) {
        return runtime::Error.invalid_argument;
    }
    return write_all(runtime::standard_error(), text.data, text.length);
}

