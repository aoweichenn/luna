module luna.std.path;

enum StdPathLimit: usize {
    maximum_size = 18446744073709551615,
}

fn std_path_empty() -> StdPath {
    return {
        storage = std_byte_buffer_empty(),
        length = 0,
    };
}

fn std_path_result(
    path: StdPath,
    error: RuntimeError
) -> StdPathResult {
    return {
        path = path,
        error = error,
    };
}

fn std_path_from_text(view: StdTextView) -> StdPathResult {
    if (!std_text_is_valid_utf8(view) || view.length == 0) {
        return std_path_result(
            std_path_empty(),
            RuntimeError.invalid_argument
        );
    }

    var index: usize = 0;
    while (index < view.length) {
        if (view.data[index] == 0) {
            return std_path_result(
                std_path_empty(),
                RuntimeError.invalid_argument
            );
        }
        index += 1;
    }

    let copied: StdByteBufferResult =
        std_byte_buffer_from(view.data, view.length);
    if (copied.error != RuntimeError.none) {
        return std_path_result(std_path_empty(), copied.error);
    }
    let terminated: StdByteBufferResult =
        std_byte_buffer_push(copied.buffer, 0);
    if (terminated.error != RuntimeError.none) {
        std_byte_buffer_release(terminated.buffer);
        return std_path_result(
            std_path_empty(),
            terminated.error
        );
    }
    return std_path_result(
        {
            storage = terminated.buffer,
            length = view.length,
        },
        RuntimeError.none
    );
}

fn std_path_from_c_string(
    data: *const u8,
    maximum_length: usize
) -> StdPathResult {
    let view: StdTextViewResult =
        std_text_from_c_string(data, maximum_length);
    if (view.error != RuntimeError.none) {
        return std_path_result(std_path_empty(), view.error);
    }
    return std_path_from_text(view.view);
}

fn std_path_is_valid(path: StdPath) -> bool {
    if (!std_byte_buffer_is_valid(path.storage) ||
        path.length == 0 ||
        path.length == StdPathLimit.maximum_size as usize ||
        path.storage.length != path.length + 1 ||
        path.storage.data[path.length] != 0) {
        return false;
    }

    var index: usize = 0;
    while (index < path.length) {
        if (path.storage.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return std_text_is_valid_utf8({
        data = path.storage.data as *const u8,
        length = path.length,
    });
}

fn std_path_as_c_string(path: StdPath) -> *const u8 {
    if (!std_path_is_valid(path)) {
        return null;
    }
    return path.storage.data as *const u8;
}

fn std_path_text(path: StdPath) -> StdTextViewResult {
    if (!std_path_is_valid(path)) {
        return {
            view = {
                data = null,
                length = 0,
            },
            error = RuntimeError.invalid_argument,
        };
    }
    return std_text_view(
        path.storage.data as *const u8,
        path.length
    );
}

fn std_path_release(path: StdPath) -> RuntimeError {
    if (!std_path_is_valid(path)) {
        return RuntimeError.invalid_argument;
    }
    return std_byte_buffer_release(path.storage);
}
