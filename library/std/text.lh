export module luna.std.text;

import luna.runtime;
import luna.std.bytes;

export struct StdTextView {
    data: *const u8;
    length: usize;
}

export struct StdTextViewResult {
    view: StdTextView;
    error: runtime::Error;
}

export struct StdOwnedText {
    buffer: StdByteBuffer;
}

export struct StdOwnedTextResult {
    text: StdOwnedText;
    error: runtime::Error;
}

export fn std_text_view(data: *const u8, length: usize) -> StdTextViewResult;
export fn std_text_from_c_string(data: *const u8, maximum_length: usize) -> StdTextViewResult;
export fn std_text_is_valid_utf8(view: StdTextView) -> bool;
export fn std_text_slice(view: StdTextView, offset: usize, length: usize) -> StdTextViewResult;
export fn std_text_equal(left: StdTextView, right: StdTextView) -> bool;
export fn std_text_copy(view: StdTextView) -> StdOwnedTextResult;
export fn std_owned_text_view(text: StdOwnedText) -> StdTextViewResult;
export fn std_owned_text_append(text: StdOwnedText, suffix: StdTextView) -> StdOwnedTextResult;
export fn std_owned_text_release(text: StdOwnedText) -> runtime::Error;

