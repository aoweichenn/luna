export module luna.std.path;

import luna.runtime;
import luna.std.bytes;
import luna.std.text;

export struct StdPath {
    storage: StdByteBuffer;
    length: usize;
}

export struct StdPathResult {
    path: StdPath;
    error: RuntimeError;
}

export fn std_path_from_text(view: StdTextView) -> StdPathResult;
export fn std_path_from_c_string(
    data: *const u8,
    maximum_length: usize
) -> StdPathResult;
export fn std_path_is_valid(path: StdPath) -> bool;
export fn std_path_as_c_string(path: StdPath) -> *const u8;
export fn std_path_text(path: StdPath) -> StdTextViewResult;
export fn std_path_release(path: StdPath) -> RuntimeError;
