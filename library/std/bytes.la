module luna.std.bytes;

import luna.std.memory as memory;

const initial_capacity: usize = 64;

fn result(buffer: Buffer, error: runtime::Error) -> BufferResult {
    return {
        buffer = buffer, error = error,
    };
}

fn empty() -> Buffer {
    return {
        data = null, length = 0, capacity = 0,
    };
}

fn is_valid(buffer: Buffer) -> bool {
    if (buffer.capacity == 0) {
        return buffer.data == null && buffer.length == 0;
    }
    return buffer.data != null && buffer.length <= buffer.capacity;
}

fn with_capacity(capacity: usize) -> BufferResult {
    if (capacity == 0) {
        return result(empty(), runtime::Error.none);
    }

    let allocation: memory::AllocationResult = memory::allocate(capacity);
    if (allocation.error != runtime::Error.none) {
        return result(empty(), allocation.error);
    }
    return result(
        {
            data = allocation.allocation.address, length = 0, capacity = allocation.allocation.length,
        }, runtime::Error.none);
}

fn from(data: *const u8, length: usize) -> BufferResult {
    if (length != 0 && data == null) {
        return result(empty(), runtime::Error.bad_address);
    }
    let created: BufferResult = with_capacity(length);
    if (created.error != runtime::Error.none || length == 0) {
        return created;
    }

    let move_error: runtime::Error = memory::move(created.buffer.data, data, length);
    if (move_error != runtime::Error.none) {
        release(created.buffer);
        return result(empty(), move_error);
    }
    var updated: Buffer = created.buffer;
    updated.length = length;
    return result(updated, runtime::Error.none);
}

fn reserve(buffer: Buffer, minimum_capacity: usize) -> BufferResult {
    if (!is_valid(buffer)) {
        return result(buffer, runtime::Error.invalid_argument);
    }
    if (minimum_capacity <= buffer.capacity) {
        return result(buffer, runtime::Error.none);
    }

    var new_capacity: usize = buffer.capacity;
    if (new_capacity < initial_capacity) {
        new_capacity = initial_capacity;
    }
    while (new_capacity < minimum_capacity) {
        var doubled: usize = 0;
        if (@mul_overflow(new_capacity, 2, &doubled)) {
            new_capacity = minimum_capacity;
        } else {
            new_capacity = doubled;
        }
    }

    let resized: memory::AllocationResult = memory::resize(
        {
            address = buffer.data, length = buffer.capacity,
        }, new_capacity);
    if (resized.error != runtime::Error.none) {
        return result(buffer, resized.error);
    }
    return result(
        {
            data = resized.allocation.address, length = buffer.length, capacity = resized.allocation.length,
        }, runtime::Error.none);
}

fn push(buffer: Buffer, value: u8) -> BufferResult {
    if (!is_valid(buffer)) {
        return result(buffer, runtime::Error.invalid_argument);
    }
    var required: usize = 0;
    if (@add_overflow(buffer.length, 1, &required)) {
        return result(buffer, runtime::Error.out_of_memory);
    }

    let reserved: BufferResult = reserve(buffer, required);
    if (reserved.error != runtime::Error.none) {
        return reserved;
    }
    var updated: Buffer = reserved.buffer;
    updated.data[updated.length] = value;
    updated.length += 1;
    return result(updated, runtime::Error.none);
}

fn append(buffer: Buffer, data: *const u8, length: usize) -> BufferResult {
    if (!is_valid(buffer)) {
        return result(buffer, runtime::Error.invalid_argument);
    }
    if (length == 0) {
        return result(buffer, runtime::Error.none);
    }
    if (data == null) {
        return result(buffer, runtime::Error.bad_address);
    }
    var new_length: usize = 0;
    if (@add_overflow(buffer.length, length, &new_length)) {
        return result(buffer, runtime::Error.out_of_memory);
    }

    let source_address: *const u8 = data;
    let buffer_address: *const u8 = buffer.data as *const u8;
    var aliases_buffer: bool = false;
    var source_offset: usize = 0;
    if (buffer.capacity != 0 && source_address >= buffer_address) {
        source_offset = source_address - buffer_address;
        if (source_offset < buffer.capacity) {
            if (source_offset > buffer.length || length > buffer.length - source_offset) {
                return result(buffer, runtime::Error.invalid_argument);
            }
            aliases_buffer = true;
        }
    }

    let old_length: usize = buffer.length;
    let reserved: BufferResult = reserve(buffer, new_length);
    if (reserved.error != runtime::Error.none) {
        return reserved;
    }
    var updated: Buffer = reserved.buffer;
    let actual_source: *const u8 = aliases_buffer ? &updated.data[source_offset] as *const u8 : data;
    let move_error: runtime::Error = memory::move(&updated.data[old_length], actual_source, length);
    if (move_error != runtime::Error.none) {
        return result(updated, move_error);
    }
    updated.length = new_length;
    return result(updated, runtime::Error.none);
}

fn truncate(buffer: Buffer, length: usize) -> BufferResult {
    if (!is_valid(buffer) || length > buffer.length) {
        return result(buffer, runtime::Error.invalid_argument);
    }
    var updated: Buffer = buffer;
    updated.length = length;
    return result(updated, runtime::Error.none);
}

fn clear(buffer: Buffer) -> BufferResult {
    return truncate(buffer, 0);
}

fn release(buffer: Buffer) -> runtime::Error {
    if (!is_valid(buffer)) {
        return runtime::Error.invalid_argument;
    }
    return memory::release({
        address = buffer.data, length = buffer.capacity,
    });
}

fn equal(buffer: Buffer, data: *const u8, length: usize) -> bool {
    if (!is_valid(buffer) || buffer.length != length) {
        return false;
    }
    return memory::equal(buffer.data as *const u8, data, length);
}
