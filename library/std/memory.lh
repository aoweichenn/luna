export module luna.std.memory;

import luna.runtime;

export struct Allocation {
    address: *u8;
    length: usize;
}

export struct AllocationResult {
    allocation: Allocation;
    error: runtime::Error;
}

export fn allocate(length: usize) -> AllocationResult;
export fn resize(allocation: Allocation, new_length: usize) -> AllocationResult;
export fn release(allocation: Allocation) -> runtime::Error;
export fn move(destination: *u8, source: *const u8, length: usize) -> runtime::Error;
export fn fill(destination: *u8, value: u8, length: usize) -> runtime::Error;
export fn equal(left: *const u8, right: *const u8, length: usize) -> bool;

