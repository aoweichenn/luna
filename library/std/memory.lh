export module luna.std.memory;

import luna.runtime;

export struct StdAllocation {
    address: *u8;
    length: usize;
}

export struct StdAllocationResult {
    allocation: StdAllocation;
    error: runtime::Error;
}

export fn std_memory_allocate(length: usize) -> StdAllocationResult;
export fn std_memory_resize(allocation: StdAllocation, new_length: usize) -> StdAllocationResult;
export fn std_memory_release(allocation: StdAllocation) -> runtime::Error;
export fn std_memory_move(destination: *u8, source: *const u8, length: usize) -> runtime::Error;
export fn std_memory_fill(destination: *u8, value: u8, length: usize) -> runtime::Error;
export fn std_memory_equal(left: *const u8, right: *const u8, length: usize) -> bool;

