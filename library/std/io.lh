export module luna.std.io;

import luna.runtime;
import luna.std.bytes;
import luna.std.path as path;
import luna.std.text as text;

export fn write_all(file: runtime::File, data: *const u8, length: usize) -> runtime::Error;
export fn read_to_end(file: runtime::File, buffer: bytes::Buffer) -> bytes::BufferResult;
export fn read_to_end_limited(
    file: runtime::File, buffer: bytes::Buffer, maximum_length: usize) -> bytes::BufferResult;
export fn read_file(path: path::Path) -> bytes::BufferResult;
export fn read_file_limited(path: path::Path, maximum_length: usize) -> bytes::BufferResult;
export fn write_file(path: path::Path, data: *const u8, length: usize) -> runtime::Error;
export fn write_executable_file(path: path::Path, data: *const u8, length: usize) -> runtime::Error;
export fn write_file_atomic(path: path::Path, data: *const u8, length: usize) -> runtime::Error;
export fn write_executable_file_atomic(path: path::Path, data: *const u8, length: usize) -> runtime::Error;
export fn print(text: text::View) -> runtime::Error;
export fn print_error(text: text::View) -> runtime::Error;

