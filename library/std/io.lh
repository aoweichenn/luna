export module luna.std.io;

import luna.runtime;
import luna.std.bytes;
import luna.std.path;
import luna.std.text;

export fn std_io_write_all(file: runtime::File, data: *const u8, length: usize) -> runtime::Error;
export fn std_io_read_to_end(file: runtime::File, buffer: StdByteBuffer) -> StdByteBufferResult;
export fn std_io_read_to_end_limited(
    file: runtime::File, buffer: StdByteBuffer, maximum_length: usize) -> StdByteBufferResult;
export fn std_io_read_file(path: StdPath) -> StdByteBufferResult;
export fn std_io_read_file_limited(path: StdPath, maximum_length: usize) -> StdByteBufferResult;
export fn std_io_write_file(path: StdPath, data: *const u8, length: usize) -> runtime::Error;
export fn std_io_write_executable_file(path: StdPath, data: *const u8, length: usize) -> runtime::Error;
export fn std_io_write_file_atomic(path: StdPath, data: *const u8, length: usize) -> runtime::Error;
export fn std_io_write_executable_file_atomic(path: StdPath, data: *const u8, length: usize) -> runtime::Error;
export fn std_io_print(text: StdTextView) -> runtime::Error;
export fn std_io_print_error(text: StdTextView) -> runtime::Error;

