export module luna.std.bytes;

import luna.runtime;

export struct StdByteBuffer {
    data: *u8;
    length: usize;
    capacity: usize;
}

export struct StdByteBufferResult {
    buffer: StdByteBuffer;
    error: RuntimeError;
}

export fn std_byte_buffer_empty() -> StdByteBuffer;
export fn std_byte_buffer_is_valid(buffer: StdByteBuffer) -> bool;
export fn std_byte_buffer_with_capacity(capacity: usize) -> StdByteBufferResult;
export fn std_byte_buffer_from(data: *const u8, length: usize) -> StdByteBufferResult;
export fn std_byte_buffer_reserve(buffer: StdByteBuffer, minimum_capacity: usize) -> StdByteBufferResult;
export fn std_byte_buffer_push(buffer: StdByteBuffer, value: u8) -> StdByteBufferResult;
export fn std_byte_buffer_append(buffer: StdByteBuffer, data: *const u8, length: usize) -> StdByteBufferResult;
export fn std_byte_buffer_truncate(buffer: StdByteBuffer, length: usize) -> StdByteBufferResult;
export fn std_byte_buffer_clear(buffer: StdByteBuffer) -> StdByteBufferResult;
export fn std_byte_buffer_release(buffer: StdByteBuffer) -> RuntimeError;
export fn std_byte_buffer_equal(buffer: StdByteBuffer, data: *const u8, length: usize) -> bool;

