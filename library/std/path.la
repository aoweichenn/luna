module luna.std.path;

enum StdPathLimit: usize {
    maximum_size = 18446744073709551615,
}

fn std_path_empty() -> StdPath {
    return {
        storage = bytes::empty(), length = 0,
    };
}

fn std_path_result(path: StdPath, error: runtime::Error) -> StdPathResult {
    return {
        path = path, error = error,
    };
}

fn std_path_from_text(view: StdTextView) -> StdPathResult {
    if (!std_text_is_valid_utf8(view) || view.length == 0) {
        return std_path_result(std_path_empty(), runtime::Error.invalid_argument);
    }

    var index: usize = 0;
    while (index < view.length) {
        if (view.data[index] == 0) {
            return std_path_result(std_path_empty(), runtime::Error.invalid_argument);
        }
        index += 1;
    }

    let copied: bytes::BufferResult = bytes::from(view.data, view.length);
    if (copied.error != runtime::Error.none) {
        return std_path_result(std_path_empty(), copied.error);
    }
    let terminated: bytes::BufferResult = bytes::push(copied.buffer, 0);
    if (terminated.error != runtime::Error.none) {
        bytes::release(terminated.buffer);
        return std_path_result(std_path_empty(), terminated.error);
    }
    return std_path_result({ storage = terminated.buffer, length = view.length, }, runtime::Error.none);
}

fn std_path_from_c_string(data: *const u8, maximum_length: usize) -> StdPathResult {
    let view: StdTextViewResult = std_text_from_c_string(data, maximum_length);
    if (view.error != runtime::Error.none) {
        return std_path_result(std_path_empty(), view.error);
    }
    return std_path_from_text(view.view);
}

fn std_path_is_valid(path: StdPath) -> bool {
    if (!bytes::is_valid(path.storage) || path.length == 0 ||
        path.length == StdPathLimit.maximum_size as usize || path.storage.length != path.length + 1 ||
        path.storage.data[path.length] != 0) {
        return false;
    }

    var index: usize = 0;
    while (index < path.length) {
        if (path.storage.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return std_text_is_valid_utf8({
        data = path.storage.data as *const u8, length = path.length,
    });
}

fn std_path_as_c_string(path: StdPath) -> *const u8 {
    if (!std_path_is_valid(path)) {
        return null;
    }
    return path.storage.data as *const u8;
}

fn std_path_text(path: StdPath) -> StdTextViewResult {
    if (!std_path_is_valid(path)) {
        return {
            view = {
                data = null, length = 0,
            }, error = runtime::Error.invalid_argument,
        };
    }
    return std_text_view(path.storage.data as *const u8, path.length);
}

fn std_path_release(path: StdPath) -> runtime::Error {
    if (!std_path_is_valid(path)) {
        return runtime::Error.invalid_argument;
    }
    return bytes::release(path.storage);
}

