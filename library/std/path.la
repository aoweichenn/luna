module luna.std.path;

enum Limit: usize {
    maximum_size = 18446744073709551615,
}

fn empty() -> Path {
    return {
        storage = bytes::empty(), length = 0,
    };
}

fn result(path: Path, error: runtime::Error) -> PathResult {
    return {
        path = path, error = error,
    };
}

fn from_text(view: text::View) -> PathResult {
    if (!text::is_valid_utf8(view) || view.length == 0) {
        return result(empty(), runtime::Error.invalid_argument);
    }

    var index: usize = 0;
    while (index < view.length) {
        if (view.data[index] == 0) {
            return result(empty(), runtime::Error.invalid_argument);
        }
        index += 1;
    }

    let copied: bytes::BufferResult = bytes::from(view.data, view.length);
    if (copied.error != runtime::Error.none) {
        return result(empty(), copied.error);
    }
    let terminated: bytes::BufferResult = bytes::push(copied.buffer, 0);
    if (terminated.error != runtime::Error.none) {
        bytes::release(terminated.buffer);
        return result(empty(), terminated.error);
    }
    return result({ storage = terminated.buffer, length = view.length, }, runtime::Error.none);
}

fn from_c_string(data: *const u8, maximum_length: usize) -> PathResult {
    let view: text::ViewResult = text::from_c_string(data, maximum_length);
    if (view.error != runtime::Error.none) {
        return result(empty(), view.error);
    }
    return from_text(view.view);
}

fn is_valid(path: Path) -> bool {
    if (!bytes::is_valid(path.storage) || path.length == 0 ||
        path.length == Limit.maximum_size as usize || path.storage.length != path.length + 1 ||
        path.storage.data[path.length] != 0) {
        return false;
    }

    var index: usize = 0;
    while (index < path.length) {
        if (path.storage.data[index] == 0) {
            return false;
        }
        index += 1;
    }
    return text::is_valid_utf8({
        data = path.storage.data as *const u8, length = path.length,
    });
}

fn as_c_string(path: Path) -> *const u8 {
    if (!is_valid(path)) {
        return null;
    }
    return path.storage.data as *const u8;
}

fn text(path: Path) -> text::ViewResult {
    if (!is_valid(path)) {
        return {
            view = {
                data = null, length = 0,
            }, error = runtime::Error.invalid_argument,
        };
    }
    return text::view(path.storage.data as *const u8, path.length);
}

fn release(path: Path) -> runtime::Error {
    if (!is_valid(path)) {
        return runtime::Error.invalid_argument;
    }
    return bytes::release(path.storage);
}

