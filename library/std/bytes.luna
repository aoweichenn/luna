module luna.std.bytes;

import luna.std.memory;

enum StdByteBufferLimit: usize {
    minimum_capacity = 64, maximum_size = 18446744073709551615,
}

fn std_byte_buffer_result(buffer: StdByteBuffer, error: RuntimeError) -> StdByteBufferResult {
    return {
        buffer = buffer, error = error,
    };
}

fn std_byte_buffer_empty() -> StdByteBuffer {
    return {
        data = null, length = 0, capacity = 0,
    };
}

fn std_byte_buffer_is_valid(buffer: StdByteBuffer) -> bool {
    if (buffer.capacity == 0) {
        return buffer.data == null && buffer.length == 0;
    }
    return buffer.data != null && buffer.length <= buffer.capacity;
}

fn std_byte_buffer_with_capacity(capacity: usize) -> StdByteBufferResult {
    if (capacity == 0) {
        return std_byte_buffer_result(std_byte_buffer_empty(), RuntimeError.none);
    }

    let allocation: StdAllocationResult = std_memory_allocate(capacity);
    if (allocation.error != RuntimeError.none) {
        return std_byte_buffer_result(std_byte_buffer_empty(), allocation.error);
    }
    return std_byte_buffer_result(
        {
            data = allocation.allocation.address, length = 0, capacity = allocation.allocation.length,
        }, RuntimeError.none);
}

fn std_byte_buffer_from(data: *const u8, length: usize) -> StdByteBufferResult {
    if (length != 0 && data == null) {
        return std_byte_buffer_result(std_byte_buffer_empty(), RuntimeError.bad_address);
    }
    let created: StdByteBufferResult = std_byte_buffer_with_capacity(length);
    if (created.error != RuntimeError.none || length == 0) {
        return created;
    }

    let move_error: RuntimeError = std_memory_move(created.buffer.data, data, length);
    if (move_error != RuntimeError.none) {
        std_byte_buffer_release(created.buffer);
        return std_byte_buffer_result(std_byte_buffer_empty(), move_error);
    }
    var result: StdByteBuffer = created.buffer;
    result.length = length;
    return std_byte_buffer_result(result, RuntimeError.none);
}

fn std_byte_buffer_reserve(buffer: StdByteBuffer, minimum_capacity: usize) -> StdByteBufferResult {
    if (!std_byte_buffer_is_valid(buffer)) {
        return std_byte_buffer_result(buffer, RuntimeError.invalid_argument);
    }
    if (minimum_capacity <= buffer.capacity) {
        return std_byte_buffer_result(buffer, RuntimeError.none);
    }

    var new_capacity: usize = buffer.capacity;
    if (new_capacity < StdByteBufferLimit.minimum_capacity as usize) {
        new_capacity = StdByteBufferLimit.minimum_capacity as usize;
    }
    while (new_capacity < minimum_capacity) {
        if (new_capacity > (StdByteBufferLimit.maximum_size as usize) / 2) {
            new_capacity = minimum_capacity;
        } else {
            new_capacity *= 2;
        }
    }

    let resized: StdAllocationResult = std_memory_resize(
        {
            address = buffer.data, length = buffer.capacity,
        }, new_capacity);
    if (resized.error != RuntimeError.none) {
        return std_byte_buffer_result(buffer, resized.error);
    }
    return std_byte_buffer_result(
        {
            data = resized.allocation.address, length = buffer.length, capacity = resized.allocation.length,
        }, RuntimeError.none);
}

fn std_byte_buffer_push(buffer: StdByteBuffer, value: u8) -> StdByteBufferResult {
    if (!std_byte_buffer_is_valid(buffer)) {
        return std_byte_buffer_result(buffer, RuntimeError.invalid_argument);
    }
    if (buffer.length == StdByteBufferLimit.maximum_size as usize) {
        return std_byte_buffer_result(buffer, RuntimeError.out_of_memory);
    }

    let reserved: StdByteBufferResult = std_byte_buffer_reserve(buffer, buffer.length + 1);
    if (reserved.error != RuntimeError.none) {
        return reserved;
    }
    var result: StdByteBuffer = reserved.buffer;
    result.data[result.length] = value;
    result.length += 1;
    return std_byte_buffer_result(result, RuntimeError.none);
}

fn std_byte_buffer_append(buffer: StdByteBuffer, data: *const u8, length: usize) -> StdByteBufferResult {
    if (!std_byte_buffer_is_valid(buffer)) {
        return std_byte_buffer_result(buffer, RuntimeError.invalid_argument);
    }
    if (length == 0) {
        return std_byte_buffer_result(buffer, RuntimeError.none);
    }
    if (data == null) {
        return std_byte_buffer_result(buffer, RuntimeError.bad_address);
    }
    if (length > (StdByteBufferLimit.maximum_size as usize) - buffer.length) {
        return std_byte_buffer_result(buffer, RuntimeError.out_of_memory);
    }

    let source_address: usize = data as usize;
    let buffer_address: usize = buffer.data as usize;
    var aliases_buffer: bool = false;
    var source_offset: usize = 0;
    if (buffer.capacity != 0 && source_address >= buffer_address) {
        source_offset = source_address - buffer_address;
        if (source_offset < buffer.capacity) {
            if (source_offset >= buffer.length || length > buffer.length - source_offset) {
                return std_byte_buffer_result(buffer, RuntimeError.invalid_argument);
            }
            aliases_buffer = true;
        }
    }

    let old_length: usize = buffer.length;
    let reserved: StdByteBufferResult = std_byte_buffer_reserve(buffer, old_length + length);
    if (reserved.error != RuntimeError.none) {
        return reserved;
    }
    var result: StdByteBuffer = reserved.buffer;
    let actual_source: *const u8 = aliases_buffer ? &result.data[source_offset] as *const u8 : data;
    let move_error: RuntimeError = std_memory_move(&result.data[old_length], actual_source, length);
    if (move_error != RuntimeError.none) {
        return std_byte_buffer_result(result, move_error);
    }
    result.length = old_length + length;
    return std_byte_buffer_result(result, RuntimeError.none);
}

fn std_byte_buffer_truncate(buffer: StdByteBuffer, length: usize) -> StdByteBufferResult {
    if (!std_byte_buffer_is_valid(buffer) || length > buffer.length) {
        return std_byte_buffer_result(buffer, RuntimeError.invalid_argument);
    }
    var result: StdByteBuffer = buffer;
    result.length = length;
    return std_byte_buffer_result(result, RuntimeError.none);
}

fn std_byte_buffer_clear(buffer: StdByteBuffer) -> StdByteBufferResult {
    return std_byte_buffer_truncate(buffer, 0);
}

fn std_byte_buffer_release(buffer: StdByteBuffer) -> RuntimeError {
    if (!std_byte_buffer_is_valid(buffer)) {
        return RuntimeError.invalid_argument;
    }
    return std_memory_release({
        address = buffer.data, length = buffer.capacity,
    });
}

fn std_byte_buffer_equal(buffer: StdByteBuffer, data: *const u8, length: usize) -> bool {
    if (!std_byte_buffer_is_valid(buffer) || buffer.length != length) {
        return false;
    }
    return std_memory_equal(buffer.data as *const u8, data, length);
}

