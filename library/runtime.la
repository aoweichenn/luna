module luna.runtime;

import luna.linux.syscall;

enum LinuxSystemCall: usize {
    read = 0, write = 1, close = 3, map_memory = 9, unmap_memory = 11, process_id = 39, change_file_mode = 91,
    exit_group = 231, open_at = 257, remove_at = 263, rename_at = 264,
}

enum LinuxDescriptor: isize {
    invalid = -1, standard_input = 0, standard_output = 1, standard_error = 2, current_directory = -100,
}

enum LinuxOpenFlags: usize {
    read_only_close_on_exec = 524288, create_write_truncate_close_on_exec = 524865,
    create_write_exclusive_close_on_exec = 524481,
}

enum LinuxFileMode: usize {
    readable_writable = 438, executable = 493,
}

enum LinuxMemoryProtection: usize {
    read_write = 3,
}

enum LinuxMemoryFlags: usize {
    private_anonymous = 34,
}

enum LinuxAbiLimit: isize {
    maximum_error = 4095, maximum_descriptor = 2147483647,
}

fn error_from_raw(result: isize) -> Error {
    if (result >= 0) {
        return Error.none;
    }
    if (result < -(LinuxAbiLimit.maximum_error as isize)) {
        return Error.io;
    }
    return (-result) as Error;
}

fn invalid_file() -> File {
    return { descriptor = LinuxDescriptor.invalid as isize, };
}

fn file_result_from_raw(result: isize) -> FileResult {
    let error: Error = error_from_raw(result);
    if (error != Error.none) {
        return {
            file = invalid_file(), error = error,
        };
    }
    if (result > (LinuxAbiLimit.maximum_descriptor as isize)) {
        return {
            file = invalid_file(), error = Error.io,
        };
    }
    return {
        file = { descriptor = result, }, error = Error.none,
    };
}

fn io_result_from_raw(result: isize, maximum: usize) -> IoResult {
    let error: Error = error_from_raw(result);
    if (error != Error.none) {
        return {
            count = 0, error = error,
        };
    }

    let count: usize = result as usize;
    if (count > maximum) {
        return {
            count = 0, error = Error.io,
        };
    }
    return {
        count = count, error = Error.none,
    };
}

fn invalid_memory_result(error: Error)
    -> MemoryResult {
    return {
        memory = {
            address = null, length = 0,
        }, error = error,
    };
}

fn error_is_none(error: Error) -> bool {
    return error == Error.none;
}

fn process_id() -> ProcessIdResult {
    let result: isize = syscall::call0(LinuxSystemCall.process_id as usize);
    let error: Error = error_from_raw(result);
    if (error != Error.none) {
        return {
            process_id = 0, error = error,
        };
    }
    if (result == 0) {
        return {
            process_id = 0, error = Error.io,
        };
    }
    return {
        process_id = result as usize, error = Error.none,
    };
}

fn process_exit(status: i32) -> void {
    syscall::call1(LinuxSystemCall.exit_group as usize, status as isize as usize);
    while (true) {
    }
}

fn standard_input() -> File {
    return {
        descriptor = LinuxDescriptor.standard_input as isize,
    };
}

fn standard_output() -> File {
    return {
        descriptor = LinuxDescriptor.standard_output as isize,
    };
}

fn standard_error() -> File {
    return {
        descriptor = LinuxDescriptor.standard_error as isize,
    };
}

fn file_open_read(path: *const u8) -> FileResult {
    if (path == null) {
        return {
            file = invalid_file(), error = Error.bad_address,
        };
    }

    let result: isize = syscall::call4(
        LinuxSystemCall.open_at as usize, LinuxDescriptor.current_directory as isize as usize, path as usize,
        LinuxOpenFlags.read_only_close_on_exec as usize, 0);
    return file_result_from_raw(result);
}

fn file_create(path: *const u8) -> FileResult {
    if (path == null) {
        return {
            file = invalid_file(), error = Error.bad_address,
        };
    }

    let result: isize = syscall::call4(
        LinuxSystemCall.open_at as usize, LinuxDescriptor.current_directory as isize as usize, path as usize,
        LinuxOpenFlags.create_write_truncate_close_on_exec as usize, LinuxFileMode.readable_writable as usize);
    return file_result_from_raw(result);
}

fn file_create_exclusive(path: *const u8) -> FileResult {
    if (path == null) {
        return {
            file = invalid_file(), error = Error.bad_address,
        };
    }

    let result: isize = syscall::call4(
        LinuxSystemCall.open_at as usize, LinuxDescriptor.current_directory as isize as usize, path as usize,
        LinuxOpenFlags.create_write_exclusive_close_on_exec as usize, LinuxFileMode.readable_writable as usize);
    return file_result_from_raw(result);
}

fn file_make_executable(file: File) -> Error {
    if (file.descriptor < 0) {
        return Error.bad_descriptor;
    }
    return error_from_raw(
        syscall::call2(
            LinuxSystemCall.change_file_mode as usize, file.descriptor as usize, LinuxFileMode.executable as usize));
}

fn file_create_executable(path: *const u8) -> FileResult {
    if (path == null) {
        return {
            file = invalid_file(), error = Error.bad_address,
        };
    }
    let result: isize = syscall::call4(
        LinuxSystemCall.open_at as usize, LinuxDescriptor.current_directory as isize as usize, path as usize,
        LinuxOpenFlags.create_write_truncate_close_on_exec as usize, LinuxFileMode.executable as usize);
    let opened: FileResult = file_result_from_raw(result);
    if (opened.error != Error.none) {
        return opened;
    }
    let mode_error: Error = file_make_executable(opened.file);
    if (mode_error != Error.none) {
        file_close(opened.file);
        return {
            file = invalid_file(), error = mode_error,
        };
    }
    return opened;
}

fn file_close(file: File) -> Error {
    if (file.descriptor < 0) {
        return Error.bad_descriptor;
    }
    return error_from_raw(syscall::call1(LinuxSystemCall.close as usize, file.descriptor as usize));
}

fn file_read(file: File, buffer: *u8, length: usize) -> IoResult {
    if (file.descriptor < 0) {
        return {
            count = 0, error = Error.bad_descriptor,
        };
    }
    if (length == 0) {
        return {
            count = 0, error = Error.none,
        };
    }
    if (buffer == null) {
        return {
            count = 0, error = Error.bad_address,
        };
    }

    return io_result_from_raw(
        syscall::call3(LinuxSystemCall.read as usize, file.descriptor as usize, buffer as usize, length), length);
}

fn file_write(file: File, buffer: *const u8, length: usize) -> IoResult {
    if (file.descriptor < 0) {
        return {
            count = 0, error = Error.bad_descriptor,
        };
    }
    if (length == 0) {
        return {
            count = 0, error = Error.none,
        };
    }
    if (buffer == null) {
        return {
            count = 0, error = Error.bad_address,
        };
    }

    return io_result_from_raw(
        syscall::call3(LinuxSystemCall.write as usize, file.descriptor as usize, buffer as usize, length), length);
}

fn path_replace(source: *const u8, destination: *const u8) -> Error {
    if (source == null || destination == null) {
        return Error.bad_address;
    }
    return error_from_raw(
        syscall::call4(
            LinuxSystemCall.rename_at as usize, LinuxDescriptor.current_directory as isize as usize, source as usize,
            LinuxDescriptor.current_directory as isize as usize, destination as usize));
}

fn path_remove(path: *const u8) -> Error {
    if (path == null) {
        return Error.bad_address;
    }
    return error_from_raw(
        syscall::call3(
            LinuxSystemCall.remove_at as usize, LinuxDescriptor.current_directory as isize as usize, path as usize, 0));
}

fn memory_map(length: usize) -> MemoryResult {
    if (length == 0) {
        return invalid_memory_result(Error.invalid_argument);
    }

    let result: isize = syscall::call6(
        LinuxSystemCall.map_memory as usize, 0, length, LinuxMemoryProtection.read_write as usize,
        LinuxMemoryFlags.private_anonymous as usize, LinuxDescriptor.invalid as isize as usize, 0);
    let error: Error = error_from_raw(result);
    if (error != Error.none) {
        return invalid_memory_result(error);
    }
    if (result == 0) {
        syscall::call2(LinuxSystemCall.unmap_memory as usize, 0, length);
        return invalid_memory_result(Error.io);
    }
    return {
        memory = {
            address = result as usize as *u8, length = length,
        }, error = Error.none,
    };
}

fn memory_unmap(memory: Memory) -> Error {
    if (memory.address == null || memory.length == 0) {
        return Error.invalid_argument;
    }
    return error_from_raw(
        syscall::call2(LinuxSystemCall.unmap_memory as usize, memory.address as usize, memory.length));
}

