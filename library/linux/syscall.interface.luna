export module luna.linux.syscall;

export extern fn luna_linux_syscall0(number: usize) -> isize;
export extern fn luna_linux_syscall1(number: usize, argument0: usize) -> isize;
export extern fn luna_linux_syscall2(number: usize, argument0: usize, argument1: usize) -> isize;
export extern fn luna_linux_syscall3(number: usize, argument0: usize, argument1: usize, argument2: usize) -> isize;
export extern fn luna_linux_syscall4(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize) -> isize;
export extern fn luna_linux_syscall5(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize, argument4: usize) -> isize;
export extern fn luna_linux_syscall6(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize, argument4: usize,
    argument5: usize) -> isize;

