module luna.linux.syscall;

// Direct Linux syscall stubs. Each stub moves the System V argument
// registers into the kernel register ABI — the fourth C argument arrives
// in %rcx but the kernel expects it in %r10 — loads the syscall number
// into %rax and executes `syscall`. The bodies are naked asm fn text: no
// prologue, epilogue or ret is emitted, so the sixth argument of
// call6 is read from the stack exactly where the caller
// placed it. The @export_name symbols are the ABI contract that extern
// fn consumers (runtime, tests, FFI shims) resolve by name.

@export_name("luna_linux_syscall0")
asm fn call0(number: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    syscall\n"
    "    ret\n"
}

@export_name("luna_linux_syscall1")
asm fn call1(number: usize, argument0: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    movq %rsi, %rdi\n"
    "    syscall\n"
    "    ret\n"
}

@export_name("luna_linux_syscall2")
asm fn call2(number: usize, argument0: usize, argument1: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    movq %rsi, %rdi\n"
    "    movq %rdx, %rsi\n"
    "    syscall\n"
    "    ret\n"
}

@export_name("luna_linux_syscall3")
asm fn call3(number: usize, argument0: usize, argument1: usize, argument2: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    movq %rsi, %rdi\n"
    "    movq %rdx, %rsi\n"
    "    movq %rcx, %rdx\n"
    "    syscall\n"
    "    ret\n"
}

@export_name("luna_linux_syscall4")
asm fn call4(number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    movq %rsi, %rdi\n"
    "    movq %rdx, %rsi\n"
    "    movq %rcx, %rdx\n"
    "    movq %r8, %r10\n"
    "    syscall\n"
    "    ret\n"
}

@export_name("luna_linux_syscall5")
asm fn call5(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize, argument4: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    movq %rsi, %rdi\n"
    "    movq %rdx, %rsi\n"
    "    movq %rcx, %rdx\n"
    "    movq %r8, %r10\n"
    "    movq %r9, %r8\n"
    "    syscall\n"
    "    ret\n"
}

@export_name("luna_linux_syscall6")
asm fn call6(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize, argument4: usize,
    argument5: usize) -> isize {
    "    movq %rdi, %rax\n"
    "    movq %rsi, %rdi\n"
    "    movq %rdx, %rsi\n"
    "    movq %rcx, %rdx\n"
    "    movq %r8, %r10\n"
    "    movq %r9, %r8\n"
    "    movq 8(%rsp), %r9\n"
    "    syscall\n"
    "    ret\n"
}
