export module luna.linux.syscall;

export fn call0(number: usize) -> isize;
export fn call1(number: usize, argument0: usize) -> isize;
export fn call2(number: usize, argument0: usize, argument1: usize) -> isize;
export fn call3(number: usize, argument0: usize, argument1: usize, argument2: usize) -> isize;
export fn call4(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize) -> isize;
export fn call5(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize, argument4: usize) -> isize;
export fn call6(
    number: usize, argument0: usize, argument1: usize, argument2: usize, argument3: usize, argument4: usize,
    argument5: usize) -> isize;
