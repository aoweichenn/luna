export module luna.std.buffer;

import luna.runtime;

export class byte_buffer {
    priv data_pointer: *u8;
    priv size_bytes: usize;
    priv capacity_bytes: usize;

    pub init();
    pub init(other: byte_buffer&&);
    pub operator =(other: byte_buffer&&);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn capacity() const -> usize;
    pub fn data() -> *u8;
    pub fn data() const -> *const u8;
    pub fn reserve(minimum_capacity: usize) -> runtime::Error;
    pub fn append(data: *const u8, length: usize) -> runtime::Error;
    pub fn push_back(value: u8) -> runtime::Error;
    pub fn truncate(length: usize) -> runtime::Error;
    pub fn clear();
    pub fn release() -> runtime::Error;
    pub deinit();
}
