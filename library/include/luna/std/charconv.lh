export module luna.std.charconv;

import luna.runtime;

export struct to_chars_result {
    ptr: *u8;
    error: runtime::Error;
}

export fn to_chars(first: *u8, last: *u8, value: u64, base: usize = 10) -> to_chars_result;
export fn to_chars(first: *u8, last: *u8, value: i64, base: usize = 10) -> to_chars_result;
export fn to_chars(first: *u8, last: *u8, value: usize, base: usize = 10) -> to_chars_result;
export fn to_chars(first: *u8, last: *u8, value: isize, base: usize = 10) -> to_chars_result;
