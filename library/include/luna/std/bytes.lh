export module luna.std.bytes;

import luna.runtime;

export struct Buffer {
    data: *u8;
    length: usize;
    capacity: usize;
}

export struct BufferResult {
    buffer: Buffer;
    error: runtime::Error;
}

export fn empty() -> Buffer;
export fn is_valid(buffer: Buffer) -> bool;
export fn with_capacity(capacity: usize) -> BufferResult;
export fn from(data: *const u8, length: usize) -> BufferResult;
export fn reserve(buffer: Buffer, minimum_capacity: usize) -> BufferResult;
export fn push(buffer: Buffer, value: u8) -> BufferResult;
export fn append(buffer: Buffer, data: *const u8, length: usize) -> BufferResult;
export fn truncate(buffer: Buffer, length: usize) -> BufferResult;
export fn clear(buffer: Buffer) -> BufferResult;
export fn release(buffer: Buffer) -> runtime::Error;
export fn equal(buffer: Buffer, data: *const u8, length: usize) -> bool;

