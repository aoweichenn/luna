export module luna.std.string;

import luna.runtime;
import luna.std.buffer as buffer;
import luna.std.string_view as string_views;

export class string {
    priv storage: buffer::byte_buffer;
    priv empty_sentinel: u8;

    pub init();
    pub init(other: string&&);
    pub operator =(other: string&&);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn capacity() const -> usize;
    pub fn data() -> *u8;
    pub fn data() const -> *const u8;
    pub fn reserve(minimum_capacity: usize) -> runtime::Error;
    pub fn append(data: *const u8, length: usize) -> runtime::Error;
    pub fn append(view: string_views::string_view) -> runtime::Error;
    pub fn push_back(value: u8) -> runtime::Error;
    pub fn clear();
    pub fn view() const -> string_views::string_view_result;
    pub fn detach() -> *u8;
    pub deinit();
}
