export module luna.std.map;

import luna.internal.tree as tree;
import luna.runtime;

export struct map_insert_result<Value> {
    value: *Value;
    inserted: bool;
    error: runtime::Error;
}

export struct map_erase_result {
    erased: bool;
    error: runtime::Error;
}

export class map<Key, Value> {
    priv index: tree::ordered_tree<Key, Value>;

    pub init();
    pub init(other: map<Key, Value>&&);
    pub operator =(other: map<Key, Value>&&);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn find(key: Key const&) -> *Value;
    pub fn find(key: Key const&) const -> *const Value;
    pub fn contains(key: Key const&) const -> bool;
    pub fn insert(key: Key, value: Value) -> map_insert_result<Value>;
    pub fn insert_or_assign(key: Key, value: Value) -> map_insert_result<Value>;
    pub fn erase(key: Key const&) -> map_erase_result;
    pub fn clear();
    pub deinit();
}

impl map {
    init(): index = tree::ordered_tree<Key, Value>() {
        assert(@is_trivially_relocatable(Key));
        assert(@is_trivially_relocatable(Value));
    }

    init(other: map<Key, Value>&&): index = other.index as tree::ordered_tree<Key, Value>&& {
        assert(@is_trivially_relocatable(Key));
        assert(@is_trivially_relocatable(Value));
    }

    operator =(other: map<Key, Value>&&) {
        this->index = other.index as tree::ordered_tree<Key, Value>&&;
    }

    fn is_valid() const -> bool {
        return this->index.is_valid();
    }

    fn empty() const -> bool {
        return this->index.empty();
    }

    fn size() const -> usize {
        return this->index.size();
    }

    fn find(key: Key const&) -> *Value {
        return this->index.find(key);
    }

    fn find(key: Key const&) const -> *const Value {
        return this->index.find(key);
    }

    fn contains(key: Key const&) const -> bool {
        return this->index.contains(key);
    }

    fn insert(key: Key, value: Value) -> map_insert_result<Value> {
        let result: tree::tree_insert_result<Value> = this->index.insert(key, value);
        return { value = result.value, inserted = result.inserted, error = result.error };
    }

    fn insert_or_assign(key: Key, value: Value) -> map_insert_result<Value> {
        let result: tree::tree_insert_result<Value> = this->index.insert_or_assign(key, value);
        return { value = result.value, inserted = result.inserted, error = result.error };
    }

    fn erase(key: Key const&) -> map_erase_result {
        let result: tree::tree_erase_result = this->index.erase(key);
        return { erased = result.erased, error = result.error };
    }

    fn clear() {
        this->index.clear();
    }

    deinit() {
    }
}
