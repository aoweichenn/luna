export module luna.std.string_view;

import luna.runtime;

export struct string_view {
    data: *const u8;
    length: usize;
}

export struct string_view_result {
    view: string_view;
    error: runtime::Error;
}

export fn from_bytes(data: *const u8, length: usize) -> string_view_result;
export fn from_c_string(data: *const u8, maximum_length: usize) -> string_view_result;
export fn is_valid_utf8(view: string_view) -> bool;
export fn substr(source: string_view, offset: usize, length: usize) -> string_view_result;
export fn equal(left: string_view, right: string_view) -> bool;
