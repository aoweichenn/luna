export module luna.std.path;

import luna.runtime;
import luna.std.bytes as bytes;
import luna.std.string_view as string_views;

export struct Path {
    storage: bytes::Buffer;
    length: usize;
}

export struct PathResult {
    path: Path;
    error: runtime::Error;
}

export fn from_string_view(view: string_views::string_view) -> PathResult;
export fn from_c_string(data: *const u8, maximum_length: usize) -> PathResult;
export fn is_valid(path: Path) -> bool;
export fn as_c_string(path: Path) -> *const u8;
export fn view(path: Path) -> string_views::string_view_result;
export fn release(path: Path) -> runtime::Error;
