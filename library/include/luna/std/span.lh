export module luna.std.span;

export class const_span<Value> {
    priv data_pointer: *const Value;
    priv element_count: usize;

    pub init(data: *const Value, count: usize);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn data() const -> *const Value;
    pub fn get(index: usize) const -> Value const&;
    pub fn subspan(offset: usize, count: usize) const -> const_span<Value>;
}

impl const_span {
    init(data: *const Value, count: usize) {
        this->data_pointer = data;
        this->element_count = count;
    }

    fn is_valid() const -> bool {
        return this->data_pointer != null || this->element_count == 0;
    }

    fn empty() const -> bool {
        return this->element_count == 0;
    }

    fn size() const -> usize {
        return this->element_count;
    }

    fn data() const -> *const Value {
        return this->data_pointer;
    }

    fn get(index: usize) const -> Value const& {
        return this->data_pointer[index];
    }

    fn subspan(offset: usize, count: usize) const -> const_span<Value> {
        let slice_data: *const Value = this->data_pointer == null ? null : this->data_pointer + offset;
        return const_span<Value>(slice_data, count);
    }
}

export class span<Value> {
    priv data_pointer: *Value;
    priv element_count: usize;

    pub init(data: *Value, count: usize);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn data() -> *Value;
    pub fn data() const -> *const Value;
    pub fn get(index: usize) -> Value&;
    pub fn get(index: usize) const -> Value const&;
    pub fn as_const() const -> const_span<Value>;
    pub fn subspan(offset: usize, count: usize) -> span<Value>;
    pub fn subspan(offset: usize, count: usize) const -> const_span<Value>;
}

impl span {
    init(data: *Value, count: usize) {
        this->data_pointer = data;
        this->element_count = count;
    }

    fn is_valid() const -> bool {
        return this->data_pointer != null || this->element_count == 0;
    }

    fn empty() const -> bool {
        return this->element_count == 0;
    }

    fn size() const -> usize {
        return this->element_count;
    }

    fn data() -> *Value {
        return this->data_pointer;
    }

    fn data() const -> *const Value {
        return this->data_pointer as *const Value;
    }

    fn get(index: usize) -> Value& {
        return this->data_pointer[index];
    }

    fn get(index: usize) const -> Value const& {
        return this->data_pointer[index];
    }

    fn as_const() const -> const_span<Value> {
        return const_span<Value>(this->data_pointer as *const Value, this->element_count);
    }

    fn subspan(offset: usize, count: usize) -> span<Value> {
        let slice_data: *Value = this->data_pointer == null ? null : this->data_pointer + offset;
        return span<Value>(slice_data, count);
    }

    fn subspan(offset: usize, count: usize) const -> const_span<Value> {
        return this->as_const().subspan(offset, count);
    }
}
