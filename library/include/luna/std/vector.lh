export module luna.std.vector;

import luna.runtime;
import luna.std.buffer as buffer;
import luna.std.span as span;

export class vector<Value> {
    priv storage: buffer::byte_buffer;

    pub init();
    pub init(other: vector<Value>&&);
    pub operator =(other: vector<Value>&&);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn capacity() const -> usize;
    pub fn reserve(minimum_capacity: usize) -> runtime::Error;
    pub fn push_back(value: Value) -> runtime::Error;
    pub fn truncate(length: usize) -> runtime::Error;
    pub fn clear();
    pub fn get(index: usize) -> Value&;
    pub fn get(index: usize) const -> Value const&;
    pub fn as_span() -> span::span<Value>;
    pub fn as_span() const -> span::const_span<Value>;
    pub deinit();
}

impl vector {
    init(): storage = buffer::byte_buffer() {
        assert(@is_trivially_relocatable(Value));
    }

    init(other: vector<Value>&&): storage = other.storage as buffer::byte_buffer&& {
        assert(@is_trivially_relocatable(Value));
    }

    operator =(other: vector<Value>&&) {
        this->storage = other.storage as buffer::byte_buffer&&;
    }

    fn is_valid() const -> bool {
        return this->storage.is_valid() && this->storage.size() % sizeof(Value) == 0;
    }

    fn empty() const -> bool {
        return this->storage.empty();
    }

    fn size() const -> usize {
        return this->storage.size() / sizeof(Value);
    }

    fn capacity() const -> usize {
        return this->storage.capacity() / sizeof(Value);
    }

    fn reserve(minimum_capacity: usize) -> runtime::Error {
        if (!this->is_valid()) {
            return runtime::Error.invalid_argument;
        }
        var minimum_bytes: usize = 0;
        if (@mul_overflow(minimum_capacity, sizeof(Value), &minimum_bytes)) {
            return runtime::Error.out_of_memory;
        }
        return this->storage.reserve(minimum_bytes);
    }

    fn push_back(value: Value) -> runtime::Error {
        if (!this->is_valid()) {
            return runtime::Error.invalid_argument;
        }
        return this->storage.append((&value) as *const Value as *const u8, sizeof(Value));
    }

    fn truncate(length: usize) -> runtime::Error {
        if (length > this->size()) {
            return runtime::Error.invalid_argument;
        }
        var byte_length: usize = 0;
        if (@mul_overflow(length, sizeof(Value), &byte_length)) {
            return runtime::Error.out_of_memory;
        }
        return this->storage.truncate(byte_length);
    }

    fn clear() {
        this->storage.clear();
    }

    fn get(index: usize) -> Value& {
        let data: *Value = this->storage.data() as *Value;
        return data[index];
    }

    fn get(index: usize) const -> Value const& {
        let data: *const Value = this->storage.data() as *const Value;
        return data[index];
    }

    fn as_span() -> span::span<Value> {
        return span::span<Value>(this->storage.data() as *Value, this->size());
    }

    fn as_span() const -> span::const_span<Value> {
        return span::const_span<Value>(this->storage.data() as *const Value, this->size());
    }

    deinit() {
    }
}
