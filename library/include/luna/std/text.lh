export module luna.std.text;

import luna.runtime;
import luna.std.bytes as bytes;

export struct View {
    data: *const u8;
    length: usize;
}

export struct ViewResult {
    view: View;
    error: runtime::Error;
}

export struct Owned {
    buffer: bytes::Buffer;
}

export struct OwnedResult {
    text: Owned;
    error: runtime::Error;
}

export fn view(data: *const u8, length: usize) -> ViewResult;
export fn from_c_string(data: *const u8, maximum_length: usize) -> ViewResult;
export fn is_valid_utf8(view: View) -> bool;
export fn slice(source: View, offset: usize, length: usize) -> ViewResult;
export fn equal(left: View, right: View) -> bool;
export fn copy(view: View) -> OwnedResult;
export fn owned_view(text: Owned) -> ViewResult;
export fn owned_append(text: Owned, suffix: View) -> OwnedResult;
export fn owned_release(text: Owned) -> runtime::Error;

