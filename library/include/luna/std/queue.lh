export module luna.std.queue;

import luna.runtime;
import luna.std.deque::{deque};

export class queue<Value> {
    priv container: deque<Value>;

    pub init();
    pub init(other: queue<Value>&&);
    pub operator =(other: queue<Value>&&);
    pub fn is_valid() const -> bool;
    pub fn empty() const -> bool;
    pub fn size() const -> usize;
    pub fn front() -> Value&;
    pub fn front() const -> Value const&;
    pub fn back() -> Value&;
    pub fn back() const -> Value const&;
    pub fn push(value: Value) -> runtime::Error;
    pub fn pop() -> runtime::Error;
    pub fn clear();
    pub deinit();
}

impl queue {
    init(): container = deque<Value>() {
        assert(@is_trivially_relocatable(Value));
    }

    init(other: queue<Value>&&): container = other.container as deque<Value>&& {
        assert(@is_trivially_relocatable(Value));
    }

    operator =(other: queue<Value>&&) {
        this->container = other.container as deque<Value>&&;
    }

    fn is_valid() const -> bool {
        return this->container.is_valid();
    }

    fn empty() const -> bool {
        return this->container.empty();
    }

    fn size() const -> usize {
        return this->container.size();
    }

    fn front() -> Value& {
        return this->container.front();
    }

    fn front() const -> Value const& {
        return this->container.front();
    }

    fn back() -> Value& {
        return this->container.back();
    }

    fn back() const -> Value const& {
        return this->container.back();
    }

    fn push(value: Value) -> runtime::Error {
        return this->container.push_back(value);
    }

    fn pop() -> runtime::Error {
        return this->container.pop_front();
    }

    fn clear() {
        this->container.clear();
    }

    deinit() {
    }
}
