export module luna.std.binary;

import luna.std.bytes as bytes;

export fn read_u16(data: *const u8, length: usize, offset: usize, result: *u16) -> bool;
export fn read_u32(data: *const u8, length: usize, offset: usize, result: *u32) -> bool;
export fn read_u64(data: *const u8, length: usize, offset: usize, result: *u64) -> bool;
export fn append_u8(output: *bytes::Buffer, value: u8) -> bool;
export fn append_u16(output: *bytes::Buffer, value: u16) -> bool;
export fn append_u32(output: *bytes::Buffer, value: u32) -> bool;
export fn append_u64(output: *bytes::Buffer, value: u64) -> bool;
export fn store_u32(destination: *u8, value: u32) -> bool;
export fn store_u64(destination: *u8, value: u64) -> bool;
