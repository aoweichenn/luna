export module luna.runtime;

export enum Error: isize {
    none = 0, operation_not_permitted = 1, not_found = 2, interrupted = 4, io = 5, bad_descriptor = 9, would_block = 11,
    out_of_memory = 12, permission_denied = 13, bad_address = 14, exists = 17, not_directory = 20, is_directory = 21,
    invalid_argument = 22, too_many_open_files = 24, no_space = 28, broken_pipe = 32, name_too_long = 36,
    not_supported = 95,
}

export struct File {
    descriptor: isize;
}

export struct Memory {
    address: *u8;
    length: usize;
}

export struct IoResult {
    count: usize;
    error: Error;
}

export struct FileResult {
    file: File;
    error: Error;
}

export struct MemoryResult {
    memory: Memory;
    error: Error;
}

export struct ProcessIdResult {
    process_id: usize;
    error: Error;
}

export fn error_is_none(error: Error) -> bool;
export fn process_id() -> ProcessIdResult;
export fn process_exit(status: i32) -> void;

export fn standard_input() -> File;
export fn standard_output() -> File;
export fn standard_error() -> File;
export fn file_open_read(path: *const u8) -> FileResult;
export fn file_create(path: *const u8) -> FileResult;
export fn file_create_exclusive(path: *const u8) -> FileResult;
export fn file_create_executable(path: *const u8) -> FileResult;
export fn file_make_executable(file: File) -> Error;
export fn file_close(file: File) -> Error;
export fn file_read(file: File, buffer: *u8, length: usize) -> IoResult;
export fn file_write(file: File, buffer: *const u8, length: usize) -> IoResult;
export fn path_replace(source: *const u8, destination: *const u8) -> Error;
export fn path_remove(path: *const u8) -> Error;

export fn memory_map(length: usize) -> MemoryResult;
export fn memory_unmap(memory: Memory) -> Error;

