export module luna.internal.pool;

import luna.runtime;
import luna.std.buffer as buffer;

struct storage_allocation {
    address: *u8;
    error: runtime::Error;
}

class slot_storage {
    priv blocks: buffer::byte_buffer;
    priv free_slots: buffer::byte_buffer;
    priv slot_size: usize;
    priv live_slots: usize;

    pub init(slot_size: usize);
    pub init(other: slot_storage&&);
    pub operator =(other: slot_storage&&);
    pub fn is_valid() const -> bool;
    pub fn size() const -> usize;
    pub fn allocate() -> storage_allocation;
    pub fn owns(address: *const u8) const -> bool;
    pub fn deallocate(address: *u8) -> runtime::Error;
    pub deinit();
}

export struct pool_allocation<Value> {
    address: *Value;
    error: runtime::Error;
}

export class slot_pool<Value> {
    priv storage: slot_storage;

    pub init();
    pub init(other: slot_pool<Value>&&);
    pub operator =(other: slot_pool<Value>&&);
    pub fn is_valid() const -> bool;
    pub fn size() const -> usize;
    pub fn allocate() -> pool_allocation<Value>;
    pub fn owns(address: *const Value) const -> bool;
    pub fn deallocate(address: *Value) -> runtime::Error;
    pub deinit();
}

impl slot_pool {
    init(): storage = slot_storage(sizeof(Value)) {
        assert(@is_trivially_relocatable(Value));
    }

    init(other: slot_pool<Value>&&): storage = other.storage as slot_storage&& {
        assert(@is_trivially_relocatable(Value));
    }

    operator =(other: slot_pool<Value>&&) {
        this->storage = other.storage as slot_storage&&;
    }

    fn is_valid() const -> bool {
        return this->storage.is_valid();
    }

    fn size() const -> usize {
        return this->storage.size();
    }

    fn allocate() -> pool_allocation<Value> {
        let result: storage_allocation = this->storage.allocate();
        return { address = result.address as *Value, error = result.error };
    }

    fn owns(address: *const Value) const -> bool {
        return this->storage.owns(address as *const u8);
    }

    fn deallocate(address: *Value) -> runtime::Error {
        return this->storage.deallocate(address as *u8);
    }

    deinit() {
    }
}
