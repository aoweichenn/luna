module luna.std.text;

fn empty_view() -> View {
    return {
        data = null, length = 0,
    };
}

fn view_result(view: View, error: runtime::Error) -> ViewResult {
    return {
        view = view, error = error,
    };
}

fn owned_result(text: Owned, error: runtime::Error) -> OwnedResult {
    return {
        text = text, error = error,
    };
}

fn is_continuation(byte: u8) -> bool {
    return byte >= 128 && byte <= 191;
}

fn utf8_sequence_length(first: u8) -> usize {
    if (first <= 127) {
        return 1;
    }
    if (first >= 194 && first <= 223) {
        return 2;
    }
    if (first >= 224 && first <= 239) {
        return 3;
    }
    if (first >= 240 && first <= 244) {
        return 4;
    }
    return 0;
}

fn second_byte_is_valid(first: u8, second: u8) -> bool {
    switch (first) {
    case 224 {
        return second >= 160 && second <= 191;
    }
    case 237 {
        return second >= 128 && second <= 159;
    }
    case 240 {
        return second >= 144 && second <= 191;
    }
    case 244 {
        return second >= 128 && second <= 143;
    }
    default {
        return is_continuation(second);
    }
    }
}

fn sequence_is_valid(view: View, offset: usize, length: usize) -> bool {
    if (view.length - offset < length) {
        return false;
    }
    if (length == 1) {
        return true;
    }
    if (!second_byte_is_valid(view.data[offset], view.data[offset + 1])) {
        return false;
    }
    for (var index: usize = 2; index < length; index += 1) {
        if (!is_continuation(view.data[offset + index])) {
            return false;
        }
    }
    return true;
}

fn is_valid_utf8(view: View) -> bool {
    if (view.length == 0) {
        return true;
    }
    if (view.data == null) {
        return false;
    }

    for (var index: usize = 0; index < view.length;) {
        let first: u8 = view.data[index];
        let sequence_length: usize = utf8_sequence_length(first);
        if (sequence_length == 0 || !sequence_is_valid(view, index, sequence_length)) {
            return false;
        }
        index += sequence_length;
    }
    return true;
}

fn view(data: *const u8, length: usize) -> ViewResult {
    let view: View = {
        data = data, length = length,
    };
    if (length != 0 && data == null) {
        return view_result(empty_view(), runtime::Error.bad_address);
    }
    if (!is_valid_utf8(view)) {
        return view_result(empty_view(), runtime::Error.invalid_argument);
    }
    return view_result(view, runtime::Error.none);
}

fn from_c_string(data: *const u8, maximum_length: usize) -> ViewResult {
    if (data == null) {
        return view_result(empty_view(), runtime::Error.bad_address);
    }

    var length: usize = 0;
    for (; length < maximum_length && data[length] != 0; length += 1) {}
    if (length == maximum_length) {
        return view_result(empty_view(), runtime::Error.name_too_long);
    }
    return view(data, length);
}

fn slice(source: View, offset: usize, length: usize) -> ViewResult {
    if (!is_valid_utf8(source) || offset > source.length) {
        return view_result(empty_view(), runtime::Error.invalid_argument);
    }
    if (length > source.length - offset) {
        return view_result(empty_view(), runtime::Error.invalid_argument);
    }
    if (length == 0) {
        return view_result(empty_view(), runtime::Error.none);
    }
    return view(&source.data[offset], length);
}

fn equal(left: View, right: View) -> bool {
    if (!is_valid_utf8(left) || !is_valid_utf8(right)) {
        return false;
    }
    if (left.length != right.length) {
        return false;
    }
    if (left.length == 0) {
        return true;
    }

    for (var index: usize = 0; index < left.length; index += 1) {
        if (left.data[index] != right.data[index]) {
            return false;
        }
    }
    return true;
}

fn copy(view: View) -> OwnedResult {
    if (!is_valid_utf8(view)) {
        return owned_result({ buffer = bytes::empty(), }, runtime::Error.invalid_argument);
    }
    let copied: bytes::BufferResult = bytes::from(view.data, view.length);
    return owned_result({ buffer = copied.buffer, }, copied.error);
}

fn owned_view(text: Owned) -> ViewResult {
    if (!bytes::is_valid(text.buffer)) {
        return view_result(empty_view(), runtime::Error.invalid_argument);
    }
    return view(text.buffer.data as *const u8, text.buffer.length);
}

fn owned_append(text: Owned, suffix: View) -> OwnedResult {
    let current: ViewResult = owned_view(text);
    if (current.error != runtime::Error.none || !is_valid_utf8(suffix)) {
        return owned_result(text, runtime::Error.invalid_argument);
    }

    let appended: bytes::BufferResult = bytes::append(text.buffer, suffix.data, suffix.length);
    return owned_result({ buffer = appended.buffer, }, appended.error);
}

fn owned_release(text: Owned) -> runtime::Error {
    return bytes::release(text.buffer);
}
