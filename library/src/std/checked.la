module luna.std.checked;

fn add(left: usize, right: usize, result: *usize) -> bool {
    return result != null && !@add_overflow(left, right, result);
}

fn is_power_of_two(value: usize) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

fn align_up(value: usize, alignment: usize, result: *usize) -> bool {
    if (result == null || !is_power_of_two(alignment)) {
        return false;
    }
    let mask = alignment - 1;
    var rounded: usize = 0;
    if (!add(value, mask, &rounded)) {
        return false;
    }
    *result = rounded & ~mask;
    return true;
}

fn range_is_valid(offset: usize, length: usize, total: usize) -> bool {
    return offset <= total && length <= total - offset;
}
