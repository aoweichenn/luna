module luna.std.memory;

fn empty_allocation() -> Allocation {
    return {
        address = null, length = 0,
    };
}

fn invalid_result(allocation: Allocation, error: runtime::Error) -> AllocationResult {
    return {
        allocation = allocation, error = error,
    };
}

fn allocation_is_valid(allocation: Allocation) -> bool {
    let is_empty: bool = allocation.address == null && allocation.length == 0;
    let is_allocated: bool = allocation.address != null && allocation.length != 0;
    return is_empty || is_allocated;
}

fn allocate(length: usize) -> AllocationResult {
    if (length == 0) {
        return {
            allocation = empty_allocation(), error = runtime::Error.none,
        };
    }

    let mapped: runtime::MemoryResult = runtime::memory_map(length);
    if (mapped.error != runtime::Error.none) {
        return invalid_result(empty_allocation(), mapped.error);
    }
    return {
        allocation = {
            address = mapped.memory.address, length = mapped.memory.length,
        }, error = runtime::Error.none,
    };
}

fn resize(allocation: Allocation, new_length: usize) -> AllocationResult {
    if (!allocation_is_valid(allocation)) {
        return invalid_result(allocation, runtime::Error.invalid_argument);
    }
    if (new_length == allocation.length) {
        return {
            allocation = allocation, error = runtime::Error.none,
        };
    }
    if (new_length == 0) {
        let release_error: runtime::Error = release(allocation);
        if (release_error != runtime::Error.none) {
            return invalid_result(allocation, release_error);
        }
        return {
            allocation = empty_allocation(), error = runtime::Error.none,
        };
    }

    let replacement: AllocationResult = allocate(new_length);
    if (replacement.error != runtime::Error.none) {
        return invalid_result(allocation, replacement.error);
    }

    let copy_length: usize = allocation.length < new_length ? allocation.length : new_length;
    let move_error: runtime::Error = move(replacement.allocation.address, allocation.address as *const u8, copy_length);
    if (move_error != runtime::Error.none) {
        release(replacement.allocation);
        return invalid_result(allocation, move_error);
    }

    let release_error: runtime::Error = release(allocation);
    if (release_error != runtime::Error.none) {
        release(replacement.allocation);
        return invalid_result(allocation, release_error);
    }
    return replacement;
}

fn release(allocation: Allocation) -> runtime::Error {
    if (!allocation_is_valid(allocation)) {
        return runtime::Error.invalid_argument;
    }
    if (allocation.length == 0) {
        return runtime::Error.none;
    }
    return runtime::memory_unmap({
        address = allocation.address, length = allocation.length,
    });
}

fn move(destination: *u8, source: *const u8, length: usize) -> runtime::Error {
    if (length == 0) {
        return runtime::Error.none;
    }
    if (destination == null || source == null) {
        return runtime::Error.bad_address;
    }
    if (destination as usize == source as usize) {
        return runtime::Error.none;
    }

    if (destination as usize < source as usize) {
        for (var index: usize = 0; index < length; index += 1) {
            destination[index] = source[index];
        }
        return runtime::Error.none;
    }

    for (var remaining: usize = length; remaining != 0; remaining -= 1) {
        destination[remaining - 1] = source[remaining - 1];
    }
    return runtime::Error.none;
}

fn fill(destination: *u8, value: u8, length: usize) -> runtime::Error {
    if (length == 0) {
        return runtime::Error.none;
    }
    if (destination == null) {
        return runtime::Error.bad_address;
    }

    for (var index: usize = 0; index < length; index += 1) {
        destination[index] = value;
    }
    return runtime::Error.none;
}

fn equal(left: *const u8, right: *const u8, length: usize) -> bool {
    if (length == 0) {
        return true;
    }
    if (left == null || right == null) {
        return false;
    }

    for (var index: usize = 0; index < length; index += 1) {
        if (left[index] != right[index]) {
            return false;
        }
    }
    return true;
}
