module luna.std.charconv;

fn result(ptr: *u8, error: runtime::Error) -> to_chars_result {
    return { ptr = ptr, error = error };
}

fn digit(value: u8) -> u8 {
    return value < 10 ? '0' + value : 'a' + value - 10;
}

fn unsigned_to_chars(first: *u8, last: *u8, value: u64, base: usize, negative: bool) -> to_chars_result {
    if (first == null || last == null) {
        return result(first, runtime::Error.bad_address);
    }
    if (last < first || base < 2) {
        return result(first, runtime::Error.invalid_argument);
    }
    if (base > 36) {
        return result(first, runtime::Error.invalid_argument);
    }

    var reversed: [64]u8 = {};
    var remaining: u64 = value;
    var digit_count: usize = 0;
    do {
        reversed[digit_count] = digit((remaining % base as u64) as u8);
        digit_count += 1;
        remaining /= base as u64;
    } while (remaining != 0);

    let output_size: usize = digit_count + (negative ? 1 : 0);
    if (output_size > last - first) {
        return result(last, runtime::Error.no_space);
    }
    var cursor: *u8 = first;
    if (negative) {
        *cursor = '-';
        cursor += 1;
    }
    for (var index: usize = digit_count; index != 0; index -= 1) {
        *cursor = reversed[index - 1];
        cursor += 1;
    }
    return result(cursor, runtime::Error.none);
}

fn to_chars(first: *u8, last: *u8, value: u64, base: usize) -> to_chars_result {
    return unsigned_to_chars(first, last, value, base, false);
}

fn to_chars(first: *u8, last: *u8, value: i64, base: usize) -> to_chars_result {
    let negative: bool = value < 0;
    let magnitude: u64 = negative ? (-(value + 1)) as u64 + 1 : value as u64;
    return unsigned_to_chars(first, last, magnitude, base, negative);
}

fn to_chars(first: *u8, last: *u8, value: usize, base: usize) -> to_chars_result {
    return unsigned_to_chars(first, last, value as u64, base, false);
}

fn to_chars(first: *u8, last: *u8, value: isize, base: usize) -> to_chars_result {
    let negative: bool = value < 0;
    let magnitude: u64 = negative ? (-(value + 1)) as u64 + 1 : value as u64;
    return unsigned_to_chars(first, last, magnitude, base, negative);
}
