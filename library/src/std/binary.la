module luna.std.binary;

import luna.runtime;
import luna.std.checked as checked;

fn read_u16(data: *const u8, length: usize, offset: usize, result: *u16) -> bool {
    if (data == null || result == null || !checked::range_is_valid(offset, 2, length)) {
        return false;
    }
    *result = (data[offset] as u16) | ((data[offset + 1] as u16) << 8);
    return true;
}

fn read_u32(data: *const u8, length: usize, offset: usize, result: *u32) -> bool {
    if (data == null || result == null || !checked::range_is_valid(offset, 4, length)) {
        return false;
    }
    var value: u32 = 0;
    var index: usize = 0;
    while (index < 4) {
        value |= (data[offset + index] as u32) << ((index * 8) as u32);
        index += 1;
    }
    *result = value;
    return true;
}

fn read_u64(data: *const u8, length: usize, offset: usize, result: *u64) -> bool {
    if (data == null || result == null || !checked::range_is_valid(offset, 8, length)) {
        return false;
    }
    var value: u64 = 0;
    var index: usize = 0;
    while (index < 8) {
        value |= (data[offset + index] as u64) << ((index * 8) as u64);
        index += 1;
    }
    *result = value;
    return true;
}

fn append_u8(output: *bytes::Buffer, value: u8) -> bool {
    if (output == null) {
        return false;
    }
    let appended = bytes::push(*output, value);
    *output = appended.buffer;
    return appended.error == runtime::Error.none;
}

fn append_u16(output: *bytes::Buffer, value: u16) -> bool {
    var index: usize = 0;
    while (index < 2) {
        if (!append_u8(output, ((value >> ((index * 8) as u16)) & 0xff) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn append_u32(output: *bytes::Buffer, value: u32) -> bool {
    var index: usize = 0;
    while (index < 4) {
        if (!append_u8(output, ((value >> ((index * 8) as u32)) & 0xff) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn append_u64(output: *bytes::Buffer, value: u64) -> bool {
    var index: usize = 0;
    while (index < 8) {
        if (!append_u8(output, ((value >> ((index * 8) as u64)) & 0xff) as u8)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn store_u32(destination: *u8, value: u32) -> bool {
    if (destination == null) {
        return false;
    }
    var index: usize = 0;
    while (index < 4) {
        destination[index] = ((value >> ((index * 8) as u32)) & 0xff) as u8;
        index += 1;
    }
    return true;
}

fn store_u64(destination: *u8, value: u64) -> bool {
    if (destination == null) {
        return false;
    }
    var index: usize = 0;
    while (index < 8) {
        destination[index] = ((value >> ((index * 8) as u64)) & 0xff) as u8;
        index += 1;
    }
    return true;
}
