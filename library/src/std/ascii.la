module luna.std.ascii;

fn is_in_range(byte: u8, first: u8, last: u8) -> bool {
    return byte >= first && byte <= last;
}

fn is_letter(byte: u8) -> bool {
    return is_in_range(byte, 'A', 'Z') || is_in_range(byte, 'a', 'z');
}

fn is_decimal_digit(byte: u8) -> bool {
    return is_in_range(byte, '0', '9');
}

fn is_hex_digit(byte: u8) -> bool {
    let is_uppercase: bool = is_in_range(byte, 'A', 'F');
    let is_lowercase: bool = is_in_range(byte, 'a', 'f');
    let is_hex_letter: bool = is_uppercase || is_lowercase;
    return is_decimal_digit(byte) || is_hex_letter;
}

fn base_is_valid(base: u64) -> bool {
    return base >= 2 && base <= 16;
}

fn digit_value(byte: u8, base: u64, result: *u64) -> bool {
    if (result == null || !base_is_valid(base)) {
        return false;
    }
    var value: u64 = 0;
    if (is_decimal_digit(byte)) {
        value = (byte - '0') as u64;
    } else if (is_in_range(byte, 'a', 'f')) {
        value = (byte - 'a' + 10) as u64;
    } else if (is_in_range(byte, 'A', 'F')) {
        value = (byte - 'A' + 10) as u64;
    } else {
        return false;
    }
    if (value >= base) {
        return false;
    }
    *result = value;
    return true;
}

fn hex_value(byte: u8) -> usize {
    var value: u64 = 0;
    return digit_value(byte, 16, &value) ? value as usize : 16;
}

fn lower_hex_digit(value: u8) -> u8 {
    if (value >= 16) {
        return 0;
    }
    return value < 10 ? '0' + value : 'a' + value - 10;
}
